sum PipelineError {
    BadInput(detail: String),
    Upstream(detail: String),
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        BadInput(detail) => return "bad input: " + detail
        Upstream(detail) => return "upstream error: " + detail
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match Int.parse(value: raw) {
        Some(value) => return Result.Ok(value)
        None => return Result.Err(PipelineError.BadInput(detail: "not an integer: " + raw))
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    match parse_amount(raw: raw) {
        Ok(amount) => match Sync.push(id: id, amount: amount) {
            Ok(count) => return Result.Ok(count)
            Err(error) => return Result.Err(PipelineError.Upstream(detail: SyncError.message(error: error)))
        }
        Err(error) => return Result.Err(error)
    }
}

fn main() -> Unit {
    match push_amount(id: "order-42", raw: "17") {
        Ok(count) => Metrics.record(name: "accepted_amount", value: count)
        Err(error) => Metrics.record(name: PipelineError.detail(error: error), value: 0)
    }
}
