async fn drain(stream: read Stream<Int>, limit: read Int) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut count: Int = 0

    while count < limit {
        local item: Result<Option<Int>, ChannelError> = await Stream.next(stream: read stream)

        match item {
            Ok(Some(value)) => {
                total = total + value
                count = count + 1
            }
            Ok(None) => {
                break
            }
            Err(error) => {
                return Err(error)
            }
        }
    }

    return Ok(total)
}

fn write(value: Int) -> Unit {
    return Unit
}

fn main() -> Result<Unit, ChannelError> {
    local values: List<Int> = [1, 2]
    local stream: Stream<Int> = Stream.from_list(items: take values)

    let mut outcome: Result<Int, ChannelError> = Ok(0)
    task_group {
        async let sum = drain(stream: read stream, limit: 2)
        outcome = await sum
    }

    match outcome {
        Ok(total) => {
            write(value: total)
            return Ok(Unit)
        }
        Err(error) => {
            return Err(error)
        }
    }
}
