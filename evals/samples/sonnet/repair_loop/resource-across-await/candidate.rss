fn read_cursor(path: read String) -> Result<fresh String, String> {
    with ConfigStore.open(path: path)? as store {
        return ConfigStore.read_key(store: mut store, key: "cursor")
    }
}

async fn sync_next_page(path: read String) -> Result<String, String> {
    let cursor = read_cursor(path: path)?
    let page = await Sync.fetch_page(cursor: cursor)
    match page {
        Ok(value) => {
            return Ok(value)
        }
        Err(error) => {
            return Err(SyncError.message(error: error))
        }
    }
}

fn main() -> Result<Unit, String> {
    task_group {
        async let result = sync_next_page(path: "config.toml")
        let page = await result

        match page {
            Ok(value) => {
                with ConfigStore.open(path: "config.toml")? as store {
                    return ConfigStore.write_key(store: mut store, key: "page", value: value)
                }
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
}
