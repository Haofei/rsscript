async fn drain(stream: mut Stream<Int>, limit: read Int) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut count: Int = 0

    while count < limit {
        match await Stream.next(stream: mut stream) {
            Ok(Some(value)) => {
                total = total + value
                count = count + 1
            }
            Ok(None) => {
                return Ok(total)
            }
            Err(error) => {
                return Err(error)
            }
        }
    }

    return Ok(total)
}

fn main() -> Result<Unit, ChannelError> {
    local numbers: List<Int> = List.of(3, 4)
    let mut stream: Stream<Int> = Stream.from_list(list: take numbers)

    let outcome = task_group {
        async let sum = drain(stream: mut stream, limit: 2)
        await sum
    }

    match outcome {
        Ok(total) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(error)
        }
    }
}
