protocol Formatter {
    fn format(self: read Self) -> fresh String
}

struct PlainFormatter {
    prefix: String
}

fn PlainFormatter.format(self: read Self) -> fresh String {
    return self.prefix
}

impl Formatter for PlainFormatter {}

struct JsonFormatter {
    field: String
}

fn JsonFormatter.format(self: read Self) -> fresh String {
    return Json.object(fields: [("field", Json.string(self.field))]).to_string()
}

impl Formatter for JsonFormatter {}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return formatter.format()
}

fn main() -> Unit {
    let plain = PlainFormatter { prefix: "LOG: " }
    let json = JsonFormatter { field: "status" }

    let plain_dyn: Dyn<Formatter> = plain
    let json_dyn: Dyn<Formatter> = json

    let rendered_plain = render(plain_dyn)
    let rendered_json = render(json_dyn)
}
