class EventLog {
    entries: List<String>
    tags: List<String>
}

fn EventLog.new() -> EventLog {
    return EventLog { entries: List<String>.new(), tags: List<String>.new() }
}

fn EventLog.record(log: mut EventLog, entry: String, tag: String) -> Unit
    retains(entry)
    retains(tag)
{
    log.entries.push(entry)
    log.tags.push(tag)
}

fn EventLog.size(log: read EventLog) -> Int {
    return log.entries.len()
}

fn main() -> Unit {
    local log = EventLog.new()
    EventLog.record(log: mut log, entry: "started", tag: "info")
    EventLog.record(log: mut log, entry: "finished", tag: "info")
    print(EventLog.size(log: log))
}
