sum PipelineError {
    BadInput(detail: String)
    Upstream(detail: String)
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        PipelineError.BadInput(detail) => return "Bad input: " + detail
        PipelineError.Upstream(detail) => return "Upstream error: " + detail
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match Int.parse(text: raw) {
        Some(value) => return Ok(value)
        None => return Err(PipelineError.BadInput(detail: "not an integer: " + raw))
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    let amount = match parse_amount(raw: raw) {
        Ok(value) => value
        Err(error) => return Err(error)
    }

    match Sync.push(id: id, amount: amount) {
        Ok(count) => return Ok(count)
        Err(error) => return Err(PipelineError.Upstream(detail: SyncError.message(error: error)))
    }
}

fn main() -> Unit {
    match push_amount(id: "acct-1", raw: "42") {
        Ok(count) => Metrics.record(name: "accepted", value: count)
        Err(error) => Metrics.record(name: PipelineError.detail(error: error), value: 0)
    }
}
