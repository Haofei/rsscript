fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0
    for id in ids {
        match Sync.push(id: id, amount: amount) {
            Ok(value) => {
                total = total + value
            }
            Err(error) => {
                return Err(SyncError.message(error: error))
            }
        }
    }
    Metrics.record(name: "accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids: List<String> = ["order-1", "order-2"]
    match publish_batch(ids: ids, amount: 25) {
        Ok(total) => {
            Metrics.record(name: "publish_batch_ok", value: total)
        }
        Err(message) => {
            Metrics.record(name: message, value: -1)
        }
    }
}
