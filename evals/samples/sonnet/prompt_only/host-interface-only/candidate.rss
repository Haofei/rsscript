fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0

    for id in ids {
        match Sync.push(id, amount) {
            Ok(pushed) => {
                total = total + pushed
            }
            Err(error) => {
                return Err(SyncError.message(error))
            }
        }
    }

    Metrics.record("publish_batch.accepted_total", total)
    Ok(total)
}

fn main() -> Unit {
    let ids: List<String> = ["order-1", "order-2"]

    match publish_batch(ids, 100) {
        Ok(total) => {
            Metrics.record("publish_batch.result", total)
        }
        Err(message) => {
            Metrics.record("publish_batch.error", -1)
        }
    }
}
