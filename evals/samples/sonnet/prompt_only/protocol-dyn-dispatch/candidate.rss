protocol Formatter {
    fn format(self: read Self) -> fresh String;
}

struct PlainFormatter {
    prefix: String,
}

fn format_plain(self: read PlainFormatter) -> fresh String {
    return self.prefix + "plain output";
}

impl Formatter for PlainFormatter {
    fn format(self: read Self) -> fresh String {
        return format_plain(self);
    }
}

struct JsonFormatter {
    field: String,
}

fn format_json(self: read JsonFormatter) -> fresh String {
    let value: Json = Json.object([
        Json.pair("field", Json.string(self.field)),
    ]);
    return value.stringify();
}

impl Formatter for JsonFormatter {
    fn format(self: read Self) -> fresh String {
        return format_json(self);
    }
}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return formatter.format();
}

fn main() -> Unit {
    let plain: PlainFormatter = PlainFormatter { prefix: "hello: " };
    let json: JsonFormatter = JsonFormatter { field: "status" };

    let plain_dyn: Dyn<Formatter> = plain as Dyn<Formatter>;
    let json_dyn: Dyn<Formatter> = json as Dyn<Formatter>;

    write(render(plain_dyn));
    write(render(json_dyn));
}
