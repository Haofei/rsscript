struct Record {
    id: String,
    amount: Int,
}

fn parse_record(line: read String) -> Result<fresh Record, String> {
    let fields: List<String> = line.split(",");
    if fields.len() != 2 {
        return Err("expected exactly two fields");
    }

    let id: String = fields.get(0).trim();
    let amount_text: String = fields.get(1).trim();

    match amount_text.to_int() {
        Ok(amount) => Ok(Record { id: id, amount: amount }),
        Err(_) => Err("amount is not an integer"),
    }
}

fn parse_all(text: read String) -> Result<fresh List<Record>, String> {
    let mut records: List<Record> = List::new();

    for line in text.split("\n") {
        let trimmed: String = line.trim();
        if trimmed.len() == 0 {
            continue;
        }

        match parse_record(trimmed) {
            Ok(record) => records.push(record),
            Err(message) => return Err(message),
        }
    }

    Ok(records)
}

fn total_amount(records: read List<Record>) -> Int {
    let mut sum: Int = 0;
    for record in records {
        sum = sum + record.amount;
    }
    sum
}

fn main() -> Unit {
    let document: String = "a1, 100\na2, 250";

    match parse_all(document) {
        Ok(records) => {
            let total: Int = total_amount(records);
            print(total);
        }
        Err(message) => {
            print(message);
        }
    }
}
