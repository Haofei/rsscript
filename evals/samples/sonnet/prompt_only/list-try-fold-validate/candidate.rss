struct Tally {
    total: Int,
    count: Int,
}

fn add_amount(tally: Tally, raw: String) -> Result<fresh Tally, String> {
    match Int::parse(raw) {
        Ok(amount) => {
            if amount < 0 {
                Err("negative amount not allowed: " + raw)
            } else {
                Ok(fresh Tally { total: tally.total + amount, count: tally.count + 1 })
            }
        }
        Err(_) => Err("not a valid integer: " + raw),
    }
}

fn tally_all(raws: read List<String>) -> Result<fresh Tally, String> {
    try_fold(raws, fresh Tally { total: 0, count: 0 }, add_amount)
}

fn main() -> Unit {
    let raws: List<String> = ["120", "45", "300"];
    match tally_all(raws) {
        Ok(tally) => print("total: " + Int::to_string(tally.total)),
        Err(message) => print("error: " + message),
    }
}
