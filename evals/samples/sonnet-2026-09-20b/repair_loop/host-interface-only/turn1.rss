fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0
    for id in ids {
        match Sync.push(id: id, amount: amount) {
            Ok(accepted) => {
                total = total + accepted
            }
            Err(error) => {
                return Err(SyncError.message(error: error))
            }
        }
    }
    Metrics.record(name: "accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids = String.split(value: "alpha,beta", delimiter: ",")
    match publish_batch(ids: ids, amount: 5) {
        Ok(total) => {
            Output.write(message: String.from_int(value: total))
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
    return Unit
}
