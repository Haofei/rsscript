fn scaled_total(values: read List<Int>, factor: Int, offset: Int) -> Int {
    local scale = |x| {
        return x * factor + offset
    }
    let mut total = 0
    for value in values {
        total = total + scale(value)
    }
    return total
}

fn main() -> Unit {
    local values = List.new<Int>()
    List.push(list: mut values, value: 1)
    List.push(list: mut values, value: 2)
    List.push(list: mut values, value: 3)
    let total = scaled_total(values: values, factor: 2, offset: 1)
    Output.write(message: String.from_int(value: total))
    return Unit
}
