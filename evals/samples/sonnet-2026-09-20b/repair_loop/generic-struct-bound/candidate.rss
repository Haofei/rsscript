struct Batch<T: Struct> {
    label: String
    items: List<T>
}

struct Reading {
    sensor: String
    value: Int
}

fn make_batch<T: Struct>(label: take String, items: take List<T>) -> fresh Batch<T> {
    return Batch(label: take label, items: take items)
}

fn batch_size<T: Struct>(batch: read Batch<T>) -> Int {
    return List.len(list: batch.items)
}

fn main() -> Unit {
    local readings = List.new<Reading>()
    local reading = Reading(sensor: "thermo", value: 21)
    List.push(list: mut readings, value: manage reading)
    local label = "daily"
    let batch = make_batch(label: take label, items: take readings)
    Output.write(message: String.from_int(value: batch_size(batch: batch)))
    return Unit
}
