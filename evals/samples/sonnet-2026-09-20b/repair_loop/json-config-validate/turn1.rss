struct ServiceConfig {
    name: String
    port: Int
    enabled: Bool
}

fn json_failure(context: String, error: JsonError) -> fresh String {
    let prefix = String.concat(left: context, right: ": ")
    return String.concat(left: prefix, right: JsonError.message(error: error))
}

fn validate_port(port: Int) -> Result<Int, String> {
    if port < 1 {
        return Err(String.concat(left: "port is below 1: ", right: String.from_int(value: port)))
    }
    if port > 65535 {
        return Err(String.concat(left: "port is above 65535: ", right: String.from_int(value: port)))
    }
    return Ok(port)
}

fn read_port(root: JsonValue) -> Result<Int, String> {
    match Json.field_int(value: root, name: "port") {
        Ok(port) => {
            return validate_port(port: port)
        }
        Err(error) => {
            return Err(json_failure(context: "invalid field port", error: error))
        }
    }
}

fn read_enabled(root: JsonValue) -> Result<Bool, String> {
    match Json.field_optional_bool(value: root, name: "enabled") {
        Ok(flag) => {
            return Ok(Option.unwrap_or(value: flag, default: true))
        }
        Err(error) => {
            return Err(json_failure(context: "invalid field enabled", error: error))
        }
    }
}

fn build_config(root: JsonValue) -> Result<fresh ServiceConfig, String> {
    match Json.field_string(value: root, name: "name") {
        Err(error) => {
            return Err(json_failure(context: "invalid field name", error: error))
        }
        Ok(name) => {
            let port = read_port(root: root)?
            let enabled = read_enabled(root: root)?
            local owned = String.copy(value: name)
            local config = ServiceConfig(name: take owned, port: port, enabled: enabled)
            return Ok(config)
        }
    }
}

fn load_config(text: String) -> Result<fresh ServiceConfig, String> {
    match Json.parse(text: text) {
        Ok(root) => {
            return build_config(root: root)
        }
        Err(error) => {
            return Err(json_failure(context: "invalid JSON", error: error))
        }
    }
}

fn main() -> Unit {
    let text = "{\"name\": \"api\", \"port\": 8080, \"enabled\": true}"
    match load_config(text: text) {
        Ok(config) => {
            Output.write(message: config.name)
        }
        Err(message) => {
            Output.write(message: message)
        }
    }
    return Unit
}
