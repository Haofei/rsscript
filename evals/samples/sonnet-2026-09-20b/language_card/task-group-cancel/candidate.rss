async fn probe(key: read String) -> Result<String, String> {
    let value = await EvalApi.fetch(key: key)?
    return Ok(value)
}

fn run() -> Result<Unit, String> {
    let source = CancellationSource.new()
    let mut cancelled = false
    let mut fetched = ""
    task_group {
        let token = Task.cancellation_token()
        CancellationSource.cancel(source: mut source)
        if CancellationToken.is_cancelled(token: token) {
            cancelled = true
        }
        async let pending = probe(key: "work")
        fetched = await pending?
    }
    if cancelled {
        Output.write(message: "cancelled")
    }
    Output.write(message: fetched)
    return Ok(Unit)
}

fn main() -> Unit {
    match run() {
        Ok(_) => {
            Output.write(message: "done")
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
    return Unit
}
