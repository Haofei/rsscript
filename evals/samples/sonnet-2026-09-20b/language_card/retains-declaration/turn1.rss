class EventLog {
    entries: List<String>
    tags: List<String>
}

fn EventLog.new() -> EventLog {
    let entries = List.new<String>()
    let tags = List.new<String>()
    return EventLog(entries: entries, tags: tags)
}

fn EventLog.record(log: mut EventLog, entry: String, tag: String) -> Unit
    retains(entry)
    retains(tag)
{
    List.push(list: mut log.entries, value: entry)
    List.push(list: mut log.tags, value: tag)
    return Unit
}

fn EventLog.size(log: read EventLog) -> Int {
    return List.len(list: log.entries)
}

fn main() -> Unit {
    let log = EventLog.new()
    EventLog.record(log: mut log, entry: manage "started", tag: manage "info")
    EventLog.record(log: mut log, entry: manage "finished", tag: manage "info")
    Output.write(message: String.from_int(value: EventLog.size(log: log)))
    return Unit
}
