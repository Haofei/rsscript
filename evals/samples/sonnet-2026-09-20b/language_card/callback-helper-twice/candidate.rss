fn count_matching(values: read List<Int>, predicate: noescape Fn(Int) -> Bool) -> Int {
    let mut count = 0
    for value in values {
        if predicate(value) {
            count = count + 1
        }
    }
    return count
}

fn summarise(values: read List<Int>, limit: Int) -> fresh String {
    local above = |x| {
        return x > limit
    }
    local rest = |x| {
        return x <= limit
    }
    let high = count_matching(values: values, predicate: above)
    let low = count_matching(values: values, predicate: rest)
    let head = String.concat(left: String.from_int(value: high), right: "/")
    return String.concat(left: head, right: String.from_int(value: low))
}

fn main() -> Unit {
    local values = List.new<Int>()
    List.push(list: mut values, value: 1)
    List.push(list: mut values, value: 5)
    List.push(list: mut values, value: 8)
    List.push(list: mut values, value: 3)
    List.push(list: mut values, value: 10)
    Output.write(message: summarise(values: values, limit: 4))
    return Unit
}
