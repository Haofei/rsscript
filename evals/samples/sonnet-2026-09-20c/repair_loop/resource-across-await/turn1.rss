fn read_cursor(path: read String) -> Result<fresh String, String> {
    let mut cursor = String.copy(value: "")
    with ConfigStore.open(path)? as store {
        cursor = ConfigStore.read_key(store: mut store, key: "cursor")?
    }
    return Ok(cursor)
}

async fn sync_next_page(path: read String) -> Result<String, String> {
    let cursor = read_cursor(path: path)?
    let fetched = await Sync.fetch_page(cursor: cursor)
    let mut page = String.copy(value: "")
    match fetched {
        Ok(value) => {
            page = value
        }
        Err(error) => {
            return Err(SyncError.message(error: error))
        }
    }
    return Ok(page)
}

fn main() -> Result<Unit, String> {
    let mut page = String.copy(value: "")
    task_group {
        async let handle = sync_next_page(path: "config.db")
        page = await handle?
    }
    Output.write(message: page)
    return Ok(Unit)
}
