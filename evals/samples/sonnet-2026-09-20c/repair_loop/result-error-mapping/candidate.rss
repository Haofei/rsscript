sum PipelineError {
    BadInput(detail: String)
    Upstream(detail: String)
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        BadInput(detail) => {
            return String.concat(left: "bad input: ", right: detail)
        }
        Upstream(detail) => {
            return String.concat(left: "upstream failure: ", right: detail)
        }
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match String.parse_int(value: raw) {
        Some(amount) => {
            return Ok(amount)
        }
        None => {
            return Err(BadInput(detail: String.concat(left: "not an integer: ", right: raw)))
        }
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    let amount = parse_amount(raw: raw)?
    match Sync.push(id: id, amount: amount) {
        Ok(count) => {
            return Ok(count)
        }
        Err(error) => {
            return Err(Upstream(detail: SyncError.message(error: error)))
        }
    }
}

fn main() -> Unit {
    match push_amount(id: "order-1", raw: "42") {
        Ok(count) => {
            Output.write(message: String.from_int(value: count))
        }
        Err(error) => {
            Output.error(message: PipelineError.detail(error: error))
        }
    }
    return Unit
}
