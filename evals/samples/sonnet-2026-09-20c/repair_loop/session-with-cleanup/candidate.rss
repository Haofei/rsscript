fn apply_all(
    session: mut DeviceSession,
    settings: read List<String>,
    value: Int,
) -> Result<Unit, String> {
    for setting in settings {
        match DeviceSession.apply(session: mut session, setting: setting, value: value) {
            Ok(_) => {
                Audit.note(event: String.concat(left: "applied setting: ", right: setting))
            }
            Err(error) => {
                Audit.note(event: String.concat(left: "aborted setting: ", right: setting))
                return Err(error)
            }
        }
    }
    return Ok(Unit)
}

fn apply_settings(
    device: read String,
    settings: read List<String>,
    value: Int,
) -> Result<Int, String> {
    let mut result: Result<Int, String> = Err("session not opened")
    with DeviceSession.open(device: device)? as session {
        match apply_all(session: mut session, settings: settings, value: value) {
            Err(error) => {
                result = Err(error)
            }
            Ok(_) => {
                match DeviceSession.commit(session: mut session) {
                    Ok(version) => {
                        Audit.note(
                            event: String.concat(
                                left: "committed version ",
                                right: String.from_int(value: version),
                            ),
                        )
                        result = Ok(version)
                    }
                    Err(error) => {
                        result = Err(error)
                    }
                }
            }
        }
    }
    return result
}

fn main() -> Unit {
    let settings = String.split(value: "brightness,contrast,volume", delimiter: ",")
    match apply_settings(device: "device-0", settings: settings, value: 7) {
        Ok(version) => {
            Output.write(
                message: String.concat(
                    left: "applied, version ",
                    right: String.from_int(value: version),
                ),
            )
        }
        Err(error) => {
            Output.error(message: error)
        }
    }
    return Unit
}
