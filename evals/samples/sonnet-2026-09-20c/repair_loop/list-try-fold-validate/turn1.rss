struct Tally {
    total: Int
    count: Int
}

fn add_amount(tally: Tally, raw: String) -> Result<fresh Tally, String> {
    let Some(amount) = String.parse_int(value: raw) else {
        return Err(String.concat(left: "not an integer: ", right: raw))
    }
    if amount < 0 {
        return Err(String.concat(left: "negative amount: ", right: raw))
    }
    return Ok(Tally(total: tally.total + amount, count: tally.count + 1))
}

fn tally_all(raws: read List<String>) -> Result<fresh Tally, String> {
    local initial = Tally(total: 0, count: 0)
    local step = |acc, raw| {
        return add_amount(tally: acc, raw: raw)
    }
    return List.try_fold(list: raws, initial: initial, folder: step)
}

fn main() -> Unit {
    local raws = String.split(value: "10,20,12", delimiter: ",")
    match tally_all(raws: raws) {
        Ok(tally) => {
            Output.write(message: String.from_int(value: tally.total))
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
    return Unit
}
