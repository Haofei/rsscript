fn parse_first(values: read List<String>) -> Result<Int, String> {
    match EvalApi.first(values: values) {
        Some(value) => {
            return EvalApi.parse(input: value)
        }
        None => {
            return Err("no values")
        }
    }
}

fn main() -> Unit {
    local values = String.split(value: "42", delimiter: ",")
    match parse_first(values: values) {
        Ok(value) => {
            Output.write(message: String.from_int(value: value))
        }
        Err(message) => {
            Output.write(message: message)
        }
    }
    return Unit
}
