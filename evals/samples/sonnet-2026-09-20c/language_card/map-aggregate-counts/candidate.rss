fn count_by_level(lines: read List<String>) -> fresh Map<String, Int> {
    local counts = Map.new<String, Int>()
    for line in lines {
        let level = Option.unwrap_or(value: String.before(value: line, delimiter: " "), default: "unknown")
        let current = Map.get_or_default(map: counts, key: level, default: 0)
        Map.insert(map: mut counts, key: level, value: current + 1)
    }
    return counts
}

fn render_counts(counts: read Map<String, Int>) -> fresh String {
    local parts = List.new<String>()
    for key in Map.keys(map: counts) {
        let count = Map.get_or_default(map: counts, key: key, default: 0)
        let label = String.concat(left: key, right: "=")
        let entry = String.concat(left: label, right: String.from_int(value: count))
        List.push(list: mut parts, value: entry)
    }
    return String.join(parts: parts, separator: ",")
}

fn main() -> Unit {
    local lines = List.new<String>()
    List.push(list: mut lines, value: "INFO server started")
    List.push(list: mut lines, value: "ERROR disk full")
    List.push(list: mut lines, value: "INFO request handled")
    let counts = count_by_level(lines: lines)
    Output.write(message: render_counts(counts: counts))
    return Unit
}
