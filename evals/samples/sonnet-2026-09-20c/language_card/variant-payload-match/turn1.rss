sum Command {
    Ping
    SetPoint(sensor: String, target: Int)
    Shutdown(reason: String)
}

fn apply_command(command: read Command, current: Int) -> Int {
    match command {
        Ping => {
            return current
        }
        SetPoint(sensor, target) => {
            return target
        }
        Shutdown(reason) => {
            return 0
        }
    }
}

fn describe(command: read Command) -> fresh String {
    match command {
        Ping => {
            return String.clone(value: "ping")
        }
        SetPoint(sensor, target) => {
            let head = String.concat(left: "set ", right: sensor)
            let tail = String.concat(left: " to ", right: String.from_int(value: target))
            return String.concat(left: head, right: tail)
        }
        Shutdown(reason) => {
            return String.concat(left: "shutdown: ", right: reason)
        }
    }
}

fn main() -> Unit {
    let command = SetPoint(sensor: "boiler", target: 70)
    Output.write(message: String.from_int(value: apply_command(command: command, current: 10)))
    Output.write(message: describe(command: command))
    return Unit
}
