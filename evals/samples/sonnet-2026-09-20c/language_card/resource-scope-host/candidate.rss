fn copy_setting(path: read String, key: read String, target: read String) -> Result<Unit, String> {
    with ConfigStore.open(path)? as store {
        let value = ConfigStore.read_key(store: mut store, key: key)?
        ConfigStore.write_key(store: mut store, key: target, value: value)?
    }
    return Ok(Unit)
}

fn main() -> Unit {
    match copy_setting(path: "settings.db", key: "theme", target: "theme_backup") {
        Ok(_) => {
            Output.write(message: "setting copied")
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
    return Unit
}
