fn run() -> Result<Unit, String> {
    let mut source = CancellationSource.new()
    task_group {
        let token = Task.cancellation_token()
        CancellationSource.cancel(source: mut source)
        if CancellationToken.is_cancelled(token: token) {
            Output.write(message: "cancelled")
        }
        async let pending = EvalApi.fetch(key: "work")
        let fetched = await pending?
        Output.write(message: fetched)
    }
    return Ok(Unit)
}

fn main() -> Unit {
    match run() {
        Ok(_) => {
            Output.write(message: "done")
        }
        Err(error) => {
            Output.error(message: error)
        }
    }
    return Unit
}
