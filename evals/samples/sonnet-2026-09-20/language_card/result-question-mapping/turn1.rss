sum IngestError {
    Malformed(detail: String)
    Rejected(detail: String)
}

fn IngestError.detail(error: read IngestError) -> fresh String {
    match error {
        Malformed(text) => {
            return String.concat(left: "malformed: ", right: text)
        }
        Rejected(text) => {
            return String.concat(left: "rejected: ", right: text)
        }
    }
}

fn parse_amount(raw: read String) -> Result<Int, IngestError> {
    let trimmed = String.trim(value: raw)
    let Some(amount) = String.parse_int(value: trimmed) else {
        return Err(Malformed(detail: String.concat(left: "not an integer: ", right: trimmed)))
    }
    return Ok(amount)
}

fn check_amount(amount: Int) -> Result<Int, IngestError> {
    if amount <= 0 {
        return Err(Rejected(detail: String.concat(left: "non-positive amount: ", right: String.from_int(value: amount))))
    }
    return Ok(amount)
}

fn ingest(raw: read String) -> Result<Int, IngestError> {
    let parsed = parse_amount(raw: raw)?
    let checked = check_amount(amount: parsed)?
    return Ok(checked * 2)
}

fn ingest_all(raws: read List<String>) -> Result<Int, String> {
    let mut total: Int = 0
    for raw in raws {
        match ingest(raw: raw) {
            Ok(value) => {
                total = total + value
            }
            Err(error) => {
                return Err(IngestError.detail(error: error))
            }
        }
    }
    return Ok(total)
}

fn main() -> Unit {
    let mut raws: List<String> = List.new<String>()
    List.push(list: mut raws, value: "10")
    List.push(list: mut raws, value: " 20 ")
    List.push(list: mut raws, value: "30")
    match ingest_all(raws: raws) {
        Ok(total) => {
            Output.write(message: String.from_int(value: total))
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
}
