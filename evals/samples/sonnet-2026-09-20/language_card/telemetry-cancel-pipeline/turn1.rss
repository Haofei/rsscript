async fn publish(sender: Sender<Int>, samples: read List<Int>, token: CancellationToken) -> Result<Int, ChannelError> {
    let mut sent: Int = 0
    for sample in samples {
        if CancellationToken.is_cancelled(token: token) {
            return Ok(sent)
        }
        local value = sample
        match await Sender.send_cancellable(sender: sender, value: take value, token: token) {
            Ok(_) => {
                sent = sent + 1
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(sent)
}

async fn collect(receiver: Receiver<Int>, limit: Int, token: CancellationToken) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut seen: Int = 0
    while seen < limit {
        match await Receiver.recv_cancellable(receiver: receiver, token: token) {
            Ok(item) => {
                match item {
                    Some(value) => {
                        total = total + value
                        seen = seen + 1
                    }
                    None => {
                        return Ok(total)
                    }
                }
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(total)
}

async fn main() -> Result<Int, ChannelError> {
    local channel = Channel.bounded<Int>(capacity: 2)?
    local sender = Channel.sender(channel: channel)
    local receiver = Channel.receiver(channel: mut channel)?
    local source = CancellationSource.new()
    local token = CancellationSource.token(source: source)

    local samples = List.new<Int>()
    List.push(list: mut samples, value: 10)
    List.push(list: mut samples, value: 20)
    List.push(list: mut samples, value: 30)
    List.push(list: mut samples, value: 40)

    let mut received: Int = 0
    let mut sent: Int = 0

    task_group {
        async let produced = publish(sender: sender, samples: samples, token: token)
        async let consumed = collect(receiver: receiver, limit: 4, token: token)

        let consumed_result = await consumed
        CancellationSource.cancel(source: mut source)
        let produced_result = await produced

        received = consumed_result?
        sent = produced_result?
    }

    Output.write(message: String.concat(left: "sent: ", right: Int.to_string(value: sent)))
    Output.write(message: String.concat(left: "received sum: ", right: Int.to_string(value: received)))
    return Ok(received)
}
