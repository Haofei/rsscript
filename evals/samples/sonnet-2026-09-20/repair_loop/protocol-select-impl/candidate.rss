protocol Sink {
    fn deliver(self: read Self, line: read String) -> fresh String
}

struct ConsoleSink {
    prefix: String
}

struct JsonSink {
    channel: String
}

fn ConsoleSink.deliver(self: read ConsoleSink, line: read String) -> fresh String {
    let head = String.concat(left: self.prefix, right: ": ")
    return String.concat(left: head, right: line)
}

fn JsonSink.deliver(self: read JsonSink, line: read String) -> fresh String {
    return Json.string_field(name: self.channel, value: line)
}

fn sink_for(kind: read String) -> fresh Dyn<Sink> {
    if kind == "json" {
        local json_sink = JsonSink(channel: "out")
        return Dyn.from<Sink, JsonSink>(value: take json_sink)
    }
    local console_sink = ConsoleSink(prefix: "console")
    return Dyn.from<Sink, ConsoleSink>(value: take console_sink)
}

fn deliver_line(kind: read String, line: read String) -> fresh String {
    let sink = sink_for(kind: kind)
    return Sink.deliver(self: sink, line: line)
}

fn main() -> Unit {
    let console_text = deliver_line(kind: "console", line: "hello")
    Output.write(message: console_text)
    let json_text = deliver_line(kind: "json", line: "hello")
    Output.write(message: json_text)
}

impl Sink for ConsoleSink {
    deliver = ConsoleSink.deliver
}

impl Sink for JsonSink {
    deliver = JsonSink.deliver
}
