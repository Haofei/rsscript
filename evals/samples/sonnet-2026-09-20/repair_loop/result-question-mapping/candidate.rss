sum IngestError {
    Malformed(detail: String)
    Rejected(detail: String)
}

fn IngestError.detail(error: read IngestError) -> fresh String {
    match error {
        Malformed(detail) => {
            return String.concat(left: "malformed amount: ", right: detail)
        }
        Rejected(detail) => {
            return String.concat(left: "rejected amount: ", right: detail)
        }
    }
}

fn parse_amount(raw: read String) -> Result<Int, IngestError> {
    let trimmed = String.trim(value: raw)
    let Some(amount) = String.parse_int(value: trimmed) else {
        return Err(Malformed(detail: trimmed))
    }
    return Ok(amount)
}

fn check_amount(amount: Int) -> Result<Int, IngestError> {
    if amount <= 0 {
        let shown = String.from_int(value: amount)
        return Err(Rejected(detail: shown))
    }
    return Ok(amount)
}

fn ingest(raw: read String) -> Result<Int, IngestError> {
    let parsed = parse_amount(raw: raw)?
    let checked = check_amount(amount: parsed)?
    return Ok(checked * 2)
}

fn ingest_all(raws: read List<String>) -> Result<Int, String> {
    let mut total: Int = 0
    for raw in raws {
        match ingest(raw: raw) {
            Ok(value) => {
                total = total + value
            }
            Err(error) => {
                return Err(IngestError.detail(error: error))
            }
        }
    }
    return Ok(total)
}

fn main() -> Unit {
    let mut items: List<String> = List.new<String>()
    List.push(list: mut items, value: "10")
    List.push(list: mut items, value: " 5 ")
    List.push(list: mut items, value: "7")
    match ingest_all(raws: items) {
        Ok(total) => {
            Output.write(message: String.concat(left: "total: ", right: String.from_int(value: total)))
        }
        Err(message) => {
            Output.error(message: message)
        }
    }
}
