sum JobState {
    Queued,
    Running(worker: String),
    Done(code: Int),
    Failed(reason: String),
}

fn advance(state: read JobState, worker: read String) -> fresh JobState {
    match state {
        Queued => {
            return Running(worker: String.concat(left: worker, right: ""))
        }
        Running(name) => {
            return Done(code: 0)
        }
        Done(code) => {
            return Done(code: code)
        }
        Failed(reason) => {
            return Failed(reason: String.concat(left: reason, right: ""))
        }
    }
}

fn describe(state: read JobState) -> fresh String {
    match state {
        Queued => {
            return "queued"
        }
        Running(name) => {
            return String.concat(left: "running on ", right: name)
        }
        Done(code) => {
            return String.concat(left: "done with code ", right: Int.to_string(value: code))
        }
        Failed(reason) => {
            return String.concat(left: "failed: ", right: reason)
        }
    }
}

fn main() -> Unit {
    let first: JobState = advance(state: Queued, worker: "worker-1")
    let second: JobState = advance(state: first, worker: "worker-1")
    let text: String = describe(state: second)
}
