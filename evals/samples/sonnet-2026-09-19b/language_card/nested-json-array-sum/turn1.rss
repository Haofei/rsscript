fn sum_quantities(text: read String) -> Result<Int, JsonError> {
    match Json.parse(text: text) {
        Err(error) => {
            return Err(error)
        }
        Ok(root) => {
            match Json.get_field(value: root, name: "items") {
                Err(error) => {
                    return Err(error)
                }
                Ok(items_value) => {
                    match Json.as_array(value: items_value) {
                        Err(error) => {
                            return Err(error)
                        }
                        Ok(items) => {
                            let mut total: Int = 0
                            for item in items {
                                match Json.get_field(value: item, name: "quantity") {
                                    Err(error) => {
                                        return Err(error)
                                    }
                                    Ok(quantity_value) => {
                                        match Json.as_int(value: quantity_value) {
                                            Err(error) => {
                                                return Err(error)
                                            }
                                            Ok(quantity) => {
                                                total = total + quantity
                                            }
                                        }
                                    }
                                }
                            }
                            return Ok(total)
                        }
                    }
                }
            }
        }
    }
}

fn main() -> Unit {
    let document: String = "{\"items\": [{\"quantity\": 3}, {\"quantity\": 4}]}"
    match sum_quantities(text: document) {
        Ok(total) => {
            IO.println(text: Int.to_string(value: total))
        }
        Err(error) => {
            IO.println(text: Json.error_message(error: error))
        }
    }
}
