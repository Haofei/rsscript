sum IngestError {
    Malformed(detail: String),
    Rejected(detail: String),
}

fn IngestError.detail(error: read IngestError) -> fresh String {
    match error {
        Malformed(detail) => {
            return String.concat(left: "malformed amount: ", right: detail)
        }
        Rejected(detail) => {
            return String.concat(left: "rejected amount: ", right: detail)
        }
    }
}

fn parse_amount(raw: read String) -> Result<Int, IngestError> {
    let trimmed: String = String.trim(value: raw)
    match Int.parse(value: trimmed) {
        Some(amount) => {
            return Ok(amount)
        }
        None => {
            return Err(Malformed(detail: trimmed))
        }
    }
}

fn check_amount(amount: Int) -> Result<Int, IngestError> {
    if amount <= 0 {
        return Err(Rejected(detail: "amount must be positive"))
    }
    return Ok(amount)
}

fn ingest(raw: read String) -> Result<Int, IngestError> {
    let parsed: Int = parse_amount(raw: raw)?
    let accepted: Int = check_amount(amount: parsed)?
    return Ok(accepted * 2)
}

fn ingest_all(raws: read List<String>) -> Result<Int, String> {
    let mut total: Int = 0
    for raw in raws {
        match ingest(raw: raw) {
            Ok(value) => {
                total = total + value
            }
            Err(error) => {
                return Err(IngestError.detail(error: error))
            }
        }
    }
    return Ok(total)
}

fn main() -> Unit {
    let mut raws: List<String> = List.new()
    List.push(list: mut raws, item: "10")
    List.push(list: mut raws, item: " 25 ")
    List.push(list: mut raws, item: "7")
    match ingest_all(raws: raws) {
        Ok(total) => {
            println(value: String.concat(left: "total: ", right: Int.to_string(value: total)))
        }
        Err(message) => {
            println(value: String.concat(left: "error: ", right: message))
        }
    }
}
