struct Window {
    start: Int
    width: Int
}

fn field_of(line: read String, delimiter: read String) -> Option<String> {
    let parts: List<String> = String.split(value: line, delimiter: delimiter)
    return List.get(list: parts, index: 1)
}

fn parsed_field(line: read String, delimiter: read String) -> Option<Int> {
    return Option.and_then(value: field_of(line: line, delimiter: delimiter), next: Int.parse)
}

fn window_from(line: read String) -> fresh Window {
    let start: Int = match parsed_field(line: line, delimiter: "start=") {
        Some(value) => { value }
        None => { 0 }
    }
    let width: Int = match parsed_field(line: line, delimiter: "width=") {
        Some(value) => {
            if value > 0 {
                value
            } else {
                60
            }
        }
        None => { 60 }
    }
    return Window(start: start, width: width)
}

fn main() -> Unit {
    let window: Window = window_from(line: "start=5 width=120")
    Console.write_line(value: Int.to_string(value: window.start))
    Console.write_line(value: Int.to_string(value: window.width))
}
