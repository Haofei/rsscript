struct Record {
    id: String,
    amount: Int,
}

fn parse_record(line: read String) -> Result<fresh Record, String> {
    let parts: List<String> = String.split(value: line, delimiter: ",")
    if List.len(list: parts) != 2 {
        return Err("expected exactly two fields")
    }
    let id: String = String.trim(value: List.get(list: parts, index: 0))
    let amount_text: String = String.trim(value: List.get(list: parts, index: 1))
    match Int.parse(value: amount_text) {
        Ok(amount) => {
            return Ok(Record(id: id, amount: amount))
        }
        Err(message) => {
            return Err(String.concat(left: "invalid amount: ", right: amount_text))
        }
    }
}

fn parse_all(text: read String) -> Result<fresh List<Record>, String> {
    let mut records: List<Record> = List.new()
    for line in String.split(value: text, delimiter: "\n") {
        let trimmed: String = String.trim(value: line)
        if String.is_empty(value: trimmed) {
            continue
        }
        match parse_record(line: trimmed) {
            Ok(record) => {
                local item = record
                List.push(list: mut records, item: take item)
            }
            Err(message) => {
                return Err(message)
            }
        }
    }
    return Ok(records)
}

fn total_amount(records: read List<Record>) -> Int {
    let mut total: Int = 0
    for record in records {
        total = total + record.amount
    }
    return total
}

fn main() -> Unit {
    let text: String = "alpha, 10\nbeta, 32\n"
    match parse_all(text: text) {
        Ok(records) => {
            let total: Int = total_amount(records: records)
            Console.write_line(value: Int.to_string(value: total))
        }
        Err(message) => {
            Console.write_line(value: message)
        }
    }
}
