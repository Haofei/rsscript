protocol Formatter {
    fn format(self: read Self) -> fresh String
}

struct PlainFormatter {
    prefix: String
}

struct JsonFormatter {
    field: String
}

fn PlainFormatter.format(self: read PlainFormatter) -> fresh String {
    return String.concat(left: self.prefix, right: ": plain")
}

fn JsonFormatter.format(self: read JsonFormatter) -> fresh String {
    let key = Json.string(value: "field")
    let value = Json.string(value: self.field)
    let pair = String.concat(left: key, right: String.concat(left: ":", right: value))
    return String.concat(left: "{", right: String.concat(left: pair, right: "}"))
}

impl Formatter for PlainFormatter {}

impl Formatter for JsonFormatter {}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return formatter.format()
}

fn main() -> Unit {
    local plain = PlainFormatter(prefix: "report")
    local json = JsonFormatter(field: "status")
    let plain_dyn: Dyn<Formatter> = Dyn.from(value: take plain)
    let json_dyn: Dyn<Formatter> = Dyn.from(value: take json)
    let plain_text = render(formatter: plain_dyn)
    let json_text = render(formatter: json_dyn)
    Console.write_line(value: plain_text)
    Console.write_line(value: json_text)
}
