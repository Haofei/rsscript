fn push_until_accepted(id: read String, amount: Int, budget: Int) -> Result<Int, String> {
    let mut attempt: Int = 0
    let mut last: String = "no attempts made"
    while attempt < budget {
        attempt = attempt + 1
        match Sync.push(id: id, amount: amount) {
            Ok(accepted) => {
                Metrics.record(name: "sync.attempts", value: attempt)
                return Ok(accepted)
            }
            Err(failure) => {
                let message: String = SyncError.message(error: failure)
                if Sync.is_retryable(error: failure) {
                    last = message
                } else {
                    return Err(message)
                }
            }
        }
    }
    return Err(last)
}

fn main() -> Unit {
    match push_until_accepted(id: "job-1", amount: 10, budget: 3) {
        Ok(accepted) => {
            Metrics.record(name: "sync.outcome.accepted", value: accepted)
        }
        Err(message) => {
            Metrics.record(name: "sync.outcome.failed", value: 0)
        }
    }
}
