async fn drain(stream: Stream<Int>, limit: Int) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut count: Int = 0
    while count < limit {
        match await Stream.next(stream: stream) {
            Ok(item) => {
                match item {
                    Some(value) => {
                        total = total + value
                        count = count + 1
                    }
                    None => {
                        return Ok(total)
                    }
                }
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(total)
}

fn main() -> Result<Unit, ChannelError> {
    local values: List<Int> = List.new()
    List.push(list: mut values, value: 1)
    List.push(list: mut values, value: 2)
    let stream: Stream<Int> = Stream.from_list(list: take values)
    task_group {
        async let pending = drain(stream: stream, limit: 5)
        let total: Int = await pending?
        Console.write_line(text: Int.to_string(value: total))
    }
    return Ok(())
}
