fn scaled_total(values: read List<Int>, factor: Int, offset: Int) -> Int {
    local scale = fn(value: Int) -> Int {
        return value * factor + offset
    }
    let mut total: Int = 0
    for value in values {
        total = total + scale(value: value)
    }
    return total
}

fn main() -> Unit {
    let total: Int = scaled_total(values: [1, 2, 3, 4], factor: 3, offset: 2)
    return
}
