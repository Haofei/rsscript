struct Alert(level: String, message: String)

fn select_alerts(alerts: read List<Alert>, keep: noescape Fn(Alert) -> Bool) -> fresh List<Alert> {
    return List.filter(list: alerts, predicate: keep)
}

fn urgent_only(alerts: read List<Alert>) -> fresh List<Alert> {
    return select_alerts(
        alerts: alerts,
        keep: fn(alert: Alert) -> Bool {
            return alert.level == "critical"
        }
    )
}

fn main() -> Unit {
    let alerts = [
        Alert(level: "warning", message: "Low disk space"),
        Alert(level: "critical", message: "System down")
    ]
    let urgent = urgent_only(alerts: alerts)
    let count = List.length(list: urgent)
    print(count)
}
