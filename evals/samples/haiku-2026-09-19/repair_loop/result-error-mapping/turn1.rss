sum PipelineError {
    BadInput(detail: String)
    Upstream(detail: String)
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        BadInput(detail) => { return detail }
        Upstream(detail) => { return detail }
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match Int.parse(value: raw) {
        Ok(amount) => { return Ok(value: amount) }
        Err(_) => { return Err(error: BadInput(detail: "not an integer")) }
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    match parse_amount(raw: raw) {
        Ok(amount) => {
            match Sync.push(id: id, amount: amount) {
                Ok(value) => { return Ok(value: value) }
                Err(sync_error) => {
                    let message = SyncError.message(error: sync_error)
                    return Err(error: Upstream(detail: message))
                }
            }
        }
        Err(parse_error) => { return Err(error: parse_error) }
    }
}

fn main() -> Unit {
    match push_amount(id: "test", raw: "42") {
        Ok(count) => {
            Console.print(value: String(value: count))
        }
        Err(error) => {
            Console.print(value: PipelineError.detail(error: error))
        }
    }
}
