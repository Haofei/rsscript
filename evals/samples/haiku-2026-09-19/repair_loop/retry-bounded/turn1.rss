fn push_with_retry(id: read String, amount: Int, max_attempts: Int) -> Result<Int, String> {
    let mut attempt = 0
    let mut last_error_msg: String = ""
    
    while attempt < max_attempts {
        attempt = attempt + 1
        
        match Sync.push(id: id, amount: amount) {
            Ok(value) => {
                Metrics.record(name: "push_success_attempts", value: attempt)
                return Ok(value)
            }
            Err(error) => {
                last_error_msg = SyncError.message(error: error)
                if !Sync.is_retryable(error: error) {
                    return Err(take last_error_msg)
                }
            }
        }
    }
    
    return Err(take last_error_msg)
}

fn main() -> Unit {
    let result = push_with_retry(id: "example", amount: 100, max_attempts: 3)
    match result {
        Ok(value) => {
            Metrics.record(name: "push_retry_result", value: value)
        }
        Err(message) => {
            Metrics.record(name: "push_retry_error", value: 0)
        }
    }
}
