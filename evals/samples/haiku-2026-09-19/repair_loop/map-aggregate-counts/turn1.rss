fn count_by_level(lines: read List<String>) -> fresh Map<String, Int> {
    let mut counts: Map<String, Int> = Map()
    
    for line in lines {
        local level = extract_level(line: line)
        let current = get_or_zero(map: counts, key: level)
        counts = Map.insert(map: counts, key: level, value: current + 1)
    }
    
    return counts
}

fn extract_level(line: read String) -> fresh String {
    let parts = String.split(value: line, delimiter: " ")
    return match parts {
        Cons(first, _) => { first }
        Nil => { "unknown" }
    }
}

fn get_or_zero(map: read Map<String, Int>, key: read String) -> fresh Int {
    return match Map.get(map: map, key: key) {
        Some(count) => { count }
        None => { 0 }
    }
}

fn render_counts(counts: read Map<String, Int>) -> fresh String {
    let entries = Map.entries(map: counts)
    let mut result: String = ""
    let mut is_first: Bool = true
    
    for entry in entries {
        if !is_first {
            result = String.concat(a: result, b: ", ")
        }
        is_first = false
        
        result = String.concat(a: result, b: entry.key)
        result = String.concat(a: result, b: ":")
        result = String.concat(a: result, b: Int.to_string(value: entry.value))
    }
    
    return result
}

fn main() -> Unit {
    local lines = List("ERROR something", "WARN another", "INFO msg")
    local counts = count_by_level(lines: lines)
    local result = render_counts(counts: counts)
    return ()
}
