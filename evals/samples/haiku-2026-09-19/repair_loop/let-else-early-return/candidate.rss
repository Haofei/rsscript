struct Route(host: String, port: Int)

fn parse_route(raw: read String) -> Option<Route> {
    let parts = String.split(value: raw, delimiter: ":")
    let len = List.len(list: parts)

    if len != 2 {
        return None
    }

    let host = String.trim(value: List.get(list: parts, index: 0))
    let port_str = String.trim(value: List.get(list: parts, index: 1))

    if host == "" {
        return None
    }

    let Some(port) = String.parse_int(value: port_str) else { return None }

    return Some(Route(host: host, port: port))
}

fn describe_route(raw: read String) -> fresh String {
    let Some(route) = parse_route(raw: raw) else { return "unroutable" }
    let port_str = Int.to_string(value: route.port)
    let with_slash = String.concat(left: route.host, right: "/")
    return String.concat(left: with_slash, right: port_str)
}

fn main() -> Unit {
    let routable = describe_route(raw: "localhost:8080")
    let unroutable = describe_route(raw: "invalid")
    Output.write(message: routable)
    Output.write(message: unroutable)
}
