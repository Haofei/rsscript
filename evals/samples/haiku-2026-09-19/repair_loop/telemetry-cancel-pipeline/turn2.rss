async fn publish(sender: Sender<Int>, samples: read List<Int>, token: CancellationToken) -> Result<Int, ChannelError> {
    let mut count = 0
    for sample in samples {
        select {
            case sent = await sender.send(value: take sample) => {
                count = count + 1
            }
            case cancelled = await token.cancelled() => {
                return Ok(count)
            }
        }
    }
    return Ok(count)
}

async fn collect(receiver: Receiver<Int>, limit: Int, token: CancellationToken) -> Result<Int, ChannelError> {
    let mut sum = 0
    let mut count = 0
    
    while count < limit {
        select {
            case result = await receiver.recv() => {
                match result {
                    Ok(value) => {
                        sum = sum + value
                        count = count + 1
                    }
                    Err(error) => {
                        return Err(error)
                    }
                }
            }
            case cancelled = await token.cancelled() => {
                return Ok(sum)
            }
        }
    }
    
    return Ok(sum)
}

fn main() -> Unit {
    let channel = Channel.bounded<Int>(capacity: 2)
    let mut sender = Channel.sender(channel: channel)
    let mut receiver = Channel.receiver(channel: mut channel)
    
    let mut cancellation_source = CancellationSource.new()
    let token = CancellationSource.token(source: cancellation_source)
    
    let samples = [1, 2, 3, 4, 5]
    
    task_group {
        async let collect_result = collect(receiver: receiver, limit: 3, token: token)
        async let publish_result = publish(sender: sender, samples: samples, token: token)
        
        await collect_result
        CancellationSource.cancel(source: take cancellation_source)
        await publish_result
    }
}
