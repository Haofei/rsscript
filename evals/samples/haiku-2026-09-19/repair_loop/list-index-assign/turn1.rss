fn clamp_samples(samples: read List<Int>, ceiling: Int) -> fresh List<Int> {
    let mut result = List.copy(list: samples)
    let len = List.len(list: result)
    let mut i = 0
    while i < len {
        let value = List.get(list: result, index: i)
        if value > ceiling {
            List.set(list: mut result, index: i, value: ceiling)
        }
        i = i + 1
    }
    return result
}

fn main() -> Unit {
    let clamped = clamp_samples(samples: [1, 5, 3, 10, 2, 8], ceiling: 7)
    let mut strings = []
    for value in clamped {
        List.append(list: mut strings, value: Int.string(value: value))
    }
    let joined = String.join(values: strings, separator: ",")
    IO.print(text: joined)
}
