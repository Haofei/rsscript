struct PumpConfig(name: String, interval_ms: Int, retries: Int)

sum ConfigError {
    MissingField(field: String),
    OutOfRange(field: String, value: Int)
}

fn ConfigError.describe(error: read ConfigError) -> fresh String {
    match error {
        MissingField(field) => {
            local msg = "Missing required field: "
            return String.concat(s1: msg, s2: field)
        }
        OutOfRange(field, value) => {
            local msg = "Field out of range: "
            return String.concat(s1: msg, s2: field)
        }
    }
}

fn validate(config: read PumpConfig) -> Result<Unit, ConfigError> {
    if config.name == "" {
        return Err(error: MissingField(field: "name"))
    }
    
    if config.interval_ms < 100 || config.interval_ms > 60000 {
        return Err(error: OutOfRange(field: "interval_ms", value: config.interval_ms))
    }
    
    if config.retries < 0 || config.retries > 10 {
        return Err(error: OutOfRange(field: "retries", value: config.retries))
    }
    
    return Ok(value: Unit())
}

fn main() -> Unit {
    local config = PumpConfig(name: "pump", interval_ms: 5000, retries: 3)
    local result = validate(config: config)
    
    match result {
        Ok(value) => {
            print(value: config.name)
        }
        Err(error) => {
            print(value: ConfigError.describe(error: error))
        }
    }
}
