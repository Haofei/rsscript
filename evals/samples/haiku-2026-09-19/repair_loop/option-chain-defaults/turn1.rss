struct Window(start: Int, width: Int)

fn field_of(line: read String, delimiter: read String) -> Option<String> {
    return Option.map(
        value: String.index_of(value: line, substring: delimiter),
        f: noescape fn(idx: Int) -> String {
            local delim_len = String.length(value: delimiter)
            local start_pos = idx + delim_len
            local remaining_len = String.length(value: line) - start_pos
            return String.sub(value: line, start: start_pos, length: remaining_len)
        }
    )
}

fn parsed_field(line: read String, delimiter: read String) -> Option<Int> {
    return Option.and_then(
        value: field_of(line: line, delimiter: delimiter),
        f: noescape fn(field: String) -> Option<Int> {
            return Int.parse(value: field)
        }
    )
}

fn window_from(line: read String) -> fresh Window {
    local start = Option.or(value: parsed_field(line: line, delimiter: "start:"), default: 0)
    local width_opt = parsed_field(line: line, delimiter: "width:")
    local width = match width_opt {
        Some(w) => {
            if w > 0 { w } else { 60 }
        }
        None => { 60 }
    }
    return Window(start: start, width: width)
}

fn main() -> Unit {
    local line = "start:10 width:80"
    local window = window_from(line: line)
    local start_str = "start: " + String.from_int(value: window.start)
    local width_str = "width: " + String.from_int(value: window.width)
    println(value: start_str)
    println(value: width_str)
}
