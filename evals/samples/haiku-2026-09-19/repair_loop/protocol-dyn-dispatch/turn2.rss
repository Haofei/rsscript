protocol Formatter {
    fn format(self: read Self) -> fresh String
}

struct PlainFormatter {
    prefix: String
}

struct JsonFormatter {
    field: String
}

fn formatPlain(self: read PlainFormatter) -> fresh String {
    return self.prefix
}

fn formatJson(self: read JsonFormatter) -> fresh String {
    return self.field
}

impl Formatter for PlainFormatter {
    fn format = formatPlain
}

impl Formatter for JsonFormatter {
    fn format = formatJson
}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return formatter.format()
}

fn main() -> Unit {
    local plain = PlainFormatter(prefix: "Hello")
    local json = JsonFormatter(field: "world")
    
    let plainResult = render(formatter: plain as Dyn<Formatter>)
    let jsonResult = render(formatter: json as Dyn<Formatter>)
}
