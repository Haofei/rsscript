protocol Sink {
    fn deliver(self: read Self, line: read String) -> fresh String
}

struct ConsoleSink(prefix: String)
struct JsonSink(channel: String)

fn console_deliver(self: read ConsoleSink, line: read String) -> fresh String {
    local temp = String.concat(left: self.prefix, right: ": ")
    return String.concat(left: temp, right: line)
}

fn json_deliver(self: read JsonSink, line: read String) -> fresh String {
    local obj = Json.object()
    Json.set(obj: mut obj, key: self.channel, value: Json.string(s: line))
    return Json.stringify(j: obj)
}

impl Sink for ConsoleSink {
    fn deliver = console_deliver
}

impl Sink for JsonSink {
    fn deliver = json_deliver
}

fn sink_for(kind: read String) -> fresh Dyn<Sink> {
    if Eq.equals(a: kind, b: "json") {
        local json_sink = JsonSink("message")
        return json_sink
    } else {
        local console_sink = ConsoleSink("LOG")
        return console_sink
    }
}

fn deliver_line(kind: read String, line: read String) -> fresh String {
    local sink = sink_for(kind: kind)
    return sink.deliver(line: line)
}

fn main() -> Unit {
    let console_result = deliver_line(kind: "console", line: "Hello World")
    let json_result = deliver_line(kind: "json", line: "Hello World")
}
