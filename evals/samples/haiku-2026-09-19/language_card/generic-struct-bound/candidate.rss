struct Batch<T: Struct> {
    label: String,
    items: List<T>
}

struct Reading {
    sensor: String,
    value: Int
}

fn make_batch<T: Struct>(label: take String, items: take List<T>) -> fresh Batch<T> {
    return Batch(label: take label, items: take items)
}

fn batch_size<T: Struct>(batch: read Batch<T>) -> Int {
    return List.len(value: batch.items)
}

fn main() -> Unit {
    local reading = Reading(sensor: "temperature", value: 25)
    local readings = List.empty<Reading>()
    local readings = List.append(list: take readings, value: take reading)
    local batch = make_batch(label: take "sensors", items: take readings)
    local size = batch_size(batch: batch)
}
