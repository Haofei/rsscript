fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0
    
    for id in ids {
        match Sync.push(id: id, amount: amount) {
            Ok(count) => {
                total = total + count
            }
            Err(error) => {
                let message = SyncError.message(error: error)
                return Err(message)
            }
        }
    }
    
    Metrics.record(name: "accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids = ["task-001", "task-002"]
    let result = publish_batch(ids: ids, amount: 100)
    
    match result {
        Ok(_) => {}
        Err(_) => {}
    }
}
