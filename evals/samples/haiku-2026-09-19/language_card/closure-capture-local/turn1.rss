fn scaled_total(values: read List<Int>, factor: Int, offset: Int) -> Int {
    local scale = fn(value: Int) -> Int {
        return value * factor + offset
    }
    
    let mut total: Int = 0
    for value in values {
        total = total + scale(value: value)
    }
    return total
}

fn main() -> Unit {
    let values: List<Int> = [1, 2, 3, 4, 5]
    let result = scaled_total(values: values, factor: 2, offset: 10)
    write(result)
}
