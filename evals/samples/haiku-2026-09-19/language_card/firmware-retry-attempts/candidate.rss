fn push_until_accepted(id: read String, amount: Int, budget: Int) -> Result<Int, String> {
    let mut attempt: Int = 0
    let mut last_error: String = ""
    
    while attempt < budget {
        attempt = attempt + 1
        let result = Sync.push(id: id, amount: amount)
        
        match result {
            Ok(value) => {
                Metrics.record(name: "push_attempts", value: attempt)
                return Ok(value)
            }
            Err(error) => {
                last_error = SyncError.message(error: error)
                if !Sync.is_retryable(error: error) {
                    return Err(last_error)
                }
            }
        }
    }
    
    return Err(last_error)
}

fn main() -> Unit {
    let result = push_until_accepted(id: "task", amount: 100, budget: 3)
    match result {
        Ok(value) => {
            Metrics.record(name: "push_completed", value: value)
        }
        Err(_message) => {
            Metrics.record(name: "push_failed", value: 0)
        }
    }
}
