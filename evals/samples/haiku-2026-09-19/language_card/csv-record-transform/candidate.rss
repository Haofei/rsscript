struct Record {
    id: String,
    amount: Int,
}

fn parse_record(line: read String) -> Result<fresh Record, String> {
    let parts = String.split(value: line, delimiter: ",")
    
    if List.len(list: parts) != 2 {
        return Err(message: "Expected exactly 2 fields")
    }
    
    let id = String.trim(value: List.get(list: parts, index: 0))
    let amount_str = String.trim(value: List.get(list: parts, index: 1))
    
    match Int.parse(value: amount_str) {
        Ok(val) => {
            return Ok(value: fresh Record(id: id, amount: val))
        }
        Err(_) => {
            return Err(message: "Invalid amount")
        }
    }
}

fn parse_all(text: read String) -> Result<fresh List<Record>, String> {
    let lines = String.split(value: text, delimiter: "\n")
    local mut records: List<Record> = List()
    
    for line in lines {
        if String.len(value: line) > 0 {
            match parse_record(line: line) {
                Ok(record) => {
                    List.push(list: mut records, value: record)
                }
                Err(err) => {
                    return Err(message: err)
                }
            }
        }
    }
    
    return Ok(value: fresh records)
}

fn total_amount(records: read List<Record>) -> Int {
    local mut total: Int = 0
    
    for record in records {
        total = total + record.amount
    }
    
    return total
}

fn main() -> Unit {
    let csv = "alice,100\nbob,200"
    
    match parse_all(text: csv) {
        Ok(records) => {
            let total = total_amount(records: records)
            print(value: Int.to_string(value: total))
        }
        Err(err) => {
            print(value: err)
        }
    }
}
