class EventLog {
  entries: List<String>
  tags: List<String>
}

fn EventLog.new() -> EventLog {
  EventLog {
    entries: [],
    tags: []
  }
}

fn EventLog.record(log: mut EventLog, entry: String, tag: String) -> Unit
  retain entry
  retain tag
{
  log.entries.push(entry)
  log.tags.push(tag)
}

fn EventLog.size(log: read EventLog) -> Int {
  log.entries.len()
}

fn main() -> Unit {
  let log = EventLog.new()
  EventLog.record(log, "First event", "startup")
  EventLog.record(log, "Second event", "shutdown")
  let size = EventLog.size(log)
  println(size)
}
