fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total = 0
    
    for id in ids {
        match Sync.push(id, amount) {
            Ok(result) => {
                total = total + result
            }
            Err(error) => {
                let message = SyncError.message(error)
                return Err(message)
            }
        }
    }
    
    Metrics.record("batch_accepted", total)
    Ok(total)
}

fn main() -> Unit {
    let ids = ["id1", "id2"]
    match publish_batch(ids, 100) {
        Ok(total) => {
            Metrics.record("publish_outcome_total", total)
        }
        Err(_) => {
            Metrics.record("publish_outcome_error", -1)
        }
    }
}
