fn split_levels(lines: read List<String>) -> (Int, Int, Int) {
  var errorCount = 0
  var warnCount = 0
  var otherCount = 0
  
  for line in lines {
    if line.startsWith("error") {
      errorCount = errorCount + 1
    } else if line.startsWith("warn") {
      warnCount = warnCount + 1
    } else {
      otherCount = otherCount + 1
    }
  }
  
  (errorCount, warnCount, otherCount)
}

fn main() -> Unit {
  let lines = ["error: something", "warn: something else", "info: other"]
  let (errors, warns, others) = split_levels(lines)
  
  println(errors)
  println(warns)
  println(others)
}
