fn push_with_retry(id: read String, amount: Int, max_attempts: Int) -> Result<Int, String> {
    let mut last_error_message = "";
    
    for attempt in 1..=max_attempts {
        match Sync.push(id, amount) {
            Ok(value) => {
                Metrics.record("push_attempts", attempt);
                return Ok(value);
            }
            Err(error) => {
                last_error_message = SyncError.message(error);
                if !Sync.is_retryable(error) {
                    return Err(last_error_message);
                }
            }
        }
    }
    
    Err(last_error_message)
}

fn main() -> Unit {
    let result = push_with_retry("example_id", 100, 5);
    match result {
        Ok(value) => {}
        Err(message) => {}
    }
}
