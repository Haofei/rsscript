fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0;

    for id in ids {
        match Sync.push(id, amount) {
            Ok(accepted) => {
                total = total + accepted;
            }
            Err(error) => {
                return Err(SyncError.message(error));
            }
        }
    }

    Metrics.record("publish_batch.accepted_total", total);
    return Ok(total);
}

fn main() -> Unit {
    let ids: List<String> = ["order-1001", "order-1002"];

    match publish_batch(ids, 100) {
        Ok(total) => {
            Metrics.record("publish_batch.success", total);
        }
        Err(message) => {
            Metrics.record("publish_batch.failure", 0);
        }
    }
}
