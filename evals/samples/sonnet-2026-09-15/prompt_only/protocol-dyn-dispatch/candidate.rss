protocol Formatter {
    fn format(self: read Self) -> fresh String;
}

struct PlainFormatter {
    prefix: String,
}

fn plain_formatter_format(self: read PlainFormatter) -> fresh String {
    return self.prefix + ": plain formatted output";
}

impl Formatter for PlainFormatter {
    fn format(self: read Self) -> fresh String {
        return plain_formatter_format(self);
    }
}

struct JsonFormatter {
    field: String,
}

fn json_formatter_format(self: read JsonFormatter) -> fresh String {
    let json: Json = Json::object();
    json.set(self.field, Json::string("formatted"));
    return json.to_string();
}

impl Formatter for JsonFormatter {
    fn format(self: read Self) -> fresh String {
        return json_formatter_format(self);
    }
}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return formatter.format();
}

fn main() -> Unit {
    let plain = PlainFormatter { prefix: "Result" };
    let json = JsonFormatter { field: "status" };

    let plain_dyn: Dyn<Formatter> = plain as Dyn<Formatter>;
    let json_dyn: Dyn<Formatter> = json as Dyn<Formatter>;

    let plain_output: String = render(plain_dyn);
    let json_output: String = render(json_dyn);

    print(plain_output);
    print(json_output);
}
