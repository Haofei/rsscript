use std.channel.bounded;
use std.task.{task_group, Task, CancellationToken};

async fn producer(sender: Sender<Int>, token: CancellationToken) {
    let values = [1, 2, 3, 4];
    for v in values {
        if token.is_cancelled() {
            break;
        }
        sender.send(take v).await;
    }
}

async fn consumer(receiver: Receiver<Int>) {
    let mut seen = 0;
    while seen < 4 {
        match receiver.recv().await {
            Some(_v) => {
                seen += 1;
            }
            None => break,
        }
    }
}

fn main() {
    let channel = bounded::<Int>(2);
    let sender = channel.sender();
    let receiver = channel.receiver();

    task_group {
        let token = Task.cancellation_token();
        let producer_handle = spawn producer(sender, token);
        let consumer_handle = spawn consumer(receiver);

        await producer_handle;
        await consumer_handle;
    }
}
