// push_with_retry.rss
//
// Retries Sync.push up to max_attempts times, giving up early on
// non-retryable errors. Records the number of attempts taken on success.

fn push_with_retry(id: read String, amount: Int, max_attempts: Int) -> Result<Int, String> {
    let mut attempt = 0
    let mut last_message = ""

    while attempt < max_attempts {
        attempt = attempt + 1

        match Sync.push(id, amount) {
            Ok(value) => {
                Metrics.record("push_with_retry.attempts", attempt)
                return Ok(value)
            }
            Err(error) => {
                last_message = SyncError.message(error)

                if !Sync.is_retryable(error) {
                    return Err(last_message)
                }
            }
        }
    }

    Err(last_message)
}

fn main() -> Unit {
    let result = push_with_retry("sync-account-1", 100, 3)

    match result {
        Ok(value) => print(value.to_string())
        Err(message) => print(message)
    }
}
