struct Record {
    id: String,
    amount: Int,
}

fn parse_record(line: read String) -> Result<fresh Record, String> {
    let parts: List<String> = line.split(",");
    if parts.len() != 2 {
        return Err("expected exactly two fields".to_string());
    }

    let id: String = parts.get(0).trim().to_string();
    let amount_str: String = parts.get(1).trim().to_string();

    let amount: Int = match amount_str.parse_int() {
        Ok(value) => value,
        Err(_) => return Err("amount is not an integer".to_string()),
    };

    return Ok(Record { id: id, amount: amount });
}

fn parse_all(text: read String) -> Result<fresh List<Record>, String> {
    let mut records: List<Record> = List::new();
    let lines: List<String> = text.split("\n");

    for line in lines {
        let trimmed: String = line.trim().to_string();
        if trimmed.len() == 0 {
            continue;
        }

        let record: Record = match parse_record(trimmed) {
            Ok(r) => r,
            Err(e) => return Err(e),
        };

        records.push(record);
    }

    return Ok(records);
}

fn total_amount(records: read List<Record>) -> Int {
    let mut sum: Int = 0;
    for record in records {
        sum = sum + record.amount;
    }
    return sum;
}

fn main() -> Unit {
    let text: String = "a1,100\nb2,250".to_string();

    match parse_all(text) {
        Ok(records) => {
            let total: Int = total_amount(records);
            print(total.to_string());
        },
        Err(e) => {
            print(e);
        },
    }
}
