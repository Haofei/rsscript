protocol Formatter {
    fn format(self: read Self) -> fresh String
}

struct PlainFormatter {
    prefix: String
}

fn PlainFormatter.format(self: read PlainFormatter) -> fresh String {
    return self.prefix
}

impl Formatter for PlainFormatter {
    fn format(self: read Self) -> fresh String
}

struct JsonFormatter {
    field: String
}

fn JsonFormatter.format(self: read JsonFormatter) -> fresh String {
    let value = Json.field(name: "field", value: self.field)
    return Json.stringify(value: value)
}

impl Formatter for JsonFormatter {
    fn format(self: read Self) -> fresh String
}

fn render(formatter: read Dyn<Formatter>) -> fresh String {
    return Formatter.format(self: formatter)
}

fn main() -> Unit {
    let plain = PlainFormatter(prefix: "info: ")
    let json = JsonFormatter(field: "status")

    let plainDyn: Dyn<Formatter> = plain
    let jsonDyn: Dyn<Formatter> = json

    Io.println(text: render(formatter: plainDyn))
    Io.println(text: render(formatter: jsonDyn))
}
