async fn feed(sender: take Sender<Int>, value: read Int) -> Unit {
    await Sender.send(sender: take sender, value: value)
}

async fn main() -> Unit {
    let mut channel_a: local Channel<Int> = Channel.bounded(capacity: 1)
    let mut channel_b: local Channel<Int> = Channel.bounded(capacity: 1)

    let sender_a: Sender<Int> = Channel.sender(channel: mut channel_a)
    let mut receiver_a: Receiver<Int> = Channel.receiver(channel: mut channel_a)
    let sender_b: Sender<Int> = Channel.sender(channel: mut channel_b)
    let mut receiver_b: Receiver<Int> = Channel.receiver(channel: mut channel_b)

    let mut source: local CancellationSource = CancellationSource.create()
    let mut winner: String = "none"

    task_group {
        async let handle_a = feed(sender: take sender_a, value: 1)
        async let handle_b = feed(sender: take sender_b, value: 2)

        select {
            value_a = await Receiver.recv(receiver: mut receiver_a) => {
                winner = "A"
                CancellationSource.cancel(source: mut source)
            }
            value_b = await Receiver.recv(receiver: mut receiver_b) => {
                winner = "B"
                CancellationSource.cancel(source: mut source)
            }
        }

        await handle_a
        await handle_b
    }
}
