sum JobState {
    Queued,
    Running(worker: String),
    Done(code: Int),
    Failed(reason: String),
}

fn advance(state: read JobState, worker: read String) -> fresh JobState {
    match state {
        Queued => { return Running(worker: worker) }
        Running(_) => { return Done(code: 0) }
        Done(code) => { return Done(code: code) }
        Failed(reason) => { return Failed(reason: reason) }
    }
}

fn describe(state: read JobState) -> fresh String {
    match state {
        Queued => { return "queued" }
        Running(_) => { return "running" }
        Done(_) => { return "done" }
        Failed(_) => { return "failed" }
    }
}

fn main() -> Unit {
    let mut state: JobState = Queued
    state = advance(state: state, worker: "worker-1")
    state = advance(state: state, worker: "worker-1")
    let description: String = describe(state: state)
    return Unit
}
