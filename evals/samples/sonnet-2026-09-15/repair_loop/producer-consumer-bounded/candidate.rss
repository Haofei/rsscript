async fn producer(sender: mut Sender<Int>, token: read CancellationToken) -> Unit {
    let mut i: Int = 0
    while i < 4 {
        if token.is_cancelled() {
            return
        }
        let value: Int = i
        await sender.send(value: take value)
        i = i + 1
    }
}

async fn consumer(receiver: mut Receiver<Int>) -> Unit {
    let mut count: Int = 0
    while count < 4 {
        match await receiver.recv() {
            Some(value) => { count = count + 1 }
            None => { return }
        }
    }
}

fn main() -> Int {
    let mut chan: Channel.Bounded<Int> = Channel.bounded(capacity: 2)
    let mut sender: Sender<Int> = Channel.sender(channel: mut chan)
    let mut receiver: Receiver<Int> = Channel.receiver(channel: mut chan)

    task_group {
        let token: CancellationToken = Task.cancellation_token()
        async let producer_handle = producer(sender: mut sender, token: read token)
        async let consumer_handle = consumer(receiver: mut receiver)
        await producer_handle
        await consumer_handle
    }

    return 0
}
