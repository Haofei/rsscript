struct Record {
    id: String,
    amount: Int,
}

fn parse_record(line: read String) -> Result<fresh Record, String> {
    let parts: List<String> = String.split(text: line, separator: ",")
    if List.length(list: parts) != 2 {
        return Err("expected exactly two fields")
    }
    let id: String = String.trim(text: List.get(list: parts, index: 0))
    let amount_text: String = String.trim(text: List.get(list: parts, index: 1))
    match Int.parse(text: amount_text) {
        Ok(amount) => { return Ok(Record(id: take id, amount: amount)) },
        Err(_) => { return Err("invalid amount") },
    }
}

fn parse_all(text: read String) -> Result<fresh List<Record>, String> {
    let lines: List<String> = String.split(text: text, separator: "\n")
    let mut records: List<Record> = List.new()
    for line in lines {
        let trimmed: String = String.trim(text: line)
        if !String.is_empty(text: trimmed) {
            match parse_record(line: trimmed) {
                Ok(record) => { List.push(list: mut records, value: take record) },
                Err(message) => { return Err(message) },
            }
        }
    }
    return Ok(records)
}

fn total_amount(records: read List<Record>) -> Int {
    let mut total: Int = 0
    for record in records {
        total = total + record.amount
    }
    return total
}

fn main() -> Unit {
    let document: String = "id1, 100\nid2, 200"
    match parse_all(text: document) {
        Ok(records) => {
            let sum: Int = total_amount(records: records)
            Debug.print(text: Int.to_string(value: sum))
        },
        Err(message) => { Debug.print(text: message) },
    }
}
