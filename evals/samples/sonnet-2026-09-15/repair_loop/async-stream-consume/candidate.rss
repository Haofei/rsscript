async fn drain(stream: read Stream<Int>, limit: read Int) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut count: Int = 0
    while count < limit {
        match await Stream.next(stream: stream) {
            Ok(Some(value)) => {
                total = total + value
                count = count + 1
            }
            Ok(None) => {
                return Ok(total)
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(total)
}

fn main() -> Result<Unit, ChannelError> {
    let mut numbers: List<Int> = List.new()
    List.push(list: mut numbers, value: 1)
    List.push(list: mut numbers, value: 2)

    let stream: Stream<Int> = Stream.from_list(items: mut numbers)

    let mut total: Int = 0
    task_group {
        async let handle = drain(stream: stream, limit: 2)
        let result = await handle
        match result {
            Ok(value) => {
                total = value
            }
            Err(error) => {
                return Err(error)
            }
        }
    }

    return Ok(Unit)
}
