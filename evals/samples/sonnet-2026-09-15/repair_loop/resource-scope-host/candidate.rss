fn copy_setting(path: read String, key: read String, target: read String) -> Result<Unit, String> {
    let mut copied: String = ""
    with ConfigStore.open(path: path)? as store {
        match ConfigStore.read_key(store: mut store, key: key) {
            Ok(value) => { copied = value }
            Err(message) => { return Err(message) }
        }
        match ConfigStore.write_key(store: mut store, key: target, value: copied) {
            Ok(_) => { return Ok(Unit) }
            Err(message) => { return Err(message) }
        }
    }
}

fn main() -> Unit {
    match copy_setting(path: "config.toml", key: "source_key", target: "target_key") {
        Ok(_) => { Output.write(message: "copy_setting succeeded") }
        Err(message) => {
            Output.write(message: "copy_setting failed: ")
            Output.write(message: message)
        }
    }
}
