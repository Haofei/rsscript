fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0

    for id in ids {
        let result: Result<Int, SyncError> = Sync.push(id: id, amount: amount)
        match result {
            Ok(value) => { total = total + value }
            Err(error) => { return Err(SyncError.message(error: error)) }
        }
    }

    Metrics.record(name: "publish_batch.accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids: List<String> = ["order-1", "order-2"]
    let outcome: Result<Int, String> = publish_batch(ids: ids, amount: 10)

    match outcome {
        Ok(total) => { Metrics.record(name: "publish_batch.success", value: total) }
        Err(message) => { Metrics.record(name: message, value: 0) }
    }
}
