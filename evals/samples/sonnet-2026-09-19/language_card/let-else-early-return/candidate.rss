struct Route {
    host: String,
    port: Int,
}

fn parse_route(raw: read String) -> Option<Route> {
    let parts = String.split(value: raw, delimiter: ":")
    if List.len(list: parts) != 2 {
        return None
    }
    let Some(host_text) = List.get(list: parts, index: 0) else {
        return None
    }
    let Some(port_text) = List.get(list: parts, index: 1) else {
        return None
    }
    local host = String.trim(value: host_text)
    if String.is_empty(value: host) {
        return None
    }
    let Some(port) = Int.parse(value: String.trim(value: port_text)) else {
        return None
    }
    return Some(Route(host: take host, port: port))
}

fn describe_route(raw: read String) -> fresh String {
    let Some(route) = parse_route(raw: raw) else {
        return "unroutable"
    }
    return route.host + "/" + Int.to_string(value: route.port)
}

fn main() -> Unit {
    IO.println(value: describe_route(raw: "example.com:8080"))
    IO.println(value: describe_route(raw: "example.com:http"))
}
