fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0
    for id in ids {
        match Sync.push(id: id, amount: amount) {
            Ok(accepted) => {
                total = total + accepted
            }
            Err(error) => {
                return Err(SyncError.message(error: error))
            }
        }
    }
    Metrics.record(name: "batch.accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids: List<String> = ["alpha", "beta"]
    match publish_batch(ids: ids, amount: 10) {
        Ok(total) => {
            Metrics.record(name: "outcome.total", value: total)
        }
        Err(_) => {
            Metrics.record(name: "outcome.failed", value: 1)
        }
    }
}
