async fn drain(stream: Stream<Int>, limit: Int) -> Result<Int, ChannelError> {
    let mut total: Int = 0
    let mut count: Int = 0
    while count < limit {
        let item = await Stream.next(stream)
        match item {
            Ok(Some(value)) => {
                total = total + value
                count = count + 1
            }
            Ok(None) => {
                break
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(total)
}

fn main() -> Result<Unit, ChannelError> {
    local values: List<Int> = List.new()
    List.push(list: mut values, value: 1)
    List.push(list: mut values, value: 2)
    let stream: Stream<Int> = Stream.from_list(values)
    task_group {
        async let total = drain(stream: stream, limit: 5)
        match total {
            Ok(sum) => {
                Console.write_line(value: Int.to_string(value: sum))
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
    return Ok(Unit)
}
