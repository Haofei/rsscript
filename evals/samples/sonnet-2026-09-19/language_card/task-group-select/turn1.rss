async fn feed(sender: read Sender<Int>, value: Int) -> Unit {
    await Sender.send(sender: sender, value: value)
    return
}

async fn main() -> Unit {
    let left_channel: Channel<Int> = Channel.bounded(capacity: 1)
    let right_channel: Channel<Int> = Channel.bounded(capacity: 1)
    let left_tx: Sender<Int> = Channel.sender(channel: left_channel)
    let left_rx: Receiver<Int> = Channel.receiver(channel: left_channel)
    let right_tx: Sender<Int> = Channel.sender(channel: right_channel)
    let right_rx: Receiver<Int> = Channel.receiver(channel: right_channel)
    let source: CancellationSource = CancellationSource.new()
    let mut winner: String = "none"

    task_group {
        async let left_feed = feed(sender: left_tx, value: 1)
        async let right_feed = feed(sender: right_tx, value: 2)

        select {
            case await Receiver.recv(receiver: left_rx) => {
                winner = "left"
                CancellationSource.cancel(source: source)
            }
            case await Receiver.recv(receiver: right_rx) => {
                winner = "right"
                CancellationSource.cancel(source: source)
            }
        }

        await left_feed
        await right_feed
    }

    return
}
