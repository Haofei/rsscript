struct Batch<T: Struct> {
    label: String
    items: List<T>
}

struct Reading {
    sensor: String
    value: Int
}

fn make_batch<T: Struct>(label: take String, items: take List<T>) -> fresh Batch<T> {
    return Batch(label: take label, items: take items)
}

fn batch_size<T: Struct>(batch: read Batch<T>) -> Int {
    return List.len(list: batch.items)
}

fn main() -> Unit {
    local reading = Reading(sensor: "thermo", value: 21)
    local items: List<Reading> = List.new()
    List.push(list: mut items, value: take reading)
    local label = "morning"
    local batch = make_batch(label: take label, items: take items)
    let size: Int = batch_size(batch: batch)
    Console.println(value: String.from_int(value: size))
}
