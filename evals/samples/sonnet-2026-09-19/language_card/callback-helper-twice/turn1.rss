fn count_matching(values: read List<Int>, predicate: noescape Fn(Int) -> Bool) -> Int {
    let mut total: Int = 0
    for value in values {
        if predicate(value) {
            total = total + 1
        }
    }
    return total
}

fn summarise(values: read List<Int>, limit: Int) -> fresh String {
    let high: Int = count_matching(
        values: values,
        predicate: fn(value: Int) -> Bool {
            return value > limit
        }
    )
    let low: Int = count_matching(
        values: values,
        predicate: fn(value: Int) -> Bool {
            return value <= limit
        }
    )
    return Int.to_string(value: high) + "/" + Int.to_string(value: low)
}

fn main() -> Unit {
    let values: List<Int> = [3, 8, 1, 9, 4, 7]
    let summary: String = summarise(values: values, limit: 5)
    Io.println(value: summary)
}
