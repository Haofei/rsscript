struct Reading {
    sensor: String
    value: Int
}

fn format_reading(reading: read Reading) -> fresh String {
    return reading.sensor + "=" + Int.to_string(value: reading.value)
}

fn render_report(title: read String, readings: read List<Reading>) -> fresh String {
    let mut lines: List<String> = List.new()
    local title_line = title
    List.push(list: mut lines, value: take title_line)
    for reading in readings {
        local line = format_reading(reading: reading)
        List.push(list: mut lines, value: take line)
    }
    local count_line = "count=" + Int.to_string(value: List.len(list: readings))
    List.push(list: mut lines, value: take count_line)
    return List.join(values: lines, separator: "\n")
}

fn main() -> Unit {
    let mut readings: List<Reading> = List.new()
    local first_name = "temp"
    local first = Reading(sensor: take first_name, value: 21)
    List.push(list: mut readings, value: take first)
    local second_name = "humidity"
    local second = Reading(sensor: take second_name, value: 48)
    List.push(list: mut readings, value: take second)
    let report = render_report(title: "report", readings: readings)
    Output.write(value: report)
}
