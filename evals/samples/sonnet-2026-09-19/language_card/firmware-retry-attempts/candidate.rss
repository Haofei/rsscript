fn push_until_accepted(id: read String, amount: Int, budget: Int) -> Result<Int, String> {
    let mut attempt: Int = 0
    let mut last: String = "no attempts made"
    while attempt < budget {
        attempt = attempt + 1
        match Sync.push(id: id, amount: amount) {
            Ok(accepted) => {
                Metrics.record(name: "sync.attempt", value: attempt)
                return Ok(accepted)
            }
            Err(error) => {
                if Sync.is_retryable(error: error) {
                    last = SyncError.message(error: error)
                } else {
                    return Err(SyncError.message(error: error))
                }
            }
        }
    }
    return Err(last)
}

fn main() -> Unit {
    match push_until_accepted(id: "job-1", amount: 10, budget: 3) {
        Ok(accepted) => {
            Metrics.record(name: "outcome.ok", value: accepted)
        }
        Err(_) => {
            Metrics.record(name: "outcome.error", value: 0)
        }
    }
}
