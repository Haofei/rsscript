pub sum PipelineError {
    BadInput(detail: String),
    Upstream(detail: String),
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        BadInput(detail) => { return "bad input: " + detail }
        Upstream(detail) => { return "upstream failure: " + detail }
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match Int.parse(value: raw) {
        Ok(amount) => { return Ok(amount) }
        Err(_) => { return Err(BadInput(detail: "not an integer: " + raw)) }
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    let amount: Int = parse_amount(raw: raw)?
    match Sync.push(id: id, amount: amount) {
        Ok(count) => { return Ok(count) }
        Err(failure) => {
            return Err(Upstream(detail: SyncError.message(error: failure)))
        }
    }
}

fn main() -> Unit {
    match push_amount(id: "order-1", raw: "42") {
        Ok(count) => {
            Metrics.record(name: "accepted", value: count)
        }
        Err(error) => {
            Metrics.record(name: PipelineError.detail(error: error), value: 0)
        }
    }
}
