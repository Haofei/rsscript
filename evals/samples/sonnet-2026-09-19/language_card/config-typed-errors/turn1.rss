struct PumpConfig {
    name: String,
    interval_ms: Int,
    retries: Int,
}

sum ConfigError {
    MissingField(field: String),
    OutOfRange(field: String, value: Int),
}

fn ConfigError.describe(error: read ConfigError) -> fresh String {
    match error {
        ConfigError.MissingField(field) => {
            return "missing field: " + field
        }
        ConfigError.OutOfRange(field, value) => {
            return "field out of range: " + field + " = " + Int.to_string(value: value)
        }
    }
}

fn validate(config: read PumpConfig) -> Result<Unit, ConfigError> {
    if config.name == "" {
        return Err(ConfigError.MissingField(field: "name"))
    }
    if config.interval_ms < 100 || config.interval_ms > 60000 {
        return Err(ConfigError.OutOfRange(field: "interval_ms", value: config.interval_ms))
    }
    if config.retries < 0 || config.retries > 10 {
        return Err(ConfigError.OutOfRange(field: "retries", value: config.retries))
    }
    return Ok(Unit)
}

fn main() -> Unit {
    let config = PumpConfig(name: "pump-a", interval_ms: 500, retries: 3)
    match validate(config: config) {
        Ok(value) => {
            print(value: config.name)
        }
        Err(error) => {
            print(value: ConfigError.describe(error: error))
        }
    }
}
