fn parse_first(values: read List<String>) -> Result<Int, String> {
    match EvalApi.first(values: values) {
        Some(value) => { return EvalApi.parse(input: value) }
        None => { return Err("no values") }
    }
}

fn main() -> Unit {
    let values = ["42"]
    match parse_first(values: values) {
        Ok(value) => { let parsed: Int = value }
        Err(message) => { let described = EvalApi.describe(input: message) }
    }
}
