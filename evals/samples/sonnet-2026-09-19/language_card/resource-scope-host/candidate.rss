fn copy_setting(path: read String, key: read String, target: read String) -> Result<Unit, String> {
    with store = ConfigStore.open(path: path)? {
        let value = ConfigStore.read_key(store: mut store, key: key)?
        ConfigStore.write_key(store: mut store, key: target, value: value)?
    }
    return Ok(Unit)
}

fn main() -> Unit {
    match copy_setting(path: "config.store", key: "primary", target: "backup") {
        Ok(_) => { return }
        Err(_) => { return }
    }
}
