struct Alert {
    level: String,
    message: String,
}

fn select_alerts(alerts: read List<Alert>, keep: noescape Fn(Alert) -> Bool) -> fresh List<Alert> {
    return List.filter(list: alerts, predicate: keep)
}

fn urgent_only(alerts: read List<Alert>) -> fresh List<Alert> {
    return select_alerts(alerts, keep: fn(alert: Alert) -> Bool {
        return alert.level == "critical"
    })
}

fn main() -> Unit {
    let mut alerts: List<Alert> = List.new()
    List.push(list: mut alerts, value: Alert(level: "critical", message: "disk full"))
    List.push(list: mut alerts, value: Alert(level: "info", message: "backup done"))
    let urgent: List<Alert> = urgent_only(alerts)
    let count: Int = List.len(list: urgent)
    Io.write_line(value: Int.to_string(value: count))
}
