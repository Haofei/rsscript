fn push_with_retry(id: read String, amount: Int, max_attempts: Int) -> Result<Int, String> {
    let mut attempt: Int = 0
    let mut last_message: String = "no attempts made"
    while attempt < max_attempts {
        attempt = attempt + 1
        match Sync.push(id: id, amount: amount) {
            Ok(total) => {
                Metrics.record(name: "sync.attempts", value: attempt)
                return Ok(total)
            }
            Err(error) => {
                last_message = SyncError.message(error: error)
                if !Sync.is_retryable(error: error) {
                    return Err(last_message)
                }
            }
        }
    }
    return Err(last_message)
}

fn main() -> Unit {
    let result: Result<Int, String> = push_with_retry(id: "order-1", amount: 10, max_attempts: 3)
    match result {
        Ok(total) => {
            Metrics.record(name: "sync.total", value: total)
        }
        Err(_) => {
            Metrics.record(name: "sync.failed", value: 1)
        }
    }
}
