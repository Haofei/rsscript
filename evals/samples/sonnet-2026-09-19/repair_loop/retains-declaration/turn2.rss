class EventLog {
    entries: List<String>
    tags: List<String>
}

fn EventLog.new() -> EventLog {
    return EventLog(entries: List.new(), tags: List.new())
}

fn EventLog.record(log: mut EventLog, entry: String, tag: String) -> Unit
    retains(entry)
    retains(tag)
{
    List.push(list: mut log.entries, value: entry)
    List.push(list: mut log.tags, value: tag)
}

fn EventLog.size(log: read EventLog) -> Int {
    return List.len(list: log.entries)
}

fn main() -> Unit {
    let mut log: EventLog = EventLog.new()
    EventLog.record(log: mut log, entry: "started", tag: "info")
    EventLog.record(log: mut log, entry: "stopped", tag: "info")
    let count: Int = EventLog.size(log: log)
    Output.write(value: count)
}
