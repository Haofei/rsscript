async fn send_work(sender: read Sender<Int>) -> Unit {
    await Channel.send(sender: sender, value: 1)
}

async fn send_deadline(sender: read Sender<Int>) -> Unit {
    await Channel.send(sender: sender, value: 2)
}

async fn race() -> Int {
    let work_channel: Channel<Int> = Channel.bounded(capacity: 1)
    let deadline_channel: Channel<Int> = Channel.bounded(capacity: 1)
    let work_tx: Sender<Int> = Channel.sender(channel: work_channel)
    let work_rx: Receiver<Int> = Channel.receiver(channel: work_channel)
    let deadline_tx: Sender<Int> = Channel.sender(channel: deadline_channel)
    let deadline_rx: Receiver<Int> = Channel.receiver(channel: deadline_channel)
    let source: CancellationSource = CancellationSource.new()
    let mut outcome: Int = 0

    task_group {
        async let work_handle = send_work(sender: work_tx)
        async let deadline_handle = send_deadline(sender: deadline_tx)

        select {
            work_rx => {
                let value: Int = await Channel.receive(receiver: work_rx)
                outcome = value
            }
            deadline_rx => {
                let marker: Int = await Channel.receive(receiver: deadline_rx)
                Console.write_line(value: "deadline fired")
                CancellationSource.cancel(source: source)
                outcome = 0 - marker
            }
        }

        await work_handle
        await deadline_handle
    }

    return outcome
}

fn main() -> Unit {
    let outcome: Int = Runtime.block_on(task: race())
    if outcome > 0 {
        Console.write_line(value: "work finished first")
    } else {
        Console.write_line(value: "deadline won the race")
    }
}
