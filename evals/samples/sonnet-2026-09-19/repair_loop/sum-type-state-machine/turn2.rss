sum JobState {
    Queued,
    Running(worker: String),
    Done(code: Int),
    Failed(reason: String),
}

fn advance(state: read JobState, worker: read String) -> fresh JobState {
    match state {
        Queued => {
            return Running(worker: String.concat(left: worker, right: ""))
        }
        Running(name) => {
            return Done(code: 0)
        }
        Done(code) => {
            return Done(code: code)
        }
        Failed(reason) => {
            return Failed(reason: String.concat(left: reason, right: ""))
        }
    }
}

fn describe(state: read JobState) -> fresh String {
    match state {
        Queued => {
            return "queued"
        }
        Running(worker) => {
            return String.concat(left: "running on ", right: worker)
        }
        Done(code) => {
            return String.concat(left: "done with code ", right: Int.to_string(value: code))
        }
        Failed(reason) => {
            return String.concat(left: "failed: ", right: reason)
        }
    }
}

fn main() -> Unit {
    let queued: JobState = Queued
    let running: JobState = advance(state: queued, worker: "worker-1")
    let finished: JobState = advance(state: running, worker: "worker-1")
    Output.write(text: describe(state: finished))
    return
}
