sum PipelineError {
    BadInput(detail: String),
    Upstream(detail: String),
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        BadInput(_) => {
            return "bad input: amount is not an integer"
        }
        Upstream(_) => {
            return "upstream failure: sync rejected the amount"
        }
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match String.parse_int(value: raw) {
        Some(amount) => {
            return Ok(amount)
        }
        None => {
            return Err(BadInput(detail: "amount is not an integer"))
        }
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    match parse_amount(raw: raw) {
        Ok(amount) => {
            match Sync.push(id: id, amount: amount) {
                Ok(count) => {
                    return Ok(count)
                }
                Err(sync_error) => {
                    let message: String = SyncError.message(error: sync_error)
                    return Err(Upstream(detail: message))
                }
            }
        }
        Err(error) => {
            return Err(error)
        }
    }
}

fn main() -> Unit {
    match push_amount(id: "order-1", raw: "42") {
        Ok(count) => {
            Metrics.record(name: "accepted", value: count)
        }
        Err(error) => {
            let text: String = PipelineError.detail(error: error)
            Metrics.record(name: text, value: 0)
        }
    }
}
