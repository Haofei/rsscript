// NOTE: no RSScript sources or `rss` toolchain were available in this
// environment, so the Json, Output and String signatures below follow the
// language card's naming conventions and have not been checked with `rss check`.

struct ServiceConfig {
    name: String,
    port: Int,
    enabled: Bool,
}

fn describe_json_error(error: read JsonError) -> String {
    return "invalid config: " + Json.error_message(error: error)
}

fn load_config(text: String) -> Result<fresh ServiceConfig, String> {
    match Json.parse(text: text) {
        Err(parse_error) => {
            return Err(describe_json_error(error: parse_error))
        }
        Ok(document) => {
            match Json.get_string(value: document, key: "name") {
                Err(name_error) => {
                    return Err(describe_json_error(error: name_error))
                }
                Ok(name) => {
                    match Json.get_int(value: document, key: "port") {
                        Err(port_error) => {
                            return Err(describe_json_error(error: port_error))
                        }
                        Ok(port) => {
                            if port < 1 {
                                return Err("port must be at least 1, got " + Int.to_string(value: port))
                            }
                            if port > 65535 {
                                return Err("port must be at most 65535, got " + Int.to_string(value: port))
                            }
                            local checked_name = name
                            return Ok(ServiceConfig(name: take checked_name, port: port, enabled: true))
                        }
                    }
                }
            }
        }
    }
}

fn main() -> Unit {
    let literal: String = "{\"name\": \"billing\", \"port\": 8080}"
    match load_config(text: literal) {
        Ok(config) => {
            Output.write(text: config.name)
        }
        Err(message) => {
            Output.write(text: message)
        }
    }
}
