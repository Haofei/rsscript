fn apply_settings(device: read String, settings: read List<String>, value: Int) -> Result<Int, String> {
    with DeviceSession.open(device: device)? as session {
        for setting in settings {
            match DeviceSession.apply(session: mut session, setting: setting, value: value) {
                Ok(_) => {
                    Audit.note(event: "applied")
                }
                Err(error) => {
                    Audit.note(event: "aborted setting")
                    Audit.note(event: setting)
                    return Err(error)
                }
            }
        }
        match DeviceSession.commit(session: mut session) {
            Ok(version) => {
                Audit.note(event: "committed")
                return Ok(version)
            }
            Err(error) => {
                return Err(error)
            }
        }
    }
}

fn main() -> Unit {
    let settings: List<String> = ["brightness", "contrast", "volume"]
    match apply_settings(device: "panel-1", settings: settings, value: 3) {
        Ok(_) => {
            Audit.note(event: "settings applied and committed")
        }
        Err(error) => {
            Audit.note(event: error)
        }
    }
}
