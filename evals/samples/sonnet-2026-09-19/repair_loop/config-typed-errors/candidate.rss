struct PumpConfig {
    name: String,
    interval_ms: Int,
    retries: Int,
}

sum ConfigError {
    MissingField(field: String),
    OutOfRange(field: String, value: Int),
}

fn ConfigError.describe(error: read ConfigError) -> fresh String {
    match error {
        MissingField(field) => {
            return String.concat(left: "missing field: ", right: field)
        }
        OutOfRange(field, value) => {
            let prefix = String.concat(left: "field out of range: ", right: field)
            let with_eq = String.concat(left: prefix, right: " = ")
            return String.concat(left: with_eq, right: Int.to_string(value: value))
        }
    }
}

fn validate(config: read PumpConfig) -> Result<Unit, ConfigError> {
    if String.is_empty(value: config.name) {
        return Err(MissingField(field: "name"))
    }
    if config.interval_ms < 100 || config.interval_ms > 60000 {
        return Err(OutOfRange(field: "interval_ms", value: config.interval_ms))
    }
    if config.retries < 0 || config.retries > 10 {
        return Err(OutOfRange(field: "retries", value: config.retries))
    }
    return Ok(Unit)
}

fn main() -> Unit {
    let config = PumpConfig(name: "main-pump", interval_ms: 500, retries: 3)
    match validate(config: config) {
        Ok(_) => {
            Output.write(message: config.name)
        }
        Err(error) => {
            Output.write(message: ConfigError.describe(error: error))
        }
    }
    return Unit
}
