struct Batch<T: Struct> {
    label: String
    items: List<T>
}

struct Reading {
    sensor: String
    value: Int
}

fn make_batch<T: Struct>(label: take String, items: take List<T>) -> fresh Batch<T> {
    return Batch(label: take label, items: take items)
}

fn batch_size<T: Struct>(batch: read Batch<T>) -> Int {
    return List.len(list: batch.items)
}

fn main() -> Unit {
    local sensor = "thermo"
    local reading = Reading(sensor: take sensor, value: 42)
    local items: List<Reading> = List.new()
    List.push(list: mut items, value: manage reading)
    local label = "daily"
    let batch: Batch<Reading> = make_batch(label: take label, items: take items)
    let size: Int = batch_size(batch: batch)
    Output.write(text: Int.to_string(value: size))
    return
}
