fn read_cursor(path: read String) -> Result<fresh String, String> {
    let mut value: String = ""
    with ConfigStore.open(path: path)? as store {
        value = ConfigStore.read_key(store: mut store, key: "cursor")?
    }
    return Ok(value)
}

async fn sync_next_page(path: read String) -> Result<String, String> {
    let cursor = read_cursor(path: path)?
    let fetched = await Sync.fetch_page(cursor: cursor)
    match fetched {
        Ok(page) => { return Ok(page) }
        Err(error) => { return Err(SyncError.message(error: error)) }
    }
}

fn main() -> Result<Unit, String> {
    let mut page: String = ""
    task_group {
        async let pending = sync_next_page(path: "config.db")
        let result = await pending
        page = result?
    }
    with ConfigStore.open(path: "config.db")? as store {
        ConfigStore.write_key(store: mut store, key: "page", value: page)?
    }
    return Ok(Unit)
}
