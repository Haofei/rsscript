sum Command {
    Ping,
    SetPoint(sensor: String, target: Int),
    Shutdown(reason: String),
}

fn apply_command(command: read Command, current: Int) -> Int {
    match command {
        Ping => { return current }
        SetPoint(sensor, target) => { return target }
        Shutdown(reason) => { return 0 }
    }
}

fn describe(command: read Command) -> fresh String {
    match command {
        Ping => { return "ping" }
        SetPoint(sensor, target) => {
            let head: String = String.concat(left: "set ", right: sensor)
            let middle: String = String.concat(left: head, right: " to ")
            return String.concat(left: middle, right: Int.to_string(value: target))
        }
        Shutdown(reason) => { return String.concat(left: "shutdown: ", right: reason) }
    }
}

fn main() -> Unit {
    let command: Command = SetPoint(sensor: "temperature", target: 42)
    let result: Int = apply_command(command: command, current: 7)
    Output.write(value: describe(command: command))
    Output.write(value: Int.to_string(value: result))
}
