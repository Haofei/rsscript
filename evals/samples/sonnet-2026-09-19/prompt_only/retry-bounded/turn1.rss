fn push_with_retry(id: read String, amount: Int, max_attempts: Int) -> Result<Int, String> {
    let mut attempt: Int = 0;
    let mut last_error: String = "no attempts made";

    while attempt < max_attempts {
        attempt = attempt + 1;

        match Sync.push(id, amount) {
            Ok(value) => {
                Metrics.record("sync.push.attempts", attempt);
                return Ok(value);
            }
            Err(error) => {
                last_error = SyncError.message(error);
                if !Sync.is_retryable(error) {
                    return Err(last_error);
                }
            }
        }
    }

    return Err(last_error);
}

fn main() -> Unit {
    match push_with_retry("order-1", 100, 3) {
        Ok(value) => {
            Metrics.record("sync.push.result", value);
        }
        Err(message) => {
            Metrics.record(message, 0);
        }
    }
}
