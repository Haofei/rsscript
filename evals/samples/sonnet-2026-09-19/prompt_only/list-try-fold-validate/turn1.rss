struct Tally {
    total: Int,
    count: Int,
}

fn add_amount(tally: Tally, raw: String) -> Result<fresh Tally, String> {
    match core::parse_int(raw) {
        Err(_) => Err("not an integer: " + raw),
        Ok(n) => {
            if n < 0 {
                return Err("negative amount: " + raw)
            }
            Ok(Tally { total: tally.total + n, count: tally.count + 1 })
        }
    }
}

fn tally_all(raws: read List<String>) -> Result<fresh Tally, String> {
    core::try_fold(raws, Tally { total: 0, count: 0 }, add_amount)
}

fn main() -> Unit {
    let raws = ["10", "25", "7"]
    match tally_all(raws) {
        Ok(t) => core::write("total: " + core::to_string(t.total)),
        Err(e) => core::write("error: " + e),
    }
}
