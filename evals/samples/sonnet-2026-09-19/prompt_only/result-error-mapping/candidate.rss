sum PipelineError {
    BadInput(detail: String),
    Upstream(detail: String),
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    match error {
        PipelineError.BadInput(detail) => "bad input: " + detail,
        PipelineError.Upstream(detail) => "upstream failure: " + detail,
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    match Int.parse(raw) {
        Some(value) => Ok(value),
        None => Err(PipelineError.BadInput(detail: "not an integer: " + raw)),
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    let amount = parse_amount(raw)?
    match Sync.push(id: id, amount: amount) {
        Ok(count) => Ok(count),
        Err(error) => Err(PipelineError.Upstream(detail: SyncError.message(error))),
    }
}

fn main() -> Unit {
    match push_amount("order-1", "42") {
        Ok(count) => print("accepted " + count.to_string()),
        Err(error) => print(PipelineError.detail(error)),
    }
}
