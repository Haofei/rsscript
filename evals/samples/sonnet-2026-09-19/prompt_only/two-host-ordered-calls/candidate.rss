fn ship(sku: read String, count: Int) -> Result<Int, String> {
    let reserved = match Inventory.reserve(sku, count) {
        Ok(n) => n,
        Err(message) => {
            return Err(message);
        }
    };

    match Sync.push(sku, reserved) {
        Ok(accepted) => {
            Metrics.record("ship.accepted", accepted);
            return Ok(accepted);
        }
        Err(error) => {
            Inventory.release(sku, reserved);
            return Err(SyncError.message(error));
        }
    }
}

fn main() -> Unit {
    match ship("sku-001", 3) {
        Ok(accepted) => {
            Metrics.record("main.outcome.ok", accepted);
        }
        Err(message) => {
            Metrics.record("main.outcome.error", 0);
        }
    }
}
