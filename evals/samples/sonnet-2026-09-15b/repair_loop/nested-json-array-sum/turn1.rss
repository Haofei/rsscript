fn sum_quantities(text: read String) -> Result<Int, JsonError> {
    let root = match Json.parse(text: text) {
        Ok(value) => { value }
        Err(error) => { return Err(error) }
    }

    let items = match Json.get_field(value: root, name: "items") {
        Ok(value) => { value }
        Err(error) => { return Err(error) }
    }

    let array = match Json.as_array(value: items) {
        Ok(value) => { value }
        Err(error) => { return Err(error) }
    }

    let mut total: Int = 0
    for element in array {
        let field = match Json.get_field(value: element, name: "quantity") {
            Ok(value) => { value }
            Err(error) => { return Err(error) }
        }
        let quantity = match Json.as_int(value: field) {
            Ok(value) => { value }
            Err(error) => { return Err(error) }
        }
        total = total + quantity
    }

    return Ok(total)
}

fn main() -> Unit {
    let text: String = "{\"items\": [{\"quantity\": 4}, {\"quantity\": 6}]}"
    match sum_quantities(text: text) {
        Ok(total) => { Console.print(text: Int.to_string(value: total)) }
        Err(error) => { Console.print(text: error.message) }
    }
}
