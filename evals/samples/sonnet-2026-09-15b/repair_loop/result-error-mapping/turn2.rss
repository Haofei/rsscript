sum PipelineError {
    BadInput(detail: String),
    Upstream(detail: String),
}

fn PipelineError.detail(error: read PipelineError) -> fresh String {
    return match error {
        BadInput(detail) => detail
        Upstream(detail) => detail
    }
}

fn parse_amount(raw: read String) -> Result<Int, PipelineError> {
    return match String.parse_int(value: raw) {
        Ok(value) => Ok(value)
        Err(message) => Err(BadInput(detail: message))
    }
}

fn push_amount(id: read String, raw: read String) -> Result<Int, PipelineError> {
    return match parse_amount(raw: raw) {
        Err(error) => Err(error)
        Ok(amount) => match Sync.push(id: id, amount: amount) {
            Ok(accepted) => Ok(accepted)
            Err(error) => Err(Upstream(detail: SyncError.message(error: error)))
        }
    }
}

fn main() -> Unit {
    return match push_amount(id: "acct-1", raw: "42") {
        Ok(accepted) => Metrics.record(name: "amounts.accepted", value: accepted)
        Err(error) => Metrics.record(name: PipelineError.detail(error: error), value: 0)
    }
}
