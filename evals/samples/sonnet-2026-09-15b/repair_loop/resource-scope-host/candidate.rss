fn copy_setting(path: read String, key: read String, target: read String) -> Result<Unit, String> {
    with ConfigStore.open(path: path)? as store {
        let value: String = ConfigStore.read_key(store: mut store, key: key)?
        ConfigStore.write_key(store: mut store, key: target, value: value)?
        return Ok(Unit)
    }
}

fn main() -> Unit {
    match copy_setting(path: "config.toml", key: "source_key", target: "target_key") {
        Ok(_) => {
            let report: String = "copy_setting succeeded"
        }
        Err(error) => {
            let report: String = error
        }
    }
}
