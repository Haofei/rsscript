struct Tally {
    total: Int,
    count: Int,
}

fn add_amount(tally: read Tally, raw: read String) -> Result<fresh Tally, String> {
    match String.parse_int(value: raw) {
        Ok(amount) => {
            if amount < 0 {
                return Err(String.concat(left: "negative amount: ", right: raw))
            }
            return Ok(Tally(total: tally.total + amount, count: tally.count + 1))
        },
        Err(_) => { return Err(String.concat(left: "not an integer: ", right: raw)) },
    }
}

fn tally_all(raws: read List<String>) -> Result<fresh Tally, String> {
    return List.try_fold(list: raws, init: Tally(total: 0, count: 0), f: add_amount)
}

fn main() -> Unit {
    let raws: List<String> = ["10", "25", "7"]
    match tally_all(raws: raws) {
        Ok(tally) => {
            Output.write(String.concat(left: "total: ", right: Int.to_string(value: tally.total)))
        },
        Err(message) => {
            Output.write(String.concat(left: "error: ", right: message))
        },
    }
}
