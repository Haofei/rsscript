class EventLog {
    entries: List<String>
    tags: List<String>
}

fn EventLog.new() -> EventLog {
    return EventLog(entries: List.new(), tags: List.new())
}

fn EventLog.record(log: mut EventLog, entry: read String, tag: read String) -> Unit
    retains(entry)
    retains(tag)
{
    List.push(list: mut log.entries, value: entry)
    List.push(list: mut log.tags, value: tag)
}

fn EventLog.size(log: read EventLog) -> Int {
    return List.length(list: log.entries)
}

fn debug_print(value: read String) -> Unit {
}

fn main() -> Unit {
    let mut log: EventLog = EventLog.new()
    EventLog.record(log: mut log, entry: "started", tag: "info")
    EventLog.record(log: mut log, entry: "finished", tag: "info")
    let size: Int = EventLog.size(log: log)
    debug_print(value: Int.to_string(value: size))
}
