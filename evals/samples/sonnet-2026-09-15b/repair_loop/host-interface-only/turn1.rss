fn publish_batch(ids: read List<String>, amount: Int) -> Result<Int, String> {
    let mut total: Int = 0
    for id in ids {
        match Sync.push(id: id, amount: amount) {
            Ok(value) => { total = total + value }
            Err(error) => { return Err(SyncError.message(error: error)) }
        }
    }
    Metrics.record(name: "batch_accepted_total", value: total)
    return Ok(total)
}

fn main() -> Unit {
    let ids: List<String> = ["order-1", "order-2"]
    let result = publish_batch(ids: ids, amount: 10)
    match result {
        Ok(total) => { Metrics.record(name: "batch_outcome_success", value: total) }
        Err(message) => { Metrics.record(name: "batch_outcome_failure", value: 0) }
    }
}
