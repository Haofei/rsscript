struct Alert {
    level: String,
    message: String,
}

fn select_alerts(alerts: read List<Alert>, keep: noescape Fn(Alert) -> Bool) -> fresh List<Alert> {
    return List.filter(list: alerts, predicate: keep)
}

fn urgent_only(alerts: read List<Alert>) -> fresh List<Alert> {
    let keep: Fn(Alert) -> Bool = fn(alert: Alert) -> Bool {
        return alert.level == "critical"
    }
    return select_alerts(alerts: alerts, keep: keep)
}

fn main() -> Unit {
    let alerts: List<Alert> = [
        Alert(level: "critical", message: "disk full"),
        Alert(level: "info", message: "backup complete"),
    ]
    let urgent: List<Alert> = urgent_only(alerts: alerts)
    Output.write(message: Dyn.from(value: urgent.length))
}
