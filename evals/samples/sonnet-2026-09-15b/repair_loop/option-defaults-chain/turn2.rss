struct Settings {
    region: String,
    retries: Int,
}

fn lookup(keys: read List<String>, values: read List<String>, key: read String) -> Option<String> {
    let mut index: Int = 0
    for candidate in keys {
        if candidate == key {
            let value: String = List.get(list: values, index: index)
            return Some(value)
        }
        index = index + 1
    }
    return None
}

fn settings_from(keys: read List<String>, values: read List<String>) -> fresh Settings {
    local region: String = match lookup(keys: keys, values: values, key: "region") {
        Some(value) => { value }
        None => { "us-east" }
    }
    let retries: Int = match lookup(keys: keys, values: values, key: "retries") {
        Some(value) => {
            match String.parse_int(value: value) {
                Some(parsed) => { parsed }
                None => { 3 }
            }
        }
        None => { 3 }
    }
    return Settings(region: take region, retries: retries)
}

fn main() -> Unit {
    let keys: List<String> = ["region", "retries"]
    let values: List<String> = ["us-west", "5"]
    let settings: Settings = settings_from(keys: keys, values: values)
    Output.write(value: settings.region)
    Output.write(value: Int.to_string(value: settings.retries))
}
