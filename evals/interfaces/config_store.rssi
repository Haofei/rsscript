// A scoped host resource. `ConfigStore` must be acquired with `with` so its
// cleanup runs, and it must not escape the scope that acquired it.

resource ConfigStore

pub fn ConfigStore.open(path: read String) -> Result<ConfigStore, String>

pub fn ConfigStore.read_key(store: mut ConfigStore, key: read String) -> Result<fresh String, String>

pub fn ConfigStore.write_key(
    store: mut ConfigStore,
    key: read String,
    value: read String,
) -> Result<Unit, String>
