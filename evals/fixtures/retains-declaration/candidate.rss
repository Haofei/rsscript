class EventLog {
    entries: List<String>
    tags: List<String>
}

fn EventLog.new() -> EventLog {
    return EventLog(entries: List.new<String>(), tags: List.new<String>())
}

fn EventLog.record(log: mut EventLog, entry: String, tag: String) -> Unit
    retains(entry)
    retains(tag)
{
    List.push<String>(list: mut log.entries, value: entry)
    List.push<String>(list: mut log.tags, value: tag)
}

fn EventLog.size(log: read EventLog) -> Int {
    return List.len<String>(list: log.entries)
}

fn main() -> Unit {
    let mut log = EventLog.new()
    EventLog.record(log: mut log, entry: "started", tag: "lifecycle")
    EventLog.record(log: mut log, entry: "finished", tag: "lifecycle")
    Output.write(message: String.from_int(value: EventLog.size(log: log)))
    return Unit
}
