struct Route {
    host: String
    port: Int
}

fn parse_route(raw: read String) -> Option<Route> {
    let parts = String.split(value: raw, delimiter: ":")
    if List.len<String>(list: parts) != 2 {
        return None
    }
    let host = String.trim(value: List.get<String>(list: parts, index: 0))
    let Some(port) = String.parse_int(value: String.trim(value: List.get<String>(list: parts, index: 1))) else {
        return None
    }
    if String.is_empty(value: host) {
        return None
    }
    return Some(Route(host: host, port: port))
}

fn describe_route(raw: read String) -> fresh String {
    let Some(route) = parse_route(raw: raw) else {
        return "unroutable"
    }
    return String.concat(
        left: String.concat(left: route.host, right: "/"),
        right: String.from_int(value: route.port),
    )
}

fn main() -> Unit {
    Output.write(message: describe_route(raw: "gateway: 8080"))
    Output.write(message: describe_route(raw: "gateway"))
    return Unit
}
