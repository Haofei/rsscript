struct Window {
    start: Int
    width: Int
}

fn field_of(line: read String, delimiter: read String) -> Option<String> {
    return String.after(value: line, delimiter: delimiter)
}

fn parsed_field(line: read String, delimiter: read String) -> Option<Int> {
    return Option.and_then<String, Int>(
        value: field_of(line: line, delimiter: delimiter),
        mapper: |raw| { return String.parse_int(value: String.trim(value: raw)) },
    )
}

fn window_from(line: read String) -> fresh Window {
    let raw_start = parsed_field(line: line, delimiter: "start=")
    let start = Option.unwrap_or<Int>(value: raw_start, default: 0)
    let raw_width = parsed_field(line: line, delimiter: "width=")
    let positive_width = Option.filter<Int>(value: raw_width, predicate: |value| { return value > 0 })
    let width = Option.unwrap_or<Int>(value: positive_width, default: 60)
    return Window(start: start, width: width)
}

fn main() -> Unit {
    let window = window_from(line: "start= 12")
    Output.write(message: String.from_int(value: window.start))
    Output.write(message: String.from_int(value: window.width))
    return Unit
}
