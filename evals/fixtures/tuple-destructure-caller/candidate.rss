fn split_levels(lines: read List<String>) -> (Int, Int, Int) {
    let mut errors = 0
    let mut warnings = 0
    let mut other = 0
    for line in lines {
        if String.starts_with(value: line, prefix: "error") {
            errors = errors + 1
        } else {
            if String.starts_with(value: line, prefix: "warn") {
                warnings = warnings + 1
            } else {
                other = other + 1
            }
        }
    }
    return (errors, warnings, other)
}

fn main() -> Unit {
    let (errors, warnings, other) = split_levels(lines: ["error disk", "warn heat", "info boot"])
    Output.write(message: String.from_int(value: errors))
    Output.write(message: String.from_int(value: warnings))
    Output.write(message: String.from_int(value: other))
    return Unit
}
