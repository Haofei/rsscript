fn push_until_accepted(id: read String, amount: Int, budget: Int) -> Result<Int, String> {
    let mut attempt = 0
    let mut last = "no attempt was made"
    while attempt < budget {
        attempt = attempt + 1
        match Sync.push(id: id, amount: amount) {
            Ok(accepted) => {
                Metrics.record(name: "push_attempts", value: attempt)
                return Ok(accepted)
            }
            Err(error) => {
                last = SyncError.message(error: error)
                if !Sync.is_retryable(error: error) {
                    return Err(last)
                }
            }
        }
    }
    return Err(last)
}

fn main() -> Unit {
    match push_until_accepted(id: "sensor-7", amount: 12, budget: 3) {
        Ok(accepted) => { Output.write(message: String.from_int(value: accepted)) }
        Err(message) => { Output.error(message: message) }
    }
    return Unit
}
