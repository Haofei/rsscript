struct ToolRequest {
    id: String
    name: String
    arguments: String
}

struct ToolOutput {
    content: String
    is_error: Bool
}

struct ToolAction {
    response: Option<ToolOutput>
    finish: Bool
    abort: Bool
    final_answer: String
}

pub fn ToolRequest.new(id: read String, name: read String, arguments: read String) -> fresh ToolRequest

pub fn ToolOutput.respond(content: read String) -> fresh ToolOutput

pub fn ToolOutput.error(content: read String) -> fresh ToolOutput

pub fn ToolAction.respond(content: read String) -> fresh ToolAction

pub fn ToolAction.error(content: read String) -> fresh ToolAction

pub fn ToolAction.finish(answer: read String) -> fresh ToolAction
