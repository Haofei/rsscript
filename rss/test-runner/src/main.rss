features: local

struct TestCase {
    name: String
    kind: String
    path: String
    paths: List<String>
    directory: String
    extension: String
    recursive: Bool
    command: String
    args: List<String>
    jobs: Int
    contains: String
    contains_all: List<String>
    ignored: Bool
}

struct TestRunSummary {
    total: Int
    selected: Int
    passed: Int
    failed: Int
    skipped: Int
}

fn json_error(prefix: read String, error: read JsonError) -> fresh String {
    let message = JsonError.message(error: read error)
    let label = String.concat(left: read prefix, right: read ": ")

    return String.concat(left: read label, right: read message)
}

fn file_error(prefix: read String, error: read FileError) -> fresh String {
    let message = FileError.message(error: read error)
    let label = String.concat(left: read prefix, right: read ": ")

    return String.concat(left: read label, right: read message)
}

fn read_text_file(path: read Path) -> Result<String, FileError> {
    with File.open_read(path: read path)? as file {
        let text = File.read_all_string(file: mut file)?

        return Ok(text)
    }
}

fn read_text(path: read Path) -> Result<String, String> {
    match read_text_file(path: read path) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(file_error(prefix: read "read file", error: read error))
        }
    }
}

fn parse_manifest(path: read Path) -> Result<fresh JsonValue, String> {
    match Toml.parse_file(path: read path) {
        Ok(value) => {
            return Ok(value)
        }
        Err(error) => {
            return Err(json_error(prefix: read "test manifest parse", error: read error))
        }
    }
}

fn json_field(value: read JsonValue, name: read String) -> Result<JsonValue, String> {
    match Json.field(value: read value, name: read name) {
        Ok(field) => {
            return Ok(field)
        }
        Err(error) => {
            return Err(json_error(prefix: read "test manifest field", error: read error))
        }
    }
}

fn json_string(value: read JsonValue, name: read String) -> Result<String, String> {
    match Json.field_string(value: read value, name: read name) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(json_error(prefix: read "test manifest string", error: read error))
        }
    }
}

fn json_string_or_default(
    value: read JsonValue,
    name: read String,
    default: read String,
) -> fresh String {
    match Json.field_string(value: read value, name: read name) {
        Ok(text) => {
            return String.concat(left: read "", right: read text)
        }
        Err(_) => {
            return String.concat(left: read "", right: read default)
        }
    }
}

fn json_string_list_or_empty(value: read JsonValue, name: read String) -> fresh List<String> {
    match Json.field(value: read value, name: read name) {
        Ok(field) => {
            match Json.array_strings(value: read field) {
                Ok(items) => {
                    return items
                }
                Err(_) => {
                    return List<String>.new()
                }
            }
        }
        Err(_) => {
            return List<String>.new()
        }
    }
}

fn json_bool_or_default(
    value: read JsonValue,
    name: read String,
    default: Bool,
) -> Bool {
    match Json.field_bool(value: read value, name: read name) {
        Ok(flag) => {
            return flag
        }
        Err(_) => {
            return default
        }
    }
}

fn json_int_or_default(
    value: read JsonValue,
    name: read String,
    default: Int,
) -> Int {
    match Json.field_int(value: read value, name: read name) {
        Ok(number) => {
            return number
        }
        Err(_) => {
            return default
        }
    }
}

fn test_case_from_json(value: read JsonValue) -> Result<fresh TestCase, String> {
    return Ok(TestCase(
        name: json_string(value: read value, name: read "name")?,
        kind: json_string(value: read value, name: read "kind")?,
        path: json_string_or_default(value: read value, name: read "path", default: read ""),
        paths: json_string_list_or_empty(value: read value, name: read "paths"),
        directory: json_string_or_default(value: read value, name: read "directory", default: read ""),
        extension: json_string_or_default(value: read value, name: read "extension", default: read ""),
        recursive: json_bool_or_default(value: read value, name: read "recursive", default: true),
        command: json_string_or_default(value: read value, name: read "command", default: read ""),
        args: json_string_list_or_empty(value: read value, name: read "args"),
        jobs: json_int_or_default(value: read value, name: read "jobs", default: 0),
        contains: json_string_or_default(value: read value, name: read "contains", default: read ""),
        contains_all: json_string_list_or_empty(value: read value, name: read "contains_all"),
        ignored: json_bool_or_default(value: read value, name: read "ignored", default: false),
    ))
}

fn parse_tests_from(
    tests: read JsonValue,
    index: Int,
    limit: Int,
    items: mut List<TestCase>,
) -> Result<Unit, String> {
    if index >= limit {
        return Ok(Unit)
    }

    match Json.array_get(value: read tests, index: index) {
        Ok(item) => {
            let test = test_case_from_json(value: read item)?
            List.push(list: mut items, value: read test)
        }
        Err(error) => {
            return Err(json_error(prefix: read "test manifest item", error: read error))
        }
    }

    return parse_tests_from(
        tests: read tests,
        index: index + 1,
        limit: limit,
        items: mut items,
    )
}

fn load_tests(manifest: read JsonValue) -> Result<fresh List<TestCase>, String> {
    let tests = json_field(value: read manifest, name: read "tests")?
    match Json.array_len(value: read tests) {
        Ok(limit) => {
            local items = List<TestCase>.new()
            parse_tests_from(tests: read tests, index: 0, limit: limit, items: mut items)?

            return Ok(items)
        }
        Err(error) => {
            return Err(json_error(prefix: read "test manifest tests", error: read error))
        }
    }
}

fn test_matches_filter(test: read TestCase, filter: read String) -> Bool {
    if String.is_empty(value: read filter) {
        return true
    }

    return String.contains(value: read test.name, needle: read filter)
}

fn text_contains_required(value: read String, required: read String) -> Bool {
    if String.is_empty(value: read required) {
        return true
    }

    return String.contains(value: read value, needle: read required)
}

fn text_contains_all_from(
    value: read String,
    needles: read List<String>,
    index: Int,
) -> Bool {
    if index >= List.len(list: read needles) {
        return true
    }

    let needle = List.get(list: read needles, index: index)
    if String.contains(value: read value, needle: read needle) == false {
        return false
    }

    return text_contains_all_from(
        value: read value,
        needles: read needles,
        index: index + 1,
    )
}

fn text_matches_expectations(
    value: read String,
    contains: read String,
    contains_all: read List<String>,
) -> Result<Bool, String> {
    if text_contains_required(value: read value, required: read contains) == false {
        return Ok(false)
    }

    return Ok(text_contains_all_from(
        value: read value,
        needles: read contains_all,
        index: 0,
    ))
}

fn copy_args_from(
    source: read List<String>,
    index: Int,
    target: mut List<String>,
) -> Unit {
    if index >= List.len(list: read source) {
        return Unit
    }

    let arg = List.get(list: read source, index: index)
    List.push(list: mut target, value: read arg)

    return copy_args_from(source: read source, index: index + 1, target: mut target)
}

fn append_arg(args: read List<String>, arg: read String) -> fresh List<String> {
    local next = List<String>.new()
    copy_args_from(source: read args, index: 0, target: mut next)
    List.push(list: mut next, value: read arg)

    return next
}

fn rss_binary_command(command: read String) -> String {
    if String.is_empty(value: read command) {
        return "target/debug/rss"
    }

    return String.concat(left: read "", right: read command)
}

fn rss_run_args(path: read String, program_args: read List<String>) -> fresh List<String> {
    local args = List<String>.new()
    List.push(list: mut args, value: read "run")
    List.push(list: mut args, value: read path)
    copy_args_from(source: read program_args, index: 0, target: mut args)

    return args
}

fn command_with_windows_exe_suffix(command: read String) -> fresh String {
    return String.concat(left: read command, right: read ".exe")
}

fn run_command_stdout(command: read String, args: read List<String>) -> Result<String, String> {
    match Process.run_stdout(command: read command, args: read args) {
        Ok(stdout) => {
            return Ok(stdout)
        }
        Err(first_error) => {
            if String.ends_with(value: read command, suffix: read ".exe") {
                return Err(first_error)
            }

            match Process.run_stdout(
                command: read command_with_windows_exe_suffix(command: read command),
                args: read args,
            ) {
                Ok(stdout) => {
                    return Ok(stdout)
                }
                Err(_) => {
                    return Err(first_error)
                }
            }
        }
    }
}

fn run_command_success(command: read String, args: read List<String>) -> Result<Bool, String> {
    match run_command_stdout(command: read command, args: read args) {
        Ok(_) => {
            return Ok(true)
        }
        Err(error) => {
            return Err(error)
        }
    }
}

fn run_rss_source_stdout(test: read TestCase) -> Result<String, String> {
    let command = rss_binary_command(command: read test.command)
    let args = rss_run_args(path: read test.path, program_args: read test.args)

    return run_command_stdout(command: read command, args: read args)
}

fn run_rss_source_success(test: read TestCase) -> Result<Bool, String> {
    match run_rss_source_stdout(test: read test) {
        Ok(_) => {
            return Ok(true)
        }
        Err(error) => {
            return Err(error)
        }
    }
}

fn run_rss_source_failure_contains(test: read TestCase) -> Result<Bool, String> {
    match run_rss_source_stdout(test: read test) {
        Ok(_) => {
            return Ok(false)
        }
        Err(error) => {
            return text_matches_expectations(
                value: read error,
                contains: read test.contains,
                contains_all: read test.contains_all,
            )
        }
    }
}

fn path_allows_recursive(path: read String, recursive: Bool) -> Bool {
    if recursive {
        return true
    }

    if String.contains(value: read path, needle: read "/") {
        return false
    }

    return String.contains(value: read path, needle: read "\\") == false
}

fn joined_path(directory: read String, file: read String) -> fresh String {
    if String.ends_with(value: read directory, suffix: read "/") {
        return String.concat(left: read directory, right: read file)
    }

    return String.concat(
        left: read String.concat(left: read directory, right: read "/"),
        right: read file,
    )
}

fn run_command_for_path(
    command: read String,
    args: read List<String>,
    path: read String,
) -> Result<Bool, String> {
    let next_args = append_arg(args: read args, arg: read path)

    return run_command_success(command: read command, args: read next_args)
}

fn collect_paths_from(
    paths: read List<String>,
    index: Int,
    selected: mut List<String>,
) -> Unit {
    if index >= List.len(list: read paths) {
        return Unit
    }

    let path = List.get(list: read paths, index: index)
    Log.write(message: read String.concat(left: read "run ", right: read path))
    List.push(list: mut selected, value: read path)

    return collect_paths_from(
        paths: read paths,
        index: index + 1,
        selected: mut selected,
    )
}

fn collect_files_from(
    directory: read String,
    extension: read String,
    recursive: Bool,
    files: read List<String>,
    index: Int,
    selected: mut List<String>,
) -> Unit {
    if index >= List.len(list: read files) {
        return Unit
    }

    let file = List.get(list: read files, index: index)
    if path_allows_recursive(path: read file, recursive: recursive) {
        if String.ends_with(value: read file, suffix: read extension) {
            let path = joined_path(directory: read directory, file: read file)
            Log.write(message: read String.concat(left: read "run ", right: read path))
            List.push(list: mut selected, value: read path)
        }
    }

    return collect_files_from(
        directory: read directory,
        extension: read extension,
        recursive: recursive,
        files: read files,
        index: index + 1,
        selected: mut selected,
    )
}

fn run_command_with_appended_args(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
) -> Result<Bool, String> {
    match Process.run_many_stdout(
        command: read command,
        args: read args,
        appended_args: read appended_args,
        jobs: jobs,
    ) {
        Ok(_) => {
            return Ok(true)
        }
        Err(error) => {
            return Err(error)
        }
    }
}

fn run_test(test: read TestCase) -> Result<Bool, String> {
    if test.kind == "file_contains" {
        let text = read_text(path: read Path.from_string(value: read test.path))?
        return text_matches_expectations(
            value: read text,
            contains: read test.contains,
            contains_all: read test.contains_all,
        )
    }

    if test.kind == "command_stdout_contains" {
        match run_command_stdout(command: read test.command, args: read test.args) {
            Ok(stdout) => {
                return text_matches_expectations(
                    value: read stdout,
                    contains: read test.contains,
                    contains_all: read test.contains_all,
                )
            }
            Err(error) => {
                return Err(error)
            }
        }
    }

    if test.kind == "command_success" {
        return run_command_success(command: read test.command, args: read test.args)
    }

    if test.kind == "rss_run_success" {
        return run_rss_source_success(test: read test)
    }

    if test.kind == "rss_run_stdout_contains" {
        match run_rss_source_stdout(test: read test) {
            Ok(stdout) => {
                return text_matches_expectations(
                    value: read stdout,
                    contains: read test.contains,
                    contains_all: read test.contains_all,
                )
            }
            Err(error) => {
                return Err(error)
            }
        }
    }

    if test.kind == "rss_run_failure_contains" {
        return run_rss_source_failure_contains(test: read test)
    }

    if test.kind == "command_for_each_path" {
        local selected = List<String>.new()
        collect_paths_from(
            paths: read test.paths,
            index: 0,
            selected: mut selected,
        )
        return run_command_with_appended_args(
            command: read test.command,
            args: read test.args,
            appended_args: read selected,
            jobs: test.jobs,
        )
    }

    if test.kind == "command_for_each_file" {
        match Directory.list_files(path: read Path.from_string(value: read test.directory)) {
            Ok(files) => {
                local selected = List<String>.new()
                collect_files_from(
                    directory: read test.directory,
                    extension: read test.extension,
                    recursive: test.recursive,
                    files: read files,
                    index: 0,
                    selected: mut selected,
                )
                return run_command_with_appended_args(
                    command: read test.command,
                    args: read test.args,
                    appended_args: read selected,
                    jobs: test.jobs,
                )
            }
            Err(error) => {
                return Err(file_error(prefix: read "list files", error: read error))
            }
        }
    }

    return Err(String.concat(left: read "unsupported test kind ", right: read test.kind))
}

fn print_test_line(status: read String, name: read String) -> Unit {
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: read status)
    StringBuilder.push(builder: mut builder, value: read " ")
    StringBuilder.push(builder: mut builder, value: read name)
    let line = StringBuilder.finish(builder: take builder)
    Log.write(message: read line)
}

fn record_selected(summary: read TestRunSummary) -> fresh TestRunSummary {
    return TestRunSummary(
        total: summary.total,
        selected: summary.selected + 1,
        passed: summary.passed,
        failed: summary.failed,
        skipped: summary.skipped,
    )
}

fn record_passed(summary: read TestRunSummary) -> fresh TestRunSummary {
    return TestRunSummary(
        total: summary.total,
        selected: summary.selected,
        passed: summary.passed + 1,
        failed: summary.failed,
        skipped: summary.skipped,
    )
}

fn record_failed(summary: read TestRunSummary) -> fresh TestRunSummary {
    return TestRunSummary(
        total: summary.total,
        selected: summary.selected,
        passed: summary.passed,
        failed: summary.failed + 1,
        skipped: summary.skipped,
    )
}

fn record_skipped(summary: read TestRunSummary) -> fresh TestRunSummary {
    return TestRunSummary(
        total: summary.total,
        selected: summary.selected,
        passed: summary.passed,
        failed: summary.failed,
        skipped: summary.skipped + 1,
    )
}

fn copy_summary(summary: read TestRunSummary) -> fresh TestRunSummary {
    return TestRunSummary(
        total: summary.total,
        selected: summary.selected,
        passed: summary.passed,
        failed: summary.failed,
        skipped: summary.skipped,
    )
}

fn execute_selected_test(
    summary: read TestRunSummary,
    test: read TestCase,
) -> Result<fresh TestRunSummary, String> {
    let selected = record_selected(summary: read summary)
    if test.ignored {
        print_test_line(status: read "skip", name: read test.name)
        return Ok(record_skipped(summary: read selected))
    }

    match run_test(test: read test) {
        Ok(ok) => {
            if ok {
                print_test_line(status: read "pass", name: read test.name)
                return Ok(record_passed(summary: read selected))
            }

            print_test_line(status: read "fail", name: read test.name)
            return Ok(record_failed(summary: read selected))
        }
        Err(error) => {
            print_test_line(status: read "fail", name: read test.name)
            Log.write(message: read error)
            return Ok(record_failed(summary: read selected))
        }
    }
}

fn run_tests(
    tests: read List<TestCase>,
    filter: read String,
) -> Result<fresh TestRunSummary, String> {
    let initial = TestRunSummary(
        total: List.len(list: read tests),
        selected: 0,
        passed: 0,
        failed: 0,
        skipped: 0,
    )

    return List.try_fold<TestCase, TestRunSummary, String>(
        list: read tests,
        initial: read initial,
        folder: |summary, test| {
            if test_matches_filter(test: read test, filter: read filter) == false {
                return Ok(copy_summary(summary: read summary))
            }

            return execute_selected_test(summary: read summary, test: read test)
        },
    )
}

fn summary_line(summary: read TestRunSummary) -> fresh String {
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: read "rss test summary total=")
    StringBuilder.push(builder: mut builder, value: read String.from_int(value: summary.total))
    StringBuilder.push(builder: mut builder, value: read " selected=")
    StringBuilder.push(builder: mut builder, value: read String.from_int(value: summary.selected))
    StringBuilder.push(builder: mut builder, value: read " passed=")
    StringBuilder.push(builder: mut builder, value: read String.from_int(value: summary.passed))
    StringBuilder.push(builder: mut builder, value: read " failed=")
    StringBuilder.push(builder: mut builder, value: read String.from_int(value: summary.failed))
    StringBuilder.push(builder: mut builder, value: read " skipped=")
    StringBuilder.push(builder: mut builder, value: read String.from_int(value: summary.skipped))

    return StringBuilder.finish(builder: take builder)
}

pub fn RssTest.run(manifest_path: read Path, filter: read String) -> Result<Unit, String> {
    let manifest = parse_manifest(path: read manifest_path)?
    let tests = load_tests(manifest: read manifest)?
    let summary = run_tests(tests: read tests, filter: read filter)?
    let line = summary_line(summary: read summary)
    Log.write(message: read line)

    if summary.failed > 0 {
        return Err("rss test failures")
    }

    return Ok(Unit)
}

fn main() -> Result<Unit, String> {
    let manifest = Args.get_or_default(
        index: 0,
        default: read "rss/test-runner/examples/rss-smoke.rsstest.toml",
    )
    let filter = Args.get_or_default(index: 1, default: read "")

    return RssTest.run(
        manifest_path: read Path.from_string(value: read manifest),
        filter: read filter,
    )
}
