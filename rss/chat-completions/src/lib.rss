features: local

pub struct ChatMessage {
    value: JsonValue
}

pub fn ChatMessage.system(content: read String) -> fresh ChatMessage {
    local value = Json.value(value: read {"role": "system", "content": content})
    return ChatMessage(value: take value)
}

pub fn ChatMessage.user(content: read String) -> fresh ChatMessage {
    local value = Json.value(value: read {"role": "user", "content": content})
    return ChatMessage(value: take value)
}

pub fn ChatMessage.assistant(content: read String) -> fresh ChatMessage {
    local value = Json.value(value: read {"role": "assistant", "content": content})
    return ChatMessage(value: take value)
}

pub fn ChatMessage.tool(request: read ToolRequest, output: read ToolOutput) -> fresh ChatMessage {
    local value = Json.value(value: read {
        "role": "tool",
        "tool_call_id": request.id,
        "content": output.content,
    })
    return ChatMessage(
        value: take value,
    )
}

pub fn ChatMessage.value(message: read ChatMessage) -> fresh JsonValue {
    return message.value.clone()
}

fn chat_message_values(messages: read List<ChatMessage>) -> fresh JsonValue {
    let mut values = List<JsonValue>.new()
    for message in messages {
        mut values.push(message.value)
    }
    return values.to_json_values()
}

pub fn ChatRequest.openai_compatible(
    model: read String,
    messages: read List<ChatMessage>,
    tools: read JsonValue,
) -> fresh JsonValue {
    return {"model": model, "messages": chat_message_values(messages), "tools": tools, "stream": false}
}

pub fn ChatResponse.content(response: read String) -> fresh String {
    match response.json_parse() {
        Ok(root) => {
            match root.at_optional_string("choices[0].message.content") {
                Ok(content) => {
                    match content {
                        Some(text) => {
                            return text.copy()
                        }
                        None => {
                            return response.copy()
                        }
                    }
                }
                Err => {
                    return response.copy()
                }
            }
        }
        Err => {
            return response.copy()
        }
    }
}

pub fn ChatResponse.usage(response: read String) -> fresh TokenUsage {
    return TokenUsage.from_response_text(text: read response)
}

fn assistant_fallback_message(content: read String) -> fresh JsonValue {
    return {"role": "assistant", "content": content}
}

pub fn ChatResponse.assistant_message(response: read String) -> fresh ChatMessage {
    match response.json_parse() {
        Ok(root) => {
            return ChatMessage(value: root.at_or("choices[0].message", assistant_fallback_message(response)))
        }
        Err => {
            return ChatMessage.assistant(content: read response)
        }
    }
}

fn tool_call_at(message: read JsonValue, index: Int) -> Result<fresh JsonValue, JsonError> {
    let calls = message.field("tool_calls")?
    return calls.array_get(index)
}

fn tool_call_count(message: read JsonValue) -> Int {
    match message.field("tool_calls") {
        Ok(calls) => {
            return calls.array_len().unwrap_or(0)
        }
        Err => {
            return 0
        }
    }
}

fn tool_request_from_call(call: read JsonValue) -> Result<fresh ToolRequest, JsonError> {
    let id = call.field_string("id")?
    let name = call.at_string("function.name")?
    let arguments = call.at_string("function.arguments")?
    return Ok(ToolRequest.new(id: read id, name: read name, arguments: read arguments))
}

fn tool_request_at(message: read JsonValue, index: Int) -> Option<ToolRequest> {
    match tool_call_at(message, index) {
        Ok(call) => {
            return tool_request_from_call(call).ok()
        }
        Err => {
            return None
        }
    }
}

pub fn ChatResponse.tool_requests(message: read ChatMessage) -> List<ToolRequest> {
    let mut requests = List<ToolRequest>.new()
    let limit = tool_call_count(message.value)
    let mut index = 0
    while index < limit {
        if let Some(request) = tool_request_at(message.value, index) {
            mut requests.push(request)
        }
        index = index + 1
    }
    return requests
}
