features: async, native, local

// Async process IO runs blocking OS process work through the async runtime
// provider. The RSScript surface stays explicit: command, args, timeout, and
// result type are visible in the signature.

pub async native fn Process.run_async(
    command: read String,
    args: read List<String>,
) -> Result<fresh ProcessOutput, String>
    effects(native)

pub async native fn Process.run_timeout_async(
    command: read String,
    args: read List<String>,
    timeout_ms: Int,
) -> Result<fresh ProcessOutput, String>
    effects(native)

pub async native fn Process.run_stdout_async(
    command: read String,
    args: read List<String>,
) -> Result<String, String>
    effects(native)

pub async native fn Process.run_stdout_timeout_async(
    command: read String,
    args: read List<String>,
    timeout_ms: Int,
) -> Result<String, String>
    effects(native)

pub async native fn Process.run_many_stdout_async(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
) -> Result<List<String>, String>
    effects(native)

pub async native fn Process.run_many_stdout_timeout_async(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
    timeout_ms: Int,
) -> Result<List<String>, String>
    effects(native)
