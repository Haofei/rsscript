fn run_diff(root: read Path, other: read Path, output: read Path) -> Result<Unit, String> {
    let before = package_review_facts(root: read root)?
    let after = package_review_facts(root: read other)?
    let before_snapshots = package_interface_snapshots(root: read root)?
    let after_snapshots = package_interface_snapshots(root: read other)?
    let facts = DiffFacts(
        package_name: read before.package_name,
        added_apis: added_api_count(before: before.public_apis, after: after.public_apis),
        removed_apis: removed_api_count(before: before.public_apis, after: after.public_apis),
        changed_interfaces: count_removed_snapshots(
                left: read before_snapshots,
                right: read after_snapshots,
                index: 0,
            ) + count_added_snapshots(
                left: read before_snapshots,
                right: read after_snapshots,
                index: 0,
            ) + count_modified_snapshots(
                left: read before_snapshots,
                right: read after_snapshots,
                index: 0,
            ),
        risk_changed: package_review_risk(facts: read before) != package_review_risk(facts: read after),
    )
    let text = package_diff_json(facts: read facts)
    write_text_result(path: read output, text: read text)?

    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: read "rss package manager diff ")
    StringBuilder.push(builder: mut builder, value: read before.package_name)
    StringBuilder.push(builder: mut builder, value: read " changed_interfaces=")
    let changed_interfaces = String.from_int(value: facts.changed_interfaces)
    StringBuilder.push(builder: mut builder, value: read changed_interfaces)
    let message = StringBuilder.finish(builder: take builder)
    Log.write(message: read message)

    return Ok(Unit)
}

