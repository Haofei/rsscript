    StringBuilder.push(builder: mut builder, value: read ",\n  \"ok\": ")
    let ok = json_bool_text(value: facts.ok)
    StringBuilder.push(builder: mut builder, value: read ok)
    StringBuilder.push(builder: mut builder, value: read ",\n  \"errors\": ")
    let errors = String.from_int(value: facts.errors)
    StringBuilder.push(builder: mut builder, value: read errors)
    StringBuilder.push(builder: mut builder, value: read "\n}\n")

    return StringBuilder.finish(builder: take builder)
}

fn package_publish_check_facts(root: read Path) -> Result<fresh PublishCheckFacts, String> {
    let manifest = parse_toml_result(path: read manifest_path(root: read root))?
    let package_name = manifest_package_string_or_empty(manifest: read manifest, field: read "name")
    let version = manifest_package_string_or_empty(manifest: read manifest, field: read "version")
    let edition = manifest_package_string_or_empty(manifest: read manifest, field: read "edition")
    let source_roots = manifest_array_strings_or_empty(
        manifest: read manifest,
        section: read "sources",
        field: read "paths",
    )
    let interface_summary = package_interface_summary(root: read root)?
    let source_files = count_existing_root_files_with_suffix(
        root: read root,
        children: read source_roots,
        suffix: read ".rss",
    )?
    let missing_name = bool_count(value: String.len(value: read package_name) == 0)
    let missing_version = bool_count(value: String.len(value: read version) == 0)
    let missing_edition = bool_count(value: String.len(value: read edition) == 0)
    let missing_interfaces = bool_count(value: interface_summary.interface_files == 0)
    let missing_sources = bool_count(value: source_files == 0)
    let errors = missing_name + missing_version + missing_edition + missing_interfaces + missing_sources + interface_summary.empty_files + interface_summary.non_public_files

    return PublishCheckFacts(
        package_name: read package_name,
        version: read version,
        interface_files: interface_summary.interface_files,
        source_files: source_files,
        public_apis: interface_summary.public_apis,
        ok: errors == 0,
        errors: errors,
    )
}

