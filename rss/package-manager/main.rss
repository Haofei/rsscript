fn add_review_line(facts: read PackageReviewFacts, line: read String) -> fresh PackageReviewFacts {
    let trimmed = String.trim(value: read line)
    let is_type = String.starts_with(value: read trimmed, prefix: read "struct ")
    let is_public_type = String.starts_with(value: read trimmed, prefix: read "pub struct ")
    let is_fn = String.starts_with(value: read trimmed, prefix: read "pub fn ")
    let is_native_fn = String.starts_with(value: read trimmed, prefix: read "pub native fn ")
    let is_api = is_fn || is_native_fn
    let has_mut = String.contains(value: read trimmed, needle: read " mut ")
    let has_retains = String.contains(value: read trimmed, needle: read "effects(retains")
    let has_resource_pool = String.contains(value: read trimmed, needle: read "ResourcePool")
    let has_resource_name = String.contains(value: read trimmed, needle: read "resource")
    let has_resource = has_resource_pool || has_resource_name
    let has_fresh = String.contains(value: read trimmed, needle: read "fresh ")
    let has_native = is_native_fn || String.contains(value: read trimmed, needle: read "effects(native")
    let has_parallel = String.contains(value: read trimmed, needle: read "parallel")
    let has_unsafe = String.contains(value: read trimmed, needle: read "unsafe")
    let has_unknown = String.contains(value: read trimmed, needle: read "unknown")

    return PackageReviewFacts(
        package_name: read facts.package_name,
        public_types: facts.public_types + bool_count(value: is_type || is_public_type),
        public_apis: facts.public_apis + bool_count(value: is_api),
        mutating_apis: facts.mutating_apis + bool_count(value: is_api && has_mut),
        retaining_apis: facts.retaining_apis + bool_count(value: is_api && has_retains),
        resource_apis: facts.resource_apis + bool_count(value: is_api && has_resource),
        fresh_apis: facts.fresh_apis + bool_count(value: is_api && has_fresh),
        native_apis: facts.native_apis + bool_count(value: is_api && has_native),
        parallel_apis: facts.parallel_apis + bool_count(value: is_api && has_parallel),
        unsafe_apis: facts.unsafe_apis + bool_count(value: is_api && has_unsafe),
        unknown_apis: facts.unknown_apis + bool_count(value: is_api && has_unknown),
    )
}

fn review_interface_file(
    root: read Path,
    child: read String,
    file: read String,
    facts: read PackageReviewFacts,
) -> Result<fresh PackageReviewFacts, String> {
    if String.ends_with(value: read file, suffix: read ".rssi") == false {
        return Ok(copy_package_review_facts(facts: read facts))
    }

    let directory = Path.join(base: read root, child: read child)
    let path = Path.join(base: read directory, child: read file)
    let text = read_text_result(path: read path)?
    let lines = String.lines(value: read text)

    return List.fold<String, PackageReviewFacts>(
        list: read lines,
        initial: read facts,
        folder: |state, line| {
            return add_review_line(facts: read state, line: read line)
        },
    )
}

fn review_interface_root(
    root: read Path,
    child: read String,
    facts: read PackageReviewFacts,
) -> Result<fresh PackageReviewFacts, String> {
    let directory = Path.join(base: read root, child: read child)
    require_directory(path: read directory, label: read child)?
    let files = list_files_result(path: read directory)?

    return List.try_fold<String, PackageReviewFacts, String>(
        list: read files,
        initial: read facts,
        folder: |state, file| {
            return review_interface_file(
                root: read root,
                child: read child,
                file: read file,
                facts: read state,
            )
        },
    )
}

fn package_review_facts(root: read Path) -> Result<fresh PackageReviewFacts, String> {
    let manifest = parse_toml_result(path: read manifest_path(root: read root))?
    let package = json_field_result(value: read manifest, name: read "package")?
    let package_name = json_field_string_result(value: read package, name: read "name")?
    let interface_roots = manifest_interface_roots(manifest: read manifest)?

    return List.try_fold<String, PackageReviewFacts, String>(
        list: read interface_roots,
        initial: read empty_package_review_facts(package_name: read package_name),
        folder: |facts, child| {
            return review_interface_root(root: read root, child: read child, facts: read facts)
        },
    )
}

fn manifest_dependencies(manifest: read JsonValue) -> Result<Option<JsonValue>, String> {
    match Json.field(value: read manifest, name: read "dependencies") {
        Ok(dependencies) => {
            return Ok(Some(dependencies))
        }
        Err(_) => {
            return Ok(None)
        }
    }
}

fn add_dependency_tree(
    root: read Path,
    dependencies: read JsonValue,
    facts: read PackageTreeFacts,
    name: read String,
) -> Result<fresh PackageTreeFacts, String> {
    let spec = json_field_result(value: read dependencies, name: read name)?

    if Json.is_object(value: read spec) {
        match Json.field_string(value: read spec, name: read "path") {
            Ok(path) => {
                let dependency_root = Path.join(base: read root, child: read path)
                let dependency_facts = package_tree_facts(root: read dependency_root)?

                return add_path_dependency(
                    facts: read facts,
                    dependency: read dependency_facts,
                )
            }
            Err(_) => {
                return add_unresolved_dependency(facts: read facts)
            }
        }
    }

    return add_unresolved_dependency(facts: read facts)
}

fn add_dependencies_tree(
    root: read Path,
    dependencies: read JsonValue,
    facts: read PackageTreeFacts,
) -> Result<fresh PackageTreeFacts, String> {
    let names = json_object_keys_result(value: read dependencies)?

    return List.try_fold<String, PackageTreeFacts, String>(
        list: read names,
        initial: read facts,
        folder: |state, name| {
            return add_dependency_tree(
                root: read root,
                dependencies: read dependencies,
                facts: read state,
                name: read name,
            )
        },
    )
}

fn package_tree_facts(root: read Path) -> Result<fresh PackageTreeFacts, String> {
    let manifest = parse_toml_result(path: read manifest_path(root: read root))?
    let package = json_field_result(value: read manifest, name: read "package")?
    let package_name = json_field_string_result(value: read package, name: read "name")?
    local facts = empty_package_tree_facts(package_name: read package_name)

    match manifest_dependencies(manifest: read manifest)? {
        Some(dependencies) => {
            return add_dependencies_tree(
                root: read root,
                dependencies: read dependencies,
                facts: read facts,
            )
        }
        None => {
            return Ok(facts)
        }
    }
}

