}

fn add_unresolved_dependency(facts: read PackageTreeFacts) -> fresh PackageTreeFacts {
    return PackageTreeFacts(
        package_name: read facts.package_name,
        packages: facts.packages + 1,
        path_dependencies: facts.path_dependencies,
        unresolved_dependencies: facts.unresolved_dependencies + 1,
    )
