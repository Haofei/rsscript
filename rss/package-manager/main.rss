fn add_path_dependency(
    facts: read PackageTreeFacts,
    dependency: read PackageTreeFacts,
) -> fresh PackageTreeFacts {
    return PackageTreeFacts(
        package_name: read facts.package_name,
        packages: facts.packages + dependency.packages,
        path_dependencies: facts.path_dependencies + dependency.path_dependencies + 1,
        unresolved_dependencies: facts.unresolved_dependencies + dependency.unresolved_dependencies,
    )
}

