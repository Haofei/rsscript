) -> Result<fresh VendorCopyFacts, String> {
    let input = Path.join(base: read source, child: read relative_path)
    let output = Path.join(base: read vendor, child: read relative_path)
    let contents = read_text_result(path: read input)?
    write_text_result(path: read output, text: read contents)?

    return add_file_facts(facts: read facts, relative_path: read relative_path)
}

fn copy_package_tree(
