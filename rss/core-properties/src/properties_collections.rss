features: local

fn lists_equal(left: read List<Int>, right: read List<Int>) -> Bool {
    if List.len(list: read left) != List.len(list: read right) {
        return false
    }
    let mut index = 0
    while index < List.len(list: read left) {
        if List.get(list: read left, index: index) != List.get(list: read right, index: index) {
            return false
        }
        index = index + 1
    }
    return true
}

fn is_even(value: Int) -> Bool {
    let quotient = value / 2
    return quotient * 2 == value
}

fn list_contains_value(values: read List<Int>, needle: Int) -> Bool {
    let mut index = 0
    while index < List.len(list: read values) {
        if List.get(list: read values, index: index) == needle {
            return true
        }
        index = index + 1
    }
    return false
}

fn prop_reverse_reverse(values: read List<Int>) -> fresh PropertyResult {
    let once = List.reverse(list: read values)
    let twice = List.reverse(list: read once)
    return Property.expect_bool(value: lists_equal(left: read values, right: read twice))
}

fn prop_take_skip_rebuild(values: read List<Int>) -> fresh PropertyResult {
    let count = List.len(list: read values) / 2
    local rebuilt = List.take(list: read values, count: count)
    let suffix = List.skip(list: read values, count: count)
    List.append(list: mut rebuilt, values: read suffix)
    return Property.expect_bool(value: lists_equal(left: read values, right: read rebuilt))
}

fn prop_filter_count_matches(values: read List<Int>) -> fresh PropertyResult {
    let filtered = List.filter(
        list: read values,
        predicate: |value| {
            return is_even(value: value)
        },
    )
    let counted = List.count_where(
        list: read values,
        predicate: |value| {
            return is_even(value: value)
        },
    )
    return Property.expect_bool(value: List.len(list: read filtered) == counted)
}

fn prop_list_first_last_match_indices(values: read List<Int>) -> fresh PropertyResult {
    if List.len(list: read values) == 0 {
        return Property.discard()
    }

    match List.first(list: read values) {
        Some(first) => {
            match List.last(list: read values) {
                Some(last) => {
                    let expected_first = List.get(list: read values, index: 0)
                    let expected_last = List.get(list: read values, index: List.len(list: read values) - 1)
                    return Property.expect_bool(value: first == expected_first && last == expected_last)
                }
                None => {
                    return Property.fail(message: read "last returned none for non-empty list", counterexample: read "")
                }
            }
        }
        None => {
            return Property.fail(message: read "first returned none for non-empty list", counterexample: read "")
        }
    }
}

fn prop_list_pop_removes_last(values: read List<Int>) -> fresh PropertyResult {
    if List.len(list: read values) == 0 {
        return Property.discard()
    }

    local copy = List.slice(list: read values, start: 0, len: List.len(list: read values))
    let expected_last = List.get(list: read values, index: List.len(list: read values) - 1)
    match List.pop(list: mut copy) {
        Some(popped) => {
            let len_ok = List.len(list: read copy) == List.len(list: read values) - 1
            return Property.expect_bool(value: popped == expected_last && len_ok)
        }
        None => {
            return Property.fail(message: read "pop returned none for non-empty list", counterexample: read "")
        }
    }
}

fn prop_list_set_updates_index(value: read IntPair) -> fresh PropertyResult {
    local values = List<Int>.new()
    List.push(list: mut values, value: read value.left)
    List.set(list: mut values, index: 0, value: read value.right)
    return Property.expect_bool(value: List.get(list: read values, index: 0) == value.right && List.len(list: read values) == 1)
}

fn prop_list_remove_at_decreases_len(values: read List<Int>) -> fresh PropertyResult {
    if List.len(list: read values) == 0 {
        return Property.discard()
    }

    let index = List.len(list: read values) / 2
    let expected = List.get(list: read values, index: index)
    local copy = List.slice(list: read values, start: 0, len: List.len(list: read values))
    match List.remove_at(list: mut copy, index: index) {
        Some(removed) => {
            let len_ok = List.len(list: read copy) == List.len(list: read values) - 1
            return Property.expect_bool(value: removed == expected && len_ok)
        }
        None => {
            return Property.fail(message: read "remove_at returned none for valid index", counterexample: read "")
        }
    }
}

fn prop_list_clear_empties(values: read List<Int>) -> fresh PropertyResult {
    local copy = List.slice(list: read values, start: 0, len: List.len(list: read values))
    List.clear(list: mut copy)
    return Property.expect_bool(value: List.len(list: read copy) == 0 && List.is_empty(list: read copy))
}

fn prop_map_insert_get(values: read List<Int>) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        Map.insert(map: mut map, key: read value, value: read value)
        match Map.get(map: read map, key: read value) {
            Some(found) => {
                if found != value {
                    return Property.fail(message: read "map returned wrong value", counterexample: read String.from_int(value: value))
                }
            }
            None => {
                return Property.fail(message: read "map lost inserted key", counterexample: read String.from_int(value: value))
            }
        }
        index = index + 1
    }
    return Property.pass()
}

fn prop_map_get_or_default_after_insert(value: Int) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    Map.insert(map: mut map, key: read value, value: read value)
    let next = value + 1
    let found = Map.get_or_default(map: read map, key: read value, default: read next)
    let missing = Map.get_or_default(map: read map, key: read next, default: read value)
    return Property.expect_bool(value: found == value && missing == value)
}

fn prop_map_remove_deletes_key(value: Int) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    Map.insert(map: mut map, key: read value, value: read value)
    match Map.remove(map: mut map, key: read value) {
        Some(removed) => {
            let missing = Map.contains_key(map: read map, key: read value) == false
            return Property.expect_bool(value: removed == value && missing)
        }
        None => {
            return Property.fail(message: read "remove returned none for inserted key", counterexample: read String.from_int(value: value))
        }
    }
}

fn prop_map_keys_values_match_len(values: read List<Int>) -> fresh PropertyResult {
