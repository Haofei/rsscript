fn prop_set_to_list_membership(values: read List<Int>) -> fresh PropertyResult {
    local set = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        Set.insert(set: mut set, value: read value)
        index = index + 1
    }

    let items = Set.to_list(set: read set)
    let mut item_index = 0
    while item_index < List.len(list: read items) {
        let item = List.get(list: read items, index: item_index)
        if list_contains_value(values: read values, needle: item) == false {
            return Property.fail(message: read "set to_list returned unknown value", counterexample: read String.from_int(value: item))
        }
        item_index = item_index + 1
    }
    return Property.expect_bool(value: List.len(list: read items) == Set.len(set: read set))
}

fn prop_set_union_contains_left(values: read List<Int>) -> fresh PropertyResult {
    local left = Set<Int>.new()
    local right = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        if is_even(value: value) {
            Set.insert(set: mut left, value: read value)
        } else {
            Set.insert(set: mut right, value: read value)
        }
        index = index + 1
    }

    let union = Set.union(left: read left, right: read right)
    let left_items = Set.to_list(set: read left)
    let mut left_index = 0
    while left_index < List.len(list: read left_items) {
        let item = List.get(list: read left_items, index: left_index)
        if Set.contains(set: read union, value: read item) == false {
            return Property.fail(message: read "union does not contain left item", counterexample: read String.from_int(value: item))
        }
        left_index = left_index + 1
    }
    return Property.pass()
}

fn prop_set_intersection_subset(values: read List<Int>) -> fresh PropertyResult {
    local left = Set<Int>.new()
    local right = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        Set.insert(set: mut left, value: read value)
        if is_even(value: value) {
            Set.insert(set: mut right, value: read value)
        }
        index = index + 1
    }

    let intersection = Set.intersection(left: read left, right: read right)
    return Property.expect_bool(value: Set.is_subset(left: read intersection, right: read left))
}

fn set_from_list(values: read List<Int>) -> fresh Set<Int> {
    local set = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        Set.insert(set: mut set, value: read value)
        index = index + 1
    }
    return set
}

fn prop_set_union_contains_both_sides(value: read IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: read value.left)
    let right = set_from_list(values: read value.right)
    let union = Set.union(left: read left, right: read right)

    let mut left_index = 0
    while left_index < List.len(list: read value.left) {
        let item = List.get(list: read value.left, index: left_index)
        if Set.contains(set: read union, value: read item) == false {
            return Property.fail(message: read "union missing left input", counterexample: read String.from_int(value: item))
        }
        left_index = left_index + 1
    }

    let mut right_index = 0
    while right_index < List.len(list: read value.right) {
        let item = List.get(list: read value.right, index: right_index)
        if Set.contains(set: read union, value: read item) == false {
            return Property.fail(message: read "union missing right input", counterexample: read String.from_int(value: item))
        }
        right_index = right_index + 1
    }

    return Property.pass()
}

fn prop_set_difference_excludes_right(value: read IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: read value.left)
    let right = set_from_list(values: read value.right)
    let difference = Set.difference(left: read left, right: read right)

    let right_items = Set.to_list(set: read right)
    let mut index = 0
    while index < List.len(list: read right_items) {
        let item = List.get(list: read right_items, index: index)
        if Set.contains(set: read difference, value: read item) {
            return Property.fail(message: read "difference contains right item", counterexample: read String.from_int(value: item))
        }
        index = index + 1
    }

    return Property.pass()
}

fn prop_set_intersection_contains_only_both(value: read IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: read value.left)
    let right = set_from_list(values: read value.right)
    let intersection = Set.intersection(left: read left, right: read right)
    let items = Set.to_list(set: read intersection)

    let mut index = 0
    while index < List.len(list: read items) {
        let item = List.get(list: read items, index: index)
        if Set.contains(set: read left, value: read item) == false || Set.contains(set: read right, value: read item) == false {
            return Property.fail(message: read "intersection item is not in both sets", counterexample: read String.from_int(value: item))
        }
        index = index + 1
    }

    return Property.pass()
}

fn prop_sort_adjacent_order(values: read List<Int>) -> fresh PropertyResult {
    if List.len(list: read values) < 2 {
        return Property.discard()
    }

    local sorted = List.slice(list: read values, start: 0, len: List.len(list: read values))
    List.sort(list: mut sorted)
    let mut index = 1
    while index < List.len(list: read sorted) {
        let previous = List.get(list: read sorted, index: index - 1)
        let current = List.get(list: read sorted, index: index)
        if previous > current {
            return Property.fail(message: read "sort produced descending adjacent pair", counterexample: read "")
        }
        index = index + 1
    }
    return Property.pass()
}

fn prop_sort_first_last(values: read List<Int>) -> fresh PropertyResult {
    if List.len(list: read values) == 0 {
        return Property.discard()
    }

    local sorted = List.slice(list: read values, start: 0, len: List.len(list: read values))
    List.sort(list: mut sorted)
    let first = List.get(list: read sorted, index: 0)
    let last = List.get(list: read sorted, index: List.len(list: read sorted) - 1)
    return Property.expect_bool(value: first <= last)
}

