fn prop_map_insert_old_reports_previous(value: Int) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    Map.insert(map: mut map, key: read value, value: read value)
    let next = value + 1
    match Map.insert_old(map: mut map, key: read value, value: read next) {
        Some(previous) => {
            return Property.expect_bool(value: previous == value)
        }
        None => {
            return Property.fail(message: read "insert_old did not return previous value", counterexample: read String.from_int(value: value))
        }
