features: local

fn prop_json_int_object_roundtrip(value: Int) -> fresh PropertyResult {
    local fields = List<String>.new()
    List.push(list: mut fields, value: read Json.int_field(name: read "value", value: value))
    let text = Json.object(fields: read fields)
    match Json.parse(text: read text) {
        Ok(root) => {
            match Json.field_int(value: read root, name: read "value") {
                Ok(parsed) => {
                    return Property.expect_bool(value: parsed == value)
                }
                Err(error) => {
                    return Property.fail(message: read JsonError.message(error: read error), counterexample: read text)
                }
            }
        }
        Err(error) => {
            return Property.fail(message: read JsonError.message(error: read error), counterexample: read text)
        }
    }
}

