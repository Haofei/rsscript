fn int_lists_equal(left: read List<Int>, right: read List<Int>) -> Bool {
    if List.len(list: read left) != List.len(list: read right) {
        return false
    }
    let mut index = 0
    while index < List.len(list: read left) {
        if List.get(list: read left, index: index) != List.get(list: read right, index: index) {
            return false
        }
        index = index + 1
    }
    return true
}

