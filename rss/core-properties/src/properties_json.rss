fn json_int_array_text(values: read List<Int>) -> fresh String {
    local items = List<String>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        List.push(list: mut items, value: read String.from_int(value: value))
        index = index + 1
    }
    return Json.array(items: read items)
}

fn json_bool_array_text(values: read List<Bool>) -> fresh String {
    local items = List<String>.new()
