        List.push(list: mut items, value: read String.from_bool(value: value))
        index = index + 1
    }
    return Json.array(items: read items)
}

fn prop_json_int_array_roundtrip(values: read List<Int>) -> fresh PropertyResult {
    let text = json_int_array_text(values: read values)
    match Json.parse(text: read text) {
        Ok(root) => {
            match Json.array_ints(value: read root) {
                Ok(parsed) => {
                    return Property.expect_bool(value: int_lists_equal(left: read values, right: read parsed))
                }
                Err(error) => {
                    return Property.fail(message: read JsonError.message(error: read error), counterexample: read text)
                }
            }
        }
        Err(error) => {
            return Property.fail(message: read JsonError.message(error: read error), counterexample: read text)
        }
    }
}

