pub fn QuickCheckJson.run() -> Unit {
    let json_int_summary = Property.check_int(
        name: read "json int object roundtrip",
        cases: 200,
        seed: 20260602,
        range: read IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_json_int_object_roundtrip(value: value)
        },
    )
    Property.assert_passed(summary: read json_int_summary)

    let json_string_summary = Property.check_string(
        name: read "json string object roundtrip",
        cases: 200,
        seed: 20260602,
        input: read StringGen.new(max_len: 40),
        property: |value| {
            return prop_json_string_object_roundtrip(value: read value)
        },
    )
    Property.assert_passed(summary: read json_string_summary)

    let json_pair_summary = Property.check_int_pair(
        name: read "json int pair object roundtrip",
        cases: 200,
        seed: 20260602,
        input: read IntPairGen.new(
            left: read IntRange.new(min: -10000, max: 10000),
            right: read IntRange.new(min: -10000, max: 10000),
        ),
        property: |value| {
            return prop_json_int_pair_object_roundtrip(value: read value)
        },
    )
    Property.assert_passed(summary: read json_pair_summary)

    let json_string_pair_summary = Property.check_string_pair(
        name: read "json string pair object roundtrip",
        cases: 200,
        seed: 20260602,
        input: read StringPairGen.new(max_len: 40),
        property: |value| {
            return prop_json_string_pair_object_roundtrip(value: read value)
        },
    )
    Property.assert_passed(summary: read json_string_pair_summary)

    let json_int_array_summary = Property.check_int_list(
        name: read "json int array roundtrip",
        cases: 200,
        seed: 20260602,
        input: read IntListGen.new(
            max_len: 50,
            range: read IntRange.new(min: -10000, max: 10000),
        ),
        property: |values| {
            return prop_json_int_array_roundtrip(values: read values)
        },
    )
    Property.assert_passed(summary: read json_int_array_summary)

    let json_bool_array_summary = Property.check_bool_list(
        name: read "json bool array roundtrip",
        cases: 200,
        seed: 20260602,
        input: read BoolListGen.new(max_len: 50),
        property: |values| {
            return prop_json_bool_array_roundtrip(values: read values)
        },
    )
    Property.assert_passed(summary: read json_bool_array_summary)

    let json_string_array_summary = Property.check_string_list(
        name: read "json string array roundtrip",
        cases: 200,
        seed: 20260602,
        input: read StringListGen.new(max_len: 50, max_item_len: 40),
        property: |values| {
            return prop_json_string_array_roundtrip(values: read values)
        },
    )
    Property.assert_passed(summary: read json_string_array_summary)

    return Unit
}
