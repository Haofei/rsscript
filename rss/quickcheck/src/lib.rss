fn int_counterexample(value: Int) -> fresh String {
    return String.from_int(value: value)
}

fn bool_counterexample(value: Bool) -> fresh String {
    return String.from_bool(value: value)
}

fn string_counterexample(value: read String) -> fresh String {
    return String.concat(
        left: read "\"",
        right: read String.concat(left: read value, right: read "\""),
    )
}

fn string_pair_counterexample(value: read StringPair) -> fresh String {
    let left = String.concat(left: read "left=", right: read string_counterexample(value: read value.left))
    let mid = String.concat(left: read left, right: read " right=")
    return String.concat(left: read mid, right: read string_counterexample(value: read value.right))
}

fn int_list_counterexample(values: read List<Int>) -> fresh String {
    local parts = List<String>.new()
    let mut index = 0
    while index < List.len(list: read values) {
        let value = List.get(list: read values, index: index)
        List.push(list: mut parts, value: read String.from_int(value: value))
        index = index + 1
    }
    return String.concat(
        left: read "[",
        right: read String.concat(
            left: read List.join(list: read parts, separator: read ", "),
            right: read "]",
        ),
    )
}

