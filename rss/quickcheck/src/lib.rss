fn shrink_int_failure(value: Int, property: noescape Fn(Int) -> fresh PropertyResult) -> fresh PropertyResult {
    let zero = property(0)
    if zero.ok == false && zero.discarded == false {
        return result_with_counterexample(
            result: read zero,
            counterexample: read int_counterexample(value: 0),
        )
    }

    let half = value / 2
    if half != value {
        let candidate = property(half)
        if candidate.ok == false && candidate.discarded == false {
            return result_with_counterexample(
                result: read candidate,
                counterexample: read int_counterexample(value: half),
            )
        }
    }

    let original = property(value)
    return result_with_counterexample(
        result: read original,
        counterexample: read int_counterexample(value: value),
    )
}

pub fn Property.check_int(
    name: read String,
    cases: Int,
    seed: Int,
    range: read IntRange,
    property: noescape Fn(Int) -> fresh PropertyResult,
) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed: seed)
    let total = bounded_cases(cases: cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng: read rng)
        let value = Rng.int(rng: read rng, range: read range)
        let result = property(value)
        if result.discarded {
            discarded = discarded + 1
        } else {
            if result.ok {
                passed = passed + 1
            } else {
                let shrunk = shrink_int_failure(value: value, property: property)
                return failed_summary(
                    name: read name,
                    passed: passed,
                    discarded: discarded,
                    total: total,
                    seed: seed,
                    result: read shrunk,
                )
            }
        }
        index = index + 1
    }

    return passed_summary(name: read name, passed: passed, discarded: discarded, total: total, seed: seed)
}

pub fn Property.check_bool(
    name: read String,
    cases: Int,
    seed: Int,
    property: noescape Fn(Bool) -> fresh PropertyResult,
) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed: seed)
    let total = bounded_cases(cases: cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng: read rng)
        let value = Rng.bool(rng: read rng)
        let result = property(value)
        if result.discarded {
            discarded = discarded + 1
        } else {
            if result.ok {
                passed = passed + 1
            } else {
                let with_input = result_with_counterexample(
                    result: read result,
                    counterexample: read bool_counterexample(value: value),
                )
                return failed_summary(
                    name: read name,
                    passed: passed,
                    discarded: discarded,
                    total: total,
                    seed: seed,
                    result: read with_input,
                )
            }
        }
        index = index + 1
    }

    return passed_summary(name: read name, passed: passed, discarded: discarded, total: total, seed: seed)
}

fn gen_bool_list(rng: read Rng, input: read BoolListGen) -> fresh List<Bool> {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng: read rng, range: read IntRange(min: 0, max: bounded_len))
    let mut item_rng = Rng.next(rng: read rng)
    local values = List<Bool>.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: read item_rng)
        List.push(list: mut values, value: read Rng.bool(rng: read item_rng))
        index = index + 1
    }
    return values
}

fn shrink_bool_list_failure(
    values: read List<Bool>,
    property: noescape Fn(List<Bool>) -> fresh PropertyResult,
) -> fresh PropertyResult {
    local empty = List<Bool>.new()
    let empty_result = property(empty)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: read empty_result,
            counterexample: read "[]",
        )
    }

    let half_len = List.len(list: read values) / 2
    if half_len > 0 {
        let half = List.take(list: read values, count: half_len)
        let half_counterexample = bool_list_counterexample(values: read half)
        let half_result = property(half)
        if half_result.ok == false && half_result.discarded == false {
            return result_with_counterexample(
                result: read half_result,
                counterexample: read half_counterexample,
            )
        }
    }

    let original_value = List.slice(list: read values, start: 0, len: List.len(list: read values))
    let original = property(original_value)
    return result_with_counterexample(
        result: read original,
        counterexample: read bool_list_counterexample(values: read values),
    )
}

pub fn Property.check_bool_list(
    name: read String,
