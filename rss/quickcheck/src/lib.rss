fn result_with_counterexample(result: read PropertyResult, counterexample: read String) -> fresh PropertyResult {
    if String.is_empty(value: read result.counterexample) {
        return PropertyResult(
            ok: result.ok,
            discarded: result.discarded,
            label: String.copy(value: read result.label),
            message: String.copy(value: read result.message),
            counterexample: String.copy(value: read counterexample),
        )
    }
    return PropertyResult(
        ok: result.ok,
        discarded: result.discarded,
        label: String.copy(value: read result.label),
        message: String.copy(value: read result.message),
        counterexample: String.copy(value: read result.counterexample),
    )
}

