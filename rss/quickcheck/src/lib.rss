fn gen_string(rng: read Rng, input: read StringGen) -> fresh String {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng: read rng, range: read IntRange(min: 0, max: bounded_len))
    let mut item_rng = Rng.next(rng: read rng)
    local builder = StringBuilder.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: read item_rng)
        let letter_index = Rng.int(rng: read item_rng, range: read IntRange(min: 0, max: 25))
        StringBuilder.push(builder: mut builder, value: read letter_from_index(value: letter_index))
        index = index + 1
    }
    return StringBuilder.finish(builder: take builder)
}

fn gen_string_pair(rng: read Rng, input: read StringPairGen) -> fresh StringPair {
    let left_rng = Rng.next(rng: read rng)
    let right_rng = Rng.next(rng: read left_rng)
    let string_gen = StringGen(max_len: input.max_len)
    local left_value = gen_string(rng: read left_rng, input: read string_gen)
    local right_value = gen_string(rng: read right_rng, input: read string_gen)
    return StringPair(left: take left_value, right: take right_value)
}

fn gen_string_list(rng: read Rng, input: read StringListGen) -> fresh List<String> {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng: read rng, range: read IntRange(min: 0, max: bounded_len))
    let string_gen = StringGen(max_len: input.max_item_len)
    let mut item_rng = Rng.next(rng: read rng)
    local values = List<String>.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: read item_rng)
        let value = gen_string(rng: read item_rng, input: read string_gen)
        List.push(list: mut values, value: read value)
        index = index + 1
    }
    return values
}

fn shrink_string_failure(value: read String, property: noescape Fn(String) -> fresh PropertyResult) -> fresh PropertyResult {
    let empty = property("")
    if empty.ok == false && empty.discarded == false {
        return result_with_counterexample(
            result: read empty,
            counterexample: read "\"\"",
        )
    }

    let half_len = String.len(value: read value) / 2
    if half_len > 0 {
        let half = String.slice(value: read value, start: 0, len: half_len)
        let half_counterexample = string_counterexample(value: read half)
        let half_result = property(half)
        if half_result.ok == false && half_result.discarded == false {
            return result_with_counterexample(
                result: read half_result,
                counterexample: read half_counterexample,
            )
        }
    }

    let original = property(String.copy(value: read value))
    return result_with_counterexample(
        result: read original,
        counterexample: read string_counterexample(value: read value),
    )
}

fn shrink_string_pair_failure(
    value: read StringPair,
    property: noescape Fn(StringPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    let empty = StringPair(left: "", right: "")
    let empty_result = property(empty)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: read empty_result,
            counterexample: read "left=\"\" right=\"\"",
        )
    }

    let original_value = StringPair(
        left: String.copy(value: read value.left),
        right: String.copy(value: read value.right),
    )
    let original = property(original_value)
    return result_with_counterexample(
        result: read original,
        counterexample: read string_pair_counterexample(value: read value),
    )
}

