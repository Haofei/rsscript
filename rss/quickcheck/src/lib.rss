pub fn Property.pass() -> fresh PropertyResult {
    return PropertyResult(
        ok: true,
        discarded: false,
        label: "",
        message: "",
        counterexample: "",
    )
}

pub fn Property.fail(message: read String, counterexample: read String) -> fresh PropertyResult {
    return PropertyResult(
        ok: false,
        discarded: false,
        label: "",
        message: String.copy(value: read message),
        counterexample: String.copy(value: read counterexample),
    )
}

pub fn Property.discard() -> fresh PropertyResult {
    return PropertyResult(
        ok: false,
        discarded: true,
