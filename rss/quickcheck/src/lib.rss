pub fn Property.assert_passed(summary: read PropertySummary) -> Unit {
    if summary.failed {
        let named = String.concat(left: read "quickcheck failed: ", right: read summary.name)
        let reason = String.concat(left: read named, right: read " reason=")
        let with_reason = String.concat(left: read reason, right: read summary.failure)
        let counterexample = String.concat(left: read with_reason, right: read " counterexample=")
        Log.write(message: read String.concat(left: read counterexample, right: read summary.counterexample))
    }
    Assert.equal_bool(left: summary.failed, right: false)
    return Unit
}
