) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed: seed)
    let total = bounded_cases(cases: cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng: read rng)
        let values = gen_string_list(rng: read rng, input: read input)
        let property_input = List.slice(list: read values, start: 0, len: List.len(list: read values))
        let result = property(property_input)
        if result.discarded {
            discarded = discarded + 1
        } else {
            if result.ok {
                passed = passed + 1
            } else {
                let shrunk = shrink_string_list_failure(values: read values, property: property)
                return failed_summary(
                    name: read name,
                    passed: passed,
                    discarded: discarded,
                    total: total,
                    seed: seed,
                    result: read shrunk,
                )
            }
        }
        index = index + 1
    }

    return passed_summary(name: read name, passed: passed, discarded: discarded, total: total, seed: seed)
}

fn gen_int_list(rng: read Rng, input: read IntListGen) -> fresh List<Int> {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng: read rng, range: read IntRange(min: 0, max: bounded_len))
    let mut item_rng = Rng.next(rng: read rng)
    local values = List<Int>.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: read item_rng)
        let value = Rng.int(rng: read item_rng, range: read input.range)
        List.push(list: mut values, value: read value)
        index = index + 1
    }
    return values
}

fn gen_int_pair(rng: read Rng, input: read IntPairGen) -> fresh IntPair {
    let left_rng = Rng.next(rng: read rng)
    let right_rng = Rng.next(rng: read left_rng)
    return IntPair(
        left: Rng.int(rng: read left_rng, range: read input.left),
        right: Rng.int(rng: read right_rng, range: read input.right),
    )
}

fn gen_int_list_pair(rng: read Rng, input: read IntListPairGen) -> fresh IntListPair {
    let left_rng = Rng.next(rng: read rng)
    let right_rng = Rng.next(rng: read left_rng)
    let list_gen = IntListGen(max_len: input.max_len, range: IntRange(min: input.range.min, max: input.range.max))
    local left_values = gen_int_list(rng: read left_rng, input: read list_gen)
    local right_values = gen_int_list(rng: read right_rng, input: read list_gen)
    return IntListPair(
        left: take left_values,
        right: take right_values,
    )
}

fn shrink_list_failure(
    values: read List<Int>,
    property: noescape Fn(List<Int>) -> fresh PropertyResult,
) -> fresh PropertyResult {
    local empty = List<Int>.new()
    let empty_result = property(empty)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: read empty_result,
            counterexample: read "[]",
        )
    }

    let half_len = List.len(list: read values) / 2
    if half_len > 0 {
        let half = List.take(list: read values, count: half_len)
        let half_counterexample = int_list_counterexample(values: read half)
        let half_result = property(half)
        if half_result.ok == false && half_result.discarded == false {
            return result_with_counterexample(
                result: read half_result,
                counterexample: read half_counterexample,
            )
        }
    }

    let original_value = List.slice(list: read values, start: 0, len: List.len(list: read values))
    let original = property(original_value)
    return result_with_counterexample(
        result: read original,
        counterexample: read int_list_counterexample(values: read values),
    )
}

fn shrink_int_pair_failure(
    value: read IntPair,
    property: noescape Fn(IntPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    let zero = IntPair(left: 0, right: 0)
    let zero_result = property(zero)
    if zero_result.ok == false && zero_result.discarded == false {
        return result_with_counterexample(
            result: read zero_result,
            counterexample: read "left=0 right=0",
        )
    }

    let original_value = IntPair(left: value.left, right: value.right)
    let original = property(original_value)
    return result_with_counterexample(
        result: read original,
        counterexample: read int_pair_counterexample(value: read value),
    )
}

fn shrink_int_list_pair_failure(
    value: read IntListPair,
    property: noescape Fn(IntListPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    local left_empty = List<Int>.new()
    local right_empty = List<Int>.new()
    let empty_pair = IntListPair(left: take left_empty, right: take right_empty)
    let empty_result = property(empty_pair)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: read empty_result,
            counterexample: read "left=[] right=[]",
        )
    }

    local left_copy = List.slice(list: read value.left, start: 0, len: List.len(list: read value.left))
    local right_copy = List.slice(list: read value.right, start: 0, len: List.len(list: read value.right))
    let original_value = IntListPair(left: take left_copy, right: take right_copy)
    let original = property(original_value)
    return result_with_counterexample(
        result: read original,
        counterexample: read int_list_pair_counterexample(value: read value),
    )
}

