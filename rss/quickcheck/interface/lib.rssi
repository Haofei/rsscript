features: local

struct Rng {
    state: Int
}

struct PropertyResult {
    ok: Bool
    discarded: Bool
    label: String
    message: String
    counterexample: String
}

struct PropertySummary {
    name: String
    passed: Int
    discarded: Int
    total: Int
    seed: Int
    failed: Bool
    failure: String
    counterexample: String
}

struct IntRange {
    min: Int
    max: Int
}

struct IntListGen {
    max_len: Int
    range: IntRange
}

struct BoolListGen {
    max_len: Int
}

struct IntPair {
    left: Int
    right: Int
}

struct IntPairGen {
    left: IntRange
    right: IntRange
}

struct IntListPair {
    left: List<Int>
    right: List<Int>
}

struct IntListPairGen {
    max_len: Int
    range: IntRange
}

struct StringGen {
    max_len: Int
}

struct StringPair {
    left: String
    right: String
}

struct StringPairGen {
    max_len: Int
}

struct StringListGen {
    max_len: Int
    max_item_len: Int
}

pub fn Rng.seed(seed: Int) -> fresh Rng

pub fn Rng.next(rng: read Rng) -> fresh Rng

pub fn Rng.int(rng: read Rng, range: read IntRange) -> Int

pub fn Rng.bool(rng: read Rng) -> Bool

pub fn IntRange.new(min: Int, max: Int) -> fresh IntRange

pub fn IntListGen.new(max_len: Int, range: read IntRange) -> fresh IntListGen

pub fn BoolListGen.new(max_len: Int) -> fresh BoolListGen

pub fn IntPairGen.new(left: read IntRange, right: read IntRange) -> fresh IntPairGen

pub fn IntListPairGen.new(max_len: Int, range: read IntRange) -> fresh IntListPairGen

pub fn StringGen.new(max_len: Int) -> fresh StringGen

pub fn StringPairGen.new(max_len: Int) -> fresh StringPairGen

pub fn StringListGen.new(max_len: Int, max_item_len: Int) -> fresh StringListGen

pub fn Property.pass() -> fresh PropertyResult

pub fn Property.fail(message: read String, counterexample: read String) -> fresh PropertyResult

pub fn Property.discard() -> fresh PropertyResult

pub fn Property.expect_bool(value: Bool) -> fresh PropertyResult

pub fn PropertyResult.label(result: read PropertyResult, label: read String) -> fresh PropertyResult

pub fn Property.check_int(
    name: read String,
    cases: Int,
    seed: Int,
    range: read IntRange,
    property: noescape Fn(Int) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_bool(
    name: read String,
    cases: Int,
    seed: Int,
    property: noescape Fn(Bool) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_bool_list(
    name: read String,
    cases: Int,
    seed: Int,
    input: read BoolListGen,
    property: noescape Fn(List<Bool>) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_string(
    name: read String,
    cases: Int,
    seed: Int,
    input: read StringGen,
    property: noescape Fn(String) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_string_pair(
    name: read String,
    cases: Int,
    seed: Int,
    input: read StringPairGen,
    property: noescape Fn(StringPair) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_string_list(
    name: read String,
    cases: Int,
    seed: Int,
    input: read StringListGen,
    property: noescape Fn(List<String>) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_int_list(
    name: read String,
    cases: Int,
    seed: Int,
    input: read IntListGen,
    property: noescape Fn(List<Int>) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_int_pair(
    name: read String,
    cases: Int,
    seed: Int,
    input: read IntPairGen,
    property: noescape Fn(IntPair) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.check_int_list_pair(
    name: read String,
    cases: Int,
    seed: Int,
    input: read IntListPairGen,
    property: noescape Fn(IntListPair) -> fresh PropertyResult,
) -> fresh PropertySummary

pub fn Property.assert_passed(summary: read PropertySummary) -> Unit
