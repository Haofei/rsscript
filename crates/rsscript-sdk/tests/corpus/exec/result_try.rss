fn parse(value: String) -> Result<Int, String> {
    match String.parse_int(value) {
        Some(number) => {
            return Ok(number)
        }
        None => {
            return Err("not a number")
        }
    }
}

fn run() -> Result<Unit, String> {
    let number = parse(value: "41")?
    Output.write(message: String.from_int(value: number + 1))
    return Ok(Unit)
}

fn main() -> Unit {
    match run() {
        Ok(_) => {
            return Unit
        }
        Err(message) => {
            Output.write(message)
        }
    }
    return Unit
}
