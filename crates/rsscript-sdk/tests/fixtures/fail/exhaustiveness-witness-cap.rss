// expect: RS0021

// Ten `Bool` fields produce 1024 witness rows, above the checker's cap of
// 512, so exhaustiveness is not *proven* rather than disproven. `RS0021`
// says so explicitly instead of implying a missing arm, and an explicit
// `_` is the only way to close the match.

struct Wide {
    f0: Bool,
    f1: Bool,
    f2: Bool,
    f3: Bool,
    f4: Bool,
    f5: Bool,
    f6: Bool,
    f7: Bool,
    f8: Bool,
    f9: Bool
}

fn describe(w: read Wide) -> Int {
    match w {
        Wide { f0: true, f1: true, f2: true, f3: true, f4: true, f5: true, f6: true, f7: true, f8: true, f9: true } => { return 1 }
        Wide { f0: false, f1: false, f2: false, f3: false, f4: false, f5: false, f6: false, f7: false, f8: false, f9: false } => { return 0 }
    }
}
