// expect: RS0401

// interface: noescape-callback-local-use-after-manage.rssi

struct ImageData {
    size: Int
}

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn main() -> Unit {
    apply(callback: || {
        local image = ImageData(size: 1)
        let shared = manage image
        inspect(image)
        inspect(image: shared)
    })

    return Unit
}
