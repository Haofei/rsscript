// expect: RS0501 RS0601

// interface: fresh-branch-retained-local.rssi

class RetainedImageStore {
    entries: List<Image>
}

struct Image {
    pixels: Buffer
}

fn maybe_cached(cache: mut RetainedImageStore, path: Path, should_store: Bool) -> fresh Image {
    local image = Image.load(path)
    if should_store {
        RetainedImageStore.store(cache: mut cache, image)
    }
    return image
}
