// expect: RS0702

// interface: resource-wrapped-managed-closure-capture.rssi

resource File {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn bad_capture(path: Path) -> Unit {
    with File.open(path) as file {
        let callback = Some(|| {
            File.read_all(file: mut file)
        })
    }
}
