// expect: RS0702

// interface: resource-wrapper-escape.rssi

resource LogFile {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn bad_return(path: Path) -> Unit {
    with LogFile.open(path) as file {
        return Ok(file)
    }
}

fn bad_binding(path: Path) -> Unit {
    with LogFile.open(path) as file {
        let saved = Some(file)
    }
}
