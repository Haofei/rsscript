// expect: RS0501

// interface: noescape-callback-retains-local.rssi

struct ImageData {
    size: Int
}

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn main() -> Unit {
    apply(callback: || {
        local image = ImageData(size: 1)
        Cache.store(image)
    })
    return Unit
}
