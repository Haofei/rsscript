// expect: RS0501


struct ImageData {
    size: Int
}

fn Cache.store(image: ImageData) -> Unit
    retains(image)

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn main() -> Unit {
    apply(callback: || {
        local image = ImageData(size: 1)
        Cache.store(image)
    })
    return Unit
}
