module rss.package.review

// A `use` path must name a module the compilation unit declares. This file is
// the only module here, so it imports from itself; a cross-module import needs
// the other module's file or interface to be part of the same check.
use rss.package.review.PackageReview

struct PackageReview {
    name: String
}

fn review_package(name: String) -> fresh PackageReview {
    return PackageReview(name: name)
}

fn main() -> Unit {
    let result = review_package(name: "test-pkg")
}
