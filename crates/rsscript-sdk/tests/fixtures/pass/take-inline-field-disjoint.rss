
struct Image

struct Pair {
    left: Image
    right: Image
}

fn make_pair(path: Path) -> fresh Pair

fn consume(image: take Image) -> Unit

fn inspect(image: Image) -> Unit

fn ok_take_disjoint(path: Path) -> Unit {
    local pair = make_pair(path)
    consume(image: take pair.left)
    inspect(image: pair.right)
}
