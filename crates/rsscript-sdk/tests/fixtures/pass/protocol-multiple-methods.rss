
protocol Writer {
    fn write(self: mut Self, message: String) -> Unit
        retains(message)

    fn flush(self: mut Self) -> Unit
}

class BufferWriter {
    buffer: List<String>
}

fn BufferWriter.write(self: mut BufferWriter, message: String) -> Unit
    retains(message)
{
    List.push<String>(list: mut self.buffer, value: message)
}

fn BufferWriter.flush(self: mut BufferWriter) -> Unit {
    let count = List.len<String>(list: self.buffer)
    Output.write(message: "flushed")
}

impl Writer for BufferWriter {
    write = BufferWriter.write
    flush = BufferWriter.flush
}

fn write_line<W: Writer>(writer: mut W, message: String) -> Unit
    retains(message)
{
    Writer.write(self: mut writer, message)
}
