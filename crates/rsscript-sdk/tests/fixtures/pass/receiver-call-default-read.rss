
class Cache {
    data: Map<String, String>
}

fn Cache.put(self: mut Cache, key: String, value: String) -> Unit {
    Map.insert<String, String>(map: mut self.data, key, value)
}

fn main() -> Unit {
    let mut cache = Cache(data: Map.new<String, String>())
    mut cache.put(key: "hello", value: "world")
}
