// interface: field-disjoint-local-inline.rssi

struct Cache {
    value: Int
}

struct Buffer {
    value: Int
}

struct Inner {
    cache: Cache
    buffer: Buffer
}

struct State {
    inner: Inner
}

fn run() -> Unit {
    local state = make_state()
    use_parts(cache: mut state.inner.cache, buffer: mut state.inner.buffer)
}
