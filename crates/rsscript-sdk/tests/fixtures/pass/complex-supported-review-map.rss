// interface: complex-supported-review-map.rssi

struct Picture
struct PictureError
struct InboundMessage
struct OutboundMessage
struct SettingsValue
struct SettingsStore
struct SettingsError
struct Settings
struct Policy
struct SharedSettings
struct MemoStore
struct Tally
struct LexicalScope
struct ClosureRecord

struct UploadPlan {
    input: Path
    output: Path
}

class RetainedImageStore {
}

fn audit_step(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn decode_upload(request: InboundMessage) -> Result<fresh UploadPlan, JsonError> {
    let body = InboundMessage.path(request)
    let json = Json.parse(text: body)?
    local input_text = Json.field_string(value: json, name: "input")?
    local output_text = Json.field_string(value: json, name: "output")?
    local input = Path.from_string(value: input_text)
    local output = Path.from_string(value: output_text)

    return UploadPlan(input: take input, output: take output)
}

fn transform_image(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, PictureError> {
    local image = Picture.load(path: plan.input)?

    audit_step(callback: || {
        Picture.inspect(image)
    })

    Picture.resize(image: mut image, width: 640, height: 480)
    Picture.normalize(image: mut image)
    Picture.sharpen(image: mut image)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: shared)
    Picture.save(image: shared, path: plan.output)?

    return Ok(Unit)
}

fn reload_settings(path: Path, store: mut SettingsStore) -> Result<Unit, SettingsError> {
    let config = Settings.load(path)?
    SettingsStore.replace(store: mut store, value: config)

    return Ok(Unit)
}

fn reload_settings_http(path: Path, store: mut SettingsStore) -> Result<Unit, HttpError> {
    match reload_settings(path, store: mut store) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error))
        }
    }
}

fn decode_upload_http(request: InboundMessage) -> Result<UploadPlan, HttpError> {
    match decode_upload(request) {
        Ok(plan) => {
            return Ok(plan)
        }
        Err(error) => {
            return Err(HttpError.from_json(error))
        }
    }
}

fn transform_image_http(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, HttpError> {
    match transform_image(plan, cache: mut cache) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_image(error))
        }
    }
}

fn record_audit(message: String) -> Result<Unit, HttpError> {
    Output.write(message)
    return Ok(Unit)
}

fn handle_upload(
    request: InboundMessage,
    cache: mut RetainedImageStore,
    config_store: mut SettingsStore,
    counter: mut Tally,
    audit_message: String,
) -> Result<fresh OutboundMessage, HttpError> {
    let config_path = Path.from_string(value: "config.json")
    reload_settings_http(path: config_path, store: mut config_store)?

    let plan = decode_upload_http(request)?
    transform_image_http(plan, cache: mut cache)?
    record_audit(message: audit_message)?

    Tally.add(counter: mut counter, amount: 1)

    let body = SettingsStore.name(store: config_store)
    return OutboundMessage.ok(body)?
}
