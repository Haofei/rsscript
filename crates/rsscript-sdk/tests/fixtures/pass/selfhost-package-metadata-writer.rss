
struct PackageMetadataInput {
    package_name: String
    version: String
    edition: String
    public_apis: Int
    native_apis: Int
    unknown_apis: Int
}

fn output_path(args: read List<String>) -> fresh Path {
    let input = Arguments.get_or_default(args: read args,
        index: 0,
        default: "target/rsscript-selfhost-package-metadata.txt",
    )

    return Path.from_string(value: input)
}

fn package_metadata_input(args: read List<String>) -> fresh PackageMetadataInput {
    let package_name = Arguments.get_or_default(args: read args, index: 1, default: "rss-selfhost-package")
    let version = Arguments.get_or_default(args: read args, index: 2, default: "0.5.0")
    let edition = Arguments.get_or_default(args: read args, index: 3, default: "2024")

    return PackageMetadataInput(
        package_name: package_name,
        version: version,
        edition: edition,
        public_apis: 5,
        native_apis: 1,
        unknown_apis: 0,
    )
}

fn metadata_text(input: PackageMetadataInput) -> fresh String {
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "{\n")
    StringBuilder.push(builder: mut builder, value: "  \"package\": ")
    let package_name = Json.quote_string(value: input.package_name)
    StringBuilder.push(builder: mut builder, value: package_name)
    StringBuilder.push(builder: mut builder, value: ",\n  \"version\": ")
    let version = Json.quote_string(value: input.version)
    StringBuilder.push(builder: mut builder, value: version)
    StringBuilder.push(builder: mut builder, value: ",\n  \"edition\": ")
    let edition = Json.quote_string(value: input.edition)
    StringBuilder.push(builder: mut builder, value: edition)
    StringBuilder.push(builder: mut builder, value: ",\n  \"public_apis\": ")
    let public_apis = String.from_int(value: input.public_apis)
    StringBuilder.push(builder: mut builder, value: public_apis)
    StringBuilder.push(builder: mut builder, value: ",\n  \"native_apis\": ")
    let native_apis = String.from_int(value: input.native_apis)
    StringBuilder.push(builder: mut builder, value: native_apis)
    StringBuilder.push(builder: mut builder, value: ",\n  \"unknown_apis\": ")
    let unknown_apis = String.from_int(value: input.unknown_apis)
    StringBuilder.push(builder: mut builder, value: unknown_apis)
    StringBuilder.push(builder: mut builder, value: "\n}\n")

    return StringBuilder.finish(builder: take builder)
}

fn ensure_parent_directory(path: Path) -> Result<Unit, FileError> {
    match Path.parent(path) {
        Some(parent) => {
            Directory.create_all(path: parent)?
        }
        None => {
        }
    }

    return Ok(Unit)
}

fn write_metadata_file(path: Path, text: String) -> Result<Unit, FileError> {
    ensure_parent_directory(path)?

    with File.open_write(path)? as file {
        File.write_string(file: mut file, text)?
    }

    return Ok(Unit)
}

pub fn main(args: read List<String>) -> Result<Unit, FileError> {
    let path = output_path(args: read args)
    let input = package_metadata_input(args: read args)
    let text = metadata_text(input)

    write_metadata_file(path, text)?

    let message = String.concat(
        left: "selfhost package metadata wrote ",
        right: input.package_name,
    )
    Output.write(message)

    return Ok(Unit)
}
