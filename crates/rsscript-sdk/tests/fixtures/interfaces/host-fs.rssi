// Host filesystem and document-parsing API used by the self-hosting and
// agent-tool fixtures. None of this is in the standard package set: `File`,
// `Directory`, `Workspace`, `Json.parse_file`, and `Toml.parse_file` are
// host-provided, so the corpus declares them here. `File` is a resource, which
// is why every producer below is bodyless (see spec §8.2).

resource File

pub fn File.open_read(path: Path) -> Result<File, FileError>

pub fn File.open_write(path: Path) -> Result<File, FileError>

pub fn File.read_all_string(file: mut File) -> Result<fresh String, FileError>

pub fn File.write_string(file: mut File, text: String) -> Result<Unit, FileError>

pub fn File.read_all(file: mut File) -> Result<fresh Bytes, FileError>

pub fn File.write(file: mut File, data: Bytes) -> Result<Unit, FileError>

pub fn File.exists(path: Path) -> Bool

pub fn File.read_string(path: Path) -> Result<fresh String, FileError>

pub fn File.write_string_to_path(path: Path, text: String) -> Result<Unit, FileError>

pub fn File.append_string(path: Path, text: String) -> Result<Unit, FileError>

pub fn File.write_atomic(path: Path, text: String) -> Result<Unit, FileError>

pub fn FileError.message(error: FileError) -> fresh String

pub fn Directory.exists(path: Path) -> Bool

pub fn Directory.is_dir(path: Path) -> Bool

pub fn Directory.create_all(path: Path) -> Result<Unit, FileError>

pub fn Directory.list_files(path: Path) -> Result<fresh List<String>, FileError>

pub fn Workspace.resolve(root: Path, relative: String) -> Result<fresh Path, String>

pub fn Json.parse_file(path: Path) -> Result<fresh JsonValue, JsonError>

pub fn Toml.parse_file(path: Path) -> Result<fresh JsonValue, JsonError>
