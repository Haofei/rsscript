fn describe(c: Char) -> String {
    match c {
        'a' => { return "vowel" }
        '\n' => { return "newline" }
        '\t' => { return "tab" }
        '\\' => { return "backslash" }
        '\'' => { return "quote" }
        '"' => { return "dquote" }
        '\0' => { return "nul" }
        _ => { return "other" }
    }
}

fn main() -> Unit {
    let c = 'a'
    Log.write(message: Char.to_string(value: c))
    Log.write(message: String.from_int(value: Char.to_code(value: c)))
    Log.write(message: describe(c))
    Log.write(message: describe(c: '\n'))
    Log.write(message: describe(c: '\t'))
    Log.write(message: describe(c: '\\'))
    Log.write(message: describe(c: '\''))
    Log.write(message: describe(c: '"'))
    Log.write(message: describe(c: '\0'))
    Log.write(message: describe(c: 'z'))
    if 'x' == 'x' {
        Log.write(message: "eq")
    }
    return Unit
}
