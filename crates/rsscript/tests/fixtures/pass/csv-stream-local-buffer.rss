features: local

struct RowBuffer {
    bytes: Buffer
}

fn sum_csv(path: Path) -> Result<Int, CsvError> {
    local buffer = RowBuffer.new(size: 4096)
    let total = 0

    with Csv.open_read(path)? as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
        let row = Csv.parse_row(buffer)?
        let amount = Row.field_string(row, index: 1)?
        total + String.len(value: amount)
    }

    return Ok(total)
}
