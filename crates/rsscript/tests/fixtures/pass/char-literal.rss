fn is_vowel(c: Char) -> Bool {
    match c {
        'a' => { return true }
        'e' => { return true }
        'i' => { return true }
        'o' => { return true }
        'u' => { return true }
        _ => { return false }
    }
}

fn classify(c: Char) -> String {
    if c == '\n' {
        return "newline"
    }
    if c == '\t' {
        return "tab"
    }
    if c == '\'' {
        return "quote"
    }
    return "other"
}
