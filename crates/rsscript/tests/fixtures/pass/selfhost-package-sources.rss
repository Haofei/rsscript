features: local

struct PackageSourceSetFacts {
    total_files: Int
    manifest_files: Int
    interface_files: Int
    source_files: Int
    public_interface_files: Int
    public_source_files: Int
    api_interface_symbols: Int
    api_source_symbols: Int
    tool_interface_symbols: Int
    tool_source_symbols: Int
}

struct PackageSourcePathSets {
    interface_paths: handle JsonValue
    source_paths: handle JsonValue
}

struct PackageSourceContentFacts {
    public_functions: Int
    api_symbols: Int
    tool_symbols: Int
}

fn selfhost_source_root() -> fresh Path {
    let input = Args.get_or_default(
        index: 0,
        default: "tests/fixtures/pass/selfhost-package-source-set",
    )

    return Path.from_string(value: input)
}

fn json_error(prefix: String, error: JsonError) -> fresh String {
    let message = JsonError.message(error)
    let first = String.concat(left: prefix, right: ": ")

    return String.concat(left: first, right: message)
}

fn file_error(prefix: String, error: FileError) -> fresh String {
    let message = FileError.message(error)
    let first = String.concat(left: prefix, right: ": ")

    return String.concat(left: first, right: message)
}

fn parse_toml_result(path: Path) -> Result<JsonValue, String> {
    match Toml.parse_file(path) {
        Ok(value) => {
            return Ok(value)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest parse", error))
        }
    }
}

fn json_field_result(
    value: JsonValue,
    name: String,
) -> Result<JsonValue, String> {
    match Json.field(value, name) {
        Ok(field) => {
            return Ok(field)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest field", error))
        }
    }
}

fn json_string_result(value: JsonValue) -> Result<String, String> {
    match Json.as_string(value) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest string", error))
        }
    }
}

fn json_array_item_result(
    value: JsonValue,
    index: Int,
) -> Result<JsonValue, String> {
    match Json.array_get(value, index) {
        Ok(item) => {
            return Ok(item)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest array item", error))
        }
    }
}

fn json_array_string_result(value: JsonValue, index: Int) -> Result<String, String> {
    let item = json_array_item_result(value, index)?

    return json_string_result(value: item)
}

fn json_array_len_result(value: JsonValue) -> Result<Int, String> {
    match Json.array_len(value) {
        Ok(length) => {
            return Ok(length)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest array length", error))
        }
    }
}

fn json_array_strings_result(value: JsonValue) -> Result<List<String>, String> {
    match Json.array_strings(value) {
        Ok(items) => {
            return Ok(items)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest string array", error))
        }
    }
}

fn list_files_result(path: Path) -> Result<List<String>, String> {
    match Directory.list_files(path) {
        Ok(paths) => {
            return Ok(paths)
        }
        Err(error) => {
            return Err(file_error(prefix: "source listing", error))
        }
    }
}

fn require_directory(path: Path, label: String) -> Result<Unit, String> {
    if Directory.exists(path) == false {
        let message = String.concat(left: label, right: " does not exist")

        return Err(message)
    }

    if Directory.is_dir(path) == false {
        let message = String.concat(left: label, right: " is not a directory")

        return Err(message)
    }

    return Ok(Unit)
}

fn read_file_text_result(path: Path) -> Result<String, FileError> {
    with File.open_read(path)? as file {
        let text = File.read_all_string(file: mut file)?

        return Ok(text)
    }
}

fn public_function_symbol(line: String) -> Option<String> {
    match String.strip_prefix(value: line, prefix: "pub fn ") {
        Some(rest) => {
            return String.before(value: rest, delimiter: "(")
        }
        None => {
            return None
        }
    }
}

fn source_content_facts(contents: String) -> fresh PackageSourceContentFacts {
    let lines = String.lines(value: contents)
    let public_functions = List.count_where(
        list: lines,
        predicate: |line| {
            match public_function_symbol(line) {
                Some(_) => {
                    return true
                }
                None => {
                    return false
                }
            }
        },
    )
    let api_symbols = List.count_where(
        list: lines,
        predicate: |line| {
            match public_function_symbol(line) {
                Some(symbol) => {
                    return symbol == "Api.run"
                }
                None => {
                    return false
                }
            }
        },
    )
    let tool_symbols = List.count_where(
        list: lines,
        predicate: |line| {
            match public_function_symbol(line) {
                Some(symbol) => {
                    return symbol == "Tool.run"
                }
                None => {
                    return false
                }
            }
        },
    )

    return PackageSourceContentFacts(
        public_functions: public_functions,
        api_symbols: api_symbols,
        tool_symbols: tool_symbols,
    )
}

fn package_source_path_sets(root: Path) -> Result<fresh PackageSourcePathSets, String> {
    let manifest_path = Path.join(
        base: root,
        child: "rsspkg.toml",
    )
    let manifest = parse_toml_result(path: manifest_path)?
    let interfaces = json_field_result(value: manifest, name: "interfaces")?
    let interface_paths = json_field_result(value: interfaces, name: "paths")?
    let sources = json_field_result(value: manifest, name: "sources")?
    let source_paths = json_field_result(value: sources, name: "paths")?

    return PackageSourcePathSets(
        interface_paths: read interface_paths,
        source_paths: read source_paths,
    )
}

fn add_source_path(
    facts: PackageSourceSetFacts,
    path: String,
    contents: String,
) -> fresh PackageSourceSetFacts {
    let is_manifest = path == "rsspkg.toml"
    let is_interface = String.ends_with(value: path, suffix: ".rssi")
    let is_source = String.ends_with(value: path, suffix: ".rss")
    let content_facts = source_content_facts(contents)
    let has_public_function = content_facts.public_functions > 0
    let has_api_run = content_facts.api_symbols > 0
    let has_tool_run = content_facts.tool_symbols > 0

    return PackageSourceSetFacts(
        total_files: facts.total_files + 1,
        manifest_files: add_bool(value: facts.manifest_files, condition: is_manifest),
        interface_files: add_bool(value: facts.interface_files, condition: is_interface),
        source_files: add_bool(value: facts.source_files, condition: is_source),
        public_interface_files: add_bool(
            value: facts.public_interface_files,
            condition: is_interface && has_public_function,
        ),
        public_source_files: add_bool(
            value: facts.public_source_files,
            condition: is_source && has_public_function,
        ),
        api_interface_symbols: add_bool(
            value: facts.api_interface_symbols,
            condition: is_interface && has_api_run,
        ),
        api_source_symbols: add_bool(
            value: facts.api_source_symbols,
            condition: is_source && has_api_run,
        ),
        tool_interface_symbols: add_bool(
            value: facts.tool_interface_symbols,
            condition: is_interface && has_tool_run,
        ),
        tool_source_symbols: add_bool(
            value: facts.tool_source_symbols,
            condition: is_source && has_tool_run,
        ),
    )
}

fn add_bool(value: Int, condition: Bool) -> Int {
    if condition {
        return value + 1
    }

    return value
}

fn count_source_path(
    root: Path,
    facts: PackageSourceSetFacts,
    relative_path: String,
) -> Result<fresh PackageSourceSetFacts, String> {
    let file_path = Path.join(
        base: root,
        child: relative_path,
    )

    match read_file_text_result(path: file_path) {
        Ok(contents) => {
            return Ok(add_source_path(
                facts,
                path: relative_path,
                contents,
            ))
        }
        Err(error) => {
            return Err(file_error(prefix: "source read", error))
        }
    }
}

fn count_source_paths(
    root: Path,
    facts: PackageSourceSetFacts,
    paths: List<String>,
) -> Result<fresh PackageSourceSetFacts, String> {
    return List.try_fold<String, PackageSourceSetFacts, String>(
        list: paths,
        initial: facts,
        folder: |state, relative_path| {
            return count_source_path(
                root,
                facts: state,
                relative_path,
            )
        },
    )
}

fn count_root_path(
    root: Path,
    facts: PackageSourceSetFacts,
    child: String,
) -> Result<fresh PackageSourceSetFacts, String> {
    let source_root = Path.join(
        base: root,
        child,
    )
    require_directory(path: source_root, label: child)?
    let paths = list_files_result(path: source_root)?

    return count_source_paths(
        root: source_root,
        facts,
        paths,
    )
}

fn count_root_paths(
    root: Path,
    roots: JsonValue,
    facts: PackageSourceSetFacts,
) -> Result<fresh PackageSourceSetFacts, String> {
    let children = json_array_strings_result(value: roots)?

    return List.try_fold<String, PackageSourceSetFacts, String>(
        list: children,
        initial: facts,
        folder: |state, child| {
            return count_root_path(
                root,
                facts: state,
                child,
            )
        },
    )
}

fn selfhost_source_set_facts() -> Result<fresh PackageSourceSetFacts, String> {
    let root = selfhost_source_root()
    require_directory(path: root, label: "package root")?
    let paths = package_source_path_sets(root)?
    let manifest = PackageSourceSetFacts(
        total_files: 1,
        manifest_files: 1,
        interface_files: 0,
        source_files: 0,
        public_interface_files: 0,
        public_source_files: 0,
        api_interface_symbols: 0,
        api_source_symbols: 0,
        tool_interface_symbols: 0,
        tool_source_symbols: 0,
    )
    let all_interfaces = count_root_paths(
        root,
        roots: paths.interface_paths,
        facts: manifest,
    )?

    return count_root_paths(
        root,
        roots: paths.source_paths,
        facts: all_interfaces,
    )
}

fn source_set_summary_line(facts: PackageSourceSetFacts) -> fresh String {
    let total = String.from_int(value: facts.total_files)
    let manifests = String.from_int(value: facts.manifest_files)
    let interfaces = String.from_int(value: facts.interface_files)
    let sources = String.from_int(value: facts.source_files)
    let public_interfaces = String.from_int(value: facts.public_interface_files)
    let public_sources = String.from_int(value: facts.public_source_files)
    let api_interfaces = String.from_int(value: facts.api_interface_symbols)
    let api_sources = String.from_int(value: facts.api_source_symbols)
    let tool_interfaces = String.from_int(value: facts.tool_interface_symbols)
    let tool_sources = String.from_int(value: facts.tool_source_symbols)
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "selfhost package sources total=")
    StringBuilder.push(builder: mut builder, value: total)
    StringBuilder.push(builder: mut builder, value: " manifests=")
    StringBuilder.push(builder: mut builder, value: manifests)
    StringBuilder.push(builder: mut builder, value: " interfaces=")
    StringBuilder.push(builder: mut builder, value: interfaces)
    StringBuilder.push(builder: mut builder, value: " sources=")
    StringBuilder.push(builder: mut builder, value: sources)
    StringBuilder.push(builder: mut builder, value: " public_interfaces=")
    StringBuilder.push(builder: mut builder, value: public_interfaces)
    StringBuilder.push(builder: mut builder, value: " public_sources=")
    StringBuilder.push(builder: mut builder, value: public_sources)
    StringBuilder.push(builder: mut builder, value: " api=")
    StringBuilder.push(builder: mut builder, value: api_interfaces)
    StringBuilder.push(builder: mut builder, value: "/")
    StringBuilder.push(builder: mut builder, value: api_sources)
    StringBuilder.push(builder: mut builder, value: " tool=")
    StringBuilder.push(builder: mut builder, value: tool_interfaces)
    StringBuilder.push(builder: mut builder, value: "/")
    StringBuilder.push(builder: mut builder, value: tool_sources)

    return StringBuilder.finish(builder: take builder)
}

pub fn main() -> Result<Unit, String> {
    let facts = selfhost_source_set_facts()?
    let summary = source_set_summary_line(facts)

    Log.write(message: summary)

    Assert.equal_int(left: facts.total_files, right: 5)
    Assert.equal_int(left: facts.manifest_files, right: 1)
    Assert.equal_int(left: facts.interface_files, right: 2)
    Assert.equal_int(left: facts.source_files, right: 2)
    Assert.equal_int(left: facts.public_interface_files, right: 2)
    Assert.equal_int(left: facts.public_source_files, right: 2)
    Assert.equal_int(left: facts.api_interface_symbols, right: 1)
    Assert.equal_int(left: facts.api_source_symbols, right: 1)
    Assert.equal_int(left: facts.tool_interface_symbols, right: 1)
    Assert.equal_int(left: facts.tool_source_symbols, right: 1)

    return Ok(Unit)
}
