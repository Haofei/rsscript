// List slice patterns in `match`: `[]`, fixed-length `[only]`, head/rest
// `[first, ..rest]`, tail `[..init, last]`, and middle-rest `[a, ..mid, z]`.
// Element bindings come out owned; the rest binding is a `List<T>`.

fn head_tail(xs: List<Int>) -> String {
    match read xs {
        [] => { return "empty" }
        [only] => { return String.from_int(value: only) }
        [first, ..rest] => {
            return String.from_int(value: first + List.len(list: rest))
        }
    }
}

fn ends(xs: List<Int>) -> Int {
    match read xs {
        [a, ..mid, z] => { return a + z + List.len(list: mid) }
        [..init, last] => { return last + List.len(list: init) }
        _ => { return 0 }
    }
}

fn main() -> Unit {
    let mut xs: List<Int> = List.new<Int>()
    List.push(list: mut xs, value: 4)
    List.push(list: mut xs, value: 5)
    List.push(list: mut xs, value: 6)
    Output.write(message: head_tail(xs))
    Output.write(message: String.from_int(value: ends(xs)))
    return Unit
}
