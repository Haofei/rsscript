// A sealed sum (enum) that carries payload variants, deriving Eq+Hash, used as a
// Map key. The Hashable bound accepts the enum because every variant payload
// field (`Int`, `String`) is itself hashable; the RS0211 derive check separately
// validates the payload fields. (User payload-variant construction is now an
// executable form — `Number(value: 5)` etc. — see RSS-13 in BUGS.md.)

sum Token derives(Clone, Eq, Hash) {
    End
    Number(value: Int)
    Name(text: String)
}

fn classify(token: Token) -> Int {
    match token {
        End => { return 0 }
        Number(value) => { return value }
        Name(text) => { return 1 }
    }
}

fn main() -> Unit {
    let counts = Map.new<Token, Int>()
    let end = End

    Map.insert(map: mut counts, key: end, value: classify(token: end))
    let here = Map.contains_key(map: counts, key: end)
    if here {
        Output.write(message: "token seen")
    }
    return Unit
}
