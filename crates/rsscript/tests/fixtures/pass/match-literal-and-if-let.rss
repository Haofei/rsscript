struct ToolRequest {
    name: String
}

fn dispatch(name: String) -> String {
    match name {
        "read_file" => { return "read" }
        "write_file" => { return "write" }
        _ => { return "unknown" }
    }
}

fn bool_label(value: Bool) -> String {
    return match value {
        true => { "yes" }
        false => { "no" }
    }
}

fn int_label(value: Int) -> String {
    return match value {
        0 => { "zero" }
        1 => { "one" }
        _ => { "many" }
    }
}

fn maybe_tool(enabled: Bool) -> Option<ToolRequest> {
    if enabled {
        return Some(ToolRequest(name: "read_file"))
    }
    return None
}

fn run(enabled: Bool) -> String {
    if let Some(tool) = maybe_tool(enabled) {
        return dispatch(name: tool.name)
    }
    return "none"
}

fn main() -> Unit {
    let result = run(enabled: true)
    Log.write(message: result)
}
