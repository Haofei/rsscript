features: async

struct NetworkError {
    message: String
}

async fn fetch_user(id: Int) -> Result<String, NetworkError> {
    return Ok("user")
}

async fn fetch_profile(id: Int) -> Result<String, NetworkError> {
    return Ok("profile")
}

fn load_user_data(id: Int) -> Result<String, NetworkError> {
    task_group {
        async let user = fetch_user(id)
        async let profile = fetch_profile(id)

        let user_value = await user?
        let profile_value = await profile?
    }
    return Ok("done")
}
