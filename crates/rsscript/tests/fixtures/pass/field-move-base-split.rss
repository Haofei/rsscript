features: local

struct Workspace {
    id: Int
}

struct Config {
    workspace: Workspace
}

fn inspect_workspace(workspace: Workspace) -> Unit
fn publish(config: Config) -> Unit
fn make_config() -> fresh Config

fn run() -> Unit {
    local config = make_config()
    inspect_workspace(workspace: config.workspace)
    publish(config: (manage config))
}
