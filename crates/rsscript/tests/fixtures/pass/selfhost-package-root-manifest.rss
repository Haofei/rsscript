
struct PackageRootManifestFacts {
    package_name: String
    version: String
    edition: String
    interface_paths: Int
    source_paths: Int
}

fn selfhost_package_root() -> fresh Path {
    let input = Args.get_or_default(
        index: 0,
        default: "tests/fixtures/pass/selfhost-package-source-set",
    )

    return Path.from_string(value: input)
}

fn selfhost_manifest_path() -> fresh Path {
    return Path.join(
        base: selfhost_package_root(),
        child: "rsspkg.toml",
    )
}

fn selfhost_root_manifest_facts() -> Result<fresh PackageRootManifestFacts, JsonError> {
    let manifest = Toml.parse_file(path: selfhost_manifest_path())?
    let package = Json.field(value: manifest, name: "package")?
    let interfaces = Json.field(value: manifest, name: "interfaces")?
    let interface_paths = Json.field(value: interfaces, name: "paths")?
    let sources = Json.field(value: manifest, name: "sources")?
    let source_paths = Json.field(value: sources, name: "paths")?

    return PackageRootManifestFacts(
        package_name: Json.field_string(value: package, name: "name")?,
        version: Json.field_string(value: package, name: "version")?,
        edition: Json.field_string(value: package, name: "edition")?,
        interface_paths: Json.array_len(value: interface_paths)?,
        source_paths: Json.array_len(value: source_paths)?,
    )
}

fn root_manifest_summary_line(facts: PackageRootManifestFacts) -> fresh String {
    let first = String.concat(left: "selfhost package root manifest name=", right: facts.package_name)
    let second = String.concat(left: first, right: " version=")
    let third = String.concat(left: second, right: facts.version)
    let fourth = String.concat(left: third, right: " edition=")
    let fifth = String.concat(left: fourth, right: facts.edition)
    let sixth = String.concat(left: fifth, right: " interface_paths=")
    let interface_count = String.from_int(value: facts.interface_paths)
    let seventh = String.concat(left: sixth, right: interface_count)
    let eighth = String.concat(left: seventh, right: " source_paths=")
    let source_count = String.from_int(value: facts.source_paths)

    return String.concat(left: eighth, right: source_count)
}

pub fn main() -> Result<Unit, JsonError> {
    let facts = selfhost_root_manifest_facts()?
    let summary = root_manifest_summary_line(facts)

    Output.write(message: summary)

    Assert.equal(left: facts.package_name, right: "rss-selfhost-source-set")
    Assert.equal(left: facts.version, right: "0.5.0")
    Assert.equal(left: facts.edition, right: "2024")
    Assert.equal_int(left: facts.interface_paths, right: 2)
    Assert.equal_int(left: facts.source_paths, right: 2)

    return Ok(Unit)
}
