// `#lower_name("...")` pins a function's backend Rust symbol (for FFI/autogen
// boundaries and compiler transitions). The pin is checked for validity and
// uniqueness and is reflected in the symbol inventory and generated Rust.
#lower_name("helpers__count")
fn count(value: Int) -> Int {
    return value
}

fn main() -> Unit {
    Output.write(message: String.from_int(value: count(value: 3)))
    return Unit
}
