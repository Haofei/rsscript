struct RemapFacts {
    diagnostics: Int
    mapped_errors: Int
    rustc_code_causes: Int
    source_file_hits: Int
    source_line_hits: Int
    source_column_hits: Int
}

fn empty_remap_facts() -> fresh RemapFacts {
    return RemapFacts(
        diagnostics: 0,
        mapped_errors: 0,
        rustc_code_causes: 0,
        source_file_hits: 0,
        source_line_hits: 0,
        source_column_hits: 0,
    )
}

fn add_bool(value: Int, condition: Bool) -> Int {
    if condition {
        return value + 1
    }

    return value
}

fn diagnose_remap_item(item: JsonValue, facts: RemapFacts) -> Result<fresh RemapFacts, JsonError> {
    let code = Json.field_string(value: item, name: "code")?
    let severity = Json.field_string(value: item, name: "severity")?
    let spans = Json.field(value: item, name: "spans")?
    let causes = Json.field(value: item, name: "causes")?
    let span = Json.array_get(value: spans, index: 0)?
    let file = Json.field_string(value: span, name: "file")?
    let normalized_file = String.replace(value: file, from: "\\", to: "/")
    let line = Json.field_int(value: span, name: "line")?
    let column = Json.field_int(value: span, name: "column")?
    let is_mapped_error = code == "RS1101" && severity == "error"
    let has_rustc_code = Json.array_contains_string(value: causes, item: "rustc code: E0308")?
    let has_source_file = String.ends_with(value: normalized_file, suffix: "src/main.rss")
    let has_source_line = line == 4
    let has_source_column = column == 31

    return RemapFacts(
        diagnostics: facts.diagnostics + 1,
        mapped_errors: add_bool(value: facts.mapped_errors, condition: is_mapped_error),
        rustc_code_causes: add_bool(value: facts.rustc_code_causes, condition: has_rustc_code),
        source_file_hits: add_bool(value: facts.source_file_hits, condition: has_source_file),
        source_line_hits: add_bool(value: facts.source_line_hits, condition: has_source_line),
        source_column_hits: add_bool(value: facts.source_column_hits, condition: has_source_column),
    )
}

fn selfhost_remap_facts() -> Result<fresh RemapFacts, JsonError> {
    let path = Path.from_string(value: "tests/fixtures/pass/selfhost-rustc-remap.json")
    let diagnostics = Json.parse_file(path)?

    return Json.array_fold<RemapFacts>(
        value: diagnostics,
        initial: empty_remap_facts(),
        folder: |facts, item| {
            return diagnose_remap_item(item, facts)
        },
    )
}

fn remap_summary_line(facts: RemapFacts) -> fresh String {
    let diagnostics = String.from_int(value: facts.diagnostics)
    let mapped = String.from_int(value: facts.mapped_errors)
    let rustc = String.from_int(value: facts.rustc_code_causes)
    let files = String.from_int(value: facts.source_file_hits)
    let lines = String.from_int(value: facts.source_line_hits)
    let columns = String.from_int(value: facts.source_column_hits)
    let first = String.concat(left: "selfhost rustc remap diagnostics=", right: diagnostics)
    let second = String.concat(left: first, right: " mapped=")
    let third = String.concat(left: second, right: mapped)
    let fourth = String.concat(left: third, right: " rustc_code=")
    let fifth = String.concat(left: fourth, right: rustc)
    let sixth = String.concat(left: fifth, right: " source_file=")
    let seventh = String.concat(left: sixth, right: files)
    let eighth = String.concat(left: seventh, right: " source_line=")
    let ninth = String.concat(left: eighth, right: lines)
    let tenth = String.concat(left: ninth, right: " source_column=")

    return String.concat(left: tenth, right: columns)
}

pub fn main() -> Result<Unit, JsonError> {
    let facts = selfhost_remap_facts()?
    let summary = remap_summary_line(facts)

    Output.write(message: summary)

    Assert.equal_int(left: facts.diagnostics, right: 1)
    Assert.equal_int(left: facts.mapped_errors, right: 1)
    Assert.equal_int(left: facts.rustc_code_causes, right: 1)
    Assert.equal_int(left: facts.source_file_hits, right: 1)
    Assert.equal_int(left: facts.source_line_hits, right: 1)
    Assert.equal_int(left: facts.source_column_hits, right: 1)

    return Ok(Unit)
}
