
struct Image {
    pixels: Buffer
}

fn Image.load(path: Path) -> fresh Image
fn Image.inspect(image: Image) -> Unit

fn inspect_or_store(path: Path, should_store: Bool) -> Unit {
    local image = Image.load(path)
    if should_store {
        let shared = manage image
        return Unit
    }
    Image.inspect(image)
}
