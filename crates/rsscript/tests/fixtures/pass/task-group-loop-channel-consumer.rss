features: async, local

async fn produce(sender: Sender<Int>) -> Result<Unit, ChannelError> {
    local first = 1
    await Sender.send(sender, value: take first)?
    local second = 2
    await Sender.send(sender, value: take second)?
    return Ok(Unit)
}

async fn consume(receiver: Receiver<Int>) -> Result<Int, ChannelError> {
    let mut count = 0
    while count < 2 {
        let item = await Receiver.recv(receiver)?
        count = count + 1
    }
    return Ok(2)
}

fn main() -> Result<Unit, ChannelError> {
    let mut channel = Channel.bounded<Int>(capacity: 1)?
    let sender = Channel.sender(channel)
    let receiver = Channel.receiver(channel: mut channel)?

    task_group {
        async let producer = produce(sender)
        async let consumer = consume(receiver)

        let count = await consumer?
        await producer?
    }

    return Ok(Unit)
}
