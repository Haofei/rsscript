features: local

class Cache {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

fn Image.load(path: Path) -> fresh Image
fn Image.inspect(image: Image) -> Unit

fn cache_put(cache: mut Cache, value: Image) -> Unit
    effects(retains(value))
{
}

fn run(cache: mut Cache, path: Path, inspect_local: Bool) -> Unit {
    if inspect_local {
        local image = Image.load(path)
        Image.inspect(image)
    }

    let image = Image.load(path)
    cache_put(cache: mut cache, value: image)
}
