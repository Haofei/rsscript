features: local

struct Picture {
    pixels: Buffer
}

struct PictureError

fn Picture.load(path: Path) -> Result<fresh Picture, PictureError>
fn Picture.resize(image: mut Picture, width: Int, height: Int) -> Unit
fn Picture.normalize(image: mut Picture) -> Unit
fn Picture.save(image: Picture, path: Path) -> Result<Unit, PictureError>

fn make_thumbnail(input: Path, output: Path) -> Result<Unit, PictureError> {
    local image = Picture.load(path: input)?

    Picture.resize(image: mut image, width: 256, height: 256)
    Picture.normalize(image: mut image)

    let shared = manage image

    Picture.save(image: shared, path: output)?

    return Ok(Unit)
}
