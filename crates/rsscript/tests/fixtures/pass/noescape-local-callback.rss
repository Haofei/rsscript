features: local

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn use_local(path: Path) -> Result<fresh Image, ImageError> {
    local image = Image.load(path)?
    apply(callback: || {
        Image.inspect(image)
    })
    return Ok(image)
}

fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: "rsscript-image-input.bin")
    let data = Bytes.from_string(value: "raw image bytes")

    with File.open_write(path)? as file {
        File.write(file: mut file, data)?
    }

    match use_local(path) {
        Ok(image) => {
            return Ok(Unit)
        }
        Err(error) => {
            Log.write(message: "noescape local callback failed")
            return Ok(Unit)
        }
    }
}
