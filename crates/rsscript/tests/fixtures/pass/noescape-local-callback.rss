
struct Picture
struct PictureError

fn Picture.load(path: Path) -> Result<fresh Picture, PictureError>
fn Picture.inspect(picture: Picture) -> Unit

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn use_local(path: Path) -> Result<fresh Picture, PictureError> {
    local picture = Picture.load(path)?
    apply(callback: || {
        Picture.inspect(picture)
    })
    return Ok(picture)
}

fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: "rsscript-image-input.bin")
    let data = Bytes.from_string(value: "raw image bytes")

    with File.open_write(path)? as file {
        File.write(file: mut file, data)?
    }

    match use_local(path) {
        Ok(picture) => {
            return Ok(Unit)
        }
        Err(error) => {
            Output.write(message: "noescape local callback failed")
            return Ok(Unit)
        }
    }
}
