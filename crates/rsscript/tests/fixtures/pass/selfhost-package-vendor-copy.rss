features: local

struct VendorCopyFacts {
    copied_files: Int
    interface_files: Int
    source_files: Int
    manifest_files: Int
}

fn source_root() -> fresh Path {
    let input = Args.get_or_default(
        index: 0,
        default: "tests/fixtures/pass/selfhost-package-source-set",
    )

    return Path.from_string(value: input)
}

fn vendor_root() -> fresh Path {
    let input = Args.get_or_default(
        index: 1,
        default: "target/rsscript-selfhost-vendor/rss-selfhost-source-set-0.5.0",
    )

    return Path.from_string(value: input)
}

fn empty_facts() -> fresh VendorCopyFacts {
    return VendorCopyFacts(
        copied_files: 0,
        interface_files: 0,
        source_files: 0,
        manifest_files: 0,
    )
}

fn bool_count(value: Bool) -> Int {
    if value {
        return 1
    }

    return 0
}

fn add_file_facts(facts: VendorCopyFacts, relative_path: String) -> fresh VendorCopyFacts {
    let is_interface = String.ends_with(value: relative_path, suffix: ".rssi")
    let is_source = String.ends_with(value: relative_path, suffix: ".rss")
    let is_manifest = relative_path == "rsspkg.toml"

    return VendorCopyFacts(
        copied_files: facts.copied_files + 1,
        interface_files: facts.interface_files + bool_count(value: is_interface),
        source_files: facts.source_files + bool_count(value: is_source),
        manifest_files: facts.manifest_files + bool_count(value: is_manifest),
    )
}

fn ensure_parent_directory(path: Path) -> Result<Unit, FileError> {
    match Path.parent(path) {
        Some(parent) => {
            Directory.create_all(path: parent)?
        }
        None => {
        }
    }

    return Ok(Unit)
}

fn read_text(path: Path) -> Result<String, FileError> {
    with File.open_read(path)? as file {
        let text = File.read_all_string(file: mut file)?

        return Ok(text)
    }
}

fn write_text(path: Path, text: String) -> Result<Unit, FileError> {
    ensure_parent_directory(path)?

    with File.open_write(path)? as file {
        File.write_string(file: mut file, text)?
    }

    return Ok(Unit)
}

fn copy_relative_file(
    source: Path,
    vendor: Path,
    facts: VendorCopyFacts,
    relative_path: String,
) -> Result<fresh VendorCopyFacts, FileError> {
    let input = Path.join(base: source, child: relative_path)
    let output = Path.join(base: vendor, child: relative_path)
    let contents = read_text(path: input)?
    write_text(path: output, text: contents)?

    return add_file_facts(facts, relative_path)
}

fn copy_package_tree(
    source: Path,
    vendor: Path,
    files: List<String>,
) -> Result<fresh VendorCopyFacts, FileError> {
    return List.try_fold<String, VendorCopyFacts, FileError>(
        list: files,
        initial: empty_facts(),
        folder: |facts, relative_path| {
            return copy_relative_file(
                source,
                vendor,
                facts,
                relative_path,
            )
        },
    )
}

fn summary_line(facts: VendorCopyFacts) -> fresh String {
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "selfhost package vendor copied=")
    let copied = String.from_int(value: facts.copied_files)
    StringBuilder.push(builder: mut builder, value: copied)
    StringBuilder.push(builder: mut builder, value: " interfaces=")
    let interfaces = String.from_int(value: facts.interface_files)
    StringBuilder.push(builder: mut builder, value: interfaces)
    StringBuilder.push(builder: mut builder, value: " sources=")
    let sources = String.from_int(value: facts.source_files)
    StringBuilder.push(builder: mut builder, value: sources)
    StringBuilder.push(builder: mut builder, value: " manifests=")
    let manifests = String.from_int(value: facts.manifest_files)
    StringBuilder.push(builder: mut builder, value: manifests)

    return StringBuilder.finish(builder: take builder)
}

pub fn main() -> Result<Unit, FileError> {
    let source = source_root()
    let vendor = vendor_root()
    Directory.create_all(path: vendor)?
    let files = Directory.list_files(path: source)?
    let facts = copy_package_tree(
        source,
        vendor,
        files,
    )?
    let summary = summary_line(facts)

    Log.write(message: summary)

    return Ok(Unit)
}
