features: local, native

class User {
    id: String
}

struct Session {
    owner: weak User
    trace_id: String
}

struct UploadPlan {
    input: Path
    output: Path
    trace_id: String
}

struct WorkItem {
    plan: UploadPlan
    session: Session
}

class RetainedImageStore {
}

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: Image) -> Unit
    effects(retains(image))

fn User.lookup(id: String) -> User
fn User.touch(user: User) -> Unit

fn audit_step(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn HttpError.from_config(error: ConfigError) -> HttpError
fn HttpError.from_json(error: JsonError) -> HttpError
fn HttpError.from_image(error: ImageError) -> HttpError
fn HttpError.from_db(error: DbError) -> HttpError

fn parse_plan(request: Request) -> Result<fresh UploadPlan, JsonError> {
    let body = Request.path(request)
    let json = Json.parse(text: body)?
    local input_text = Json.field_string(value: json, name: "input")?
    local output_text = Json.field_string(value: json, name: "output")?
    local trace_id = Json.field_string(value: json, name: "trace")?
    local input = Path.from_string(value: input_text)
    local output = Path.from_string(value: output_text)

    return UploadPlan(
        input: take input,
        output: take output,
        trace_id: take trace_id,
    )
}

fn build_session(owner: User, trace_id: String) -> fresh Session {
    return Session(
        owner: Weak.from(value: owner),
        trace_id: read trace_id,
    )
}

fn inspect_session(session: Session) -> Unit {
    let maybe_owner = Weak.upgrade(value: session.owner)
    audit_step(callback: || {
        Log.write(message: session.trace_id)
    })

    return Unit
}

fn build_work_item(request: Request, owner_id: String) -> Result<fresh WorkItem, JsonError> {
    local plan = parse_plan(request)?
    let owner = User.lookup(id: owner_id)
    local session = build_session(owner, trace_id: plan.trace_id)

    return WorkItem(plan: take plan, session: take session)
}

fn load_first_row(path: Path) -> Result<fresh Row, CsvError> {
    local buffer = RowBuffer.new(size: 8192)

    with Csv.open_read(path)? as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
    }

    return Csv.parse_row(buffer)
}

fn process_image(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, ImageError> {
    local image = Image.load(path: plan.input)?

    audit_step(callback: || {
        Image.inspect(image)
    })

    Image.resize(image: mut image, width: 1024, height: 768)
    Image.normalize(image: mut image)
    Image.sharpen(image: mut image)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: shared)
    Image.save(image: shared, path: plan.output)?

    return Ok(Unit)
}

fn refresh_config(path: Path, store: mut ConfigStore) -> Result<Unit, ConfigError> {
    let config = Config.load(path)?
    ConfigStore.replace(store: mut store, value: config)

    return Ok(Unit)
}

fn run_audit_query(url: Url, trace_id: String) -> Result<Unit, DbError> {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.open(url),
        max_size: 2,
    )

    with ResourcePool.borrow(pool: mut pool) as conn {
        DbConnection.query(conn: mut conn, sql: trace_id)?
    }

    return Ok(Unit)
}

fn refresh_config_http(path: Path, store: mut ConfigStore) -> Result<Unit, HttpError> {
    match refresh_config(path, store: mut store) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error))
        }
    }
}

fn build_work_item_http(
    request: Request,
    owner_id: String,
) -> Result<WorkItem, HttpError> {
    match build_work_item(request, owner_id) {
        Ok(item) => {
            return Ok(item)
        }
        Err(error) => {
            return Err(HttpError.from_json(error))
        }
    }
}

fn process_image_http(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, HttpError> {
    match process_image(plan, cache: mut cache) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_image(error))
        }
    }
}

fn run_audit_query_http(url: Url, trace_id: String) -> Result<Unit, HttpError> {
    match run_audit_query(url, trace_id) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_db(error))
        }
    }
}

fn persist_trace(cache: mut Cache, trace_id: String, status: String) -> Unit {
    Cache.insert(cache: mut cache, key: trace_id, value: status)
    return Unit
}

fn handle_request(
    request: Request,
    owner_id: String,
    image_store: mut RetainedImageStore,
    config_store: mut ConfigStore,
    status_cache: mut Cache,
    counter: mut Counter,
    db_url: Url,
) -> Result<fresh Response, HttpError> {
    let config_path = Path.from_string(value: "config.json")
    refresh_config_http(path: config_path, store: mut config_store)?

    let item = build_work_item_http(request, owner_id)?
    inspect_session(session: item.session)
    process_image_http(plan: item.plan, cache: mut image_store)?
    run_audit_query_http(url: db_url, trace_id: item.plan.trace_id)?

    let status = ConfigStore.name(store: config_store)
    persist_trace(cache: mut status_cache, trace_id: item.plan.trace_id, status)
    Counter.add(counter: mut counter, amount: 1)
    Log.write(message: item.plan.trace_id)

    return Response.ok(body: status)?
}
