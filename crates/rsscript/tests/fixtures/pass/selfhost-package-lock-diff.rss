
struct PackageLockDiffFacts {
    declared_risk: Int
    package_changes: Int
    high_package_changes: Int
    high_feature_changes: Int
    unmodeled_reasons: Int
}

struct PackageLockDiffDecision {
    risk: Int
    mismatches: Int
}

fn LockRisk.low() -> Int {
    return 1
}

fn LockRisk.elevated() -> Int {
    return 2
}

fn LockRisk.high() -> Int {
    return 3
}

fn LockRisk.unknown() -> Int {
    return 4
}

fn lock_risk_from_string(value: String) -> Int {
    if value == "unknown" {
        return LockRisk.unknown()
    }

    if value == "high" {
        return LockRisk.high()
    }

    if value == "elevated" {
        return LockRisk.elevated()
    }

    return LockRisk.low()
}

fn max_lock_risk(left: Int, right: Int) -> Int {
    if left > right {
        return left
    }

    return right
}

fn lock_diff_reason_is_modeled(reason: String) -> Bool {
    if reason == "RSScript package added to lockfile" {
        return true
    }

    if reason == "RSScript package removed from lockfile" {
        return true
    }

    if reason == "RSScript package version changed" {
        return true
    }

    if reason == ".rssi interface hash changed" {
        return true
    }

    if reason == "review metadata hash changed" {
        return true
    }

    if reason == "native wrapper source hash changed" {
        return true
    }

    if reason == "package checksum changed" {
        return true
    }

    if reason == "package feature selection changed" {
        return true
    }

    if reason == "package source changed" {
        return true
    }

    return false
}

fn count_unmodeled_lock_reasons_from(
    reasons: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let item = Json.array_get(value: reasons, index)?
    let reason = Json.as_string(value: item)?
    let rest = count_unmodeled_lock_reasons_from(
        reasons,
        index: index + 1,
        limit,
    )?

    if lock_diff_reason_is_modeled(reason) {
        return Ok(rest)
    }

    return Ok(rest + 1)
}

fn count_unmodeled_lock_reasons(reasons: JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: reasons)?

    return count_unmodeled_lock_reasons_from(
        reasons,
        index: 0,
        limit,
    )
}

fn count_high_package_changes_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let rest = count_high_package_changes_from(
        changes,
        index: index + 1,
        limit,
    )?

    if risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn count_high_feature_fields_from(
    fields: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let field = Json.array_get(value: fields, index)?
    let name = Json.field_string(value: field, name: "field")?
    let risk_text = Json.field_string(value: field, name: "risk")?
    let rest = count_high_feature_fields_from(
        fields,
        index: index + 1,
        limit,
    )?

    if name == "features" && risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn count_high_feature_changes_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: changes, index)?
    let fields = Json.field(value: change, name: "changes")?
    let field_count = Json.array_len(value: fields)?
    let high_here = count_high_feature_fields_from(
        fields,
        index: 0,
        limit: field_count,
    )?
    let rest = count_high_feature_changes_from(
        changes,
        index: index + 1,
        limit,
    )?

    return Ok(high_here + rest)
}

fn max_package_change_risk_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
    risk: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(risk)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let change_risk = lock_risk_from_string(value: risk_text)
    let next = max_lock_risk(left: risk, right: change_risk)

    return max_package_change_risk_from(
        changes,
        index: index + 1,
        limit,
        risk: next,
    )
}

fn max_package_change_risk(changes: JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: changes)?

    return max_package_change_risk_from(
        changes,
        index: 0,
        limit,
        risk: LockRisk.low(),
    )
}

fn parse_package_lock_diff_facts(
    value: JsonValue,
) -> Result<fresh PackageLockDiffFacts, JsonError> {
    let risk = Json.field_string(value, name: "risk")?
    let changes = Json.field(value, name: "package_changes")?
    let reasons = Json.field(value, name: "reasons")?
    let change_count = Json.array_len(value: changes)?

    return PackageLockDiffFacts(
        declared_risk: lock_risk_from_string(value: risk),
        package_changes: change_count,
        high_package_changes: count_high_package_changes_from(
            changes,
            index: 0,
            limit: change_count,
        )?,
        high_feature_changes: count_high_feature_changes_from(
            changes,
            index: 0,
            limit: change_count,
        )?,
        unmodeled_reasons: count_unmodeled_lock_reasons(reasons)?,
    )
}

fn classify_package_lock_diff(
    facts: PackageLockDiffFacts,
    changes: JsonValue,
) -> Result<fresh PackageLockDiffDecision, JsonError> {
    let risk = max_package_change_risk(changes)?
    let mismatch = lock_diff_mismatch_count(risk, expected: facts.declared_risk)

    return PackageLockDiffDecision(
        risk: risk,
        mismatches: mismatch,
    )
}

fn lock_diff_mismatch_count(risk: Int, expected: Int) -> Int {
    if risk != expected {
        return 1
    }

    return 0
}

fn selfhost_package_lock_diff_json() -> Result<fresh JsonValue, JsonError> {
    let path = Path.from_string(value: "tests/fixtures/pass/selfhost-package-lock-diff.json")

    return Json.parse_file(path)
}

fn lock_diff_summary_line(
    facts: PackageLockDiffFacts,
    decision: PackageLockDiffDecision,
) -> fresh String {
    let packages = String.from_int(value: facts.package_changes)
    let high_packages = String.from_int(value: facts.high_package_changes)
    let high_features = String.from_int(value: facts.high_feature_changes)
    let mismatches = String.from_int(value: decision.mismatches)
    let unmodeled = String.from_int(value: facts.unmodeled_reasons)
    let first = String.concat(left: "selfhost package lock diff packages=", right: packages)
    let second = String.concat(left: first, right: " high_packages=")
    let third = String.concat(left: second, right: high_packages)
    let fourth = String.concat(left: third, right: " high_features=")
    let fifth = String.concat(left: fourth, right: high_features)
    let sixth = String.concat(left: fifth, right: " mismatches=")
    let seventh = String.concat(left: sixth, right: mismatches)
    let eighth = String.concat(left: seventh, right: " unmodeled_reasons=")

    return String.concat(left: eighth, right: unmodeled)
}

pub fn main() -> Result<Unit, JsonError> {
    let value = selfhost_package_lock_diff_json()?
    let changes = Json.field(value, name: "package_changes")?
    let facts = parse_package_lock_diff_facts(value)?
    let decision = classify_package_lock_diff(
        facts,
        changes,
    )?
    let summary = lock_diff_summary_line(facts, decision)

    Log.write(message: summary)

    Assert.equal_int(left: decision.risk, right: facts.declared_risk)
    Assert.equal_int(left: decision.mismatches, right: 0)
    Assert.equal_int(left: facts.unmodeled_reasons, right: 0)
    Assert.equal_int(left: facts.package_changes, right: 1)
    Assert.equal_int(left: facts.high_package_changes, right: 1)
    Assert.equal_int(left: facts.high_feature_changes, right: 1)

    return Ok(Unit)
}
