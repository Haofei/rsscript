features: local

struct PackageRiskFacts {
    declared_risk: Int
    errors: Int
    has_manifest_unknown: Bool
    has_review_unknown: Bool
    has_interface_error: Bool
    has_native: Bool
    has_native_build: Bool
    has_native_proc_macro: Bool
    has_native_unsafe: Bool
    has_native_links: Bool
    has_feature_boundary: Bool
    has_review_must: Bool
    unmodeled_reasons: Int
}

struct PackageRiskSummary {
    total_cases: Int
    mismatches: Int
    unmodeled_reasons: Int
    low_cases: Int
    elevated_cases: Int
    high_cases: Int
    unknown_cases: Int
}

fn PackageRisk.low() -> Int {
    return 1
}

fn PackageRisk.elevated() -> Int {
    return 2
}

fn PackageRisk.high() -> Int {
    return 3
}

fn PackageRisk.unknown() -> Int {
    return 4
}

fn package_risk_from_string(value: read String) -> Int {
    if value == "unknown" {
        return PackageRisk.unknown()
    }

    if value == "high" {
        return PackageRisk.high()
    }

    if value == "elevated" {
        return PackageRisk.elevated()
    }

    return PackageRisk.low()
}

fn package_reason_is_modeled(reason: read String) -> Bool {
    if reason == "manifest declares unknown package risk" {
        return true
    }

    if reason == "package declares selectable package features" {
        return true
    }

    if reason == "package feature `native-tls` may change native/unsafe/build risk" {
        return true
    }

    if reason == "package policy denies unknown review risk" {
        return true
    }

    if reason == "package policy denies native boundaries" || reason == "package policy denies unsafe APIs" {
        return true
    }

    if reason == "package policy denies native public APIs" || reason == "package policy denies native Rust wrappers" {
        return true
    }

    if reason == "package policy denies native implementation risk" {
        return true
    }

    if reason == "package policy denies unsafe public APIs" || reason == "package policy denies native unsafe policy" {
        return true
    }

    if reason == "package policy denies detected unsafe native code" {
        return true
    }

    if reason == "native Rust wrapper enabled" {
        return true
    }

    if reason == "native Rust build scripts require review" {
        return true
    }

    if reason == "native Rust proc macros require review" {
        return true
    }

    if reason == "native Rust unsafe policy requires review" {
        return true
    }

    if reason == "native Rust links external libraries" {
        return true
    }

    if reason == "review map contains unknown functions" {
        return true
    }

    if reason == "review map contains must-review functions" {
        return true
    }

    if reason == "package contains frontend errors" || reason == "package contains frontend warnings" {
        return true
    }

    if reason == "public .rssi contract contains frontend errors" {
        return true
    }

    return false
}

fn count_unmodeled_package_reasons(reasons: read JsonValue) -> Result<Int, JsonError> {
    return Json.array_count_where(
        value: read reasons,
        predicate: |item| {
            let reason = Json.as_string(value: read item)?
            if package_reason_is_modeled(reason: read reason) {
                return Ok(false)
            }

            return Ok(true)
        },
    )
}

fn parse_package_risk_facts(value: read JsonValue) -> Result<fresh PackageRiskFacts, JsonError> {
    let risk = Json.field_string(value: read value, name: read "risk")?
    let reasons = Json.field(value: read value, name: read "reasons")?
    let summary = Json.field(value: read value, name: read "summary")?

    return PackageRiskFacts(
        declared_risk: package_risk_from_string(value: read risk),
        errors: Json.field_int(value: read summary, name: read "errors")?,
        has_manifest_unknown: Json.array_contains_string(value: read reasons, item: read "manifest declares unknown package risk")?,
        has_review_unknown: Json.array_contains_string(value: read reasons, item: read "review map contains unknown functions")?,
        has_interface_error: Json.array_contains_string(value: read reasons, item: read "public .rssi contract contains frontend errors")?,
        has_native: Json.array_contains_string(value: read reasons, item: read "native Rust wrapper enabled")?,
        has_native_build: Json.array_contains_string(value: read reasons, item: read "native Rust build scripts require review")?,
        has_native_proc_macro: Json.array_contains_string(value: read reasons, item: read "native Rust proc macros require review")?,
        has_native_unsafe: Json.array_contains_string(value: read reasons, item: read "native Rust unsafe policy requires review")?,
        has_native_links: Json.array_contains_string(value: read reasons, item: read "native Rust links external libraries")?,
        has_feature_boundary: Json.array_contains_string(value: read reasons, item: read "package feature `native-tls` may change native/unsafe/build risk")?,
        has_review_must: Json.array_contains_string(value: read reasons, item: read "review map contains must-review functions")?,
        unmodeled_reasons: count_unmodeled_package_reasons(reasons: read reasons)?,
    )
}

fn classify_package_risk(facts: read PackageRiskFacts) -> Int {
    if facts.has_manifest_unknown || facts.has_review_unknown || facts.has_interface_error {
        return PackageRisk.unknown()
    }

    if facts.errors > 0 {
        return PackageRisk.high()
    }

    if facts.has_native_build || facts.has_native_proc_macro || facts.has_native_unsafe || facts.has_native_links || facts.has_feature_boundary {
        return PackageRisk.high()
    }

    if facts.has_native || facts.has_review_must {
        return PackageRisk.elevated()
    }

    return PackageRisk.low()
}

fn empty_package_risk_summary() -> fresh PackageRiskSummary {
    return PackageRiskSummary(
        total_cases: 0,
        mismatches: 0,
        unmodeled_reasons: 0,
        low_cases: 0,
        elevated_cases: 0,
        high_cases: 0,
        unknown_cases: 0,
    )
}

fn add_package_risk_case(
    summary: read PackageRiskSummary,
    facts: read PackageRiskFacts,
) -> fresh PackageRiskSummary {
    let actual = classify_package_risk(facts: read facts)
    let next_mismatches = next_mismatch_count(
        summary: read summary,
        facts: read facts,
        actual: actual,
    )
    let next_unmodeled = summary.unmodeled_reasons + facts.unmodeled_reasons

    if actual == PackageRisk.unknown() {
        return PackageRiskSummary(
            total_cases: summary.total_cases + 1,
            mismatches: next_mismatches,
            unmodeled_reasons: next_unmodeled,
            low_cases: summary.low_cases,
            elevated_cases: summary.elevated_cases,
            high_cases: summary.high_cases,
            unknown_cases: summary.unknown_cases + 1,
        )
    }

    if actual == PackageRisk.high() {
        return PackageRiskSummary(
            total_cases: summary.total_cases + 1,
            mismatches: next_mismatches,
            unmodeled_reasons: next_unmodeled,
            low_cases: summary.low_cases,
            elevated_cases: summary.elevated_cases,
            high_cases: summary.high_cases + 1,
            unknown_cases: summary.unknown_cases,
        )
    }

    if actual == PackageRisk.elevated() {
        return PackageRiskSummary(
            total_cases: summary.total_cases + 1,
            mismatches: next_mismatches,
            unmodeled_reasons: next_unmodeled,
            low_cases: summary.low_cases,
            elevated_cases: summary.elevated_cases + 1,
            high_cases: summary.high_cases,
            unknown_cases: summary.unknown_cases,
        )
    }

    return PackageRiskSummary(
        total_cases: summary.total_cases + 1,
        mismatches: next_mismatches,
        unmodeled_reasons: next_unmodeled,
        low_cases: summary.low_cases + 1,
        elevated_cases: summary.elevated_cases,
        high_cases: summary.high_cases,
        unknown_cases: summary.unknown_cases,
    )
}

fn next_mismatch_count(
    summary: read PackageRiskSummary,
    facts: read PackageRiskFacts,
    actual: Int,
) -> Int {
    if actual != facts.declared_risk {
        return summary.mismatches + 1
    }

    return summary.mismatches
}

fn fold_package_risk_case(
    summary: read PackageRiskSummary,
    item: read JsonValue,
) -> Result<fresh PackageRiskSummary, JsonError> {
    let facts = parse_package_risk_facts(value: read item)?

    return Ok(add_package_risk_case(summary: read summary, facts: read facts))
}

fn selfhost_package_risk_summary() -> Result<fresh PackageRiskSummary, JsonError> {
    let input = Args.get_or_default(
        index: 0,
        default: read "tests/fixtures/pass/selfhost-package-review.json",
    )
    let path = Path.from_string(value: read input)
    let json = Json.parse_file(path: read path)?

    return Json.array_fold<PackageRiskSummary>(
        value: read json,
        initial: read empty_package_risk_summary(),
        folder: |summary, item| {
            return fold_package_risk_case(summary: read summary, item: read item)
        },
    )
}

fn package_risk_summary_line(
    summary: read PackageRiskSummary,
) -> fresh String {
    let total = String.from_int(value: summary.total_cases)
    let mismatches = String.from_int(value: summary.mismatches)
    let unmodeled = String.from_int(value: summary.unmodeled_reasons)
    let low = String.from_int(value: summary.low_cases)
    let elevated = String.from_int(value: summary.elevated_cases)
    let high = String.from_int(value: summary.high_cases)
    let unknown = String.from_int(value: summary.unknown_cases)
    let first = String.concat(left: read "selfhost package risk cases=", right: read total)
    let second = String.concat(left: read first, right: read " mismatches=")
    let third = String.concat(left: read second, right: read mismatches)
    let fourth = String.concat(left: read third, right: read " unmodeled_reasons=")
    let fifth = String.concat(left: read fourth, right: read unmodeled)
    let sixth = String.concat(left: read fifth, right: read " low=")
    let seventh = String.concat(left: read sixth, right: read low)
    let eighth = String.concat(left: read seventh, right: read " elevated=")
    let ninth = String.concat(left: read eighth, right: read elevated)
    let tenth = String.concat(left: read ninth, right: read " high=")
    let eleventh = String.concat(left: read tenth, right: read high)
    let twelfth = String.concat(left: read eleventh, right: read " unknown=")

    return String.concat(left: read twelfth, right: read unknown)
}

pub fn main() -> Result<Unit, JsonError> {
    let summary = selfhost_package_risk_summary()?
    let summary_line = package_risk_summary_line(summary: read summary)

    Log.write(message: read summary_line)

    Assert.equal_int(left: summary.total_cases, right: 5)
    Assert.equal_int(left: summary.mismatches, right: 0)
    Assert.equal_int(left: summary.unmodeled_reasons, right: 0)
    Assert.equal_int(left: summary.low_cases, right: 1)
    Assert.equal_int(left: summary.elevated_cases, right: 1)
    Assert.equal_int(left: summary.high_cases, right: 2)
    Assert.equal_int(left: summary.unknown_cases, right: 1)

    return Ok(Unit)
}
