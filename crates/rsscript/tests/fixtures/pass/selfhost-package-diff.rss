
struct PackageDiffFacts {
    declared_risk: Int
    old_review_risk: Int
    new_review_risk: Int
    manifest_risk: Int
    interface_risk: Int
    manifest_changes: Int
    interface_changes: Int
    high_manifest_changes: Int
    high_interface_changes: Int
    callback_contract_changes: Int
    unmodeled_reasons: Int
}

struct PackageDiffDecision {
    risk: Int
    mismatches: Int
}

fn DiffRisk.low() -> Int {
    return 1
}

fn DiffRisk.elevated() -> Int {
    return 2
}

fn DiffRisk.high() -> Int {
    return 3
}

fn DiffRisk.unknown() -> Int {
    return 4
}

fn diff_risk_from_string(value: String) -> Int {
    if value == "unknown" {
        return DiffRisk.unknown()
    }

    if value == "high" {
        return DiffRisk.high()
    }

    if value == "elevated" {
        return DiffRisk.elevated()
    }

    return DiffRisk.low()
}

fn max_risk(left: Int, right: Int) -> Int {
    if left > right {
        return left
    }

    return right
}

fn diff_reason_is_modeled(reason: String) -> Bool {
    if reason == "RSScript dependencies changed" {
        return true
    }

    if reason == "package features changed" {
        return true
    }

    if reason == "native Rust wrapper metadata changed" {
        return true
    }

    if reason == "public .rssi semantic contract changed" {
        return true
    }

    if reason == "high-risk interface change detected" {
        return true
    }

    if String.starts_with(value: reason, prefix: "package risk changed from ") {
        return true
    }

    return false
}

fn count_unmodeled_diff_reasons_from(
    reasons: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let item = Json.array_get(value: reasons, index)?
    let reason = Json.as_string(value: item)?
    let rest = count_unmodeled_diff_reasons_from(
        reasons,
        index: index + 1,
        limit,
    )?

    if diff_reason_is_modeled(reason) {
        return Ok(rest)
    }

    return Ok(rest + 1)
}

fn count_unmodeled_diff_reasons(reasons: JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: reasons)?

    return count_unmodeled_diff_reasons_from(
        reasons,
        index: 0,
        limit,
    )
}

fn max_manifest_risk_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
    risk: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(risk)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let change_risk = diff_risk_from_string(value: risk_text)
    let next = max_risk(left: risk, right: change_risk)

    return max_manifest_risk_from(
        changes,
        index: index + 1,
        limit,
        risk: next,
    )
}

fn max_manifest_risk(changes: JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: changes)?

    return max_manifest_risk_from(
        changes,
        index: 0,
        limit,
        risk: DiffRisk.low(),
    )
}

fn high_interface_count_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let rest = high_interface_count_from(
        changes,
        index: index + 1,
        limit,
    )?

    if risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn high_manifest_count_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let rest = high_manifest_count_from(
        changes,
        index: index + 1,
        limit,
    )?

    if risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn max_interface_risk_from(
    changes: JsonValue,
    index: Int,
    limit: Int,
    risk: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(risk)
    }

    let change = Json.array_get(value: changes, index)?
    let risk_text = Json.field_string(value: change, name: "risk")?
    let change_risk = diff_risk_from_string(value: risk_text)
    let next = max_risk(left: risk, right: change_risk)

    return max_interface_risk_from(
        changes,
        index: index + 1,
        limit,
        risk: next,
    )
}

fn max_interface_risk(changes: JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: changes)?

    return max_interface_risk_from(
        changes,
        index: 0,
        limit,
        risk: DiffRisk.low(),
    )
}

fn callback_contract_finding_is_modeled(finding: JsonValue) -> Result<Bool, JsonError> {
    let before = Json.field_string(value: finding, name: "before")?
    let after = Json.field_string(value: finding, name: "after")?

    if before == "callback: read Fn(Int) -> Result<String, BuildError>" {
        if after == "callback: read Fn(Int) -> Result<Int, BuildError>" {
            return Ok(true)
        }
    }

    return Ok(false)
}

fn callback_contract_count_from_findings(
    findings: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let finding = Json.array_get(value: findings, index)?
    let rest = callback_contract_count_from_findings(
        findings,
        index: index + 1,
        limit,
    )?

    if callback_contract_finding_is_modeled(finding)? {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn callback_contract_count_in_change(change: JsonValue) -> Result<Int, JsonError> {
    let risk_text = Json.field_string(value: change, name: "risk")?

    if risk_text != "elevated" {
        return Ok(0)
    }

    let findings = Json.field(value: change, name: "findings")?
    let limit = Json.array_len(value: findings)?

    return callback_contract_count_from_findings(
        findings,
        index: 0,
        limit,
    )
}

fn callback_contract_count_from_changes(
    changes: JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: changes, index)?
    let current = callback_contract_count_in_change(change)?
    let rest = callback_contract_count_from_changes(
        changes,
        index: index + 1,
        limit,
    )?

    return Ok(current + rest)
}

fn review_risk_from_summary(summary: JsonValue) -> Result<Int, JsonError> {
    let errors = Json.field_int(value: summary, name: "errors")?
    let native = Json.field_int(value: summary, name: "native_apis")?
    let unknown = Json.field_int(value: summary, name: "unknown_apis")?
    let public_apis = Json.field_int(value: summary, name: "public_apis")?

    if unknown > 0 {
        return Ok(DiffRisk.unknown())
    }

    if errors > 0 {
        return Ok(DiffRisk.high())
    }

    if native > 0 || public_apis > 0 {
        return Ok(DiffRisk.elevated())
    }

    return Ok(DiffRisk.low())
}

fn parse_package_diff_facts(value: JsonValue) -> Result<fresh PackageDiffFacts, JsonError> {
    let risk = Json.field_string(value, name: "risk")?
    let old_review = Json.field(value, name: "old_review")?
    let new_review = Json.field(value, name: "new_review")?
    let manifest_changes = Json.field(value, name: "manifest_changes")?
    let interface_changes = Json.field(value, name: "interface_changes")?
    let reasons = Json.field(value, name: "reasons")?
    let manifest_count = Json.array_len(value: manifest_changes)?
    let interface_count = Json.array_len(value: interface_changes)?

    return PackageDiffFacts(
        declared_risk: diff_risk_from_string(value: risk),
        old_review_risk: review_risk_from_summary(summary: old_review)?,
        new_review_risk: review_risk_from_summary(summary: new_review)?,
        manifest_risk: max_manifest_risk(changes: manifest_changes)?,
        interface_risk: max_interface_risk(changes: interface_changes)?,
        manifest_changes: manifest_count,
        interface_changes: interface_count,
        high_manifest_changes: high_manifest_count_from(
            changes: manifest_changes,
            index: 0,
            limit: manifest_count,
        )?,
        high_interface_changes: high_interface_count_from(
            changes: interface_changes,
            index: 0,
            limit: interface_count,
        )?,
        callback_contract_changes: callback_contract_count_from_changes(
            changes: interface_changes,
            index: 0,
            limit: interface_count,
        )?,
        unmodeled_reasons: count_unmodeled_diff_reasons(reasons)?,
    )
}

fn classify_package_diff(facts: PackageDiffFacts) -> fresh PackageDiffDecision {
    let review_risk = max_risk(left: facts.old_review_risk, right: facts.new_review_risk)
    let change_risk = max_risk(left: facts.manifest_risk, right: facts.interface_risk)
    let risk = max_risk(left: review_risk, right: change_risk)
    let mismatch = diff_mismatch_count(risk, expected: facts.declared_risk)

    return PackageDiffDecision(
        risk: risk,
        mismatches: mismatch,
    )
}

fn diff_mismatch_count(risk: Int, expected: Int) -> Int {
    if risk != expected {
        return 1
    }

    return 0
}

fn selfhost_package_diff_facts() -> Result<fresh PackageDiffFacts, JsonError> {
    let path = Path.from_string(value: "tests/fixtures/pass/selfhost-package-diff.json")
    let json = Json.parse_file(path)?

    return parse_package_diff_facts(value: json)
}

fn diff_summary_line(
    facts: PackageDiffFacts,
    decision: PackageDiffDecision,
) -> fresh String {
    let manifest = String.from_int(value: facts.manifest_changes)
    let interfaces = String.from_int(value: facts.interface_changes)
    let high_manifests = String.from_int(value: facts.high_manifest_changes)
    let high_interfaces = String.from_int(value: facts.high_interface_changes)
    let mismatches = String.from_int(value: decision.mismatches)
    let unmodeled = String.from_int(value: facts.unmodeled_reasons)
    let callback = String.from_int(value: facts.callback_contract_changes)
    let first = String.concat(left: "selfhost package diff manifest=", right: manifest)
    let second = String.concat(left: first, right: " interface=")
    let third = String.concat(left: second, right: interfaces)
    let fourth = String.concat(left: third, right: " high_manifest=")
    let fifth = String.concat(left: fourth, right: high_manifests)
    let sixth = String.concat(left: fifth, right: " high_interface=")
    let seventh = String.concat(left: sixth, right: high_interfaces)
    let eighth = String.concat(left: seventh, right: " mismatches=")
    let ninth = String.concat(left: eighth, right: mismatches)
    let tenth = String.concat(left: ninth, right: " unmodeled_reasons=")
    let eleventh = String.concat(left: tenth, right: unmodeled)
    let twelfth = String.concat(left: eleventh, right: " callback_contract=")

    return String.concat(left: twelfth, right: callback)
}

pub fn main() -> Result<Unit, JsonError> {
    let facts = selfhost_package_diff_facts()?
    let decision = classify_package_diff(facts)
    let summary = diff_summary_line(facts, decision)

    Output.write(message: summary)

    Assert.equal_int(left: decision.risk, right: facts.declared_risk)
    Assert.equal_int(left: decision.mismatches, right: 0)
    Assert.equal_int(left: facts.unmodeled_reasons, right: 0)
    Assert.equal_int(left: facts.interface_changes, right: 3)
    Assert.equal_int(left: facts.high_manifest_changes, right: 5)
    Assert.equal_int(left: facts.high_interface_changes, right: 2)
    Assert.equal_int(left: facts.callback_contract_changes, right: 1)

    return Ok(Unit)
}
