
struct PackageManifestFacts {
    package_name: String
    version: String
    edition: String
    interface_paths: Int
    dependency_version: String
    feature_members: Int
}

fn selfhost_manifest_path() -> fresh Path {
    let input = Args.get_or_default(
        index: 0,
        default: "tests/fixtures/pass/selfhost-package-manifest.toml",
    )

    return Path.from_string(value: input)
}

fn selfhost_manifest_facts() -> Result<fresh PackageManifestFacts, JsonError> {
    let manifest = Toml.parse_file(path: selfhost_manifest_path())?
    let package = Json.field(value: manifest, name: "package")?
    let interfaces = Json.field(value: manifest, name: "interfaces")?
    let interface_paths = Json.field(value: interfaces, name: "paths")?
    let dependencies = Json.field(value: manifest, name: "dependencies")?
    let features = Json.field(value: manifest, name: "features")?
    let native_tls = Json.field(value: features, name: "native-tls")?

    return PackageManifestFacts(
        package_name: Json.field_string(value: package, name: "name")?,
        version: Json.field_string(value: package, name: "version")?,
        edition: Json.field_string(value: package, name: "edition")?,
        interface_paths: Json.array_len(value: interface_paths)?,
        dependency_version: Json.field_string(value: dependencies, name: "rss-core")?,
        feature_members: Json.array_len(value: native_tls)?,
    )
}

fn selfhost_manifest_summary_line(facts: PackageManifestFacts) -> fresh String {
    let first = String.concat(left: "selfhost package manifest name=", right: facts.package_name)
    let second = String.concat(left: first, right: " version=")
    let third = String.concat(left: second, right: facts.version)
    let fourth = String.concat(left: third, right: " edition=")
    let fifth = String.concat(left: fourth, right: facts.edition)
    let sixth = String.concat(left: fifth, right: " interface_paths=")
    let paths = String.from_int(value: facts.interface_paths)
    let seventh = String.concat(left: sixth, right: paths)
    let eighth = String.concat(left: seventh, right: " dep=")
    let ninth = String.concat(left: eighth, right: facts.dependency_version)
    let tenth = String.concat(left: ninth, right: " feature_members=")
    let members = String.from_int(value: facts.feature_members)

    return String.concat(left: tenth, right: members)
}

pub fn main() -> Result<Unit, JsonError> {
    let facts = selfhost_manifest_facts()?
    let summary = selfhost_manifest_summary_line(facts)

    Output.write(message: summary)

    Assert.equal(left: facts.package_name, right: "rss-selfhost-manifest")
    Assert.equal(left: facts.version, right: "0.5.0")
    Assert.equal(left: facts.edition, right: "2024")
    Assert.equal_int(left: facts.interface_paths, right: 1)
    Assert.equal(left: facts.dependency_version, right: "0.5")
    Assert.equal_int(left: facts.feature_members, right: 1)

    return Ok(Unit)
}
