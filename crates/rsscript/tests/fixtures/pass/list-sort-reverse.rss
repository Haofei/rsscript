
fn sort_descending(numbers: mut List<Int>) -> Unit {
    List.sort_with<Int>(
        list: mut numbers,
        compare: |a, b| { return b - a },
    )
}

fn sort_ascending(numbers: mut List<Int>) -> Unit {
    List.sort<Int>(list: mut numbers)
}

fn make_reversed(items: List<Int>) -> fresh List<Int> {
    local result = List.reverse<Int>(list: items)
    return result
}

fn check_empty(items: List<Int>) -> Bool {
    return List.is_empty<Int>(list: items)
}

fn has_positive(items: List<Int>) -> Bool {
    return List.contains<Int>(
        list: items,
        predicate: |x| x > 0,
    )
}
