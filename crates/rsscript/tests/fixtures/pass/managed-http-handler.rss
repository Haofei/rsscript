
class AppState {
    cache: Cache
}

struct Response {
    status: Int
    body: String
}

fn handle_request(state: mut AppState, request: Request) -> Result<fresh Response, HttpError> {
    let path = Request.path(request)
    let body = Cache.lookup(cache: state.cache, key: path)

    return Response(status: 200, body: read body)
}
