class User {
    id: String
}

struct Session {
    owner: weak User
    trace_id: String
}

struct UploadPlan {
    input: Path
    output: Path
    trace_id: String
}

struct WorkItem {
    plan: UploadPlan
    session: Session
}

struct AuditRecord {
    trace_id: String
    status: String
}

struct RenderResult {
    response: OutboundMessage
    status: String
}

class RetainedImageStore {
}

fn RetainedImageStore.new(capacity: Int) -> RetainedImageStore

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: Picture) -> Unit
    retains(image)

fn User.lookup(id: String) -> User

fn User.touch(user: User) -> Unit

fn audit_step(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn HttpError.from_config(error: SettingsError) -> HttpError
fn HttpError.from_json(error: JsonError) -> HttpError
fn HttpError.from_image(error: PictureError) -> HttpError
fn HttpError.from_csv(error: CsvError) -> HttpError

fn parse_plan(request: InboundMessage) -> Result<fresh UploadPlan, JsonError> {
    let body = InboundMessage.path(request)
    let json = Json.parse(text: body)?
    local input_text = Json.field_string(value: json, name: "input")?
    local output_text = Json.field_string(value: json, name: "output")?
    local trace_id = Json.field_string(value: json, name: "trace")?
    local input = Path.from_string(value: input_text)
    local output = Path.from_string(value: output_text)

    return UploadPlan(
        input: take input,
        output: take output,
        trace_id: take trace_id,
    )
}

fn build_session(owner: User, trace_id: String) -> fresh Session {
    return Session(
        owner: Weak.from(value: owner),
        trace_id: read trace_id,
    )
}

fn inspect_session(session: Session) -> Unit {
    let maybe_owner = Weak.upgrade(value: session.owner)

    match maybe_owner {
        Some(owner) => {
            User.touch(user: owner)
        }
        None => {
            Log.write(message: session.trace_id)
        }
    }

    audit_step(callback: || {
        Log.write(message: session.trace_id)
    })

    return Unit
}

fn build_work_item(request: InboundMessage, owner_id: String) -> Result<fresh WorkItem, JsonError> {
    local plan = parse_plan(request)?
    let owner = User.lookup(id: owner_id)
    local session = build_session(owner, trace_id: plan.trace_id)

    return WorkItem(plan: take plan, session: take session)
}

fn load_request_row(path: Path) -> Result<fresh Row, CsvError> {
    local buffer = RowBuffer.new(size: 8192)

    with Csv.open_read(path)? as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
    }

    return Csv.parse_row(buffer)
}

fn decode_row_status(path: Path) -> Result<String, CsvError> {
    let row = load_request_row(path)?
    let status = Row.field_string(row, index: 1)?

    return Ok(status)
}

fn process_image(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, PictureError> {
    local image = Picture.load(path: plan.input)?

    audit_step(callback: || {
        Picture.inspect(image)
    })

    Picture.resize(image: mut image, width: 1024, height: 768)
    Picture.normalize(image: mut image)
    Picture.sharpen(image: mut image)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: shared)
    Picture.save(image: shared, path: plan.output)?

    return Ok(Unit)
}

fn build_image_store() -> RetainedImageStore {
    return RetainedImageStore.new(capacity: 64)
}

fn refresh_config(path: Path, store: mut SettingsStore) -> Result<Unit, SettingsError> {
    let config = Settings.load(path)?
    SettingsStore.replace(store: mut store, value: config)

    return Ok(Unit)
}

fn load_rules_config(path: Path) -> Result<fresh Settings, SettingsError> {
    let rules = PolicyLoader.load_rules(path)?
    let name = String.concat(left: "rules:", right: "active")

    return Settings.new(name, rules)
}

fn replace_global_rules(path: Path, global: mut SharedSettings) -> Result<Unit, SettingsError> {
    let config = load_rules_config(path)?
    SharedSettings.replace(global: mut global, value: config)

    return Ok(Unit)
}

fn initialize_global_rules(path: Path) -> Result<fresh SharedSettings, SettingsError> {
    let config = load_rules_config(path)?

    return SharedSettings.new(value: config)
}

fn persist_trace(cache: mut MemoStore, trace_id: String, status: String) -> Unit {
    MemoStore.insert(cache: mut cache, key: trace_id, value: status)
    return Unit
}

fn lookup_trace(cache: MemoStore, trace_id: String) -> String {
    let status = MemoStore.lookup(cache, key: trace_id)

    return status
}

fn build_audit_record(trace_id: String, status: String) -> fresh AuditRecord {
    return AuditRecord(trace_id: read trace_id, status: read status)
}

fn save_audit_record(cache: mut MemoStore, record: AuditRecord) -> Unit {
    MemoStore.insert(cache: mut cache, key: record.trace_id, value: record.status)
    return Unit
}

fn write_response_file(path: Path, text: String) -> Result<Unit, FileError> {
    let bytes = Bytes.from_string(value: text)
    with File.open_write(path)? as file {
        File.write(file: mut file, data: bytes)?
    }

    return Ok(Unit)
}

fn refresh_config_http(path: Path, store: mut SettingsStore) -> Result<Unit, HttpError> {
    match refresh_config(path, store: mut store) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error))
        }
    }
}

fn replace_global_rules_http(path: Path, global: mut SharedSettings) -> Result<Unit, HttpError> {
    match replace_global_rules(path, global: mut global) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error))
        }
    }
}

fn build_work_item_http(
    request: InboundMessage,
    owner_id: String,
) -> Result<WorkItem, HttpError> {
    match build_work_item(request, owner_id) {
        Ok(item) => {
            return Ok(item)
        }
        Err(error) => {
            return Err(HttpError.from_json(error))
        }
    }
}

fn process_image_http(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, HttpError> {
    match process_image(plan, cache: mut cache) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_image(error))
        }
    }
}

fn record_audit_http(trace_id: String) -> Result<Unit, HttpError> {
    Log.write(message: trace_id)
    return Ok(Unit)
}

fn decode_row_status_http(path: Path) -> Result<String, HttpError> {
    match decode_row_status(path) {
        Ok(status) => {
            return Ok(status)
        }
        Err(error) => {
            return Err(HttpError.from_csv(error))
        }
    }
}

fn record_status_http(status: String) -> Result<Unit, HttpError> {
    Log.write(message: status)
    return Ok(Unit)
}

fn consume_local_buffer() -> Unit {
    local buffer = Buffer.new(size: 4096)
    Buffer.clear(buffer: mut buffer)
    Buffer.consume(buffer: take buffer)

    return Unit
}

fn build_environment() -> LexicalScope {
    let root = LexicalScope.root()
    let child = LexicalScope.child(parent: root)
    let function = ClosureRecord.new(closure: child)
    LexicalScope.bind_function(env: mut child, function)

    return child
}

fn inspect_environment(env: LexicalScope, function: ClosureRecord) -> Unit {
    let has_parent = LexicalScope.has_parent(env)
    let has_function = LexicalScope.has_function(env)
    let has_closure = ClosureRecord.has_closure(function)

    if has_parent {
        Log.write(message: "parent")
    } else {
        Log.write(message: "root")
    }

    if has_function {
        Log.write(message: "function")
    } else {
        Log.write(message: "empty")
    }

    if has_closure {
        Log.write(message: "closure")
    } else {
        Log.write(message: "no closure")
    }

    return Unit
}

fn count_request(counter: mut Tally) -> Int {
    Tally.add(counter: mut counter, amount: 1)
    let value = Tally.value(counter)

    return value
}

fn verify_status(expected: String, actual: String) -> Unit {
    Assert.equal(left: expected, right: actual)
    return Unit
}

fn render_response(status: String) -> Result<fresh RenderResult, HttpError> {
    local response = OutboundMessage.ok(body: status)?

    return RenderResult(response: take response, status: read status)
}

fn complete_request(
    request: InboundMessage,
    owner_id: String,
    image_store: mut RetainedImageStore,
    config_store: mut SettingsStore,
    rules_global: mut SharedSettings,
    status_cache: mut MemoStore,
    counter: mut Tally,
    csv_path: Path,
) -> Result<fresh OutboundMessage, HttpError> {
    let config_path = Path.from_string(value: "config.json")
    let rules_path = Path.from_string(value: "rules.json")
    refresh_config_http(path: config_path, store: mut config_store)?
    replace_global_rules_http(path: rules_path, global: mut rules_global)?

    let item = build_work_item_http(request, owner_id)?
    inspect_session(session: item.session)

    process_image_http(plan: item.plan, cache: mut image_store)?
    record_audit_http(trace_id: item.plan.trace_id)?

    let csv_status = decode_row_status_http(path: csv_path)?
    record_status_http(status: csv_status)?

    let status = SettingsStore.name(store: config_store)
    let record = build_audit_record(trace_id: item.plan.trace_id, status)
    save_audit_record(cache: mut status_cache, record)
    persist_trace(cache: mut status_cache, trace_id: item.plan.trace_id, status: csv_status)

    let cached = lookup_trace(cache: status_cache, trace_id: item.plan.trace_id)
    verify_status(expected: status, actual: cached)

    count_request(counter: mut counter)
    consume_local_buffer()

    Log.write(message: status)

    return OutboundMessage.ok(body: status)?
}

fn main_handler(
    request: InboundMessage,
    owner_id: String,
    config_store: mut SettingsStore,
    rules_global: mut SharedSettings,
    status_cache: mut MemoStore,
    counter: mut Tally,
    csv_path: Path,
) -> Result<fresh OutboundMessage, HttpError> {
    let image_store = build_image_store()
    let env = build_environment()
    let child = LexicalScope.child(parent: env)
    let function = ClosureRecord.new(closure: child)
    inspect_environment(env: child, function)

    return complete_request(
        request,
        owner_id,
        image_store: mut image_store,
        config_store: mut config_store,
        rules_global: mut rules_global,
        status_cache: mut status_cache,
        counter: mut counter,
        csv_path,
    )?
}
