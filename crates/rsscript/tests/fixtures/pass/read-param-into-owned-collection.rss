// Regression: a `read`-PARAM managed value pushed into an owned collection (or passed on as
// a `read` arg) must not be double-borrowed. Before the fix this emitted `&&T` -> E0308.
features: local

struct Node derives(Clone, Eq, Hash) {
    tag: Int
    src: List<Node>
}

fn leaf(tag: Int) -> fresh Node { return Node(tag: tag, src: List.new<Node>()) }

fn bin(a: Node, b: Node) -> fresh Node {
    local s = List.new<Node>()
    List.push(list: mut s, value: a)
    List.push(list: mut s, value: b)
    return Node(tag: 0, src: take s)
}

fn main() -> Unit {
    let p = bin(a: leaf(tag: 1), b: leaf(tag: 2))
    Log.write(message: Int.to_string(value: List.len(list: p.src)))
    return Unit
}
