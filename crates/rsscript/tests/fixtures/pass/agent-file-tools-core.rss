fn write_workspace_file(root: Path, relative: String, text: String) -> Result<Unit, String> {
    match Workspace.resolve(root, relative) {
        Ok(path) => {
            match path.parent() {
                Some(parent) => {
                    match Directory.create_dir_all(path: parent) {
                        Ok(unit) => {
                        }
                        Err(error) => {
                            return Err(error.message())
                        }
                    }
                }
                None => {
                }
            }
            match File.write_atomic(path, text) {
                Ok(unit) => {
                    return Ok(Unit)
                }
                Err(error) => {
                    return Err(error.message())
                }
            }
        }
        Err(error) => {
            return Err(error)
        }
    }
}

fn preview_and_apply(original: String, changed: String) -> Result<fresh String, String> {
    let patch = Diff.unified(old: original, new: changed)
    return Patch.apply_text(original, patch)
}
