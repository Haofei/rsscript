features: local

fn count_keys(table: Map<String, Int>) -> Int {
    let keys = Map.keys<String, Int>(map: table)
    let count = List.len<String>(list: keys)
    return count
}

fn sum_values(table: Map<String, Int>) -> Int {
    let values = Map.values<String, Int>(map: table)
    let total = List.fold<Int, Int>(
        list: values,
        initial: 0,
        folder: |acc, val| acc + val,
    )
    return total
}
