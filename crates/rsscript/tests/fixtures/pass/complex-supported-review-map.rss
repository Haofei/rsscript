features: local

struct UploadPlan {
    input: Path
    output: Path
}

class RetainedImageStore {
}

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: Image) -> Unit
    effects(retains(image))

fn audit_step(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn HttpError.from_config(error: ConfigError) -> HttpError
fn HttpError.from_json(error: JsonError) -> HttpError
fn HttpError.from_image(error: ImageError) -> HttpError
fn HttpError.from_db(error: DbError) -> HttpError

fn decode_upload(request: Request) -> Result<fresh UploadPlan, JsonError> {
    let body = Request.path(request)
    let json = Json.parse(text: body)?
    local input_text = Json.field_string(value: json, name: "input")?
    local output_text = Json.field_string(value: json, name: "output")?
    local input = Path.from_string(value: input_text)
    local output = Path.from_string(value: output_text)

    return UploadPlan(input: take input, output: take output)
}

fn transform_image(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, ImageError> {
    local image = Image.load(path: plan.input)?

    audit_step(callback: || {
        Image.inspect(image)
    })

    Image.resize(image: mut image, width: 640, height: 480)
    Image.normalize(image: mut image)
    Image.sharpen(image: mut image)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: shared)
    Image.save(image: shared, path: plan.output)?

    return Ok(Unit)
}

fn reload_settings(path: Path, store: mut ConfigStore) -> Result<Unit, ConfigError> {
    let config = Config.load(path)?
    ConfigStore.replace(store: mut store, value: config)

    return Ok(Unit)
}

fn run_query(url: Url, sql: String) -> Result<Unit, DbError> {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.open(url),
        max_size: 4,
    )

    with ResourcePool.borrow(pool: mut pool) as conn {
        DbConnection.query(conn: mut conn, sql)?
    }

    return Ok(Unit)
}

fn reload_settings_http(path: Path, store: mut ConfigStore) -> Result<Unit, HttpError> {
    match reload_settings(path, store: mut store) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error))
        }
    }
}

fn decode_upload_http(request: Request) -> Result<UploadPlan, HttpError> {
    match decode_upload(request) {
        Ok(plan) => {
            return Ok(plan)
        }
        Err(error) => {
            return Err(HttpError.from_json(error))
        }
    }
}

fn transform_image_http(plan: UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, HttpError> {
    match transform_image(plan, cache: mut cache) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_image(error))
        }
    }
}

fn run_query_http(url: Url, sql: String) -> Result<Unit, HttpError> {
    match run_query(url, sql) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_db(error))
        }
    }
}

fn handle_upload(
    request: Request,
    cache: mut RetainedImageStore,
    config_store: mut ConfigStore,
    counter: mut Counter,
    db_url: Url,
    sql: String,
) -> Result<fresh Response, HttpError> {
    let config_path = Path.from_string(value: "config.json")
    reload_settings_http(path: config_path, store: mut config_store)?

    let plan = decode_upload_http(request)?
    transform_image_http(plan, cache: mut cache)?
    run_query_http(url: db_url, sql)?

    Counter.add(counter: mut counter, amount: 1)

    let body = ConfigStore.name(store: config_store)
    return Response.ok(body)?
}
