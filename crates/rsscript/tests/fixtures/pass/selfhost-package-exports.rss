features: local

struct PackageExportSummary {
    public_types: Int
    public_functions: Int
    public_apis: Int
    mutating_apis: Int
    retaining_apis: Int
    resource_apis: Int
    fresh_returning_apis: Int
    unknown_apis: Int
    unmodeled_reasons: Int
}

fn empty_export_summary() -> fresh PackageExportSummary {
    return PackageExportSummary(
        public_types: 0,
        public_functions: 0,
        public_apis: 0,
        mutating_apis: 0,
        retaining_apis: 0,
        resource_apis: 0,
        fresh_returning_apis: 0,
        unknown_apis: 0,
        unmodeled_reasons: 0,
    )
}

fn export_reason_is_modeled(reason: read String) -> Bool {
    if reason == "public struct type" || reason == "public resource type" {
        return true
    }

    if reason == "resource type" || reason == "public function" {
        return true
    }

    if reason == "returns fresh value" || reason == "unknown review-map region" {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "mut parameter") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "take parameter") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "resource parameter") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "resource return type") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "retains(") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "native boundary") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "unsafe boundary") {
        return true
    }

    if String.starts_with(value: read reason, prefix: read "guarantee `") {
        return true
    }

    return false
}

fn count_unmodeled_export_reasons(reasons: read JsonValue) -> Result<Int, JsonError> {
    return Json.array_count_where(
        value: read reasons,
        predicate: |item| {
            let reason = Json.as_string(value: read item)?
            if export_reason_is_modeled(reason: read reason) {
                return Ok(false)
            }

            return Ok(true)
        },
    )
}

fn export_has_resource_boundary(
    kind: read String,
    reasons: read JsonValue,
) -> Result<Bool, JsonError> {
    if kind != "function" {
        return Ok(false)
    }

    if Json.array_contains_prefix(value: read reasons, prefix: read "resource parameter")? {
        return Ok(true)
    }

    return Json.array_contains_string(value: read reasons, item: read "resource return type")
}

fn add_export_summary(
    summary: read PackageExportSummary,
    export: read JsonValue,
) -> Result<fresh PackageExportSummary, JsonError> {
    let kind = Json.field_string(value: read export, name: read "kind")?
    let classification = Json.field_string(value: read export, name: read "classification")?
    let reasons = Json.field(value: read export, name: read "reasons")?
    let is_function = kind == "function"
    let is_type = kind == "type"
    let mutating = is_function && Json.array_contains_prefix(value: read reasons, prefix: read "mut parameter")?
    let retaining = is_function && Json.array_contains_prefix(value: read reasons, prefix: read "retains(")?
    let resource = export_has_resource_boundary(kind: read kind, reasons: read reasons)?
    let fresh = is_function && Json.array_contains_string(value: read reasons, item: read "returns fresh value")?
    let unknown = is_function && classification == "unknown"
    let unmodeled = count_unmodeled_export_reasons(reasons: read reasons)?

    return PackageExportSummary(
        public_types: add_bool(value: summary.public_types, condition: is_type),
        public_functions: add_bool(value: summary.public_functions, condition: is_function),
        public_apis: summary.public_apis + 1,
        mutating_apis: add_bool(value: summary.mutating_apis, condition: mutating),
        retaining_apis: add_bool(value: summary.retaining_apis, condition: retaining),
        resource_apis: add_bool(value: summary.resource_apis, condition: resource),
        fresh_returning_apis: add_bool(value: summary.fresh_returning_apis, condition: fresh),
        unknown_apis: add_bool(value: summary.unknown_apis, condition: unknown),
        unmodeled_reasons: summary.unmodeled_reasons + unmodeled,
    )
}

fn add_bool(value: Int, condition: Bool) -> Int {
    if condition {
        return value + 1
    }

    return value
}

fn fold_export_summary(
    summary: read PackageExportSummary,
    export: read JsonValue,
) -> Result<fresh PackageExportSummary, JsonError> {
    return add_export_summary(summary: read summary, export: read export)
}

fn selfhost_export_summary() -> Result<fresh PackageExportSummary, JsonError> {
    let path = Path.from_string(value: read "tests/fixtures/pass/selfhost-package-exports.json")
    let json = Json.parse_file(path: read path)?
    let exports = Json.field(value: read json, name: read "exports")?

    return Json.array_fold<PackageExportSummary>(
        value: read exports,
        initial: read empty_export_summary(),
        folder: |summary, export| {
            return fold_export_summary(summary: read summary, export: read export)
        },
    )
}

fn expected_export_summary() -> Result<fresh PackageExportSummary, JsonError> {
    let path = Path.from_string(value: read "tests/fixtures/pass/selfhost-package-exports.json")
    let json = Json.parse_file(path: read path)?
    let summary = Json.field(value: read json, name: read "summary")?

    return PackageExportSummary(
        public_types: Json.field_int(value: read summary, name: read "public_types")?,
        public_functions: Json.field_int(value: read summary, name: read "public_functions")?,
        public_apis: Json.field_int(value: read summary, name: read "public_apis")?,
        mutating_apis: Json.field_int(value: read summary, name: read "mutating_apis")?,
        retaining_apis: Json.field_int(value: read summary, name: read "retaining_apis")?,
        resource_apis: Json.field_int(value: read summary, name: read "resource_apis")?,
        fresh_returning_apis: Json.field_int(value: read summary, name: read "fresh_returning_apis")?,
        unknown_apis: Json.field_int(value: read summary, name: read "unknown_apis")?,
        unmodeled_reasons: 0,
    )
}

fn export_mismatch_count(
    actual: read PackageExportSummary,
    expected: read PackageExportSummary,
) -> Int {
    if actual.public_types != expected.public_types {
        return 1
    }

    if actual.public_functions != expected.public_functions {
        return 1
    }

    if actual.public_apis != expected.public_apis {
        return 1
    }

    if actual.mutating_apis != expected.mutating_apis {
        return 1
    }

    if actual.retaining_apis != expected.retaining_apis {
        return 1
    }

    if actual.resource_apis != expected.resource_apis {
        return 1
    }

    if actual.fresh_returning_apis != expected.fresh_returning_apis {
        return 1
    }

    if actual.unknown_apis != expected.unknown_apis {
        return 1
    }

    return 0
}

fn export_summary_line(
    actual: read PackageExportSummary,
    mismatches: Int,
) -> fresh String {
    let types = String.from_int(value: actual.public_types)
    let functions = String.from_int(value: actual.public_functions)
    let apis = String.from_int(value: actual.public_apis)
    let mutating = String.from_int(value: actual.mutating_apis)
    let retaining = String.from_int(value: actual.retaining_apis)
    let resource = String.from_int(value: actual.resource_apis)
    let fresh = String.from_int(value: actual.fresh_returning_apis)
    let unknown = String.from_int(value: actual.unknown_apis)
    let mismatch_count = String.from_int(value: mismatches)
    let unmodeled = String.from_int(value: actual.unmodeled_reasons)
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: read "selfhost package exports types=")
    StringBuilder.push(builder: mut builder, value: read types)
    StringBuilder.push(builder: mut builder, value: read " functions=")
    StringBuilder.push(builder: mut builder, value: read functions)
    StringBuilder.push(builder: mut builder, value: read " apis=")
    StringBuilder.push(builder: mut builder, value: read apis)
    StringBuilder.push(builder: mut builder, value: read " mutating=")
    StringBuilder.push(builder: mut builder, value: read mutating)
    StringBuilder.push(builder: mut builder, value: read " retaining=")
    StringBuilder.push(builder: mut builder, value: read retaining)
    StringBuilder.push(builder: mut builder, value: read " resource=")
    StringBuilder.push(builder: mut builder, value: read resource)
    StringBuilder.push(builder: mut builder, value: read " fresh=")
    StringBuilder.push(builder: mut builder, value: read fresh)
    StringBuilder.push(builder: mut builder, value: read " unknown=")
    StringBuilder.push(builder: mut builder, value: read unknown)
    StringBuilder.push(builder: mut builder, value: read " mismatches=")
    StringBuilder.push(builder: mut builder, value: read mismatch_count)
    StringBuilder.push(builder: mut builder, value: read " unmodeled_reasons=")
    StringBuilder.push(builder: mut builder, value: read unmodeled)

    return StringBuilder.finish(builder: take builder)
}

pub fn main() -> Result<Unit, JsonError> {
    let actual = selfhost_export_summary()?
    let expected = expected_export_summary()?
    let mismatches = export_mismatch_count(actual: read actual, expected: read expected)
    let summary = export_summary_line(actual: read actual, mismatches: mismatches)

    Log.write(message: read summary)

    Assert.equal_int(left: mismatches, right: 0)
    Assert.equal_int(left: actual.unmodeled_reasons, right: 0)

    return Ok(Unit)
}
