features: local

struct PackageExportSummary {
    public_types: Int
    public_functions: Int
    public_apis: Int
    mutating_apis: Int
    retaining_apis: Int
    resource_apis: Int
    fresh_returning_apis: Int
    unknown_apis: Int
    unmodeled_reasons: Int
}

fn empty_export_summary() -> fresh PackageExportSummary {
    return PackageExportSummary(
        public_types: 0,
        public_functions: 0,
        public_apis: 0,
        mutating_apis: 0,
        retaining_apis: 0,
        resource_apis: 0,
        fresh_returning_apis: 0,
        unknown_apis: 0,
        unmodeled_reasons: 0,
    )
}

fn export_reason_is_modeled(reason: String) -> Bool {
    if reason == "public struct type" || reason == "public resource type" {
        return true
    }

    if reason == "resource type" || reason == "public function" {
        return true
    }

    if reason == "returns fresh value" || reason == "unknown review-map region" {
        return true
    }

    if String.starts_with(value: reason, prefix: "mut parameter") {
        return true
    }

    if String.starts_with(value: reason, prefix: "take parameter") {
        return true
    }

    if String.starts_with(value: reason, prefix: "resource parameter") {
        return true
    }

    if String.starts_with(value: reason, prefix: "resource return type") {
        return true
    }

    if String.starts_with(value: reason, prefix: "retains(") {
        return true
    }

    if String.starts_with(value: reason, prefix: "native boundary") {
        return true
    }

    if String.starts_with(value: reason, prefix: "unsafe boundary") {
        return true
    }

    if String.starts_with(value: reason, prefix: "guarantee `") {
        return true
    }

    return false
}

fn count_unmodeled_export_reasons(reasons: JsonValue) -> Result<Int, JsonError> {
    return Json.array_count_where(
        value: reasons,
        predicate: |item| {
            let reason = Json.as_string(value: item)?
            if export_reason_is_modeled(reason) {
                return Ok(false)
            }

            return Ok(true)
        },
    )
}

fn export_has_resource_boundary(
    kind: String,
    reasons: JsonValue,
) -> Result<Bool, JsonError> {
    if kind != "function" {
        return Ok(false)
    }

    if Json.array_contains_prefix(value: reasons, prefix: "resource parameter")? {
        return Ok(true)
    }

    return Json.array_contains_string(value: reasons, item: "resource return type")
}

fn add_export_summary(
    summary: PackageExportSummary,
    export: JsonValue,
) -> Result<fresh PackageExportSummary, JsonError> {
    let kind = Json.field_string(value: export, name: "kind")?
    let classification = Json.field_string(value: export, name: "classification")?
    let reasons = Json.field(value: export, name: "reasons")?
    let is_function = kind == "function"
    let is_type = kind == "type"
    let mutating = is_function && Json.array_contains_prefix(value: reasons, prefix: "mut parameter")?
    let retaining = is_function && Json.array_contains_prefix(value: reasons, prefix: "retains(")?
    let resource = export_has_resource_boundary(kind, reasons)?
    let fresh = is_function && Json.array_contains_string(value: reasons, item: "returns fresh value")?
    let unknown = is_function && classification == "unknown"
    let unmodeled = count_unmodeled_export_reasons(reasons)?

    return PackageExportSummary(
        public_types: add_bool(value: summary.public_types, condition: is_type),
        public_functions: add_bool(value: summary.public_functions, condition: is_function),
        public_apis: summary.public_apis + 1,
        mutating_apis: add_bool(value: summary.mutating_apis, condition: mutating),
        retaining_apis: add_bool(value: summary.retaining_apis, condition: retaining),
        resource_apis: add_bool(value: summary.resource_apis, condition: resource),
        fresh_returning_apis: add_bool(value: summary.fresh_returning_apis, condition: fresh),
        unknown_apis: add_bool(value: summary.unknown_apis, condition: unknown),
        unmodeled_reasons: summary.unmodeled_reasons + unmodeled,
    )
}

fn add_bool(value: Int, condition: Bool) -> Int {
    if condition {
        return value + 1
    }

    return value
}

fn fold_export_summary(
    summary: PackageExportSummary,
    export: JsonValue,
) -> Result<fresh PackageExportSummary, JsonError> {
    return add_export_summary(summary, export)
}

fn selfhost_export_summary() -> Result<fresh PackageExportSummary, JsonError> {
    let path = Path.from_string(value: "tests/fixtures/pass/selfhost-package-exports.json")
    let json = Json.parse_file(path)?
    let exports = Json.field(value: json, name: "exports")?

    return Json.array_fold<PackageExportSummary>(
        value: exports,
        initial: empty_export_summary(),
        folder: |summary, export| {
            return fold_export_summary(summary, export)
        },
    )
}

fn expected_export_summary() -> Result<fresh PackageExportSummary, JsonError> {
    let path = Path.from_string(value: "tests/fixtures/pass/selfhost-package-exports.json")
    let json = Json.parse_file(path)?
    let summary = Json.field(value: json, name: "summary")?

    return PackageExportSummary(
        public_types: Json.field_int(value: summary, name: "public_types")?,
        public_functions: Json.field_int(value: summary, name: "public_functions")?,
        public_apis: Json.field_int(value: summary, name: "public_apis")?,
        mutating_apis: Json.field_int(value: summary, name: "mutating_apis")?,
        retaining_apis: Json.field_int(value: summary, name: "retaining_apis")?,
        resource_apis: Json.field_int(value: summary, name: "resource_apis")?,
        fresh_returning_apis: Json.field_int(value: summary, name: "fresh_returning_apis")?,
        unknown_apis: Json.field_int(value: summary, name: "unknown_apis")?,
        unmodeled_reasons: 0,
    )
}

fn export_mismatch_count(
    actual: PackageExportSummary,
    expected: PackageExportSummary,
) -> Int {
    if actual.public_types != expected.public_types {
        return 1
    }

    if actual.public_functions != expected.public_functions {
        return 1
    }

    if actual.public_apis != expected.public_apis {
        return 1
    }

    if actual.mutating_apis != expected.mutating_apis {
        return 1
    }

    if actual.retaining_apis != expected.retaining_apis {
        return 1
    }

    if actual.resource_apis != expected.resource_apis {
        return 1
    }

    if actual.fresh_returning_apis != expected.fresh_returning_apis {
        return 1
    }

    if actual.unknown_apis != expected.unknown_apis {
        return 1
    }

    return 0
}

fn export_summary_line(
    actual: PackageExportSummary,
    mismatches: Int,
) -> fresh String {
    let types = String.from_int(value: actual.public_types)
    let functions = String.from_int(value: actual.public_functions)
    let apis = String.from_int(value: actual.public_apis)
    let mutating = String.from_int(value: actual.mutating_apis)
    let retaining = String.from_int(value: actual.retaining_apis)
    let resource = String.from_int(value: actual.resource_apis)
    let fresh = String.from_int(value: actual.fresh_returning_apis)
    let unknown = String.from_int(value: actual.unknown_apis)
    let mismatch_count = String.from_int(value: mismatches)
    let unmodeled = String.from_int(value: actual.unmodeled_reasons)
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "selfhost package exports types=")
    StringBuilder.push(builder: mut builder, value: types)
    StringBuilder.push(builder: mut builder, value: " functions=")
    StringBuilder.push(builder: mut builder, value: functions)
    StringBuilder.push(builder: mut builder, value: " apis=")
    StringBuilder.push(builder: mut builder, value: apis)
    StringBuilder.push(builder: mut builder, value: " mutating=")
    StringBuilder.push(builder: mut builder, value: mutating)
    StringBuilder.push(builder: mut builder, value: " retaining=")
    StringBuilder.push(builder: mut builder, value: retaining)
    StringBuilder.push(builder: mut builder, value: " resource=")
    StringBuilder.push(builder: mut builder, value: resource)
    StringBuilder.push(builder: mut builder, value: " fresh=")
    StringBuilder.push(builder: mut builder, value: fresh)
    StringBuilder.push(builder: mut builder, value: " unknown=")
    StringBuilder.push(builder: mut builder, value: unknown)
    StringBuilder.push(builder: mut builder, value: " mismatches=")
    StringBuilder.push(builder: mut builder, value: mismatch_count)
    StringBuilder.push(builder: mut builder, value: " unmodeled_reasons=")
    StringBuilder.push(builder: mut builder, value: unmodeled)

    return StringBuilder.finish(builder: take builder)
}

pub fn main() -> Result<Unit, JsonError> {
    let actual = selfhost_export_summary()?
    let expected = expected_export_summary()?
    let mismatches = export_mismatch_count(actual, expected)
    let summary = export_summary_line(actual, mismatches)

    Log.write(message: summary)

    Assert.equal_int(left: mismatches, right: 0)
    Assert.equal_int(left: actual.unmodeled_reasons, right: 0)

    return Ok(Unit)
}
