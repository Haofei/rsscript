features: local

class MyCache {
    entries: Map<String, String>
}

fn MyCache.put(self: mut MyCache, key: String, value: String) -> Unit
    effects(retains(key), retains(value))
{
    Map.insert(map: mut self.entries, key, value)
}

fn MyCache.get(self: MyCache, key: String) -> Option<String> {
    return Map.get(map: self.entries, key)
}

fn use_cache(cache: mut MyCache, key: String, value: String) -> Unit
    effects(retains(key), retains(value))
{
    mut cache.put(key: key, value: value)
}
