
struct ImageData {
    size: Int
}

struct Cache {
    count: Int
}

fn Cache.store(cache: mut Cache, image: ImageData) -> Unit
    retains(image) {
    return Unit
}

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn main() -> Unit {
    let cache = Cache(count: 0)

    apply(callback: || {
        local image = ImageData(size: 1)
        let shared = manage image
        Cache.store(cache: mut cache, image: shared)
    })

    return Unit
}
