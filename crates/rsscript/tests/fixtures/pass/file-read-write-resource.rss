
resource File {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn copy_file(input: Path, output: Path) -> Result<Unit, FileError> {
    with File.open_read(path: input)? as reader {
        with File.open_write(path: output)? as writer {
            let bytes = File.read_all(file: mut reader)?
            File.write(file: mut writer, data: bytes)?
        }
    }

    return Ok(Unit)
}
