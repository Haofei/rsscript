
class RetainedImageStore {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

struct ImageError

fn Image.load(path: Path) -> Result<fresh Image, ImageError>

fn Image.resize(image: mut Image, width: Int, height: Int) -> Unit

fn Image.save(image: Image, path: Path) -> Result<Unit, ImageError>

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: Image) -> Unit
    retains(image)

fn good_store(cache: mut RetainedImageStore, input: Path, output: Path) -> Result<Unit, ImageError> {
    local image = Image.load(path: input)?
    Image.resize(image: mut image, width: 800, height: 600)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: shared)
    Image.save(image: shared, path: output)?

    return Ok(Unit)
}
