// expect: RS0401
features: local

struct Image

struct Holder {
    image: Image
}

fn make_holder(path: Path) -> fresh Holder

fn consume(image: take Image) -> Unit

fn inspect(image: Image) -> Unit

fn bad_take_field(path: Path) -> Unit {
    local holder = make_holder(path)
    consume(image: take holder.image)
    inspect(image: holder.image)
}
