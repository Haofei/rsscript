// expect: RS0708
features: local

resource DbConnection {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn DbConnection.open(url: String) -> DbConnection

// An eager pool allocates up front, so `max_size` must be statically known (a
// positive literal or a `const`). A runtime parameter is rejected. (A lazy pool
// would accept this — it sizes on demand.)
fn bad_pool(url: String, size: Int) -> Unit {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.open(url),
        max_size: size,
    )
}
