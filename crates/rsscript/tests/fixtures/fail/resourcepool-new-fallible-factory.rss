// expect: RS0707
features: local

resource DbConnection {
    fd: Int

    drop {
        Db.close(fd: fd)
    }
}

fn DbConnection.try_open(url: Url) -> Result<DbConnection, DbError>

fn bad_pool(url: Url) -> Unit {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.try_open(url),
        max_size: 4,
    )
}
