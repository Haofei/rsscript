// expect: RS0706
features: local

resource File {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn File.open_result(path: Path) -> Result<File, IOError>
fn File.stat(file: File) -> Unit

fn bad_with_missing_try(path: Path) -> Unit {
    with File.open_result(path) as file {
        File.stat(file)
    }
}
