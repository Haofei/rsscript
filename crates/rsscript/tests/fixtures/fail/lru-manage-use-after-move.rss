// expect: RS0401

class LruCache {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

fn lru_put(cache: mut LruCache, key: String, value: Image) -> Unit
    retains(value)
{
    Map.insert(map: mut cache.entries, key, value)
}

fn store_thumbnail(cache: mut LruCache, key: String, path: Path) -> Unit {
    local image = Image.load(path)
    lru_put(cache: mut cache, key, value: (manage image))
    Image.inspect(image)
}
