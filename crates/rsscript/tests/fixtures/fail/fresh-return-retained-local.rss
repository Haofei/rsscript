class RetainedImageStore {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

fn Image.load(path: Path) -> fresh Image

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: Image) -> Unit
    retains(image)

fn bad_fresh(cache: mut RetainedImageStore, path: Path) -> fresh Image {
    local image = Image.load(path)
    RetainedImageStore.store(cache: mut cache, image)

    return image
}
