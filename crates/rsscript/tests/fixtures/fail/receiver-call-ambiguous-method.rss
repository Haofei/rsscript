// expect: RS0206
features: local

protocol Formatter {
    fn format(self: Self) -> fresh String
}

struct Report {
    title: String
}

fn Report.format(self: Report) -> fresh String {
    return String.concat(left: "report:", right: self.title)
}

impl Formatter for Report {
    format = Report.format
}

fn display(report: Report) -> fresh String {
    return report.format()
}
