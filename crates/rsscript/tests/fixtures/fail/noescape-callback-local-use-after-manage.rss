// expect: RS0401

struct ImageData {
    size: Int
}

fn inspect(image: ImageData) -> Unit

fn apply(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn main() -> Unit {
    apply(callback: || {
        local image = ImageData(size: 1)
        let shared = manage image
        inspect(image)
        inspect(image: shared)
    })

    return Unit
}
