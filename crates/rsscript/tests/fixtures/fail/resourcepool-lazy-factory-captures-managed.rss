// expect: RS0711
features: local

resource Session {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn Session.open(host: String) -> Session

// A lazy factory must capture an *owned local*. A managed `let` binding is
// shared/refcounted, not a clean owned value, so capturing it is rejected just
// like capturing a parameter — `local host_value = ...` should be used instead.
fn run() -> Result<Unit, PoolError> {
    let host = "db://local"
    local pool = ResourcePool<Session>.lazy(
        create: || Session.open(host),
        max_size: 2,
    )
    return Ok(Unit)
}
