// expect: RS0501

struct Image {
    pixels: Buffer
}

struct Holder {
    image: Image
}

struct Cache

fn Cache.store(cache: mut Cache, value: Image) -> Unit
    retains(value)

fn make_holder(path: Path) -> fresh Holder

fn bad_store(cache: mut Cache, path: Path) -> Unit {
    local holder = make_holder(path)
    Cache.store(cache: mut cache, value: holder.image)
}
