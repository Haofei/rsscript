// expect: RS0401

struct Image {
    pixels: Buffer
}

fn Image.load(path: Path) -> fresh Image
fn Image.save(image: Image, path: Path) -> Unit

fn publish(path: Path) -> Unit {
    local image = Image.load(path)
    let shared = manage image
    Image.save(image, path)
    Image.save(image: shared, path)
}
