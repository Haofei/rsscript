// expect: RS0702
features: local

resource File {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

class Registry {
    entries: List<File>
}

fn register(registry: mut Registry, file: File) -> Unit
    effects(retains(file))
{
}

fn bad_retain(registry: mut Registry, path: Path) -> Unit {
    with File.open(path)? as file {
        register(registry: mut registry, file)
    }
}
