// expect: RS0302
features: local

struct Cache {
    value: Int
}

struct Inner {
    cache: Cache
}

struct State {
    inner: Inner
}

fn use_state(state: State, cache: mut Cache) -> Unit
fn make_state() -> fresh State

fn run() -> Unit {
    local state = make_state()
    use_state(state, cache: mut state.inner.cache)
}
