// expect: RS0101 RS0202 RS0207

struct Image {
    pixels: Buffer
}

struct ImageError

fn Image.load(path: Path) -> fresh Image
fn Image.resize(image: mut Image, width: Int, height: Int) -> Unit
fn Image.save(image: Image, path: Path) -> Result<Unit, ImageError>

fn resize(image: mut Image, width: Int, height: Int) -> Unit {
    local image = Image.load(path: "in.png")
    Image.resize(image: image, width: 800, height: 600)
    Image.save(read image, path: "out.png")
}
