// expect: RS0702

features: local

resource MyFile {
    fd: Int
}

resource Conn {
    fd: Int
}

class MyError {
    code: Int
}

fn MyFile.open(path: Path) -> Result<MyFile, MyError>
fn Conn.from_file(file: MyFile) -> Conn

fn bad(path: Path) -> Result<Unit, MyError> {
    with MyFile.open(path)? as file {
        local pool = ResourcePool<Conn>.new(
            create: || Conn.from_file(file),
            max_size: 1,
        )
    }
    return Ok(Unit)
}
