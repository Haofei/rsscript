// expect: RS0702

features: local

resource MyFile {
    fd: Int
}

resource Conn {
    fd: Int
}

class MyError {
    code: Int
}

fn MyFile.open(path: read Path) -> Result<MyFile, MyError>
fn Conn.from_file(file: read MyFile) -> Conn

fn bad(path: read Path) -> Result<Unit, MyError> {
    with MyFile.open(path: read path)? as file {
        local pool = ResourcePool<Conn>.new(
            create: || Conn.from_file(file: read file),
            max_size: 1,
        )
    }
    return Ok(Unit)
}
