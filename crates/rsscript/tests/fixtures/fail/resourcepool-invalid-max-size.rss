// expect: RS0708
features: local

resource DbConnection {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn DbConnection.open(url: String) -> DbConnection

fn bad_pool(url: String) -> Unit {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.open(url),
        max_size: 0,
    )
}
