// expect: RS0801

struct Image
struct CallbackOption
class Scheduler

fn Image.load(path: Path) -> fresh Image
fn Image.inspect(image: Image) -> Unit
fn schedule(scheduler: mut Scheduler, callback: CallbackOption) -> Unit
    retains(callback)

fn bad_schedule(scheduler: mut Scheduler, path: Path) -> Unit {
    local image = Image.load(path)
    schedule(
        scheduler: mut scheduler,
        callback: Some(|| {
            Image.inspect(image)
        }),
    )
    return Unit
}
