// expect: RS0501
features: local

class Cache {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

fn cache_put(cache: mut Cache, value: Image) -> Unit
    effects(retains(value))
{
}

fn run(cache: mut Cache, path: Path) -> Unit {
    local image = Image.load(path)
    cache_put(cache: mut cache, value: image)
}
