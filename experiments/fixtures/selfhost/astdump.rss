// Self-hosted rss AST-dump producer — step 2 of frontend object parity.
//
//
// Emits the canonical AST dump defined in docs/self-hosting.md, matching the
// Rust oracle (crate::syntax::parse_source_raw serialized by crate::selfhost_parity)
// byte-for-byte at tier 0. Reads RSS source as argv[0] and prints the dump.
//
// KEY DESIGN: parser_items materializes one shared Program. This module renders
// supported declarations and function-body nodes directly from that value. The
// older recursive token renderer remains an explicit compatibility fallback for
// grammar families whose shared AST representation is not exact yet; each
// migrated family removes another reason to enter it. Both paths use the shared
// scanner and emit the same deterministic pre-order protocol.
//
// COVERAGE: the ignored ast_parity_corpus gate now requires byte-exact parity
// over every discovered corpus file. The curated samples under
// selfhost/samples/ast/ remain the fast non-ignored inner-loop gate.
//
// rss constraints honored (SH-016/017/018): char literals, `||` chains kept on one
// line / wrapped via operator continuation, cursors threaded positionally.

module selfhost.astdump

use selfhost.scan.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

// Symbol codes not already named in scan.rss (single-char ASCII).
const SYM_QUESTION: Int = 63    // '?'
const SYM_BANG: Int = 33        // '!'
const SYM_TILDE: Int = 126      // '~'
const SYM_SEMI: Int = 59        // ';'
const SYM_AMP: Int = 38         // '&'
const SYM_PIPE: Int = 124       // '|'
const SYM_PLUS: Int = 43        // '+'
const SYM_MINUS: Int = 45       // '-'
const SYM_SLASH: Int = 47       // '/'
const SYM_CARET: Int = 94       // '^'
const SYM_PERCENT: Int = 37     // '%'

// -------------------------------------------------------------------------
// Emit helpers.
// -------------------------------------------------------------------------

fn indent(depth: Int) -> String {
    // Most AST nodes are shallow. Avoid allocating a StringBuilder for every
    // emitted node on corpus-scale inputs; deeply nested source keeps the
    // existing general fallback below.
    if depth <= 0 { return "" }
    if depth == 1 { return "  " }
    if depth == 2 { return "    " }
    if depth == 3 { return "      " }
    if depth == 4 { return "        " }
    if depth == 5 { return "          " }
    if depth == 6 { return "            " }
    if depth == 7 { return "              " }
    if depth == 8 { return "                " }
    local sb = StringBuilder.new()
    let mut k = 0
    while k < depth {
        StringBuilder.push(builder: mut sb, value: "  ")
        k = k + 1
    }
    return StringBuilder.finish(builder: take sb)
}

fn emit(out: mut StringBuilder, depth: Int, s: String) -> Unit {
    let line = String.concat(left: indent(depth), right: s)
    StringBuilder.push(builder: mut out, value: line)
    StringBuilder.push(builder: mut out, value: "\n")
    return Unit
}

// Span suffix ` @line:col:len` for the representative token i (always the richest
// form; the harness projects it down to the active AST tier). Mirrors the Rust
// oracle's `sp`, whose node span is a SINGLE token's line:col:len (never a
// multi-token range) — so reproducing a node's span is just emitting its
// representative token's position + length.
fn spanof(toks: List<Tok>, i: Int) -> String {
    let lc = String.concat(left: String.concat(left: String.from_int(value: tk_line(toks: toks, i: i)), right: ":"), right: String.from_int(value: tk_col(toks, i)))
    let full = String.concat(left: String.concat(left: lc, right: ":"), right: String.from_int(value: tk_len(toks, i)))
    return String.concat(left: " @", right: full)
}

// emit a spanned node HEAD: content + the representative token's span suffix.
fn emit_at(out: mut StringBuilder, depth: Int, s: String, toks: List<Tok>, i: Int) -> Unit {
    emit(out: mut out, depth, s: String.concat(left: s, right: spanof(toks, i)))
    return Unit
}

fn tk_text(toks: List<Tok>, i: Int) -> String {
    if i < 0 { return "" }
    if i >= List.len(list: toks) { return "" }
    let t = List.get(list: toks, index: i)
    return t.text
}

// Span-field accessors for a token (defined here, not in the shared scan.rss
// prelude, because parser.rss already declares its own `tk_col`).
fn tk_col(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: toks) { return 0 }
    let t = List.get(list: toks, index: i)
    return t.col
}

fn tk_len(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: toks) { return 0 }
    let t = List.get(list: toks, index: i)
    return t.len
}

// bool -> "true"/"false" for attribute values.
fn boolstr(b: Bool) -> String {
    if b { return "true" }
    return "false"
}

// -------------------------------------------------------------------------
// Expression parser (range-based, mirrors crate::syntax::parser::expr).
// emit_expr renders the expression occupying tokens [start, end) at depth d.
// -------------------------------------------------------------------------

// Mirrors is_generic_angle_open: token `open` is `<`, preceded by an ident, and
// its matching `>` (by angle nesting) is followed by `.` or `(` — i.e. it opens a
// generic argument list, not a comparison.
fn is_generic_angle(toks: List<Tok>, start: Int, end: Int, open: Int) -> Bool {
    if open <= start { return false }
    if is_ident_tok(toks: toks, i: (open - 1)) == false { return false }
    if at_symbol(toks: toks, i: open, code: SYM_LANGLE) == false { return false }
    let mut depth = 0
    let mut i = open
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RANGLE) {
            depth = depth - 1
            if depth == 0 {
                return at_symbol(toks: toks, i: (i + 1), code: SYM_DOT) || at_symbol(toks: toks, i: (i + 1), code: SYM_LPAREN)
            }
        }
        i = i + 1
    }
    return false
}

// Two consecutive symbol tokens a,b at i (both within end).
fn two_sym(toks: List<Tok>, i: Int, end: Int, a: Int, b: Int) -> Bool {
    if i + 1 >= end { return false }
    return at_symbol(toks: toks, i: i, code: a) && at_symbol(toks: toks, i: (i + 1), code: b)
}

// Dump op name for the operator at index i (assumes it is a real binop split point).
fn binop_name_at(toks: List<Tok>, i: Int, end: Int) -> String {
    if two_sym(toks, i, end, a: SYM_PIPE, b: SYM_PIPE) { return "logical-or" }
    if two_sym(toks, i, end, a: SYM_AMP, b: SYM_AMP) { return "logical-and" }
    if two_sym(toks, i, end, a: SYM_EQ, b: SYM_EQ) { return "equal" }
    if two_sym(toks, i, end, a: SYM_BANG, b: SYM_EQ) { return "not-equal" }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_EQ) { return "less-equal" }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_EQ) { return "greater-equal" }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_LANGLE) { return "shift-left" }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_RANGLE) { return "shift-right" }
    if at_symbol(toks: toks, i: i, code: SYM_PIPE) { return "bit-or" }
    if at_symbol(toks: toks, i: i, code: SYM_CARET) { return "bit-xor" }
    if at_symbol(toks: toks, i: i, code: SYM_AMP) { return "bit-and" }
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) { return "less" }
    if at_symbol(toks: toks, i: i, code: SYM_RANGLE) { return "greater" }
    if at_symbol(toks: toks, i: i, code: SYM_PLUS) { return "add" }
    if at_symbol(toks: toks, i: i, code: SYM_MINUS) { return "subtract" }
    if at_symbol(toks: toks, i: i, code: SYM_STAR) { return "multiply" }
    if at_symbol(toks: toks, i: i, code: SYM_SLASH) { return "divide" }
    return "modulo"
}

// Token width of the operator at i (1 or 2).
fn binop_width_at(toks: List<Tok>, i: Int, end: Int) -> Int {
    if two_sym(toks, i, end, a: SYM_PIPE, b: SYM_PIPE) { return 2 }
    if two_sym(toks, i, end, a: SYM_AMP, b: SYM_AMP) { return 2 }
    if two_sym(toks, i, end, a: SYM_EQ, b: SYM_EQ) { return 2 }
    if two_sym(toks, i, end, a: SYM_BANG, b: SYM_EQ) { return 2 }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_EQ) { return 2 }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_EQ) { return 2 }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_LANGLE) { return 2 }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_RANGLE) { return 2 }
    return 1
}

// Precedence tier of the operator beginning at i, or 0 when it cannot split an
// expression. This ordering is used by both binary-expression scans.
fn op_tier_at(toks: List<Tok>, i: Int, end: Int) -> Int {
    if two_sym(toks, i, end, a: SYM_PIPE, b: SYM_PIPE) { return 1 }
    if two_sym(toks, i, end, a: SYM_AMP, b: SYM_AMP) { return 2 }
    if at_symbol(toks: toks, i: i, code: SYM_PIPE) { return 3 }
    if at_symbol(toks: toks, i: i, code: SYM_CARET) { return 4 }
    if at_symbol(toks: toks, i: i, code: SYM_AMP) { return 5 }
    if two_sym(toks, i, end, a: SYM_EQ, b: SYM_EQ) { return 6 }
    if two_sym(toks, i, end, a: SYM_BANG, b: SYM_EQ) { return 6 }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_EQ) { return 6 }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_EQ) { return 6 }
    if two_sym(toks, i, end, a: SYM_LANGLE, b: SYM_LANGLE) { return 7 }
    if two_sym(toks, i, end, a: SYM_RANGLE, b: SYM_RANGLE) { return 7 }
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) || at_symbol(toks: toks, i: i, code: SYM_RANGLE) { return 6 }
    if at_symbol(toks: toks, i: i, code: SYM_PLUS) || at_symbol(toks: toks, i: i, code: SYM_MINUS) { return 8 }
    if at_symbol(toks: toks, i: i, code: SYM_STAR) || at_symbol(toks: toks, i: i, code: SYM_SLASH) || at_symbol(toks: toks, i: i, code: SYM_PERCENT) { return 9 }
    return 0
}

// Lowest-precedence top-level operator split index in [start, end), or -1.
// For equal precedence the last operator wins, preserving left-associative
// parsing. Generic angle groups are excluded exactly as in the chain collector.
fn find_binop(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut angle = 0
    let mut bestTier = 10
    let mut best = -1
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: i, code: SYM_LANGLE) && is_generic_angle(toks, start, end, open: i) {
            angle = angle + 1
        } else if depth == 0 && angle > 0 {
            if at_symbol(toks: toks, i: i, code: SYM_LANGLE) { angle = angle + 1 }
            else if at_symbol(toks: toks, i: i, code: SYM_RANGLE) { angle = angle - 1 }
        } else if depth == 0 {
            let tier = op_tier_at(toks, i, end)
            if tier > 0 && tier <= bestTier {
                bestTier = tier
                best = i
            }
        }
        i = i + 1
    }
    return best
}

// All top-level operators at the lowest precedence present, in source order.
// This combines split discovery and chain collection: the previous renderer scanned
// every binary expression twice before it could render even a one-op tree.
// Equal-precedence operators stay in source order, preserving left association.
fn collect_lowest_top_binops(toks: List<Tok>, start: Int, end: Int) -> fresh List<Int> {
    local ops = List<Int>.new()
    let mut depth = 0
    let mut angle = 0
    let mut bestTier = 10
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: i, code: SYM_LANGLE) && is_generic_angle(toks, start, end, open: i) {
            angle = angle + 1
        } else if depth == 0 && angle > 0 {
            if at_symbol(toks: toks, i: i, code: SYM_LANGLE) { angle = angle + 1 }
            else if at_symbol(toks: toks, i: i, code: SYM_RANGLE) { angle = angle - 1 }
        } else if depth == 0 {
            let tier = op_tier_at(toks, i, end)
            if tier > 0 && tier < bestTier {
                bestTier = tier
                List.clear<Int>(list: mut ops)
                List.push<Int>(list: mut ops, value: i)
            } else if tier > 0 && tier == bestTier {
                List.push<Int>(list: mut ops, value: i)
            }
        }
        i = i + 1
    }
    return ops
}

// Emit the left-associated tree for ops[0..count). Each operator was found at
// top level by the chain collector, so the right child contains no same-tier
// operator and the left child can reuse the prefix of that one analysis.
fn emit_binary_chain(out: mut StringBuilder, toks: List<Tok>, ops: List<Int>, count: Int, start: Int, end: Int, d: Int) -> Unit {
    if count <= 0 {
        emit_expr(out: mut out, toks, start, end, d)
        return Unit
    }
    let op = List.get<Int>(list: ops, index: (count - 1))
    let name = binop_name_at(toks, i: op, end)
    let width = binop_width_at(toks, i: op, end)
    emit_at(out: mut out, depth: d, s: String.concat(left: "binary op=", right: name), toks, i: op)
    emit_binary_chain(out: mut out, toks, ops, count: (count - 1), start, end: op, d: (d + 1))
    emit_expr(out: mut out, toks, start: (op + width), end, d: (d + 1))
    return Unit
}

// Representative token index whose (line:col:len) IS this expression's span —
// mirrors emit_expr's dispatch order exactly (the parser sets each Expr.span from
// ONE token: the operator for Binary, the trailing `?` for Try, the receiver for
// a ReceiverCall, otherwise the node's first trimmed token). Used where a caller
// needs the span WITHOUT descending into the expr (e.g. an expr-statement head,
// whose span equals its inner expression's span).
fn expr_rep_tok(toks: List<Tok>, start: Int, end: Int) -> Int {
    // Tuple `(a, b, …)` — before paren-trim; span = the `(`.
    if at_symbol(toks: toks, i: start, code: SYM_LPAREN) {
        let tclose = find_matching(toks: toks, open: start, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if tclose == (end - 1) && count_type_args(toks, start: (start + 1), end: tclose) >= 2 {
            return start
        }
    }
    // Trim wrapping parens.
    let mut s = start
    let mut e = end
    let mut trimming = true
    while trimming {
        if s < e && at_symbol(toks: toks, i: s, code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: s, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close == e - 1 { s = s + 1; e = close } else { trimming = false }
        } else { trimming = false }
    }
    if s >= e { return s }
    // Closures / effect-closures / fn-closures: span = first token.
    if at_symbol(toks: toks, i: s, code: SYM_PIPE) { return s }
    if is_kw_text(toks, i: s, word: "fn") && at_symbol(toks: toks, i: (s + 1), code: SYM_LPAREN) { return s }
    let effClosure = effect_kw(toks, i: s)
    if String.len(value: effClosure) > 0 && at_symbol(toks: toks, i: (s + 1), code: SYM_PIPE) { return s }
    // Binary: span = the operator token.
    let opIdx = find_binop(toks, start: s, end: e)
    if opIdx >= 0 { return opIdx }
    // Prefix `!`/`~`: span = the operator (first) token.
    if at_symbol(toks: toks, i: s, code: SYM_BANG) { return s }
    if at_symbol(toks: toks, i: s, code: SYM_TILDE) { return s }
    // Trailing `?` => try; span = the `?` token.
    if at_symbol(toks: toks, i: (e - 1), code: SYM_QUESTION) { return e - 1 }
    // Match expression: span = the `match` keyword.
    if is_kw_text(toks, i: s, word: "match") && at_symbol(toks: toks, i: (e - 1), code: SYM_RBRACE) {
        let braceOpen = matching_open_brace(toks, close: (e - 1), start: s)
        if braceOpen > s { return s }
    }
    // Effect prefix: a receiver-call shorthand's span is the RECEIVER token; a
    // plain effect prefix's span is the effect keyword.
    let effWord = effect_kw(toks, i: s)
    if String.len(value: effWord) > 0 {
        let recvStart = s + 1
        if at_symbol(toks: toks, i: recvStart, code: SYM_BANG) == false {
            let dot = find_receiver_call_dot(toks, recvStart, end: e)
            if dot > recvStart && is_qualified_ns_receiver(toks, start: recvStart, dot) == false {
                let open = find_call_open(toks, start: (dot + 1), end: e)
                let method = named_segment_str(toks, start: (dot + 1), end: open)
                if open > 0 && String.len(value: method) > 0 { return recvStart }
            }
        }
        return s
    }
    // manage / spawn / await: span = the keyword.
    // Postfix (call / index / field / primary): span = the first trimmed token.
    return s
}

fn emit_expr(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    // Tuple literal `(a, b, …)` (≥2 elements filling the whole range) desugars to a
    // `__TupleN(item0: a, …)` call — detected before paren-trimming (parse_tuple_expr).
    if at_symbol(toks: toks, i: start, code: SYM_LPAREN) {
        let tclose = find_matching(toks: toks, open: start, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if tclose == (end - 1) {
            let cnt = count_type_args(toks, start: (start + 1), end: tclose)
            if cnt >= 2 {
                emit_at(out: mut out, depth: d, s: "call", toks, i: start)
                emit(out: mut out, depth: (d + 1), s: String.concat(left: "callee-name name=__Tuple", right: String.from_int(value: cnt)))
                let mut idx = 0
                let mut k = start + 1
                while k < tclose {
                    let comma = split_comma(toks, start: k, end: tclose)
                    let mut segEnd = tclose
                    if comma >= 0 { segEnd = comma }
                    if k < segEnd {
                        emit(out: mut out, depth: (d + 1), s: String.concat(left: "arg name=item", right: String.from_int(value: idx)))
                        emit_expr(out: mut out, toks, start: k, end: segEnd, d: (d + 2))
                        idx = idx + 1
                    }
                    if comma < 0 { k = tclose } else { k = comma + 1 }
                }
                return Unit
            }
        }
    }
    // Trim parens wrapping the whole range: (expr) -> expr.
    let mut s = start
    let mut e = end
    let mut trimming = true
    while trimming {
        if s < e && at_symbol(toks: toks, i: s, code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: s, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close == e - 1 {
                s = s + 1
                e = close
            } else {
                trimming = false
            }
        } else {
            trimming = false
        }
    }
    if s >= e {
        emit_at(out: mut out, depth: d, s: "unknown-expr", toks, i: s)
        return Unit
    }
    // Negative number literal: `-` <number> exactly (before binary/closure, as in
    // parse_expr) so it doesn't split as subtraction.
    if e - s == 2 && at_symbol(toks: toks, i: s, code: SYM_MINUS) && tk_kind(toks: toks, i: (s + 1)) == TOK_NUMBER {
        emit_at(out: mut out, depth: d, s: String.concat(left: "number -", right: escape(s: tk_text(toks, i: (s + 1)))), toks, i: s)
        return Unit
    }
    // Closure `|params| body` — checked before binary split so its `|` pipes are
    // not read as bit-or (matches parse_expr's ordering).
    if at_symbol(toks: toks, i: s, code: SYM_PIPE) {
        emit_closure(out: mut out, toks, start: s, end: e, d)
        return Unit
    }
    // Explicit closure: `fn(params) captures(...) [effect_list(...)] { body }`.
    if is_kw_text(toks, i: s, word: "fn") && at_symbol(toks: toks, i: (s + 1), code: SYM_LPAREN) {
        emit_explicit_fn(out: mut out, toks, start: s, end: e, d)
        return Unit
    }
    // `if condition { then } else { otherwise }` is represented as the same
    // two boolean arms as the Rust parser, while retaining an `if-expr` dump
    // tag so surface syntax remains reviewable.
    if is_kw_text(toks, i: s, word: "if") && at_symbol(toks: toks, i: (e - 1), code: SYM_RBRACE) {
        let thenOpen = find_block_open(toks, start: (s + 1), limit: e)
        if thenOpen > s {
            let thenClose = find_matching(toks: toks, open: thenOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            let elsePos = thenClose + 1
            if thenClose >= thenOpen && is_kw_text(toks, i: elsePos, word: "else") && at_symbol(toks: toks, i: (elsePos + 1), code: SYM_LBRACE) {
                let elseOpen = elsePos + 1
                let elseClose = find_matching(toks: toks, open: elseOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if elseClose == e - 1 {
                    emit_at(out: mut out, depth: d, s: "if-expr", toks, i: s)
                    emit(out: mut out, depth: (d + 1), s: "value")
                    emit_expr(out: mut out, toks, start: (s + 1), end: thenOpen, d: (d + 2))
                    emit_at(out: mut out, depth: (d + 1), s: "arm", toks, i: s)
                    emit(out: mut out, depth: (d + 2), s: "pattern")
                    emit(out: mut out, depth: (d + 3), s: "pat-literal kind=bool true")
                    emit_block(out: mut out, toks, open: thenOpen, close: thenClose, d: (d + 2))
                    emit_at(out: mut out, depth: (d + 1), s: "arm", toks, i: elsePos)
                    emit(out: mut out, depth: (d + 2), s: "pattern")
                    emit(out: mut out, depth: (d + 3), s: "pat-literal kind=bool false")
                    emit_block(out: mut out, toks, open: elseOpen, close: elseClose, d: (d + 2))
                    return Unit
                }
            }
        }
    }
    // Effect-annotated closure `read || { … }` / `mut |x| …`: handled BEFORE the
    // binary split so the closure `|` pipes aren't read as logical-or / bit-or.
    // (parse_expr special-cases ONLY effect+closure here; a general `read <expr>`
    // like `read r * read r` still splits at the operator first — effect binds
    // tighter than any binary op.)
    let effClosure = effect_kw(toks, i: s)
    if String.len(value: effClosure) > 0 && at_symbol(toks: toks, i: (s + 1), code: SYM_PIPE) {
        emit_at(out: mut out, depth: d, s: String.concat(left: "effect kind=", right: effClosure), toks, i: s)
        emit_closure(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        return Unit
    }
    // Binary split (lowest precedence, last top-level occurrence). One scan
    // returns the complete equal-precedence chain, including the one-op case.
    let chain = collect_lowest_top_binops(toks, start: s, end: e)
    let chainCount = List.len(list: chain)
    if chainCount > 0 {
        let opIdx = List.get<Int>(list: chain, index: (chainCount - 1))
        if chainCount > 1 {
            emit_binary_chain(out: mut out, toks, chain, count: chainCount, start: s, end: e, d)
            return Unit
        }
        let name = binop_name_at(toks, i: opIdx, end: e)
        let w = binop_width_at(toks, i: opIdx, end: e)
        emit_at(out: mut out, depth: d, s: String.concat(left: "binary op=", right: name), toks, i: opIdx)
        emit_expr(out: mut out, toks, start: s, end: opIdx, d: (d + 1))
        emit_expr(out: mut out, toks, start: (opIdx + w), end: e, d: (d + 1))
        return Unit
    }
    // Prefix `!x` desugars to `x == false`; `~x` to `Int.bit_not(value: x)`.
    if at_symbol(toks: toks, i: s, code: SYM_BANG) {
        emit_at(out: mut out, depth: d, s: "binary op=equal", toks, i: s)
        emit_unary_operand(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        emit_at(out: mut out, depth: (d + 1), s: "ident false", toks, i: s)
        return Unit
    }
    if at_symbol(toks: toks, i: s, code: SYM_TILDE) {
        emit_at(out: mut out, depth: d, s: "call", toks, i: s)
        emit(out: mut out, depth: (d + 1), s: "callee-qualified namespace=Int name=bit_not")
        emit(out: mut out, depth: (d + 1), s: "arg name=value")
        emit_unary_operand(out: mut out, toks, start: (s + 1), end: e, d: (d + 2))
        return Unit
    }
    // Trailing top-level `?` => try.
    if at_symbol(toks: toks, i: (e - 1), code: SYM_QUESTION) {
        emit_at(out: mut out, depth: d, s: "try", toks, i: (e - 1))
        emit_expr(out: mut out, toks, start: s, end: (e - 1), d: (d + 1))
        return Unit
    }
    // Match expression: match [effect] value { arms }.
    if is_kw_text(toks, i: s, word: "match") && at_symbol(toks: toks, i: (e - 1), code: SYM_RBRACE) {
        let braceOpen = matching_open_brace(toks, close: (e - 1), start: s)
        if braceOpen > s {
            emit_match(out: mut out, toks, matchPos: s, braceOpen, braceClose: (e - 1), tag: "match-expr", d)
            return Unit
        }
    }
    // General effect prefix: read/mut/take <value>, handled AFTER the binary split
    // (effect binds tighter than any operator). The receiver-call shorthand
    // `<effect> recv.method(args)` (lowercase receiver) parses as a ReceiverCall;
    // an uppercase namespace (`read Store.put()`) stays a qualified call under it.
    let effWord = effect_kw(toks, i: s)
    if String.len(value: effWord) > 0 {
        let recvStart = s + 1
        if at_symbol(toks: toks, i: recvStart, code: SYM_BANG) == false {
            let dot = find_receiver_call_dot(toks, recvStart, end: e)
            if dot > recvStart && is_qualified_ns_receiver(toks, start: recvStart, dot) == false {
                let mpos = dot + 1
                let open = find_call_open(toks, start: mpos, end: e)
                let method = named_segment_str(toks, start: mpos, end: open)
                if open > 0 && String.len(value: method) > 0 {
                    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                    emit_at(out: mut out, depth: d, s: "call", toks, i: recvStart)
                    let cl = String.concat(left: "callee-receiver method=", right: method)
                    emit(out: mut out, depth: (d + 1), s: String.concat(left: String.concat(left: cl, right: " effect="), right: effWord))
                    emit_expr(out: mut out, toks, start: recvStart, end: dot, d: (d + 2))
                    emit_args(out: mut out, toks, start: (open + 1), end: close, d: (d + 1))
                    return Unit
                }
            }
        }
        emit_at(out: mut out, depth: d, s: String.concat(left: "effect kind=", right: effWord), toks, i: s)
        emit_expr(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        return Unit
    }
    // Prefix expression forms `manage X` / `spawn X` / `await X` (value child).
    if is_kw_text(toks, i: s, word: "manage") {
        emit_at(out: mut out, depth: d, s: "manage", toks, i: s)
        emit_expr(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        return Unit
    }
    if is_kw_text(toks, i: s, word: "spawn") {
        emit_at(out: mut out, depth: d, s: "spawn", toks, i: s)
        emit_expr(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        return Unit
    }
    if is_kw_text(toks, i: s, word: "await") {
        emit_at(out: mut out, depth: d, s: "await", toks, i: s)
        emit_expr(out: mut out, toks, start: (s + 1), end: e, d: (d + 1))
        return Unit
    }
    emit_postfix(out: mut out, toks, start: s, end: e, d)
    return Unit
}

// Closure `|params| body`. `body` is a `{ }` block or a single expression (which
// becomes a block with one expr-stmt). Captures belong to the explicit `fn(...)`
// form only; the `|...|` form has none.
fn emit_closure(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    // Second `|` closes the parameter list.
    let mut closePipe = -1
    let mut i = start + 1
    while i < end && closePipe < 0 {
        if at_symbol(toks: toks, i: i, code: SYM_PIPE) { closePipe = i }
        i = i + 1
    }
    if closePipe < 0 { emit_at(out: mut out, depth: d, s: "unknown-expr", toks, i: start); return Unit }
    emit_at(out: mut out, depth: d, s: "closure explicit=false", toks, i: start)
    // Params: comma-separated single idents.
    let mut k = start + 1
    while k < closePipe {
        let comma = split_comma(toks, start: k, end: closePipe)
        let pEnd = pick_end(comma, end: closePipe)
        if is_ident_tok(toks: toks, i: k) {
            emit(out: mut out, depth: (d + 1), s: String.concat(left: "closure-param ", right: tk_text(toks, i: k)))
        }
        if comma < 0 { k = closePipe } else { k = comma + 1 }
    }
    emit(out: mut out, depth: (d + 1), s: "body")
    let bodyStart = closePipe + 1
    if at_symbol(toks: toks, i: bodyStart, code: SYM_LBRACE) {
        let close = find_matching(toks: toks, open: bodyStart, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if close == end - 1 {
            emit_block(out: mut out, toks, open: bodyStart, close, d: (d + 2))
            return Unit
        }
    }
    // Single-expression body → a block with one expr-stmt (the Stmt::Expr head is
    // spanned at the body expression's representative token).
    emit(out: mut out, depth: (d + 2), s: "block")
    emit_at(out: mut out, depth: (d + 3), s: "expr-stmt", toks, i: expr_rep_tok(toks, start: bodyStart, end))
    emit_expr(out: mut out, toks, start: bodyStart, end, d: (d + 4))
    return Unit
}

// Explicit closure `fn(params) captures(<data-effect name>, ...) { body }`.
fn emit_explicit_fn(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let pOpen = start + 1
    let pClose = find_matching(toks: toks, open: pOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pClose < 0 { emit_at(out: mut out, depth: d, s: "unknown-expr", toks, i: start); return Unit }
    emit_at(out: mut out, depth: d, s: "closure explicit=true", toks, i: start)
    // params: comma-separated single idents.
    let mut k = pOpen + 1
    while k < pClose {
        let comma = split_comma(toks, start: k, end: pClose)
        if is_ident_tok(toks: toks, i: k) {
            emit(out: mut out, depth: (d + 1), s: String.concat(left: "closure-param ", right: tk_text(toks, i: k)))
        }
        if comma < 0 { k = pClose } else { k = comma + 1 }
    }
    // captures(...) — each entry is `<effect> <ident>`.
    let mut cur = pClose + 1
    if is_kw_text(toks, i: cur, word: "captures") && at_symbol(toks: toks, i: (cur + 1), code: SYM_LPAREN) {
        let cOpen = cur + 1
        let cClose = find_matching(toks: toks, open: cOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        let mut j = cOpen + 1
        while j < cClose {
            let comma = split_comma(toks, start: j, end: cClose)
            let eff = effect_kw(toks, i: j)
            if String.len(value: eff) > 0 && is_ident_tok(toks: toks, i: (j + 1)) {
                let a = String.concat(left: "capture effect=", right: eff)
                let b = String.concat(left: a, right: " name=")
                emit(out: mut out, depth: (d + 1), s: String.concat(left: b, right: tk_text(toks, i: (j + 1))))
            }
            if comma < 0 { j = cClose } else { j = comma + 1 }
        }
        cur = cClose + 1
    }
    emit(out: mut out, depth: (d + 1), s: "body")
    if at_symbol(toks: toks, i: cur, code: SYM_LBRACE) {
        let bClose = find_matching(toks: toks, open: cur, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if bClose == end - 1 {
            emit_block(out: mut out, toks, open: cur, close: bClose, d: (d + 2))
            return Unit
        }
    }
    emit(out: mut out, depth: (d + 2), s: "block")
    return Unit
}

// A unary operand [start, end): strip parens wrapping the whole operand (matches
// unary_operand_range), then emit the expression.
fn emit_unary_operand(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let mut s = start
    let mut e = end
    if s < e && at_symbol(toks: toks, i: s, code: SYM_LPAREN) {
        let close = find_matching(toks: toks, open: s, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if close == e - 1 { s = s + 1; e = close }
    }
    emit_expr(out: mut out, toks, start: s, end: e, d)
    return Unit
}

// "read"/"mut"/"take" if token i is that effect keyword, else "".
fn effect_kw(toks: List<Tok>, i: Int) -> String {
    if is_kw_text(toks, i, word: "read") { return "read" }
    if is_kw_text(toks, i, word: "mut") { return "mut" }
    if is_kw_text(toks, i, word: "take") { return "take" }
    return ""
}

// Postfix / primary. Handles calls, field access, index, and primaries.
fn emit_postfix(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    // Trailing call: <callee>(args) where the ( ) closes exactly at end-1.
    if end - start >= 2 && at_symbol(toks: toks, i: (end - 1), code: SYM_RPAREN) {
        let openp = matching_open_paren(toks, close: (end - 1), start)
        if openp > start {
            // No-effect receiver call: `recv.method(args)` with a lowercase/complex
            // receiver parses as ReceiverCall{effect:None}, not Qualified (only an
            // uppercase namespace path is Qualified).
            let dot = find_receiver_call_dot(toks, recvStart: start, end)
            if dot > start && is_qualified_ns_receiver(toks, start, dot) == false {
                let method = named_segment_str(toks, start: (dot + 1), end: openp)
                if String.len(value: method) > 0 {
                    emit_at(out: mut out, depth: d, s: "call", toks, i: start)
                    emit(out: mut out, depth: (d + 1), s: String.concat(left: "callee-receiver method=", right: method))
                    emit_expr(out: mut out, toks, start, end: dot, d: (d + 2))
                    emit_args(out: mut out, toks, start: (openp + 1), end: (end - 1), d: (d + 1))
                    return Unit
                }
            }
            // callee is [start, openp); args in (openp, end-1)
            emit_at(out: mut out, depth: d, s: "call", toks, i: start)
            emit_callee(out: mut out, toks, start, end: openp, d: (d + 1))
            emit_args(out: mut out, toks, start: (openp + 1), end: (end - 1), d: (d + 1))
            return Unit
        }
    }
    // Trailing index: <base>[idx].
    if end - start >= 2 && at_symbol(toks: toks, i: (end - 1), code: SYM_RBRACKET) {
        let openb = matching_open_bracket(toks, close: (end - 1), start)
        if openb > start {
            emit_at(out: mut out, depth: d, s: "index", toks, i: start)
            emit_expr(out: mut out, toks, start, end: openb, d: (d + 1))
            emit_expr(out: mut out, toks, start: (openb + 1), end: (end - 1), d: (d + 1))
            return Unit
        }
    }
    // Trailing field access: <base>.name  (name is the last token, preceded by `.`).
    if end - start >= 3 && is_ident_tok(toks: toks, i: (end - 1)) && at_symbol(toks: toks, i: (end - 2), code: SYM_DOT) {
        let nm = tk_text(toks, i: (end - 1))
        emit_at(out: mut out, depth: d, s: String.concat(left: "field-access name=", right: nm), toks, i: start)
        emit_expr(out: mut out, toks, start, end: (end - 2), d: (d + 1))
        return Unit
    }
    emit_primary(out: mut out, toks, start, end, d)
    return Unit
}

// The matching '(' for the ')' at `close`, scanning back to `start`, or -1.
fn matching_open_paren(toks: List<Tok>, close: Int, start: Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: toks, i: i, code: SYM_RPAREN) { depth = depth + 1 }
        else if at_symbol(toks: toks, i: i, code: SYM_LPAREN) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

fn matching_open_bracket(toks: List<Tok>, close: Int, start: Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: toks, i: i, code: SYM_RBRACKET) { depth = depth + 1 }
        else if at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

// First top-level dot in [start, end) with `<`/`[`/`(` treated as depth, or -1.
fn find_first_dot_angle(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_DOT) {
            return i
        }
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) || at_symbol(toks: toks, i: i, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RANGLE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) || at_symbol(toks: toks, i: i, code: SYM_RPAREN) {
            depth = depth - 1
        }
        i = i + 1
    }
    return -1
}

// Reproduce parse_named_callee_segment: "" unless [start,end) is `name` or
// `name<arg, ...>` (args canonicalized via type_name_str, joined ", ").
fn named_segment_str(toks: List<Tok>, start: Int, end: Int) -> String {
    if start >= end || is_ident_tok(toks: toks, i: start) == false { return "" }
    let name = tk_text(toks, i: start)
    if start + 1 == end { return name }
    if at_symbol(toks: toks, i: (start + 1), code: SYM_LANGLE) == false { return "" }
    let close = find_matching(toks: toks, open: (start + 1), openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 || close + 1 != end || start + 2 >= close { return "" }
    let args = type_args_str(toks, start: (start + 2), end: close)
    let a = String.concat(left: name, right: "<")
    let b = String.concat(left: a, right: args)
    return String.concat(left: b, right: ">")
}

// Opening `(` of a call in [start, end), or -1. Skips generic `<...>`/`[...]`
// (mirrors find_call_open: only `<`/`[` nest, `>`/`]` close). Scan begins at
// start+1 (the callee/method name occupies start).
fn find_call_open(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut i = start + 1
    while i < end {
        if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_LPAREN) { return i }
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RANGLE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        }
        i = i + 1
    }
    return -1
}

// Last top-level `.` in [recvStart, end) that opens a valid receiver call:
// dot+1 is an ident, a call `(` follows, and its matching `)` closes at end-1.
// Mirrors find_receiver_call_dot (()[]{} nest; `<>` do NOT). -1 if none.
fn find_receiver_call_dot(toks: List<Tok>, recvStart: Int, end: Int) -> Int {
    let mut depth = 0
    let mut best = -1
    let mut i = recvStart
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_DOT) && i > recvStart && (i + 1) < end && is_ident_tok(toks: toks, i: (i + 1)) {
            let open = find_call_open(toks, start: (i + 1), end)
            if open > 0 {
                let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                if close == end - 1 { best = i }
            }
        }
        i = i + 1
    }
    return best
}

// True when the receiver [start, dot) is an uppercase-led namespace path (only
// idents / `<` / `>` / `,`) — those parse as Qualified, not a ReceiverCall.
fn is_qualified_ns_receiver(toks: List<Tok>, start: Int, dot: Int) -> Bool {
    if is_ident_tok(toks: toks, i: start) == false { return false }
    if is_upper_first(name: tk_text(toks, i: start)) == false { return false }
    let mut i = start + 1
    while i < dot {
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) || at_symbol(toks: toks, i: i, code: SYM_RANGLE) || at_symbol(toks: toks, i: i, code: SYM_COMMA) || is_ident_tok(toks: toks, i: i) {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

// Canonical type name for [start, end): `Name` or `Name<arg, ...>` (matches
// type_ref_name for the common subset; Fn/noescape/owned/fresh are not rendered).
fn type_name_str(toks: List<Tok>, start: Int, end: Int) -> String {
    if start >= end || is_ident_tok(toks: toks, i: start) == false { return "" }
    let name = tk_text(toks, i: start)
    if start + 1 < end && at_symbol(toks: toks, i: (start + 1), code: SYM_LANGLE) {
        let close = find_matching(toks: toks, open: (start + 1), openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if close == end - 1 {
            let args = type_args_str(toks, start: (start + 2), end: close)
            let a = String.concat(left: name, right: "<")
            let b = String.concat(left: a, right: args)
            return String.concat(left: b, right: ">")
        }
    }
    return name
}

// Comma-join canonical type names for the arg list [start, end), separator ", ".
fn type_args_str(toks: List<Tok>, start: Int, end: Int) -> String {
    local sb = StringBuilder.new()
    let mut k = start
    let mut first = true
    while k < end {
        let comma = split_comma(toks, start: k, end)
        let aEnd = pick_end(comma, end)
        if !first  { StringBuilder.push(builder: mut sb, value: ", ") }
        StringBuilder.push(builder: mut sb, value: type_name_str(toks, start: k, end: aEnd))
        first = false
        if comma < 0 { k = end } else { k = comma + 1 }
    }
    return StringBuilder.finish(builder: take sb)
}

// Callee occupying [start, end). Mirrors crate::syntax::parser::expr::parse_callee:
// a whole-range named segment (`name` / `name<args>`) is Callee::Name; otherwise
// the FIRST top-level dot splits a type-ref namespace from a method segment,
// giving Callee::Qualified{namespace, name}. Bare `x.m()` is Qualified (namespace
// "x"); Callee::ReceiverCall only arises with an explicit effect (handled in
// emit_expr's effect branch).
fn emit_callee(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let whole = named_segment_str(toks, start, end)
    if String.len(value: whole) > 0 {
        emit(out: mut out, depth: d, s: String.concat(left: "callee-name name=", right: whole))
        return Unit
    }
    let dot = find_first_dot_angle(toks, start, end)
    if dot > start {
        let ns = type_name_str(toks, start, end: dot)
        let meth = named_segment_str(toks, start: (dot + 1), end)
        if String.len(value: ns) > 0 && String.len(value: meth) > 0 {
            let a = String.concat(left: "callee-qualified namespace=", right: ns)
            let b = String.concat(left: a, right: " name=")
            emit(out: mut out, depth: d, s: String.concat(left: b, right: meth))
            return Unit
        }
    }
    // Fallback: a receiver expression `<expr>.method` (rare without an effect).
    if end - start >= 3 && is_ident_tok(toks: toks, i: (end - 1)) && at_symbol(toks: toks, i: (end - 2), code: SYM_DOT) {
        let nm = tk_text(toks, i: (end - 1))
        emit(out: mut out, depth: d, s: String.concat(left: "callee-receiver method=", right: nm))
        emit_expr(out: mut out, toks, start, end: (end - 2), d: (d + 1))
        return Unit
    }
    emit(out: mut out, depth: d, s: "callee-name name=")
    return Unit
}

// Call arguments in [start, end): comma-separated, each optionally `name:` labeled.
fn emit_args(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let mut i = start
    while i < end {
        let comma = split_comma(toks, start: i, end)
        let argEnd = pick_end(comma, end)
        if i >= argEnd {
            // Empty segment (leading/trailing/double comma) → malformed arg with an
            // Unknown value (mirrors parse_call_args' empty_span branch: the Unknown's
            // span is the comma token at `i`).
            emit(out: mut out, depth: d, s: "arg malformed=true")
            emit_at(out: mut out, depth: (d + 1), s: "unknown-expr", toks, i)
        } else {
            // Named arg: `name: value` when a top-level `:` follows an ident at i.
            let mut vstart = i
            let mut line = "arg"
            if is_ident_tok(toks: toks, i: i) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
                line = String.concat(left: "arg name=", right: tk_text(toks, i))
                vstart = i + 2
            }
            emit(out: mut out, depth: d, s: line)
            // An empty value (`print(value:)`) parses to Expr::Unknown spanned at the
            // arg's FIRST token (parse_call_args' tokens[start] fallback), not the
            // post-colon position emit_expr would use.
            if vstart >= argEnd {
                emit_at(out: mut out, depth: (d + 1), s: "unknown-expr", toks, i)
            } else {
                emit_expr(out: mut out, toks, start: vstart, end: argEnd, d: (d + 1))
            }
        }
        if comma < 0 { i = end } else { i = comma + 1 }
    }
    return Unit
}

fn pick_end(comma: Int, end: Int) -> Int {
    if comma < 0 { return end }
    return comma
}

// First top-level comma in [start, end), or -1. Mirrors split_param_ranges: a
// single `depth` counts ()[]{} AND generic `<>`, and a `|` at depth 0 toggles
// `pipe` so closure-parameter commas (`|acc, x|`) don't split. This is the
// canonical splitter for args, params, generic args, and pattern payloads.
fn split_comma(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut pipe = 0
    let mut i = start
    while i < end {
        if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_PIPE) {
            pipe = 1 - pipe
        } else if pipe == 0 && (at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) || at_symbol(toks: toks, i: i, code: SYM_LANGLE)) {
            depth = depth + 1
        } else if pipe == 0 && (at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) || at_symbol(toks: toks, i: i, code: SYM_RANGLE)) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && pipe == 0 && at_symbol(toks: toks, i: i, code: SYM_COMMA) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Primary expressions: literals and bracketed literals.
fn emit_primary(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    if end - start == 1 {
        let k = tk_kind(toks: toks, i: start)
        let t = tk_text(toks, i: start)
        if k == TOK_NUMBER {
            emit_at(out: mut out, depth: d, s: String.concat(left: "number ", right: escape(s: t)), toks, i: start)
            return Unit
        }
        if k == TOK_STRING {
            emit_at(out: mut out, depth: d, s: String.concat(left: "string ", right: escape(s: t)), toks, i: start)
            return Unit
        }
        if k == TOK_CHAR {
            emit_at(out: mut out, depth: d, s: String.concat(left: "char ", right: escape(s: t)), toks, i: start)
            return Unit
        }
        if k == TOK_MULTILINE {
            emit_at(out: mut out, depth: d, s: String.concat(left: "multiline ", right: escape(s: t)), toks, i: start)
            return Unit
        }
        if k == TOK_INTERP {
            emit_interp(out: mut out, text: t, d, toks, tokIdx: start)
            return Unit
        }
        // Ident or keyword-as-ident (true/false/etc lex as ident).
        emit_at(out: mut out, depth: d, s: String.concat(left: "ident ", right: escape(s: t)), toks, i: start)
        return Unit
    }
    // Array literal: [ items ].
    if at_symbol(toks: toks, i: start, code: SYM_LBRACKET) && at_symbol(toks: toks, i: (end - 1), code: SYM_RBRACKET) {
        let close = find_matching(toks: toks, open: start, openSym: SYM_LBRACKET, closeSym: SYM_RBRACKET)
        if close == end - 1 {
            emit_at(out: mut out, depth: d, s: "array", toks, i: start)
            let mut i = start + 1
            while i < end - 1 {
                let comma = split_comma(toks, start: i, end: (end - 1))
                let itemEnd = pick_end(comma, end: (end - 1))
                emit_expr(out: mut out, toks, start: i, end: itemEnd, d: (d + 1))
                if comma < 0 { i = end - 1 } else { i = comma + 1 }
            }
            return Unit
        }
    }
    // Object / map literal: { fields } or { k => v, ... }.
    if at_symbol(toks: toks, i: start, code: SYM_LBRACE) && at_symbol(toks: toks, i: (end - 1), code: SYM_RBRACE) {
        let close = find_matching(toks: toks, open: start, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if close == end - 1 {
            emit_object_or_map(out: mut out, toks, start, close, d)
            return Unit
        }
    }
    emit_at(out: mut out, depth: d, s: "unknown-expr", toks, i: start)
    return Unit
}

// Interpolated string `"...{expr}..."` desugars to
// String.format(template: read "<{}-collapsed>", args: read [<exprs>]).
// Mirrors parse_interpolated_string_parts. The only unreproducible case is a
// syntactically-invalid embedded expr (emit_expr can't signal parse failure), so
// `malformed` is set only for an unterminated `{` — a documented residual.
fn emit_interp(out: mut StringBuilder, text: String, d: Int, toks: List<Tok>, tokIdx: Int) -> Unit {
    local tmpl = StringBuilder.new()
    local items = List.new()
    let mut malformed = false
    let cs = String.chars(value: text)
    let n = List.len(list: cs)
    let mut i = 0
    while i < n {
        let c = code_at(chars: cs, n: n, i: i)
        if c == 92 {
            // backslash: copy it and the next char verbatim (escaped later).
            StringBuilder.push(builder: mut tmpl, value: Char.to_string(value: List.get(list: cs, index: i)))
            i = i + 1
            if i < n {
                StringBuilder.push(builder: mut tmpl, value: Char.to_string(value: List.get(list: cs, index: i)))
                i = i + 1
            }
        } else if c == 123 && code_at(chars: cs, n: n, i: (i + 1)) == 123 {
            StringBuilder.push(builder: mut tmpl, value: "{{"); i = i + 2
        } else if c == 125 && code_at(chars: cs, n: n, i: (i + 1)) == 125 {
            StringBuilder.push(builder: mut tmpl, value: "}}"); i = i + 2
        } else if c == 123 {
            let close = interp_end(cs, n, start: (i + 1))
            if close < 0 {
                malformed = true
                StringBuilder.push(builder: mut tmpl, value: "{")
                i = i + 1
            } else {
                StringBuilder.push(builder: mut tmpl, value: "{}")
                List.push(list: mut items, value: slice(chars: cs, from: (i + 1), to: close))
                i = close + 1
            }
        } else if c == 125 {
            StringBuilder.push(builder: mut tmpl, value: "}}"); i = i + 1
        } else {
            StringBuilder.push(builder: mut tmpl, value: Char.to_string(value: List.get(list: cs, index: i)))
            i = i + 1
        }
    }
    let template = StringBuilder.finish(builder: take tmpl)
    let mut suffix = ""
    if malformed { suffix = " malformed=true" }
    emit_at(out: mut out, depth: d, s: "call", toks, i: tokIdx)
    emit(out: mut out, depth: (d + 1), s: "callee-qualified namespace=String name=format")
    emit(out: mut out, depth: (d + 1), s: String.concat(left: "arg name=template", right: suffix))
    emit_at(out: mut out, depth: (d + 2), s: "effect kind=read", toks, i: tokIdx)
    emit_at(out: mut out, depth: (d + 3), s: String.concat(left: "string ", right: escape(s: template)), toks, i: tokIdx)
    emit(out: mut out, depth: (d + 1), s: String.concat(left: "arg name=args", right: suffix))
    emit_at(out: mut out, depth: (d + 2), s: "effect kind=read", toks, i: tokIdx)
    emit_at(out: mut out, depth: (d + 3), s: "array", toks, i: tokIdx)
    let m = List.len(list: items)
    let mut j = 0
    while j < m {
        let subToks = tokenize(source: List.get(list: items, index: j))
        let stop = first_eof(toks: subToks)
        emit_expr(out: mut out, toks: subToks, start: 0, end: stop, d: (d + 4))
        j = j + 1
    }
    return Unit
}

// Matching top-level `}` for an interpolation opening at `start`, or -1. Mirrors
// find_interpolation_end (skips string literals; `([{` nest, `)]` and `}` close).
fn interp_end(cs: List<Char>, n: Int, start: Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < n {
        let c = code_at(chars: cs, n: n, i: i)
        if c == 34 {
            i = i + 1
            let mut inStr = true
            while i < n && inStr {
                let sc = code_at(chars: cs, n: n, i: i)
                if sc == 92 { i = i + 2 }
                else if sc == 34 { i = i + 1; inStr = false }
                else { i = i + 1 }
            }
        } else if c == 40 || c == 91 || c == 123 {
            depth = depth + 1; i = i + 1
        } else if c == 41 || c == 93 {
            if depth > 0 { depth = depth - 1 }
            i = i + 1
        } else if c == 125 {
            if depth == 0 { return i }
            depth = depth - 1; i = i + 1
        } else {
            i = i + 1
        }
    }
    return -1
}

// Index of the first TOK_EOF in a freshly tokenized list (its logical end).
fn first_eof(toks: List<Tok>) -> Int {
    let m = List.len(list: toks)
    let mut i = 0
    while i < m {
        if tk_kind(toks: toks, i: i) == TOK_EOF { return i }
        i = i + 1
    }
    return m
}

// `{ "field": v, ... }` (object) or `{ k => v, ... }` (map). A top-level `=>` in
// any entry makes it a map; otherwise an object (empty `{}` is an object).
fn emit_object_or_map(out: mut StringBuilder, toks: List<Tok>, start: Int, close: Int, d: Int) -> Unit {
    // Decide map vs object.
    let mut isMap = false
    let mut i = start + 1
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let entEnd = pick_end(comma, end: close)
        if find_top_sym(toks, start: i, end: entEnd, code: SYM_FATARROW) >= 0 {
            isMap = true
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    if isMap {
        emit_at(out: mut out, depth: d, s: "map", toks, i: start)
        let mut k = start + 1
        while k < close {
            let comma = split_comma(toks, start: k, end: close)
            let entEnd = pick_end(comma, end: close)
            let arrow = find_top_sym(toks, start: k, end: entEnd, code: SYM_FATARROW)
            emit(out: mut out, depth: (d + 1), s: "map-entry")
            emit(out: mut out, depth: (d + 2), s: "key")
            emit_expr(out: mut out, toks, start: k, end: arrow, d: (d + 3))
            emit(out: mut out, depth: (d + 2), s: "value")
            emit_expr(out: mut out, toks, start: (arrow + 1), end: entEnd, d: (d + 3))
            if comma < 0 { k = close } else { k = comma + 1 }
        }
        return Unit
    }
    emit_at(out: mut out, depth: d, s: "object", toks, i: start)
    let mut k = start + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let entEnd = pick_end(comma, end: close)
        let colon = find_top_sym(toks, start: k, end: entEnd, code: SYM_COLON)
        if colon >= 0 {
            let nm = tk_text(toks, i: k)
            emit(out: mut out, depth: (d + 1), s: String.concat(left: "object-field name=", right: nm))
            emit_expr(out: mut out, toks, start: (colon + 1), end: entEnd, d: (d + 2))
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Type references (subset: [fresh] Name [< args >]).
// emit_type_ref renders one type starting at token i and returns the next index.
// -------------------------------------------------------------------------

// True if token j is a type-level prefix keyword skipped when locating the name
// (read/mut/take effects + fresh/handle/weak/noescape/owned), matching name_index
// in parse_type_ref.
fn is_type_prefix(toks: List<Tok>, j: Int) -> Bool {
    return is_kw_text(toks, i: j, word: "read") || is_kw_text(toks, i: j, word: "mut") || is_kw_text(toks, i: j, word: "take") || is_kw_text(toks, i: j, word: "fresh") || is_kw_text(toks, i: j, word: "handle") || is_kw_text(toks, i: j, word: "weak") || is_kw_text(toks, i: j, word: "noescape") || is_kw_text(toks, i: j, word: "owned")
}

// Count non-empty comma-separated segments in [start, end) (tuple/generic arity).
fn count_type_args(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut cnt = 0
    let mut k = start
    while k < end {
        let comma = split_comma(toks, start: k, end)
        let mut segEnd = end
        if comma >= 0 { segEnd = comma }
        if k < segEnd { cnt = cnt + 1 }
        if comma < 0 { k = end } else { k = comma + 1 }
    }
    return cnt
}

// Tokens that end a type ref (used to bound the name search).
fn is_type_terminator(toks: List<Tok>, j: Int) -> Bool {
    return tk_kind(toks: toks, i: j) == TOK_EOF || at_symbol(toks: toks, i: j, code: SYM_COMMA) || at_symbol(toks: toks, i: j, code: SYM_RPAREN) || at_symbol(toks: toks, i: j, code: SYM_RANGLE) || at_symbol(toks: toks, i: j, code: SYM_RBRACE) || at_symbol(toks: toks, i: j, code: SYM_LBRACE) || at_symbol(toks: toks, i: j, code: SYM_SEMI) || at_symbol(toks: toks, i: j, code: SYM_EQ)
}

fn emit_type_ref(out: mut StringBuilder, toks: List<Tok>, i: Int, tag: String, eff: String, d: Int) -> Int {
    // Prefix flags reflect ONLY the token at `i` (matching parse_type_ref, which
    // reads is_fresh/is_noescape/is_owned from tokens[start]).
    let mut isFresh = false
    let mut isNoescape = false
    let mut isOwned = false
    if at_ident(toks: toks, i: i, wid: WORD_FRESH) { isFresh = true }
    else if is_kw_text(toks, i, word: "noescape") { isNoescape = true }
    else if is_kw_text(toks, i, word: "owned") { isOwned = true }
    // Tuple type `(A, B, …)` (≥2 elements) → __TupleN with the elements as args
    // (parse_tuple_type_ref, tried before the named path; fresh/noescape/owned=false).
    let mut ps = i
    while is_type_prefix(toks, j: ps) { ps = ps + 1 }
    if at_symbol(toks: toks, i: ps, code: SYM_LPAREN) {
        let tclose = find_matching(toks: toks, open: ps, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if tclose > ps && count_type_args(toks, start: (ps + 1), end: tclose) >= 2 {
            local tb = StringBuilder.new()
            StringBuilder.push(builder: mut tb, value: tag)
            if String.len(value: eff) > 0 {
                StringBuilder.push(builder: mut tb, value: " effect=")
                StringBuilder.push(builder: mut tb, value: eff)
            }
            StringBuilder.push(builder: mut tb, value: " name=__Tuple")
            StringBuilder.push(builder: mut tb, value: String.from_int(value: count_type_args(toks, start: (ps + 1), end: tclose)))
            StringBuilder.push(builder: mut tb, value: " fresh=false noescape=false owned=false")
            emit_at(out: mut out, depth: d, s: StringBuilder.finish(builder: take tb), toks, i)
            let mut tk = ps + 1
            while tk < tclose {
                let comma = split_comma(toks, start: tk, end: tclose)
                let mut segEnd = tclose
                if comma >= 0 { segEnd = comma }
                if tk < segEnd {
                    emit_type_ref(out: mut out, toks, i: tk, tag: "arg", eff: "", d: (d + 1))
                }
                if comma < 0 { tk = tclose } else { tk = comma + 1 }
            }
            return tclose + 1
        }
    }
    // Name is the first non-prefix IDENT (parse_type_ref's name_index skips both
    // prefix keywords AND non-ident tokens like a leading `&`), bounded by a type
    // terminator so a malformed type never scans away.
    let mut j = i
    let mut scanning = true
    while scanning {
        if is_ident_tok(toks: toks, i: j) && is_type_prefix(toks, j) == false {
            scanning = false
        } else if is_type_terminator(toks, j) {
            scanning = false
        } else {
            j = j + 1
        }
    }
    let nameIdx = j
    let name = tk_text(toks, i: j)
    j = j + 1
    local sb = StringBuilder.new()
    StringBuilder.push(builder: mut sb, value: tag)
    if String.len(value: eff) > 0 {
        StringBuilder.push(builder: mut sb, value: " effect=")
        StringBuilder.push(builder: mut sb, value: eff)
    }
    StringBuilder.push(builder: mut sb, value: " name=")
    StringBuilder.push(builder: mut sb, value: name)
    StringBuilder.push(builder: mut sb, value: " fresh=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: isFresh))
    StringBuilder.push(builder: mut sb, value: " noescape=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: isNoescape))
    StringBuilder.push(builder: mut sb, value: " owned=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: isOwned))
    emit_at(out: mut out, depth: d, s: StringBuilder.finish(builder: take sb), toks, i: nameIdx)
    // Generic args `<...>`.
    if at_symbol(toks: toks, i: j, code: SYM_LANGLE) {
        let close = find_matching(toks: toks, open: j, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if close > j {
            let mut k = j + 1
            while k < close {
                let comma = split_comma(toks, start: k, end: close)
                let mut segEnd = close
                if comma >= 0 { segEnd = comma }
                // Empty arg segments (`Map<, String>`, `Result<String,, E>`) are
                // malformed_arg_spans in the reference — dropped, not dumped.
                if k < segEnd {
                    emit_type_ref(out: mut out, toks, i: k, tag: "arg", eff: "", d: (d + 1))
                }
                if comma < 0 { k = close } else { k = comma + 1 }
            }
            j = close + 1
        }
    }
    // Fn types: `Fn(<params>) -> <ret>` → fn-param (with optional effect) + fn-return.
    if name == "Fn" && at_symbol(toks: toks, i: j, code: SYM_LPAREN) {
        let pclose = find_matching(toks: toks, open: j, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        let mut k = j + 1
        while k < pclose {
            let comma = split_comma(toks, start: k, end: pclose)
            let pEff = effect_kw(toks, i: k)
            let mut pStart = k
            if String.len(value: pEff) > 0 { pStart = k + 1 }
            emit_type_ref(out: mut out, toks, i: pStart, tag: "fn-param", eff: pEff, d: (d + 1))
            if comma < 0 { k = pclose } else { k = comma + 1 }
        }
        j = pclose + 1
        if at_symbol(toks: toks, i: j, code: SYM_ARROW) {
            j = emit_type_ref(out: mut out, toks, i: (j + 1), tag: "fn-return", eff: "", d: (d + 1))
        }
    }
    return j
}

// -------------------------------------------------------------------------
// Statements. emit_stmt renders one statement in [start, limit) and returns the
// index of the next statement (statement_end semantics from scan.rss's line model).
// -------------------------------------------------------------------------

// Statement end: first token on a strictly-later line at bracket depth 0 (simple
// line model; operator-continuation and postfix chains are a documented gap).
// Statement boundary, mirroring parser/scan.rs statement_end. A statement ends at
// the first token on a strictly-later line at bracket+angle depth 0, EXCEPT: a
// top-level `;` terminates immediately; a line starting with `.`/`?` (postfix) or
// with/after a continuation operator (`| & + * / % ^`) continues the statement.
fn stmt_end(toks: List<Tok>, start: Int, limit: Int) -> Int {
    let mut line = tk_line(toks: toks, i: start)
    let mut depth = 0
    let mut angle = 0
    let mut postfixLine = -1
    let mut i = start + 1
    while i < limit {
        if depth == 0 && angle == 0 && at_symbol(toks: toks, i: i, code: SYM_SEMI) {
            return i
        }
        if depth == 0 && angle == 0 && tk_line(toks: toks, i: i) > line {
            if postfixLine == tk_line(toks: toks, i: i) {
                // still on a postfix-continuation line — keep scanning.
            } else if is_stmt_postfix(toks, i) {
                postfixLine = tk_line(toks: toks, i: i)
            } else if is_cont_op(toks, i) || is_cont_op(toks, i: (i - 1)) {
                line = tk_line(toks: toks, i: i)
            } else if is_kw_text(toks, i, word: "else") && at_symbol(toks: toks, i: (i - 1), code: SYM_RBRACE) {
                // An `else` following a branch body continues an if expression;
                // it cannot begin an independent statement.
                line = tk_line(toks: toks, i: i)
            } else {
                return i
            }
        }
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_LANGLE) && is_generic_angle(toks, start, end: limit, open: i) {
            angle = angle + 1
        } else if depth == 0 && angle > 0 && at_symbol(toks: toks, i: i, code: SYM_RANGLE) {
            angle = angle - 1
        }
        i = i + 1
    }
    return limit
}

fn is_stmt_postfix(toks: List<Tok>, i: Int) -> Bool {
    return at_symbol(toks: toks, i: i, code: SYM_QUESTION) || at_symbol(toks: toks, i: i, code: SYM_DOT)
}

// Continuation operators (SH-017): `| & + * / % ^` — a statement-level expression
// wraps across a newline when a line begins with, or ends before, one of these.
// `< > - = !` are deliberately excluded (see scan.rs).
fn is_cont_op(toks: List<Tok>, i: Int) -> Bool {
    return at_symbol(toks: toks, i: i, code: SYM_PIPE) || at_symbol(toks: toks, i: i, code: SYM_AMP) || at_symbol(toks: toks, i: i, code: SYM_PLUS) || at_symbol(toks: toks, i: i, code: SYM_STAR) || at_symbol(toks: toks, i: i, code: SYM_SLASH) || at_symbol(toks: toks, i: i, code: SYM_PERCENT) || at_symbol(toks: toks, i: i, code: SYM_CARET)
}

// First top-level standalone `=` (assignment, not == != <= >=) in [start, end), or -1.
// First `=` symbol token in [start, end), or -1 (used for let value split;
// `=>` is a distinct FatArrow token, not matched).
fn first_eq(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_EQ) { return i }
        i = i + 1
    }
    return -1
}

fn top_assign(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_EQ) {
            let prevJoin = i > start && (at_symbol(toks: toks, i: (i - 1), code: SYM_EQ) || at_symbol(toks: toks, i: (i - 1), code: SYM_BANG) || at_symbol(toks: toks, i: (i - 1), code: SYM_LANGLE) || at_symbol(toks: toks, i: (i - 1), code: SYM_RANGLE))
            let nextJoin = at_symbol(toks: toks, i: (i + 1), code: SYM_EQ)
            if !prevJoin  && !nextJoin  {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn emit_stmt(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    // return [value]
    if is_kw_text(toks, i: start, word: "return") {
        let e = stmt_end(toks, start, limit)
        emit_at(out: mut out, depth: d, s: "return", toks, i: start)
        if start + 1 < e {
            emit(out: mut out, depth: (d + 1), s: "value")
            emit_expr(out: mut out, toks, start: (start + 1), end: e, d: (d + 2))
        }
        return e
    }
    // if cond { then } [else { ... }]
    if is_kw_text(toks, i: start, word: "if") {
        return emit_if(out: mut out, toks, start, limit, d)
    }
    // while/loop [cond] { body }
    if is_kw_text(toks, i: start, word: "while") || is_kw_text(toks, i: start, word: "loop") {
        return emit_loop(out: mut out, toks, start, limit, d)
    }
    // match [effect] value { arms }
    if is_kw_text(toks, i: start, word: "match") {
        let openb = find_block_open(toks, start: (start + 1), limit)
        if openb < 0 {
            emit_at(out: mut out, depth: d, s: "malformed-match", toks, i: start)
            return stmt_end(toks, start, limit)
        }
        let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        // Empty scrutinee (`match {`) → malformed-match (parse_match_stmt's
        // parse_expr over the value region fails).
        let meff = effect_kw(toks, i: (start + 1))
        let mut vstart = start + 1
        if String.len(value: meff) > 0 { vstart = start + 2 }
        if vstart >= openb {
            emit_at(out: mut out, depth: d, s: "malformed-match", toks, i: start)
            return close + 1
        }
        emit_match(out: mut out, toks, matchPos: start, braceOpen: openb, braceClose: close, tag: "match", d)
        return close + 1
    }
    // for binding in iterable { body }  (and `await for ...`)
    if is_kw_text(toks, i: start, word: "for") {
        return emit_for(out: mut out, toks, forPos: start, limit, d, isAsync: false)
    }
    if is_kw_text(toks, i: start, word: "await") && is_kw_text(toks, i: (start + 1), word: "for") {
        return emit_for(out: mut out, toks, forPos: (start + 1), limit, d, isAsync: true)
    }
    // with <resource> as <binding> { body }
    if is_kw_text(toks, i: start, word: "with") {
        return emit_with(out: mut out, toks, start, limit, d)
    }
    // task_group { body }
    if is_kw_text(toks, i: start, word: "task_group") {
        return emit_task_group(out: mut out, toks, start, limit, d)
    }
    // select { arms }
    if is_kw_text(toks, i: start, word: "select") {
        return emit_select(out: mut out, toks, start, limit, d)
    }
    // break / continue
    if is_kw_text(toks, i: start, word: "break") {
        emit_at(out: mut out, depth: d, s: "break", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    if is_kw_text(toks, i: start, word: "continue") {
        emit_at(out: mut out, depth: d, s: "continue", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    // async let name = value  (managed, no annotation, async=true)
    if is_kw_text(toks, i: start, word: "async") && is_kw_text(toks, i: (start + 1), word: "let") {
        let e = stmt_end(toks, start, limit)
        let name = tk_text(toks, i: (start + 2))
        emit_at(out: mut out, depth: d, s: String.concat(left: String.concat(left: "let kind=managed name=", right: name), right: " mut=false async=true"), toks, i: start)
        let asg = first_eq(toks, start: (start + 3), end: e)
        if asg >= 0 {
            emit(out: mut out, depth: (d + 1), s: "value")
            emit_expr(out: mut out, toks, start: (asg + 1), end: e, d: (d + 2))
        }
        return e
    }
    // let / local [mut] name [: type] = value
    if is_kw_text(toks, i: start, word: "let") || is_kw_text(toks, i: start, word: "local") {
        // `let Some(x) = expr else { … }` is a distinct let-else statement.
        let leEnd = try_emit_let_else(out: mut out, toks, start, limit, d)
        if leEnd >= 0 { return leEnd }
        return emit_let(out: mut out, toks, start, limit, d)
    }
    // Assignment or expression statement.
    let e = stmt_end(toks, start, limit)
    let asg = top_assign(toks, start, end: e)
    if asg >= 0 {
        emit_at(out: mut out, depth: d, s: "assign", toks, i: start)
        emit(out: mut out, depth: (d + 1), s: "target")
        emit_expr(out: mut out, toks, start, end: asg, d: (d + 2))
        emit(out: mut out, depth: (d + 1), s: "value")
        emit_expr(out: mut out, toks, start: (asg + 1), end: e, d: (d + 2))
        return e
    }
    emit_at(out: mut out, depth: d, s: "expr-stmt", toks, i: expr_rep_tok(toks, start, end: e))
    emit_expr(out: mut out, toks, start, end: e, d: (d + 1))
    return e
}

// Token i is a keyword/ident with the exact text `word`.
fn is_kw_text(toks: List<Tok>, i: Int, word: String) -> Bool {
    if is_ident_tok(toks: toks, i: i) == false { return false }
    return tk_text(toks, i) == word
}

// True if token i is a let-else variant head (Some/Ok/None/Err).
fn is_let_else_variant(toks: List<Tok>, i: Int) -> Bool {
    if is_ident_tok(toks: toks, i: i) == false { return false }
    let t = tk_text(toks, i)
    return t == "Some" || t == "Ok" || t == "None" || t == "Err"
}

// `let (a, _, c) = expr` tuple destructure (mirrors parse_let_tuple_stmt).
fn emit_let_tuple(out: mut StringBuilder, toks: List<Tok>, start: Int, nameIdx: Int, kind: String, limit: Int, d: Int) -> Int {
    let e = stmt_end(toks, start, limit)
    let close = find_matching(toks: toks, open: nameIdx, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    // Collect element names; each element must be a single token (ident/`_`), ≥2.
    local nb = StringBuilder.new()
    let mut count = 0
    let mut namesOk = true
    let mut k = nameIdx + 1
    if close < 0 { namesOk = false }
    while close >= 0 && k < close {
        let comma = split_comma(toks, start: k, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        if k < segEnd {
            if (k + 1) != segEnd { namesOk = false }
            if count > 0 { StringBuilder.push(builder: mut nb, value: ",") }
            StringBuilder.push(builder: mut nb, value: tk_text(toks, i: k))
            count = count + 1
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    if count < 2 { namesOk = false }
    let names = StringBuilder.finish(builder: take nb)
    let mut eqPos = -1
    if close >= 0 { eqPos = first_eq(toks, start: (close + 1), end: e) }
    let hasValue = eqPos >= 0 && (eqPos + 1) < e
    let malformed = !namesOk || !hasValue
    local sb = StringBuilder.new()
    StringBuilder.push(builder: mut sb, value: String.concat(left: "let kind=", right: kind))
    StringBuilder.push(builder: mut sb, value: " name= mut=false async=false")
    if malformed { StringBuilder.push(builder: mut sb, value: " malformed=true") }
    if namesOk { StringBuilder.push(builder: mut sb, value: String.concat(left: " destructure=", right: names)) }
    emit_at(out: mut out, depth: d, s: StringBuilder.finish(builder: take sb), toks, i: start)
    if hasValue {
        emit(out: mut out, depth: (d + 1), s: "value")
        emit_expr(out: mut out, toks, start: (eqPos + 1), end: e, d: (d + 2))
    }
    return e
}

// `let Some(x) = expr else { … }` (mirrors try_parse_let_else). Emits the let-else
// node and returns the next index, or -1 if this isn't a let-else.
fn try_emit_let_else(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let ps = start + 1
    if is_let_else_variant(toks, i: ps) == false { return -1 }
    let mut binding = ""
    let mut afterPat = ps + 1
    if at_symbol(toks: toks, i: (ps + 1), code: SYM_LPAREN) {
        let pclose = find_matching(toks: toks, open: (ps + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if pclose < 0 { return -1 }
        if is_ident_tok(toks: toks, i: (ps + 2)) { binding = tk_text(toks, i: (ps + 2)) }
        afterPat = pclose + 1
    }
    if at_symbol(toks: toks, i: afterPat, code: SYM_EQ) == false { return -1 }
    // Find `else` before a `{`.
    let mut elsePos = -1
    let mut i = afterPat + 1
    let mut scanning = true
    while scanning && i < limit {
        if is_kw_text(toks, i, word: "else") { elsePos = i; scanning = false }
        else if at_symbol(toks: toks, i: i, code: SYM_LBRACE) { scanning = false }
        else { i = i + 1 }
    }
    if elsePos < 0 { return -1 }
    let open = find_block_open(toks, start: (elsePos + 1), limit)
    if open < 0 { return -1 }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    emit_at(out: mut out, depth: d, s: String.concat(left: "let-else binding=", right: binding), toks, i: start)
    emit(out: mut out, depth: (d + 1), s: "pattern")
    emit(out: mut out, depth: (d + 2), s: String.concat(left: "pat-variant name=", right: tk_text(toks, i: ps)))
    if String.len(value: binding) > 0 {
        emit(out: mut out, depth: (d + 3), s: String.concat(left: "pat-binding name=", right: binding))
    }
    emit(out: mut out, depth: (d + 1), s: "value")
    emit_expr(out: mut out, toks, start: (afterPat + 1), end: elsePos, d: (d + 2))
    emit(out: mut out, depth: (d + 1), s: "else")
    // try_parse_let_else calls parse_block(open + 1, close) — an off-by-one that
    // treats the first body token as the brace; replicate it for byte-parity.
    emit_block(out: mut out, toks, open: (open + 1), close, d: (d + 2))
    return close + 1
}

fn emit_let(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let e = stmt_end(toks, start, limit)
    let mut kind = "managed"
    if is_kw_text(toks, i: start, word: "local") { kind = "local" }
    let mut j = start + 1
    let mut isMut = false
    if kind == "managed" && is_kw_text(toks, i: j, word: "mut") {
        isMut = true
        j = j + 1
    }
    // `let (a, _, c) = expr` destructures a tuple (parse_let_tuple_stmt): name is
    // empty, mut/async false, and a destructure=<names> attribute.
    if at_symbol(toks: toks, i: j, code: SYM_LPAREN) {
        return emit_let_tuple(out: mut out, toks, start, nameIdx: j, kind, limit, d)
    }
    let name = tk_text(toks, i: j)
    j = j + 1
    let a = String.concat(left: "let kind=", right: kind)
    let b = String.concat(left: a, right: " name=")
    let c = String.concat(left: b, right: name)
    // Value split is the FIRST `=` after the name (matching parse_let_stmt): a
    // let's name/annotation never contains `=`, so no `>=`/`==` guard is needed —
    // and top_assign's guard would wrongly skip the `=` after a generic `>`
    // (`let x: Option<Int> = …`).
    let asg = first_eq(toks, start: j, end: e)
    let hasColon = at_symbol(toks: toks, i: j, code: SYM_COLON)
    let mut typeEnd = e
    if asg >= 0 { typeEnd = asg }
    // malformed=true when `=` is present with no value expression, or `:` with no
    // type (parse_let_stmt: equals.is_some && value.is_none, or the colon analog).
    let emptyVal = asg >= 0 && (asg + 1) >= e
    let emptyType = hasColon && (j + 1) >= typeEnd
    let malformed = emptyVal || emptyType
    let f = String.concat(left: c, right: " mut=")
    let g = String.concat(left: f, right: boolstr(b: isMut))
    let mut h = String.concat(left: g, right: " async=false")
    if malformed { h = String.concat(left: h, right: " malformed=true") }
    emit_at(out: mut out, depth: d, s: h, toks, i: start)
    if hasColon && !emptyType  {
        emit_type_ref(out: mut out, toks, i: (j + 1), tag: "type", eff: "", d: (d + 1))
    }
    // Value.
    if asg >= 0 && !emptyVal  {
        emit(out: mut out, depth: (d + 1), s: "value")
        emit_expr(out: mut out, toks, start: (asg + 1), end: e, d: (d + 2))
    }
    return e
}

// `if let PATTERN = value { then } [else …]` → two-arm match (parse_if_let_stmt).
fn emit_if_let(out: mut StringBuilder, toks: List<Tok>, start: Int, openb: Int, close: Int, limit: Int, d: Int) -> Int {
    let equals = find_top_sym(toks, start: (start + 2), end: openb, code: SYM_EQ)
    if equals < 0 {
        emit_at(out: mut out, depth: d, s: "malformed-if", toks, i: start)
        return close + 1
    }
    emit_at(out: mut out, depth: d, s: "match", toks, i: start)
    emit(out: mut out, depth: (d + 1), s: "value")
    emit_expr(out: mut out, toks, start: (equals + 1), end: openb, d: (d + 2))
    // Arm 1: the pattern with the then-block. (parse_if_let_stmt spans both arms at
    // the `if` token.)
    emit_at(out: mut out, depth: (d + 1), s: "arm", toks, i: start)
    emit(out: mut out, depth: (d + 2), s: "pattern")
    emit_pattern(out: mut out, toks, start: (start + 2), end: equals, d: (d + 3))
    emit_block(out: mut out, toks, open: openb, close, d: (d + 2))
    // Arm 2: wildcard with the else-block (empty when there is no else).
    emit_at(out: mut out, depth: (d + 1), s: "arm", toks, i: start)
    emit(out: mut out, depth: (d + 2), s: "pattern")
    emit(out: mut out, depth: (d + 3), s: "pat-wildcard")
    let nx = close + 1
    if is_kw_text(toks, i: nx, word: "else") && at_symbol(toks: toks, i: (nx + 1), code: SYM_LBRACE) {
        let eopen = nx + 1
        let eclose = find_matching(toks: toks, open: eopen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        emit_block(out: mut out, toks, open: eopen, close: eclose, d: (d + 2))
        return eclose + 1
    }
    if is_kw_text(toks, i: nx, word: "else") && is_kw_text(toks, i: (nx + 1), word: "if") {
        // else-if: the else body is a block wrapping the nested if statement.
        emit(out: mut out, depth: (d + 2), s: "block")
        return emit_stmt(out: mut out, toks, start: (nx + 1), limit, d: (d + 3))
    }
    // No else → empty else block.
    emit(out: mut out, depth: (d + 2), s: "block")
    return nx
}

fn emit_if(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    // Find the `{` opening the then-block at top level.
    let openb = find_block_open(toks, start: (start + 1), limit)
    if openb < 0 { emit_at(out: mut out, depth: d, s: "malformed-if", toks, i: start); return stmt_end(toks, start, limit) }
    let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    // `if let PATTERN = value { … } else { … }` desugars to a two-arm match
    // (pattern arm + wildcard else arm), mirroring parse_if_let_stmt.
    if is_kw_text(toks, i: (start + 1), word: "let") {
        return emit_if_let(out: mut out, toks, start, openb, close, limit, d)
    }
    // Pre-check the else clause: `else` must be followed by `{` or `if`; anything
    // else (`else return …`) makes the whole statement malformed-if
    // (parse_if_stmt returns MalformedIf before building the If).
    let nx = close + 1
    if is_kw_text(toks, i: nx, word: "else") && is_kw_text(toks, i: (nx + 1), word: "if") == false && at_symbol(toks: toks, i: (nx + 1), code: SYM_LBRACE) == false {
        emit_at(out: mut out, depth: d, s: "malformed-if", toks, i: start)
        return stmt_end(toks, start: nx, limit)
    }
    emit_at(out: mut out, depth: d, s: "if", toks, i: start)
    emit(out: mut out, depth: (d + 1), s: "cond")
    emit_expr(out: mut out, toks, start: (start + 1), end: openb, d: (d + 2))
    emit(out: mut out, depth: (d + 1), s: "then")
    emit_block(out: mut out, toks, open: openb, close, d: (d + 2))
    // else?
    let mut next = close + 1
    if is_kw_text(toks, i: next, word: "else") {
        if is_kw_text(toks, i: (next + 1), word: "if") {
            emit(out: mut out, depth: (d + 1), s: "else")
            emit(out: mut out, depth: (d + 2), s: "block")
            let r = emit_if(out: mut out, toks, start: (next + 1), limit, d: (d + 3))
            return r
        }
        let eopen = find_block_open(toks, start: (next + 1), limit)
        if eopen >= 0 {
            let eclose = find_matching(toks: toks, open: eopen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            emit(out: mut out, depth: (d + 1), s: "else")
            emit_block(out: mut out, toks, open: eopen, close: eclose, d: (d + 2))
            return eclose + 1
        }
    }
    return next
}

fn emit_for(out: mut StringBuilder, toks: List<Tok>, forPos: Int, limit: Int, d: Int, isAsync: Bool) -> Int {
    let openb = find_block_open(toks, start: forPos, limit)
    if openb < 0 {
        emit_at(out: mut out, depth: d, s: "malformed-for", toks, i: forPos)
        return stmt_end(toks, start: forPos, limit)
    }
    let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    let binding = tk_text(toks, i: (forPos + 1))
    let a = String.concat(left: "for binding=", right: binding)
    let b = String.concat(left: a, right: " async=")
    emit_at(out: mut out, depth: d, s: String.concat(left: b, right: boolstr(b: isAsync)), toks, i: forPos)
    emit(out: mut out, depth: (d + 1), s: "iter")
    emit_expr(out: mut out, toks, start: (forPos + 3), end: openb, d: (d + 2))
    emit_block(out: mut out, toks, open: openb, close, d: (d + 1))
    return close + 1
}

// with <resource> as <binding> { body }. Mirrors parse_with_stmt: the FIRST `as`
// (not depth-aware) splits resource from binding; `as` must be immediately before
// the body brace.
fn emit_with(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let mut asIdx = -1
    let mut i = start + 1
    while i < limit && asIdx < 0 {
        if is_kw_text(toks, i, word: "as") { asIdx = i }
        i = i + 1
    }
    if asIdx < 0 {
        emit_at(out: mut out, depth: d, s: "malformed-with", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    let open = find_block_open(toks, start: (asIdx + 1), limit)
    if open < 0 {
        emit_at(out: mut out, depth: d, s: "malformed-with", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    // The binding after `as` must be an ident immediately before the block `{`
    // (`as {` with no binding is malformed) — mirrors parse_with_stmt.
    if is_ident_tok(toks: toks, i: (asIdx + 1)) == false || (asIdx + 2) != open {
        emit_at(out: mut out, depth: d, s: "malformed-with", toks, i: start)
        return close + 1
    }
    let binding = tk_text(toks, i: (asIdx + 1))
    emit_at(out: mut out, depth: d, s: String.concat(left: "with binding=", right: binding), toks, i: start)
    emit(out: mut out, depth: (d + 1), s: "resource")
    emit_expr(out: mut out, toks, start: (start + 1), end: asIdx, d: (d + 2))
    emit_block(out: mut out, toks, open, close, d: (d + 1))
    return close + 1
}

// task_group { body }
fn emit_task_group(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let open = start + 1
    if at_symbol(toks: toks, i: open, code: SYM_LBRACE) == false {
        emit_at(out: mut out, depth: d, s: "unknown-stmt", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    emit_at(out: mut out, depth: d, s: "task-group", toks, i: start)
    emit_block(out: mut out, toks, open, close, d: (d + 1))
    return close + 1
}

// select { <binding> = <operation> => { body } ... }
fn emit_select(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let open = start + 1
    if at_symbol(toks: toks, i: open, code: SYM_LBRACE) == false {
        emit_at(out: mut out, depth: d, s: "unknown-stmt", toks, i: start)
        return stmt_end(toks, start, limit)
    }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    emit_at(out: mut out, depth: d, s: "select", toks, i: start)
    emit_select_arms(out: mut out, toks, start: (open + 1), end: close, d: (d + 1))
    return close + 1
}

fn emit_select_arms(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_SEMI) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: toks, start: i, end: end)
            let arrow = find_top_sym(toks, start: i, end: lineEnd, code: SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let eq = find_top_sym(toks, start: i, end: arrow, code: SYM_EQ)
                if eq < 0 {
                    i = arrow + 1
                } else {
                    let mut binding = "_"
                    if is_ident_tok(toks: toks, i: i) { binding = tk_text(toks, i) }
                    emit(out: mut out, depth: d, s: String.concat(left: "select-arm binding=", right: binding))
                    emit(out: mut out, depth: (d + 1), s: "operation")
                    emit_expr(out: mut out, toks, start: (eq + 1), end: arrow, d: (d + 2))
                    let bodyStart = arrow + 1
                    if at_symbol(toks: toks, i: bodyStart, code: SYM_LBRACE) {
                        let bclose = find_matching(toks: toks, open: bodyStart, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                        emit_block(out: mut out, toks, open: bodyStart, close: bclose, d: (d + 1))
                        i = bclose + 1
                    } else {
                        let bEnd = next_line_or_block_end(toks: toks, start: bodyStart, end: end)
                        emit(out: mut out, depth: (d + 1), s: "block")
                        emit_stmt(out: mut out, toks, start: bodyStart, limit: bEnd, d: (d + 2))
                        if bEnd > i { i = bEnd } else { i = i + 1 }
                    }
                }
            }
        }
    }
    return Unit
}

fn emit_loop(out: mut StringBuilder, toks: List<Tok>, start: Int, limit: Int, d: Int) -> Int {
    let isWhile = is_kw_text(toks, i: start, word: "while")
    let openb = find_block_open(toks, start: (start + 1), limit)
    if openb < 0 { emit_at(out: mut out, depth: d, s: "malformed-loop", toks, i: start); return stmt_end(toks, start, limit) }
    let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    // Malformed (mirror parse_loop_stmt): `while` with no condition (`while {`), or
    // `loop` WITH tokens before `{` (`loop true {` — loop takes no condition).
    if isWhile {
        if (start + 1) >= openb { emit_at(out: mut out, depth: d, s: "malformed-loop", toks, i: start); return close + 1 }
    } else {
        if openb != (start + 1) { emit_at(out: mut out, depth: d, s: "malformed-loop", toks, i: start); return close + 1 }
    }
    emit_at(out: mut out, depth: d, s: "loop", toks, i: start)
    if isWhile && start + 1 < openb {
        emit(out: mut out, depth: (d + 1), s: "cond")
        emit_expr(out: mut out, toks, start: (start + 1), end: openb, d: (d + 2))
    }
    emit_block(out: mut out, toks, open: openb, close, d: (d + 1))
    return close + 1
}

// Index of the top-level `{` at or after `start` (before `limit`), or -1.
fn find_block_open(toks: List<Tok>, start: Int, limit: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < limit {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_LBRACE) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Emit a `block` node and its statements for the braces [open, close].
fn emit_block(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    emit(out: mut out, depth: d, s: "block")
    emit_stmts(out: mut out, toks, from: (open + 1), close, d: (d + 1))
    return Unit
}

// True if a scoped-view binding `view <ident> = …` begins at i (is_view_binding).
fn is_view_binding(toks: List<Tok>, i: Int, close: Int) -> Bool {
    return is_kw_text(toks, i, word: "view") && is_ident_tok(toks: toks, i: (i + 1)) && at_symbol(toks: toks, i: (i + 2), code: SYM_EQ) && (i + 2) < close
}

// Emit statements in [from, close) at depth d. A `view name = expr` desugars to a
// `with expr as name { <rest of block> }` that captures the remaining statements
// (collect_statements' scoped-view desugar).
fn emit_stmts(out: mut StringBuilder, toks: List<Tok>, from: Int, close: Int, d: Int) -> Unit {
    let mut i = from
    while i < close {
        if at_symbol(toks: toks, i: i, code: SYM_SEMI) {
            i = i + 1
        } else if is_view_binding(toks, i, close) {
            let name = tk_text(toks, i: (i + 1))
            let stEnd = stmt_end(toks, start: i, limit: close)
            let eqPos = first_eq(toks, start: (i + 2), end: stEnd)
            emit_at(out: mut out, depth: d, s: String.concat(left: "with binding=", right: name), toks, i)
            emit(out: mut out, depth: (d + 1), s: "resource")
            if eqPos >= 0 {
                emit_expr(out: mut out, toks, start: (eqPos + 1), end: stEnd, d: (d + 2))
            } else {
                emit_at(out: mut out, depth: (d + 2), s: "unknown-expr", toks, i)
            }
            emit(out: mut out, depth: (d + 1), s: "block")
            emit_stmts(out: mut out, toks, from: stEnd, close, d: (d + 2))
            i = close
        } else {
            let next = emit_stmt(out: mut out, toks, start: i, limit: close, d)
            if next > i { i = next } else { i = i + 1 }
        }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Items: functions (core), plus struct/sum/const shells.
// -------------------------------------------------------------------------

// The shared body AST is deliberately adopted in validated slices. A body is
// rendered from Program only when every node has an exact dump mapping below;
// all other bodies retain the legacy token renderer until their AST form and
// byte-exact oracle coverage are complete.
fn emit_ast_at(out: mut StringBuilder, depth: Int, s: String, line: Int, column: Int, length: Int) -> Unit {
    let a = String.concat(left: s, right: " @")
    let b = String.concat(left: a, right: String.from_int(value: line))
    let c = String.concat(left: b, right: ":")
    let d = String.concat(left: c, right: String.from_int(value: column))
    let e = String.concat(left: d, right: ":")
    emit(out: mut out, depth: depth, s: String.concat(left: e, right: String.from_int(value: length)))
    return Unit
}

fn ast_binary_name(operator: String) -> String {
    if operator == "||" { return "logical-or" }
    if operator == "&&" { return "logical-and" }
    if operator == "==" { return "equal" }
    if operator == "!=" { return "not-equal" }
    if operator == "<=" { return "less-equal" }
    if operator == ">=" { return "greater-equal" }
    if operator == "<" { return "less" }
    if operator == ">" { return "greater" }
    if operator == "+" { return "add" }
    if operator == "-" { return "subtract" }
    if operator == "*" { return "multiply" }
    if operator == "/" { return "divide" }
    if operator == "%" { return "modulo" }
    return ""
}

fn ast_expr_direct(program: Program, index: Int) -> Bool {
    if index < 0 || index >= List.len(list: program.expressions) { return false }
    let expression = List.get<Expr>(list: program.expressions, index: index)
    // The shared parser does not materialize if-expressions yet and currently
    // retains their leading keyword as a recovered name. Keep those bodies on
    // the exact legacy renderer until EXPR_IF exists.
    if expression.kind == EXPR_NAME {
        return expression.text != "if" && expression.text != "break" && expression.text != "continue"
    }
    if expression.kind == EXPR_LITERAL {
        return expression.tokenKind == TOK_NUMBER || expression.tokenKind == TOK_STRING || expression.tokenKind == TOK_CHAR || expression.tokenKind == TOK_MULTILINE || expression.tokenKind == TOK_IDENT
    }
    if expression.kind == EXPR_BINARY {
        if String.len(value: ast_binary_name(operator: expression.text)) == 0 || List.len(list: expression.children) != 2 { return false }
        let left = List.get<Int>(list: expression.children, index: 0)
        let right = List.get<Int>(list: expression.children, index: 1)
        return ast_expr_direct(program: program, index: left) && ast_expr_direct(program: program, index: right)
    }
    if expression.kind == EXPR_UNARY || expression.kind == EXPR_FIELD || expression.kind == EXPR_EFFECT || expression.kind == EXPR_MANAGE || expression.kind == EXPR_AWAIT || expression.kind == EXPR_TRY || expression.kind == EXPR_SPAWN {
        if List.len(list: expression.children) != 1 { return false }
        let child = List.get<Int>(list: expression.children, index: 0)
        // `mut receiver.method()` stores the effect on Rust's receiver callee,
        // while this initial shared AST retains an outer effect node.
        if expression.kind == EXPR_EFFECT && child >= 0 && child < List.len(list: program.expressions) {
            let value = List.get<Expr>(list: program.expressions, index: child)
            if value.kind == EXPR_CALL && value.calleeKind == CALLEE_RECEIVER { return false }
        }
        return ast_expr_direct(program: program, index: child)
    }
    if expression.kind == EXPR_INDEX {
        if List.len(list: expression.children) != 2 { return false }
        return ast_expr_direct(program: program, index: List.get<Int>(list: expression.children, index: 0)) && ast_expr_direct(program: program, index: List.get<Int>(list: expression.children, index: 1))
    }
    if expression.kind == EXPR_ARRAY {
        let mut i = 0
        while i < List.len(list: expression.children) {
            if ast_expr_direct(program: program, index: List.get<Int>(list: expression.children, index: i)) == false { return false }
            i = i + 1
        }
        return true
    }
    if expression.kind == EXPR_CLOSURE {
        if expression.closureBody >= 0 {
            return List.len(list: expression.closureStatements) == 0 && ast_expr_direct(program: program, index: expression.closureBody)
        }
        return List.len(list: expression.closureStatements) > 0 && ast_body_direct(program: program, statements: expression.closureStatements)
    }
    if expression.kind == EXPR_CALL {
        // Generic callee spelling is not yet reconstructed from typeArgs by the
        // direct serializer. Keep it on the legacy path rather than guessing.
        if List.len(list: expression.typeArgs) > 0 { return false }
        if expression.calleeKind != CALLEE_NAME && expression.calleeKind != CALLEE_QUALIFIED && expression.calleeKind != CALLEE_RECEIVER { return false }
        if expression.calleeKind == CALLEE_RECEIVER && ast_expr_direct(program: program, index: expression.calleeReceiver) == false { return false }
        let mut i = 0
        while i < List.len(list: expression.args) {
            let argument = List.get<CallArg>(list: expression.args, index: i)
            if ast_expr_direct(program: program, index: argument.value) == false { return false }
            i = i + 1
        }
        return true
    }
    return false
}

fn ast_stmt_direct(program: Program, index: Int) -> Bool {
    if index < 0 || index >= List.len(list: program.statements) { return false }
    let statement = List.get<Stmt>(list: program.statements, index: index)
    if statement.kind == STMT_RETURN {
        if statement.expression < 0 { return true }
        return ast_expr_direct(program: program, index: statement.expression)
    }
    if statement.kind == STMT_LET {
        // Type nodes and destructuring are intentionally not reconstructed by
        // this first direct slice. The remaining binding facts are complete.
        if String.len(value: statement.name) == 0 || is_upper_first(name: statement.name) || List.len(list: statement.destructure) > 0 || String.len(value: statement.typeText) > 0 { return false }
        if statement.hasInitializer && statement.expression < 0 { return false }
        if statement.expression < 0 { return true }
        return ast_expr_direct(program: program, index: statement.expression)
    }
    if statement.kind == STMT_EXPR {
        return ast_expr_direct(program: program, index: statement.expression)
    }
    if statement.kind == STMT_ASSIGN || statement.kind == STMT_INDEX_ASSIGN {
        // `view name = value` is a scoped-view binding in the production AST,
        // not an ordinary assignment. It needs its own shared statement node.
        if statement.name == "view" { return false }
        return ast_expr_direct(program: program, index: statement.target) && ast_expr_direct(program: program, index: statement.expression)
    }
    if statement.kind == STMT_IF {
        if statement.hasValidHeader == false || statement.hasBlock == false || (statement.hasElse && statement.hasElseBlock == false) { return false }
        if ast_expr_direct(program: program, index: statement.expression) == false || ast_body_direct(program: program, statements: statement.children) == false { return false }
        if statement.hasElse { return ast_body_direct(program: program, statements: statement.elseChildren) }
        return true
    }
    if statement.kind == STMT_WHILE {
        return statement.hasValidHeader && statement.hasBlock && ast_expr_direct(program: program, index: statement.expression) && ast_body_direct(program: program, statements: statement.children)
    }
    if statement.kind == STMT_LOOP || statement.kind == STMT_TASK_GROUP {
        return statement.hasValidHeader && statement.hasBlock && ast_body_direct(program: program, statements: statement.children)
    }
    if statement.kind == STMT_FOR {
        return statement.hasValidHeader && statement.hasBlock && String.len(value: statement.name) > 0 && ast_expr_direct(program: program, index: statement.expression) && ast_body_direct(program: program, statements: statement.children)
    }
    if statement.kind == STMT_WITH {
        return statement.hasValidHeader && statement.hasBlock && String.len(value: statement.name) > 0 && ast_expr_direct(program: program, index: statement.expression) && ast_body_direct(program: program, statements: statement.children)
    }
    if statement.kind == STMT_SELECT {
        if statement.hasValidHeader == false || statement.hasBlock == false { return false }
        let mut i = 0
        while i < List.len(list: statement.selectArms) {
            let arm = List.get<SelectArm>(list: statement.selectArms, index: i)
            if ast_expr_direct(program: program, index: arm.operation) == false || ast_body_direct(program: program, statements: arm.body) == false { return false }
            i = i + 1
        }
        return true
    }
    if statement.kind == STMT_MATCH {
        if statement.hasValidHeader == false || statement.hasBlock == false || statement.expression < 0 { return false }
        let value = List.get<Expr>(list: program.expressions, index: statement.expression)
        if value.kind == EXPR_EFFECT || ast_expr_direct(program: program, index: statement.expression) == false { return false }
        let mut i = 0
        while i < List.len(list: statement.arms) {
            let arm = List.get<MatchArm>(list: statement.arms, index: i)
            if ast_match_pattern_direct(program: program, index: arm.patternNode) == false || (arm.guard >= 0 && ast_expr_direct(program: program, index: arm.guard) == false) || ast_body_direct(program: program, statements: arm.body) == false { return false }
            i = i + 1
        }
        return true
    }
    return false
}

// Direct Pattern output is enabled only for forms whose shared arena contains
// all information needed by the canonical AST dump.
fn ast_match_pattern_direct(program: Program, index: Int) -> Bool {
    if index < 0 || index >= List.len(list: program.patterns) { return false }
    let pattern = List.get<Pattern>(list: program.patterns, index: index)
    if pattern.kind == PAT_WILDCARD || pattern.kind == PAT_BINDING || pattern.kind == PAT_LITERAL { return true }
    if pattern.kind == PAT_STRUCT {
        let mut fieldIndex = 0
        while fieldIndex < List.len(list: pattern.fields) {
            let field = List.get<PatternField>(list: pattern.fields, index: fieldIndex)
            if field.pattern >= 0 && ast_match_pattern_direct(program: program, index: field.pattern) == false { return false }
            fieldIndex = fieldIndex + 1
        }
        return true
    }
    if pattern.kind == PAT_TUPLE || pattern.kind == PAT_LIST {
        let mut childIndex = 0
        while childIndex < List.len(list: pattern.children) {
            if ast_match_pattern_direct(program: program, index: List.get<Int>(list: pattern.children, index: childIndex)) == false { return false }
            childIndex = childIndex + 1
        }
        return true
    }
    if pattern.kind != PAT_VARIANT { return false }
    let mut i = 0
    while i < List.len(list: pattern.children) {
        if ast_match_pattern_direct(program: program, index: List.get<Int>(list: pattern.children, index: i)) == false { return false }
        i = i + 1
    }
    return true
}

fn ast_body_direct(program: Program, statements: List<Int>) -> Bool {
    if program.bodiesMaterialized == false { return false }
    let mut i = 0
    while i < List.len(list: statements) {
        if ast_stmt_direct(program: program, index: List.get<Int>(list: statements, index: i)) == false { return false }
        i = i + 1
    }
    return true
}

fn emit_ast_expr(out: mut StringBuilder, program: Program, index: Int, depth: Int) -> Unit {
    let expression = List.get<Expr>(list: program.expressions, index: index)
    if expression.kind == EXPR_NAME {
        emit_ast_at(out: mut out, depth: depth, s: String.concat(left: "ident ", right: escape(s: expression.text)), line: expression.line, column: expression.column, length: expression.length)
        return Unit
    }
    if expression.kind == EXPR_LITERAL {
        let mut tag = "ident "
        if expression.tokenKind == TOK_NUMBER { tag = "number " }
        else if expression.tokenKind == TOK_STRING { tag = "string " }
        else if expression.tokenKind == TOK_CHAR { tag = "char " }
        else if expression.tokenKind == TOK_MULTILINE { tag = "multiline " }
        emit_ast_at(out: mut out, depth: depth, s: String.concat(left: tag, right: escape(s: expression.text)), line: expression.line, column: expression.column, length: expression.length)
        return Unit
    }
    if expression.kind == EXPR_BINARY {
        let name = ast_binary_name(operator: expression.text)
        emit_ast_at(out: mut out, depth: depth, s: String.concat(left: "binary op=", right: name), line: expression.line, column: expression.column, length: expression.length)
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 0), depth: (depth + 1))
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 1), depth: (depth + 1))
        return Unit
    }
    if expression.kind == EXPR_UNARY {
        emit_ast_at(out: mut out, depth: depth, s: "binary op=equal", line: expression.line, column: expression.column, length: expression.length)
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 0), depth: (depth + 1))
        emit_ast_at(out: mut out, depth: (depth + 1), s: "ident false", line: expression.line, column: expression.column, length: expression.length)
        return Unit
    }
    if expression.kind == EXPR_FIELD {
        emit_ast_at(out: mut out, depth: depth, s: String.concat(left: "field-access name=", right: expression.text), line: expression.line, column: expression.column, length: expression.length)
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 0), depth: (depth + 1))
        return Unit
    }
    if expression.kind == EXPR_INDEX {
        emit_ast_at(out: mut out, depth: depth, s: "index", line: expression.line, column: expression.column, length: expression.length)
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 0), depth: (depth + 1))
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 1), depth: (depth + 1))
        return Unit
    }
    if expression.kind == EXPR_ARRAY {
        emit_ast_at(out: mut out, depth: depth, s: "array", line: expression.line, column: expression.column, length: expression.length)
        let mut i = 0
        while i < List.len(list: expression.children) {
            emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: i), depth: (depth + 1))
            i = i + 1
        }
        return Unit
    }
    if expression.kind == EXPR_EFFECT || expression.kind == EXPR_MANAGE || expression.kind == EXPR_AWAIT || expression.kind == EXPR_TRY || expression.kind == EXPR_SPAWN {
        let mut head = expression.text
        if expression.kind == EXPR_EFFECT { head = String.concat(left: "effect kind=", right: expression.text) }
        emit_ast_at(out: mut out, depth: depth, s: head, line: expression.line, column: expression.column, length: expression.length)
        emit_ast_expr(out: mut out, program: program, index: List.get<Int>(list: expression.children, index: 0), depth: (depth + 1))
        return Unit
    }
    if expression.kind == EXPR_CLOSURE {
        emit_ast_at(out: mut out, depth: depth, s: "closure explicit=false", line: expression.line, column: expression.column, length: expression.length)
        let mut parameter = 0
        while parameter < List.len(list: expression.closureParams) {
            emit(out: mut out, depth: (depth + 1), s: String.concat(left: "closure-param ", right: List.get<String>(list: expression.closureParams, index: parameter)))
            parameter = parameter + 1
        }
        emit(out: mut out, depth: (depth + 1), s: "body")
        if expression.closureBody >= 0 {
            let body = List.get<Expr>(list: program.expressions, index: expression.closureBody)
            emit(out: mut out, depth: (depth + 2), s: "block")
            emit_ast_at(out: mut out, depth: (depth + 3), s: "expr-stmt", line: body.line, column: body.column, length: body.length)
            emit_ast_expr(out: mut out, program: program, index: expression.closureBody, depth: (depth + 4))
        } else {
            emit_ast_block(out: mut out, program: program, statements: expression.closureStatements, depth: (depth + 2))
        }
        return Unit
    }
    emit_ast_at(out: mut out, depth: depth, s: "call", line: expression.line, column: expression.column, length: expression.length)
    if expression.calleeKind == CALLEE_RECEIVER {
        emit(out: mut out, depth: (depth + 1), s: String.concat(left: "callee-receiver method=", right: expression.text))
        emit_ast_expr(out: mut out, program: program, index: expression.calleeReceiver, depth: (depth + 2))
    } else if expression.calleeKind == CALLEE_QUALIFIED {
        match String.index_of(value: expression.text, needle: ".") {
            Some(dot) => {
                let namespace = String.slice(value: expression.text, start: 0, len: dot)
                let method = String.slice(value: expression.text, start: (dot + 1), len: (String.len(value: expression.text) - dot - 1))
                let head = String.concat(left: "callee-qualified namespace=", right: namespace)
                emit(out: mut out, depth: (depth + 1), s: String.concat(left: String.concat(left: head, right: " name="), right: method))
            }
            None => { emit(out: mut out, depth: (depth + 1), s: "callee-name name=") }
        }
    } else {
        emit(out: mut out, depth: (depth + 1), s: String.concat(left: "callee-name name=", right: expression.text))
    }
    let mut i = 0
    while i < List.len(list: expression.args) {
        let argument = List.get<CallArg>(list: expression.args, index: i)
        let mut head = "arg"
        if String.len(value: argument.label) > 0 { head = String.concat(left: "arg name=", right: argument.label) }
        emit(out: mut out, depth: (depth + 1), s: head)
        emit_ast_expr(out: mut out, program: program, index: argument.value, depth: (depth + 2))
        i = i + 1
    }
    return Unit
}

// A bare name at the arm root is a variant in the production grammar. Positional
// names nested under a variant are bindings. Keep that contextual distinction
// explicit until a recursive Pattern node replaces this Expr-backed slice.
fn emit_ast_match_pattern(out: mut StringBuilder, program: Program, index: Int, depth: Int) -> Unit {
    let pattern = List.get<Pattern>(list: program.patterns, index: index)
    if pattern.kind == PAT_WILDCARD {
        emit(out: mut out, depth: depth, s: "pat-wildcard")
        return Unit
    }
    if pattern.kind == PAT_BINDING {
        emit(out: mut out, depth: depth, s: String.concat(left: "pat-binding name=", right: pattern.name))
        return Unit
    }
    if pattern.kind == PAT_LITERAL {
        let mut tag = "int"
        if pattern.tokenKind == TOK_STRING { tag = "string" }
        else if pattern.tokenKind == TOK_CHAR { tag = "char" }
        else if pattern.tokenKind == TOK_IDENT { tag = "bool" }
        let prefix = String.concat(left: "pat-literal kind=", right: tag)
        emit(out: mut out, depth: depth, s: String.concat(left: String.concat(left: prefix, right: " "), right: escape(s: pattern.name)))
        return Unit
    }
    if pattern.kind == PAT_STRUCT {
        let mut head = String.concat(left: "pat-struct name=", right: pattern.name)
        if pattern.rest == "present" { head = String.concat(left: head, right: " rest=true") }
        else { head = String.concat(left: head, right: " rest=false") }
        emit(out: mut out, depth: depth, s: head)
        let mut fieldIndex = 0
        while fieldIndex < List.len(list: pattern.fields) {
            let field = List.get<PatternField>(list: pattern.fields, index: fieldIndex)
            let mut fieldHead = String.concat(left: "pat-field name=", right: field.name)
            if field.ignored { fieldHead = String.concat(left: fieldHead, right: " ignored=true") }
            else {
                fieldHead = String.concat(left: fieldHead, right: " ignored=false")
                if String.len(value: field.binding) > 0 {
                    fieldHead = String.concat(left: fieldHead, right: " binding=")
                    fieldHead = String.concat(left: fieldHead, right: field.binding)
                }
                if String.len(value: field.effect) > 0 {
                    fieldHead = String.concat(left: fieldHead, right: " effect=")
                    fieldHead = String.concat(left: fieldHead, right: field.effect)
                }
            }
            emit(out: mut out, depth: (depth + 1), s: fieldHead)
            if field.pattern >= 0 { emit_ast_match_pattern(out: mut out, program: program, index: field.pattern, depth: (depth + 2)) }
            fieldIndex = fieldIndex + 1
        }
        return Unit
    }
    if pattern.kind == PAT_TUPLE {
        let mut head = String.concat(left: "pat-struct name=__Tuple", right: String.from_int(value: List.len(list: pattern.children)))
        head = String.concat(left: head, right: " rest=false")
        emit(out: mut out, depth: depth, s: head)
        let mut childIndex = 0
        while childIndex < List.len(list: pattern.children) {
            let name = String.concat(left: "item", right: String.from_int(value: childIndex))
            emit_ast_tuple_field(out: mut out, program: program, name: name, patternIndex: List.get<Int>(list: pattern.children, index: childIndex), depth: (depth + 1))
            childIndex = childIndex + 1
        }
        return Unit
    }
    if pattern.kind == PAT_LIST {
        let mut head = String.concat(left: "pat-list rest=", right: pattern.rest)
        emit(out: mut out, depth: depth, s: head)
        let mut prefixEnd = List.len(list: pattern.children)
        if pattern.restIndex >= 0 { prefixEnd = pattern.restIndex }
        if prefixEnd > 0 {
            emit(out: mut out, depth: (depth + 1), s: "list-prefix")
            emit_ast_list_side(out: mut out, program: program, pattern: pattern, start: 0, end: prefixEnd, depth: (depth + 2))
        }
        if pattern.restIndex >= 0 && pattern.restIndex < List.len(list: pattern.children) {
            emit(out: mut out, depth: (depth + 1), s: "list-suffix")
            emit_ast_list_side(out: mut out, program: program, pattern: pattern, start: pattern.restIndex, end: List.len(list: pattern.children), depth: (depth + 2))
        }
        return Unit
    }
    emit(out: mut out, depth: depth, s: String.concat(left: "pat-variant name=", right: pattern.name))
    let mut i = 0
    while i < List.len(list: pattern.children) {
        emit_ast_match_pattern(out: mut out, program: program, index: List.get<Int>(list: pattern.children, index: i), depth: (depth + 1))
        i = i + 1
    }
    return Unit
}

fn emit_ast_tuple_field(out: mut StringBuilder, program: Program, name: String, patternIndex: Int, depth: Int) -> Unit {
    let child = List.get<Pattern>(list: program.patterns, index: patternIndex)
    let mut head = String.concat(left: "pat-field name=", right: name)
    if child.kind == PAT_WILDCARD {
        emit(out: mut out, depth: depth, s: String.concat(left: head, right: " ignored=true"))
        return Unit
    }
    head = String.concat(left: head, right: " ignored=false")
    if child.kind == PAT_BINDING {
        head = String.concat(left: head, right: " binding=")
        emit(out: mut out, depth: depth, s: String.concat(left: head, right: child.name))
        return Unit
    }
    emit(out: mut out, depth: depth, s: head)
    emit_ast_match_pattern(out: mut out, program: program, index: patternIndex, depth: (depth + 1))
    return Unit
}

fn emit_ast_list_side(out: mut StringBuilder, program: Program, pattern: Pattern, start: Int, end: Int, depth: Int) -> Unit {
    let mut childIndex = start
    while childIndex < end {
        emit_ast_match_pattern(out: mut out, program: program, index: List.get<Int>(list: pattern.children, index: childIndex), depth: depth)
        childIndex = childIndex + 1
    }
    return Unit
}

fn emit_ast_block(out: mut StringBuilder, program: Program, statements: List<Int>, depth: Int) -> Unit {
    emit(out: mut out, depth: depth, s: "block")
    let mut i = 0
    while i < List.len(list: statements) {
        let statement = List.get<Stmt>(list: program.statements, index: List.get<Int>(list: statements, index: i))
        if statement.kind == STMT_RETURN {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "return", line: statement.line, column: statement.column, length: statement.length)
            if statement.expression >= 0 {
                emit(out: mut out, depth: (depth + 2), s: "value")
                emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            }
        } else if statement.kind == STMT_LET {
            let mut kind = "managed"
            if statement.isLocal { kind = "local" }
            let a = String.concat(left: "let kind=", right: kind)
            let b = String.concat(left: String.concat(left: a, right: " name="), right: statement.name)
            let c = String.concat(left: String.concat(left: b, right: " mut="), right: boolstr(b: statement.isMutable))
            emit_ast_at(out: mut out, depth: (depth + 1), s: String.concat(left: c, right: String.concat(left: " async=", right: boolstr(b: statement.isAsync))), line: statement.line, column: statement.column, length: statement.length)
            if statement.expression >= 0 {
                emit(out: mut out, depth: (depth + 2), s: "value")
                emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            }
        } else if statement.kind == STMT_EXPR {
            let expression = List.get<Expr>(list: program.expressions, index: statement.expression)
            emit_ast_at(out: mut out, depth: (depth + 1), s: "expr-stmt", line: expression.line, column: expression.column, length: expression.length)
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 2))
        } else if statement.kind == STMT_IF {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "if", line: statement.line, column: statement.column, length: statement.length)
            emit(out: mut out, depth: (depth + 2), s: "cond")
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            emit(out: mut out, depth: (depth + 2), s: "then")
            emit_ast_block(out: mut out, program: program, statements: statement.children, depth: (depth + 3))
            if statement.hasElse {
                emit(out: mut out, depth: (depth + 2), s: "else")
                emit_ast_block(out: mut out, program: program, statements: statement.elseChildren, depth: (depth + 3))
            }
        } else if statement.kind == STMT_WHILE || statement.kind == STMT_LOOP {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "loop", line: statement.line, column: statement.column, length: statement.length)
            if statement.kind == STMT_WHILE {
                emit(out: mut out, depth: (depth + 2), s: "cond")
                emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            }
            emit_ast_block(out: mut out, program: program, statements: statement.children, depth: (depth + 2))
        } else if statement.kind == STMT_FOR {
            let head = String.concat(left: String.concat(left: "for binding=", right: statement.name), right: String.concat(left: " async=", right: boolstr(b: statement.isAsync)))
            emit_ast_at(out: mut out, depth: (depth + 1), s: head, line: statement.line, column: statement.column, length: statement.length)
            emit(out: mut out, depth: (depth + 2), s: "iter")
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            emit_ast_block(out: mut out, program: program, statements: statement.children, depth: (depth + 2))
        } else if statement.kind == STMT_WITH {
            emit_ast_at(out: mut out, depth: (depth + 1), s: String.concat(left: "with binding=", right: statement.name), line: statement.line, column: statement.column, length: statement.length)
            emit(out: mut out, depth: (depth + 2), s: "resource")
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            emit_ast_block(out: mut out, program: program, statements: statement.children, depth: (depth + 2))
        } else if statement.kind == STMT_SELECT {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "select", line: statement.line, column: statement.column, length: statement.length)
            let mut armIndex = 0
            while armIndex < List.len(list: statement.selectArms) {
                let arm = List.get<SelectArm>(list: statement.selectArms, index: armIndex)
                emit_ast_at(out: mut out, depth: (depth + 2), s: String.concat(left: "select-arm binding=", right: arm.binding), line: arm.line, column: arm.column, length: arm.length)
                emit(out: mut out, depth: (depth + 3), s: "operation")
                emit_ast_expr(out: mut out, program: program, index: arm.operation, depth: (depth + 4))
                emit_ast_block(out: mut out, program: program, statements: arm.body, depth: (depth + 3))
                armIndex = armIndex + 1
            }
        } else if statement.kind == STMT_MATCH {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "match", line: statement.line, column: statement.column, length: statement.length)
            emit(out: mut out, depth: (depth + 2), s: "value")
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
            let mut armIndex = 0
            while armIndex < List.len(list: statement.arms) {
                let arm = List.get<MatchArm>(list: statement.arms, index: armIndex)
                emit_ast_at(out: mut out, depth: (depth + 2), s: "arm", line: arm.line, column: arm.column, length: arm.length)
                emit(out: mut out, depth: (depth + 3), s: "pattern")
                emit_ast_match_pattern(out: mut out, program: program, index: arm.patternNode, depth: (depth + 4))
                if arm.guard >= 0 {
                    emit(out: mut out, depth: (depth + 3), s: "guard")
                    emit_ast_expr(out: mut out, program: program, index: arm.guard, depth: (depth + 4))
                }
                emit_ast_block(out: mut out, program: program, statements: arm.body, depth: (depth + 3))
                armIndex = armIndex + 1
            }
            let mut malformed = 0
            while malformed < statement.malformedArms {
                emit(out: mut out, depth: (depth + 2), s: "malformed-arm")
                malformed = malformed + 1
            }
        } else if statement.kind == STMT_TASK_GROUP {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "task-group", line: statement.line, column: statement.column, length: statement.length)
            emit_ast_block(out: mut out, program: program, statements: statement.children, depth: (depth + 2))
        } else {
            emit_ast_at(out: mut out, depth: (depth + 1), s: "assign", line: statement.line, column: statement.column, length: statement.length)
            emit(out: mut out, depth: (depth + 2), s: "target")
            emit_ast_expr(out: mut out, program: program, index: statement.target, depth: (depth + 3))
            emit(out: mut out, depth: (depth + 2), s: "value")
            emit_ast_expr(out: mut out, program: program, index: statement.expression, depth: (depth + 3))
        }
        i = i + 1
    }
    return Unit
}

// True if tokens [start, end) contain a `.` (a dotted method name like Type.m).
fn name_has_dot(toks: List<Tok>, start: Int, end: Int) -> Bool {
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_DOT) { return true }
        i = i + 1
    }
    return false
}

// True if the `<...>` generic list at i already declares a `Self` param.
fn has_self_generic(toks: List<Tok>, i: Int) -> Bool {
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) == false { return false }
    let close = find_matching(toks: toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 { return false }
    let mut k = i + 1
    while k < close {
        if is_ident_tok(toks: toks, i: k) && tk_text(toks, i: k) == "Self" { return true }
        k = k + 1
    }
    return false
}

fn emit_function(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int, protoName: String) -> Int {
    let mut j = start
    // Attributes: #deprecated("...") / #lower_name("...")  (before pub/async).
    let mut depReason = ""
    let mut haveDep = false
    let mut lowerName = ""
    let mut haveLower = false
    let mut attrs = true
    while attrs {
        if at_symbol(toks: toks, i: j, code: SYM_HASH) {
            let isDep = at_ident(toks: toks, i: (j + 1), wid: WORD_DEPRECATED)
            let sval = tk_text(toks, i: (j + 3))
            if isDep { depReason = sval; haveDep = true } else { lowerName = sval; haveLower = true }
            j = j + 5
        } else {
            attrs = false
        }
    }
    let mut isPub = false
    let mut isAsync = false
    if is_kw_text(toks, i: j, word: "pub") { isPub = true; j = j + 1 }
    if is_kw_text(toks, i: j, word: "async") { isAsync = true; j = j + 1 }
    // `fn`
    j = j + 1
    let nameEnd = take_function_name(toks: toks, i: j)
    let rawName = dotted_text(toks, start: j, end: nameEnd)
    // Protocol methods: prefix the name with the protocol (unless already dotted),
    // force public, and inject a leading `Self: Managed` generic (parse_protocol_decl).
    let mut name = rawName
    if String.len(value: protoName) > 0 && name_has_dot(toks, start: j, end: nameEnd) == false {
        name = String.concat(left: String.concat(left: protoName, right: "."), right: rawName)
    }
    if String.len(value: protoName) > 0 { isPub = true }
    let genStart = nameEnd
    // params
    let popen = parse_generic_params(toks: toks, i: genStart)
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    j = pclose + 1
    // return type
    let mut hasRet = false
    let mut retFresh = false
    let mut retStart = -1
    if at_symbol(toks: toks, i: j, code: SYM_ARROW) {
        hasRet = true
        retStart = j + 1
        // `-> fresh T` sets the fn's returns-fresh and the type ref begins AT T
        // (the return TypeRef itself is fresh=false — matches parse_function_decl).
        if at_ident(toks: toks, i: (j + 1), wid: WORD_FRESH) {
            retFresh = true
            retStart = j + 2
        }
    }
    // Signature region [pclose+1, sigEnd): return type, effect_list(...), and the
    // default-impl marker `= _`. function_signature_end stops at the body `{` or
    // the next top-level item — so a body exists iff sigEnd lands on a `{`. (A raw
    // find_block_open would wrongly borrow a LATER fn's `{` for a body-less decl.)
    let sigEnd = function_signature_end(toks: toks, start: (pclose + 1))
    let mut bodyOpen = -1
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) { bodyOpen = sigEnd }
    // A body exists iff sigEnd lands on `{`, including when the opening brace is
    // placed on the following line.
    let mut hasBody = bodyOpen >= 0
    let defaultImpl = has_default_impl(toks, start: (pclose + 1), end: sigEnd)
    // A `fresh` anywhere in the return-type region (e.g. `-> Result<fresh String, E>`)
    // also sets returns-fresh, matching parse_function_decl's region scan.
    if hasRet && fresh_in_return(toks, start: retStart, sigEnd) {
        retFresh = true
    }
    // Function headers, including protocol methods, are headed by the shared
    // Program record. Token ranges remain responsible only for recovery and
    // expression children that the AST has not materialized yet.
    let mut sharedGenerics = List<GenericParam>.new()
    let mut sharedParams = List<Param>.new()
    let mut sharedRetainedParams = List<String>.new()
    let mut sharedStatements = List<Int>.new()
    let mut hasSharedFunction = false
    let item = shared_item_at(program, toks, start, kind: ITEM_FUNCTION)
    if item.kind == ITEM_FUNCTION {
        hasSharedFunction = true
        name = item.name
        isPub = item.isPublic
        isAsync = item.isAsync
        hasBody = item.hasBody
        sharedGenerics = item.generics
        sharedParams = item.params
        sharedRetainedParams = item.retainedParams
        sharedStatements = item.statements
    }
    // Emit fn line.
    local sb = StringBuilder.new()
    StringBuilder.push(builder: mut sb, value: "fn name=")
    StringBuilder.push(builder: mut sb, value: name)
    StringBuilder.push(builder: mut sb, value: " public=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: isPub))
    StringBuilder.push(builder: mut sb, value: " async=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: isAsync))
    StringBuilder.push(builder: mut sb, value: " has-body=")
    StringBuilder.push(builder: mut sb, value: boolstr(b: hasBody))
    if defaultImpl {
        StringBuilder.push(builder: mut sb, value: " default-impl=true")
    }
    if hasRet && retFresh {
        StringBuilder.push(builder: mut sb, value: " returns-fresh=true")
    }
    emit_at(out: mut out, depth: d, s: StringBuilder.finish(builder: take sb), toks, i: start)
    // deprecated / lower-name attribute child lines (before generics).
    if haveDep {
        emit(out: mut out, depth: (d + 1), s: String.concat(left: "deprecated ", right: escape(s: depReason)))
    }
    if haveLower {
        emit(out: mut out, depth: (d + 1), s: String.concat(left: "lower-name ", right: lowerName))
    }
    // generics — protocol methods get a synthetic leading `Self: Managed` param.
    if String.len(value: protoName) > 0 && has_self_generic(toks, i: genStart) == false {
        // The synthetic `Self: Managed` param is spanned at the method's span (the
        // `fn`/decl start), matching parse_protocol_decl's `method.span.clone()`.
        emit_at(out: mut out, depth: (d + 1), s: "generic name=Self", toks, i: start)
        emit(out: mut out, depth: (d + 2), s: "bound managed")
    }
    let malGen = count_malformed_generics(toks, i: genStart)
    if hasSharedFunction {
        emit_shared_generics(out: mut out, sharedGenerics, toks, i: genStart, d: (d + 1))
    } else {
        emit_generics(out: mut out, toks, i: genStart, d: (d + 1))
    }
    // params
    let mut malParam = 0
    if hasSharedFunction {
        malParam = emit_shared_params(out: mut out, sharedParams, toks, open: popen, close: pclose, d: (d + 1))
    } else {
        malParam = emit_params(out: mut out, toks, open: popen, close: pclose, d: (d + 1))
    }
    // return type
    if hasRet {
        emit_type_ref(out: mut out, toks, i: retStart, tag: "return-type", eff: "", d: (d + 1))
    }
    // Structured retention clauses.
    if hasSharedFunction {
        let mut retainedIndex = 0
        while retainedIndex < List.len(list: sharedRetainedParams) {
            let target = List.get<String>(list: sharedRetainedParams, index: retainedIndex)
            emit(out: mut out, depth: (d + 1), s: String.concat(left: "retains ", right: target))
            retainedIndex = retainedIndex + 1
        }
    }
    // Dump order (ast_oracle_dump): generics, params, return-type, effects, then
    // malformed-generic / malformed-param / malformed-effect, then body.
    emit_repeat(out: mut out, marker: "malformed-generic", n: malGen, d: (d + 1))
    emit_repeat(out: mut out, marker: "malformed-param", n: malParam, d: (d + 1))
    // body — the oracle always emits `body`/`block`, empty when there is no body.
    emit(out: mut out, depth: (d + 1), s: "body")
    if hasBody {
        let bclose = find_matching(toks: toks, open: bodyOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if String.len(value: protoName) == 0 && hasSharedFunction && ast_body_direct(program: program, statements: sharedStatements) {
            emit_ast_block(out: mut out, program: program, statements: sharedStatements, depth: (d + 2))
            return bclose + 1
        }
        emit_block(out: mut out, toks, open: bodyOpen, close: bclose, d: (d + 2))
        return bclose + 1
    }
    emit(out: mut out, depth: (d + 2), s: "block")
    // No body: the declaration ends exactly at sigEnd (next top-level item / EOF),
    // which is correct even for a signature spanning multiple lines.
    return sigEnd
}

fn same_stmt_line(toks: List<Tok>, a: Int, b: Int) -> Bool {
    return tk_line(toks: toks, i: a) == tk_line(toks: toks, i: b)
}

// True if `fresh` appears in the return-type region [start, sigEnd) before the
// effects clause / body `{` / default-impl `=` (mirrors parse_function_decl).
fn fresh_in_return(toks: List<Tok>, start: Int, sigEnd: Int) -> Bool {
    let mut k = start
    while k < sigEnd {
        if is_kw_text(toks, i: k, word: "retains") || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_EQ) {
            return false
        }
        if at_ident(toks: toks, i: k, wid: WORD_FRESH) { return true }
        k = k + 1
    }
    return false
}

// The default-impl marker `= _` appears at top level in the signature region.
fn has_default_impl(toks: List<Tok>, start: Int, end: Int) -> Bool {
    let mut depth = 0
    let mut i = start
    while i < end {
        let opener = at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) || at_symbol(toks: toks, i: i, code: SYM_LANGLE)
        let closer = at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) || at_symbol(toks: toks, i: i, code: SYM_RANGLE)
        if depth == 0 && at_symbol(toks: toks, i: i, code: SYM_EQ) && at_ident(toks: toks, i: (i + 1), wid: WORD_UNDERSCORE) {
            return true
        }
        if opener { depth = depth + 1 } else if closer { if depth > 0 { depth = depth - 1 } }
        i = i + 1
    }
    return false
}

// `effect_list(a, retains(self), ...)` → one `effect-name`/`effect-retains` per entry.
// -------------------------------------------------------------------------
// Malformed-recovery predicates + markers (mirror the reference parsers, which
// record malformed_*_spans; the oracle dumps one `malformed-<kind>` line each,
// AFTER the valid nodes of that construct).
// -------------------------------------------------------------------------

// parse_type_ref finds a name_index (first non-prefix ident) over [s, e), else
// returns None. So a type "parses" iff such a token exists.
fn type_parses(toks: List<Tok>, s: Int, e: Int) -> Bool {
    let mut m = s
    while m < e {
        if is_ident_tok(toks: toks, i: m) && is_type_prefix(toks, j: m) == false {
            return true
        }
        m = m + 1
    }
    return false
}

fn is_data_effect_kw(toks: List<Tok>, i: Int) -> Bool {
    return is_kw_text(toks, i, word: "read") || is_kw_text(toks, i, word: "mut") || is_kw_text(toks, i, word: "take")
}

// Emit `marker` n times at depth d.
fn emit_repeat(out: mut StringBuilder, marker: String, n: Int, d: Int) -> Unit {
    let mut c = 0
    while c < n {
        emit(out: mut out, depth: d, s: marker)
        c = c + 1
    }
    return Unit
}

// Field-line validity (mirrors parse_fields): ident name, `:`, and a type that
// parses over [ty_start, ty_end) where ty_start skips handle/weak and ty_end is
// the default `=` or the line/region limit.
fn field_valid(toks: List<Tok>, nameIdx: Int, end: Int) -> Bool {
    if is_ident_tok(toks: toks, i: nameIdx) == false { return false }
    if at_symbol(toks: toks, i: (nameIdx + 1), code: SYM_COLON) == false { return false }
    let mut tyStart = nameIdx + 2
    let mut pref = true
    while pref {
        if is_kw_text(toks, i: tyStart, word: "handle") || is_kw_text(toks, i: tyStart, word: "weak") {
            tyStart = tyStart + 1
        } else {
            pref = false
        }
    }
    let lineLimit = next_line_or_block_end(toks: toks, start: tyStart, end: end)
    let deq = first_eq(toks, start: tyStart, end: lineLimit)
    let mut tyEnd = lineLimit
    if deq >= 0 { tyEnd = deq }
    return type_parses(toks, s: tyStart, e: tyEnd)
}

// Generic-param validity (mirrors parse_generic_params): ident name, then either
// no bound (start+1==end) or `: Bound` with start+3==end and a bound token.
fn gen_valid(toks: List<Tok>, start: Int, end: Int) -> Bool {
    if is_ident_tok(toks: toks, i: start) == false { return false }
    if (start + 1) == end { return true }
    if at_symbol(toks: toks, i: (start + 1), code: SYM_COLON) && (start + 3) == end && is_ident_tok(toks: toks, i: (start + 2)) {
        return true
    }
    return false
}

// Count malformed generic params in the `<...>` beginning at i (0 if not `<`).
fn count_malformed_generics(toks: List<Tok>, i: Int) -> Int {
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) == false { return 0 }
    let close = find_matching(toks: toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 { return 0 }
    let mut k = i + 1
    let mut mal = 0
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        if gen_valid(toks, start: k, end: segEnd) == false { mal = mal + 1 }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return mal
}

// Join a dotted name's identifier tokens [start,end) with '.'.
fn dotted_text(toks: List<Tok>, start: Int, end: Int) -> String {
    local sb = StringBuilder.new()
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_DOT) == false {
            StringBuilder.push(builder: mut sb, value: tk_text(toks, i))
        } else {
            StringBuilder.push(builder: mut sb, value: ".")
        }
        i = i + 1
    }
    return StringBuilder.finish(builder: take sb)
}

// Params in the parens [open, close]: each `name: [effect] Type [= default]`.
// Emits valid params and returns the malformed count (mirrors parse_params: an
// empty segment, a non-ident name, or a leading data-effect keyword are malformed;
// a `name` with no `:` is a VALID param with an empty type).
fn emit_params(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Int {
    let mut i = open + 1
    let mut mal = 0
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        if i >= segEnd {
            mal = mal + 1
        } else if is_ident_tok(toks: toks, i: i) == false {
            mal = mal + 1
        } else if is_data_effect_kw(toks, i) {
            mal = mal + 1
        } else {
            let pname = tk_text(toks, i)
            if at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) == false {
                // Name-only param: valid, with an empty type ref (both spanned at the
                // param's name token, matching parse_params).
                emit_at(out: mut out, depth: d, s: String.concat(left: "param name=", right: pname), toks, i)
                emit_at(out: mut out, depth: (d + 1), s: "type name= fresh=false noescape=false owned=false", toks, i)
            } else {
                let mut k = i + 2
                let mut effStr = ""
                if is_kw_text(toks, i: k, word: "read") { effStr = "read"; k = k + 1 }
                else if is_kw_text(toks, i: k, word: "mut") { effStr = "mut"; k = k + 1 }
                else if is_kw_text(toks, i: k, word: "take") { effStr = "take"; k = k + 1 }
                let mut line = String.concat(left: "param name=", right: pname)
                if String.len(value: effStr) > 0 {
                    let l2 = String.concat(left: line, right: " effect=")
                    line = String.concat(left: l2, right: effStr)
                }
                emit_at(out: mut out, depth: d, s: line, toks, i)
                let afterType = emit_type_ref(out: mut out, toks, i: k, tag: "type", eff: "", d: (d + 1))
                // Default value: `name: Type = <expr>` (dump_param emits it after type).
                if at_symbol(toks: toks, i: afterType, code: SYM_EQ) {
                    emit(out: mut out, depth: (d + 1), s: "default")
                    emit_expr(out: mut out, toks, start: (afterType + 1), end: segEnd, d: (d + 2))
                }
            }
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return mal
}

fn emit_shared_params(out: mut StringBuilder, params: List<Param>, toks: List<Tok>, open: Int, close: Int, d: Int) -> Int {
    let mut i = open + 1
    let mut paramIndex = 0
    let mut mal = 0
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        if i >= segEnd || is_ident_tok(toks: toks, i: i) == false || is_data_effect_kw(toks, i) {
            mal = mal + 1
        } else if paramIndex < List.len(list: params) {
            let param = List.get<Param>(list: params, index: paramIndex)
            paramIndex = paramIndex + 1
            if at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) == false {
                emit_at(out: mut out, depth: d, s: String.concat(left: "param name=", right: param.name), toks, i)
                emit_at(out: mut out, depth: (d + 1), s: "type name= fresh=false noescape=false owned=false", toks, i)
            } else {
                let mut k = i + 2
                if is_kw_text(toks, i: k, word: "read") || is_kw_text(toks, i: k, word: "mut") || is_kw_text(toks, i: k, word: "take") { k = k + 1 }
                let mut line = String.concat(left: "param name=", right: param.name)
                if String.len(value: param.effect) > 0 {
                    line = String.concat(left: String.concat(left: line, right: " effect="), right: param.effect)
                }
                emit_at(out: mut out, depth: d, s: line, toks, i)
                let afterType = emit_type_ref(out: mut out, toks, i: k, tag: "type", eff: "", d: (d + 1))
                if at_symbol(toks: toks, i: afterType, code: SYM_EQ) {
                    emit(out: mut out, depth: (d + 1), s: "default")
                    emit_expr(out: mut out, toks, start: (afterType + 1), end: segEnd, d: (d + 2))
                }
            }
        } else {
            // A missing shared record must preserve the legacy exact renderer.
            let fallback = emit_params(out: mut out, toks, open: (i - 1), close: segEnd, d)
            mal = mal + fallback
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return mal
}

// Generic records are shared by the frontend. The source range remains the
// recovery authority: malformed segments are counted exactly as before.
fn emit_shared_generics(out: mut StringBuilder, generics: List<GenericParam>, toks: List<Tok>, i: Int, d: Int) -> Int {
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) == false { return i }
    let close = find_matching(toks: toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 { return i }
    let mut k = i + 1
    let mut genericIndex = 0
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        if gen_valid(toks, start: k, end: segEnd) {
            if genericIndex < List.len(list: generics) {
                let generic = List.get<GenericParam>(list: generics, index: genericIndex)
                genericIndex = genericIndex + 1
                emit_at(out: mut out, depth: d, s: String.concat(left: "generic name=", right: generic.name), toks, i: k)
                if String.len(value: generic.boundText) > 0 {
                    emit(out: mut out, depth: (d + 1), s: bound_line(word: generic.boundText))
                }
            } else {
                // Keep the old source renderer as a recovery fallback if a
                // malformed declaration ever has fewer shared records.
                emit_at(out: mut out, depth: d, s: String.concat(left: "generic name=", right: tk_text(toks, i: k)), toks, i: k)
                if at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
                    emit(out: mut out, depth: (d + 1), s: bound_line(word: tk_text(toks, i: (k + 2))))
                }
            }
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return close + 1
}

// -------------------------------------------------------------------------
// Generic params, derives, fields, and declaration items.
// -------------------------------------------------------------------------

// Emit `generic` children for a `<...>` param list at i; return index past `>`.
fn emit_generics(out: mut StringBuilder, toks: List<Tok>, i: Int, d: Int) -> Int {
    if at_symbol(toks: toks, i: i, code: SYM_LANGLE) == false { return i }
    let close = find_matching(toks: toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 { return i }
    let mut k = i + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let mut segEnd = close
        if comma >= 0 { segEnd = comma }
        // Emit only VALID generic params; malformed ones become malformed-generic
        // markers counted separately (count_malformed_generics).
        if gen_valid(toks, start: k, end: segEnd) {
            let name = tk_text(toks, i: k)
            emit_at(out: mut out, depth: d, s: String.concat(left: "generic name=", right: name), toks, i: k)
            if at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
                let bw = tk_text(toks, i: (k + 2))
                emit(out: mut out, depth: (d + 1), s: bound_line(word: bw))
            }
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return close + 1
}

fn bound_line(word: String) -> String {
    if word == "Managed" { return "bound managed" }
    if word == "Struct" { return "bound struct" }
    if word == "Resource" { return "bound resource" }
    return String.concat(left: "bound protocol=", right: word)
}

// Emit `derive` children for `derives(...)` at i; return index past `)`.
fn emit_derives(out: mut StringBuilder, toks: List<Tok>, i: Int, d: Int) -> Int {
    if at_ident(toks: toks, i: i, wid: WORD_DERIVES) == false { return i }
    if at_symbol(toks: toks, i: (i + 1), code: SYM_LPAREN) == false { return i }
    let close = find_matching(toks: toks, open: (i + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return i }
    let mut k = i + 2
    while k < close {
        if is_ident_tok(toks: toks, i: k) {
            emit(out: mut out, depth: d, s: String.concat(left: "derive ", right: tk_text(toks, i: k)))
        }
        k = k + 1
    }
    return close + 1
}

// Index of a top-level `drop` keyword followed by `{` in body (open,close), or -1.
fn find_drop(toks: List<Tok>, open: Int, close: Int) -> Int {
    let mut depth = 0
    let mut i = open + 1
    while i < close {
        if at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks, i, word: "drop") {
            return i
        }
        i = i + 1
    }
    return -1
}

// One field `name: [handle|weak] Type [= default]` on the line ending at lineEnd.
fn emit_field(out: mut StringBuilder, toks: List<Tok>, start: Int, lineEnd: Int, d: Int) -> Unit {
    let name = tk_text(toks, i: start)
    let mut k = start + 2
    let mut isHandle = false
    let mut isWeak = false
    if is_kw_text(toks, i: k, word: "handle") { isHandle = true; k = k + 1 }
    else if is_kw_text(toks, i: k, word: "weak") { isWeak = true; k = k + 1 }
    let a = String.concat(left: "field name=", right: name)
    let b = String.concat(left: a, right: " handle=")
    let c = String.concat(left: b, right: boolstr(b: isHandle))
    let e2 = String.concat(left: c, right: " weak=")
    let f = String.concat(left: e2, right: boolstr(b: isWeak))
    emit_at(out: mut out, depth: d, s: f, toks, i: start)
    let afterType = emit_type_ref(out: mut out, toks, i: k, tag: "type", eff: "", d: (d + 1))
    if at_symbol(toks: toks, i: afterType, code: SYM_EQ) {
        emit(out: mut out, depth: (d + 1), s: "default")
        emit_expr(out: mut out, toks, start: (afterType + 1), end: lineEnd, d: (d + 2))
    }
    return Unit
}

fn emit_shared_field(out: mut StringBuilder, field: Field, toks: List<Tok>, start: Int, lineEnd: Int, d: Int) -> Unit {
    let mut k = start + 2
    if is_kw_text(toks, i: k, word: "handle") || is_kw_text(toks, i: k, word: "weak") { k = k + 1 }
    let a = String.concat(left: "field name=", right: field.name)
    let b = String.concat(left: a, right: " handle=")
    let c = String.concat(left: b, right: boolstr(b: field.isHandle))
    let e2 = String.concat(left: c, right: " weak=")
    let line = String.concat(left: e2, right: boolstr(b: field.isWeak))
    emit_at(out: mut out, depth: d, s: line, toks, i: start)
    let afterType = emit_type_ref(out: mut out, toks, i: k, tag: "type", eff: "", d: (d + 1))
    if at_symbol(toks: toks, i: afterType, code: SYM_EQ) {
        emit(out: mut out, depth: (d + 1), s: "default")
        emit_expr(out: mut out, toks, start: (afterType + 1), end: lineEnd, d: (d + 2))
    }
    return Unit
}

// Emit `field` children for a struct/class/resource body region [start, end),
// one field per line (mirrors parse_fields). Returns the malformed-field count.
fn emit_fields(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Int {
    let mut i = start
    let mut mal = 0
    while i < end {
        let le = stmt_end(toks, start: i, limit: end)
        if field_valid(toks, nameIdx: i, end) {
            emit_field(out: mut out, toks, start: i, lineEnd: le, d)
        } else {
            mal = mal + 1
        }
        if le > i { i = le } else { i = i + 1 }
    }
    return mal
}

// The materialized field list contains precisely the valid source fields. Keep
// malformed recovery in this serializer, but take every valid field header from
// the shared AST in source order.
fn emit_shared_fields(out: mut StringBuilder, fields: List<Field>, toks: List<Tok>, start: Int, end: Int, d: Int) -> Int {
    let mut i = start
    let mut fieldIndex = 0
    let mut mal = 0
    while i < end {
        let le = stmt_end(toks, start: i, limit: end)
        if field_valid(toks, nameIdx: i, end) {
            if fieldIndex < List.len(list: fields) {
                let field = List.get<Field>(list: fields, index: fieldIndex)
                emit_shared_field(out: mut out, field, toks, start: i, lineEnd: le, d)
                fieldIndex = fieldIndex + 1
            } else {
                emit_field(out: mut out, toks, start: i, lineEnd: le, d)
            }
        } else {
            mal = mal + 1
        }
        if le > i { i = le } else { i = i + 1 }
    }
    return mal
}

// class/struct/resource declaration. Returns the next token index.
fn emit_shared_type_decl(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let mut j = start
    let item = shared_item_at(program, toks, start, kind: ITEM_TYPE)
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    if is_kw_text(toks, i: j, word: "opaque") { j = j + 1 }
    j = j + 1
    j = j + 1
    let a = String.concat(left: "type kind=", right: item.dataKind)
    let b = String.concat(left: a, right: " name=")
    let c = String.concat(left: b, right: item.name)
    let e2 = String.concat(left: c, right: " public=")
    let f = String.concat(left: e2, right: boolstr(b: item.isPublic))
    let g = String.concat(left: f, right: " opaque=")
    let h = String.concat(left: g, right: boolstr(b: item.isOpaque))
    emit_at(out: mut out, depth: d, s: h, toks, i: start)
    let malGen = count_malformed_generics(toks, i: j)
    j = emit_generics(out: mut out, toks, i: j, d: (d + 1))
    j = emit_derives(out: mut out, toks, i: j, d: (d + 1))
    // After the name (and any generics/derives) the very next token is either the
    // body `{` or the start of the NEXT declaration — so a body exists iff that
    // token is `{`. (A raw find_block_open would borrow a LATER decl's brace for a
    // body-less declaration like `struct Picture`, swallowing everything up to it.)
    let mut openb = -1
    if at_symbol(toks: toks, i: j, code: SYM_LBRACE) { openb = j }
    if openb < 0 { return j }
    let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    let dropPos = find_drop(toks, open: openb, close)
    let mut fieldsEnd = close
    if dropPos >= 0 { fieldsEnd = dropPos }
    let malField = emit_shared_fields(out: mut out, item.fields, toks, start: (openb + 1), end: fieldsEnd, d: (d + 1))
    // Dump order (ast_oracle_dump): valid fields, then malformed-generic, then
    // malformed-field, then drop.
    emit_repeat(out: mut out, marker: "malformed-generic", n: malGen, d: (d + 1))
    emit_repeat(out: mut out, marker: "malformed-field", n: malField, d: (d + 1))
    if dropPos >= 0 {
        let dopen = find_block_open(toks, start: dropPos, limit: close)
        if dopen >= 0 {
            let dclose = find_matching(toks: toks, open: dopen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            emit(out: mut out, depth: (d + 1), s: "drop")
            emit_block(out: mut out, toks, open: dopen, close: dclose, d: (d + 2))
        }
    }
    return close + 1
}

// sum declaration. Returns the next token index.
fn emit_shared_sum(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let mut j = start
    let item = shared_item_at(program, toks, start, kind: ITEM_SUM)
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    j = j + 1
    j = j + 1
    let a = String.concat(left: "sum name=", right: item.name)
    let b = String.concat(left: a, right: " public=")
    let c = String.concat(left: b, right: boolstr(b: item.isPublic))
    emit_at(out: mut out, depth: d, s: c, toks, i: start)
    j = emit_generics(out: mut out, toks, i: j, d: (d + 1))
    j = emit_derives(out: mut out, toks, i: j, d: (d + 1))
    // After the name (and any generics/derives) the very next token is either the
    // body `{` or the start of the NEXT declaration — so a body exists iff that
    // token is `{`. (A raw find_block_open would borrow a LATER decl's brace for a
    // body-less declaration like `struct Picture`, swallowing everything up to it.)
    let mut openb = -1
    if at_symbol(toks: toks, i: j, code: SYM_LBRACE) { openb = j }
    if openb < 0 { return j }
    let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    // Variants: newline-separated `Name` or `Name(fields)`.
    let mut i = openb + 1
    let mut variantIndex = 0
    while i < close {
        if is_ident_tok(toks: toks, i: i) {
            let mut vname = tk_text(toks, i)
            let mut variantFields = List<Field>.new()
            if variantIndex < List.len(list: item.variants) {
                let variant = List.get<Variant>(list: item.variants, index: variantIndex)
                vname = variant.name
                variantFields = variant.fields
                variantIndex = variantIndex + 1
            }
            emit_at(out: mut out, depth: (d + 1), s: String.concat(left: "variant name=", right: vname), toks, i)
            if at_symbol(toks: toks, i: (i + 1), code: SYM_LPAREN) {
                let vclose = find_matching(toks: toks, open: (i + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                emit_shared_variant_fields(out: mut out, variantFields, toks, open: (i + 1), close: vclose, d: (d + 2))
                i = stmt_end(toks, start: i, limit: close)
            } else {
                i = stmt_end(toks, start: i, limit: close)
            }
        } else {
            i = i + 1
        }
    }
    return close + 1
}

// Variant fields inside parens: comma-separated `name: Type`.
fn emit_variant_fields(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let fend = pick_end(comma, end: close)
        if is_ident_tok(toks: toks, i: i) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            emit_field(out: mut out, toks, start: i, lineEnd: fend, d)
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

fn emit_shared_variant_fields(out: mut StringBuilder, fields: List<Field>, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    let mut i = open + 1
    let mut fieldIndex = 0
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let fend = pick_end(comma, end: close)
        if is_ident_tok(toks: toks, i: i) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            if fieldIndex < List.len(list: fields) {
                let field = List.get<Field>(list: fields, index: fieldIndex)
                emit_shared_field(out: mut out, field, toks, start: i, lineEnd: fend, d)
                fieldIndex = fieldIndex + 1
            } else {
                emit_field(out: mut out, toks, start: i, lineEnd: fend, d)
            }
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

// const declaration. Returns the next token index.
fn emit_shared_const(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let mut j = start
    let item = shared_item_at(program, toks, start, kind: ITEM_CONST)
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    j = j + 1
    let nameEnd = take_function_name(toks: toks, i: j)
    let e = stmt_end(toks, start, limit: List.len(list: toks))
    let a = String.concat(left: "const name=", right: item.name)
    let b = String.concat(left: a, right: " public=")
    let c = String.concat(left: b, right: boolstr(b: item.isPublic))
    emit_at(out: mut out, depth: d, s: c, toks, i: start)
    let mut k = nameEnd
    if at_symbol(toks: toks, i: k, code: SYM_COLON) {
        k = emit_type_ref(out: mut out, toks, i: (k + 1), tag: "type", eff: "", d: (d + 1))
    }
    let asg = top_assign(toks, start: k, end: e)
    if asg >= 0 {
        emit(out: mut out, depth: (d + 1), s: "value")
        emit_expr(out: mut out, toks, start: (asg + 1), end: e, d: (d + 2))
    }
    return e
}

// type alias declaration. Returns the next token index.
fn emit_shared_type_alias(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let mut j = start
    let item = shared_item_at(program, toks, start, kind: ITEM_TYPE_ALIAS)
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    j = j + 1
    j = j + 1
    let e = stmt_end(toks, start, limit: List.len(list: toks))
    let a = String.concat(left: "type-alias name=", right: item.name)
    let b = String.concat(left: a, right: " public=")
    let c = String.concat(left: b, right: boolstr(b: item.isPublic))
    emit_at(out: mut out, depth: d, s: c, toks, i: start)
    j = emit_generics(out: mut out, toks, i: j, d: (d + 1))
    let asg = top_assign(toks, start: j, end: e)
    if asg >= 0 {
        emit_type_ref(out: mut out, toks, i: (asg + 1), tag: "target", eff: "", d: (d + 1))
    }
    return e
}

// module declaration: `module a.b.c`.
fn shared_item_at(program: Program, toks: List<Tok>, start: Int, kind: Int) -> Item {
    let token = List.get<Tok>(list: toks, index: start)
    // Program items are appended in source order, including protocol methods
    // directly after their owning protocol. A linear lookup here used to copy
    // every preceding Item (and its nested Lists) for every rendered
    // declaration. Large self-hosted tools have hundreds of declarations, so
    // binary-search by the source token before copying the one matching item.
    let mut low = 0
    let mut high = Program.len(self: program)
    while low < high {
        let mid = low + (high - low) / 2
        let item = List.get<Item>(list: program.items, index: mid)
        if item.line < token.line || (item.line == token.line && item.column < token.col) {
            low = mid + 1
        } else {
            high = mid
        }
    }
    if low < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: low)
        if item.kind == kind && item.line == token.line && item.column == token.col && item.length == token.len {
            return item
        }
    }
    local missing = ""
    return Item.plain(kind: ITEM_UNKNOWN, name: take missing, line: 0, column: 0, length: 0)
}

// Module/use are the first AST-dump nodes rendered from the materialized
// Program. The legacy cursor remains only to advance this streaming serializer;
// its semantic payload must come from the shared parser.
fn emit_shared_module(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let e = declaration_line_end(toks: toks, start: start)
    let item = shared_item_at(program, toks, start, kind: ITEM_MODULE)
    emit_at(out: mut out, depth: d, s: String.concat(left: "module path=", right: item.name), toks, i: start)
    return e
}

// use declaration: `use a.b.c [as alias]` or `use a.b.*`.
fn emit_shared_use(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    // A glob `*` is part of a declaration, never an expression continuation.
    let e = declaration_line_end(toks: toks, start: start)
    let item = shared_item_at(program, toks, start, kind: ITEM_USE)
    let a = String.concat(left: "use path=", right: item.name)
    let b = String.concat(left: a, right: " glob=")
    let mut line = String.concat(left: b, right: boolstr(b: item.useGlob))
    if String.len(value: item.useAlias) > 0 {
        let l2 = String.concat(left: line, right: " alias=")
        line = String.concat(left: l2, right: item.useAlias)
    }
    emit_at(out: mut out, depth: d, s: line, toks, i: start)
    return e
}

// -------------------------------------------------------------------------
// match (statement + expression) and patterns.
// -------------------------------------------------------------------------

// First top-level symbol with `code` in [start, end), or -1.
fn find_top_sym(toks: List<Tok>, start: Int, end: Int, code: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: i, code: code) {
            return i
        }
        i = i + 1
    }
    return -1
}

// First top-level `if` keyword in [start, end), or -1.
fn find_top_if(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks, i, word: "if") {
            return i
        }
        i = i + 1
    }
    return -1
}

// The matching '{' for the '}' at close, scanning back to start, or -1.
fn matching_open_brace(toks: List<Tok>, close: Int, start: Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: toks, i: i, code: SYM_RBRACE) { depth = depth + 1 }
        else if at_symbol(toks: toks, i: i, code: SYM_LBRACE) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

// End index of a dotted pattern/name head starting at `start` (Ident(.Ident)*).
fn dotted_name_end(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut j = start + 1
    let mut going = true
    while going {
        if j + 1 < end && at_symbol(toks: toks, i: j, code: SYM_DOT) && is_ident_tok(toks: toks, i: (j + 1)) {
            j = j + 2
        } else {
            going = false
        }
    }
    return j
}

// True if the name's first char is ASCII-uppercase (constructor-like).
fn is_upper_first(name: String) -> Bool {
    let cs = String.chars(value: name)
    if List.len(list: cs) == 0 { return false }
    let c0 = List.get(list: cs, index: 0)
    let code = Char.to_code(value: c0)
    return code >= 65 && code <= 90
}

fn emit_match(out: mut StringBuilder, toks: List<Tok>, matchPos: Int, braceOpen: Int, braceClose: Int, tag: String, d: Int) -> Unit {
    let mut vstart = matchPos + 1
    let eff = effect_kw(toks, i: vstart)
    let mut line = tag
    if String.len(value: eff) > 0 {
        let l2 = String.concat(left: tag, right: " effect=")
        line = String.concat(left: l2, right: eff)
        vstart = vstart + 1
    }
    emit_at(out: mut out, depth: d, s: line, toks, i: matchPos)
    emit(out: mut out, depth: (d + 1), s: "value")
    emit_expr(out: mut out, toks, start: vstart, end: braceOpen, d: (d + 2))
    emit_match_arms(out: mut out, toks, start: (braceOpen + 1), end: braceClose, d: (d + 1))
    return Unit
}

fn emit_match_arms(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    let mut i = start
    let mut mal = 0
    while i < end {
        // Skip separators between arms (`,`/`;`) so a trailing comma after an arm's
        // `{ }` block isn't misread as an arm with no `=>`.
        if at_symbol(toks: toks, i: i, code: SYM_SEMI) || at_symbol(toks: toks, i: i, code: SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: toks, start: i, end: end)
            let arrow = find_top_sym(toks, start: i, end: lineEnd, code: SYM_FATARROW)
            if arrow < 0 {
                // Malformed arm (no `=>`) — counted; the oracle dumps malformed-arm
                // markers AFTER all valid arms.
                mal = mal + 1
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks, start: i, end: arrow)
                let mut patEnd = arrow
                if ifPos >= 0 { patEnd = ifPos }
                emit_at(out: mut out, depth: d, s: "arm", toks, i)
                emit(out: mut out, depth: (d + 1), s: "pattern")
                emit_pattern(out: mut out, toks, start: i, end: patEnd, d: (d + 2))
                if ifPos >= 0 {
                    emit(out: mut out, depth: (d + 1), s: "guard")
                    emit_expr(out: mut out, toks, start: (ifPos + 1), end: arrow, d: (d + 2))
                }
                let bodyStart = arrow + 1
                if at_symbol(toks: toks, i: bodyStart, code: SYM_LBRACE) {
                    let bclose = find_matching(toks: toks, open: bodyStart, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    emit_block(out: mut out, toks, open: bodyStart, close: bclose, d: (d + 1))
                    i = bclose + 1
                } else {
                    let bEnd = next_line_or_block_end(toks: toks, start: bodyStart, end: end)
                    emit(out: mut out, depth: (d + 1), s: "block")
                    emit_stmt(out: mut out, toks, start: bodyStart, limit: bEnd, d: (d + 2))
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    emit_repeat(out: mut out, marker: "malformed-arm", n: mal, d)
    return Unit
}

fn emit_pattern(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    // Tuple pattern `(p0, .., pN)` (>=2 elements) — checked before paren-trim, which
    // would otherwise strip the wrapping parens. Desugars to a `__TupleN` struct.
    if at_symbol(toks: toks, i: start, code: SYM_LPAREN) && at_symbol(toks: toks, i: (end - 1), code: SYM_RPAREN) {
        let tclose = find_matching(toks: toks, open: start, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if tclose == end - 1 && count_pat_elems(toks, open: start, close: tclose) >= 2 {
            emit_tuple(out: mut out, toks, open: start, close: tclose, d)
            return Unit
        }
    }
    // List / slice pattern `[a, ..rest, z]`.
    if at_symbol(toks: toks, i: start, code: SYM_LBRACKET) && at_symbol(toks: toks, i: (end - 1), code: SYM_RBRACKET) {
        let lclose = find_matching(toks: toks, open: start, openSym: SYM_LBRACKET, closeSym: SYM_RBRACKET)
        if lclose == end - 1 {
            emit_list_pattern(out: mut out, toks, open: start, close: lclose, d)
            return Unit
        }
    }
    // Trim wrapping parens.
    let mut s = start
    let mut e = end
    let mut trimming = true
    while trimming {
        if s < e && at_symbol(toks: toks, i: s, code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: s, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close == e - 1 { s = s + 1; e = close } else { trimming = false }
        } else { trimming = false }
    }
    if s >= e { emit(out: mut out, depth: d, s: "pat-wildcard"); return Unit }
    // Single-token: literal / wildcard / bare variant.
    if s + 1 == e {
        let k = tk_kind(toks: toks, i: s)
        let t = tk_text(toks, i: s)
        if k == TOK_NUMBER { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=int ", right: escape(s: t))); return Unit }
        if k == TOK_STRING { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=string ", right: escape(s: t))); return Unit }
        if k == TOK_CHAR { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=char ", right: escape(s: t))); return Unit }
        if t == "true" || t == "false" { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=bool ", right: t)); return Unit }
        if t == "_" { emit(out: mut out, depth: d, s: "pat-wildcard"); return Unit }
        emit(out: mut out, depth: d, s: String.concat(left: "pat-variant name=", right: t))
        return Unit
    }
    // Dotted head.
    let headEnd = dotted_name_end(toks, start: s, end: e)
    let name = dotted_text(toks, start: s, end: headEnd)
    if at_symbol(toks: toks, i: headEnd, code: SYM_LBRACE) {
        let close = find_matching(toks: toks, open: headEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        let rest = struct_pattern_has_rest(toks, open: headEnd, close)
        let a = String.concat(left: "pat-struct name=", right: name)
        let b = String.concat(left: a, right: " rest=")
        let c = String.concat(left: b, right: boolstr(b: rest))
        emit(out: mut out, depth: d, s: c)
        emit_struct_fields(out: mut out, toks, open: headEnd, close, d: (d + 1))
        return Unit
    }
    if at_symbol(toks: toks, i: headEnd, code: SYM_LPAREN) {
        let close = find_matching(toks: toks, open: headEnd, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        emit(out: mut out, depth: d, s: String.concat(left: "pat-variant name=", right: name))
        let mut k = headEnd + 1
        while k < close {
            let comma = split_comma(toks, start: k, end: close)
            let elEnd = pick_end(comma, end: close)
            emit_payload_element(out: mut out, toks, start: k, end: elEnd, d: (d + 1))
            if comma < 0 { k = close } else { k = comma + 1 }
        }
        return Unit
    }
    // Bare (possibly dotted) name → variant with no bindings.
    emit(out: mut out, depth: d, s: String.concat(left: "pat-variant name=", right: name))
    return Unit
}

// A payload element: single-token disambiguates binding/literal/constructor;
// multi-token is a nested pattern.
fn emit_payload_element(out: mut StringBuilder, toks: List<Tok>, start: Int, end: Int, d: Int) -> Unit {
    if start + 1 == end {
        let k = tk_kind(toks: toks, i: start)
        let t = tk_text(toks, i: start)
        if k == TOK_NUMBER { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=int ", right: escape(s: t))); return Unit }
        if k == TOK_STRING { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=string ", right: escape(s: t))); return Unit }
        if k == TOK_CHAR { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=char ", right: escape(s: t))); return Unit }
        if t == "true" || t == "false" { emit(out: mut out, depth: d, s: String.concat(left: "pat-literal kind=bool ", right: t)); return Unit }
        if t == "_" { emit(out: mut out, depth: d, s: "pat-wildcard"); return Unit }
        if is_upper_first(name: t) {
            emit(out: mut out, depth: d, s: String.concat(left: "pat-variant name=", right: t))
        } else {
            emit(out: mut out, depth: d, s: String.concat(left: "pat-binding name=", right: t))
        }
        return Unit
    }
    emit_pattern(out: mut out, toks, start, end, d)
    return Unit
}

// True if the struct-pattern body (open,close) contains a top-level `..` rest.
fn struct_pattern_has_rest(toks: List<Tok>, open: Int, close: Int) -> Bool {
    let mut i = open + 1
    while i < close {
        if at_symbol(toks: toks, i: i, code: SYM_DOT) && at_symbol(toks: toks, i: (i + 1), code: SYM_DOT) {
            return true
        }
        i = i + 1
    }
    return false
}

// Struct-pattern fields: `name` | `name: _` | `name: [effect] binding|pattern`.
fn emit_struct_fields(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks, start: i, end: close)
        let fEnd = pick_end(comma, end: close)
        // Skip a `..` rest segment.
        if at_symbol(toks: toks, i: i, code: SYM_DOT) {
            // rest, already reflected in rest=; emit nothing
            let x = 0
        } else if is_ident_tok(toks: toks, i: i) {
            let fname = tk_text(toks, i)
            let colon = find_top_sym(toks, start: i, end: fEnd, code: SYM_COLON)
            if colon < 0 {
                // shorthand `name` → binding=name
                let a = String.concat(left: "pat-field name=", right: fname)
                let b = String.concat(left: a, right: " ignored=false binding=")
                emit(out: mut out, depth: d, s: String.concat(left: b, right: fname))
            } else {
                emit_struct_field_rhs(out: mut out, toks, fname, rhsStart: (colon + 1), fEnd, d)
            }
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

fn emit_struct_field_rhs(out: mut StringBuilder, toks: List<Tok>, fname: String, rhsStart: Int, fEnd: Int, d: Int) -> Unit {
    // `name: _` → ignored.
    if rhsStart + 1 == fEnd && is_kw_text(toks, i: rhsStart, word: "_") {
        let a = String.concat(left: "pat-field name=", right: fname)
        emit(out: mut out, depth: d, s: String.concat(left: a, right: " ignored=true"))
        return Unit
    }
    // Optional effect prefix.
    let mut bstart = rhsStart
    let eff = effect_kw(toks, i: rhsStart)
    if String.len(value: eff) > 0 { bstart = rhsStart + 1 }
    let a = String.concat(left: "pat-field name=", right: fname)
    let mut head = String.concat(left: a, right: " ignored=false")
    if bstart + 1 == fEnd {
        let t = tk_text(toks, i: bstart)
        let k = tk_kind(toks: toks, i: bstart)
        let isLit = k == TOK_NUMBER || k == TOK_STRING || k == TOK_CHAR || t == "true" || t == "false"
        if isLit || is_upper_first(name: t) {
            // literal/constructor → nested pattern child, no binding=
            if String.len(value: eff) > 0 { head = add_effect(line: head, eff) }
            emit(out: mut out, depth: d, s: head)
            emit_payload_element(out: mut out, toks, start: bstart, end: fEnd, d: (d + 1))
            return Unit
        }
        // binding
        head = String.concat(left: head, right: " binding=")
        head = String.concat(left: head, right: t)
        if String.len(value: eff) > 0 { head = add_effect(line: head, eff) }
        emit(out: mut out, depth: d, s: head)
        return Unit
    }
    // Nested multi-token pattern.
    if String.len(value: eff) > 0 { head = add_effect(line: head, eff) }
    emit(out: mut out, depth: d, s: head)
    emit_pattern(out: mut out, toks, start: bstart, end: fEnd, d: (d + 1))
    return Unit
}

fn add_effect(line: String, eff: String) -> String {
    let a = String.concat(left: line, right: " effect=")
    return String.concat(left: a, right: eff)
}

// Count comma-separated pattern elements in (open, close).
fn count_pat_elems(toks: List<Tok>, open: Int, close: Int) -> Int {
    let mut n = 0
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        n = n + 1
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return n
}

// Tuple pattern → `pat-struct name=__TupleN rest=false` with item0..itemN fields
// (element mapping identical to a struct-field RHS; no effects).
fn emit_tuple(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    let n = count_pat_elems(toks, open, close)
    let hdr = String.concat(left: String.concat(left: "pat-struct name=__Tuple", right: String.from_int(value: n)), right: " rest=false")
    emit(out: mut out, depth: d, s: hdr)
    let mut k = open + 1
    let mut idx = 0
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let elEnd = pick_end(comma, end: close)
        let fname = String.concat(left: "item", right: String.from_int(value: idx))
        emit_struct_field_rhs(out: mut out, toks, fname, rhsStart: k, fEnd: elEnd, d: (d + 1))
        idx = idx + 1
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// True if the comma-segment at [segStart, segEnd) is a `..`/`..name` rest segment.
fn is_rest_segment(toks: List<Tok>, segStart: Int) -> Bool {
    return at_symbol(toks: toks, i: segStart, code: SYM_DOT) && at_symbol(toks: toks, i: (segStart + 1), code: SYM_DOT)
}

// List pattern: `rest=none|ignore|NAME`, with non-empty `list-prefix`/`list-suffix`.
fn emit_list_pattern(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, d: Int) -> Unit {
    // Pass 1: find the rest segment and its rendered name.
    let mut restStart = -1
    let mut restStr = "none"
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let segEnd = pick_end(comma, end: close)
        if is_rest_segment(toks, segStart: k) {
            restStart = k
            let aft = k + 2
            if aft >= segEnd { restStr = "ignore" }
            else if is_kw_text(toks, i: aft, word: "_") { restStr = "ignore" }
            else if is_ident_tok(toks: toks, i: aft) { restStr = tk_text(toks, i: aft) }
            else { restStr = "ignore" }
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    emit(out: mut out, depth: d, s: String.concat(left: "pat-list rest=", right: restStr))
    // Prefix: elements before the rest (or all elements when there is no rest).
    let prefixCount = count_list_side(toks, open, close, restStart, before: true)
    if prefixCount > 0 {
        emit(out: mut out, depth: (d + 1), s: "list-prefix")
        emit_list_side(out: mut out, toks, open, close, restStart, before: true, d: (d + 2))
    }
    // Suffix: elements after the rest.
    if restStart >= 0 {
        let suffixCount = count_list_side(toks, open, close, restStart, before: false)
        if suffixCount > 0 {
            emit(out: mut out, depth: (d + 1), s: "list-suffix")
            emit_list_side(out: mut out, toks, open, close, restStart, before: false, d: (d + 2))
        }
    }
    return Unit
}

// Whether the element starting at k falls on the requested side of the rest.
// (rss has no if-expression, so this is a helper rather than an inline ternary.)
fn on_list_side(restStart: Int, k: Int, before: Bool) -> Bool {
    if before { return restStart < 0 || k < restStart }
    return restStart >= 0 && k > restStart
}

// Count list elements on one side of the rest (before/after), excluding the rest.
fn count_list_side(toks: List<Tok>, open: Int, close: Int, restStart: Int, before: Bool) -> Int {
    let mut n = 0
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let isRest = k == restStart
        let onSide = on_list_side(restStart, k, before)
        if !isRest  && onSide { n = n + 1 }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return n
}

fn emit_list_side(out: mut StringBuilder, toks: List<Tok>, open: Int, close: Int, restStart: Int, before: Bool, d: Int) -> Unit {
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks, start: k, end: close)
        let segEnd = pick_end(comma, end: close)
        let isRest = k == restStart
        let onSide = on_list_side(restStart, k, before)
        if !isRest  && onSide {
            emit_payload_element(out: mut out, toks, start: k, end: segEnd, d)
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Driver.
// -------------------------------------------------------------------------

fn main(args: read List<String>) -> Unit {
    let source = Arguments.get_or_default(args: read args, index: 0, default: "")
    let toks = tokenize(source: source)
    local out = StringBuilder.new()
    // The streaming renderer below owns body traversal. Header-only parsing
    // preserves the shared declaration facts without paying for a second full
    // body AST on large inputs.
    let program = parse_program_headers(toks: toks)
    let ntok = List.len(list: toks)
    emit(out: mut out, depth: 0, s: "program")
    let mut i = 0
    let mut malDecl = 0
    let mut unknownTop = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else if at_symbol(toks: toks, i: i, code: SYM_SEMI) {
            i = i + 1
        } else {
            let cls = classify_top(toks: toks, i: i)
            if starts_type_decl(toks: toks, i: i, isPub: cls.isPub) {
                // A struct/class/resource with no name (`struct {`) fails to parse →
                // program-level malformed-declaration.
                if type_decl_malformed(toks, start: i) {
                    malDecl = malDecl + 1
                    i = advance(toks, i, r: next_decl_skip(toks, start: i))
                } else {
                    i = advance(toks, i, r: emit_shared_type_decl(out: mut out, program, toks, start: i, d: 1))
                }
            } else if cls.isSum {
                i = advance(toks, i, r: emit_shared_sum(out: mut out, program, toks, start: i, d: 1))
            } else if cls.isTypeAlias {
                i = advance(toks, i, r: emit_shared_type_alias(out: mut out, program, toks, start: i, d: 1))
            } else if cls.isConst {
                i = advance(toks, i, r: emit_shared_const(out: mut out, program, toks, start: i, d: 1))
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                i = advance(toks, i, r: emit_shared_module(out: mut out, program, toks, start: i, d: 1))
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                i = advance(toks, i, r: emit_shared_use(out: mut out, program, toks, start: i, d: 1))
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                // Protocol methods become top-level functions emitted in source order;
                // the `protocol <name>` line is emitted later (protocols section).
                i = advance(toks, i, r: emit_protocol(out: mut out, program, toks, start: i, d: 1))
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                // Implementations emit in the protocol-impls section later.
                i = advance(toks, i, r: next_decl_skip(toks, start: i))
            } else if starts_fn_like(toks: toks, i: i, isPub: cls.isPub) {
                // A fn whose name won't parse (`fn (…)`) is a program-level malformed
                // declaration (parse_function_decl returns None) — counted for the
                // section-5 marker, not emitted as a fn.
                if fn_malformed(toks, start: i) {
                    malDecl = malDecl + 1
                    i = advance(toks, i, r: next_decl_skip(toks, start: i))
                } else {
                    i = advance(toks, i, r: emit_function(out: mut out, program, toks, start: i, d: 1, protoName: ""))
                }
            } else {
                // Unrecognized top-level token (e.g. `namespace …`) → unknown-top-level.
                unknownTop = unknownTop + 1
                i = advance(toks, i, r: next_decl_skip(toks, start: i))
            }
        }
    }
    // Sections 3 & 4: protocol names, then protocol-impls (after all items).
    emit_protocols_pass(out: mut out, program)
    emit_impls_pass(out: mut out, program)
    // Section 5: unknown top-level input, then malformed declarations.
    emit_repeat(out: mut out, marker: "unknown-top-level", n: unknownTop, d: 1)
    emit_repeat(out: mut out, marker: "malformed-declaration", n: malDecl, d: 1)
    let rendered = StringBuilder.finish(builder: take out)
    // `emit` stores a newline after every logical dump line. `Output.write` owns
    // the protocol's one final newline, so drop only that trailing separator.
    let renderedLen = String.len(value: rendered)
    if renderedLen > 0 {
        Output.write(message: String.slice(value: rendered, start: 0, len: (renderedLen - 1)))
    }
    return Unit
}

// Emit a protocol's methods in place as top-level functions (Protocol.method,
// public, Self:Managed injected); the `protocol <name>` line is a later pass.
fn emit_protocol(out: mut StringBuilder, program: Program, toks: List<Tok>, start: Int, d: Int) -> Int {
    let pname = tk_text(toks, i: (start + 1))
    let n = List.len(list: toks)
    let open = find_block_open(toks, start: (start + 1), limit: n)
    if open < 0 { return next_decl_skip(toks, start) }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    let mut i = open + 1
    while i < close {
        if at_symbol(toks: toks, i: i, code: SYM_SEMI) {
            i = i + 1
        } else if fn_malformed(toks, start: i) {
            let r = next_decl_skip(toks, start: i)
            if r > close { i = close } else if r <= i { i = i + 1 } else { i = r }
        } else {
            let r = emit_function(out: mut out, program, toks, start: i, d, protoName: pname)
            if r > close { i = close } else if r <= i { i = i + 1 } else { i = r }
        }
    }
    return close + 1
}

// Protocols section: emit `protocol <name>` for each top-level protocol.
fn emit_protocols_pass(out: mut StringBuilder, program: Program) -> Unit {
    let mut i = 0
    while i < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: i)
        if item.kind == ITEM_PROTOCOL { emit(out: mut out, depth: 1, s: String.concat(left: "protocol ", right: item.protocol)) }
        i = i + 1
    }
    return Unit
}

// Protocol-impls section: `protocol-impl protocol=P type=T` + `mapping method=m target=t`.
fn emit_impls_pass(out: mut StringBuilder, program: Program) -> Unit {
    let mut i = 0
    while i < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: i)
        if item.kind == ITEM_IMPL {
            let head = String.concat(left: String.concat(left: "protocol-impl protocol=", right: item.protocol), right: String.concat(left: " type=", right: item.implType))
            emit(out: mut out, depth: 1, s: head)
            let mut mapping = 0
            while mapping < List.len(list: item.mappings) {
                let entry = List.get<ProtocolMapping>(list: item.mappings, index: mapping)
                let line = String.concat(left: String.concat(left: "mapping method=", right: entry.method), right: String.concat(left: " target=", right: entry.target))
                emit(out: mut out, depth: 2, s: line)
                mapping = mapping + 1
            }
        }
        i = i + 1
    }
    return Unit
}

// Emit one `impl Protocol for Type { method = target … }` (parse_protocol_impl_decl).
fn emit_one_impl(out: mut StringBuilder, toks: List<Tok>, start: Int, ntok: Int) -> Unit {
    let proto = tk_text(toks, i: (start + 1))
    if is_kw_text(toks, i: (start + 2), word: "for") == false { return Unit }
    let typeEnd = take_function_name(toks: toks, i: (start + 3))
    if typeEnd < 0 { return Unit }
    let typeName = dotted_text(toks, start: (start + 3), end: typeEnd)
    let open = find_block_open(toks, start: typeEnd, limit: ntok)
    if open < 0 { return Unit }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    emit(out: mut out, depth: 1, s: String.concat(left: String.concat(left: String.concat(left: "protocol-impl protocol=", right: proto), right: " type="), right: typeName))
    let mut k = open + 1
    while k < close {
        if is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_EQ) {
            let method = tk_text(toks, i: k)
            let tEnd = take_function_name(toks: toks, i: (k + 2))
            if tEnd < 0 {
                k = k + 1
            } else {
                let target = dotted_text(toks, start: (k + 2), end: tEnd)
                emit(out: mut out, depth: 2, s: String.concat(left: String.concat(left: String.concat(left: "mapping method=", right: method), right: " target="), right: target))
                k = tEnd
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// True if a struct/class/resource declaration at `start` has no name (`struct {`),
// which parse_type_decl rejects → program-level malformed-declaration.
fn type_decl_malformed(toks: List<Tok>, start: Int) -> Bool {
    let mut j = start
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    if is_kw_text(toks, i: j, word: "opaque") { j = j + 1 }
    j = j + 1
    return is_ident_tok(toks: toks, i: j) == false
}

// Position of the function name (just past `fn`) after skipping #attrs and
// pub/async, or -1 if this isn't a fn-like head.
fn fn_name_start(toks: List<Tok>, start: Int) -> Int {
    let mut j = start
    while at_symbol(toks: toks, i: j, code: SYM_HASH) { j = j + 5 }
    if is_kw_text(toks, i: j, word: "pub") { j = j + 1 }
    if is_kw_text(toks, i: j, word: "async") { j = j + 1 }
    if is_kw_text(toks, i: j, word: "fn") == false { return -1 }
    return j + 1
}

// True if a fn head at `start` fails to parse (parse_function_decl returns None):
// no name, unclosed params `(`, or a body `{` with no matching `}`.
fn fn_malformed(toks: List<Tok>, start: Int) -> Bool {
    let ns = fn_name_start(toks, start)
    if ns < 0 { return false }
    let nameEnd = take_function_name(toks: toks, i: ns)
    if nameEnd < 0 { return true }
    let popen = parse_generic_params(toks: toks, i: nameEnd)
    let mut sigStart = popen
    if at_symbol(toks: toks, i: popen, code: SYM_LPAREN) {
        let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if pclose < 0 { return true }
        sigStart = pclose + 1
    }
    let sigEnd = function_signature_end(toks: toks, start: sigStart)
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) {
        if find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE) < 0 {
            return true
        }
    }
    return false
}

// Progress guard: never let the driver stall on a decl that returned <= i.
fn advance(toks: List<Tok>, i: Int, r: Int) -> Int {
    if r > i { return r }
    return i + 1
}

// Skip an unsupported top-level item: to its block end if it has one, else its line end.
// Skip an unknown/malformed top-level declaration (mirrors skip_unknown_top_level):
// if the declaration line opens a `{`, skip to its matching `}` (or to EOF when it
// never closes); otherwise skip to the declaration line end.
fn next_decl_skip(toks: List<Tok>, start: Int) -> Int {
    let n = List.len(list: toks)
    let lineEnd = declaration_line_end(toks: toks, start: start)
    let openb = find_block_open(toks, start, limit: lineEnd)
    let mut r = lineEnd
    if openb >= 0 {
        let close = find_matching(toks: toks, open: openb, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if close < 0 { r = n } else { r = close + 1 }
    }
    if r > start { return r }
    return start + 1
}
