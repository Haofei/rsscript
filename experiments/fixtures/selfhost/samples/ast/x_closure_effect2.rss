class Scheduler {
    callbacks: List<Callback>
}

struct Picture {
    pixels: Buffer
}

fn schedule(scheduler: mut Scheduler, callback: Callback) -> Unit
    retains(callback)
{
}

fn bad_schedule(scheduler: mut Scheduler, path: Path) -> Unit {
    local image = Picture.load(path)
    schedule(
        scheduler: mut scheduler,
        callback: || {
            Picture.inspect(image)
        },
    )
}
