// JIT hot path: native parent calls a compiled child with a Bool parameter and
// Bool return, then consumes that result in native control flow. This pins the
// staged native-call ABI for Bool values instead of relying on the Int encoding
// accidentally working.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn matches(flag: Bool, value: Int) -> Bool {
    let over = value > 10
    return flag == over
}

fn hot(limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        let ok = matches(flag: true, value: i % 23)
        if ok {
            total = total + i
        } else {
            total = total - 1
        }
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 750000)
    let result = hot(limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
