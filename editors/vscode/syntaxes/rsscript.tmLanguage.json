{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "RsScript",
  "scopeName": "source.rsscript",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#function-definition"
    },
    {
      "include": "#named-arguments"
    },
    {
      "include": "#call"
    },
    {
      "include": "#types"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.rsscript",
          "begin": "//",
          "end": "$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.rsscript",
          "begin": "\"\"\"",
          "end": "\"\"\""
        },
        {
          "name": "string.quoted.double.rsscript",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.rsscript",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.rsscript",
          "match": "\\b[0-9][0-9]*(\\.[0-9]+)?\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.rsscript",
          "match": "\\b(if|else|for|in|match|loop|while|break|continue|return|await)\\b"
        },
        {
          "name": "keyword.declaration.rsscript",
          "match": "\\b(features|class|struct|resource|handle|fn|let)\\b"
        },
        {
          "name": "storage.modifier.rsscript",
          "match": "\\b(pub|async|effects|drop|with|as|native)\\b"
        },
        {
          "name": "storage.modifier.ownership.rsscript",
          "match": "\\b(read|mut|take|fresh|manage|weak|local)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.rsscript",
          "match": "\\b(true|false|Ok|Err|Some|None|Unit)\\b"
        }
      ]
    },
    "function-definition": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+(?:([A-Z][A-Za-z0-9_]*)\\s*(\\.))?([a-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.declaration.rsscript"
            },
            "2": {
              "name": "entity.name.type.rsscript"
            },
            "3": {
              "name": "punctuation.accessor.rsscript"
            },
            "4": {
              "name": "entity.name.function.rsscript"
            }
          }
        }
      ]
    },
    "named-arguments": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": {
              "name": "variable.parameter.rsscript"
            },
            "2": {
              "name": "punctuation.separator.rsscript"
            }
          }
        }
      ]
    },
    "call": {
      "patterns": [
        {
          "match": "(?:([A-Z][A-Za-z0-9_]*)\\s*(\\.))?([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": {
              "name": "entity.name.type.rsscript"
            },
            "2": {
              "name": "punctuation.accessor.rsscript"
            },
            "3": {
              "name": "entity.name.function.call.rsscript"
            }
          }
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.rsscript",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.arrow.rsscript",
          "match": "->"
        },
        {
          "name": "keyword.operator.error-propagation.rsscript",
          "match": "\\?"
        },
        {
          "name": "keyword.operator.rsscript",
          "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/=<>!&])"
        }
      ]
    }
  }
}
