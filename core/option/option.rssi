pub fn Option.is_some<T>(value: read Option<T>) -> Bool
    effects(pure)

pub fn Option.is_none<T>(value: read Option<T>) -> Bool
    effects(pure)

pub fn Option.unwrap_or<T>(value: read Option<T>, default: read T) -> T
    effects(pure)

pub fn Option.map<T, U>(
    value: read Option<T>,
    mapper: noescape Fn(T) -> U,
) -> Option<U>

pub fn Option.and_then<T, U>(
    value: read Option<T>,
    mapper: noescape Fn(T) -> Option<U>,
) -> Option<U>

pub fn Option.ok_or<T, E>(
    value: read Option<T>,
    error: read E,
) -> Result<T, E>

pub fn Option.or<T>(
    value: read Option<T>,
    fallback: read Option<T>,
) -> Option<T>

pub fn Option.filter<T>(
    value: read Option<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Option<T>

pub fn Option.unwrap_or_else<T>(
    value: read Option<T>,
    default: noescape Fn() -> T,
) -> T
