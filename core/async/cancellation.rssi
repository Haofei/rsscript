features: native

// Structured cancellation split into a capability and an observation ticket.
//
// `CancellationSource` is the cancel *capability*: only a holder of
// `mut CancellationSource` can trigger cancellation, so "who can cancel" is
// visible in signatures. `CancellationToken` is a read-only observation ticket
// handed out by the source; it can be passed to workers and loops to check
// cancellation but carries no cancel power. Both share the same flag, so
// cancelling the source is observed by every token derived from it.
//
// Note: while RSScript's resource/capability-object machinery matures these are
// managed `struct` handles; the capability rule is enforced by the `mut source`
// requirement on `cancel`. They are expected to tighten into a real
// `resource CancellationSource` later.

struct CancellationSource
struct CancellationToken

pub native fn CancellationSource.new() -> fresh CancellationSource
    effects(native)

pub native fn CancellationSource.token(source: read CancellationSource) -> fresh CancellationToken
    effects(native)

pub native fn CancellationSource.cancel(source: mut CancellationSource) -> Unit
    effects(native)

pub native fn CancellationToken.is_cancelled(token: read CancellationToken) -> Bool
    effects(native)
