features: native

struct Deadline

pub native fn Deadline.after_ms(ms: Int) -> fresh Deadline
    effects(native)

pub native fn Deadline.after(duration: read Duration) -> fresh Deadline
    effects(native)

pub native fn Deadline.is_expired(deadline: read Deadline) -> Bool
    effects(native)

pub native fn Deadline.remaining_ms(deadline: read Deadline) -> Int
    effects(native)
