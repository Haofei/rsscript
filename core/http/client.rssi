features: native, local

struct HttpResponse
struct HttpRequest
struct HttpError

pub native fn HttpRequest.json(url: read Url, body: read String) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_timeout(
    request: take HttpRequest,
    timeout_ms: Int,
) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_retry(
    request: take HttpRequest,
    attempts: Int,
    backoff_ms: Int,
) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_header(
    request: take HttpRequest,
    name: read String,
    value: read String,
) -> fresh HttpRequest
    effects(native)

pub native fn Http.get(url: read Url) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn Http.post_json(url: read Url, body: read String) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn Http.post_form(url: read Url, body: read String) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn HttpResponse.status(response: read HttpResponse) -> Int
    effects(native)

pub native fn HttpResponse.text(response: read HttpResponse) -> fresh String
    effects(native)

pub native fn HttpResponse.lines(response: read HttpResponse) -> fresh List<String>
    effects(native)

pub native fn HttpResponse.is_success(response: read HttpResponse) -> Bool
    effects(native)

pub native fn HttpError.message(error: read HttpError) -> String
    effects(native)
