struct JsonValue
struct JsonLiteral

pub fn Json.parse(text: read String) -> Result<fresh JsonValue, JsonError>

pub fn Json.json_parse(text: read String) -> Result<fresh JsonValue, JsonError>

pub fn Json.parse_file(path: read Path) -> Result<fresh JsonValue, JsonError>

pub fn Json.value(value: read JsonLiteral) -> fresh JsonValue
    effects(pure)

pub fn Json.clone(value: read JsonValue) -> fresh JsonValue
    effects(pure)

pub fn Json.encode(value: read JsonLiteral) -> fresh String
    effects(pure)

pub fn Json.quote_string(value: read String) -> fresh String
    effects(pure)

pub fn Json.to_string(value: read JsonValue) -> fresh String
    effects(pure)

pub fn Json.string_field(name: read String, value: read String) -> fresh String
    effects(pure)

pub fn Json.int_field(name: read String, value: Int) -> fresh String
    effects(pure)

pub fn Json.bool_field(name: read String, value: Bool) -> fresh String
    effects(pure)

pub fn Json.raw_field(name: read String, value: read String) -> fresh String
    effects(pure)

pub fn Json.object(fields: read List<String>) -> fresh String
    effects(pure)

pub fn Json.array(items: read List<String>) -> fresh String
    effects(pure)

pub fn Json.string_array(items: read List<String>) -> fresh String
    effects(pure)

pub fn Json.strings(items: read List<String>) -> fresh JsonValue
    effects(pure)

pub fn Json.values(items: read List<JsonValue>) -> fresh JsonValue
    effects(pure)

pub fn Json.field(
    value: read JsonValue,
    name: read String,
) -> Result<fresh JsonValue, JsonError>

pub fn Json.field_string(
    value: read JsonValue,
    name: read String,
) -> Result<String, JsonError>

pub fn Json.field_int(
    value: read JsonValue,
    name: read String,
) -> Result<Int, JsonError>

pub fn Json.field_bool(
    value: read JsonValue,
    name: read String,
) -> Result<Bool, JsonError>

