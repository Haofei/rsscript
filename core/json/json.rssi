    value: read JsonValue,
    path: read String,
) -> Result<fresh JsonValue, JsonError>

pub fn Json.at(
    value: read JsonValue,
    path: read String,
) -> Result<fresh JsonValue, JsonError>

pub fn Json.at_or(
    value: read JsonValue,
    path: read String,
    fallback: read JsonValue,
) -> fresh JsonValue
    effects(pure)

pub fn Json.at_string(
    value: read JsonValue,
    path: read String,
) -> Result<String, JsonError>

pub fn Json.at_int(
    value: read JsonValue,
    path: read String,
) -> Result<Int, JsonError>

pub fn Json.at_bool(
    value: read JsonValue,
    path: read String,
) -> Result<Bool, JsonError>

