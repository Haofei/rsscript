features: native

pub native fn Process.run_stdout(
    command: read String,
    args: read List<String>,
) -> Result<String, String>
    effects(native)

pub native fn Process.run_stdout_timeout(
    command: read String,
    args: read List<String>,
    timeout_ms: Int,
) -> Result<String, String>
    effects(native)

pub native fn Process.run_many_stdout(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
) -> Result<List<String>, String>
    effects(native)

pub native fn Process.run_many_stdout_timeout(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
    timeout_ms: Int,
) -> Result<List<String>, String>
    effects(native)
