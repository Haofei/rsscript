features: local, native

struct StringBuilder

struct StringView

pub fn Char.is_digit(value: read Char) -> Bool
    effects(pure)

pub fn Char.is_alpha(value: read Char) -> Bool
    effects(pure)

pub fn Char.is_whitespace(value: read Char) -> Bool
    effects(pure)

pub fn Char.is_alphanumeric(value: read Char) -> Bool
    effects(pure)

pub fn Char.is_lower(value: read Char) -> Bool
    effects(pure)

pub fn Char.is_upper(value: read Char) -> Bool
    effects(pure)

pub fn Char.to_lower(value: read Char) -> Char
    effects(pure)

pub fn Char.to_upper(value: read Char) -> Char
    effects(pure)

pub fn Char.to_code(value: read Char) -> Int
    effects(pure)

pub fn Char.from_code(value: Int) -> Option<Char>
    effects(pure)

pub fn Char.compare(left: read Char, right: read Char) -> Int
    effects(pure)

pub fn Char.to_string(value: read Char) -> fresh String
    effects(pure)

pub fn String.concat(left: read String, right: read String) -> fresh String
    effects(pure)

pub fn String.copy(value: read String) -> fresh String
    effects(pure)

pub fn String.from_int(value: Int) -> fresh String
    effects(pure)

pub fn String.from_float(value: Float) -> fresh String
    effects(pure)

pub fn String.from_bool(value: Bool) -> fresh String
    effects(pure)

pub fn Int.to_string(value: read Int) -> fresh String
    effects(pure)

pub fn Float.to_string(value: read Float) -> fresh String
    effects(pure)

pub fn Float.is_nan(value: read Float) -> Bool
    effects(pure)

pub fn Float.is_finite(value: read Float) -> Bool
    effects(pure)

pub fn Float.is_infinite(value: read Float) -> Bool
    effects(pure)

pub fn Int.bit_and(left: Int, right: Int) -> Int
    effects(pure)

pub fn Int.bit_or(left: Int, right: Int) -> Int
    effects(pure)

pub fn Int.bit_xor(left: Int, right: Int) -> Int
    effects(pure)

pub fn Int.bit_not(value: Int) -> Int
    effects(pure)

pub fn Int.shift_left(value: Int, bits: Int) -> Int
    effects(pure)

pub fn Int.shift_right(value: Int, bits: Int) -> Int
    effects(pure)

pub fn String.to_path(value: read String) -> fresh Path
    effects(pure)

pub fn String.safe_relative(value: read String) -> Result<fresh Path, String>
    effects(pure)

pub fn String.to_url(value: read String) -> fresh Url
    effects(pure)

pub fn String.to_bytes(value: read String) -> fresh Bytes
    effects(pure)

pub fn String.env(value: read String) -> Option<fresh String>
    effects(native)

pub fn String.env_or(value: read String, default: read String) -> fresh String
    effects(native)

pub fn String.len(value: read String) -> Int
    effects(pure)

pub fn String.is_empty(value: read String) -> Bool
    effects(pure)

pub fn String.trim(value: read String) -> fresh String
    effects(pure)

pub fn String.trim_start(value: read String) -> fresh String
    effects(pure)

pub fn String.trim_end(value: read String) -> fresh String
    effects(pure)

pub fn String.to_lowercase(value: read String) -> fresh String
    effects(pure)

pub fn String.to_uppercase(value: read String) -> fresh String
    effects(pure)

pub fn String.replace(
    value: read String,
    from: read String,
    to: read String,
) -> fresh String
    effects(pure)

pub fn String.replace_first(
    value: read String,
    from: read String,
    to: read String,
) -> fresh String
    effects(pure)

pub fn String.count(
    value: read String,
    needle: read String,
) -> Int
    effects(pure)

pub fn String.pad_left(
    value: read String,
    width: Int,
    fill: read String,
) -> fresh String
    effects(pure)

pub fn String.pad_right(
    value: read String,
    width: Int,
    fill: read String,
) -> fresh String
    effects(pure)

pub fn String.reverse(value: read String) -> fresh String
    effects(pure)

pub fn String.char_at(
    value: read String,
    index: Int,
) -> Option<Char>
    effects(pure)

pub fn String.starts_with(
    value: read String,
    prefix: read String,
) -> Bool
    effects(pure)

pub fn String.ends_with(
    value: read String,
    suffix: read String,
) -> Bool
    effects(pure)

pub fn String.contains(
    value: read String,
    needle: read String,
) -> Bool
    effects(pure)

pub fn String.lines(value: read String) -> fresh List<String>
    effects(pure)

pub fn String.chars(value: read String) -> fresh List<Char>
    effects(pure)

pub fn String.join(
    parts: read List<String>,
    separator: read String,
) -> fresh String
    effects(pure)

pub fn String.format(
    template: read String,
    args: read List<String>,
) -> fresh String
    effects(pure)

pub fn String.strip_prefix(
    value: read String,
    prefix: read String,
) -> Option<String>
    effects(pure)

pub fn String.before(
    value: read String,
    delimiter: read String,
) -> Option<String>
    effects(pure)

pub fn String.after(
    value: read String,
    delimiter: read String,
) -> Option<String>
    effects(pure)

pub fn String.split(
    value: read String,
    delimiter: read String,
) -> fresh List<String>
    effects(pure)

pub fn String.slice(
    value: read String,
    start: Int,
    len: Int,
) -> fresh String
    effects(pure)

pub fn String.index_of(
    value: read String,
    needle: read String,
) -> Option<Int>
    effects(pure)

pub fn String.repeat(
    value: read String,
    count: Int,
) -> fresh String
    effects(pure)

pub fn String.parse_int(value: read String) -> Option<Int>
    effects(pure)

pub fn String.parse_float(value: read String) -> Option<Float>
    effects(pure)

pub fn String.view(
    value: read String,
    start: Int,
    len: Int,
) -> StringView
    effects(pure)

pub fn StringView.slice(
    value: read StringView,
    start: Int,
    len: Int,
) -> StringView
    effects(pure)

pub fn StringView.len(value: read StringView) -> Int
    effects(pure)

pub fn StringView.is_empty(value: read StringView) -> Bool
    effects(pure)

pub fn StringView.to_string(value: read StringView) -> fresh String
    effects(pure)

pub fn StringView.starts_with(
    value: read StringView,
    prefix: read String,
) -> Bool
    effects(pure)

pub fn StringView.contains(
    value: read StringView,
    needle: read String,
) -> Bool
    effects(pure)

pub fn StringView.before(
    value: read StringView,
    delimiter: read String,
) -> Option<StringView>
    effects(pure)

pub fn StringView.after(
    value: read StringView,
    delimiter: read String,
) -> Option<StringView>
    effects(pure)

pub fn StringBuilder.new() -> fresh StringBuilder

pub fn StringBuilder.push(
    builder: mut StringBuilder,
    value: read String,
) -> Unit

pub fn StringBuilder.finish(builder: take StringBuilder) -> fresh String
