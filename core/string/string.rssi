pub fn String.concat(left: read String, right: read String) -> fresh String

pub fn String.from_int(value: Int) -> fresh String

pub fn String.from_bool(value: Bool) -> fresh String

pub fn String.starts_with(
    value: read String,
    prefix: read String,
) -> Bool

pub fn String.ends_with(
    value: read String,
    suffix: read String,
) -> Bool
