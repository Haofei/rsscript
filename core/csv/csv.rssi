struct RowBuffer

struct Row

pub fn RowBuffer.new(size: Int) -> fresh RowBuffer

pub fn Csv.open_read(path: read Path) -> Result<File, CsvError>

pub fn Csv.read_into(
    file: mut File,
    buffer: mut RowBuffer,
) -> Result<Unit, CsvError>

pub fn Csv.rows(
    path: read Path,
    buffer_size: Int,
) -> Result<fresh Stream<Row>, ChannelError>

pub fn Csv.parse_row(buffer: read RowBuffer) -> Result<fresh Row, CsvError>

pub fn Row.field_string(
    row: read Row,
    index: Int,
) -> Result<String, CsvError>
