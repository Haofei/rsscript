// File-feature and removed-profile diagnostics over the shared Program.
//
// This mirrors the Rust checker boundary in crates/rsscript/src/checks/features.rs.

module selfhost.semantics.features

use selfhost.semantics.diagnostics.*
use selfhost.syntax.ast.*

fn collect_program_removed_profile_diagnostics(program: Program, diagnostics: mut DiagnosticBag) -> Unit {
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_PROFILE {
            DiagnosticBag.add(self: mut diagnostics, code: "RS0010", line: item.line, column: item.column, length: item.length)
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}

fn collect_program_feature_diagnostics(program: Program, diagnostics: mut DiagnosticBag) -> Unit {
    let mut headers = 0
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FEATURES {
            if headers >= 1 { DiagnosticBag.add(self: mut diagnostics, code: "RS0006", line: item.line, column: item.column, length: item.length) }
            headers = headers + 1
            let mut seen = Set<String>.new()
            let mut featureIndex = 0
            while featureIndex < List.len(list: item.features) {
                let feature = List.get<FeatureName>(list: item.features, index: featureIndex)
                if is_known_feature(name: feature.name) == false {
                    DiagnosticBag.add(self: mut diagnostics, code: "RS0016", line: feature.line, column: feature.column, length: feature.length)
                } else if Set.contains<String>(set: seen, value: feature.name) {
                    DiagnosticBag.add(self: mut diagnostics, code: "RS0017", line: feature.line, column: feature.column, length: feature.length)
                } else {
                    Set.insert<String>(set: mut seen, value: feature.name)
                }
                featureIndex = featureIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}

fn is_known_feature(name: String) -> Bool {
    return name == "local" || name == "native" || name == "unsafe" || name == "async" || name == "device" || name == "ffi" || name == "reflection"
}
