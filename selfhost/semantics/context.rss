features: local
// Minimal shared semantic context for the first body-AST consumers. It owns
// bindings and function return lookup; richer nominal/generic/effect models
// will extend this module instead of rebuilding checker-local token maps.

module selfhost.semantics.context

use selfhost.scan.*
use selfhost.syntax.ast.*

struct FunctionContext {
    bindings: Map<String, String>
}

fn FunctionContext.from_item(item: read Item) -> fresh FunctionContext {
    local bindings = Map<String, String>.new()
    let mut i = 0
    while i < List.len(list: read item.params) {
        let param = List.get<Param>(list: read item.params, index: read i)
        Map.insert<String, String>(map: mut bindings, key: read param.name, value: read param.typeText)
        i = i + 1
    }
    return FunctionContext(bindings: take bindings)
}

fn program_function_return_type(program: read Program, name: read String) -> String {
    let mut i = 0
    while i < Program.len(self: read program) {
        let item = List.get<Item>(list: read program.items, index: read i)
        if item.kind == ITEM_FUNCTION && item.name == name { return item.returnType }
        i = i + 1
    }
    return ""
}

fn is_comparison_operator(operator: read String) -> Bool {
    return operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">="
}

fn infer_expression_type(program: read Program, context: read FunctionContext, index: Int) -> String {
    if index < 0 || index >= List.len(list: read program.expressions) { return "" }
    let expression = List.get<Expr>(list: read program.expressions, index: read index)
    if expression.kind == EXPR_NAME {
        return Map.get_or_default<String, String>(map: read context.bindings, key: read expression.text, default: read "")
    }
    if expression.kind == EXPR_LITERAL {
        if expression.tokenKind == TOK_NUMBER { return "Int" }
        if expression.tokenKind == TOK_STRING { return "String" }
        if expression.tokenKind == TOK_CHAR { return "Char" }
        if expression.text == "true" || expression.text == "false" { return "Bool" }
        if expression.text == "Unit" { return "Unit" }
        return ""
    }
    if expression.kind == EXPR_CALL {
        return program_function_return_type(program: read program, name: read expression.text)
    }
    if expression.kind == EXPR_BINARY {
        if is_comparison_operator(operator: read expression.text) { return "Bool" }
        if List.len(list: read expression.children) == 2 {
            let left = List.get<Int>(list: read expression.children, index: read 0)
            let right = List.get<Int>(list: read expression.children, index: read 1)
            if infer_expression_type(program: read program, context: read context, index: read left) == "Int" && infer_expression_type(program: read program, context: read context, index: read right) == "Int" { return "Int" }
        }
    }
    return ""
}

fn infer_statement_type(program: read Program, context: mut FunctionContext, index: Int) -> String {
    if index < 0 || index >= List.len(list: read program.statements) { return "" }
    let statement = List.get<Stmt>(list: read program.statements, index: read index)
    let inferred = infer_expression_type(program: read program, context: read context, index: statement.expression)
    if statement.kind == STMT_LET && String.len(value: read statement.name) > 0 {
        let mut bindingType = statement.typeText
        if String.len(value: read bindingType) == 0 { bindingType = inferred }
        if String.len(value: read bindingType) > 0 { Map.insert<String, String>(map: mut context.bindings, key: read statement.name, value: read bindingType) }
    }
    return inferred
}
