features: local
// Minimal shared semantic context for the first body-AST consumers. It owns
// bindings and function return lookup; richer nominal/generic/effect models
// will extend this module instead of rebuilding checker-local token maps.

module selfhost.semantics.context

use selfhost.scan.*
use selfhost.semantics.call_binding.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.ast.*
use selfhost.types.*

struct FunctionContext {
    bindings: Map<String, String>
    semantics: handle SemanticIndex
}

fn FunctionContext.from_item(item: Item, semantics: SemanticIndex) -> fresh FunctionContext {
    local bindings = Map<String, String>.new()
    let mut i = 0
    while i < List.len(list: item.params) {
        let param = List.get<Param>(list: item.params, index: i)
        Map.insert<String, String>(map: mut bindings, key: param.name, value: param.typeText)
        i = i + 1
    }
    return FunctionContext(bindings: take bindings, semantics: read semantics)
}

fn FunctionContext.copy(self: FunctionContext) -> fresh FunctionContext {
    local bindings = Map<String, String>.new()
    let keys = Map.keys<String, String>(map: self.bindings)
    let mut i = 0
    while i < List.len(list: keys) {
        let key = List.get<String>(list: keys, index: i)
        let value = Map.get_or_default<String, String>(map: self.bindings, key: key, default: "")
        Map.insert<String, String>(
            map: mut bindings,
            key: String.copy(value: key),
            value: String.copy(value: value)
        )
        i = i + 1
    }
    return FunctionContext(bindings: take bindings, semantics: read self.semantics)
}

// Resolve a direct field from a file-local data declaration after expanding the
// owner alias and substituting its nominal generic arguments.
fn program_field_type(program: Program, semantics: SemanticIndex, ownerType: String, fieldName: String) -> String {
    let expandedOwner = SemanticIndex.expand_type_alias(self: semantics, typeName: ownerType)
    let root = str_type_root(s: expandedOwner)
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_TYPE && item.name == root {
            let mut substitutions = Map<String, String>.new()
            let mut genericIndex = 0
            while genericIndex < List.len(list: item.generics) {
                let generic = List.get<GenericParam>(list: item.generics, index: genericIndex)
                let argument = str_top_arg(s: expandedOwner, which: genericIndex)
                if String.len(value: argument) > 0 {
                    Map.insert<String, String>(
                        map: mut substitutions,
                        key: generic.name,
                        value: argument
                    )
                }
                genericIndex = genericIndex + 1
            }
            let mut fieldIndex = 0
            while fieldIndex < List.len(list: item.fields) {
                let field = List.get<Field>(list: item.fields, index: fieldIndex)
                if field.name == fieldName {
                    return substitute_type_parameters(
                        ty: field.typeText,
                        substitutions: substitutions,
                        depth: 0
                    )
                }
                fieldIndex = fieldIndex + 1
            }
            return ""
        }
        itemIndex = itemIndex + 1
    }
    return ""
}

fn prepared_call_substitutions(
    program: Program,
    context: FunctionContext,
    expressionIndex: Int,
    prepared: PreparedCall
) -> Map<String, String> {
    let mut substitutions = Map<String, String>.new()
    let mut genericNames = Set<String>.new()
    let mut index = 0
    while index < List.len(list: prepared.typeParameters) {
        let name = List.get<String>(list: prepared.typeParameters, index: index)
        Set.insert<String>(set: mut genericNames, value: name)
        index = index + 1
    }
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) {
        return substitutions
    }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    index = 0
    while index < List.len(list: prepared.typeParameters)
        && index < List.len(list: expression.typeArgs) {
        Map.insert<String, String>(
            map: mut substitutions,
            key: List.get<String>(list: prepared.typeParameters, index: index),
            value: List.get<String>(list: expression.typeArgs, index: index)
        )
        index = index + 1
    }
    if expression.calleeKind == CALLEE_RECEIVER
        && expression.calleeReceiver >= 0
        && List.len(list: prepared.parameterTypes) > 0 {
        let actualReceiver = infer_expression_type(
            program: program,
            context: context,
            index: expression.calleeReceiver
        )
        collect_type_substitutions(
            pattern: SemanticIndex.expand_type_alias(
                self: context.semantics,
                typeName: List.get<String>(list: prepared.parameterTypes, index: 0)
            ),
            actual: SemanticIndex.expand_type_alias(
                self: context.semantics,
                typeName: actualReceiver
            ),
            genericNames: genericNames,
            substitutions: mut substitutions,
            depth: 0
        )
    }
    index = 0
    while index < List.len(list: prepared.binding.evaluationOrder) {
        let bound = List.get<BoundArgument>(list: prepared.binding.evaluationOrder, index: index)
        if bound.sourceKind == BOUND_SOURCE_EXPLICIT
            && bound.sourceIndex >= 0
            && bound.sourceIndex < List.len(list: expression.args)
            && bound.parameterIndex >= 0
            && bound.parameterIndex < List.len(list: prepared.parameterTypes) {
            let argument = List.get<CallArg>(list: expression.args, index: bound.sourceIndex)
            let actual = infer_expression_type(
                program: program,
                context: context,
                index: argument.value
            )
            collect_type_substitutions(
                pattern: SemanticIndex.expand_type_alias(
                    self: context.semantics,
                    typeName: List.get<String>(list: prepared.parameterTypes, index: bound.parameterIndex)
                ),
                actual: SemanticIndex.expand_type_alias(
                    self: context.semantics,
                    typeName: actual
                ),
                genericNames: genericNames,
                substitutions: mut substitutions,
                depth: 0
            )
        }
        index = index + 1
    }
    return substitutions
}

fn resolved_prepared_parameter_type(
    context: FunctionContext,
    prepared: PreparedCall,
    substitutions: Map<String, String>,
    parameterIndex: Int
) -> String {
    if parameterIndex < 0 || parameterIndex >= List.len(list: prepared.parameterTypes) {
        return ""
    }
    let substituted = substitute_type_parameters(
        ty: List.get<String>(list: prepared.parameterTypes, index: parameterIndex),
        substitutions: substitutions,
        depth: 0
    )
    return SemanticIndex.expand_type_alias(
        self: context.semantics,
        typeName: substituted
    )
}

fn resolved_prepared_result_type(
    program: Program,
    context: FunctionContext,
    expressionIndex: Int,
    prepared: PreparedCall
) -> String {
    let substitutions = prepared_call_substitutions(
        program: program,
        context: context,
        expressionIndex: expressionIndex,
        prepared: prepared
    )
    let substituted = substitute_type_parameters(
        ty: prepared.resultType,
        substitutions: substitutions,
        depth: 0
    )
    return SemanticIndex.expand_type_alias(
        self: context.semantics,
        typeName: substituted
    )
}

fn is_comparison_operator(operator: String) -> Bool {
    return operator == "==" || operator == "!=" || operator == "<" || operator == "<=" || operator == ">" || operator == ">="
}

fn numeric_literal_type(text: String) -> String {
    match String.index_of(value: text, needle: ".") {
        Some(_) => { return "Float" }
        None => {}
    }
    match String.index_of(value: text, needle: "e") {
        Some(_) => { return "Float" }
        None => {}
    }
    match String.index_of(value: text, needle: "E") {
        Some(_) => { return "Float" }
        None => {}
    }
    return "Int"
}

fn call_constructed_type(expression: Expr) -> String {
    if expression.text != "Map.new" && expression.text != "Set.new" && expression.text != "List.new" && expression.text != "Deque.new" { return "" }
    let count = List.len(list: expression.typeArgs)
    if count == 0 { return "" }
    let mut out = String.concat(left: expression.text, right: "")
    out = String.slice(value: out, start: 0, len: (String.len(value: out) - 4))
    out = String.concat(left: out, right: "<")
    let mut i = 0
    while i < count {
        if i > 0 { out = String.concat(left: out, right: ", ") }
        out = String.concat(left: out, right: List.get<String>(list: expression.typeArgs, index: i))
        i = i + 1
    }
    return String.concat(left: out, right: ">")
}

fn infer_expression_type(program: Program, context: FunctionContext, index: Int) -> String {
    if index < 0 || index >= List.len(list: program.expressions) { return "" }
    let expression = List.get<Expr>(list: program.expressions, index)
    if expression.kind == EXPR_NAME {
        return Map.get_or_default<String, String>(map: context.bindings, key: expression.text, default: "")
    }
    if expression.kind == EXPR_LITERAL {
        if expression.tokenKind == TOK_NUMBER { return numeric_literal_type(text: expression.text) }
        if expression.tokenKind == TOK_STRING { return "String" }
        if expression.tokenKind == TOK_CHAR { return "Char" }
        if expression.text == "true" || expression.text == "false" { return "Bool" }
        if expression.text == "Unit" { return "Unit" }
        return ""
    }
    if expression.kind == EXPR_CALL {
        let constructed = call_constructed_type(expression: expression)
        if String.len(value: constructed) > 0 { return constructed }
        let preparedIndex = SemanticIndex.call_index(
            self: context.semantics,
            expressionIndex: index
        )
        if preparedIndex < 0 { return "" }
        let prepared = List.get<PreparedCall>(list: context.semantics.calls, index: preparedIndex)
        return resolved_prepared_result_type(
            program: program,
            context: context,
            expressionIndex: index,
            prepared: prepared
        )
    }
    if (expression.kind == EXPR_EFFECT || expression.kind == EXPR_MANAGE)
        && List.len(list: expression.children) == 1 {
        return infer_expression_type(
            program: program,
            context: context,
            index: List.get<Int>(list: expression.children, index: 0)
        )
    }
    if expression.kind == EXPR_FIELD && List.len(list: expression.children) == 1 {
        let base = List.get<Int>(list: expression.children, index: 0)
        let baseType = infer_expression_type(program: program, context: context, index: base)
        return program_field_type(
            program: program,
            semantics: context.semantics,
            ownerType: baseType,
            fieldName: expression.text
        )
    }
    if expression.kind == EXPR_UNARY && expression.text == "!" { return "Bool" }
    if expression.kind == EXPR_BINARY {
        if is_comparison_operator(operator: expression.text) || expression.text == "&&" || expression.text == "||" { return "Bool" }
        if List.len(list: expression.children) == 2 {
            let left = List.get<Int>(list: expression.children, index: 0)
            let right = List.get<Int>(list: expression.children, index: 1)
            if infer_expression_type(program, context, index: left) == "Int" && infer_expression_type(program, context, index: right) == "Int" { return "Int" }
        }
    }
    return ""
}

fn infer_statement_type(program: Program, context: mut FunctionContext, index: Int) -> String {
    if index < 0 || index >= List.len(list: program.statements) { return "" }
    let statement = List.get<Stmt>(list: program.statements, index)
    let inferred = infer_expression_type(program, context, index: statement.expression)
    if statement.kind == STMT_LET && String.len(value: statement.name) > 0 {
        let mut bindingType = statement.typeText
        if String.len(value: bindingType) == 0 { bindingType = inferred }
        if String.len(value: bindingType) > 0 { Map.insert<String, String>(map: mut context.bindings, key: statement.name, value: bindingType) }
    }
    return inferred
}
