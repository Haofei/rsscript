features: local
// Shared semantic diagnostic model.
//
// Input: rules add stable source spans. Output: one ordered bag. This module
// does not sort, print, parse tokens, or decide which rules run; those remain
// driver responsibilities while Stage 2 migrates the legacy checker in slices.

module selfhost.semantics.diagnostics

struct Diagnostic {
    code: String
    line: Int
    column: Int
    length: Int
}

struct DiagnosticBag {
    items: List<Diagnostic>
}

fn Diagnostic.from(code: take String, line: Int, column: Int, length: Int) -> fresh Diagnostic {
    return Diagnostic(code: take code, line: line, column: column, length: length)
}

fn Diagnostic.from_copy(code: String, line: Int, column: Int, length: Int) -> fresh Diagnostic {
    local ownedCode = String.copy(value: code)
    return Diagnostic.from(code: take ownedCode, line, column, length)
}

fn DiagnosticBag.empty() -> fresh DiagnosticBag {
    return DiagnosticBag(items: List<Diagnostic>.new())
}

fn DiagnosticBag.add(self: mut DiagnosticBag, code: String, line: Int, column: Int, length: Int) -> Unit {
    let diagnostic = Diagnostic.from_copy(code, line, column, length)
    List.push<Diagnostic>(list: mut self.items, value: diagnostic)
}

fn DiagnosticBag.has_code(self: DiagnosticBag, code: String) -> Bool {
    let mut i = 0
    while i < List.len(list: self.items) {
        let diagnostic = List.get<Diagnostic>(list: self.items, index: i)
        if diagnostic.code == code { return true }
        i = i + 1
    }
    return false
}
