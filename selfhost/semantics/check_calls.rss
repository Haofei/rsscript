// Call-level diagnostics over the shared Program.
//
// This mirrors the Rust checker boundary in crates/rsscript/src/checks/calls.rs.

module selfhost.semantics.check_calls

use selfhost.semantics.call_binding.*
use selfhost.semantics.context.*
use selfhost.semantics.diagnostics.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.ast.*
use selfhost.types.*

fn call_site_key(line: Int, column: Int, length: Int) -> String {
    let linePart = String.concat(left: String.from_int(value: line), right: ":")
    let columnPart = String.concat(left: linePart, right: String.from_int(value: column))
    return String.concat(
        left: columnPart,
        right: String.concat(left: ":", right: String.from_int(value: length))
    )
}

fn supplied_effect(program: Program, expressionIndex: Int) -> String {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return "" }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind == EXPR_EFFECT { return expression.text }
    return ""
}

fn effect_matches(expected: String, supplied: String) -> Bool {
    if expected == "read" && (String.len(value: supplied) == 0 || supplied == "read") { return true }
    return expected == supplied
}

// The generated interface registry is broader than the currently materialized
// self-host type model. Own RS0207 only for signatures whose concrete argument
// behavior is already covered by the differential corpus.
fn prepared_external_type_is_owned(expression: Expr, parameterName: String) -> Bool {
    if expression.calleeKind != CALLEE_QUALIFIED { return true }
    if expression.text == "Log.write" && parameterName == "message" { return true }
    if expression.text == "String.concat" && (parameterName == "left" || parameterName == "right") { return true }
    if expression.text == "String.len" && parameterName == "value" { return true }
    if expression.text == "List.push" && (parameterName == "list" || parameterName == "value") { return true }
    if expression.text == "File.write" && parameterName == "data" { return true }
    if expression.text == "Image.inspect" && parameterName == "image" { return true }
    if expression.text == "Image.normalize" && parameterName == "image" { return true }
    if expression.text == "Image.resize" && (parameterName == "image" || parameterName == "width" || parameterName == "height") { return true }
    if expression.text == "Image.save" && (parameterName == "image" || parameterName == "path") { return true }
    if expression.text == "Image.load" && parameterName == "path" { return true }
    if expression.text == "Request.path" && parameterName == "request" { return true }
    return false
}

fn collect_function_value_call_contracts(
    program: Program,
    context: FunctionContext,
    expression: Expr,
    diagnostics: mut DiagnosticBag,
    typeOwnedSites: mut Set<String>
) -> Unit {
    if expression.calleeKind != CALLEE_NAME { return Unit }
    let callableType = Map.get_or_default<String, String>(
        map: context.bindings,
        key: expression.text,
        default: ""
    )
    let body = strip_type_prefixes(s: callableType)
    let arity = fn_type_arity(body: body)
    if arity < 0 { return Unit }
    let count = List.len(list: expression.args)
    let mut index = 0
    while index < count && index < arity {
        let argument = List.get<CallArg>(list: expression.args, index: index)
        if argument.value >= 0
            && argument.value < List.len(list: program.expressions)
            && expression_type_is_owned(
                program: program,
                context: context,
                expressionIndex: argument.value
            ) {
            let value = List.get<Expr>(list: program.expressions, index: argument.value)
            let expectedType = SemanticIndex.expand_type_alias(
                self: context.semantics,
                typeName: fn_type_arg_at(body: body, which: index)
            )
            let actualType = SemanticIndex.expand_type_alias(
                self: context.semantics,
                typeName: infer_expression_type(
                    program: program,
                    context: context,
                    index: argument.value
                )
            )
            if resolved_call_type_mismatch(
                expected: expectedType,
                actual: actualType,
                genericNames: List<String>.new(),
                semantics: context.semantics
            ) {
                let key = call_site_key(line: value.line, column: value.column, length: value.length)
                Set.insert<String>(set: mut typeOwnedSites, value: key)
                DiagnosticBag.add(
                    self: mut diagnostics,
                    code: "RS0207",
                    line: value.line,
                    column: value.column,
                    length: value.length
                )
            }
        }
        index = index + 1
    }
    return Unit
}

fn expression_type_is_owned(program: Program, context: FunctionContext, expressionIndex: Int) -> Bool {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return false }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind == EXPR_LITERAL { return true }
    if expression.kind == EXPR_NAME {
        return Map.contains_key<String, String>(map: context.bindings, key: expression.text)
    }
    if expression.kind == EXPR_CALL {
        let preparedIndex = SemanticIndex.call_index(
            self: context.semantics,
            expressionIndex: expressionIndex
        )
        return preparedIndex >= 0
    }
    if (expression.kind == EXPR_EFFECT || expression.kind == EXPR_MANAGE)
        && List.len(list: expression.children) == 1 {
        return expression_type_is_owned(
            program: program,
            context: context,
            expressionIndex: List.get<Int>(list: expression.children, index: 0)
        )
    }
    if expression.kind == EXPR_FIELD || expression.kind == EXPR_BINARY || expression.kind == EXPR_UNARY {
        let inferred = infer_expression_type(
            program: program,
            context: context,
            index: expressionIndex
        )
        return String.len(value: inferred) > 0
    }
    return false
}

fn expression_is_bound_name(program: Program, expressionIndex: Int) -> Bool {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return false }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind == EXPR_NAME { return true }
    if (expression.kind == EXPR_EFFECT || expression.kind == EXPR_MANAGE)
        && List.len(list: expression.children) == 1 {
        return expression_is_bound_name(
            program: program,
            expressionIndex: List.get<Int>(list: expression.children, index: 0)
        )
    }
    return false
}

fn stable_scalar_call_type(ty: String) -> Bool {
    let root = str_type_root(s: ty)
    return root == "Int"
        || root == "Float"
        || root == "Bool"
        || root == "String"
        || root == "Char"
        || root == "Unit"
}

fn type_contains_unresolved_generic(
    ty: String,
    genericNames: List<String>,
    semantics: SemanticIndex,
    depth: Int
) -> Bool {
    if depth >= TYPE_SUBSTITUTION_DEPTH_LIMIT { return false }
    let body = strip_type_prefixes(s: str_trim(s: ty))
    let root = str_type_root(s: body)
    let mut index = 0
    while index < List.len(list: genericNames) {
        if root == List.get<String>(list: genericNames, index: index) { return true }
        index = index + 1
    }
    if String.len(value: root) == 1
        && Char.is_upper(value: List.get<Char>(list: String.chars(value: root), index: 0))
        && SemanticIndex.is_declared_type(self: semantics, typeName: root) == false {
        return true
    }
    let count = str_type_arg_count(s: body)
    index = 0
    while index < count {
        if type_contains_unresolved_generic(
            ty: str_top_arg(s: body, which: index),
            genericNames: genericNames,
            semantics: semantics,
            depth: depth + 1
        ) {
            return true
        }
        index = index + 1
    }
    return false
}

fn resolved_call_type_mismatch(
    expected: String,
    actual: String,
    genericNames: List<String>,
    semantics: SemanticIndex
) -> Bool {
    if arg_type_matches(expected: expected, actual: actual) { return false }
    if String.len(value: expected) == 0
        || String.len(value: actual) == 0
        || type_contains_unresolved_generic(
            ty: expected,
            genericNames: genericNames,
            semantics: semantics,
            depth: 0
        )
        || type_contains_unresolved_generic(
            ty: actual,
            genericNames: genericNames,
            semantics: semantics,
            depth: 0
        ) {
        return false
    }
    let expectedScalar = stable_scalar_call_type(ty: expected)
    let actualScalar = stable_scalar_call_type(ty: actual)
    if expectedScalar && actualScalar {
        return true
    }
    if expectedScalar
        && String.len(value: str_type_root(s: actual)) == 1
        && SemanticIndex.is_declared_type(self: semantics, typeName: actual) {
        return true
    }
    if actualScalar
        && String.len(value: str_type_root(s: expected)) == 1
        && SemanticIndex.is_declared_type(self: semantics, typeName: expected) {
        return true
    }
    let expectedArgs = str_type_arg_count(s: expected)
    let actualArgs = str_type_arg_count(s: actual)
    return expectedArgs > 0
        && expectedArgs == actualArgs
        && str_type_root(s: expected) == str_type_root(s: actual)
}

fn collect_prepared_argument_contracts(
    program: Program,
    context: FunctionContext,
    expressionIndex: Int,
    prepared: PreparedCall,
    diagnostics: mut DiagnosticBag,
    effectOwnedSites: mut Set<String>,
    typeOwnedSites: mut Set<String>
) -> Unit {
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    let substitutions = prepared_call_substitutions(
        program: program,
        context: context,
        expressionIndex: expressionIndex,
        prepared: prepared
    )
    let mut boundIndex = 0
    while boundIndex < List.len(list: prepared.binding.evaluationOrder) {
        let bound = List.get<BoundArgument>(list: prepared.binding.evaluationOrder, index: boundIndex)
        if bound.sourceKind == BOUND_SOURCE_EXPLICIT
            && bound.sourceIndex >= 0
            && bound.sourceIndex < List.len(list: expression.args)
            && bound.parameterIndex >= 0
            && bound.parameterIndex < List.len(list: prepared.parameterNames) {
            let argument = List.get<CallArg>(list: expression.args, index: bound.sourceIndex)
            if argument.value >= 0 && argument.value < List.len(list: program.expressions) {
                let value = List.get<Expr>(list: program.expressions, index: argument.value)
                let expectedEffect = List.get<String>(list: prepared.parameterEffects, index: bound.parameterIndex)
                if String.len(value: expectedEffect) > 0 {
                    let key = call_site_key(line: value.line, column: value.column, length: value.length)
                    Set.insert<String>(set: mut effectOwnedSites, value: key)
                    let actualEffect = supplied_effect(program: program, expressionIndex: argument.value)
                    if effect_matches(expected: expectedEffect, supplied: actualEffect) == false {
                        DiagnosticBag.add(
                            self: mut diagnostics,
                            code: "RS0202",
                            line: value.line,
                            column: value.column,
                            length: value.length
                        )
                    }
                }

                let parameterName = List.get<String>(list: prepared.parameterNames, index: bound.parameterIndex)
                let expectedType = resolved_prepared_parameter_type(
                    context: context,
                    prepared: prepared,
                    substitutions: substitutions,
                    parameterIndex: bound.parameterIndex
                )
                let inferredActualType = infer_expression_type(
                    program: program,
                    context: context,
                    index: argument.value
                )
                let actualType = SemanticIndex.expand_type_alias(
                    self: context.semantics,
                    typeName: inferredActualType
                )
                let scalarPair = stable_scalar_call_type(ty: expectedType)
                    && stable_scalar_call_type(ty: actualType)
                let mismatch = resolved_call_type_mismatch(
                    expected: expectedType,
                    actual: actualType,
                    genericNames: prepared.typeParameters,
                    semantics: context.semantics
                )
                let singleLetterNominalMismatch = (
                    String.len(value: str_type_root(s: expectedType)) == 1
                    && SemanticIndex.is_declared_type(
                        self: context.semantics,
                        typeName: expectedType
                    )
                ) || (
                    String.len(value: str_type_root(s: actualType)) == 1
                    && SemanticIndex.is_declared_type(
                        self: context.semantics,
                        typeName: actualType
                    )
                )
                let ownsType = prepared_external_type_is_owned(
                    expression: expression,
                    parameterName: parameterName
                ) && expression_type_is_owned(
                    program: program,
                    context: context,
                    expressionIndex: argument.value
                ) && (scalarPair || singleLetterNominalMismatch || expression_is_bound_name(
                    program: program,
                    expressionIndex: argument.value
                ))
                if ownsType
                    && mismatch
                    && String.len(value: inferredActualType) > 0 {
                    let key = call_site_key(line: value.line, column: value.column, length: value.length)
                    Set.insert<String>(set: mut typeOwnedSites, value: key)
                    DiagnosticBag.add(
                        self: mut diagnostics,
                        code: "RS0207",
                        line: value.line,
                        column: value.column,
                        length: value.length
                    )
                }
            }
        }
        boundIndex = boundIndex + 1
    }
    return Unit
}

fn collect_receiver_effect_contract(
    program: Program,
    expression: Expr,
    prepared: PreparedCall,
    visibleEffect: String,
    diagnostics: mut DiagnosticBag,
    effectOwnedSites: mut Set<String>
) -> Unit {
    if expression.calleeKind != CALLEE_RECEIVER || prepared.callableIndex < 0 { return Unit }
    if List.len(list: prepared.parameterEffects) == 0 { return Unit }
    let expected = List.get<String>(list: prepared.parameterEffects, index: 0)
    if String.len(value: expected) == 0 { return Unit }
    if expression.calleeReceiver < 0 || expression.calleeReceiver >= List.len(list: program.expressions) { return Unit }
    let receiver = List.get<Expr>(list: program.expressions, index: expression.calleeReceiver)
    let key = call_site_key(line: receiver.line, column: receiver.column, length: receiver.length)
    Set.insert<String>(set: mut effectOwnedSites, value: key)
    let mut supplied = visibleEffect
    if String.len(value: supplied) == 0 { supplied = "read" }
    if supplied != expected {
        DiagnosticBag.add(
            self: mut diagnostics,
            code: "RS0202",
            line: receiver.line,
            column: receiver.column,
            length: receiver.length
        )
    }
    return Unit
}

fn collect_unresolved_duplicate_arguments(expression: Expr, diagnostics: mut DiagnosticBag) -> Unit {
    let mut seen = Set<String>.new()
    let mut argIndex = 0
    while argIndex < List.len(list: expression.args) {
        let argument = List.get<CallArg>(list: expression.args, index: argIndex)
        if String.len(value: argument.label) > 0 {
            if Set.contains<String>(set: seen, value: argument.label) {
                DiagnosticBag.add(
                    self: mut diagnostics,
                    code: "RS0205",
                    line: argument.line,
                    column: argument.column,
                    length: argument.length
                )
            } else {
                Set.insert<String>(set: mut seen, value: argument.label)
            }
        }
        argIndex = argIndex + 1
    }
    return Unit
}

fn collect_prepared_call_diagnostics(program: Program, semantics: SemanticIndex, expressionIndex: Int, diagnostics: mut DiagnosticBag) -> Unit {
    let preparedIndex = SemanticIndex.call_index(self: semantics, expressionIndex: expressionIndex)
    if preparedIndex < 0 {
        let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
        let resolution = SemanticIndex.resolve_call(self: semantics, expression: expression)
        if resolution == AMBIGUOUS_CALLABLE || expression.calleeKind != CALLEE_NAME {
            collect_unresolved_duplicate_arguments(expression: expression, diagnostics: mut diagnostics)
        }
        return Unit
    }
    let prepared = List.get<PreparedCall>(list: semantics.calls, index: preparedIndex)
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    let mut issueIndex = 0
    while issueIndex < List.len(list: prepared.binding.issues) {
        let issue = List.get<CallBindingIssue>(list: prepared.binding.issues, index: issueIndex)
        if issue.kind == BINDING_DUPLICATE_PARAMETER
            && issue.sourceIndex >= 0
            && issue.sourceIndex < List.len(list: expression.args) {
            let argument = List.get<CallArg>(list: expression.args, index: issue.sourceIndex)
            DiagnosticBag.add(
                self: mut diagnostics,
                code: "RS0205",
                line: argument.line,
                column: argument.column,
                length: argument.length
            )
        }
        issueIndex = issueIndex + 1
    }
    return Unit
}

fn collect_call_diagnostics_expression(program: Program, semantics: SemanticIndex, expressionIndex: Int, diagnostics: mut DiagnosticBag) -> Unit {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return Unit }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind == EXPR_CALL {
        collect_prepared_call_diagnostics(
            program: program,
            semantics: semantics,
            expressionIndex: expressionIndex,
            diagnostics: mut diagnostics
        )
    }
    let mut childIndex = 0
    while childIndex < List.len(list: expression.children) {
        collect_call_diagnostics_expression(
            program,
            semantics: semantics,
            expressionIndex: List.get<Int>(list: expression.children, index: childIndex),
            diagnostics: mut diagnostics
        )
        childIndex = childIndex + 1
    }
    if expression.kind == EXPR_MATCH {
        let mut armIndex = 0
        while armIndex < List.len(list: expression.arms) {
            let arm = List.get<MatchArm>(list: expression.arms, index: armIndex)
            let mut bodyIndex = 0
            while bodyIndex < List.len(list: arm.body) {
                collect_call_diagnostics_statement(
                    program,
                    semantics: semantics,
                    statementIndex: List.get<Int>(list: arm.body, index: bodyIndex),
                    diagnostics: mut diagnostics
                )
                bodyIndex = bodyIndex + 1
            }
            armIndex = armIndex + 1
        }
    }
    return Unit
}

fn collect_call_diagnostics_statement(program: Program, semantics: SemanticIndex, statementIndex: Int, diagnostics: mut DiagnosticBag) -> Unit {
    if statementIndex < 0 || statementIndex >= List.len(list: program.statements) { return Unit }
    let statement = List.get<Stmt>(list: program.statements, index: statementIndex)
    collect_call_diagnostics_expression(
        program,
        semantics: semantics,
        expressionIndex: statement.expression,
        diagnostics: mut diagnostics
    )
    let mut armIndex = 0
    while armIndex < List.len(list: statement.arms) {
        let arm = List.get<MatchArm>(list: statement.arms, index: armIndex)
        let mut bodyIndex = 0
        while bodyIndex < List.len(list: arm.body) {
            collect_call_diagnostics_statement(
                program,
                semantics: semantics,
                statementIndex: List.get<Int>(list: arm.body, index: bodyIndex),
                diagnostics: mut diagnostics
            )
            bodyIndex = bodyIndex + 1
        }
        armIndex = armIndex + 1
    }
    let mut childIndex = 0
    while childIndex < List.len(list: statement.children) {
        collect_call_diagnostics_statement(
            program,
            semantics: semantics,
            statementIndex: List.get<Int>(list: statement.children, index: childIndex),
            diagnostics: mut diagnostics
        )
        childIndex = childIndex + 1
    }
    let mut elseIndex = 0
    while elseIndex < List.len(list: statement.elseChildren) {
        collect_call_diagnostics_statement(
            program,
            semantics: semantics,
            statementIndex: List.get<Int>(list: statement.elseChildren, index: elseIndex),
            diagnostics: mut diagnostics
        )
        elseIndex = elseIndex + 1
    }
    return Unit
}

fn collect_program_call_diagnostics(program: Program, semantics: SemanticIndex, diagnostics: mut DiagnosticBag) -> Unit {
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION {
            let mut statementIndex = 0
            while statementIndex < List.len(list: item.statements) {
                collect_call_diagnostics_statement(
                    program,
                    semantics: semantics,
                    statementIndex: List.get<Int>(list: item.statements, index: statementIndex),
                    diagnostics: mut diagnostics
                )
                statementIndex = statementIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}

fn collect_call_contract_expression(
    program: Program,
    context: FunctionContext,
    expressionIndex: Int,
    visibleEffect: String,
    diagnostics: mut DiagnosticBag,
    effectOwnedSites: mut Set<String>,
    typeOwnedSites: mut Set<String>,
    visitedCalls: mut Set<Int>
) -> Unit {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return Unit }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind == EXPR_EFFECT && List.len(list: expression.children) == 1 {
        collect_call_contract_expression(
            program: program,
            context: context,
            expressionIndex: List.get<Int>(list: expression.children, index: 0),
            visibleEffect: expression.text,
            diagnostics: mut diagnostics,
            effectOwnedSites: mut effectOwnedSites,
            typeOwnedSites: mut typeOwnedSites,
            visitedCalls: mut visitedCalls
        )
        return Unit
    }
    if expression.kind == EXPR_CALL && Set.contains<Int>(set: visitedCalls, value: expressionIndex) == false {
        Set.insert<Int>(set: mut visitedCalls, value: expressionIndex)
        let preparedIndex = SemanticIndex.call_index(self: context.semantics, expressionIndex: expressionIndex)
        if preparedIndex >= 0 {
            let prepared = List.get<PreparedCall>(list: context.semantics.calls, index: preparedIndex)
            collect_prepared_argument_contracts(
                program: program,
                context: context,
                expressionIndex: expressionIndex,
                prepared: prepared,
                diagnostics: mut diagnostics,
                effectOwnedSites: mut effectOwnedSites,
                typeOwnedSites: mut typeOwnedSites
            )
            collect_receiver_effect_contract(
                program: program,
                expression: expression,
                prepared: prepared,
                visibleEffect: visibleEffect,
                diagnostics: mut diagnostics,
                effectOwnedSites: mut effectOwnedSites
            )
        } else {
            collect_function_value_call_contracts(
                program: program,
                context: context,
                expression: expression,
                diagnostics: mut diagnostics,
                typeOwnedSites: mut typeOwnedSites
            )
        }
    }
    if expression.calleeReceiver >= 0 {
        collect_call_contract_expression(
            program: program,
            context: context,
            expressionIndex: expression.calleeReceiver,
            visibleEffect: "",
            diagnostics: mut diagnostics,
            effectOwnedSites: mut effectOwnedSites,
            typeOwnedSites: mut typeOwnedSites,
            visitedCalls: mut visitedCalls
        )
    }
    let mut childIndex = 0
    while childIndex < List.len(list: expression.children) {
        collect_call_contract_expression(
            program: program,
            context: context,
            expressionIndex: List.get<Int>(list: expression.children, index: childIndex),
            visibleEffect: "",
            diagnostics: mut diagnostics,
            effectOwnedSites: mut effectOwnedSites,
            typeOwnedSites: mut typeOwnedSites,
            visitedCalls: mut visitedCalls
        )
        childIndex = childIndex + 1
    }
    let mut armIndex = 0
    while armIndex < List.len(list: expression.arms) {
        let arm = List.get<MatchArm>(list: expression.arms, index: armIndex)
        let mut armContext = FunctionContext.copy(self: context)
        collect_call_contract_statements(
            program: program,
            statements: arm.body,
            context: mut armContext,
            diagnostics: mut diagnostics,
            effectOwnedSites: mut effectOwnedSites,
            typeOwnedSites: mut typeOwnedSites,
            visitedCalls: mut visitedCalls
        )
        armIndex = armIndex + 1
    }
    if List.len(list: expression.closureStatements) > 0 {
        let mut closureContext = FunctionContext.copy(self: context)
        collect_call_contract_statements(
            program: program,
            statements: expression.closureStatements,
            context: mut closureContext,
            diagnostics: mut diagnostics,
            effectOwnedSites: mut effectOwnedSites,
            typeOwnedSites: mut typeOwnedSites,
            visitedCalls: mut visitedCalls
        )
    }
    return Unit
}

fn collect_call_contract_statements(
    program: Program,
    statements: List<Int>,
    context: mut FunctionContext,
    diagnostics: mut DiagnosticBag,
    effectOwnedSites: mut Set<String>,
    typeOwnedSites: mut Set<String>,
    visitedCalls: mut Set<Int>
) -> Unit {
    let mut index = 0
    while index < List.len(list: statements) {
        let statementIndex = List.get<Int>(list: statements, index: index)
        if statementIndex >= 0 && statementIndex < List.len(list: program.statements) {
            let statement = List.get<Stmt>(list: program.statements, index: statementIndex)
            collect_call_contract_expression(
                program: program,
                context: context,
                expressionIndex: statement.expression,
                visibleEffect: "",
                diagnostics: mut diagnostics,
                effectOwnedSites: mut effectOwnedSites,
                typeOwnedSites: mut typeOwnedSites,
                visitedCalls: mut visitedCalls
            )
            infer_statement_type(program: program, context: mut context, index: statementIndex)
            if List.len(list: statement.children) > 0 {
                let mut childContext = FunctionContext.copy(self: context)
                collect_call_contract_statements(
                    program: program,
                    statements: statement.children,
                    context: mut childContext,
                    diagnostics: mut diagnostics,
                    effectOwnedSites: mut effectOwnedSites,
                    typeOwnedSites: mut typeOwnedSites,
                    visitedCalls: mut visitedCalls
                )
            }
            if List.len(list: statement.elseChildren) > 0 {
                let mut elseContext = FunctionContext.copy(self: context)
                collect_call_contract_statements(
                    program: program,
                    statements: statement.elseChildren,
                    context: mut elseContext,
                    diagnostics: mut diagnostics,
                    effectOwnedSites: mut effectOwnedSites,
                    typeOwnedSites: mut typeOwnedSites,
                    visitedCalls: mut visitedCalls
                )
            }
            let mut armIndex = 0
            while armIndex < List.len(list: statement.arms) {
                let arm = List.get<MatchArm>(list: statement.arms, index: armIndex)
                let mut armContext = FunctionContext.copy(self: context)
                collect_call_contract_statements(
                    program: program,
                    statements: arm.body,
                    context: mut armContext,
                    diagnostics: mut diagnostics,
                    effectOwnedSites: mut effectOwnedSites,
                    typeOwnedSites: mut typeOwnedSites,
                    visitedCalls: mut visitedCalls
                )
                armIndex = armIndex + 1
            }
        }
        index = index + 1
    }
    return Unit
}

fn collect_program_call_contract_diagnostics(
    program: Program,
    semantics: SemanticIndex,
    diagnostics: mut DiagnosticBag,
    effectOwnedSites: mut Set<String>,
    typeOwnedSites: mut Set<String>
) -> Unit {
    let mut visitedCalls = Set<Int>.new()
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION {
            let mut context = FunctionContext.from_item(item: item, semantics: semantics)
            collect_call_contract_statements(
                program: program,
                statements: item.statements,
                context: mut context,
                diagnostics: mut diagnostics,
                effectOwnedSites: mut effectOwnedSites,
                typeOwnedSites: mut typeOwnedSites,
                visitedCalls: mut visitedCalls
            )
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}
