// Self-hosted package-contract checker — RS1301 frontier.
//
// Reads interface source as argv[0], package source as argv[1], and an optional
// comma-separated native-binding symbol list as argv[2]. Emits RS1301 when the
// interface and source package contracts differ; otherwise emits CLEAN.
//
// This is intentionally separate from check.rss: RS1301 is package-level, not a
// single-source analyzer diagnostic.

features: local

module selfhost.package_contract

use selfhost.scan.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

struct PackageFnIndex {
    names: List<String>
    sigs: handle Map<String, String>
    nativeNames: handle Set<String>
}

// Function contract text is derived from the materialized Program, not a
// second header scanner. It is intentionally internal: the package checker
// only needs a deterministic equality key while Stage 2 grows richer types.
fn package_function_contract(item: Item) -> String {
    let mut out = String.copy(value: item.name)
    let mut genericIndex = 0
    while genericIndex < List.len(list: item.generics) {
        let generic = List.get<GenericParam>(list: item.generics, index: genericIndex)
        out = String.concat(left: out, right: String.concat(left: "|g:", right: generic.name))
        out = String.concat(left: out, right: String.concat(left: ":", right: generic.boundText))
        genericIndex = genericIndex + 1
    }
    let mut paramIndex = 0
    while paramIndex < List.len(list: item.params) {
        let param = List.get<Param>(list: item.params, index: paramIndex)
        out = String.concat(left: out, right: String.concat(left: "|p:", right: param.effect))
        out = String.concat(left: out, right: String.concat(left: ":", right: param.typeText))
        if param.hasDefault { out = String.concat(left: out, right: "=default") }
        paramIndex = paramIndex + 1
    }
    out = String.concat(left: out, right: String.concat(left: "|r:", right: item.returnType))
    let mut effectIndex = 0
    while effectIndex < List.len(list: item.effects) {
        let effect = List.get<EffectName>(list: item.effects, index: effectIndex)
        out = String.concat(left: out, right: String.concat(left: "|e:", right: effect.name))
        if effect.isRetains { out = String.concat(left: out, right: String.concat(left: "(", right: String.concat(left: effect.target, right: ")"))) }
        effectIndex = effectIndex + 1
    }
    return out
}

fn collect_package_functions(program: Program, sourceVisibility: Bool) -> PackageFnIndex {
    let mut names = List<String>.new()
    let mut sigs = Map<String, String>.new()
    let mut nativeNames = Set<String>.new()
    let mut i = 0
    while i < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: i)
        if item.kind == ITEM_FUNCTION && (!sourceVisibility || item.isPublic) {
            let name = String.copy(value: item.name)
            let signature = package_function_contract(item: item)
            if Map.contains_key<String, String>(map: sigs, key: name) == false {
                List.push<String>(list: mut names, value: name)
            }
            if item.isNative { Set.insert<String>(set: mut nativeNames, value: name) }
            Map.insert<String, String>(map: mut sigs, key: name, value: signature)
        }
        i = i + 1
    }
    return PackageFnIndex(names: names, sigs: read sigs, nativeNames: read nativeNames)
}

fn comma_list_contains(values: String, wanted: String) -> Bool {
    let parts = String.split(value: values, delimiter: ",")
    let mut i = 0
    while i < List.len(list: parts) {
        if List.get(list: parts, index: i) == wanted { return true }
        i = i + 1
    }
    return false
}

fn has_function_contract_mismatch(interfaceProgram: Program, sourceProgram: Program, nativeBindings: String) -> Bool {
    let interfaceFns = collect_package_functions(program: interfaceProgram, sourceVisibility: false)
    let sourceFns = collect_package_functions(program: sourceProgram, sourceVisibility: true)
    let n = List.len(list: interfaceFns.names)
    let mut i = 0
    let mut mismatch = false
    while i < n {
        let name = List.get(list: interfaceFns.names, index: i)
        let want = Map.get_or_default<String, String>(map: interfaceFns.sigs, key: name, default: "")
        let got = Map.get_or_default<String, String>(map: sourceFns.sigs, key: name, default: "")
        if got == "" {
            let nativeExempt = Set.contains<String>(set: interfaceFns.nativeNames, value: name)
            if !nativeExempt  || comma_list_contains(values: nativeBindings, wanted: name) == false {
                mismatch = true
            }
        } else if got != want {
            mismatch = true
        }
        i = i + 1
    }
    return mismatch
}

struct PackageDeclIndex {
    keys: List<String>
    contracts: handle Map<String, String>
    opaqueTypes: handle Set<String>
    typeHeaders: handle Map<String, String>
}

fn prefixed_key(prefix: String, name: String) -> String {
    return String.concat(left: String.concat(left: prefix, right: ":"), right: name)
}

fn package_field_contract(field: Field) -> String {
    let mut out = String.concat(left: field.name, right: ":")
    out = String.concat(left: out, right: field.typeText)
    if field.isHandle { out = String.concat(left: out, right: "|handle") }
    if field.isWeak { out = String.concat(left: out, right: "|weak") }
    return out
}

fn package_data_header_contract(item: Item) -> String {
    let mut out = String.copy(value: item.dataKind)
    let mut genericIndex = 0
    while genericIndex < List.len(list: item.generics) {
        let generic = List.get<GenericParam>(list: item.generics, index: genericIndex)
        out = String.concat(left: out, right: String.concat(left: "|g:", right: generic.name))
        out = String.concat(left: out, right: String.concat(left: ":", right: generic.boundText))
        genericIndex = genericIndex + 1
    }
    return out
}

fn package_data_contract(item: Item) -> String {
    let mut out = package_data_header_contract(item: item)
    let mut deriveIndex = 0
    while deriveIndex < List.len(list: item.derives) {
        let derive = List.get<FeatureName>(list: item.derives, index: deriveIndex)
        out = String.concat(left: out, right: String.concat(left: "|derive:", right: derive.name))
        deriveIndex = deriveIndex + 1
    }
    let mut fieldIndex = 0
    while fieldIndex < List.len(list: item.fields) {
        let field = List.get<Field>(list: item.fields, index: fieldIndex)
        out = String.concat(left: out, right: String.concat(left: "|field:", right: package_field_contract(field: field)))
        fieldIndex = fieldIndex + 1
    }
    let mut variantIndex = 0
    while variantIndex < List.len(list: item.variants) {
        let variant = List.get<Variant>(list: item.variants, index: variantIndex)
        out = String.concat(left: out, right: String.concat(left: "|variant:", right: variant.name))
        fieldIndex = 0
        while fieldIndex < List.len(list: variant.fields) {
            let field = List.get<Field>(list: variant.fields, index: fieldIndex)
            out = String.concat(left: out, right: String.concat(left: ":", right: package_field_contract(field: field)))
            fieldIndex = fieldIndex + 1
        }
        variantIndex = variantIndex + 1
    }
    return out
}

fn package_protocol_contract(program: Program, protocol: Item) -> String {
    let mut out = String.copy(value: protocol.name)
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION && item.protocol == protocol.name {
            out = String.concat(left: out, right: String.concat(left: "|method:", right: package_function_contract(item: item)))
            if item.hasDefaultImplMarker { out = String.concat(left: out, right: "=default") }
        }
        itemIndex = itemIndex + 1
    }
    return out
}

fn package_impl_contract(implementation: Item) -> String {
    let mut out = String.concat(left: implementation.protocol, right: String.concat(left: " for ", right: implementation.implType))
    let mut mappingIndex = 0
    while mappingIndex < List.len(list: implementation.mappings) {
        let mapping = List.get<ProtocolMapping>(list: implementation.mappings, index: mappingIndex)
        out = String.concat(left: out, right: String.concat(left: "|", right: mapping.method))
        out = String.concat(left: out, right: String.concat(left: "=", right: mapping.target))
        mappingIndex = mappingIndex + 1
    }
    return out
}

fn merge_program_declarations(program: Program, sourceVisibility: Bool, keys: mut List<String>, contracts: mut Map<String, String>, opaqueTypes: mut Set<String>, typeHeaders: mut Map<String, String>) -> Unit {
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        let include = !sourceVisibility || item.isPublic || item.kind == ITEM_PROTOCOL || item.kind == ITEM_IMPL
        let mut key = ""
        let mut contract = ""
        let mut header = ""
        if include && item.kind == ITEM_TYPE {
            key = prefixed_key(prefix: "type", name: item.name)
            contract = package_data_contract(item: item)
            header = package_data_header_contract(item: item)
        } else if include && item.kind == ITEM_SUM {
            key = prefixed_key(prefix: "sum", name: item.name)
            contract = package_data_contract(item: item)
        } else if include && item.kind == ITEM_PROTOCOL {
            key = prefixed_key(prefix: "protocol", name: item.name)
            contract = package_protocol_contract(program: program, protocol: item)
        } else if include && item.kind == ITEM_IMPL {
            local implementationName = String.concat(left: item.protocol, right: String.concat(left: " for ", right: item.implType))
            key = prefixed_key(prefix: "impl", name: implementationName)
            contract = package_impl_contract(implementation: item)
        } else if include && item.kind == ITEM_TYPE_ALIAS {
            key = prefixed_key(prefix: "alias", name: item.name)
            contract = String.copy(value: item.aliasTarget)
        } else if include && item.kind == ITEM_CONST {
            key = prefixed_key(prefix: "const", name: item.name)
            contract = String.concat(left: item.constType, right: String.concat(left: "=", right: item.constValue))
        }
        if key != "" {
            if Map.contains_key<String, String>(map: contracts, key: key) == false {
                List.push<String>(list: mut keys, value: key)
            }
            if item.kind == ITEM_TYPE && item.isOpaque { Set.insert<String>(set: mut opaqueTypes, value: key) }
            if header != "" { Map.insert<String, String>(map: mut typeHeaders, key: key, value: header) }
            Map.insert<String, String>(map: mut contracts, key: key, value: contract)
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}

fn collect_package_declarations(program: Program, sourceVisibility: Bool) -> PackageDeclIndex {
    let mut keys = List<String>.new()
    let mut contracts = Map<String, String>.new()
    let mut opaqueTypes = Set<String>.new()
    let mut typeHeaders = Map<String, String>.new()
    merge_program_declarations(program: program, sourceVisibility: sourceVisibility, keys: mut keys, contracts: mut contracts, opaqueTypes: mut opaqueTypes, typeHeaders: mut typeHeaders)
    return PackageDeclIndex(keys: keys, contracts: read contracts, opaqueTypes: read opaqueTypes, typeHeaders: read typeHeaders)
}

fn has_declaration_contract_mismatch(interfaceProgram: Program, sourceProgram: Program) -> Bool {
    let wanted = collect_package_declarations(program: interfaceProgram, sourceVisibility: false)
    let actual = collect_package_declarations(program: sourceProgram, sourceVisibility: true)
    let mut i = 0
    while i < List.len(list: wanted.keys) {
        let key = List.get(list: wanted.keys, index: i)
        let got = Map.get_or_default<String, String>(map: actual.contracts, key, default: "")
        if got == "" { return true }
        let isOpaque = Set.contains<String>(set: wanted.opaqueTypes, value: key)
        if isOpaque {
            let wantHeader = Map.get_or_default<String, String>(map: wanted.typeHeaders, key, default: "")
            let gotHeader = Map.get_or_default<String, String>(map: actual.typeHeaders, key, default: "")
            if wantHeader != gotHeader { return true }
        } else {
            let want = Map.get_or_default<String, String>(map: wanted.contracts, key, default: "")
            if got != want { return true }
        }
        i = i + 1
    }
    return false
}

fn main() -> Unit {
    let interfaceSource = Args.get_or_default(index: 0, default: "")
    let source = Args.get_or_default(index: 1, default: "")
    let nativeBindings = Args.get_or_default(index: 2, default: "")
    let interfaceTokens = tokenize(source: interfaceSource)
    let sourceTokens = tokenize(source: source)
    let interfaceProgram = parse_program(toks: interfaceTokens)
    let sourceProgram = parse_program(toks: sourceTokens)
    let fnMismatch = has_function_contract_mismatch(interfaceProgram, sourceProgram, nativeBindings)
    let declMismatch = has_declaration_contract_mismatch(interfaceProgram, sourceProgram)
    if fnMismatch || declMismatch {
        Log.write(message: "RS1301")
    } else {
        Log.write(message: "CLEAN")
    }
    return Unit
}
