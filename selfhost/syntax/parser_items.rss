features: local
// Stage 2 top-level parser slice. It owns Program construction and delegates
// declaration boundary recognition to the established shared scanner helpers.

module selfhost.syntax.parser_items

use selfhost.scan.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_stmts.*

// First name token after top-level modifiers. Non-function declarations still
// use this small normalizer; function headers use the scanner's explicit helper.
fn item_name_index(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    while at_symbol(toks: read toks, i: read j, code: read SYM_HASH) { j = j + 5 }
    let mut modifiers = true
    while modifiers {
        if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) || at_ident(toks: read toks, i: read j, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read j, wid: read WORD_NATIVE) {
            j = j + 1
        } else {
            modifiers = false
        }
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_OPAQUE) { j = j + 1 }
    if at_ident(toks: read toks, i: read j, wid: read WORD_FN) || at_ident(toks: read toks, i: read j, wid: read WORD_CLASS) || at_ident(toks: read toks, i: read j, wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read j, wid: read WORD_RESOURCE) || at_ident(toks: read toks, i: read j, wid: read WORD_OPAQUE) || at_ident(toks: read toks, i: read j, wid: read WORD_SUM) || at_ident(toks: read toks, i: read j, wid: read WORD_TYPE) || at_ident(toks: read toks, i: read j, wid: read WORD_CONST) || at_ident(toks: read toks, i: read j, wid: read WORD_PROTOCOL) {
        return j + 1
    }
    return j + 1
}

fn item_name(toks: read List<Tok>, i: read Int) -> String {
    let nameIndex = item_name_index(toks: read toks, i: read i)
    if is_ident_tok(toks: read toks, i: read nameIndex) {
        let tok = List.get(list: read toks, index: read nameIndex)
        return tok.text
    }
    return ""
}

fn push_item(program: mut Program, toks: read List<Tok>, i: read Int, kind: Int, name: read String) -> Unit {
    let tok = List.get(list: read toks, index: read i)
    local ownedName = String.copy(value: read name)
    let item = Item.plain(kind: kind, name: take ownedName, line: tok.line, column: tok.col, length: tok.len)
    Program.push(self: mut program, item: read item)
}

fn modifier_present(toks: read List<Tok>, start: read Int, word: read Int) -> Bool {
    let mut i = start
    while at_symbol(toks: read toks, i: read i, code: read SYM_HASH) { i = i + 5 }
    let mut scanning = true
    while scanning {
        if at_ident(toks: read toks, i: read i, wid: read word) { return true }
        if at_ident(toks: read toks, i: read i, wid: read WORD_PUB) || at_ident(toks: read toks, i: read i, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read i, wid: read WORD_NATIVE) {
            i = i + 1
        } else {
            scanning = false
        }
    }
    return false
}

fn dotted_name(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    let mut out = ""
    let mut i = start
    while i < end {
        let tok = List.get(list: read toks, index: read i)
        out = String.concat(left: read out, right: read tok.text)
        i = i + 1
    }
    return out
}

fn data_effect(toks: read List<Tok>, i: read Int) -> String {
    if is_ident_tok(toks: read toks, i: read i) == false { return "" }
    let tok = List.get(list: read toks, index: read i)
    if tok.text == "read" { return "read" }
    if tok.text == "mut" { return "mut" }
    if tok.text == "take" { return "take" }
    return ""
}

// A parameter's default expression starts at a top-level `=`. Nested generic,
// tuple, and function types may contain punctuation, so only depth-zero `=`
// terminates the syntax type range.
fn param_type_end(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < end {
        let opener = at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_EQ) {
            return i
        }
        i = i + 1
    }
    return end
}

fn push_param(toks: read List<Tok>, start: read Int, end: read Int, params: mut List<Param>) -> Unit {
    if start >= end || is_ident_tok(toks: read toks, i: read start) == false { return Unit }
    if String.len(value: read data_effect(toks: read toks, i: read start)) > 0 { return Unit }
    let nameTok = List.get(list: read toks, index: read start)
    let mut typeStart = start + 1
    let mut effect = ""
    if at_symbol(toks: read toks, i: read typeStart, code: read SYM_COLON) {
        typeStart = typeStart + 1
        effect = data_effect(toks: read toks, i: read typeStart)
        if String.len(value: read effect) > 0 { typeStart = typeStart + 1 }
    }
    local name = String.copy(value: read nameTok.text)
    local ownedEffect = String.copy(value: read effect)
    let defaultEq = param_type_end(toks: read toks, start: read typeStart, end: read end)
    local typeText = canonical_type_text(toks: read toks, start: read typeStart, end: read defaultEq)
    let hasDefault = defaultEq < end && at_symbol(toks: read toks, i: read defaultEq, code: read SYM_EQ) && (defaultEq + 1) < end
    let mut defaultLine = 0
    let mut defaultColumn = 0
    let mut defaultLength = 0
    if hasDefault {
        let defaultTok = List.get(list: read toks, index: read (defaultEq + 1))
        defaultLine = defaultTok.line
        defaultColumn = defaultTok.col
        defaultLength = defaultTok.len
    }
    let param = Param.from(name: take name, effect: take ownedEffect, typeText: take typeText, hasDefault: hasDefault, defaultLine: defaultLine, defaultColumn: defaultColumn, defaultLength: defaultLength, line: nameTok.line, column: nameTok.col, length: nameTok.len)
    List.push<Param>(list: mut params, value: read param)
}

fn parse_params(toks: read List<Tok>, open: read Int, close: read Int, params: mut List<Param>) -> Unit {
    let mut start = open + 1
    while start < close {
        let comma = split_top_level_comma(toks: read toks, start: read start, end: read close)
        let mut end = close
        if comma >= 0 { end = comma }
        push_param(toks: read toks, start: read start, end: read end, params: mut params)
        if comma < 0 { start = close } else { start = comma + 1 }
    }
    return Unit
}

fn push_generic_param(toks: read List<Tok>, start: read Int, end: read Int, generics: mut List<GenericParam>) -> Unit {
    if start >= end || is_ident_tok(toks: read toks, i: read start) == false { return Unit }
    let tok = List.get(list: read toks, index: read start)
    local name = String.copy(value: read tok.text)
    let mut boundStart = end
    if at_symbol(toks: read toks, i: read (start + 1), code: read SYM_COLON) { boundStart = start + 2 }
    local boundText = canonical_type_text(toks: read toks, start: read boundStart, end: read end)
    let generic = GenericParam.from(name: take name, boundText: take boundText, line: tok.line, column: tok.col, length: tok.len)
    List.push<GenericParam>(list: mut generics, value: read generic)
}

fn parse_generic_params(toks: read List<Tok>, nameEnd: read Int, signatureEnd: read Int, generics: mut List<GenericParam>) -> Unit {
    if at_symbol(toks: read toks, i: read nameEnd, code: read SYM_LANGLE) == false { return Unit }
    let close = find_matching(toks: read toks, open: read nameEnd, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 || close >= signatureEnd { return Unit }
    let mut start = nameEnd + 1
    while start < close {
        let comma = split_top_level_comma(toks: read toks, start: read start, end: read close)
        let mut end = close
        if comma >= 0 { end = comma }
        push_generic_param(toks: read toks, start: read start, end: read end, generics: mut generics)
        if comma < 0 { start = close } else { start = comma + 1 }
    }
    return Unit
}

fn return_type(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    let mut arrow = -1
    let mut i = start
    while i < end && arrow < 0 {
        if at_symbol(toks: read toks, i: read i, code: read SYM_ARROW) { arrow = i }
        i = i + 1
    }
    if arrow < 0 { return "" }
    let mut typeEnd = end
    i = arrow + 1
    while i < end {
        if at_ident(toks: read toks, i: read i, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read i, code: read SYM_EQ) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            typeEnd = i
            i = end
        } else {
            i = i + 1
        }
    }
    return canonical_type_text(toks: read toks, start: read (arrow + 1), end: read typeEnd)
}

fn collect_effects(toks: read List<Tok>, start: read Int, end: read Int, effects: mut List<EffectName>) -> Unit {
    let mut i = start
    let mut open = -1
    while i < end && open < 0 {
        if at_ident(toks: read toks, i: read i, wid: read WORD_EFFECTS) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            open = i + 1
        }
        i = i + 1
    }
    if open < 0 { return Unit }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 || close > end { return Unit }
    let mut segmentStart = open + 1
    while segmentStart < close {
        let comma = split_top_level_comma(toks: read toks, start: read segmentStart, end: read close)
        if is_ident_tok(toks: read toks, i: read segmentStart) {
            let tok = List.get(list: read toks, index: read segmentStart)
            local name = String.copy(value: read tok.text)
            let effect = EffectName.from(name: take name, line: tok.line, column: tok.col, length: tok.len)
            List.push<EffectName>(list: mut effects, value: read effect)
        }
        if comma < 0 { segmentStart = close } else { segmentStart = comma + 1 }
    }
    return Unit
}

fn push_function_item(program: mut Program, toks: read List<Tok>, start: read Int, end: read Int) -> Unit {
    let nameStart = function_decl_name_start(toks: read toks, i: read start)
    let nameEnd = take_function_name(toks: read toks, i: read nameStart)
    let sigEnd = function_signature_end(toks: read toks, start: read (nameStart - 1))
    let paramOpen = function_param_open(toks: read toks, from: read nameEnd, end: read sigEnd)
    local generics = List<GenericParam>.new()
    parse_generic_params(toks: read toks, nameEnd: read nameEnd, signatureEnd: read sigEnd, generics: mut generics)
    local params = List<Param>.new()
    if paramOpen >= 0 {
        let paramClose = find_matching(toks: read toks, open: read paramOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if paramClose >= 0 { parse_params(toks: read toks, open: read paramOpen, close: read paramClose, params: mut params) }
    }
    local effects = List<EffectName>.new()
    collect_effects(toks: read toks, start: read nameEnd, end: read sigEnd, effects: mut effects)
    local name = dotted_name(toks: read toks, start: read nameStart, end: read nameEnd)
    local ret = return_type(toks: read toks, start: read nameEnd, end: read sigEnd)
    let bodyOpen = sigEnd
    let hasBody = at_symbol(toks: read toks, i: read bodyOpen, code: read SYM_LBRACE)
    local statements = List<Int>.new()
    if hasBody {
        let bodyClose = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if bodyClose >= 0 { parse_body_statements(program: mut program, toks: read toks, open: read bodyOpen, close: read bodyClose, statements: mut statements) }
    }
    let tok = List.get(list: read toks, index: read start)
    let item = Item.function(name: take name, line: tok.line, column: tok.col, length: tok.len, isPublic: modifier_present(toks: read toks, start: read start, word: read WORD_PUB), isAsync: modifier_present(toks: read toks, start: read start, word: read WORD_ASYNC), isNative: modifier_present(toks: read toks, start: read start, word: read WORD_NATIVE), hasBody: hasBody, generics: take generics, params: take params, effects: take effects, statements: take statements, returnType: take ret)
    Program.push(self: mut program, item: read item)
}

// Parse all recoverable top-level declarations. Unknown and malformed items are
// represented explicitly so a later diagnostic pass can report them without
// reparsing source text.
fn parse_program(toks: read List<Tok>) -> Program {
    let mut program = Program.empty()
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok || tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_FEATURES, name: read "features")
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_PROFILE, name: read "profile")
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_TYPE, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_SUM, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_PROTOCOL, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_IMPL, name: read "") ; i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_NATIVE_MODULE, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_TYPE_ALIAS, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_CONST, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_MODULE, name: read item_name(toks: read toks, i: read i)) ; i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_USE, name: read "") ; i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "") ; i = i + 1 }
                else { push_function_item(program: mut program, toks: read toks, start: read i, end: read r) ; i = r }
            } else {
                push_item(program: mut program, toks: read toks, i: read i, kind: ITEM_UNKNOWN, name: read "")
                i = i + 1
            }
        }
    }
    return program
}
