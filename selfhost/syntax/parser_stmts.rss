features: local
// First shared function-body AST slice. It owns only the simple statements and
// expressions needed by signature/body migration; unsupported forms remain
// explicit unknown nodes until their parser and parity gate move here.

module selfhost.syntax.parser_stmts

use selfhost.scan.*
use selfhost.syntax.ast.*

fn is_word(toks: read List<Tok>, i: read Int, word: read String) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) == false { return false }
    let tok = List.get(list: read toks, index: read i)
    return tok.text == word
}

fn first_equals(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_EQ) { return i }
        i = i + 1
    }
    return -1
}

fn expression_end(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut result = end
    if end > start && at_symbol(toks: read toks, i: read (end - 1), code: read 59) { result = end - 1 }
    return result
}

// One top-level statement ends at `;` or the first later line after every
// bracket/block nesting level closes. This keeps multiline calls, literals,
// and control-flow blocks intact even before each form receives a dedicated
// statement node.
fn statement_end(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let line = tk_line(toks: read toks, i: read start)
    let mut depth = 0
    let mut i = start + 1
    while i < limit {
        if depth == 0 && at_symbol(toks: read toks, i: read i, code: read 59) { return i }
        let elseContinuation = is_word(toks: read toks, i: read i, word: read "else") || (at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) && is_word(toks: read toks, i: read (i - 1), word: read "else"))
        if depth == 0 && tk_line(toks: read toks, i: read i) > line && elseContinuation == false { return i }
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        }
        i = i + 1
    }
    return limit
}

fn block_open(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < limit {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            return i
        }
        i = i + 1
    }
    return -1
}

fn binary_operator_text(toks: read List<Tok>, i: read Int, end: read Int) -> String {
    if i >= end { return "" }
    let tok = List.get(list: read toks, index: read i)
    if at_symbol(toks: read toks, i: read i, code: read SYM_EQ) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_EQ) { return "==" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_BANG) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_EQ) { return "!=" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_EQ) { return "<=" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_EQ) { return ">=" }
    if at_symbol(toks: read toks, i: read i, code: read 124) && at_symbol(toks: read toks, i: read (i + 1), code: read 124) { return "||" }
    if at_symbol(toks: read toks, i: read i, code: read 38) && at_symbol(toks: read toks, i: read (i + 1), code: read 38) { return "&&" }
    if at_symbol(toks: read toks, i: read i, code: read 43) || at_symbol(toks: read toks, i: read i, code: read 45) || at_symbol(toks: read toks, i: read i, code: read 42) || at_symbol(toks: read toks, i: read i, code: read 47) || at_symbol(toks: read toks, i: read i, code: read 37) || at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) { return tok.text }
    return ""
}

fn binary_operator_width(operator: read String) -> Int {
    if operator == "==" || operator == "!=" || operator == "<=" || operator == ">=" || operator == "&&" || operator == "||" { return 2 }
    return 1
}

fn last_top_binary_operator(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut found = -1
    let mut i = start + 1
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && String.len(value: read binary_operator_text(toks: read toks, i: read i, end: read end)) > 0 {
            found = i
        }
        i = i + 1
    }
    return found
}

fn parse_expression(program: mut Program, toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let stop = expression_end(toks: read toks, start: read start, end: read end)
    if start >= stop { return -1 }
    if at_symbol(toks: read toks, i: read start, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read start, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == (stop - 1) { return parse_expression(program: mut program, toks: read toks, start: read (start + 1), end: read close) }
    }
    if at_symbol(toks: read toks, i: read start, code: read SYM_BANG) {
        let token = List.get(list: read toks, index: read start)
        let child = parse_expression(program: mut program, toks: read toks, start: read (start + 1), end: read stop)
        local children = List<Int>.new()
        if child >= 0 { List.push<Int>(list: mut children, value: read child) }
        local operator = "!"
        let expression = Expr.from(kind: EXPR_UNARY, tokenKind: token.kind, text: take operator, line: token.line, column: token.col, length: token.len, children: take children)
        return Program.push_expression(self: mut program, expression: read expression)
    }
    let binary = last_top_binary_operator(toks: read toks, start: read start, end: read stop)
    if binary >= 0 {
        local operator = binary_operator_text(toks: read toks, i: read binary, end: read stop)
        let width = binary_operator_width(operator: read operator)
        let left = parse_expression(program: mut program, toks: read toks, start: read start, end: read binary)
        let right = parse_expression(program: mut program, toks: read toks, start: read (binary + width), end: read stop)
        let token = List.get(list: read toks, index: read binary)
        local children = List<Int>.new()
        if left >= 0 { List.push<Int>(list: mut children, value: read left) }
        if right >= 0 { List.push<Int>(list: mut children, value: read right) }
        let expression = Expr.from(kind: EXPR_BINARY, tokenKind: token.kind, text: take operator, line: token.line, column: token.col, length: token.len, children: take children)
        return Program.push_expression(self: mut program, expression: read expression)
    }
    let tok = List.get(list: read toks, index: read start)
    local text = String.copy(value: read tok.text)
    let mut kind = EXPR_UNKNOWN
    if is_ident_tok(toks: read toks, i: read start) {
        if text == "true" || text == "false" || text == "Unit" { kind = EXPR_LITERAL }
        else { kind = EXPR_NAME }
    }
    else if tk_kind(toks: read toks, i: read start) == TOK_NUMBER || tk_kind(toks: read toks, i: read start) == TOK_STRING || tk_kind(toks: read toks, i: read start) == TOK_CHAR { kind = EXPR_LITERAL }
    local children = List<Int>.new()
    let afterName = take_function_name(toks: read toks, i: read start)
    if afterName > start && at_symbol(toks: read toks, i: read afterName, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read afterName, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == (stop - 1) {
            kind = EXPR_CALL
            let mut argStart = afterName + 1
            while argStart < close {
                let comma = split_top_level_comma(toks: read toks, start: read argStart, end: read close)
                let mut argEnd = close
                if comma >= 0 { argEnd = comma }
                let child = parse_expression(program: mut program, toks: read toks, start: read argStart, end: read argEnd)
                if child >= 0 { List.push<Int>(list: mut children, value: read child) }
                if comma < 0 { argStart = close } else { argStart = comma + 1 }
            }
        }
    }
    let expression = Expr.from(kind: kind, tokenKind: tok.kind, text: take text, line: tok.line, column: tok.col, length: tok.len, children: take children)
    return Program.push_expression(self: mut program, expression: read expression)
}

fn push_statement(program: mut Program, toks: read List<Tok>, start: read Int, end: read Int, statements: mut List<Int>) -> Unit {
    let stop = expression_end(toks: read toks, start: read start, end: read end)
    if start >= stop { return Unit }
    let tok = List.get(list: read toks, index: read start)
    let mut kind = STMT_EXPR
    let mut expressionStart = start
    let mut name = ""
    let mut typeText = ""
    local children = List<Int>.new()
    local elseChildren = List<Int>.new()
    if is_word(toks: read toks, i: read start, word: read "return") {
        kind = STMT_RETURN
        expressionStart = start + 1
    } else if is_word(toks: read toks, i: read start, word: read "let") || is_word(toks: read toks, i: read start, word: read "local") {
        kind = STMT_LET
        let mut nameIndex = start + 1
        if is_word(toks: read toks, i: read nameIndex, word: read "mut") { nameIndex = nameIndex + 1 }
        if is_ident_tok(toks: read toks, i: read nameIndex) {
            let nameTok = List.get(list: read toks, index: read nameIndex)
            name = nameTok.text
        }
        let eq = first_equals(toks: read toks, start: read (nameIndex + 1), end: read stop)
        let mut typeEnd = stop
        if eq >= 0 { typeEnd = eq; expressionStart = eq + 1 } else { expressionStart = stop }
        if at_symbol(toks: read toks, i: read (nameIndex + 1), code: read SYM_COLON) {
            typeText = canonical_type_text(toks: read toks, start: read (nameIndex + 2), end: read typeEnd)
        }
    } else if is_word(toks: read toks, i: read start, word: read "if") || is_word(toks: read toks, i: read start, word: read "while") || is_word(toks: read toks, i: read start, word: read "loop") {
        if is_word(toks: read toks, i: read start, word: read "if") { kind = STMT_IF }
        else if is_word(toks: read toks, i: read start, word: read "while") { kind = STMT_WHILE }
        else { kind = STMT_LOOP }
        let open = block_open(toks: read toks, start: read (start + 1), limit: read stop)
        if open >= 0 {
            if kind == STMT_IF || kind == STMT_WHILE {
                expressionStart = start + 1
            } else {
                expressionStart = open
            }
            let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if close >= 0 {
                parse_body_statements(program: mut program, toks: read toks, open: read open, close: read close, statements: mut children)
                if is_word(toks: read toks, i: read (close + 1), word: read "else") && at_symbol(toks: read toks, i: read (close + 2), code: read SYM_LBRACE) {
                    let elseOpen = close + 2
                    let elseClose = find_matching(toks: read toks, open: read elseOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if elseClose >= 0 { parse_body_statements(program: mut program, toks: read toks, open: read elseOpen, close: read elseClose, statements: mut elseChildren) }
                }
            }
        }
    }
    let mut expressionEnd = stop
    if kind == STMT_IF || kind == STMT_WHILE || kind == STMT_LOOP {
        let open = block_open(toks: read toks, start: read (start + 1), limit: read stop)
        if open >= 0 { expressionEnd = open }
    }
    let expression = parse_expression(program: mut program, toks: read toks, start: read expressionStart, end: read expressionEnd)
    local ownedName = String.copy(value: read name)
    local ownedType = String.copy(value: read typeText)
    let statement = Stmt.from(kind: kind, name: take ownedName, typeText: take ownedType, line: tok.line, column: tok.col, length: tok.len, expression: expression, children: take children, elseChildren: take elseChildren)
    let index = Program.push_statement(self: mut program, statement: read statement)
    List.push<Int>(list: mut statements, value: read index)
}

fn parse_body_statements(program: mut Program, toks: read List<Tok>, open: read Int, close: read Int, statements: mut List<Int>) -> Unit {
    let mut start = open + 1
    while start < close {
        if at_symbol(toks: read toks, i: read start, code: read 59) {
            start = start + 1
        } else {
            let end = statement_end(toks: read toks, start: read start, limit: read close)
            push_statement(program: mut program, toks: read toks, start: read start, end: read end, statements: mut statements)
            if end > start { start = end } else { start = start + 1 }
        }
    }
    return Unit
}
