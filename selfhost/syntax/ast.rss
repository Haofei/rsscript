features: local
// Shared self-hosted syntax model. This is deliberately small at first: it
// establishes one materialized Program for top-level declarations before
// expressions, statements, and patterns migrate from the legacy stream parser.

module selfhost.syntax.ast

const ITEM_MODULE: Int = 1
const ITEM_USE: Int = 2
const ITEM_TYPE: Int = 3
const ITEM_SUM: Int = 4
const ITEM_TYPE_ALIAS: Int = 5
const ITEM_CONST: Int = 6
const ITEM_FUNCTION: Int = 7
const ITEM_PROTOCOL: Int = 8
const ITEM_IMPL: Int = 9
const ITEM_NATIVE_MODULE: Int = 10
const ITEM_FEATURES: Int = 11
const ITEM_PROFILE: Int = 12
const ITEM_UNKNOWN: Int = 13

// Function bodies use flat arenas. Child relationships are indices into
// Program.expressions, avoiding recursive value layout in the first shared AST.
const EXPR_UNKNOWN: Int = 1
const EXPR_NAME: Int = 2
const EXPR_LITERAL: Int = 3
const EXPR_CALL: Int = 4
const EXPR_BINARY: Int = 5

const STMT_UNKNOWN: Int = 1
const STMT_RETURN: Int = 2
const STMT_LET: Int = 3
const STMT_EXPR: Int = 4
const STMT_IF: Int = 5
const STMT_LOOP: Int = 6

struct Expr {
    kind: Int
    text: String
    line: Int
    column: Int
    length: Int
    children: List<Int>
}

struct Stmt {
    kind: Int
    name: String
    typeText: String
    line: Int
    column: Int
    length: Int
    expression: Int
    children: List<Int>
    elseChildren: List<Int>
}

struct Param {
    name: String
    effect: String
    typeText: String
    hasDefault: Bool
    defaultLine: Int
    defaultColumn: Int
    defaultLength: Int
    line: Int
    column: Int
    length: Int
}

struct GenericParam {
    name: String
    boundText: String
    line: Int
    column: Int
    length: Int
}

struct EffectName {
    name: String
    line: Int
    column: Int
    length: Int
}

struct Item {
    kind: Int
    name: String
    line: Int
    column: Int
    length: Int
    isPublic: Bool
    isAsync: Bool
    isNative: Bool
    hasBody: Bool
    generics: List<GenericParam>
    params: List<Param>
    effects: List<EffectName>
    statements: List<Int>
    returnType: String
}

struct Program {
    items: List<Item>
    expressions: List<Expr>
    statements: List<Stmt>
}

fn Expr.from(kind: Int, text: take String, line: Int, column: Int, length: Int, children: take List<Int>) -> fresh Expr {
    return Expr(kind: kind, text: take text, line: line, column: column, length: length, children: take children)
}

fn Stmt.from(kind: Int, name: take String, typeText: take String, line: Int, column: Int, length: Int, expression: Int, children: take List<Int>, elseChildren: take List<Int>) -> fresh Stmt {
    return Stmt(kind: kind, name: take name, typeText: take typeText, line: line, column: column, length: length, expression: expression, children: take children, elseChildren: take elseChildren)
}

fn Param.from(name: take String, effect: take String, typeText: take String, hasDefault: Bool, defaultLine: Int, defaultColumn: Int, defaultLength: Int, line: Int, column: Int, length: Int) -> fresh Param {
    return Param(name: take name, effect: take effect, typeText: take typeText, hasDefault: hasDefault, defaultLine: defaultLine, defaultColumn: defaultColumn, defaultLength: defaultLength, line: line, column: column, length: length)
}

fn GenericParam.from(name: take String, boundText: take String, line: Int, column: Int, length: Int) -> fresh GenericParam {
    return GenericParam(name: take name, boundText: take boundText, line: line, column: column, length: length)
}

fn EffectName.from(name: take String, line: Int, column: Int, length: Int) -> fresh EffectName {
    return EffectName(name: take name, line: line, column: column, length: length)
}

fn Item.plain(kind: Int, name: take String, line: Int, column: Int, length: Int) -> fresh Item {
    return Item(kind: kind, name: take name, line: line, column: column, length: length, isPublic: false, isAsync: false, isNative: false, hasBody: false, generics: List<GenericParam>.new(), params: List<Param>.new(), effects: List<EffectName>.new(), statements: List<Int>.new(), returnType: "")
}

fn Item.function(name: take String, line: Int, column: Int, length: Int, isPublic: Bool, isAsync: Bool, isNative: Bool, hasBody: Bool, generics: take List<GenericParam>, params: take List<Param>, effects: take List<EffectName>, statements: take List<Int>, returnType: take String) -> fresh Item {
    return Item(kind: ITEM_FUNCTION, name: take name, line: line, column: column, length: length, isPublic: isPublic, isAsync: isAsync, isNative: isNative, hasBody: hasBody, generics: take generics, params: take params, effects: take effects, statements: take statements, returnType: take returnType)
}

fn Program.empty() -> fresh Program {
    return Program(items: List<Item>.new(), expressions: List<Expr>.new(), statements: List<Stmt>.new())
}

fn Program.push(self: mut Program, item: read Item) -> Unit
    effects(retains(item))
{
    List.push<Item>(list: mut self.items, value: read item)
}

fn Program.push_expression(self: mut Program, expression: read Expr) -> Int
    effects(retains(expression))
{
    let index = List.len(list: read self.expressions)
    List.push<Expr>(list: mut self.expressions, value: read expression)
    return index
}

fn Program.push_statement(self: mut Program, statement: read Stmt) -> Int
    effects(retains(statement))
{
    let index = List.len(list: read self.statements)
    List.push<Stmt>(list: mut self.statements, value: read statement)
    return index
}

fn Program.len(self: read Program) -> Int {
    return List.len(list: read self.items)
}
