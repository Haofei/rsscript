features: local
// Shared self-hosted syntax model. This is deliberately small at first: it
// establishes one materialized Program for top-level declarations before
// expressions, statements, and patterns migrate from the legacy stream parser.

module selfhost.syntax.ast

const ITEM_MODULE: Int = 1
const ITEM_USE: Int = 2
const ITEM_TYPE: Int = 3
const ITEM_SUM: Int = 4
const ITEM_TYPE_ALIAS: Int = 5
const ITEM_CONST: Int = 6
const ITEM_FUNCTION: Int = 7
const ITEM_PROTOCOL: Int = 8
const ITEM_IMPL: Int = 9
const ITEM_NATIVE_MODULE: Int = 10
const ITEM_FEATURES: Int = 11
const ITEM_PROFILE: Int = 12
const ITEM_UNKNOWN: Int = 13

struct Param {
    name: String
    effect: String
    typeText: String
    line: Int
    column: Int
    length: Int
}

struct EffectName {
    name: String
    line: Int
    column: Int
    length: Int
}

struct Item {
    kind: Int
    name: String
    line: Int
    column: Int
    length: Int
    isPublic: Bool
    isAsync: Bool
    isNative: Bool
    hasBody: Bool
    params: List<Param>
    effects: List<EffectName>
    returnType: String
}

struct Program {
    items: List<Item>
}

fn Param.from(name: take String, effect: take String, typeText: take String, line: Int, column: Int, length: Int) -> fresh Param {
    return Param(name: take name, effect: take effect, typeText: take typeText, line: line, column: column, length: length)
}

fn EffectName.from(name: take String, line: Int, column: Int, length: Int) -> fresh EffectName {
    return EffectName(name: take name, line: line, column: column, length: length)
}

fn Item.plain(kind: Int, name: take String, line: Int, column: Int, length: Int) -> fresh Item {
    return Item(kind: kind, name: take name, line: line, column: column, length: length, isPublic: false, isAsync: false, isNative: false, hasBody: false, params: List<Param>.new(), effects: List<EffectName>.new(), returnType: "")
}

fn Item.function(name: take String, line: Int, column: Int, length: Int, isPublic: Bool, isAsync: Bool, isNative: Bool, hasBody: Bool, params: take List<Param>, effects: take List<EffectName>, returnType: take String) -> fresh Item {
    return Item(kind: ITEM_FUNCTION, name: take name, line: line, column: column, length: length, isPublic: isPublic, isAsync: isAsync, isNative: isNative, hasBody: hasBody, params: take params, effects: take effects, returnType: take returnType)
}

fn Program.empty() -> fresh Program {
    return Program(items: List<Item>.new())
}

fn Program.push(self: mut Program, item: read Item) -> Unit
    effects(retains(item))
{
    List.push<Item>(list: mut self.items, value: read item)
}

fn Program.len(self: read Program) -> Int {
    return List.len(list: read self.items)
}
