// Self-hosted rss checker — Phase 3 (semantic diagnostic parity, driver only).
//
// Reads rss source as argv[0] and prints the analyzer diagnostic codes it finds,
// one per line, or `CLEAN` if none. Oracle: crate::analyze_source filtered to the
// target codes (see SELFHOST_CHECKER_TARGET_CODES and selfhost_parity.rs).
//
// Namespace grouping replicated from crate::hir::lower::collect_item_signatures:
//   * callable namespace: fn names + type (struct/resource/class/opaque)
//     constructor names — a collision in this set is a duplicate.
//   * type namespace: type names + sum names — a collision is a duplicate.
//   * per-type field names: a struct/resource/class field name declared twice
//     within one type is a duplicate (sum variants are NOT field-checked).
// A duplicate in ANY of these => RS0005. Decidable from declaration structure
// alone (no body parsing; see ledger SH-021).
//
// The tokenizer, token accessors, declaration parsers and dispatch predicates
// live in selfhost/scan.rss. The unified `Tok` carries identifier TEXT so names
// can compare. Only the checker-unique text accessor, name/field extraction, and
// the driver are here.
//
// rss constraints (SH-016/017/018): char literals for code-point tests and
// `||` chains wrapped via operator continuation (both in the shared scan.rss
// prelude), cursors threaded positionally.

module selfhost.check

use selfhost.scan.*
use selfhost.interfaces.*
use selfhost.types.*

// ';' — the semicolon symbol code (not in the shared scan.rss prelude; used by
// the RS0021 arm scanner, mirroring astdump).
const SYM_SEMI: Int = 59

// '?' — the try-operator symbol code (single-char symbol, val = code point).
const SYM_QUESTION: Int = 63

// '|' — the closure-parameter delimiter (single-char symbol). Used by the RS0201
// arg-splitter to skip commas inside a closure param list `|a, b|`.
const SYM_PIPE: Int = 124

// Binary-operator symbol codes (single-char val = code point), mirroring astdump.rss.
// Multi-char operators (`==`, `!=`, `<=`, `>=`, `&&`, `||`, `<<`, `>>`) are two adjacent
// single-char symbol tokens (the scanner only fuses `->`/`=>`), matched via two_sym.
const SYM_BANG: Int = 33         // '!'
const SYM_PERCENT: Int = 37      // '%'
const SYM_AMP: Int = 38          // '&'
const SYM_PLUS: Int = 43         // '+'
const SYM_MINUS: Int = 45        // '-'
const SYM_SLASH: Int = 47        // '/'
const SYM_CARET: Int = 94        // '^'

fn tk_text(toks: read List<Tok>, i: read Int) -> String {
    if i < 0 { return "" }
    if i >= List.len(list: read toks) { return "" }
    let t = List.get(list: read toks, index: read i)
    return t.text
}

// ---------------------------------------------------------------------------
// Name / field extraction for the duplicate-declaration checker.
// ---------------------------------------------------------------------------

// Full dotted declaration name text starting at the name's first token index.
fn dotted_name_text(toks: read List<Tok>, i: read Int) -> String {
    if is_ident_tok(toks: read toks, i: read i) == false {
        return ""
    }
    let mut out = tk_text(toks: read toks, i: read i)
    let mut j = i + 1
    let mut going = true
    while going {
        let dot = at_symbol(toks: read toks, i: read j, code: read SYM_DOT)
        let nextIdent = is_ident_tok(toks: read toks, i: read (j + 1))
        if dot && nextIdent {
            out = String.concat(left: read out, right: read ".")
            out = String.concat(left: read out, right: read tk_text(toks: read toks, i: read (j + 1)))
            j = j + 2
        } else {
            going = false
        }
    }
    return out
}

// Index of the name token for a type decl (after optional pub, opaque, kind kw).
fn type_name_start(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_OPAQUE) {
        j = j + 1
    }
    j = j + 1
    return j
}

// Index of the name token for a sum decl (after optional pub, sum kw).
fn sum_name_start(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    j = j + 1
    return j
}

// Index of the name token for a fn decl (after attrs, modifiers, fn kw).
fn fn_name_start(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    let mut attrs = true
    while attrs {
        if at_symbol(toks: read toks, i: read j, code: read SYM_HASH) {
            j = j + 5
        } else {
            attrs = false
        }
    }
    let mut mods = true
    while mods {
        let isMod = at_ident(toks: read toks, i: read j, wid: read WORD_PUB) || at_ident(toks: read toks, i: read j, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read j, wid: read WORD_NATIVE)
        if isMod {
            j = j + 1
        } else {
            mods = false
        }
    }
    j = j + 1
    return j
}

// First `{` in the token range [i, end), or -1 if none.
fn find_body_open(toks: read List<Tok>, i: read Int, end: read Int) -> Int {
    let mut k = i
    while k < end {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            return k
        }
        k = k + 1
    }
    return -1
}

// True if the type body (open brace `ob`, matching close `close`) declares any
// field name twice. A field name is the token immediately before a `:` that sits
// at the top level of the body (not inside (), [], <>, or a nested {}).
fn body_has_duplicate_field(toks: read List<Tok>, ob: read Int, close: read Int) -> Bool {
    let mut seen = Set<String>.new()
    let mut dup = false
    let mut paren = 0
    let mut br = 0
    let mut ang = 0
    let mut brace = 0
    let mut k = ob + 1
    while k < close {
        let isColon = at_symbol(toks: read toks, i: read k, code: read SYM_COLON)
        let atTop = paren == 0 && br == 0 && ang == 0 && brace == 0
        if isColon && atTop && is_ident_tok(toks: read toks, i: read (k - 1)) {
            let name = tk_text(toks: read toks, i: read (k - 1))
            if Set.contains<String>(set: read seen, value: read name) {
                dup = true
            }
            Set.insert<String>(set: mut seen, value: read name)
        }
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if paren > 0 {
                paren = paren - 1
            }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            br = br + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            if br > 0 {
                br = br - 1
            }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if ang > 0 {
                ang = ang - 1
            }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            if brace > 0 {
                brace = brace - 1
            }
        }
        k = k + 1
    }
    return dup
}

// The file features recognized by the compiler (parse_file_feature). Anything
// else in a `features:` header is an unknown feature (RS0016).
fn is_known_feature(name: read String) -> Bool {
    return name == "local" || name == "native" || name == "unsafe" || name == "async" || name == "device" || name == "ffi" || name == "reflection"
}

// ---------------------------------------------------------------------------
// Driver.
// ---------------------------------------------------------------------------

// True if token i is a data-effect keyword (read/mut/take) — parse_data_effect.
fn is_effect_kw(toks: read List<Tok>, i: read Int) -> Bool {
    let t = tk_text(toks: read toks, i: read i)
    return t == "read" || t == "mut" || t == "take"
}

// First top-level `(` (param-list open) at/after `from`, skipping a generic
// `<…>` clause (whose bounds may themselves contain `Fn(…)` parens).
fn find_param_open(toks: read List<Tok>, from: read Int, end: read Int) -> Int {
    let mut k = from
    let mut angle = 0
    let mut r = -1
    while k < end && r < 0 {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            r = k
        }
        k = k + 1
    }
    return r
}

// RS0002: a function with no explicit `-> ReturnType` (check_return_type_explicit,
// function.return_ty.is_none()). True iff no top-level `->` follows the param list.
fn fn_missing_return(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    // Signature scan must begin at the `fn` keyword (ns - 1), not the decl start:
    // when the decl is attribute-led (`#deprecated(...) fn …`), starting at `#`
    // makes function_signature_end stop at the later `fn` (a top-level-item start).
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = close + 1
    let mut hasArrow = false
    while k < sigEnd {
        if at_symbol(toks: read toks, i: read k, code: read SYM_ARROW) { hasArrow = true }
        k = k + 1
    }
    return hasArrow == false
}

// A parameter segment [segStart,segEnd) is an untyped param iff it starts with a
// non-effect identifier whose next token is not `:` (parse_params: empty ty.name).
// Segments that start with a data-effect keyword or a non-ident are malformed and
// produce no Param (so no RS0003).
fn seg_is_untyped(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if is_effect_kw(toks: read toks, i: read segStart) { return false }
    return at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false
}

// RS0003: any parameter lacking an explicit type (check_params, param.ty.name
// is_empty). Splits the param list on top-level commas (depth-aware for
// ()[]{}<>) and tests each segment with seg_is_untyped.
fn fn_has_untyped_param(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    // Signature scan must begin at the `fn` keyword (ns - 1), not the decl start:
    // when the decl is attribute-led (`#deprecated(...) fn …`), starting at `#`
    // makes function_signature_end stop at the later `fn` (a top-level-item start).
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut untyped = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_is_untyped(toks: read toks, segStart: read segStart, segEnd: read k) { untyped = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_is_untyped(toks: read toks, segStart: read segStart, segEnd: read close) { untyped = true }
    return untyped
}

// Valid v0.6 effect names for an `effects(...)` clause (check_function_effects).
fn is_valid_effect_name(name: read String) -> Bool {
    return name == "no_panic" || name == "noalloc" || name == "no_block" || name == "pure" || name == "unsafe" || name == "native" || name == "parallel"
}

// Removed runtime effects → RS0012 (removed_runtime_effect_replacement set).
fn is_removed_runtime_effect(name: read String) -> Bool {
    return name == "io" || name == "allocates" || name == "may_panic" || name == "may_fail" || name == "async" || name == "suspends"
}

// Index of the `(` of a top-level `effects(...)` clause in a function signature,
// or -1. The clause sits after the param list, before the body.
fn find_effects_open(toks: read List<Tok>, start: read Int) -> Int {
    let ns = fn_name_start(toks: read toks, i: read start)
    // Signature scan must begin at the `fn` keyword (ns - 1), not the decl start:
    // when the decl is attribute-led (`#deprecated(...) fn …`), starting at `#`
    // makes function_signature_end stop at the later `fn` (a top-level-item start).
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return -1 }
    let pclose = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return -1 }
    let mut k = pclose + 1
    let mut depth = 0
    let mut r = -1
    while k < sigEnd && r < 0 {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && tk_text(toks: read toks, i: read k) == "effects" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            r = k + 1
        }
        k = k + 1
    }
    return r
}

// Classify one effects-clause item [segStart,segEnd) exactly like parse_effects:
//   1 = a valid bare `Name` (single-token effect name)
//   2 = a valid `retains(ident)` item
//   0 = malformed (empty, non-ident, `name(args)`, bad retains) → skipped, no check
fn effect_item_kind(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Int {
    if segStart >= segEnd { return 0 }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return 0 }
    let name = tk_text(toks: read toks, i: read segStart)
    if name == "retains" {
        if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read (segStart + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close >= 0 && (close + 1) == segEnd && (segStart + 3) == close && is_ident_tok(toks: read toks, i: read (segStart + 2)) {
                return 2
            }
        }
        return 0
    }
    if (segStart + 1) == segEnd { return 1 }
    return 0
}

// Walk a function's `effects(...)` items (only the VALID ones — malformed items
// recover to RS0015 and are skipped). `mode`: 0 = RS0004 (unknown effect: `fresh`
// or an unrecognized name), 1 = RS0012 (removed runtime effect).
fn effects_name_probe(toks: read List<Tok>, start: read Int, mode: read Int) -> Bool {
    let effOpen = find_effects_open(toks: read toks, start: read start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: read toks, open: read effOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if effect_name_hits(toks: read toks, segStart: read segStart, segEnd: read k, mode: read mode) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_name_hits(toks: read toks, segStart: read segStart, segEnd: read effClose, mode: read mode) { hit = true }
    return hit
}

// Does a single VALID bare-name item trigger `mode`? (retains/malformed items
// never trigger RS0004/RS0012.)
fn effect_name_hits(toks: read List<Tok>, segStart: read Int, segEnd: read Int, mode: read Int) -> Bool {
    if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read segEnd) != 1 { return false }
    let name = tk_text(toks: read toks, i: read segStart)
    if mode == 1 { return is_removed_runtime_effect(name: read name) }
    // mode 2: RS0101 — the `native` effect (a `native fn` boundary, or any fn with
    // `effects(native)`). Used to gate the `native` file feature.
    if mode == 2 { return name == "native" }
    if name == "fresh" { return true }
    if is_removed_runtime_effect(name: read name) { return false }
    return is_valid_effect_name(name: read name) == false
}

// RS0011: a parameter written `name: share …` (no data effect, type name `share`).
fn fn_has_share_param(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    // Signature scan must begin at the `fn` keyword (ns - 1), not the decl start:
    // when the decl is attribute-led (`#deprecated(...) fn …`), starting at `#`
    // makes function_signature_end stop at the later `fn` (a top-level-item start).
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_is_share(toks: read toks, segStart: read segStart, segEnd: read k) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_is_share(toks: read toks, segStart: read segStart, segEnd: read close) { hit = true }
    return hit
}

// RS0033: a decimal integer literal that does not fit i64 (check_integer_literal_
// range: all-ASCII-digit text whose value overflows). Non-decimal / float literals
// (containing `.`, `e`, `x`, …) are left alone — their text isn't all digits.
fn is_int_out_of_range(text: read String) -> Bool {
    let cs = String.chars(value: read text)
    let n = List.len(list: read cs)
    if n == 0 { return false }
    let mut allDigit = true
    let mut i = 0
    while i < n {
        let code = Char.to_code(value: read List.get(list: read cs, index: read i))
        if code < 48 || code > 57 { allDigit = false }
        i = i + 1
    }
    if allDigit == false { return false }
    // Strip leading zeros (Rust's i64 parse accepts them: `007` → 7).
    let mut start = 0
    while start < (n - 1) && Char.to_code(value: read List.get(list: read cs, index: read start)) == 48 {
        start = start + 1
    }
    let digits = n - start
    if digits > 19 { return true }
    if digits < 19 { return false }
    // Exactly 19 significant digits: compare against i64::MAX digit-by-digit.
    let ms = String.chars(value: read "9223372036854775807")
    let mut j = 0
    let mut result = false
    let mut decided = false
    while j < 19 && decided == false {
        let a = Char.to_code(value: read List.get(list: read cs, index: read (start + j)))
        let b = Char.to_code(value: read List.get(list: read ms, index: read j))
        if a > b {
            result = true
            decided = true
        } else if a < b {
            decided = true
        }
        j = j + 1
    }
    return result
}

// Whole-file scan: any decimal integer literal token out of i64 range → RS0033.
fn has_out_of_range_int(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if tk_kind(toks: read toks, i: read i) == TOK_NUMBER {
            if is_int_out_of_range(text: read tk_text(toks: read toks, i: read i)) { hit = true }
        }
        i = i + 1
    }
    return hit
}

// RS0212: a value derive on a `resource` type. Resources are move-only RAII values
// that support only `Debug`/`Schema`/`ReviewSchema`; `Clone`/`Eq`/`Ord`/`Hash`/
// `JsonEncode`/`JsonDecode` would copy or compare the resource (analyzer/derives.rs
// check_resource_derives). Decidable from declaration structure alone.
fn is_banned_resource_derive(name: read String) -> Bool {
    return name == "Clone" || name == "Eq" || name == "Ord" || name == "Hash" || name == "JsonEncode" || name == "JsonDecode"
}

// Scan a resource decl's header [nameIdx, declEnd) for a `derives(...)` clause and
// report a banned value derive. The body `{` terminates the header.
fn resource_derives_bad(toks: read List<Tok>, nameIdx: read Int, declEnd: read Int) -> Bool {
    let mut k = nameIdx + 1
    let mut hit = false
    let mut going = true
    while going {
        if k >= declEnd {
            going = false
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            going = false
        } else if tk_text(toks: read toks, i: read k) == "derives" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close < 0 {
                going = false
            } else {
                let mut m = k + 2
                while m < close {
                    if is_ident_tok(toks: read toks, i: read m) && is_banned_resource_derive(name: read tk_text(toks: read toks, i: read m)) {
                        hit = true
                    }
                    m = m + 1
                }
                k = close + 1
            }
        } else {
            k = k + 1
        }
    }
    return hit
}

fn has_bad_resource_derive(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            if starts_type_decl(toks: read toks, i: read i, isPub: read cls.isPub) {
                let ns = type_name_start(toks: read toks, i: read i)
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if at_ident(toks: read toks, i: read (ns - 1), wid: read WORD_RESOURCE) {
                        if resource_derives_bad(toks: read toks, nameIdx: read ns, declEnd: read r) { hit = true }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0211: DERIVE_FIELD_UNSUPPORTED. A value-derive trait whose field types don't satisfy
// the trait constraint. Float is not Eq/Ord/Hash (but IS Clone); a `handle` field is not
// Eq/Ord/Hash; a Map keyed by Float or List is not Eq/Ord/Hash, and a Float Map key is not
// JsonDecode-able. A field type that transitively contains Float (e.g. `GenericKeyHolder
// <Float>`) fails the same way (the inner Float is not Eq). Message: "`<Trait>` derive is
// not supported by field `<name>`." (analyzer/derives.rs). Scans type-decl headers for a
// `derives(...)` clause, then each `name: Type` field in the body.

// Whether the derives(...) clause in [nameIdx, bodyOpen) contains the given trait name.
fn derive_has_trait(toks: read List<Tok>, nameIdx: read Int, bodyOpen: read Int, traitName: read String) -> Bool {
    let mut k = nameIdx + 1
    let mut found = false
    while k < bodyOpen {
        if tk_text(toks: read toks, i: read k) == "derives" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close < 0 {
                k = bodyOpen
            } else {
                let mut m = k + 2
                while m < close {
                    if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == traitName { found = true }
                    m = m + 1
                }
                k = close + 1
            }
        } else {
            k = k + 1
        }
    }
    return found
}

// Generic params declared in `struct Name<T, U>` — the idents inside the `<...>` right after
// the type name. Empty if the type is non-generic.
fn collect_struct_generics(toks: read List<Tok>, nameIdx: read Int, bodyOpen: read Int) -> Set<String> {
    let mut params = Set.new<String>()
    if (nameIdx + 1) < bodyOpen && at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_LANGLE) {
        let close = find_matching(toks: read toks, open: read (nameIdx + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if close >= 0 {
            let mut m = nameIdx + 2
            while m < close {
                if is_ident_tok(toks: read toks, i: read m) {
                    let nm = tk_text(toks: read toks, i: read m)
                    Set.insert<String>(set: mut params, value: read nm)
                }
                m = m + 1
            }
        }
    }
    return params
}

// Whether the type in [ts, te) is usable as a Map key — i.e. is Hash. Int/String/Bool/Char
// are Hash; Float is not; List<E>/Map<E,_> are Hash iff their key/element is; a generic param
// is Hash only if the enclosing struct also derives Hash (which bounds it); any other user
// type is assumed Hash-safe (avoids false positives — the direct Float/handle scan catches
// the concrete non-Eq cases). Only the root token and its first generic arg are inspected.
fn type_is_hash_safe(toks: read List<Tok>, ts: read Int, te: read Int, genParams: read Set<String>, derivesHash: read Bool) -> Bool {
    if ts >= te { return true }
    let root = tk_text(toks: read toks, i: read ts)
    if root == "Int" || root == "String" || root == "Bool" || root == "Char" { return true }
    if root == "Float" { return false }
    if root == "List" || root == "Map" {
        // recurse on the first generic argument (List<E> element, Map<K,_> key)
        if (ts + 1) < te && at_symbol(toks: read toks, i: read (ts + 1), code: read SYM_LANGLE) {
            let close = find_matching(toks: read toks, open: read (ts + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
            let inner = arg_end(toks: read toks, start: read (ts + 2), limit: read te)
            return type_is_hash_safe(toks: read toks, ts: read (ts + 2), te: read inner, genParams: read genParams, derivesHash: read derivesHash)
        }
        return true
    }
    if Set.contains<String>(set: read genParams, value: read root) { return derivesHash }
    return true
}

// End of the first generic argument that starts at `start`: the top-level `,` inside the
// enclosing `<...>`, or `limit`.
fn arg_end(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let mut m = start
    let mut depth = 0
    let mut result = limit
    let mut going = true
    while going {
        if m >= limit {
            result = limit
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read m, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read m, code: read SYM_LBRACKET) {
            depth = depth + 1
            m = m + 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read m, code: read SYM_RBRACKET) {
            depth = depth - 1
            m = m + 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RANGLE) {
            if depth == 0 {
                result = m
                going = false
            } else {
                depth = depth - 1
                m = m + 1
            }
        } else if depth == 0 && at_symbol(toks: read toks, i: read m, code: read SYM_COMMA) {
            result = m
            going = false
        } else {
            m = m + 1
        }
    }
    return result
}

// The first `{` in [nameIdx, declEnd) — the type body open (derives(...) uses parens, and a
// generic `<T>` uses angles, so the first brace is always the body).
fn derive_type_body_open(toks: read List<Tok>, nameIdx: read Int, declEnd: read Int) -> Int {
    let mut k = nameIdx + 1
    let mut result = -1
    let mut going = true
    while going {
        if k >= declEnd {
            going = false
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            result = k
            going = false
        } else {
            k = k + 1
        }
    }
    return result
}

// RS0032: a type used where a generic method requires a protocol it does not satisfy —
// `Set.new<T>`/`Map.new<K,_>`/`Set.insert`/`Map.insert` require the element/key to be
// Hashable, `List.sort<T>` requires Ord. Message: "type `T` does not satisfy protocol
// `Hashable`/`Ord` required by `<call>`." The parity check is presence-per-file, so the
// explicit-type-arg forms (`Set.new<T>`, `Map.new<K,V>`, `List.sort<T>`) suffice — every
// RS0032 file carries one. A user struct/class/sum is Hashable/Ord only if it derives
// Hash/Ord; Int/String/Bool/Char are both; Float is neither. Unknown (imported) types are
// left alone to avoid false positives.

// Whether a type DECLARED in this file with the given name derives the given trait. Handles
// both struct/class/resource decls (parse_type_decl) and `sum` decls (parse_sum_decl); a
// parse failure just advances one token rather than aborting the scan.
fn local_type_derives(toks: read List<Tok>, typeName: read String, traitName: read String) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut found = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isTypeDecl = starts_type_decl(toks: read toks, i: read i, isPub: read cls.isPub)
            let isSumDecl = at_ident(toks: read toks, i: read i, wid: read WORD_SUM) || (cls.isPub && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_SUM))
            if isTypeDecl || isSumDecl {
                let ns = type_name_start(toks: read toks, i: read i)
                let mut r = parse_type_decl(toks: read toks, i: read i)
                if isSumDecl { r = parse_sum_decl(toks: read toks, i: read i) }
                if r < 0 {
                    i = i + 1
                } else {
                    if is_ident_tok(toks: read toks, i: read ns) && tk_text(toks: read toks, i: read ns) == typeName {
                        let bo = derive_type_body_open(toks: read toks, nameIdx: read ns, declEnd: read r)
                        let mut hdrEnd = r
                        if bo >= 0 { hdrEnd = bo }
                        if derive_has_trait(toks: read toks, nameIdx: read ns, bodyOpen: read hdrEnd, traitName: read traitName) { found = true }
                        running = false
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return found
}

// Whether the root type at `ts` satisfies a protocol: `wantHash` = Hashable, else Ord.
// Returns true (satisfies, no fire) for scalars and for unknown/imported types.
fn arg_root_satisfies(toks: read List<Tok>, ts: read Int, te: read Int, declared: read Set<String>, wantHash: read Bool) -> Bool {
    if ts >= te { return true }
    let root = tk_text(toks: read toks, i: read ts)
    if root == "Int" || root == "String" || root == "Char" || root == "Bool" { return true }
    if root == "Float" { return false }
    if Set.contains<String>(set: read declared, value: read root) {
        if wantHash {
            return local_type_derives(toks: read toks, typeName: read root, traitName: read "Hash")
        }
        return local_type_derives(toks: read toks, typeName: read root, traitName: read "Ord")
    }
    return true
}

// Fire when `recv.method<TypeArg, ..>` requires a protocol the first type arg lacks.
fn call_protocol_bad(toks: read List<Tok>, i: read Int, recv: read String, method: read String, declared: read Set<String>, wantHash: read Bool) -> Bool {
    if tk_text(toks: read toks, i: read i) == recv && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_DOT) && tk_text(toks: read toks, i: read (i + 2)) == method && at_symbol(toks: read toks, i: read (i + 3), code: read SYM_LANGLE) {
        let rangle = find_matching(toks: read toks, open: read (i + 3), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if rangle > (i + 4) {
            let te = arg_end(toks: read toks, start: read (i + 4), limit: read rangle)
            if arg_root_satisfies(toks: read toks, ts: read (i + 4), te: read te, declared: read declared, wantHash: read wantHash) == false { return true }
        }
    }
    return false
}

fn has_protocol_violation(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let declared = collect_declared_types(toks: read toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if call_protocol_bad(toks: read toks, i: read i, recv: read "Set", method: read "new", declared: read declared, wantHash: read true) { hit = true }
        if call_protocol_bad(toks: read toks, i: read i, recv: read "Map", method: read "new", declared: read declared, wantHash: read true) { hit = true }
        if call_protocol_bad(toks: read toks, i: read i, recv: read "List", method: read "sort", declared: read declared, wantHash: read false) { hit = true }
        i = i + 1
    }
    return hit
}

// RS1004: surface reference syntax (`&T` / `&mut T`) is not part of RSScript — it only ever
// appears in a TYPE position (borrow-passing uses the `read`/`mut`/`take` effect keywords, not
// `&`). Message: "surface reference syntax is not part of RSScript." Detect `& mut` (mut is a
// reserved keyword, so this is never a bitwise-and), `: &` (a type starting with `&`), or
// `-> &` (a return type starting with `&`). Bitwise-and `a & b` never matches these.
fn has_surface_reference(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while (i + 1) < ntok {
        if at_symbol(toks: read toks, i: read i, code: read SYM_AMP) && tk_text(toks: read toks, i: read (i + 1)) == "mut" { hit = true }
        if at_symbol(toks: read toks, i: read i, code: read SYM_COLON) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_AMP) { hit = true }
        if at_symbol(toks: read toks, i: read i, code: read SYM_ARROW) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_AMP) { hit = true }
        i = i + 1
    }
    return hit
}

// RS0708: an eager `ResourcePool<T>.new(...)` allocates up front, so its `max_size` must be a
// positive literal or a `const` (a `.lazy(...)` pool sizes on demand and is exempt). Message:
// "`ResourcePool.new` requires a positive literal `max_size`." Fire when the `max_size` value
// is `0`/negative, a runtime binding (not a `const`), or any non-literal expression.

// Names declared with `const` (or `pub const`) in the file.
fn collect_const_names(toks: read List<Tok>) -> Set<String> {
    let mut names = Set.new<String>()
    let ntok = List.len(list: read toks)
    let mut i = 0
    while i < ntok {
        if at_ident(toks: read toks, i: read i, wid: read WORD_CONST) && is_ident_tok(toks: read toks, i: read (i + 1)) {
            let nm = tk_text(toks: read toks, i: read (i + 1))
            Set.insert<String>(set: mut names, value: read nm)
        }
        i = i + 1
    }
    return names
}

// Whether the `max_size` value in [vs, ve) is not an accepted eager size: OK only when it is a
// single positive integer literal or a single `const` identifier.
fn maxsize_value_bad(toks: read List<Tok>, vs: read Int, ve: read Int, consts: read Set<String>) -> Bool {
    if (ve - vs) == 1 {
        if tk_kind(toks: read toks, i: read vs) == TOK_NUMBER {
            return tk_text(toks: read toks, i: read vs) == "0"
        }
        if is_ident_tok(toks: read toks, i: read vs) {
            return Set.contains<String>(set: read consts, value: read tk_text(toks: read toks, i: read vs)) == false
        }
        return true
    }
    return true
}

fn has_resourcepool_maxsize_bad(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let consts = collect_const_names(toks: read toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if tk_text(toks: read toks, i: read i) == "ResourcePool" && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LANGLE) {
            let rangle = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
            if rangle >= 0 && at_symbol(toks: read toks, i: read (rangle + 1), code: read SYM_DOT) && tk_text(toks: read toks, i: read (rangle + 2)) == "new" && at_symbol(toks: read toks, i: read (rangle + 3), code: read SYM_LPAREN) {
                let callClose = find_matching(toks: read toks, open: read (rangle + 3), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if callClose >= 0 {
                    let mut k = rangle + 4
                    while k < callClose {
                        if tk_text(toks: read toks, i: read k) == "max_size" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
                            let vs = k + 2
                            let ve = arg_end(toks: read toks, start: read vs, limit: read callClose)
                            if maxsize_value_bad(toks: read toks, vs: read vs, ve: read ve, consts: read consts) { hit = true }
                        }
                        k = k + 1
                    }
                }
            }
        }
        i = i + 1
    }
    return hit
}

// End of the field type that starts at `ts`: the next top-level (nesting-depth 0) `name:`
// field header, or bodyClose. `< ( [` open and `> ) ]` close a nesting level.
fn field_type_end(toks: read List<Tok>, ts: read Int, bodyClose: read Int) -> Int {
    let mut m = ts
    let mut depth = 0
    let mut result = bodyClose
    let mut going = true
    while going {
        if m >= bodyClose {
            result = bodyClose
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read m, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read m, code: read SYM_LBRACKET) {
            depth = depth + 1
            m = m + 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read m, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read m, code: read SYM_RBRACKET) {
            depth = depth - 1
            m = m + 1
        } else if depth == 0 && m > ts && is_ident_tok(toks: read toks, i: read m) && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) {
            result = m
            going = false
        } else {
            m = m + 1
        }
    }
    return result
}

// Whether the field type in [ts, te) violates a derived trait: (Eq/Ord/Hash) a `Float` type
// token or a `handle` modifier anywhere; (Eq/Ord/Hash/JsonDecode) a `Map<Float, ..>` or
// `Map<List.., ..>` key.
fn field_type_bad_for_derive(toks: read List<Tok>, ts: read Int, te: read Int, hasEOH: read Bool, hasJD: read Bool, genParams: read Set<String>, derivesHash: read Bool) -> Bool {
    let mut k = ts
    let mut bad = false
    while k < te {
        if hasEOH {
            if is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == "Float" { bad = true }
            if tk_text(toks: read toks, i: read k) == "handle" { bad = true }
        }
        // A Map key must be Hash. Applies to any derive (Eq/Ord/Hash need the field to be
        // Eq/Ord/Hash, which needs the Map well-formed; JsonDecode needs string-decodable keys).
        if (hasEOH || hasJD) && tk_text(toks: read toks, i: read k) == "Map" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LANGLE) {
            let keyEnd = arg_end(toks: read toks, start: read (k + 2), limit: read te)
            if type_is_hash_safe(toks: read toks, ts: read (k + 2), te: read keyEnd, genParams: read genParams, derivesHash: read derivesHash) == false { bad = true }
        }
        k = k + 1
    }
    return bad
}

// Iterate `name: Type` fields in the body [bodyOpen, bodyClose) and test each type.
fn derive_body_fields_bad(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, hasEOH: read Bool, hasJD: read Bool, genParams: read Set<String>, derivesHash: read Bool) -> Bool {
    let mut i = bodyOpen + 1
    let mut hit = false
    while i < bodyClose {
        if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            let ts = i + 2
            let te = field_type_end(toks: read toks, ts: read ts, bodyClose: read bodyClose)
            if field_type_bad_for_derive(toks: read toks, ts: read ts, te: read te, hasEOH: read hasEOH, hasJD: read hasJD, genParams: read genParams, derivesHash: read derivesHash) { hit = true }
            i = te
        } else {
            i = i + 1
        }
    }
    return hit
}

fn has_bad_derive_field(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            if starts_type_decl(toks: read toks, i: read i, isPub: read cls.isPub) {
                let ns = type_name_start(toks: read toks, i: read i)
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let bo = derive_type_body_open(toks: read toks, nameIdx: read ns, declEnd: read r)
                    if bo >= 0 {
                        let hasEq = derive_has_trait(toks: read toks, nameIdx: read ns, bodyOpen: read bo, traitName: read "Eq")
                        let hasOrd = derive_has_trait(toks: read toks, nameIdx: read ns, bodyOpen: read bo, traitName: read "Ord")
                        let hasHash = derive_has_trait(toks: read toks, nameIdx: read ns, bodyOpen: read bo, traitName: read "Hash")
                        let hasEOH = hasEq || hasOrd || hasHash
                        let hasJD = derive_has_trait(toks: read toks, nameIdx: read ns, bodyOpen: read bo, traitName: read "JsonDecode")
                        if hasEOH || hasJD {
                            let bc = find_matching(toks: read toks, open: read bo, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                            if bc >= 0 {
                                let genParams = collect_struct_generics(toks: read toks, nameIdx: read ns, bodyOpen: read bo)
                                if derive_body_fields_bad(toks: read toks, bodyOpen: read bo, bodyClose: read bc, hasEOH: read hasEOH, hasJD: read hasJD, genParams: read genParams, derivesHash: read hasHash) { hit = true }
                            }
                        }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0034: a bare `Ok(...)`/`Err(...)`/`None` bound to an UNUSED name with no type
// annotation leaves a type parameter open with nothing to pin it (oracle
// checks/body/binding.rs::open_variant_constructor + unused-name analysis).

// Any other ident-token occurrence of `name` in the body besides the binding at `skip`.
fn name_used_in_body(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String, skip: read Int) -> Bool {
    let mut k = bodyOpen + 1
    let mut used = false
    while k < bodyClose {
        if k != skip && is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == name {
            used = true
        }
        k = k + 1
    }
    return used
}

// One `let` at `letPos`: RS0034 iff `let [mut] NAME = <open-ctor>` (no `: Type`),
// the RHS is EXACTLY `None`/`Ok(...)`/`Err(...)` (nothing trailing), and NAME is unused.
fn let_is_uninferable(toks: read List<Tok>, letPos: read Int, bodyOpen: read Int, bodyClose: read Int) -> Bool {
    let mut q = letPos + 1
    if is_kw_text(toks: read toks, i: read q, word: read "mut") { q = q + 1 }
    if is_ident_tok(toks: read toks, i: read q) == false { return false }
    let name = tk_text(toks: read toks, i: read q)
    if at_symbol(toks: read toks, i: read (q + 1), code: read SYM_EQ) == false { return false }
    let rhs = q + 2
    if is_ident_tok(toks: read toks, i: read rhs) == false { return false }
    if at_symbol(toks: read toks, i: read (rhs - 1), code: read SYM_DOT) { return false }
    let lineEnd = next_line_or_block_end(toks: read toks, start: read rhs, end: read bodyClose)
    let head = tk_text(toks: read toks, i: read rhs)
    let mut isOpen = false
    if head == "None" {
        if (rhs + 1) >= lineEnd { isOpen = true }
    } else if head == "Ok" || head == "Err" {
        if at_symbol(toks: read toks, i: read (rhs + 1), code: read SYM_LPAREN) {
            let rc = find_matching(toks: read toks, open: read (rhs + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if rc >= 0 && (rc + 1) >= lineEnd { isOpen = true }
        }
    }
    if isOpen == false { return false }
    return name_used_in_body(toks: read toks, bodyOpen: read bodyOpen, bodyClose: read bodyClose, name: read name, skip: read q) == false
}

// RS0034 over one fn body: any uninferable `let` binding.
fn fn_has_uninferable_binding(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "let") {
            if let_is_uninferable(toks: read toks, letPos: read k, bodyOpen: read sigEnd, bodyClose: read bodyClose) { hit = true }
        }
        k = k + 1
    }
    return hit
}

// RS0311: reassigning an immutable `let` local (oracle analyzer/assign.rs). We fire
// only the FP-safe core — a bare-name simple assignment `NAME = e` where NAME is a
// plain `let` local (not `let mut`, not a param). Compound (`x.f = e`) and param
// cases are also RS0311 but are left as safe false-negatives (no corpus file needs
// them). The scanner emits `==` as two SYM_EQ and never fuses `=`, so a SYM_EQ whose
// next token isn't `=` and whose previous token is an ident (not after `let`/`mut`)
// is exactly an assignment.
fn collect_let_kinds(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, immut: mut Set<String>, mutable: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut q = k + 1
            let isMut = is_kw_text(toks: read toks, i: read q, word: read "mut")
            if isMut { q = q + 1 }
            if is_ident_tok(toks: read toks, i: read q) {
                let name = tk_text(toks: read toks, i: read q)
                if isMut {
                    Set.insert<String>(set: mut mutable, value: read name)
                } else {
                    Set.insert<String>(set: mut immut, value: read name)
                }
            }
        }
        k = k + 1
    }
    return Unit
}

// Add every param name (`name:` at the top level of the param parens) to `out`. Used
// as an assignment-exclusion set: a `mut` Copy-scalar param IS legally reassignable,
// so we never fire RS0311 on a param-named binding (safe over-approximation — the
// rare `let` that shadows a param stays a false-negative rather than a false-positive).
fn collect_param_names(toks: read List<Tok>, ns: read Int, sigEnd: read Int, out: mut Set<String>) -> Unit {
    let popen = find_top_sym(toks: read toks, start: read ns, end: read sigEnd, code: read SYM_LPAREN)
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read k))
        }
        k = k + 1
    }
    return Unit
}

fn fn_has_immutable_assign(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut immut = Set<String>.new()
    let mut mutable = Set<String>.new()
    collect_param_names(toks: read toks, ns: read ns, sigEnd: read sigEnd, out: mut mutable)
    collect_let_kinds(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, immut: mut immut, mutable: mut mutable)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_EQ) {
            if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_EQ) == false {
                if is_ident_tok(toks: read toks, i: read (k - 1)) {
                    let assignee = tk_text(toks: read toks, i: read (k - 1))
                    let notLet = is_kw_text(toks: read toks, i: read (k - 2), word: read "let") == false
                    let notMut = is_kw_text(toks: read toks, i: read (k - 2), word: read "mut") == false
                    let notLocal = is_kw_text(toks: read toks, i: read (k - 2), word: read "local") == false
                    if notLet && notMut && notLocal {
                        if Set.contains<String>(set: read immut, value: read assignee) {
                            if Set.contains<String>(set: read mutable, value: read assignee) == false {
                                hit = true
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0313: a reassignment `name = <value>` whose value type doesn't match the local's declared
// type, e.g. `count = "oops"` where `count: Int`. Message: "cannot assign `String` to `count`
// of type `Int`." Conservative: only a literal RHS (String/number/Bool/Char) vs an explicitly
// annotated scalar local, compared by category (String / Numeric / Bool / Char) — a category
// mismatch is unambiguous and never a false positive (Int↔Float coercion stays in one category).

// The broad scalar category of a declared type root, or "" if not a simple scalar.
fn type_scalar_cat(t: read String) -> String {
    if t == "String" { return "S" }
    if t == "Bool" { return "B" }
    if t == "Char" { return "C" }
    if t == "Int" || t == "Float" { return "N" }
    return ""
}

// The scalar category of a literal token at `i`, or "" if it is not a scalar literal.
fn literal_scalar_cat(toks: read List<Tok>, i: read Int) -> String {
    let k = tk_kind(toks: read toks, i: read i)
    if k == TOK_STRING { return "S" }
    if k == TOK_NUMBER { return "N" }
    if k == TOK_CHAR { return "C" }
    if is_ident_tok(toks: read toks, i: read i) {
        let t = tk_text(toks: read toks, i: read i)
        if t == "true" || t == "false" { return "B" }
    }
    return ""
}

// The declared type root of the first `let [mut] name : Type` in [bodyOpen, bodyClose), or "".
fn find_local_decl_type(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String) -> String {
    let mut k = bodyOpen + 1
    let mut result = ""
    let mut going = true
    while going {
        if k >= bodyClose {
            going = false
        } else if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut p = k + 1
            if is_kw_text(toks: read toks, i: read p, word: read "mut") { p = p + 1 }
            if is_ident_tok(toks: read toks, i: read p) && tk_text(toks: read toks, i: read p) == name && at_symbol(toks: read toks, i: read (p + 1), code: read SYM_COLON) {
                result = tk_text(toks: read toks, i: read (p + 2))
                going = false
            } else {
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return result
}

fn fn_has_assign_type_mismatch(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_EQ) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_EQ) == false {
            if is_ident_tok(toks: read toks, i: read (k - 1)) {
                let notLet = is_kw_text(toks: read toks, i: read (k - 2), word: read "let") == false
                let notMut = is_kw_text(toks: read toks, i: read (k - 2), word: read "mut") == false
                let notLocal = is_kw_text(toks: read toks, i: read (k - 2), word: read "local") == false
                let notField = at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) == false
                if notLet && notMut && notLocal && notField {
                    let name = tk_text(toks: read toks, i: read (k - 1))
                    let declType = find_local_decl_type(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, name: read name)
                    let dcat = type_scalar_cat(t: read declType)
                    if dcat != "" {
                        let lcat = literal_scalar_cat(toks: read toks, i: read (k + 1))
                        if lcat != "" && lcat != dcat { hit = true }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0312: index assignment `container[i] = v` is only supported for List values. Message:
// "index assignment is only supported for List values." FP-safe: fire only when the container
// is a KNOWN Map/Set/Deque local (from an explicit annotation or a `Map<..>.new()`-style
// initializer) — a List or an unresolved container is left alone.

// Locals whose declared/initialized type root is a non-indexable collection (Map/Set/Deque).
fn collect_nonlist_collection_locals(toks: read List<Tok>) -> Set<String> {
    let mut names = Set.new<String>()
    let ntok = List.len(list: read toks)
    let mut k = 0
    while k < ntok {
        if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut p = k + 1
            if is_kw_text(toks: read toks, i: read p, word: read "mut") { p = p + 1 }
            if is_ident_tok(toks: read toks, i: read p) {
                let q = p + 1
                if at_symbol(toks: read toks, i: read q, code: read SYM_COLON) || at_symbol(toks: read toks, i: read q, code: read SYM_EQ) {
                    let root = tk_text(toks: read toks, i: read (q + 1))
                    if root == "Map" || root == "Set" || root == "Deque" {
                        let nm = tk_text(toks: read toks, i: read p)
                        Set.insert<String>(set: mut names, value: read nm)
                    }
                }
            }
        }
        k = k + 1
    }
    return names
}

// The `[` matching the `]` at `closePos`, or -1.
fn matching_lbracket(toks: read List<Tok>, closePos: read Int) -> Int {
    let mut m = closePos
    let mut depth = 0
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m < 0 {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RBRACKET) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LBRACKET) {
            depth = depth - 1
            if depth == 0 {
                result = m
                going = false
            } else {
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

fn has_index_assign_non_list(toks: read List<Tok>) -> Bool {
    let nonList = collect_nonlist_collection_locals(toks: read toks)
    let ntok = List.len(list: read toks)
    let mut k = 1
    let mut hit = false
    while k < ntok {
        if at_symbol(toks: read toks, i: read k, code: read SYM_EQ) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_EQ) == false && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_RBRACKET) {
            let j = matching_lbracket(toks: read toks, closePos: read (k - 1))
            if j > 0 && is_ident_tok(toks: read toks, i: read (j - 1)) {
                let container = tk_text(toks: read toks, i: read (j - 1))
                if Set.contains<String>(set: read nonList, value: read container) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0307 (`manage`) / RS0308 (`take`): both require an OWNED local value. `manage <x>` /
// `take <x>` fires only when `x` is a MANAGED source — a `read`/`mut` parameter, a `let`
// binding, or a `local` captured across a closure boundary. It is OK (no fire) when `x` is:
// a field access `x.f` (RS0901/other own it); a Type (uppercase — a nested closure's `take T`
// param effect); a `take`-effect parameter (already owned, re-takeable); a `with … as x`
// resource lease (RS0013 owns escapes); or a `local` reachable in the same closure scope. Only
// a closure `|…| { }` is a capture boundary — `if`/`loop`/`while`/`with` blocks share the
// function's locals.

// Parameter names declared with the `take` effect (`name: take Type`).
fn collect_take_params(toks: read List<Tok>, ns: read Int, sigEnd: read Int, out: mut Set<String>) -> Unit {
    // The first `(` after the name (find_top_sym can't match an opening bracket — it counts it
    // as depth before the match check).
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: read toks, i: read tt, code: read SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (k + 2), word: read "take") {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read k))
        }
        k = k + 1
    }
    return Unit
}

// The `(` matching the `)` at `closePos`, or -1.
fn matching_lparen(toks: read List<Tok>, closePos: read Int) -> Int {
    let mut m = closePos
    let mut depth = 0
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m < 0 {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RPAREN) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LPAREN) {
            depth = depth - 1
            if depth == 0 {
                result = m
                going = false
            } else {
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// Lowercase idents bound by a match arm: the payload idents of `Variant(a, b) =>` and a bare
// `name =>` catch-all. Such bindings own their value, so `take`/`manage` of them is allowed.
fn collect_match_bindings(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_FATARROW) && k >= 1 {
            if at_symbol(toks: read toks, i: read (k - 1), code: read SYM_RPAREN) {
                let lp = matching_lparen(toks: read toks, closePos: read (k - 1))
                if lp >= 0 {
                    let mut m = lp + 1
                    while m < (k - 1) {
                        if is_ident_tok(toks: read toks, i: read m) && is_upper_head(name: read tk_text(toks: read toks, i: read m)) == false {
                            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read m))
                        }
                        m = m + 1
                    }
                }
            } else if is_ident_tok(toks: read toks, i: read (k - 1)) && is_upper_head(name: read tk_text(toks: read toks, i: read (k - 1))) == false {
                Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read (k - 1)))
            }
        }
        k = k + 1
    }
    return Unit
}

// Names bound by `with … as <name>` (a resource lease).
fn collect_with_bindings(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "as") && is_ident_tok(toks: read toks, i: read (k + 1)) {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read (k + 1)))
        }
        k = k + 1
    }
    return Unit
}

// The `{` opening the nearest CLOSURE body enclosing `p` (its `{` is preceded by a `|`), or
// `fnBody` if no closure intervenes. Ordinary `{}` blocks are transparent (shared scope).
fn enclosing_capture_open(toks: read List<Tok>, p: read Int, fnBody: read Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = fnBody
    let mut going = true
    while going {
        if m < 0 {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RBRACE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LBRACE) {
            if depth == 0 {
                if m == fnBody {
                    result = fnBody
                    going = false
                } else if m > 0 && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_PIPE) {
                    result = m
                    going = false
                } else {
                    m = m - 1
                }
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// Whether `local [mut] <x>` is declared anywhere in [open, close).
fn local_in_scope_all(toks: read List<Tok>, open: read Int, close: read Int, x: read String) -> Bool {
    let mut k = open + 1
    let mut found = false
    while k < close {
        if is_kw_text(toks: read toks, i: read k, word: read "local") {
            let mut q = k + 1
            if is_kw_text(toks: read toks, i: read q, word: read "mut") { q = q + 1 }
            if is_ident_tok(toks: read toks, i: read q) && tk_text(toks: read toks, i: read q) == x { found = true }
        }
        k = k + 1
    }
    return found
}

fn fn_manage_take_bad(toks: read List<Tok>, start: read Int, keyword: read String) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut takeParams = Set.new<String>()
    collect_take_params(toks: read toks, ns: read ns, sigEnd: read sigEnd, out: mut takeParams)
    let mut withBinds = Set.new<String>()
    collect_with_bindings(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, out: mut withBinds)
    let mut matchBinds = Set.new<String>()
    collect_match_bindings(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, out: mut matchBinds)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read keyword) && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let x = tk_text(toks: read toks, i: read (k + 1))
            // A PLAIN field access `x.f` is owned (RS0901 territory) — but a METHOD-CALL result
            // `x.m(…)` is a managed temp and DOES fire. Exclude only the former (dot, no call).
            let isField = at_symbol(toks: read toks, i: read (k + 2), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (k + 4), code: read SYM_LPAREN) == false
            let isType = is_upper_head(name: read x)
            let isTakeParam = Set.contains<String>(set: read takeParams, value: read x)
            // A `with … as x` lease is owned for `take` (RS0013 owns the escape) but managed
            // for `manage` (RS0307 fires on `manage <lease>`).
            let isWith = keyword == "take" && Set.contains<String>(set: read withBinds, value: read x)
            let isMatch = Set.contains<String>(set: read matchBinds, value: read x)
            if isField == false && isType == false && isTakeParam == false && isWith == false && isMatch == false {
                let scopeOpen = enclosing_capture_open(toks: read toks, p: read k, fnBody: read sigEnd)
                let mut scopeClose = find_matching(toks: read toks, open: read scopeOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if scopeClose < 0 { scopeClose = bodyClose }
                if local_in_scope_all(toks: read toks, open: read scopeOpen, close: read scopeClose, x: read x) == false { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0301 MANAGED_TO_LOCAL: `local X = RHS` where RHS is a managed place — a plain `let`
// binding (ALWAYS managed, even scalar — confirmed via oracle), a `handle`-field access, or a
// `Some(…)`/`Ok(…)` wrapper around one (after an optional leading `read`/`mut`). Params,
// `local` bindings, literals, and normal (non-handle) field accesses are NOT managed.

// Field names declared with the `handle` modifier anywhere (`name: handle Type`).
fn collect_handle_field_names(toks: read List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: read toks)
    let mut k = 0
    while k + 2 < n {
        if is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (k + 2), word: read "handle") {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read k))
        }
        k = k + 1
    }
    return Unit
}

// Whether the RHS value at `vs` is a managed place for RS0301: a `let` binding, a
// `handle`-field access `_.f`, or `Some(…)`/`Ok(…)` wrapping one (after an optional effect).
fn rhs_managed_for_local(toks: read List<Tok>, vs: read Int, end: read Int, managed: read Set<String>, handleFields: read Set<String>) -> Bool {
    let mut s = vs
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if s >= end { return false }
    if is_ident_tok(toks: read toks, i: read s) == false { return false }
    let head = tk_text(toks: read toks, i: read s)
    if (head == "Some" || head == "Ok") && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN) {
        return rhs_managed_for_local(toks: read toks, vs: read (s + 2), end: read end, managed: read managed, handleFields: read handleFields)
    }
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (s + 2)) {
        let field = tk_text(toks: read toks, i: read (s + 2))
        return Set.contains<String>(set: read handleFields, value: read field)
    }
    return Set.contains<String>(set: read managed, value: read head)
}

fn fn_has_managed_to_local(toks: read List<Tok>, start: read Int, handleFields: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let managed = collect_managed_names(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "local") {
            let mut nameIdx = k + 1
            if is_kw_text(toks: read toks, i: read nameIdx, word: read "mut") { nameIdx = nameIdx + 1 }
            if is_ident_tok(toks: read toks, i: read nameIdx) {
                let mut eqPos = 0 - 1
                let mut t = nameIdx + 1
                let mut scan = true
                while scan {
                    if t >= bodyClose {
                        scan = false
                    } else if at_symbol(toks: read toks, i: read t, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read t, code: read SYM_RBRACE) {
                        scan = false
                    } else if at_symbol(toks: read toks, i: read t, code: read SYM_EQ) && at_symbol(toks: read toks, i: read (t + 1), code: read SYM_EQ) == false {
                        eqPos = t
                        scan = false
                    } else {
                        t = t + 1
                    }
                }
                if eqPos > 0 {
                    if rhs_managed_for_local(toks: read toks, vs: read (eqPos + 1), end: read bodyClose, managed: read managed, handleFields: read handleFields) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0401 USE_AFTER_MANAGE: a `manage x` / `take x` moves `x`, so any USE of `x` later in the
// function body is an error — even when the move sits inside a branch or loop (rss treats a
// conditionally-moved value as moved on the continuation). A "use" is an occurrence of the
// ident `x` that is not an arg/field label (`x:`), not a field of another place (`_.x`), not a
// (re)binding position (`let`/`local`/`mut x`), and not an assignment target (`x =`).
fn used_after_move(toks: read List<Tok>, from: read Int, close: read Int, x: read String) -> Bool {
    let mut m = from
    let mut found = false
    while m < close {
        if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == x {
            let prevDot = at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT)
            let prevBind = is_kw_text(toks: read toks, i: read (m - 1), word: read "let") || is_kw_text(toks: read toks, i: read (m - 1), word: read "local") || is_kw_text(toks: read toks, i: read (m - 1), word: read "mut")
            let nextColon = at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON)
            let nextAssign = at_symbol(toks: read toks, i: read (m + 1), code: read SYM_EQ) && at_symbol(toks: read toks, i: read (m + 2), code: read SYM_EQ) == false
            if prevDot == false && prevBind == false && nextColon == false && nextAssign == false { found = true }
        }
        m = m + 1
    }
    return found
}

// The `{` opening the immediate block enclosing `p`, floored at `fnBody` (the fn body `{`).
fn enclosing_block_open(toks: read List<Tok>, p: read Int, fnBody: read Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = fnBody
    let mut going = true
    while going {
        if m <= fnBody {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RBRACE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LBRACE) {
            if depth == 0 {
                result = m
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// Whether a `return` keyword appears in [from, to). Only `return` exits the FUNCTION, so a move
// on that path never taints the continuation; a `break` merely exits a loop and execution
// continues after it, so a move before a `break` still taints the post-loop continuation.
fn has_return_or_break(toks: read List<Tok>, from: read Int, to: read Int) -> Bool {
    let mut m = from
    let mut found = false
    while m < to {
        if is_kw_text(toks: read toks, i: read m, word: read "return") { found = true }
        m = m + 1
    }
    return found
}

// Whether the field path `base . field` is used in [from, close), excluding a binding position.
fn used_field_after_move(toks: read List<Tok>, from: read Int, close: read Int, base: read String, field: read String) -> Bool {
    let mut m = from
    let mut found = false
    while m < close {
        if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == base && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (m + 2)) && tk_text(toks: read toks, i: read (m + 2)) == field {
            let prevBind = is_kw_text(toks: read toks, i: read (m - 1), word: read "let") || is_kw_text(toks: read toks, i: read (m - 1), word: read "local")
            let prevDot = at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT)
            if prevBind == false && prevDot == false { found = true }
        }
        m = m + 1
    }
    return found
}

fn fn_has_use_after_manage(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        let isMove = is_kw_text(toks: read toks, i: read k, word: read "manage") || is_kw_text(toks: read toks, i: read k, word: read "take")
        if isMove && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let x = tk_text(toks: read toks, i: read (k + 1))
            if is_upper_head(name: read x) == false {
                // A move in a block that returns/breaks does not taint the continuation past
                // that block — limit the scan to the enclosing block in that case.
                let bo = enclosing_block_open(toks: read toks, p: read k, fnBody: read sigEnd)
                let mut bc = find_matching(toks: read toks, open: read bo, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if bc < 0 { bc = bodyClose }
                let exits = has_return_or_break(toks: read toks, from: read (k + 1), to: read bc)
                let mut scanEnd = bodyClose
                if exits { scanEnd = bc }
                if at_symbol(toks: read toks, i: read (k + 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (k + 3)) {
                    let field = tk_text(toks: read toks, i: read (k + 3))
                    if used_field_after_move(toks: read toks, from: read (k + 4), close: read scanEnd, base: read x, field: read field) { hit = true }
                } else {
                    if used_after_move(toks: read toks, from: read (k + 2), close: read scanEnd, x: read x) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0501 LOCAL_VALUE_RETAINED: passing a `local` value as an argument to a parameter the callee
// declares `effects(retains(P))`. A local's lifetime is the caller's frame, so it can't be
// retained beyond the call. (A `let`/managed value passed there is a different error — the take
// itself is RS0308; a managed value can legitimately be retained.)

// Registry of retained params as composite keys `shortFnName|paramName`, across all fn decls in
// the file (analyze_source is per-file, so callee decls are in-scope here).
fn collect_retains(toks: read List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "fn") {
            let mut p = k + 1
            let mut scan = true
            while scan {
                if p >= n {
                    scan = false
                } else if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) || is_kw_text(toks: read toks, i: read p, word: read "fn") || at_symbol(toks: read toks, i: read p, code: read SYM_LBRACE) {
                    scan = false
                } else {
                    p = p + 1
                }
            }
            if p < n && at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (p - 1)) {
                let shortName = tk_text(toks: read toks, i: read (p - 1))
                let pclose = find_matching(toks: read toks, open: read p, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if pclose > 0 {
                    let mut e = pclose + 1
                    let mut go = true
                    while go {
                        if e >= n {
                            go = false
                        } else if at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) || is_kw_text(toks: read toks, i: read e, word: read "fn") {
                            go = false
                        } else if is_ident_tok(toks: read toks, i: read e) && tk_text(toks: read toks, i: read e) == "retains" && at_symbol(toks: read toks, i: read (e + 1), code: read SYM_LPAREN) {
                            let rclose = find_matching(toks: read toks, open: read (e + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                            if rclose > 0 {
                                let mut m = e + 2
                                while m < rclose {
                                    if is_ident_tok(toks: read toks, i: read m) {
                                        let key = String.concat(left: read String.concat(left: read shortName, right: read "|"), right: read tk_text(toks: read toks, i: read m))
                                        Set.insert<String>(set: mut out, value: read key)
                                    }
                                    m = m + 1
                                }
                                e = rclose
                            } else {
                                e = e + 1
                            }
                        } else {
                            e = e + 1
                        }
                    }
                }
                k = p
            } else {
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// Whether the binding of `name` in scope at `from` (nearest preceding `local`/`let` decl,
// scanning back to bodyOpen) is a `local`. Proximity handles shadowing — a later `let name`
// supersedes an earlier `local name` in a since-closed sibling block. No decl found → false.
fn nearest_binding_is_local(toks: read List<Tok>, from: read Int, bodyOpen: read Int, name: read String) -> Bool {
    let mut m = from - 1
    let mut result = false
    let mut found = false
    while m > bodyOpen && found == false {
        if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == name {
            let mut prev = m - 1
            if is_kw_text(toks: read toks, i: read prev, word: read "mut") { prev = m - 2 }
            if is_kw_text(toks: read toks, i: read prev, word: read "local") {
                result = true
                found = true
            } else if is_kw_text(toks: read toks, i: read prev, word: read "let") {
                result = false
                found = true
            }
        }
        m = m - 1
    }
    return result
}

// A builtin collection `insert` retains its `key`/`value` (the collection outlives the call).
// `Cache.insert(cache: mut cache, key: read localKey, …)` on a managed collection retains the
// key. Matched by receiver type + method + label, since no in-file decl carries the effect.
fn builtin_retains_label(toks: read List<Tok>, callPos: read Int, label: read String) -> Bool {
    if tk_text(toks: read toks, i: read (callPos - 1)) != "insert" { return false }
    if at_symbol(toks: read toks, i: read (callPos - 2), code: read SYM_DOT) == false { return false }
    if is_ident_tok(toks: read toks, i: read (callPos - 3)) == false { return false }
    let recv = tk_text(toks: read toks, i: read (callPos - 3))
    let isColl = recv == "Cache" || recv == "Map" || recv == "Set" || recv == "Deque" || recv == "HashMap"
    if isColl == false { return false }
    return label == "key" || label == "value"
}

fn fn_has_retained_local(toks: read List<Tok>, start: read Int, retains: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (k - 1)) {
            let callee = tk_text(toks: read toks, i: read (k - 1))
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close > 0 {
                let mut q = k + 1
                let mut depth = 0
                let mut atStart = true
                while q < close {
                    let opener = at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACE)
                    let closer = at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACE)
                    if opener {
                        depth = depth + 1
                        atStart = false
                    } else if closer {
                        if depth > 0 { depth = depth - 1 }
                        atStart = false
                    } else if depth == 0 && at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) {
                        atStart = true
                    } else if depth == 0 && atStart && is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_COLON) {
                        let label = tk_text(toks: read toks, i: read q)
                        let key = String.concat(left: read String.concat(left: read callee, right: read "|"), right: read label)
                        let retained = Set.contains<String>(set: read retains, value: read key) || builtin_retains_label(toks: read toks, callPos: read k, label: read label)
                        if retained {
                            // Base of the value: strip effect, unwrap Some(…)/Ok(…), to the base ident.
                            let mut v = q + 2
                            if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
                            let mut unwrap = true
                            while unwrap {
                                if is_ident_tok(toks: read toks, i: read v) && (tk_text(toks: read toks, i: read v) == "Some" || tk_text(toks: read toks, i: read v) == "Ok") && at_symbol(toks: read toks, i: read (v + 1), code: read SYM_LPAREN) {
                                    v = v + 2
                                    if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
                                } else {
                                    unwrap = false
                                }
                            }
                            if is_ident_tok(toks: read toks, i: read v) && nearest_binding_is_local(toks: read toks, from: read k, bodyOpen: read sigEnd, name: read tk_text(toks: read toks, i: read v)) { hit = true }
                        }
                        atStart = false
                    } else {
                        atStart = false
                    }
                    q = q + 1
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0303 / RS0305 / RS0309: three place-pair conflict codes emitted by the same routine
// (checks/body/place.rs::check_place_pair_conflict). For each call, every effect-wrapped place
// argument (`read`/`mut`/`take`/`manage <place>`, including places inside a closure argument) is
// collected; each unordered same-base pair dispatches, in order, to:
//   RS0305 — a MOVE (`take`/`manage`) whose path is not provably disjoint from the other access
//            (bare base on either side, an index, a handle crossing, or prefix-or-equal fields).
//   RS0303 — a mut pair (≥1 `mut`, no move) whose paths are prefix-or-equal OR cross a `handle`
//            field, excluding whole-vs-field (that is RS0302) and indexed paths (RS0304).
//   RS0309 — genuinely DISJOINT inline fields of a non-splittable base (a `mut` parameter), ≥1
//            `mut`/`take`, no index/handle/prefix.
// A base that is a `local` binding or a `take` parameter (a provably-exclusive local value) is
// splittable, so disjoint inline fields there are clean.

// Parameter names declared with the `mut` effect (`name: mut Type`).
fn collect_mut_params(toks: read List<Tok>, ns: read Int, sigEnd: read Int, out: mut Set<String>) -> Unit {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: read toks, i: read tt, code: read SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (k + 2), word: read "mut") {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read k))
        }
        k = k + 1
    }
    return Unit
}

// The base ident position of an arg value at `v`: skip leading effect kws and `(`, return the
// first ident, or -1.
fn arg_base_pos(toks: read List<Tok>, v: read Int, argEnd: read Int) -> Int {
    let mut m = v
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m >= argEnd {
            going = false
        } else {
            let t = tk_text(toks: read toks, i: read m)
            if t == "read" || t == "mut" || t == "take" || t == "manage" || at_symbol(toks: read toks, i: read m, code: read SYM_LPAREN) {
                m = m + 1
            } else if is_ident_tok(toks: read toks, i: read m) {
                result = m
                going = false
            } else {
                going = false
            }
        }
    }
    return result
}

// 2 if a `take`/`manage` precedes the base (a move), 1 if a `mut` does, 0 otherwise.
fn arg_move_kind(toks: read List<Tok>, v: read Int, basePos: read Int) -> Int {
    let mut m = v
    let mut kind = 0
    while m < basePos {
        let t = tk_text(toks: read toks, i: read m)
        if t == "take" || t == "manage" {
            kind = 2
        } else if t == "mut" && kind == 0 {
            kind = 1
        }
        m = m + 1
    }
    return kind
}

// End of the place path starting at `basePos` (base + `.field` chain + `[index]`), bounded by end.
fn place_end(toks: read List<Tok>, basePos: read Int, argEnd: read Int) -> Int {
    let mut m = basePos + 1
    let mut going = true
    while going {
        if m >= argEnd {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (m + 1)) {
            m = m + 2
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LBRACKET) {
            let cl = find_matching(toks: read toks, open: read m, openSym: read SYM_LBRACKET, closeSym: read SYM_RBRACKET)
            if cl < 0 { going = false } else { m = cl + 1 }
        } else {
            going = false
        }
    }
    return m
}

fn place_has_index(toks: read List<Tok>, basePos: read Int, end: read Int) -> Bool {
    let mut m = basePos + 1
    let mut found = false
    while m < end {
        if at_symbol(toks: read toks, i: read m, code: read SYM_LBRACKET) { found = true }
        m = m + 1
    }
    return found
}

fn place_crosses_handle(toks: read List<Tok>, basePos: read Int, end: read Int, handleFields: read Set<String>) -> Bool {
    let mut m = basePos + 1
    let mut found = false
    while m < end {
        if at_symbol(toks: read toks, i: read m, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (m + 1)) && Set.contains<String>(set: read handleFields, value: read tk_text(toks: read toks, i: read (m + 1))) { found = true }
        m = m + 1
    }
    return found
}

// The `.field` chain as a dotted string ("" if bare, "f1.f2" otherwise), skipping indices.
fn place_comps(toks: read List<Tok>, basePos: read Int, end: read Int) -> String {
    let mut out = ""
    let mut m = basePos + 1
    while m < end {
        if at_symbol(toks: read toks, i: read m, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (m + 1)) {
            if String.len(value: read out) > 0 { out = String.concat(left: read out, right: read ".") }
            out = String.concat(left: read out, right: read tk_text(toks: read toks, i: read (m + 1)))
            m = m + 2
        } else {
            m = m + 1
        }
    }
    return out
}

fn comps_prefix_or_equal(a: read String, b: read String) -> Bool {
    if a == b { return true }
    if String.starts_with(value: read b, prefix: read String.concat(left: read a, right: read ".")) { return true }
    if String.starts_with(value: read a, prefix: read String.concat(left: read b, right: read ".")) { return true }
    return false
}

// Whether an effect kw (`read`/`mut`/`take`/`manage`) appears in [from, to).
fn has_effect_prefix(toks: read List<Tok>, from: read Int, to: read Int) -> Bool {
    let mut m = from
    let mut found = false
    while m < to {
        let t = tk_text(toks: read toks, i: read m)
        if t == "read" || t == "mut" || t == "take" || t == "manage" { found = true }
        m = m + 1
    }
    return found
}

// Collect effect-places of one argument segment [sStart, sEnd). A closure argument (`|…| …`) is
// scanned in full (its captured accesses join the call's conflict set); a plain argument
// contributes its single leading effect-place.
fn collect_segment_places(toks: read List<Tok>, sStart: read Int, sEnd: read Int, posOut: mut List<Int>, kindOut: mut List<Int>) -> Unit {
    let mut vStart = sStart
    if is_ident_tok(toks: read toks, i: read sStart) && at_symbol(toks: read toks, i: read (sStart + 1), code: read SYM_COLON) { vStart = sStart + 2 }
    if at_symbol(toks: read toks, i: read vStart, code: read SYM_PIPE) {
        // Only variables CAPTURED from outside the closure join the enclosing call's conflict
        // set; the closure's own params and `local`/`let` bindings are internal, not captures.
        let mut declInside = Set.new<String>()
        let mut pp = vStart + 1
        let mut inParams = true
        while pp < sEnd && inParams {
            if at_symbol(toks: read toks, i: read pp, code: read SYM_PIPE) {
                inParams = false
            } else {
                if is_ident_tok(toks: read toks, i: read pp) { Set.insert<String>(set: mut declInside, value: read tk_text(toks: read toks, i: read pp)) }
                pp = pp + 1
            }
        }
        collect_local_names(toks: read toks, bodyOpen: read pp, bodyClose: read sEnd, out: mut declInside)
        let mut dl = pp + 1
        while dl < sEnd {
            if is_kw_text(toks: read toks, i: read dl, word: read "let") {
                let mut nm = dl + 1
                if is_kw_text(toks: read toks, i: read nm, word: read "mut") { nm = nm + 1 }
                if is_ident_tok(toks: read toks, i: read nm) { Set.insert<String>(set: mut declInside, value: read tk_text(toks: read toks, i: read nm)) }
            }
            dl = dl + 1
        }
        let mut m = vStart
        while m < sEnd {
            let t = tk_text(toks: read toks, i: read m)
            if t == "read" || t == "mut" || t == "take" || t == "manage" {
                let bp = arg_base_pos(toks: read toks, v: read m, argEnd: read sEnd)
                if bp >= 0 && is_upper_head(name: read tk_text(toks: read toks, i: read bp)) == false && Set.contains<String>(set: read declInside, value: read tk_text(toks: read toks, i: read bp)) == false {
                    List.push<Int>(list: mut posOut, value: read bp)
                    List.push<Int>(list: mut kindOut, value: read arg_move_kind(toks: read toks, v: read m, basePos: read bp))
                }
            }
            m = m + 1
        }
    } else {
        let bp = arg_base_pos(toks: read toks, v: read vStart, argEnd: read sEnd)
        if bp >= 0 && is_upper_head(name: read tk_text(toks: read toks, i: read bp)) == false && has_effect_prefix(toks: read toks, from: read vStart, to: read bp) {
            List.push<Int>(list: mut posOut, value: read bp)
            List.push<Int>(list: mut kindOut, value: read arg_move_kind(toks: read toks, v: read vStart, basePos: read bp))
        }
    }
    return Unit
}

// Collect the effect-place args of the call `(op..close)` — split into arg segments at depth-0
// commas, each processed by collect_segment_places.
fn collect_call_places(toks: read List<Tok>, op: read Int, close: read Int, posOut: mut List<Int>, kindOut: mut List<Int>) -> Unit {
    let mut q = op + 1
    let mut depth = 0
    let mut segStart = op + 1
    while q < close {
        if at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) {
            collect_segment_places(toks: read toks, sStart: read segStart, sEnd: read q, posOut: mut posOut, kindOut: mut kindOut)
            segStart = q + 1
        }
        q = q + 1
    }
    collect_segment_places(toks: read toks, sStart: read segStart, sEnd: read close, posOut: mut posOut, kindOut: mut kindOut)
    return Unit
}

// Whether `bitval` (a power of two) is set in `mask` (no bitwise ops in the dialect).
fn bit_set(mask: read Int, bitval: read Int) -> Bool {
    let q = mask / bitval
    return q - (q / 2) * 2 == 1
}

// Bitmask over one function's calls: bit0 RS0303, bit1 RS0305, bit2 RS0309, bit3 RS0302, bit4 RS0304.
fn fn_place_conflicts(toks: read List<Tok>, start: read Int, handleFields: read Set<String>, mutParams: read Set<String>) -> Int {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return 0 }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return 0 }
    let mut has0303 = false
    let mut has0305 = false
    let mut has0309 = false
    let mut has0302 = false
    let mut has0304 = false
    let mut k = sigEnd + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (k - 1)) {
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close > 0 {
                let mut posList = List.new<Int>()
                let mut kindList = List.new<Int>()
                collect_call_places(toks: read toks, op: read k, close: read close, posOut: mut posList, kindOut: mut kindList)
                let np = List.len(list: read posList)
                let mut a = 0
                while a < np {
                    let mut b = a + 1
                    while b < np {
                        let pa = List.get<Int>(list: read posList, index: read a)
                        let pb = List.get<Int>(list: read posList, index: read b)
                        if tk_text(toks: read toks, i: read pa) == tk_text(toks: read toks, i: read pb) {
                            let ka = List.get<Int>(list: read kindList, index: read a)
                            let kb = List.get<Int>(list: read kindList, index: read b)
                            let ea = place_end(toks: read toks, basePos: read pa, argEnd: read close)
                            let eb = place_end(toks: read toks, basePos: read pb, argEnd: read close)
                            let compsA = place_comps(toks: read toks, basePos: read pa, end: read ea)
                            let compsB = place_comps(toks: read toks, basePos: read pb, end: read eb)
                            let bareA = String.len(value: read compsA) == 0
                            let bareB = String.len(value: read compsB) == 0
                            let idx = place_has_index(toks: read toks, basePos: read pa, end: read ea) || place_has_index(toks: read toks, basePos: read pb, end: read eb)
                            let hdl = place_crosses_handle(toks: read toks, basePos: read pa, end: read ea, handleFields: read handleFields) || place_crosses_handle(toks: read toks, basePos: read pb, end: read eb, handleFields: read handleFields)
                            let prefixEq = comps_prefix_or_equal(a: read compsA, b: read compsB)
                            let anyMove = ka == 2 || kb == 2
                            let anyMut = ka == 1 || kb == 1
                            let mutates = anyMove || anyMut
                            let mut handled = false
                            if mutates {
                                if anyMove {
                                    if bareA || bareB || idx || hdl || prefixEq {
                                        has0305 = true
                                        handled = true
                                    }
                                }
                                if handled == false && idx {
                                    has0304 = true
                                    handled = true
                                }
                                let oneBare = (bareA && bareB == false) || (bareB && bareA == false)
                                if handled == false && oneBare {
                                    has0302 = true
                                    handled = true
                                }
                                if handled == false && hdl {
                                    has0303 = true
                                    handled = true
                                }
                                if handled == false && prefixEq {
                                    has0303 = true
                                    handled = true
                                }
                                if handled == false && Set.contains<String>(set: read mutParams, value: read tk_text(toks: read toks, i: read pa)) {
                                    has0309 = true
                                }
                            }
                        }
                        b = b + 1
                    }
                    a = a + 1
                }
            }
        }
        k = k + 1
    }
    let mut result = 0
    if has0303 { result = result + 1 }
    if has0305 { result = result + 2 }
    if has0309 { result = result + 4 }
    if has0302 { result = result + 8 }
    if has0304 { result = result + 16 }
    return result
}

// `local` binding names of the body [bodyOpen,bodyClose).
fn collect_local_names(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "local") {
            let mut q = k + 1
            if is_kw_text(toks: read toks, i: read q, word: read "mut") { q = q + 1 }
            if is_ident_tok(toks: read toks, i: read q) {
                Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read q))
            }
        }
        k = k + 1
    }
    return Unit
}

// RS0601 FRESH_RETURN_NOT_CLEAN: a `-> fresh …` function that `return`s a value which is not a
// clean, freshly-owned value. Not clean: a `mut`/`take` param, a non-scalar `read` param, a
// `let` bound to a non-fresh call, a `local`/`let` that has been tainted (retained / captured in
// a closure / `manage`d / moved), a match-arm binding of a managed scrutinee, or a handle-field
// access. Clean: a fresh call, a constructor, a literal, an untainted fresh-sourced local/let.

// Whether this fn's return type contains `fresh` anywhere (covers `-> fresh T`,
// `-> Option<fresh T>`, `-> Result<fresh T, E>`) — broader than the direct-only `fn_returns_fresh`.
fn fn_return_type_has_fresh(toks: read List<Tok>, ns: read Int, sigEnd: read Int) -> Bool {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: read toks, i: read tt, code: read SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return false }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let mut m = pclose + 1
    let mut found = false
    while m < sigEnd {
        if is_kw_text(toks: read toks, i: read m, word: read "fresh") { found = true }
        m = m + 1
    }
    return found
}

fn collect_fire_params(toks: read List<Tok>, ns: read Int, sigEnd: read Int, out: mut Set<String>) -> Unit {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: read toks, i: read tt, code: read SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let pname = tk_text(toks: read toks, i: read k)
            let eff = tk_text(toks: read toks, i: read (k + 2))
            if eff == "mut" || eff == "take" {
                Set.insert<String>(set: mut out, value: read pname)
            } else if eff == "read" && is_scalar_name(name: read tk_text(toks: read toks, i: read (k + 3))) == false {
                Set.insert<String>(set: mut out, value: read pname)
            }
        }
        k = k + 1
    }
    return Unit
}

// `let` names bound to a call of a file-DECLARED non-fresh function — a managed, non-fresh value
// (returning it from a `-> fresh` fn is not clean). A builtin call (`List.new()`), a constructor,
// or a fresh-fn call is NOT managed-non-fresh. Only `let` (a `local` is owned).
fn collect_managed_nonfresh_lets(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, freshFns: read Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut nameIdx = k + 1
            if is_kw_text(toks: read toks, i: read nameIdx, word: read "mut") { nameIdx = nameIdx + 1 }
            if is_ident_tok(toks: read toks, i: read nameIdx) {
                let mut eqPos = 0 - 1
                let mut t = nameIdx + 1
                let mut scan = true
                while scan {
                    if t >= bodyClose {
                        scan = false
                    } else if at_symbol(toks: read toks, i: read t, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read t, code: read SYM_RBRACE) {
                        scan = false
                    } else if at_symbol(toks: read toks, i: read t, code: read SYM_EQ) && at_symbol(toks: read toks, i: read (t + 1), code: read SYM_EQ) == false {
                        eqPos = t
                        scan = false
                    } else {
                        t = t + 1
                    }
                }
                if eqPos > 0 {
                    let mut s = eqPos + 1
                    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
                    // A `let` bound to a CALL is managed-non-fresh unless the call is a fresh
                    // source: a bare constructor `Foo(...)`, a registered `-> fresh` fn, or a
                    // stdlib-type receiver (`List.new()`, whose builtin result is fresh). Any other
                    // call — including an unknown/user `Cache.get()` — yields a managed value.
                    let isCtor = is_ident_tok(toks: read toks, i: read s) && is_upper_head(name: read tk_text(toks: read toks, i: read s)) && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN)
                    if is_ident_tok(toks: read toks, i: read s) && isCtor == false {
                        let de = dotted_end(toks: read toks, i: read s)
                        if at_symbol(toks: read toks, i: read de, code: read SYM_LPAREN) {
                            let dn = dotted_name_text(toks: read toks, i: read s)
                            let recvStdlib = at_symbol(toks: read toks, i: read (s + 1), code: read SYM_DOT) && is_stdlib_type(name: read tk_text(toks: read toks, i: read s))
                            if Set.contains<String>(set: read freshFns, value: read dn) == false && recvStdlib == false {
                                Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read nameIdx))
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return Unit
}

fn collect_tainted_bindings(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, retains: read Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if (is_kw_text(toks: read toks, i: read k, word: read "manage") || is_kw_text(toks: read toks, i: read k, word: read "take")) && is_ident_tok(toks: read toks, i: read (k + 1)) {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read (k + 1)))
        }
        k = k + 1
    }
    k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) && k > bodyOpen && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_PIPE) {
            // Only a STORED closure (`= |…| { }`) retains its captures; a `noescape` callback
            // argument does not. Find the closure's opening `|` and require `=` before it.
            let mut op = k - 2
            let mut findPipe = true
            while findPipe {
                if op <= bodyOpen {
                    findPipe = false
                } else if at_symbol(toks: read toks, i: read op, code: read SYM_PIPE) {
                    findPipe = false
                } else {
                    op = op - 1
                }
            }
            let stored = op > bodyOpen && at_symbol(toks: read toks, i: read (op - 1), code: read SYM_EQ)
            let cbClose = find_matching(toks: read toks, open: read k, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if cbClose > 0 {
                if stored {
                    let mut m = k + 1
                    while m < cbClose {
                        if is_ident_tok(toks: read toks, i: read m) {
                            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read m))
                        }
                        m = m + 1
                    }
                }
                k = cbClose
            }
        }
        k = k + 1
    }
    k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (k - 1)) {
            let callee = tk_text(toks: read toks, i: read (k - 1))
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close > 0 {
                let mut q = k + 1
                let mut depth = 0
                let mut atStart = true
                while q < close {
                    let opener = at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACE)
                    let closer = at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACE)
                    if opener {
                        depth = depth + 1
                        atStart = false
                    } else if closer {
                        if depth > 0 { depth = depth - 1 }
                        atStart = false
                    } else if depth == 0 && at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) {
                        atStart = true
                    } else if depth == 0 && atStart && is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_COLON) {
                        let label = tk_text(toks: read toks, i: read q)
                        let key = String.concat(left: read String.concat(left: read callee, right: read "|"), right: read label)
                        let isR = Set.contains<String>(set: read retains, value: read key) || builtin_retains_label(toks: read toks, callPos: read k, label: read label)
                        if isR {
                            let mut v = q + 2
                            if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
                            if is_ident_tok(toks: read toks, i: read v) {
                                Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read v))
                            }
                        }
                        atStart = false
                    } else {
                        atStart = false
                    }
                    q = q + 1
                }
            }
        }
        k = k + 1
    }
    return Unit
}

fn collect_managed_match_binds(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, managed: read Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "match") && is_ident_tok(toks: read toks, i: read (k + 1)) && Set.contains<String>(set: read managed, value: read tk_text(toks: read toks, i: read (k + 1))) {
            let mut b = k + 2
            let mut go = true
            while go {
                if b >= bodyClose {
                    go = false
                } else if at_symbol(toks: read toks, i: read b, code: read SYM_LBRACE) {
                    go = false
                } else {
                    b = b + 1
                }
            }
            if b < bodyClose && at_symbol(toks: read toks, i: read b, code: read SYM_LBRACE) {
                let mClose = find_matching(toks: read toks, open: read b, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if mClose > 0 {
                    collect_match_bindings(toks: read toks, bodyOpen: read b, bodyClose: read mClose, out: mut out)
                    k = mClose
                }
            }
        }
        k = k + 1
    }
    return Unit
}

// Registry of `noescape Fn()` params as `shortFn|param` composite keys.
fn collect_noescape_params(toks: read List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "fn") {
            let mut p = k + 1
            let mut scan = true
            while scan {
                if p >= n {
                    scan = false
                } else if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) || is_kw_text(toks: read toks, i: read p, word: read "fn") || at_symbol(toks: read toks, i: read p, code: read SYM_LBRACE) {
                    scan = false
                } else {
                    p = p + 1
                }
            }
            if p < n && at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (p - 1)) {
                let shortName = tk_text(toks: read toks, i: read (p - 1))
                let pclose = find_matching(toks: read toks, open: read p, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if pclose > 0 {
                    let mut depth = 0
                    let mut q = p + 1
                    while q < pclose {
                        if at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) {
                            depth = depth + 1
                        } else if at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) {
                            depth = depth - 1
                        } else if depth == 0 && is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (q + 2), word: read "noescape") {
                            let key = String.concat(left: read String.concat(left: read shortName, right: read "|"), right: read tk_text(toks: read toks, i: read q))
                            Set.insert<String>(set: mut out, value: read key)
                        }
                        q = q + 1
                    }
                }
                k = p
            } else {
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// The opening `|` of a closure whose body `{` is at `cb` (cb-1 is the closing `|`).
fn find_closure_open_pipe(toks: read List<Tok>, cb: read Int, floor: read Int) -> Int {
    let mut m = cb - 2
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m <= floor {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_PIPE) {
            result = m
            going = false
        } else {
            m = m - 1
        }
    }
    return result
}

// The `(` opening the nearest call whose argument list encloses `p`, or -1.
fn enclosing_paren_open(toks: read List<Tok>, p: read Int, floor: read Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m <= floor {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RPAREN) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LPAREN) {
            if depth == 0 {
                result = m
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// The `(` of the call whose argument directly holds the closure at `p`, seeing through variant
// wrappers `Some(`/`Ok(`/`Err(` (whose callee is an uppercase constructor, not the real callee).
fn closure_outer_call_open(toks: read List<Tok>, p: read Int, floor: read Int) -> Int {
    let mut cur = p
    let mut result = 0 - 1
    let mut going = true
    while going {
        let pOpen = enclosing_paren_open(toks: read toks, p: read cur, floor: read floor)
        if pOpen <= 0 {
            going = false
        } else if is_ident_tok(toks: read toks, i: read (pOpen - 1)) {
            let nm = tk_text(toks: read toks, i: read (pOpen - 1))
            if nm == "Some" || nm == "Ok" || nm == "Err" {
                cur = pOpen
            } else {
                result = pOpen
                going = false
            }
        } else {
            going = false
        }
    }
    return result
}

// The label of the top-level argument of call `callOpen` that contains `target`, or "".
fn arg_label_at(toks: read List<Tok>, callOpen: read Int, target: read Int) -> String {
    let callClose = find_matching(toks: read toks, open: read callOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if callClose < 0 { return "" }
    let mut depth = 0
    let mut segStart = callOpen + 1
    let mut q = callOpen + 1
    let mut result = ""
    while q < callClose {
        if at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) {
            if segStart <= target && target < q {
                if is_ident_tok(toks: read toks, i: read segStart) && at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) {
                    result = tk_text(toks: read toks, i: read segStart)
                }
                q = callClose
            }
            segStart = q + 1
        }
        q = q + 1
    }
    if result == "" && segStart <= target && target < callClose {
        if is_ident_tok(toks: read toks, i: read segStart) && at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) {
            result = tk_text(toks: read toks, i: read segStart)
        }
    }
    return result
}

// bit0 = RS0801 (managed/retained closure captures a local), bit1 = RS0804 (noescape closure
// consumes — take/manage — a captured local).
fn fn_has_closure_capture_bad(toks: read List<Tok>, start: read Int, retains: read Set<String>, noescape: read Set<String>) -> Int {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return 0 }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return 0 }
    let mut localNames = Set.new<String>()
    collect_local_names(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, out: mut localNames)
    let mut has0801 = false
    let mut has0804 = false
    let mut k = sigEnd + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) && k > sigEnd && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_PIPE) {
            let cbClose = find_matching(toks: read toks, open: read k, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            let op = find_closure_open_pipe(toks: read toks, cb: read k, floor: read sigEnd)
            if cbClose > 0 && op > 0 {
                let mut declInside = Set.new<String>()
                let mut pp = op + 1
                while pp < (k - 1) {
                    if is_ident_tok(toks: read toks, i: read pp) { Set.insert<String>(set: mut declInside, value: read tk_text(toks: read toks, i: read pp)) }
                    pp = pp + 1
                }
                collect_local_names(toks: read toks, bodyOpen: read k, bodyClose: read cbClose, out: mut declInside)
                let mut dl = k + 1
                while dl < cbClose {
                    if is_kw_text(toks: read toks, i: read dl, word: read "let") {
                        let mut nm = dl + 1
                        if is_kw_text(toks: read toks, i: read nm, word: read "mut") { nm = nm + 1 }
                        if is_ident_tok(toks: read toks, i: read nm) { Set.insert<String>(set: mut declInside, value: read tk_text(toks: read toks, i: read nm)) }
                    }
                    dl = dl + 1
                }
                let mut captured = Set.new<String>()
                let mut anyCapture = false
                let mut m = k + 1
                while m < cbClose {
                    // Capturing a local's handle-field (`holder.image`) yields a managed value,
                    // not the local itself — only a bare local reference is a capture.
                    if is_ident_tok(toks: read toks, i: read m) && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_DOT) == false {
                        let nmv = tk_text(toks: read toks, i: read m)
                        if Set.contains<String>(set: read localNames, value: read nmv) && Set.contains<String>(set: read declInside, value: read nmv) == false {
                            Set.insert<String>(set: mut captured, value: read nmv)
                            anyCapture = true
                        }
                    }
                    m = m + 1
                }
                let mut bpos = op - 1
                if is_effect_kw(toks: read toks, i: read bpos) { bpos = bpos - 1 }
                if at_symbol(toks: read toks, i: read bpos, code: read SYM_EQ) {
                    // stored: `let NAME = |…| {…}` — RS0801 only for a `let` (managed) closure
                    let mut kw = bpos - 2
                    if is_kw_text(toks: read toks, i: read kw, word: read "mut") { kw = kw - 1 }
                    if is_kw_text(toks: read toks, i: read kw, word: read "let") && anyCapture { has0801 = true }
                } else {
                    // call argument (possibly wrapped in `Some(…)`/`Ok(…)`)
                    let callOpen = closure_outer_call_open(toks: read toks, p: read op, floor: read sigEnd)
                    if callOpen > 0 && is_ident_tok(toks: read toks, i: read (callOpen - 1)) {
                        let callee = tk_text(toks: read toks, i: read (callOpen - 1))
                        let label = arg_label_at(toks: read toks, callOpen: read callOpen, target: read op)
                        if label != "" {
                            let key = String.concat(left: read String.concat(left: read callee, right: read "|"), right: read label)
                            if Set.contains<String>(set: read retains, value: read key) && anyCapture { has0801 = true }
                            if Set.contains<String>(set: read noescape, value: read key) {
                                let mut c = k + 1
                                while c < cbClose {
                                    if (is_kw_text(toks: read toks, i: read c, word: read "manage") || is_kw_text(toks: read toks, i: read c, word: read "take")) && is_ident_tok(toks: read toks, i: read (c + 1)) && Set.contains<String>(set: read captured, value: read tk_text(toks: read toks, i: read (c + 1))) { has0804 = true }
                                    c = c + 1
                                }
                            }
                        }
                    }
                }
                k = cbClose
            }
        }
        k = k + 1
    }
    let mut result = 0
    if has0801 { result = result + 1 }
    if has0804 { result = result + 2 }
    return result
}

// RS0711: a ResourcePool<..>.lazy(…)/.try_lazy(…) factory closure captures a non-owned binding
// (a parameter or managed `let`) instead of only owned `local` bindings.
fn fn_has_lazy_capture_bad(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    // parameter names (scan the first `(` directly — find_top_sym can't match an opening paren)
    let mut nonOwned = Set.new<String>()
    let mut popen = 0 - 1
    let mut pf = ns
    while pf < sigEnd {
        if at_symbol(toks: read toks, i: read pf, code: read SYM_LPAREN) {
            popen = pf
            pf = sigEnd
        } else {
            pf = pf + 1
        }
    }
    if popen > 0 {
        let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if pclose > 0 {
            let mut depth = 0
            let mut q = popen + 1
            while q < pclose {
                if at_symbol(toks: read toks, i: read q, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_LBRACKET) {
                    depth = depth + 1
                } else if at_symbol(toks: read toks, i: read q, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read q, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_RBRACKET) {
                    if depth > 0 { depth = depth - 1 }
                } else if depth == 0 && is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_COLON) {
                    Set.insert<String>(set: mut nonOwned, value: read tk_text(toks: read toks, i: read q))
                }
                q = q + 1
            }
        }
    }
    let mut letImmut = Set.new<String>()
    let mut letMut = Set.new<String>()
    collect_let_kinds(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, immut: mut letImmut, mutable: mut letMut)
    let mut k = sigEnd + 1
    while k < bodyClose {
        if tk_text(toks: read toks, i: read k) == "ResourcePool" {
            let mut mpos = k + 1
            if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LANGLE) {
                let rangle = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
                if rangle >= 0 { mpos = rangle + 1 }
            }
            if at_symbol(toks: read toks, i: read mpos, code: read SYM_DOT) {
                let method = tk_text(toks: read toks, i: read (mpos + 1))
                if (method == "lazy" || method == "try_lazy") && at_symbol(toks: read toks, i: read (mpos + 2), code: read SYM_LPAREN) {
                    let callOpen = mpos + 2
                    let callClose = find_matching(toks: read toks, open: read callOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                    if callClose > 0 {
                        let mut op1 = 0 - 1
                        let mut s = callOpen + 1
                        while s < callClose {
                            if at_symbol(toks: read toks, i: read s, code: read SYM_PIPE) {
                                op1 = s
                                s = callClose
                            } else {
                                s = s + 1
                            }
                        }
                        if op1 > 0 {
                            let mut closep = 0 - 1
                            let mut t = op1 + 1
                            while t < callClose {
                                if at_symbol(toks: read toks, i: read t, code: read SYM_PIPE) {
                                    closep = t
                                    t = callClose
                                } else {
                                    t = t + 1
                                }
                            }
                            if closep > 0 {
                                let mut cparams = Set.new<String>()
                                let mut cp = op1 + 1
                                while cp < closep {
                                    if is_ident_tok(toks: read toks, i: read cp) { Set.insert<String>(set: mut cparams, value: read tk_text(toks: read toks, i: read cp)) }
                                    cp = cp + 1
                                }
                                let mut bodyStart = closep + 1
                                let mut bodyEnd = callClose
                                if at_symbol(toks: read toks, i: read (closep + 1), code: read SYM_LBRACE) {
                                    let bclose = find_matching(toks: read toks, open: read (closep + 1), openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                                    if bclose > 0 {
                                        bodyStart = closep + 2
                                        bodyEnd = bclose
                                    }
                                } else {
                                    let mut d2 = 0
                                    let mut e = closep + 1
                                    let mut findEnd = true
                                    while findEnd {
                                        if e >= callClose {
                                            bodyEnd = callClose
                                            findEnd = false
                                        } else if at_symbol(toks: read toks, i: read e, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read e, code: read SYM_LBRACKET) {
                                            d2 = d2 + 1
                                            e = e + 1
                                        } else if at_symbol(toks: read toks, i: read e, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read e, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read e, code: read SYM_RBRACKET) {
                                            if d2 > 0 {
                                                d2 = d2 - 1
                                                e = e + 1
                                            } else {
                                                bodyEnd = e
                                                findEnd = false
                                            }
                                        } else if d2 == 0 && at_symbol(toks: read toks, i: read e, code: read SYM_COMMA) {
                                            bodyEnd = e
                                            findEnd = false
                                        } else {
                                            e = e + 1
                                        }
                                    }
                                }
                                let mut m = bodyStart
                                while m < bodyEnd {
                                    // a real capture is a value, not an argument label (`host:`) or a
                                    // field/method access base (`x.f`)
                                    if is_ident_tok(toks: read toks, i: read m) && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false {
                                        let nm = tk_text(toks: read toks, i: read m)
                                        if (Set.contains<String>(set: read nonOwned, value: read nm) || Set.contains<String>(set: read letImmut, value: read nm) || Set.contains<String>(set: read letMut, value: read nm)) && Set.contains<String>(set: read cparams, value: read nm) == false {
                                            return true
                                        }
                                    }
                                    m = m + 1
                                }
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return false
}

// The container head immediately enclosing the type-arg at `pos` (ident before the opening `<` of
// the innermost generic clause containing `pos`), or "".
fn enclosing_generic_head(toks: read List<Tok>, pos: read Int) -> String {
    let mut m = pos - 1
    let mut depth = 0
    let mut result = ""
    let mut going = true
    while going {
        if m <= 0 {
            going = false
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_RANGLE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: read toks, i: read m, code: read SYM_LANGLE) {
            if depth == 0 {
                if is_ident_tok(toks: read toks, i: read (m - 1)) { result = tk_text(toks: read toks, i: read (m - 1)) }
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// A resource-decl generic-param segment: returns true if UNBOUNDED (B1); records a Resource-bounded
// param name into `resParams`.
fn seg_generic_kind(toks: read List<Tok>, segStart: read Int, resParams: mut Set<String>) -> Bool {
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    let nm = tk_text(toks: read toks, i: read segStart)
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false {
        return true
    }
    if tk_text(toks: read toks, i: read (segStart + 2)) == "Resource" {
        Set.insert<String>(set: mut resParams, value: read nm)
    }
    return false
}

// RS0704 sub-rule A: a file-declared resource used as a generic type-argument of a non-pool
// container. Exempt under ResourcePool<…>, and Result<Resource, E> at arg-0 in a return type.
fn has_resource_generic_arg(toks: read List<Tok>, resources: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_ident_tok(toks: read toks, i: read k) && Set.contains<String>(set: read resources, value: read tk_text(toks: read toks, i: read k)) && k >= 1 && (at_symbol(toks: read toks, i: read (k - 1), code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read (k - 1), code: read SYM_COMMA)) {
            let head = enclosing_generic_head(toks: read toks, pos: read k)
            let mut skip = false
            if head == "ResourcePool" {
                skip = true
            } else if head == "Result" && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_LANGLE) {
                let mut bp = k - 3
                if is_kw_text(toks: read toks, i: read bp, word: read "fresh") { bp = bp - 1 }
                if at_symbol(toks: read toks, i: read bp, code: read SYM_ARROW) { skip = true }
            }
            if skip == false { return true }
        }
        k = k + 1
    }
    return false
}

// RS0704 sub-rules B1/B2: a `resource Name<params>` with an unbounded param (B1), or a
// Resource-bounded param used directly (not under ResourcePool) in a field type (B2).
fn has_resource_decl_generic_bad(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "resource") && is_ident_tok(toks: read toks, i: read (k + 1)) && at_symbol(toks: read toks, i: read (k + 2), code: read SYM_LANGLE) {
            let gOpen = k + 2
            let gClose = find_matching(toks: read toks, open: read gOpen, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
            if gClose > 0 {
                let mut resParams = Set.new<String>()
                let mut depth = 0
                let mut segStart = gOpen + 1
                let mut j = gOpen + 1
                let mut b1 = false
                while j < gClose {
                    if at_symbol(toks: read toks, i: read j, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
                        depth = depth + 1
                    } else if at_symbol(toks: read toks, i: read j, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) {
                        if depth > 0 { depth = depth - 1 }
                    } else if depth == 0 && at_symbol(toks: read toks, i: read j, code: read SYM_COMMA) {
                        if seg_generic_kind(toks: read toks, segStart: read segStart, resParams: mut resParams) { b1 = true }
                        segStart = j + 1
                    }
                    j = j + 1
                }
                if seg_generic_kind(toks: read toks, segStart: read segStart, resParams: mut resParams) { b1 = true }
                if b1 { return true }
                let mut bOpen = gClose + 1
                let mut findBody = true
                while findBody {
                    if bOpen >= n {
                        findBody = false
                    } else if at_symbol(toks: read toks, i: read bOpen, code: read SYM_LBRACE) {
                        findBody = false
                    } else {
                        bOpen = bOpen + 1
                    }
                }
                if bOpen < n {
                    let bClose = find_matching(toks: read toks, open: read bOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if bClose > 0 {
                        let mut f = bOpen + 1
                        while f < bClose {
                            if is_ident_tok(toks: read toks, i: read f) && Set.contains<String>(set: read resParams, value: read tk_text(toks: read toks, i: read f)) && f >= 1 && (at_symbol(toks: read toks, i: read (f - 1), code: read SYM_COLON) || at_symbol(toks: read toks, i: read (f - 1), code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read (f - 1), code: read SYM_COMMA)) {
                                if enclosing_generic_head(toks: read toks, pos: read f) != "ResourcePool" {
                                    return true
                                }
                            }
                            f = f + 1
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return false
}

// RS0704 whole-file predicate.
fn has_resource_generic_bad(toks: read List<Tok>, resources: read Set<String>) -> Bool {
    if has_resource_generic_arg(toks: read toks, resources: read resources) { return true }
    if has_resource_decl_generic_bad(toks: read toks) { return true }
    return false
}

// A declaration keyword sits at index i (start of a decl whose name+generics follow).
fn decl_kw_before(toks: read List<Tok>, i: read Int) -> Bool {
    return is_kw_text(toks: read toks, i: read i, word: read "fn") || is_kw_text(toks: read toks, i: read i, word: read "struct") || is_kw_text(toks: read toks, i: read i, word: read "class") || is_kw_text(toks: read toks, i: read i, word: read "resource") || is_kw_text(toks: read toks, i: read i, word: read "sum") || is_kw_text(toks: read toks, i: read i, word: read "protocol") || is_kw_text(toks: read toks, i: read i, word: read "impl")
}

// A generic-clause segment starting at `segStart` declares `name` with a non-Resource bound.
fn seg_is_nonresource_param(toks: read List<Tok>, segStart: read Int, name: read String) -> Bool {
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if tk_text(toks: read toks, i: read segStart) != name { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) && tk_text(toks: read toks, i: read (segStart + 2)) == "Resource" {
        return false
    }
    return true
}

// True if `name` is declared as a generic parameter (in some `fn/struct/class/resource/sum/
// protocol/impl` header `Name<…>`) whose bound is NOT exactly `Resource`.
fn nonresource_generic_param(toks: read List<Tok>, name: read String) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    let mut found = false
    while k < n {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) && k >= 2 && is_ident_tok(toks: read toks, i: read (k - 1)) && decl_kw_before(toks: read toks, i: read (k - 2)) {
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
            if close > 0 {
                let mut depth = 0
                let mut segStart = k + 1
                let mut j = k + 1
                while j < close {
                    if at_symbol(toks: read toks, i: read j, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
                        depth = depth + 1
                    } else if at_symbol(toks: read toks, i: read j, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) {
                        if depth > 0 { depth = depth - 1 }
                    } else if depth == 0 && at_symbol(toks: read toks, i: read j, code: read SYM_COMMA) {
                        if seg_is_nonresource_param(toks: read toks, segStart: read segStart, name: read name) { found = true }
                        segStart = j + 1
                    }
                    j = j + 1
                }
                if seg_is_nonresource_param(toks: read toks, segStart: read segStart, name: read name) { found = true }
            }
        }
        k = k + 1
    }
    return found
}

// RS0703: any `ResourcePool<X>` whose argument X is a declared/stdlib non-resource type or a
// non-Resource-bounded generic parameter. Unknown/undeclared X → OK.
fn has_resource_pool_type_bad(toks: read List<Tok>, resources: read Set<String>, declared: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if tk_text(toks: read toks, i: read k) == "ResourcePool" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LANGLE) && is_ident_tok(toks: read toks, i: read (k + 2)) {
            let x = tk_text(toks: read toks, i: read (k + 2))
            let mut fire = false
            if x == "Resource" {
                fire = false
            } else if Set.contains<String>(set: read resources, value: read x) {
                fire = false
            } else if Set.contains<String>(set: read declared, value: read x) {
                fire = true
            } else if nonresource_generic_param(toks: read toks, name: read x) {
                fire = true
            }
            if fire { return true }
        }
        k = k + 1
    }
    return false
}

// The aggregate access effect of `name` across an explicit closure body: "take" > "mut" > "read",
// or "" if `name` never appears as an external use.
fn capture_body_effect(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String, params: read Set<String>, inner: read Set<String>) -> String {
    let mut eff = ""
    let mut m = bodyOpen + 1
    while m < bodyClose {
        if tk_kind(toks: read toks, i: read m) == TOK_IDENT && tk_text(toks: read toks, i: read m) == name && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_LPAREN) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false && Set.contains<String>(set: read params, value: read name) == false && Set.contains<String>(set: read inner, value: read name) == false {
            let mut occ = "read"
            if is_kw_text(toks: read toks, i: read (m - 1), word: read "take") || is_kw_text(toks: read toks, i: read (m - 1), word: read "manage") {
                occ = "take"
            } else if at_symbol(toks: read toks, i: read (m + 1), code: read SYM_EQ) && at_symbol(toks: read toks, i: read (m + 2), code: read SYM_EQ) == false {
                occ = "mut"
            }
            if occ == "take" {
                eff = "take"
            } else if occ == "mut" && eff != "take" {
                eff = "mut"
            } else if eff == "" {
                eff = "read"
            }
        }
        m = m + 1
    }
    return eff
}

// True if the explicit closure at `cp` (the `captures` keyword) violates its capture contract:
// a used-but-undeclared external (Missing), a declared-but-unused capture (Unused), or a declared
// effect that differs from the body's use (Mismatch).
fn capture_contract_bad(toks: read List<Tok>, cp: read Int) -> Bool {
    let pClose = cp - 1
    if at_symbol(toks: read toks, i: read pClose, code: read SYM_RPAREN) == false { return false }
    let mut pOpen = 0 - 1
    let mut depth = 0
    let mut s = pClose - 1
    let mut findOpen = true
    while findOpen {
        if s <= 0 {
            findOpen = false
        } else if at_symbol(toks: read toks, i: read s, code: read SYM_RPAREN) {
            depth = depth + 1
            s = s - 1
        } else if at_symbol(toks: read toks, i: read s, code: read SYM_LPAREN) {
            if depth == 0 {
                pOpen = s
                findOpen = false
            } else {
                depth = depth - 1
                s = s - 1
            }
        } else {
            s = s - 1
        }
    }
    if pOpen <= 0 || is_kw_text(toks: read toks, i: read (pOpen - 1), word: read "fn") == false { return false }
    if at_symbol(toks: read toks, i: read (cp + 1), code: read SYM_LPAREN) == false { return false }
    let capClose = find_matching(toks: read toks, open: read (cp + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if capClose < 0 { return false }
    let mut bOpen = 0 - 1
    let mut b = capClose + 1
    let mut findBody = true
    while findBody {
        if b >= List.len(list: read toks) {
            findBody = false
        } else if at_symbol(toks: read toks, i: read b, code: read SYM_LBRACE) {
            bOpen = b
            findBody = false
        } else {
            b = b + 1
        }
    }
    if bOpen <= 0 { return false }
    let bClose = find_matching(toks: read toks, open: read bOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bClose < 0 { return false }
    // param names: ident right after `(` or a comma
    let mut params = Set.new<String>()
    let mut pp = pOpen + 1
    while pp < pClose {
        if is_ident_tok(toks: read toks, i: read pp) && (pp == (pOpen + 1) || at_symbol(toks: read toks, i: read (pp - 1), code: read SYM_COMMA)) {
            Set.insert<String>(set: mut params, value: read tk_text(toks: read toks, i: read pp))
        }
        pp = pp + 1
    }
    // inner-declared names (local/let inside the body)
    let mut inner = Set.new<String>()
    let mut di = bOpen + 1
    while di < bClose {
        if is_kw_text(toks: read toks, i: read di, word: read "let") || is_kw_text(toks: read toks, i: read di, word: read "local") {
            let mut nm = di + 1
            if is_kw_text(toks: read toks, i: read nm, word: read "mut") { nm = nm + 1 }
            if is_ident_tok(toks: read toks, i: read nm) { Set.insert<String>(set: mut inner, value: read tk_text(toks: read toks, i: read nm)) }
        }
        di = di + 1
    }
    // declared captures: `name|eff` pairs (optional read/mut/take prefix, default read)
    let mut declPairs = Set.new<String>()
    let mut c = cp + 2
    while c < capClose {
        if is_effect_kw(toks: read toks, i: read c) && is_ident_tok(toks: read toks, i: read (c + 1)) {
            let eff = tk_text(toks: read toks, i: read c)
            let nm = tk_text(toks: read toks, i: read (c + 1))
            Set.insert<String>(set: mut declPairs, value: read String.concat(left: read String.concat(left: read nm, right: read "|"), right: read eff))
            c = c + 2
        } else if is_ident_tok(toks: read toks, i: read c) {
            let nm = tk_text(toks: read toks, i: read c)
            Set.insert<String>(set: mut declPairs, value: read String.concat(left: read nm, right: read "|read"))
            c = c + 1
        } else {
            c = c + 1
        }
    }
    // observed external uses (distinct); Missing/Mismatch fire here. Only plain identifiers
    // (TOK_IDENT) are captures — keywords (return/if/let/…) are is_ident_tok but not variables.
    let mut observedNames = Set.new<String>()
    let mut m = bOpen + 1
    while m < bClose {
        if tk_kind(toks: read toks, i: read m) == TOK_IDENT {
            let nm = tk_text(toks: read toks, i: read m)
            if is_upper_head(name: read nm) == false && Set.contains<String>(set: read params, value: read nm) == false && Set.contains<String>(set: read inner, value: read nm) == false && Set.contains<String>(set: read observedNames, value: read nm) == false && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_LPAREN) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false {
                let eff = capture_body_effect(toks: read toks, bodyOpen: read bOpen, bodyClose: read bClose, name: read nm, params: read params, inner: read inner)
                if eff != "" {
                    Set.insert<String>(set: mut observedNames, value: read nm)
                    let pair = String.concat(left: read String.concat(left: read nm, right: read "|"), right: read eff)
                    if Set.contains<String>(set: read declPairs, value: read pair) == false {
                        return true
                    }
                }
            }
        }
        m = m + 1
    }
    // Unused: a declared capture name never used in the body
    let mut c2 = cp + 2
    while c2 < capClose {
        if is_ident_tok(toks: read toks, i: read c2) && is_effect_kw(toks: read toks, i: read c2) == false {
            let dn = tk_text(toks: read toks, i: read c2)
            if Set.contains<String>(set: read observedNames, value: read dn) == false {
                return true
            }
        }
        c2 = c2 + 1
    }
    return false
}

// Any explicit closure in the file whose capture contract is violated (RS0805).
fn has_capture_contract_bad(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "captures") && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            if capture_contract_bad(toks: read toks, cp: read k) { return true }
        }
        k = k + 1
    }
    return false
}

// Dotted names of fns whose return type root is a resource, or Result<Resource, E>.
fn collect_producer_fns(toks: read List<Tok>, resources: read Set<String>) -> Set<String> {
    let n = List.len(list: read toks)
    let mut out = Set.new<String>()
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "fn") && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let ns = k + 1
            // find `->` at depth 0 (works for bodyless fn decls too — don't rely on the body `{`)
            let mut a = ns + 1
            let mut arrow = 0 - 1
            let mut d = 0
            let mut scanning = true
            while scanning {
                if a >= n {
                    scanning = false
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read a, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read a, code: read SYM_LANGLE) {
                    d = d + 1
                    a = a + 1
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read a, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read a, code: read SYM_RANGLE) {
                    if d > 0 { d = d - 1 }
                    a = a + 1
                } else if d == 0 && at_symbol(toks: read toks, i: read a, code: read SYM_ARROW) {
                    arrow = a
                    scanning = false
                } else if d == 0 && (at_symbol(toks: read toks, i: read a, code: read SYM_LBRACE) || is_kw_text(toks: read toks, i: read a, word: read "fn")) {
                    scanning = false
                } else {
                    a = a + 1
                }
            }
            if arrow > 0 {
                let mut r = arrow + 1
                if is_kw_text(toks: read toks, i: read r, word: read "fresh") { r = r + 1 }
                let root = tk_text(toks: read toks, i: read r)
                let mut isProducer = false
                if Set.contains<String>(set: read resources, value: read root) {
                    isProducer = true
                } else if root == "Result" && at_symbol(toks: read toks, i: read (r + 1), code: read SYM_LANGLE) && Set.contains<String>(set: read resources, value: read tk_text(toks: read toks, i: read (r + 2))) {
                    isProducer = true
                }
                if isProducer {
                    Set.insert<String>(set: mut out, value: read dotted_name_text(toks: read toks, i: read ns))
                }
            }
            k = ns
        } else {
            k = k + 1
        }
    }
    return out
}

// M3: ResourcePool.borrow/.try_borrow lease used outside a `with` resource slot.
fn has_pool_lease_escape(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut m = 0
    while m < n {
        let mt = tk_text(toks: read toks, i: read m)
        if (mt == "borrow" || mt == "try_borrow") && m >= 2 && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) {
            let mut root = m - 2
            if at_symbol(toks: read toks, i: read (m - 2), code: read SYM_RANGLE) {
                let mut depth = 0
                let mut b = m - 2
                let mut going = true
                while going {
                    if b <= 0 {
                        going = false
                    } else if at_symbol(toks: read toks, i: read b, code: read SYM_RANGLE) {
                        depth = depth + 1
                        b = b - 1
                    } else if at_symbol(toks: read toks, i: read b, code: read SYM_LANGLE) {
                        depth = depth - 1
                        if depth == 0 {
                            root = b - 1
                            going = false
                        } else {
                            b = b - 1
                        }
                    } else {
                        b = b - 1
                    }
                }
            }
            if tk_text(toks: read toks, i: read root) == "ResourcePool" && is_kw_text(toks: read toks, i: read (root - 1), word: read "with") == false {
                return true
            }
        }
        m = m + 1
    }
    return false
}

// M4: a resource producer (a producer-fn call or a resource constructor `R(`) that is not the
// resource expression of a `with` (its root ident is not immediately preceded by `with`), and is
// not the producer fn's own declaration (`fn R.open(...)`).
fn has_producer_escape(toks: read List<Tok>, resources: read Set<String>, producerFns: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_ident_tok(toks: read toks, i: read k) && (is_kw_text(toks: read toks, i: read (k - 1), word: read "return") || at_symbol(toks: read toks, i: read (k - 1), code: read SYM_EQ)) {
            // only a producer that is directly returned or bound (`let x = producer`) escapes — one
            // used as a sub-expression (e.g. a factory `create: || Producer.open(...)` closure) is OK
            // resource constructor `R(`
            let mut isProducer = false
            if Set.contains<String>(set: read resources, value: read tk_text(toks: read toks, i: read k)) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
                isProducer = true
            } else {
                // producer-fn call `A.b(` — match the dotted name against the registry
                let de = dotted_end(toks: read toks, i: read k)
                if de > k && at_symbol(toks: read toks, i: read de, code: read SYM_LPAREN) && Set.contains<String>(set: read producerFns, value: read dotted_name_text(toks: read toks, i: read k)) {
                    isProducer = true
                }
            }
            if isProducer { return true }
        }
        k = k + 1
    }
    return false
}

// The operand base of an escape after skipping read/mut/take, `?`, and Ok/Err/Some wrappers.
fn escape_operand_is(toks: read List<Tok>, pos: read Int, name: read String) -> Bool {
    let mut p = pos
    let mut going = true
    while going {
        if is_effect_kw(toks: read toks, i: read p) {
            p = p + 1
        } else if (tk_text(toks: read toks, i: read p) == "Ok" || tk_text(toks: read toks, i: read p) == "Err" || tk_text(toks: read toks, i: read p) == "Some") && at_symbol(toks: read toks, i: read (p + 1), code: read SYM_LPAREN) {
            p = p + 2
        } else {
            going = false
        }
    }
    return tk_text(toks: read toks, i: read p) == name
}

// M1: within a `with … as B { body }`, B escapes via return / plain `let` / manage / take-arg /
// retains-arg. (Closure captures are M2/M5.)
fn with_binding_escapes(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String, retains: read Set<String>) -> Bool {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "return") {
            if escape_operand_is(toks: read toks, pos: read (k + 1), name: read name) { return true }
        } else if is_kw_text(toks: read toks, i: read k, word: read "let") {
            // let [mut] x = <wrap> B
            let mut e = k + 1
            while e < bodyClose && at_symbol(toks: read toks, i: read e, code: read SYM_EQ) == false && at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) == false {
                e = e + 1
            }
            if e < bodyClose && at_symbol(toks: read toks, i: read e, code: read SYM_EQ) {
                if escape_operand_is(toks: read toks, pos: read (e + 1), name: read name) { return true }
            }
        } else if is_kw_text(toks: read toks, i: read k, word: read "manage") {
            if tk_text(toks: read toks, i: read (k + 1)) == name { return true }
        } else if is_kw_text(toks: read toks, i: read k, word: read "take") && tk_text(toks: read toks, i: read (k + 1)) == name && (at_symbol(toks: read toks, i: read (k + 2), code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read (k + 2), code: read SYM_COMMA)) {
            return true
        } else if is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == name && is_effect_kw(toks: read toks, i: read (k - 1)) && at_symbol(toks: read toks, i: read (k - 2), code: read SYM_COLON) {
            // retains-arg: `callee(… label: <effect> B …)` where callee|label declares retains(label)
            let label = tk_text(toks: read toks, i: read (k - 3))
            let callOpen = enclosing_paren_open(toks: read toks, p: read k, floor: read bodyOpen)
            if callOpen > 0 && is_ident_tok(toks: read toks, i: read (callOpen - 1)) {
                let key = String.concat(left: read String.concat(left: read tk_text(toks: read toks, i: read (callOpen - 1)), right: read "|"), right: read label)
                if Set.contains<String>(set: read retains, value: read key) { return true }
            }
        }
        k = k + 1
    }
    return false
}

// M2/M5: within a `with … as B { body }`, a closure captures B. A stored `let` closure (M2) or a
// ResourcePool factory `create:` closure (M5) fires; a bare `local` closure does not.
fn with_binding_closure_capture(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String) -> Bool {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        // closure body `{` preceded by a `|`
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_PIPE) {
            let cbClose = find_matching(toks: read toks, open: read k, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            let op = find_closure_open_pipe(toks: read toks, cb: read k, floor: read bodyOpen)
            if cbClose > 0 && op > 0 {
                // does the body reference B (bare)?
                let mut refsB = false
                let mut m = k + 1
                while m < cbClose {
                    if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == name && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false {
                        refsB = true
                    }
                    m = m + 1
                }
                if refsB {
                    // stored-let closure, or a factory closure (`create:` / preceded by a label:)
                    let mut bpos = op - 1
                    if is_effect_kw(toks: read toks, i: read bpos) { bpos = bpos - 1 }
                    // see through a `Some(`/`Ok(`/`Err(` wrapper around the closure
                    if at_symbol(toks: read toks, i: read bpos, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (bpos - 1)) && (tk_text(toks: read toks, i: read (bpos - 1)) == "Some" || tk_text(toks: read toks, i: read (bpos - 1)) == "Ok" || tk_text(toks: read toks, i: read (bpos - 1)) == "Err") {
                        bpos = bpos - 2
                        if is_effect_kw(toks: read toks, i: read bpos) { bpos = bpos - 1 }
                    }
                    if at_symbol(toks: read toks, i: read bpos, code: read SYM_EQ) {
                        let mut kw = bpos - 2
                        if is_kw_text(toks: read toks, i: read kw, word: read "mut") { kw = kw - 1 }
                        if is_kw_text(toks: read toks, i: read kw, word: read "let") { return true }
                    } else if at_symbol(toks: read toks, i: read bpos, code: read SYM_COLON) {
                        // a labelled closure argument (create: || …) — factory capture
                        return true
                    }
                }
            }
            k = cbClose
        }
        k = k + 1
    }
    return false
}

// M5: within a `with … as B { body }`, a ResourcePool factory (.new/.try_new/.lazy/.try_lazy)
// `create` closure (expression- or block-bodied) references B.
fn with_body_factory_captures(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String) -> Bool {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if tk_text(toks: read toks, i: read k) == "ResourcePool" {
            let mut mpos = k + 1
            if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LANGLE) {
                let rangle = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
                if rangle >= 0 { mpos = rangle + 1 }
            }
            if at_symbol(toks: read toks, i: read mpos, code: read SYM_DOT) {
                let method = tk_text(toks: read toks, i: read (mpos + 1))
                if (method == "new" || method == "try_new" || method == "lazy" || method == "try_lazy") && at_symbol(toks: read toks, i: read (mpos + 2), code: read SYM_LPAREN) {
                    let callOpen = mpos + 2
                    let callClose = find_matching(toks: read toks, open: read callOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                    if callClose > 0 {
                        // scan the whole factory-call arg region for a bare reference to B
                        let mut m = callOpen + 1
                        while m < callClose {
                            if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == name && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false {
                                return true
                            }
                            m = m + 1
                        }
                        k = callClose
                    }
                }
            }
        }
        k = k + 1
    }
    return false
}

// RS0702 whole-file predicate combining all five paths.
fn has_resource_escape(toks: read List<Tok>, resources: read Set<String>, retains: read Set<String>) -> Bool {
    if has_pool_lease_escape(toks: read toks) { return true }
    let producerFns = collect_producer_fns(toks: read toks, resources: read resources)
    if has_producer_escape(toks: read toks, resources: read resources, producerFns: read producerFns) { return true }
    // M1/M2/M5: iterate `with EXPR as B { body }`
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "with") {
            // find `as B {` — the binding name follows `as`, the body `{` follows the name
            let mut a = k + 1
            let mut asPos = 0 - 1
            while a < n {
                if is_kw_text(toks: read toks, i: read a, word: read "as") {
                    asPos = a
                    a = n
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_LBRACE) {
                    a = n
                } else {
                    a = a + 1
                }
            }
            if asPos > 0 && is_ident_tok(toks: read toks, i: read (asPos + 1)) && at_symbol(toks: read toks, i: read (asPos + 2), code: read SYM_LBRACE) {
                let name = tk_text(toks: read toks, i: read (asPos + 1))
                let bodyOpen = asPos + 2
                let bodyClose = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if bodyClose > 0 {
                    if with_binding_escapes(toks: read toks, bodyOpen: read bodyOpen, bodyClose: read bodyClose, name: read name, retains: read retains) { return true }
                    if with_binding_closure_capture(toks: read toks, bodyOpen: read bodyOpen, bodyClose: read bodyClose, name: read name) { return true }
                    if with_body_factory_captures(toks: read toks, bodyOpen: read bodyOpen, bodyClose: read bodyClose, name: read name) { return true }
                }
            }
        } else if is_kw_text(toks: read toks, i: read k, word: read "view") && is_ident_tok(toks: read toks, i: read (k + 1)) && at_symbol(toks: read toks, i: read (k + 2), code: read SYM_EQ) {
            // `view NAME = EXPR` desugars to a with-lease scoped to the rest of the enclosing block
            let name = tk_text(toks: read toks, i: read (k + 1))
            let mut depth = 0
            let mut e = k + 3
            let mut ec = 0 - 1
            while e < n {
                if at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) {
                    depth = depth + 1
                    e = e + 1
                } else if at_symbol(toks: read toks, i: read e, code: read SYM_RBRACE) {
                    if depth == 0 {
                        ec = e
                        e = n
                    } else {
                        depth = depth - 1
                        e = e + 1
                    }
                } else {
                    e = e + 1
                }
            }
            if ec > 0 {
                if with_binding_escapes(toks: read toks, bodyOpen: read (k + 2), bodyClose: read ec, name: read name, retains: read retains) { return true }
                if with_binding_closure_capture(toks: read toks, bodyOpen: read (k + 2), bodyClose: read ec, name: read name) { return true }
            }
        }
        k = k + 1
    }
    return false
}

fn is_copy_scalar_name(name: read String) -> Bool {
    return name == "Bool" || name == "Byte" || name == "Char" || name == "Float" || name == "Float32" || name == "Float64" || name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Unit"
}

// Is the payload type in token range [lo, hi) transferable? Bare enclosing fn
// type params are unresolved here, so mirror Rust and leave them for a future
// Sendable-style bound instead of false-positiveing.
fn channel_payload_transferable(toks: read List<Tok>, lo: read Int, hi: read Int, generics: read Set<String>) -> Bool {
    // any nested generic (`<`) ⇒ not Copy, not String/Bytes ⇒ non-transferable
    let mut i = lo
    while i < hi {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) { return false }
        i = i + 1
    }
    // strip a leading `fresh`
    let mut s = lo
    if is_kw_text(toks: read toks, i: read s, word: read "fresh") { s = s + 1 }
    if s == hi - 1 {
        let t = tk_text(toks: read toks, i: read s)
        if Set.contains<String>(set: read generics, value: read t) { return true }
        return is_copy_scalar_name(name: read t) || t == "String" || t == "Bytes"
    }
    return false
}

// RS0036 inside [start,end): any `Channel.message<T>` whose payload `T` is not transferable.
fn region_has_nontransferable_channel(toks: read List<Tok>, start: read Int, end: read Int, generics: read Set<String>) -> Bool {
    let mut k = start
    while k < end {
        if tk_text(toks: read toks, i: read k) == "Channel" && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_DOT) && tk_text(toks: read toks, i: read (k + 2)) == "message" && at_symbol(toks: read toks, i: read (k + 3), code: read SYM_LANGLE) {
            let open = k + 3
            let mut depth = 0
            let mut j = open
            let mut close = 0 - 1
            while j < end && close < 0 {
                if at_symbol(toks: read toks, i: read j, code: read SYM_LANGLE) {
                    depth = depth + 1
                } else if at_symbol(toks: read toks, i: read j, code: read SYM_RANGLE) {
                    depth = depth - 1
                    if depth == 0 { close = j }
                }
                j = j + 1
            }
            if close > open + 1 {
                if channel_payload_transferable(toks: read toks, lo: read (open + 1), hi: read close, generics: read generics) == false {
                    return true
                }
            }
        }
        k = k + 1
    }
    return false
}

// RS0036: whole-file wrapper. Walk function bodies so bare function generics can
// be skipped exactly like the Rust analyzer.
fn has_nontransferable_channel(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        let isPub = at_ident(toks: read toks, i: read k, wid: read WORD_PUB)
        if starts_fn_like(toks: read toks, i: read k, isPub: read isPub) {
            let ns = fn_name_start(toks: read toks, i: read k)
            let nameEnd = dotted_end(toks: read toks, i: read ns)
            let generics = collect_generics(toks: read toks, nameEnd: read nameEnd)
            let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
            if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) {
                let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if bodyClose > 0 {
                    if region_has_nontransferable_channel(toks: read toks, start: read sigEnd, end: read bodyClose, generics: read generics) { return true }
                    k = bodyClose
                }
            }
        }
        k = k + 1
    }
    return false
}

// Dotted names of fns whose return type is `Result<Resource, E>` (or `Result<fresh Resource, E>`) —
// i.e. FALLIBLE resource producers. Mirrors collect_producer_fns but only the Result<Resource> case.
fn collect_fallible_producers(toks: read List<Tok>, resources: read Set<String>) -> Set<String> {
    let n = List.len(list: read toks)
    let mut out = Set.new<String>()
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "fn") {
            let ns = k + 1
            // find `->` at depth 0 (handles bodyless decls)
            let mut a = ns + 1
            let mut arrow = 0 - 1
            let mut d = 0
            let mut scanning = true
            while scanning {
                if a >= n {
                    scanning = false
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read a, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read a, code: read SYM_LANGLE) {
                    d = d + 1
                    a = a + 1
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read a, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read a, code: read SYM_RANGLE) {
                    if d > 0 { d = d - 1 }
                    a = a + 1
                } else if d == 0 && at_symbol(toks: read toks, i: read a, code: read SYM_ARROW) {
                    arrow = a
                    scanning = false
                } else if d == 0 && (at_symbol(toks: read toks, i: read a, code: read SYM_LBRACE) || is_kw_text(toks: read toks, i: read a, word: read "fn")) {
                    scanning = false
                } else {
                    a = a + 1
                }
            }
            if arrow > 0 {
                let r = arrow + 1
                if tk_text(toks: read toks, i: read r) == "Result" && at_symbol(toks: read toks, i: read (r + 1), code: read SYM_LANGLE) {
                    // inner type root (skip a leading `fresh`)
                    let mut inner = r + 2
                    if is_kw_text(toks: read toks, i: read inner, word: read "fresh") { inner = inner + 1 }
                    if Set.contains<String>(set: read resources, value: read tk_text(toks: read toks, i: read inner)) {
                        Set.insert<String>(set: mut out, value: read dotted_name_text(toks: read toks, i: read ns))
                    }
                }
            }
        }
        k = k + 1
    }
    return out
}

// Builtin fallible resource producers whose signatures come from stdlib interfaces,
// not the source file. Only add them when the file does not declare the same
// dotted fn name; same-file declarations shadow the builtin signature.
fn add_builtin_fallible_producers(out: mut Set<String>, allFns: read Set<String>) -> Unit {
    if Set.contains<String>(set: read allFns, value: read "Image.load") == false {
        Set.insert<String>(set: mut out, value: read "Image.load")
    }
}

// RS0706: `with <fallible-producer call> as B` with no `?` before `as` (the Result is not unwrapped).
fn has_missing_try_producer(toks: read List<Tok>, fallible: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks: read toks, i: read k, word: read "with") && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let de = dotted_end(toks: read toks, i: read (k + 1))
            if de > k + 1 && at_symbol(toks: read toks, i: read de, code: read SYM_LPAREN) && Set.contains<String>(set: read fallible, value: read dotted_name_text(toks: read toks, i: read (k + 1))) {
                // scan from the call's close-paren to the `as`: fire if there is no `?`
                let close = find_matching(toks: read toks, open: read de, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if close > 0 {
                    let mut hasTry = false
                    let mut m = close + 1
                    while m < n && is_kw_text(toks: read toks, i: read m, word: read "as") == false {
                        if at_symbol(toks: read toks, i: read m, code: read SYM_QUESTION) { hasTry = true }
                        m = m + 1
                    }
                    if hasTry == false { return true }
                }
            }
        }
        k = k + 1
    }
    return false
}

// RS0707: `ResourcePool<…>.new(create: || <fallible-producer>(…))` — `.new` demands an infallible factory.
fn has_fallible_factory(toks: read List<Tok>, fallible: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        // `.new(` whose receiver root is ResourcePool
        if tk_text(toks: read toks, i: read k) == "new" && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            let root = pool_receiver_root(toks: read toks, dot: read (k - 1))
            if tk_text(toks: read toks, i: read root) == "ResourcePool" {
                let close = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if close > 0 {
                    // any fallible producer call inside the arg region ⇒ fallible factory
                    let mut m = k + 2
                    while m < close {
                        if is_ident_tok(toks: read toks, i: read m) && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false {
                            let de = dotted_end(toks: read toks, i: read m)
                            if de > m && at_symbol(toks: read toks, i: read de, code: read SYM_LPAREN) && Set.contains<String>(set: read fallible, value: read dotted_name_text(toks: read toks, i: read m)) {
                                return true
                            }
                        }
                        m = m + 1
                    }
                }
            }
        }
        k = k + 1
    }
    return false
}

// receiver root of a `.method` — walks back over a `Name<…>` generic clause.
fn pool_receiver_root(toks: read List<Tok>, dot: read Int) -> Int {
    let mut root = dot - 1
    if at_symbol(toks: read toks, i: read (dot - 1), code: read SYM_RANGLE) {
        let mut depth = 0
        let mut b = dot - 1
        let mut going = true
        while going {
            if b <= 0 {
                going = false
            } else if at_symbol(toks: read toks, i: read b, code: read SYM_RANGLE) {
                depth = depth + 1
                b = b - 1
            } else if at_symbol(toks: read toks, i: read b, code: read SYM_LANGLE) {
                depth = depth - 1
                if depth == 0 { root = b - 1; going = false } else { b = b - 1 }
            } else {
                b = b - 1
            }
        }
    }
    return root
}

// pool value of a `ResourcePool.borrow(pool: <effect> P)` call — returns the ident P, or -1.
fn borrow_pool_value(toks: read List<Tok>, open: read Int, close: read Int) -> Int {
    let mut m = open + 1
    while m < close {
        if tk_text(toks: read toks, i: read m) == "pool" && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) {
            let mut v = m + 2
            if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
            if is_ident_tok(toks: read toks, i: read v) { return v }
        }
        m = m + 1
    }
    return 0 - 1
}

// RS0709: a `with ResourcePool.borrow(pool: mut P) as _ { … }` nested inside another borrow of the SAME P.
fn has_active_lease_conflict(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if (tk_text(toks: read toks, i: read k) == "borrow" || tk_text(toks: read toks, i: read k) == "try_borrow") && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            let root = pool_receiver_root(toks: read toks, dot: read (k - 1))
            if tk_text(toks: read toks, i: read root) == "ResourcePool" && is_kw_text(toks: read toks, i: read (root - 1), word: read "with") {
                let close = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                let pv = borrow_pool_value(toks: read toks, open: read (k + 1), close: read close)
                if close > 0 && pv >= 0 {
                    let pname = tk_text(toks: read toks, i: read pv)
                    // find this with-body `{ … }` and scan it for another borrow of pname
                    let mut b = close + 1
                    while b < n && at_symbol(toks: read toks, i: read b, code: read SYM_LBRACE) == false { b = b + 1 }
                    if b < n {
                        let bodyClose = find_matching(toks: read toks, open: read b, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                        if bodyClose > 0 {
                            let mut m = b + 1
                            while m < bodyClose {
                                if (tk_text(toks: read toks, i: read m) == "borrow" || tk_text(toks: read toks, i: read m) == "try_borrow") && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_LPAREN) {
                                    let r2 = pool_receiver_root(toks: read toks, dot: read (m - 1))
                                    if tk_text(toks: read toks, i: read r2) == "ResourcePool" {
                                        let c2 = find_matching(toks: read toks, open: read (m + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                                        let pv2 = borrow_pool_value(toks: read toks, open: read (m + 1), close: read c2)
                                        if pv2 >= 0 && tk_text(toks: read toks, i: read pv2) == pname { return true }
                                    }
                                }
                                m = m + 1
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return false
}

// RS0710: `ResourcePool.discard(lease: <effect> X)` where X is not bound by a `with …borrow… as X`.
fn has_discard_non_lease(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut k = 0
    while k < n {
        if tk_text(toks: read toks, i: read k) == "discard" && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
            let root = pool_receiver_root(toks: read toks, dot: read (k - 1))
            if tk_text(toks: read toks, i: read root) == "ResourcePool" {
                let close = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                // lease arg value
                let mut lv = 0 - 1
                let mut m = k + 2
                while m < close {
                    if tk_text(toks: read toks, i: read m) == "lease" && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) {
                        let mut v = m + 2
                        if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
                        if is_ident_tok(toks: read toks, i: read v) { lv = v }
                    }
                    m = m + 1
                }
                if lv >= 0 {
                    let lname = tk_text(toks: read toks, i: read lv)
                    // is lname bound by `with ResourcePool.borrow(…) as lname`?
                    let mut isLease = false
                    let mut w = 0
                    while w < n {
                        if is_kw_text(toks: read toks, i: read w, word: read "as") && is_ident_tok(toks: read toks, i: read (w + 1)) && tk_text(toks: read toks, i: read (w + 1)) == lname {
                            isLease = true
                        }
                        w = w + 1
                    }
                    if isLease == false { return true }
                }
            }
        }
        k = k + 1
    }
    return false
}

// `name` escapes as an ordinary value: return name / let y = name / pass to a non-noescape param.
fn value_escapes(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String, noescape: read Set<String>) -> Bool {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "return") {
            let mut p = k + 1
            if is_effect_kw(toks: read toks, i: read p) { p = p + 1 }
            // `return name` escapes; `return name()` (a direct call) does not
            if tk_text(toks: read toks, i: read p) == name && at_symbol(toks: read toks, i: read (p + 1), code: read SYM_LPAREN) == false && at_symbol(toks: read toks, i: read (p + 1), code: read SYM_DOT) == false { return true }
        } else if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut e = k + 1
            while e < bodyClose && at_symbol(toks: read toks, i: read e, code: read SYM_EQ) == false && at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) == false {
                e = e + 1
            }
            if e < bodyClose && at_symbol(toks: read toks, i: read e, code: read SYM_EQ) {
                let mut r = e + 1
                if is_effect_kw(toks: read toks, i: read r) { r = r + 1 }
                if tk_text(toks: read toks, i: read r) == name && at_symbol(toks: read toks, i: read (r + 1), code: read SYM_LPAREN) == false && at_symbol(toks: read toks, i: read (r + 1), code: read SYM_DOT) == false { return true }
            }
        } else if is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == name && is_effect_kw(toks: read toks, i: read (k - 1)) && at_symbol(toks: read toks, i: read (k - 2), code: read SYM_COLON) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) == false {
            // pass as arg `callee(label: <effect> name)` — escapes unless the target is noescape
            let label = tk_text(toks: read toks, i: read (k - 3))
            let callOpen = enclosing_paren_open(toks: read toks, p: read k, floor: read bodyOpen)
            if callOpen > 0 && is_ident_tok(toks: read toks, i: read (callOpen - 1)) {
                let key = String.concat(left: read String.concat(left: read tk_text(toks: read toks, i: read (callOpen - 1)), right: read "|"), right: read label)
                if Set.contains<String>(set: read noescape, value: read key) == false { return true }
            }
        }
        k = k + 1
    }
    return false
}

// A stored `let X = |…| { … name … }` closure captures `name` (RS0802 stored-closure escape).
fn stored_closure_captures(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, name: read String) -> Bool {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_PIPE) {
            let cbClose = find_matching(toks: read toks, open: read k, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            let op = find_closure_open_pipe(toks: read toks, cb: read k, floor: read bodyOpen)
            if cbClose > 0 && op > 0 {
                // stored: opening pipe preceded (skip effect) by `=` and a `let`
                let mut bpos = op - 1
                if is_effect_kw(toks: read toks, i: read bpos) { bpos = bpos - 1 }
                let mut stored = false
                if at_symbol(toks: read toks, i: read bpos, code: read SYM_EQ) {
                    let mut kw = bpos - 2
                    if is_kw_text(toks: read toks, i: read kw, word: read "mut") { kw = kw - 1 }
                    if is_kw_text(toks: read toks, i: read kw, word: read "let") { stored = true }
                }
                if stored {
                    let mut m = k + 1
                    while m < cbClose {
                        if is_ident_tok(toks: read toks, i: read m) && tk_text(toks: read toks, i: read m) == name && at_symbol(toks: read toks, i: read (m - 1), code: read SYM_DOT) == false && at_symbol(toks: read toks, i: read (m + 1), code: read SYM_COLON) == false {
                            return true
                        }
                        m = m + 1
                    }
                }
            }
            k = cbClose
        }
        k = k + 1
    }
    return false
}

// RS0802: a `noescape Fn()` parameter that is retained by its own fn (signature variant) or escapes
// in the body (return / let-store / pass-ordinary / stored-closure capture).
fn fn_noescape_escape(toks: read List<Tok>, start: read Int, noescape: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    // signature-retains variant: a noescape param `p` with `retains(p)` in the same signature
    let mut q = ns
    while q < sigEnd {
        if is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (q + 2), word: read "noescape") {
            let pname = tk_text(toks: read toks, i: read q)
            let mut rr = ns
            while rr < sigEnd {
                if is_kw_text(toks: read toks, i: read rr, word: read "retains") && at_symbol(toks: read toks, i: read (rr + 1), code: read SYM_LPAREN) && tk_text(toks: read toks, i: read (rr + 2)) == pname {
                    return true
                }
                rr = rr + 1
            }
        }
        q = q + 1
    }
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    // escape variant: any noescape param escaping in the body
    let mut pit = ns
    while pit < sigEnd {
        if is_ident_tok(toks: read toks, i: read pit) && at_symbol(toks: read toks, i: read (pit + 1), code: read SYM_COLON) && is_kw_text(toks: read toks, i: read (pit + 2), word: read "noescape") {
            let pname = tk_text(toks: read toks, i: read pit)
            if value_escapes(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, name: read pname, noescape: read noescape) { return true }
            if stored_closure_captures(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, name: read pname) { return true }
        }
        pit = pit + 1
    }
    return false
}

// RS0803: a `local`-bound closure that escapes (return / let-store / pass-ordinary).
fn fn_local_closure_escape(toks: read List<Tok>, start: read Int, noescape: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    while k < bodyClose {
        // `local X = |` — a local closure binding
        if is_kw_text(toks: read toks, i: read k, word: read "local") && is_ident_tok(toks: read toks, i: read (k + 1)) && at_symbol(toks: read toks, i: read (k + 2), code: read SYM_EQ) && at_symbol(toks: read toks, i: read (k + 3), code: read SYM_PIPE) {
            let cname = tk_text(toks: read toks, i: read (k + 1))
            if value_escapes(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, name: read cname, noescape: read noescape) { return true }
        }
        k = k + 1
    }
    return false
}

fn fn_has_fresh_return_bad(toks: read List<Tok>, start: read Int, handleFields: read Set<String>, retains: read Set<String>, freshFns: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    if fn_return_type_has_fresh(toks: read toks, ns: read ns, sigEnd: read sigEnd) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let managed = collect_managed_names(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose)
    let mut fireParams = Set.new<String>()
    collect_fire_params(toks: read toks, ns: read ns, sigEnd: read sigEnd, out: mut fireParams)
    let mut nonFreshLets = Set.new<String>()
    collect_managed_nonfresh_lets(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, freshFns: read freshFns, out: mut nonFreshLets)
    let mut tainted = Set.new<String>()
    collect_tainted_bindings(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, retains: read retains, out: mut tainted)
    let mut matchBinds = Set.new<String>()
    collect_managed_match_binds(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, managed: read managed, out: mut matchBinds)
    let mut localNames = Set.new<String>()
    collect_local_names(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, out: mut localNames)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "return") {
            let mut v = k + 1
            if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
            let mut unwrap = true
            while unwrap {
                if is_ident_tok(toks: read toks, i: read v) && (tk_text(toks: read toks, i: read v) == "Some" || tk_text(toks: read toks, i: read v) == "Ok") && at_symbol(toks: read toks, i: read (v + 1), code: read SYM_LPAREN) {
                    v = v + 2
                    if is_ident_tok(toks: read toks, i: read v) && at_symbol(toks: read toks, i: read (v + 1), code: read SYM_COLON) { v = v + 2 }
                    if is_effect_kw(toks: read toks, i: read v) { v = v + 1 }
                } else {
                    unwrap = false
                }
            }
            if is_ident_tok(toks: read toks, i: read v) {
                let base = tk_text(toks: read toks, i: read v)
                let nextDot = at_symbol(toks: read toks, i: read (v + 1), code: read SYM_DOT)
                let nextParen = at_symbol(toks: read toks, i: read (v + 1), code: read SYM_LPAREN)
                if nextDot {
                    // a handle-field access `x.f` (not a method call) is not clean
                    if is_ident_tok(toks: read toks, i: read (v + 2)) && at_symbol(toks: read toks, i: read (v + 3), code: read SYM_LPAREN) == false && Set.contains<String>(set: read handleFields, value: read tk_text(toks: read toks, i: read (v + 2))) { hit = true }
                } else if nextParen == false {
                    if Set.contains<String>(set: read fireParams, value: read base) {
                        hit = true
                    } else if Set.contains<String>(set: read matchBinds, value: read base) {
                        hit = true
                    } else if Set.contains<String>(set: read nonFreshLets, value: read base) {
                        hit = true
                    } else if (Set.contains<String>(set: read localNames, value: read base) || Set.contains<String>(set: read managed, value: read base)) && Set.contains<String>(set: read tainted, value: read base) {
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0205: a call that repeats a named argument, e.g. `f(x: 1, x: 2)` (oracle
// checks/calls.rs). We detect the syntactic case — the same explicit `name:` label
// twice in one call's arg list. An arg label is an `IDENT:` that sits at an argument
// START: right after the call's `(` or after a depth-0 `,`. That anchoring excludes
// struct-field colons (`{x: 1}` — inside `{}`, depth>0), nested-call labels, and
// typed closure params. Positional duplicates (same param filled twice without a
// label) need callee resolution and are left as a safe false-negative.
fn call_has_dup_arg(toks: read List<Tok>, open: read Int, close: read Int) -> Bool {
    let mut seen = Set<String>.new()
    let mut dup = false
    let mut depth = 0
    let mut atArgStart = true
    let mut k = open + 1
    while k < close {
        if depth == 0 && atArgStart && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let label = tk_text(toks: read toks, i: read k)
            if Set.contains<String>(set: read seen, value: read label) {
                dup = true
            } else {
                Set.insert<String>(set: mut seen, value: read label)
            }
        }
        atArgStart = false
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            atArgStart = true
        }
        k = k + 1
    }
    return dup
}

// RS0205 over one fn body: any `(...)` whose arg list repeats a label. Runs on every
// paren (grouping parens carry no labels, so this is safe); cost is O(tokens * depth),
// fine for the shallow call nesting in real code.
fn fn_has_dup_arg(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close >= 0 {
                if call_has_dup_arg(toks: read toks, open: read k, close: read close) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0028: a parameter named `self` that is not the first parameter of a qualified
// method (check_params: `self` && (!is_qualified_method || index != 0)). A method
// is qualified iff its name is dotted (`Type.method`).
fn fn_has_invalid_self(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let qualified = at_symbol(toks: read toks, i: read (ns + 1), code: read SYM_DOT)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut idx = 0
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_is_bad_self(toks: read toks, segStart: read segStart, segEnd: read k, idx: read idx, qualified: read qualified) { hit = true }
            segStart = k + 1
            idx = idx + 1
        }
        k = k + 1
    }
    if seg_is_bad_self(toks: read toks, segStart: read segStart, segEnd: read close, idx: read idx, qualified: read qualified) { hit = true }
    return hit
}

// A param segment is an invalid `self` iff it is named `self` and either the
// enclosing function is not a qualified method or this is not the first parameter.
fn seg_is_bad_self(toks: read List<Tok>, segStart: read Int, segEnd: read Int, idx: read Int, qualified: read Bool) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if tk_text(toks: read toks, i: read segStart) == "self" {
        return qualified == false || idx != 0
    }
    return false
}

// `name : share` — ident, `:`, then `share` as the type's first token.
fn seg_is_share(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    if (segStart + 2) >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return false }
    return tk_text(toks: read toks, i: read (segStart + 2)) == "share"
}

// The 17 Copy scalar type names (crate scalar/primitive set).
fn is_scalar_name(name: read String) -> Bool {
    return name == "Bool" || name == "Byte" || name == "Char" || name == "Float" || name == "Float32" || name == "Float64" || name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Unit"
}

// Copy classification of a param type region for RS0007. The type begins after
// `name :` and an optional data-effect; then optional prefixes precede the base.
// Copy iff (no fresh/noescape prefix) AND base ∈ scalars AND next token is not `<`.
fn seg_type_is_copy(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    let mut k = segStart + 2
    if is_effect_kw(toks: read toks, i: read k) { k = k + 1 }
    let mut sawFreshNoescape = false
    let mut scanning = true
    while scanning {
        let t = tk_text(toks: read toks, i: read k)
        if t == "fresh" || t == "noescape" {
            sawFreshNoescape = true
            k = k + 1
        } else if t == "owned" || t == "handle" || t == "weak" {
            k = k + 1
        } else {
            scanning = false
        }
    }
    if sawFreshNoescape { return false }
    let base = tk_text(toks: read toks, i: read k)
    if is_scalar_name(name: read base) == false { return false }
    if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LANGLE) { return false }
    return true
}

// Status of a named param for RS0007: -1 = this segment is not param `pname`,
// 2 = matched and Copy, 1 = matched and non-Copy.
fn one_param_status(toks: read List<Tok>, segStart: read Int, segEnd: read Int, pname: read String) -> Int {
    if segStart >= segEnd { return -1 }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return -1 }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return -1 }
    if tk_text(toks: read toks, i: read segStart) != pname { return -1 }
    if seg_type_is_copy(toks: read toks, segStart: read segStart, segEnd: read segEnd) { return 2 }
    return 1
}

// Walk the param list [open,close] looking for param `pname`. Returns 0 (not a
// param), 1 (param, non-Copy), or 2 (param, Copy).
fn param_retains_status(toks: read List<Tok>, open: read Int, close: read Int, pname: read String) -> Int {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut status = 0
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            let s = one_param_status(toks: read toks, segStart: read segStart, segEnd: read k, pname: read pname)
            if s != -1 { status = s }
            segStart = k + 1
        }
        k = k + 1
    }
    let s = one_param_status(toks: read toks, segStart: read segStart, segEnd: read close, pname: read pname)
    if s != -1 { status = s }
    return status
}

// One effects-clause item [segStart,segEnd): a `retains(p)` where p is not a
// param, or is a Copy param → RS0007.
fn retains_item_bad(toks: read List<Tok>, segStart: read Int, segEnd: read Int, popen: read Int, pclose: read Int) -> Bool {
    if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read segEnd) != 2 { return false }
    let pname = tk_text(toks: read toks, i: read (segStart + 2))
    let status = param_retains_status(toks: read toks, open: read popen, close: read pclose, pname: read pname)
    return status == 0 || status == 2
}

// RS0007: an `effects(retains(p))` item whose p is not a param, or is a Copy param.
fn fn_retains_bad(toks: read List<Tok>, start: read Int) -> Bool {
    let effOpen = find_effects_open(toks: read toks, start: read start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: read toks, open: read effOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if effClose < 0 { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let popen = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if popen < 0 { return false }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if retains_item_bad(toks: read toks, segStart: read segStart, segEnd: read k, popen: read popen, pclose: read pclose) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if retains_item_bad(toks: read toks, segStart: read segStart, segEnd: read effClose, popen: read popen, pclose: read pclose) { hit = true }
    return hit
}

// ---------------------------------------------------------------------------
// RS0009 INVALID_PURE_EFFECT.
// ---------------------------------------------------------------------------

// Index of the base type token after skipping data effects, `&`, and the
// fresh/noescape/owned/handle/weak prefixes, bounded by e.
fn skip_type_prefixes(toks: read List<Tok>, s: read Int, e: read Int) -> Int {
    let mut p = s
    let mut going = true
    while going {
        let t = tk_text(toks: read toks, i: read p)
        if p < e && (t == "fresh" || t == "noescape" || t == "owned" || t == "handle" || t == "weak" || t == "&" || t == "read" || t == "mut" || t == "take") {
            p = p + 1
        } else {
            going = false
        }
    }
    return p
}

// One effects-clause item is the bare `pure` effect.
fn item_is_pure(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read segEnd) != 1 { return false }
    return tk_text(toks: read toks, i: read segStart) == "pure"
}

// True if the fn declares `effects(pure)` (a bare `pure` item).
fn fn_is_pure(toks: read List<Tok>, start: read Int) -> Bool {
    let effOpen = find_effects_open(toks: read toks, start: read start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: read toks, open: read effOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut pure = false
    while k < effClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if item_is_pure(toks: read toks, segStart: read segStart, segEnd: read k) { pure = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if item_is_pure(toks: read toks, segStart: read segStart, segEnd: read effClose) { pure = true }
    return pure
}

// True if the fn has a `retains(...)` effect item.
fn fn_has_retains(toks: read List<Tok>, start: read Int) -> Bool {
    let effOpen = find_effects_open(toks: read toks, start: read start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: read toks, open: read effOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read k) == 2 { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read effClose) == 2 { hit = true }
    return hit
}

// True if any param uses the `mut` or `take` data effect.
fn fn_has_mut_take_param(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_is_mut_take(toks: read toks, segStart: read segStart, segEnd: read k) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_is_mut_take(toks: read toks, segStart: read segStart, segEnd: read close) { hit = true }
    return hit
}

// `name : mut|take …`
fn seg_is_mut_take(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return false }
    let e = tk_text(toks: read toks, i: read (segStart + 2))
    return e == "mut" || e == "take"
}

// True if a resource-typed value is returned. Mirrors resource_return_type_name:
// for Result/Option the first type arg is the target, else the return itself.
fn fn_pure_resource_return(toks: read List<Tok>, start: read Int, resources: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return false }
    let rs = close + 2
    let mut re = rs
    let mut scanning = true
    while scanning {
        let stop = at_ident(toks: read toks, i: read re, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read re, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read re, code: read SYM_EQ)
        if re < sigEnd && stop == false {
            re = re + 1
        } else {
            scanning = false
        }
    }
    let p = skip_type_prefixes(toks: read toks, s: read rs, e: read re)
    let base = dotted_name_text(toks: read toks, i: read p)
    let after = dotted_end(toks: read toks, i: read p)
    let mut target = base
    if (base == "Result" || base == "Option") && at_symbol(toks: read toks, i: read after, code: read SYM_LANGLE) {
        let ac = find_matching(toks: read toks, open: read after, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if ac >= 0 {
            let q = skip_type_prefixes(toks: read toks, s: read (after + 1), e: read ac)
            target = dotted_name_text(toks: read toks, i: read q)
        }
    }
    return is_stdlib_resource(name: read target) || Set.contains<String>(set: read resources, value: read target)
}

// Stdlib resource types (the `resource` Item::Type decls in the .rssi interfaces).
fn is_stdlib_resource(name: read String) -> Bool {
    return name == "File" || name == "DbConnection" || name == "TempDir"
}

// A qualified call `Ns.method(...)` is pure-allowed iff Ns is a known type.
fn qualified_call_allowed(name: read String, declared: read Set<String>) -> Bool {
    return is_builtin_type(name: read name) || is_stdlib_type(name: read name) || Set.contains<String>(set: read declared, value: read name)
}

// An unqualified call `name(...)` in a pure fn: FLAG iff it resolves to a declared
// non-pure function; constructors / enum variants / pure fns are allowed; an
// unresolved name is ignored.
fn unqual_call_bad(name: read String, sumVariants: read Set<String>, pureFns: read Set<String>, allFns: read Set<String>, declared: read Set<String>) -> Bool {
    if name == "Some" || name == "Ok" || name == "Err" || name == "None" { return false }
    if is_builtin_type(name: read name) || is_stdlib_type(name: read name) || Set.contains<String>(set: read declared, value: read name) { return false }
    if Set.contains<String>(set: read sumVariants, value: read name) { return false }
    if Set.contains<String>(set: read pureFns, value: read name) { return false }
    if Set.contains<String>(set: read allFns, value: read name) { return true }
    return false
}

// Scan a pure fn body [bodyOpen,bodyClose) for a `with`/`manage` or a non-pure call.
fn pure_body_bad(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, sumVariants: read Set<String>, pureFns: read Set<String>, allFns: read Set<String>, declared: read Set<String>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        let t = tk_text(toks: read toks, i: read k)
        if t == "with" {
            hit = true
        } else if t == "manage" {
            hit = true
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && tk_kind(toks: read toks, i: read (k - 1)) == TOK_IDENT {
            let name = tk_text(toks: read toks, i: read (k - 1))
            let qualified = at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (k - 3))
            if qualified {
                let mut root = k - 3
                let mut walking = true
                while walking {
                    if at_symbol(toks: read toks, i: read (root - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (root - 2)) {
                        root = root - 2
                    } else {
                        walking = false
                    }
                }
                if qualified_call_allowed(name: read tk_text(toks: read toks, i: read root), declared: read declared) == false { hit = true }
            } else {
                if unqual_call_bad(name: read name, sumVariants: read sumVariants, pureFns: read pureFns, allFns: read allFns, declared: read declared) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0009: a `pure` fn that returns a resource, has a mut/take param, retains a
// param, or whose body uses `with`/`manage`/a non-pure call.
fn fn_pure_bad(toks: read List<Tok>, start: read Int, resources: read Set<String>, sumVariants: read Set<String>, pureFns: read Set<String>, allFns: read Set<String>, declared: read Set<String>) -> Bool {
    if fn_is_pure(toks: read toks, start: read start) == false { return false }
    let mut bad = false
    if fn_pure_resource_return(toks: read toks, start: read start, resources: read resources) { bad = true }
    if fn_has_mut_take_param(toks: read toks, start: read start) { bad = true }
    if fn_has_retains(toks: read toks, start: read start) { bad = true }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) {
        let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if bodyClose >= 0 {
            if pure_body_bad(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, sumVariants: read sumVariants, pureFns: read pureFns, allFns: read allFns, declared: read declared) { bad = true }
        }
    }
    return bad
}

// Pre-pass filling RS0009 lookup sets: user resource type names, sum variant
// names, pure fn (simple) names, and all fn (simple) names.
fn collect_rs0009(toks: read List<Tok>, resources: mut Set<String>, sumVariants: mut Set<String>, pureFns: mut Set<String>, allFns: mut Set<String>, noBlockFns: mut Set<String>, noPanicFns: mut Set<String>, asyncFns: mut Set<String>) -> Unit {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks: read toks, i: read i)
                    if at_ident(toks: read toks, i: read (nameIdx - 1), wid: read WORD_RESOURCE) {
                        Set.insert<String>(set: mut resources, value: read dotted_name_text(toks: read toks, i: read nameIdx))
                    }
                    i = r
                }
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        let mut k = ob + 1
                        let mut depth = 0
                        while k < (r - 1) {
                            if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
                                depth = depth + 1
                            } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
                                if depth > 0 { depth = depth - 1 }
                            } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) {
                                Set.insert<String>(set: mut sumVariants, value: read tk_text(toks: read toks, i: read k))
                            }
                            k = k + 1
                        }
                    }
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = fn_name_start(toks: read toks, i: read i)
                    if at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT) == false {
                        let fname = tk_text(toks: read toks, i: read nameIdx)
                        Set.insert<String>(set: mut allFns, value: read fname)
                        if fn_is_pure(toks: read toks, start: read i) {
                            Set.insert<String>(set: mut pureFns, value: read fname)
                        }
                        if fn_has_named_effect(toks: read toks, start: read i, effName: read "no_block") {
                            Set.insert<String>(set: mut noBlockFns, value: read fname)
                        }
                        if fn_has_named_effect(toks: read toks, start: read i, effName: read "no_panic") {
                            Set.insert<String>(set: mut noPanicFns, value: read fname)
                        }
                        if fn_is_async(toks: read toks, start: read i) {
                            Set.insert<String>(set: mut asyncFns, value: read fname)
                        }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return Unit
}

// ---------------------------------------------------------------------------
// RS0008 MISSING_PARAMETER_EFFECT.
// ---------------------------------------------------------------------------

// Does any token in [s,e) have the given identifier text?
fn region_has_text(toks: read List<Tok>, s: read Int, e: read Int, word: read String) -> Bool {
    let mut k = s
    let mut hit = false
    while k < e {
        if tk_text(toks: read toks, i: read k) == word { hit = true }
        k = k + 1
    }
    return hit
}

// Pre-pass: user `sum` names whose EVERY variant is payloadless (no `(...)`).
fn collect_payloadless_sums(toks: read List<Tok>) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut sums = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = sum_name_start(toks: read toks, i: read i)
                    let name = dotted_name_text(toks: read toks, i: read ns)
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        if region_has_paren(toks: read toks, s: read (ob + 1), e: read (r - 1)) == false {
                            Set.insert<String>(set: mut sums, value: read name)
                        }
                    }
                    i = r
                }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return sums
}

// Any `(` token in [s,e)?
fn region_has_paren(toks: read List<Tok>, s: read Int, e: read Int) -> Bool {
    let mut k = s
    let mut hit = false
    while k < e {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) { hit = true }
        k = k + 1
    }
    return hit
}

// One param segment: RS0008 iff no data-effect and the type demands one.
fn param_seg_missing_effect(toks: read List<Tok>, segStart: read Int, segEnd: read Int, sums: read Set<String>) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return false }
    let typeStart = segStart + 2
    if is_effect_kw(toks: read toks, i: read typeStart) { return false }
    // Type region ends at the first top-level `=` (default), else the segment end.
    let mut typeEnd = segEnd
    let mut k = typeStart
    let mut depth = 0
    let mut found = false
    while k < segEnd && found == false {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_EQ) {
            typeEnd = k
            found = true
        }
        k = k + 1
    }
    // Base name: skip surface-ref `&`, prefixes and (defensive) data effects.
    let mut p = typeStart
    let mut sawFresh = false
    let mut sawNoOwn = false
    let mut going = true
    while going {
        let t = tk_text(toks: read toks, i: read p)
        if p < typeEnd && t == "fresh" {
            sawFresh = true
            p = p + 1
        } else if p < typeEnd && (t == "noescape" || t == "owned") {
            sawNoOwn = true
            p = p + 1
        } else if p < typeEnd && (t == "handle" || t == "weak" || t == "&" || t == "read" || t == "mut" || t == "take") {
            p = p + 1
        } else {
            going = false
        }
    }
    if p >= typeEnd { return false }
    let base = tk_text(toks: read toks, i: read p)
    if base == "share" { return false }
    let hasArgs = at_symbol(toks: read toks, i: read dotted_end(toks: read toks, i: read p), code: read SYM_LANGLE)
    // NOT noescape / owned anywhere in the type region.
    if region_has_text(toks: read toks, s: read typeStart, e: read typeEnd, word: read "noescape") { return false }
    if region_has_text(toks: read toks, s: read typeStart, e: read typeEnd, word: read "owned") { return false }
    // NOT bare `Closure` (no args).
    if base == "Closure" && hasArgs == false { return false }
    // NOT a surface reference (`&` anywhere in the segment).
    if region_has_text(toks: read toks, s: read segStart, e: read segEnd, word: read "&") { return false }
    // NOT containing type name `Fd` anywhere in the type region.
    if region_has_text(toks: read toks, s: read typeStart, e: read typeEnd, word: read "Fd") { return false }
    // NOT a Copy scalar (base ∈ scalars, no generic args).
    if is_scalar_name(name: read base) && hasArgs == false { return false }
    // NOT a bare payload-less sum.
    if hasArgs == false && sawFresh == false && sawNoOwn == false && Set.contains<String>(set: read sums, value: read base) { return false }
    return true
}

// RS0008: any parameter of the fn that must declare an effect but doesn't.
fn fn_missing_param_effect(toks: read List<Tok>, start: read Int, sums: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if param_seg_missing_effect(toks: read toks, segStart: read segStart, segEnd: read k, sums: read sums) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if param_seg_missing_effect(toks: read toks, segStart: read segStart, segEnd: read close, sums: read sums) { hit = true }
    return hit
}

// ---------------------------------------------------------------------------
// RS0024 UNKNOWN_TYPE.
// ---------------------------------------------------------------------------

// The hardcoded builtin nominal type set (mirror check_unknown_types).
fn is_builtin_type(name: read String) -> Bool {
    return name == "Unit" || name == "Bool" || name == "Byte" || name == "Char" || name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Float" || name == "Float32" || name == "Float64" || name == "String" || name == "StringView" || name == "Url" || name == "Fd" || name == "Bytes" || name == "BytesView" || name == "Buffer" || name == "BufferView" || name == "Path" || name == "Result" || name == "Option" || name == "List" || name == "Map" || name == "Set" || name == "Capability" || name == "Fn" || name == "Closure" || name == "Cache" || name == "FileError" || name == "IOError" || name == "HttpError" || name == "ConfigError" || name == "DbError" || name == "ImageError" || name == "JsonError" || name == "CsvError" || name == "NetworkError"
}

// Nominal types the analyzer preloads from the stdlib/package `.rssi` interfaces
// (every `struct`/`resource` Item::Type across CORE + STANDARD package interfaces).
// These live in hir.type_info and so count as known types for RS0024.
fn is_stdlib_type(name: read String) -> Bool {
    return name == "CancellationSource" || name == "CancellationToken" || name == "Channel" || name == "ChannelError" || name == "Config" || name == "ConfigStore" || name == "ConfigValue" || name == "Counter" || name == "DbConnection" || name == "Deadline" || name == "DecodeError" || name == "Deque" || name == "Duration" || name == "Environment" || name == "FalliblePipeline" || name == "File" || name == "FileMetadata" || name == "FunctionObject" || name == "GlobalConfig" || name == "HttpRequest" || name == "HttpResponse" || name == "Image" || name == "Instant" || name == "JsonLiteral" || name == "JsonValue" || name == "Metal" || name == "PersistentMap" || name == "Pipeline" || name == "PoolError" || name == "PoolStats" || name == "ProcessEnv" || name == "ProcessEvent" || name == "ProcessOutput" || name == "ProcessRequest" || name == "Receiver" || name == "Regex" || name == "RegexError" || name == "Request" || name == "ResourcePool" || name == "Response" || name == "Row" || name == "RowBuffer" || name == "Rule" || name == "Sender" || name == "SortedMap" || name == "SortedSet" || name == "Stream" || name == "StringBuilder" || name == "TcpError" || name == "TcpStream" || name == "TempDir" || name == "Tensor" || name == "TensorError" || name == "TimerError" || name == "WebSocket" || name == "WebSocketError"
}

// Index just past a dotted ident sequence starting at i (i must be an ident).
fn dotted_end(toks: read List<Tok>, i: read Int) -> Int {
    if is_ident_tok(toks: read toks, i: read i) == false { return i }
    let mut j = i + 1
    let mut going = true
    while going {
        if at_symbol(toks: read toks, i: read j, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (j + 1)) {
            j = j + 2
        } else {
            going = false
        }
    }
    return j
}

// Generic-param names in scope for an item whose `<...>` clause opens at nameEnd
// (or an empty set if none). First ident of each top-level comma segment.
fn collect_generics(toks: read List<Tok>, nameEnd: read Int) -> Set<String> {
    let mut g = Set<String>.new()
    if at_symbol(toks: read toks, i: read nameEnd, code: read SYM_LANGLE) == false { return g }
    let close = find_matching(toks: read toks, open: read nameEnd, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 { return g }
    let mut k = nameEnd + 1
    let mut depth = 0
    let mut segStart = nameEnd + 1
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if is_ident_tok(toks: read toks, i: read segStart) {
                Set.insert<String>(set: mut g, value: read tk_text(toks: read toks, i: read segStart))
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if is_ident_tok(toks: read toks, i: read segStart) {
        Set.insert<String>(set: mut g, value: read tk_text(toks: read toks, i: read segStart))
    }
    return g
}

// True if any TypeRef in the comma-separated argument region [s,e) is unknown.
fn args_have_unknown(toks: read List<Tok>, s: read Int, e: read Int, generics: read Set<String>, declared: read Set<String>) -> Bool {
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut unknown = false
    while k < e {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if type_ref_has_unknown(toks: read toks, s: read segStart, e: read k, generics: read generics, declared: read declared) { unknown = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if type_ref_has_unknown(toks: read toks, s: read segStart, e: read e, generics: read generics, declared: read declared) { unknown = true }
    return unknown
}

// Validate one TypeRef region [s,e): unknown base, or unknown nested arg / Fn part.
fn type_ref_has_unknown(toks: read List<Tok>, s: read Int, e: read Int, generics: read Set<String>, declared: read Set<String>) -> Bool {
    let mut p = s
    let mut going = true
    while going {
        let t = tk_text(toks: read toks, i: read p)
        if p < e && (t == "fresh" || t == "noescape" || t == "owned" || t == "handle" || t == "weak" || t == "&" || t == "read" || t == "mut" || t == "take") {
            p = p + 1
        } else {
            going = false
        }
    }
    if p >= e { return false }
    if is_ident_tok(toks: read toks, i: read p) == false { return false }
    let base = dotted_name_text(toks: read toks, i: read p)
    let after = dotted_end(toks: read toks, i: read p)
    let mut unknown = false
    // Capability is treated as always-known and its protocol arg is not recursed.
    if base == "Capability" {
        return false
    }
    let known = Set.contains<String>(set: read generics, value: read base) || is_builtin_type(name: read base) || is_stdlib_type(name: read base) || Set.contains<String>(set: read declared, value: read base)
    if known == false { unknown = true }
    if at_symbol(toks: read toks, i: read after, code: read SYM_LANGLE) {
        let close = find_matching(toks: read toks, open: read after, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if close >= 0 {
            if args_have_unknown(toks: read toks, s: read (after + 1), e: read close, generics: read generics, declared: read declared) { unknown = true }
        }
    } else if base == "Fn" && at_symbol(toks: read toks, i: read after, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read after, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close >= 0 {
            if args_have_unknown(toks: read toks, s: read (after + 1), e: read close, generics: read generics, declared: read declared) { unknown = true }
            if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) {
                if type_ref_has_unknown(toks: read toks, s: read (close + 2), e: read e, generics: read generics, declared: read declared) { unknown = true }
            }
        }
    }
    return unknown
}

// RS0024 over a type decl [i,r): every FIELD type. generics = the type's params.
fn type_decl_unknown(toks: read List<Tok>, i: read Int, r: read Int, declared: read Set<String>) -> Bool {
    let ns = type_name_start(toks: read toks, i: read i)
    let nameEnd = dotted_end(toks: read toks, i: read ns)
    let generics = collect_generics(toks: read toks, nameEnd: read nameEnd)
    let ob = find_body_open(toks: read toks, i: read i, end: read r)
    if ob < 0 { return false }
    let close = r - 1
    let mut k = ob + 1
    let mut paren = 0
    let mut br = 0
    let mut ang = 0
    let mut brace = 0
    let mut unknown = false
    while k < close {
        let isColon = at_symbol(toks: read toks, i: read k, code: read SYM_COLON)
        let atTop = paren == 0 && br == 0 && ang == 0 && brace == 0
        if isColon && atTop && is_ident_tok(toks: read toks, i: read (k - 1)) {
            if type_ref_has_unknown(toks: read toks, s: read (k + 1), e: read close, generics: read generics, declared: read declared) { unknown = true }
        }
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            br = br + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            if br > 0 { br = br - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if ang > 0 { ang = ang - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            if brace > 0 { brace = brace - 1 }
        }
        k = k + 1
    }
    return unknown
}

// RS0024 over a fn: every PARAM type and the RETURN type. generics = fn's params.
fn fn_types_unknown(toks: read List<Tok>, start: read Int, declared: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let nameEnd = dotted_end(toks: read toks, i: read ns)
    let generics = collect_generics(toks: read toks, nameEnd: read nameEnd)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut unknown = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if param_seg_type_unknown(toks: read toks, segStart: read segStart, segEnd: read k, generics: read generics, declared: read declared) { unknown = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if param_seg_type_unknown(toks: read toks, segStart: read segStart, segEnd: read close, generics: read generics, declared: read declared) { unknown = true }
    // Return type: after the param-list close, an optional `-> Type` before
    // `effects`/`{`/`=` (mirror parse_function_decl's return-type scan).
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) {
        let rs = close + 2
        let mut re = rs
        let mut scanning = true
        while scanning {
            let stop = at_ident(toks: read toks, i: read re, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read re, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read re, code: read SYM_EQ)
            if re < sigEnd && stop == false {
                re = re + 1
            } else {
                scanning = false
            }
        }
        if type_ref_has_unknown(toks: read toks, s: read rs, e: read re, generics: read generics, declared: read declared) { unknown = true }
    }
    return unknown
}

// One param segment's type region → unknown? Type starts after `name :` and an
// optional data-effect; runs to the segment end.
fn param_seg_type_unknown(toks: read List<Tok>, segStart: read Int, segEnd: read Int, generics: read Set<String>, declared: read Set<String>) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return false }
    let mut ts = segStart + 2
    if is_effect_kw(toks: read toks, i: read ts) { ts = ts + 1 }
    return type_ref_has_unknown(toks: read toks, s: read ts, e: read segEnd, generics: read generics, declared: read declared)
}

// Pre-pass: names of all declared nominal types (struct/class/resource/opaque/
// sum/type-alias LHS). Protocols are NOT included. Mirrors the main dispatch.
fn collect_declared_types(toks: read List<Tok>) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut declared = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = type_name_start(toks: read toks, i: read i)
                    Set.insert<String>(set: mut declared, value: read dotted_name_text(toks: read toks, i: read ns))
                    i = r
                }
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = sum_name_start(toks: read toks, i: read i)
                    Set.insert<String>(set: mut declared, value: read dotted_name_text(toks: read toks, i: read ns))
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let mut ns = i
                    if isPub { ns = ns + 1 }
                    ns = ns + 1
                    Set.insert<String>(set: mut declared, value: read dotted_name_text(toks: read toks, i: read ns))
                    i = r
                }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return declared
}

// ---------------------------------------------------------------------------
// RS0021 NON_EXHAUSTIVE_MATCH.
//
// A `match SCRUT { arm... }` (statement or expression form) is non-exhaustive
// unless it covers its scrutinee type: Some/None (Option), Ok/Err (Result),
// true/false (Bool), every variant of a declared sum, or an irrefutable pattern
// for a single-constructor tuple/struct — or it contains a `_` wildcard. Only
// GUARDLESS arms contribute coverage; malformed arms (no `=>`) contribute none.
// Ported from crate::analyzer::exhaustiveness (simplified for the corpus).
// ---------------------------------------------------------------------------

// True if token i is the keyword/ident with the given text (copied from astdump).
fn is_kw_text(toks: read List<Tok>, i: read Int, word: read String) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) == false { return false }
    return tk_text(toks: read toks, i: read i) == word
}

// First top-level symbol `code` in [start,end) (depth over ()[]{}) — from astdump.
fn find_top_sym(toks: read List<Tok>, start: read Int, end: read Int, code: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read code) {
            return i
        }
        i = i + 1
    }
    return -1
}

// First top-level `if` keyword in [start,end) — from astdump.
fn find_top_if(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks: read toks, i: read i, word: read "if") {
            return i
        }
        i = i + 1
    }
    return -1
}

// First top-level `{` after the scrutinee (paren/bracket depth 0), or -1. Mirrors
// find_match_expr_arms_open (angle brackets are not tracked).
fn find_match_arms_open(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut paren = 0
    let mut br = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            br = br + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if br > 0 { br = br - 1 }
        } else if paren == 0 && br == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Collect the head ident of each variant in a sum body [ob+1, close) into `out`.
// Variant heads are the idents at paren/angle/brace depth 0 (payload fields sit
// inside `(...)`/`{...}` so they are excluded).
fn collect_variant_heads(toks: read List<Tok>, ob: read Int, close: read Int, out: mut Set<String>) -> Unit {
    let mut k = ob + 1
    let mut paren = 0
    let mut ang = 0
    let mut brace = 0
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if ang > 0 { ang = ang - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            if brace > 0 { brace = brace - 1 }
        } else if paren == 0 && ang == 0 && brace == 0 && is_ident_tok(toks: read toks, i: read k) {
            Set.insert<String>(set: mut out, value: read tk_text(toks: read toks, i: read k))
        }
        k = k + 1
    }
    return Unit
}

// True if the `sum` keyword at i heads a real top-level sum DECL (not a variable
// named `sum`): a name ident follows on the same line, and the `sum` starts a
// line or is preceded by `pub`. The tokenizer tags every `sum` text with
// WORD_SUM, so this guard is what separates `sum Color { … }` from `sum = …`.
fn real_sum_at(toks: read List<Tok>, i: read Int) -> Bool {
    if at_ident(toks: read toks, i: read i, wid: read WORD_SUM) == false { return false }
    if is_ident_tok(toks: read toks, i: read (i + 1)) == false { return false }
    if tk_line(toks: read toks, i: read (i + 1)) != tk_line(toks: read toks, i: read i) { return false }
    if i == 0 { return true }
    if tk_line(toks: read toks, i: read (i - 1)) < tk_line(toks: read toks, i: read i) { return true }
    return at_ident(toks: read toks, i: read (i - 1), wid: read WORD_PUB)
}

// The variant-name set of the declared `sum sumName` (empty if there is no such
// sum). A non-sum root therefore yields an empty set.
fn sum_variants_of(toks: read List<Tok>, sumName: read String) -> Set<String> {
    let n = List.len(list: read toks)
    let mut out = Set<String>.new()
    if String.len(value: read sumName) == 0 { return out }
    let mut i = 0
    let mut done = false
    while i < n && done == false {
        if real_sum_at(toks: read toks, i: read i) {
            let name = dotted_name_text(toks: read toks, i: read (i + 1))
            if name == sumName {
                let ob = find_body_open(toks: read toks, i: read (i + 1), end: read n)
                if ob >= 0 {
                    let close = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if close >= 0 {
                        collect_variant_heads(toks: read toks, ob: read ob, close: read close, out: mut out)
                    }
                }
                done = true
            }
        }
        i = i + 1
    }
    return out
}

// The declared sum that owns variant `vname`, or "" if none.
fn variant_owner(toks: read List<Tok>, vname: read String) -> String {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut result = ""
    let mut done = false
    while i < n && done == false {
        if real_sum_at(toks: read toks, i: read i) {
            let sname = dotted_name_text(toks: read toks, i: read (i + 1))
            let ob = find_body_open(toks: read toks, i: read (i + 1), end: read n)
            if ob >= 0 {
                let close = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if close >= 0 {
                    let mut heads = Set<String>.new()
                    collect_variant_heads(toks: read toks, ob: read ob, close: read close, out: mut heads)
                    if Set.contains<String>(set: read heads, value: read vname) {
                        result = sname
                        done = true
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

// Root of a TypeRef region [s,e): tuple `(...)` → "__Tuple", else the base
// (possibly dotted) name after skipping data-effects/reference prefixes; "" if
// the region has no nominal head.
fn type_region_root(toks: read List<Tok>, s: read Int, e: read Int) -> String {
    let p = skip_type_prefixes(toks: read toks, s: read s, e: read e)
    if p >= e { return "" }
    if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) { return "__Tuple" }
    if is_ident_tok(toks: read toks, i: read p) == false { return "" }
    return dotted_name_text(toks: read toks, i: read p)
}

// Return-type root of the fn whose keyword sits at `fnkw` (the `-> RET` head).
fn return_type_root_at(toks: read List<Tok>, fnkw: read Int) -> String {
    let sigEnd = function_signature_end(toks: read toks, start: read fnkw)
    let open = find_param_open(toks: read toks, from: read fnkw, end: read sigEnd)
    if open < 0 { return "" }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return "" }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return "" }
    let rs = close + 2
    let mut re = rs
    let mut scanning = true
    while scanning {
        let stop = at_ident(toks: read toks, i: read re, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read re, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read re, code: read SYM_EQ)
        if re < sigEnd && stop == false {
            re = re + 1
        } else {
            scanning = false
        }
    }
    return type_region_root(toks: read toks, s: read rs, e: read re)
}

// Return-type root of the first unqualified `fn fnName(...)` in the file, or "".
fn fn_return_root(toks: read List<Tok>, fnName: read String) -> String {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut result = ""
    let mut done = false
    while i < n && done == false {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let nameIdx = i + 1
            let named = is_ident_tok(toks: read toks, i: read nameIdx) && tk_text(toks: read toks, i: read nameIdx) == fnName
            if named && at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT) == false {
                result = return_type_root_at(toks: read toks, fnkw: read i)
                done = true
            }
        }
        i = i + 1
    }
    return result
}

// Type root of param `name` in the param list [open,close], or "" if absent.
fn param_type_root(toks: read List<Tok>, open: read Int, close: read Int, name: read String) -> String {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut result = ""
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_name_matches(toks: read toks, segStart: read segStart, name: read name) {
                result = type_region_root(toks: read toks, s: read (segStart + 2), e: read k)
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_name_matches(toks: read toks, segStart: read segStart, name: read name) {
        result = type_region_root(toks: read toks, s: read (segStart + 2), e: read close)
    }
    return result
}

// Full canonical type string of the param named `name` (effect read/mut/take
// stripped; noescape/owned/fresh kept), or "" if not found. Used by the RS0208
// engine to type a bare-ident return whose value is a parameter.
fn param_type_string(toks: read List<Tok>, open: read Int, close: read Int, name: read String) -> String {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut result = ""
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_name_matches(toks: read toks, segStart: read segStart, name: read name) {
                let mut t = segStart + 2
                if is_effect_kw(toks: read toks, i: read t) { t = t + 1 }
                result = type_token_string(toks: read toks, ts: read t, te: read k)
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_name_matches(toks: read toks, segStart: read segStart, name: read name) {
        let mut t2 = segStart + 2
        if is_effect_kw(toks: read toks, i: read t2) { t2 = t2 + 1 }
        result = type_token_string(toks: read toks, ts: read t2, te: read close)
    }
    return result
}

// A param segment starts with `name :`.
fn seg_name_matches(toks: read List<Tok>, segStart: read Int, name: read String) -> Bool {
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if tk_text(toks: read toks, i: read segStart) != name { return false }
    return at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON)
}

// Root of the scrutinee expression region [s,e) (expr_root in the spec).
fn expr_root(toks: read List<Tok>, s0: read Int, e: read Int, declared: read Set<String>, allFns: read Set<String>) -> String {
    let mut s = s0
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if s >= e { return "" }
    if is_ident_tok(toks: read toks, i: read s) == false {
        let k = tk_kind(toks: read toks, i: read s)
        if k == TOK_STRING { return "String" }
        if k == TOK_NUMBER { return "Int" }
        if k == TOK_CHAR { return "Char" }
        return ""
    }
    let t = tk_text(toks: read toks, i: read s)
    if t == "Some" || t == "None" { return "Option" }
    if t == "Ok" || t == "Err" { return "Result" }
    if t == "true" || t == "false" { return "Bool" }
    let after = dotted_end(toks: read toks, i: read s)
    if after > (s + 1) { return "" }
    let owner = variant_owner(toks: read toks, vname: read t)
    if String.len(value: read owner) > 0 { return owner }
    if at_symbol(toks: read toks, i: read after, code: read SYM_LPAREN) {
        if Set.contains<String>(set: read allFns, value: read t) {
            return fn_return_root(toks: read toks, fnName: read t)
        }
        if Set.contains<String>(set: read declared, value: read t) { return t }
        return ""
    }
    return ""
}

// RHS start index (`=`+1) of the nearest preceding `let/local [mut] name = …`
// before matchPos in the body, or -1.
fn find_let_rhs_start(toks: read List<Tok>, bodyOpen: read Int, matchPos: read Int, name: read String) -> Int {
    let mut k = bodyOpen + 1
    let mut best = -1
    while k < matchPos {
        let isLet = is_kw_text(toks: read toks, i: read k, word: read "let") || is_kw_text(toks: read toks, i: read k, word: read "local")
        if isLet {
            let mut j = k + 1
            if is_kw_text(toks: read toks, i: read j, word: read "mut") { j = j + 1 }
            if is_ident_tok(toks: read toks, i: read j) && tk_text(toks: read toks, i: read j) == name {
                let stmtEnd = next_line_or_block_end(toks: read toks, start: read k, end: read matchPos)
                let eq = find_top_sym(toks: read toks, start: read j, end: read stmtEnd, code: read SYM_EQ)
                if eq >= 0 { best = eq + 1 }
            }
        }
        k = k + 1
    }
    return best
}

// Scrutinee type root (spec's scrutinee inference).
fn scrutinee_root(toks: read List<Tok>, s0: read Int, e: read Int, bodyOpen: read Int, matchPos: read Int, popen: read Int, pclose: read Int, declared: read Set<String>, allFns: read Set<String>) -> String {
    // A `?`-terminated scrutinee (`maybe()?`) matches the UNWRAPPED payload type,
    // which we do not track — treat as unknown so the arms drive the fallback.
    if e > 0 && at_symbol(toks: read toks, i: read (e - 1), code: read SYM_QUESTION) {
        return ""
    }
    let mut s = s0
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if (s + 1) == e && is_ident_tok(toks: read toks, i: read s) {
        let name = tk_text(toks: read toks, i: read s)
        let lr = find_let_rhs_start(toks: read toks, bodyOpen: read bodyOpen, matchPos: read matchPos, name: read name)
        if lr >= 0 {
            let re = next_line_or_block_end(toks: read toks, start: read lr, end: read matchPos)
            return expr_root(toks: read toks, s0: read lr, e: read re, declared: read declared, allFns: read allFns)
        }
        if popen >= 0 && pclose >= 0 {
            let pr = param_type_root(toks: read toks, open: read popen, close: read pclose, name: read name)
            if String.len(value: read pr) > 0 { return pr }
        }
        // Not a let-bound local or a typed param: fall through so a bare value
        // literal scrutinee (`true`, `None`, …) still resolves via expr_root.
        return expr_root(toks: read toks, s0: read s0, e: read e, declared: read declared, allFns: read allFns)
    }
    return expr_root(toks: read toks, s0: read s0, e: read e, declared: read declared, allFns: read allFns)
}

// A single-token payload/tuple element that is a binding (`name`) or `_`.
fn elem_is_binding(toks: read List<Tok>, s: read Int, e: read Int) -> Bool {
    if (s + 1) != e { return false }
    return is_ident_tok(toks: read toks, i: read s)
}

// Every top-level comma-separated element of [s,e) is a bare binding / `_`.
fn elems_all_bindings(toks: read List<Tok>, s: read Int, e: read Int) -> Bool {
    if s >= e { return true }
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut ok = true
    while k < e {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if elem_is_binding(toks: read toks, s: read segStart, e: read k) == false { ok = false }
            segStart = k + 1
        }
        k = k + 1
    }
    if elem_is_binding(toks: read toks, s: read segStart, e: read e) == false { ok = false }
    return ok
}

// True if the pattern [ps,pe) is irrefutable (a `_`, an all-binding tuple, a
// bare/empty-payload constructor, or a constructor whose every field binds).
fn pattern_irref(toks: read List<Tok>, ps: read Int, pe: read Int) -> Bool {
    if (ps + 1) == pe && tk_text(toks: read toks, i: read ps) == "_" { return true }
    if at_symbol(toks: read toks, i: read ps, code: read SYM_LPAREN) && at_symbol(toks: read toks, i: read (pe - 1), code: read SYM_RPAREN) {
        let close = find_matching(toks: read toks, open: read ps, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == (pe - 1) {
            return elems_all_bindings(toks: read toks, s: read (ps + 1), e: read close)
        }
    }
    if is_ident_tok(toks: read toks, i: read ps) {
        let after = dotted_end(toks: read toks, i: read ps)
        if after == pe { return true }
        if at_symbol(toks: read toks, i: read after, code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read after, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close == (pe - 1) {
                return elems_all_bindings(toks: read toks, s: read (after + 1), e: read close)
            }
            return false
        }
        if at_symbol(toks: read toks, i: read after, code: read SYM_LBRACE) {
            let close = find_matching(toks: read toks, open: read after, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if close == (pe - 1) {
                return elems_all_bindings(toks: read toks, s: read (after + 1), e: read close)
            }
            return false
        }
    }
    return false
}

// Classify one guardless pattern [ps,pe) into the running coverage sets.
fn classify_pattern(toks: read List<Tok>, ps: read Int, pe: read Int, variants: mut Set<String>, flags: mut Set<String>) -> Unit {
    let single = (ps + 1) == pe
    if single && tk_text(toks: read toks, i: read ps) == "_" {
        Set.insert<String>(set: mut flags, value: read "wild")
        return Unit
    }
    let k0 = tk_kind(toks: read toks, i: read ps)
    if single && (k0 == TOK_STRING || k0 == TOK_NUMBER || k0 == TOK_CHAR) {
        return Unit
    }
    if single && is_ident_tok(toks: read toks, i: read ps) && tk_text(toks: read toks, i: read ps) == "true" {
        Set.insert<String>(set: mut flags, value: read "true")
        return Unit
    }
    if single && is_ident_tok(toks: read toks, i: read ps) && tk_text(toks: read toks, i: read ps) == "false" {
        Set.insert<String>(set: mut flags, value: read "false")
        return Unit
    }
    if at_symbol(toks: read toks, i: read ps, code: read SYM_LBRACKET) && at_symbol(toks: read toks, i: read (pe - 1), code: read SYM_RBRACKET) {
        let close = find_matching(toks: read toks, open: read ps, openSym: read SYM_LBRACKET, closeSym: read SYM_RBRACKET)
        if close == (pe - 1) {
            classify_list_pattern(toks: read toks, s: read (ps + 1), e: read close, flags: mut flags)
            return Unit
        }
    }
    if is_ident_tok(toks: read toks, i: read ps) {
        let after = dotted_end(toks: read toks, i: read ps)
        Set.insert<String>(set: mut variants, value: read tk_text(toks: read toks, i: read (after - 1)))
    }
    if pattern_irref(toks: read toks, ps: read ps, pe: read pe) {
        Set.insert<String>(set: mut flags, value: read "irref")
    }
    return Unit
}

// A top-level list element [a,e) that is a rest binding (`..` or `..name`).
fn elem_is_rest(toks: read List<Tok>, a: read Int, e: read Int) -> Bool {
    if (a + 1) >= e { return false }
    return at_symbol(toks: read toks, i: read a, code: read SYM_DOT) && at_symbol(toks: read toks, i: read (a + 1), code: read SYM_DOT)
}

// Record a list slice pattern's shape into `flags`: "F<n>" for a fixed-length
// pattern of `n` elements, or "R<n>" for a rest pattern with `n` fixed elements.
fn classify_list_pattern(toks: read List<Tok>, s: read Int, e: read Int, flags: mut Set<String>) -> Unit {
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut count = 0
    let mut hasRest = false
    while k < e {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if elem_is_rest(toks: read toks, a: read segStart, e: read k) {
                hasRest = true
            } else {
                count = count + 1
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if segStart < e {
        if elem_is_rest(toks: read toks, a: read segStart, e: read e) {
            hasRest = true
        } else {
            count = count + 1
        }
    }
    let mut marker = "F"
    if hasRest { marker = "R" }
    Set.insert<String>(set: mut flags, value: read String.concat(left: read marker, right: read String.from_int(value: count)))
    return Unit
}

// True if the match with arms [braceOpen+1, braceClose) over scrutinee root `root`
// is NON-exhaustive.
fn match_is_non_exhaustive(toks: read List<Tok>, braceOpen: read Int, braceClose: read Int, root: read String, declared: read Set<String>, allFns: read Set<String>) -> Bool {
    let mut variants = Set<String>.new()
    let mut flags = Set<String>.new()
    let mut i = braceOpen + 1
    while i < braceClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) || at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read braceClose)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks: read toks, start: read i, end: read arrow)
                if ifPos < 0 {
                    classify_pattern(toks: read toks, ps: read i, pe: read arrow, variants: mut variants, flags: mut flags)
                }
                let bodyStart = arrow + 1
                if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                    let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if bclose < 0 { i = braceClose } else { i = bclose + 1 }
                } else {
                    let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read braceClose)
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    if Set.contains<String>(set: read flags, value: read "wild") { return false }
    if root == "Option" {
        let ok = Set.contains<String>(set: read variants, value: read "Some") && Set.contains<String>(set: read variants, value: read "None")
        return ok == false
    }
    if root == "Result" {
        let ok = Set.contains<String>(set: read variants, value: read "Ok") && Set.contains<String>(set: read variants, value: read "Err")
        return ok == false
    }
    if root == "Bool" {
        let ok = Set.contains<String>(set: read flags, value: read "true") && Set.contains<String>(set: read flags, value: read "false")
        return ok == false
    }
    if root == "__Tuple" {
        return Set.contains<String>(set: read flags, value: read "irref") == false
    }
    if root == "List" {
        // Exhaustive iff some rest pattern caps the open tail (min fixed count
        // `minRest`) AND every shorter length 0..minRest has a fixed-length arm.
        let mut minRest = -1
        let mut q = 0
        while q <= 32 {
            if minRest < 0 && Set.contains<String>(set: read flags, value: read String.concat(left: read "R", right: read String.from_int(value: q))) {
                minRest = q
            }
            q = q + 1
        }
        if minRest < 0 { return true }
        let mut covered = true
        let mut len = 0
        while len < minRest {
            if Set.contains<String>(set: read flags, value: read String.concat(left: read "F", right: read String.from_int(value: len))) == false {
                covered = false
            }
            len = len + 1
        }
        return covered == false
    }
    let sv = sum_variants_of(toks: read toks, sumName: read root)
    if Set.is_empty<String>(set: read sv) == false {
        return Set.is_subset<String>(left: read sv, right: read variants) == false
    }
    if String.len(value: read root) > 0 && Set.contains<String>(set: read declared, value: read root) {
        return Set.contains<String>(set: read flags, value: read "irref") == false
    }
    let fb = (Set.contains<String>(set: read variants, value: read "Some") && Set.contains<String>(set: read variants, value: read "None")) || (Set.contains<String>(set: read variants, value: read "Ok") && Set.contains<String>(set: read variants, value: read "Err"))
    return fb == false
}

// RS0021: any `match` inside the fn body [i,r) whose arms are non-exhaustive.
fn fn_has_nonexhaustive_match(toks: read List<Tok>, start: read Int, declared: read Set<String>, allFns: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let popen = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    let mut pclose = -1
    if popen >= 0 {
        pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        let isMatch = is_kw_text(toks: read toks, i: read k, word: read "match") && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) == false
        if isMatch {
            let braceOpen = find_match_arms_open(toks: read toks, start: read (k + 1), end: read bodyClose)
            if braceOpen >= 0 {
                let braceClose = find_matching(toks: read toks, open: read braceOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if braceClose >= 0 {
                    let root = scrutinee_root(toks: read toks, s0: read (k + 1), e: read braceOpen, bodyOpen: read sigEnd, matchPos: read k, popen: read popen, pclose: read pclose, declared: read declared, allFns: read allFns)
                    if match_is_non_exhaustive(toks: read toks, braceOpen: read braceOpen, braceClose: read braceClose, root: read root, declared: read declared, allFns: read allFns) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0029 AWAIT_OUTSIDE_ASYNC.
//
// An `await` expression in a function that is not `async` (check_await_placement,
// async_context = function_is_async || in_task_group). Token-level: a non-async
// top-level fn whose body has an `await` keyword and no `async let` (task_group)
// binding suppressing it. Awaits are always checked non-async inside closures, so
// over-suppressing on any `async` token in the body is safe for the corpus.
// ---------------------------------------------------------------------------

// True if the fn decl at `start` carries the `async` modifier (a WORD_ASYNC
// keyword between the decl start / attributes and the `fn` keyword at ns-1).
fn fn_is_async(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let mut k = start
    let mut hit = false
    while k < (ns - 1) {
        if at_ident(toks: read toks, i: read k, wid: read WORD_ASYNC) { hit = true }
        k = k + 1
    }
    return hit
}

// RS0029: a non-async fn body that contains an `await` keyword and no `async`
// (task_group `async let`) binding to make the await valid.
fn fn_has_bad_await(toks: read List<Tok>, start: read Int) -> Bool {
    if fn_is_async(toks: read toks, start: read start) { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hasAwait = false
    let mut suppress = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "await") { hasAwait = true }
        // `async let` (task_group) makes an await valid; `select` arm operations
        // are a structured await boundary; both suppress RS0029 for this fn.
        if at_ident(toks: read toks, i: read k, wid: read WORD_ASYNC) { suppress = true }
        if is_kw_text(toks: read toks, i: read k, word: read "select") { suppress = true }
        if is_kw_text(toks: read toks, i: read k, word: read "task_group") { suppress = true }
        k = k + 1
    }
    return hasAwait && suppress == false
}

// ---------------------------------------------------------------------------
// RS0023 FD_OUTSIDE_INTERNAL_BOUNDARY.
//
// `Fd` used in a param/return type of a non-native fn, or in a field type of a
// non-resource type decl (check_fd_surface, type_ref_contains_name(ty, "Fd")).
// Native fns and resource types are the trusted internal boundary and skipped.
// ---------------------------------------------------------------------------

// True if the fn decl at `start` carries the `native` modifier.
fn fn_is_native(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let mut k = start
    let mut hit = false
    while k < (ns - 1) {
        if at_ident(toks: read toks, i: read k, wid: read WORD_NATIVE) { hit = true }
        k = k + 1
    }
    return hit
}

// RS0023 over a non-native fn: any param type or the return type names `Fd`.
fn fn_has_fd_surface(toks: read List<Tok>, start: read Int) -> Bool {
    if fn_is_native(toks: read toks, start: read start) { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_type_has_fd(toks: read toks, segStart: read segStart, segEnd: read k) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_type_has_fd(toks: read toks, segStart: read segStart, segEnd: read close) { hit = true }
    // Return type region: `-> Type` before effects/`{`/`=`.
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) {
        let rs = close + 2
        let mut re = rs
        let mut scanning = true
        while scanning {
            let stop = at_ident(toks: read toks, i: read re, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read re, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read re, code: read SYM_EQ)
            if re < sigEnd && stop == false {
                re = re + 1
            } else {
                scanning = false
            }
        }
        if region_has_text(toks: read toks, s: read rs, e: read re, word: read "Fd") { hit = true }
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0022 ASYNC_CALL_NOT_CONSUMED (signature-table decidable).
//
// A call whose callee resolves to a same-file `async fn` must be consumed: it is
// the direct operand of `await` or `spawn`, or the RHS of an `async let` binding.
// A bare/`let`-bound async call is unconsumed (check_async_call_consumed). Only
// same-file async fns register a signature; stdlib/native fns are never async, so
// qualified/receiver calls (`Ns.method(...)`) never resolve to an async signature
// and are skipped. Consumption threads through the AST, but the corpus only ever
// consumes an async call as the immediate `await`/`spawn` operand or `async let`
// RHS, so a token-adjacency probe is exact here.
// ---------------------------------------------------------------------------

fn has_unconsumed_async_call(toks: read List<Tok>, asyncFns: read Set<String>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        let isCall = is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN)
        if isCall && Set.contains<String>(set: read asyncFns, value: read tk_text(toks: read toks, i: read i)) {
            // A method call (`x.name(...)`) or the fn's own declaration (`fn name(`)
            // is not a resolvable unqualified async call site.
            let prevDot = at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT)
            let prevFn = at_ident(toks: read toks, i: read (i - 1), wid: read WORD_FN)
            if prevDot == false && prevFn == false {
                let awaited = is_kw_text(toks: read toks, i: read (i - 1), word: read "await")
                let spawned = is_kw_text(toks: read toks, i: read (i - 1), word: read "spawn")
                let asyncLet = at_symbol(toks: read toks, i: read (i - 1), code: read SYM_EQ) && is_kw_text(toks: read toks, i: read (i - 3), word: read "let") && at_ident(toks: read toks, i: read (i - 4), wid: read WORD_ASYNC)
                if awaited == false && spawned == false && asyncLet == false {
                    hit = true
                }
            }
        }
        i = i + 1
    }
    return hit
}

// A param segment's type region [segStart+2, segEnd) names `Fd`.
fn seg_type_has_fd(toks: read List<Tok>, segStart: read Int, segEnd: read Int) -> Bool {
    if (segStart + 2) >= segEnd { return false }
    if is_ident_tok(toks: read toks, i: read segStart) == false { return false }
    if at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_COLON) == false { return false }
    return region_has_text(toks: read toks, s: read (segStart + 2), e: read segEnd, word: read "Fd")
}

// ---------------------------------------------------------------------------
// RS0035 LOWER_NAME_CONFLICT.
//
// A `#lower_name("x")` pin that is not a valid Rust identifier, or two functions
// whose lowered backend names collide with at least one pinned. The default
// lowered name flattens dotted names (`.`->`_`) and raw-escapes Rust keywords
// (`gen`->`r#gen`); a pin overrides it. Mirrors check_lowered_name_conflicts.
// ---------------------------------------------------------------------------

// The Rust (strict + reserved) keyword set (rust_lower::is_rust_keyword).
fn is_rust_keyword(name: read String) -> Bool {
    return name == "abstract" || name == "as" || name == "async" || name == "await" || name == "become" || name == "box" || name == "break" || name == "const" || name == "continue" || name == "crate" || name == "do" || name == "dyn" || name == "else" || name == "enum" || name == "extern" || name == "false" || name == "final" || name == "fn" || name == "for" || name == "gen" || name == "if" || name == "impl" || name == "in" || name == "let" || name == "loop" || name == "macro" || name == "match" || name == "mod" || name == "move" || name == "mut" || name == "override" || name == "priv" || name == "pub" || name == "ref" || name == "return" || name == "self" || name == "Self" || name == "static" || name == "struct" || name == "super" || name == "trait" || name == "true" || name == "try" || name == "type" || name == "typeof" || name == "unsafe" || name == "unsized" || name == "use" || name == "virtual" || name == "where" || name == "while" || name == "yield"
}

// A valid Rust identifier: ASCII alpha/`_` first, ASCII alnum/`_` rest, and not a
// Rust keyword. Empty strings and any other character make a pin invalid.
fn is_valid_rust_ident(name: read String) -> Bool {
    let cs = String.chars(value: read name)
    let n = List.len(list: read cs)
    if n == 0 { return false }
    let f = Char.to_code(value: read List.get(list: read cs, index: read 0))
    let firstOk = (f >= 65 && f <= 90) || (f >= 97 && f <= 122) || f == 95
    if firstOk == false { return false }
    let mut i = 1
    let mut ok = true
    while i < n {
        let c = Char.to_code(value: read List.get(list: read cs, index: read i))
        let alnum = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
        if alnum == false { ok = false }
        i = i + 1
    }
    if ok == false { return false }
    return is_rust_keyword(name: read name) == false
}

// The default backend symbol name for a source fn name: dotted names flatten to
// `_`, then a Rust keyword is raw-escaped (`gen` -> `r#gen`).
fn default_lowered_name(name: read String) -> String {
    let cs = String.chars(value: read name)
    let n = List.len(list: read cs)
    let mut out = ""
    let mut i = 0
    while i < n {
        let ch = List.get(list: read cs, index: read i)
        if Char.to_code(value: read ch) == 46 {
            out = String.concat(left: read out, right: read "_")
        } else {
            out = String.concat(left: read out, right: read Char.to_string(value: read ch))
        }
        i = i + 1
    }
    if is_rust_keyword(name: read out) {
        return String.concat(left: read "r#", right: read out)
    }
    return out
}

// True if the fn decl at `start` carries a `#lower_name(...)` attribute (each
// attribute is `#name(arg)`, five tokens).
fn fn_has_lower_name(toks: read List<Tok>, start: read Int) -> Bool {
    let mut j = start
    let mut going = true
    let mut has = false
    while going {
        if at_symbol(toks: read toks, i: read j, code: read SYM_HASH) {
            if tk_text(toks: read toks, i: read (j + 1)) == "lower_name" {
                has = true
            }
            j = j + 5
        } else {
            going = false
        }
    }
    return has
}

// The `#lower_name("...")` pin string of a fn decl at `start`, or "" if none.
fn fn_lower_name_pin(toks: read List<Tok>, start: read Int) -> String {
    let mut j = start
    let mut going = true
    let mut pin = ""
    while going {
        if at_symbol(toks: read toks, i: read j, code: read SYM_HASH) {
            if tk_text(toks: read toks, i: read (j + 1)) == "lower_name" && at_symbol(toks: read toks, i: read (j + 2), code: read SYM_LPAREN) && tk_kind(toks: read toks, i: read (j + 3)) == TOK_STRING {
                pin = tk_text(toks: read toks, i: read (j + 3))
            }
            j = j + 5
        } else {
            going = false
        }
    }
    return pin
}

// ---------------------------------------------------------------------------
// RS0027 UNKNOWN_PROTOCOL.
//
// A generic protocol bound `<T: P>` naming a protocol P that is neither a special
// bound (`Managed`/`Struct`/`Resource`) nor visible. Visible protocols are the
// stdlib-interface protocols plus the file's own `protocol` decls. Mirrors
// check_protocol_bound over the exact 3-token `Ident : Ident` param form the
// parser accepts. (The Capability<P> and `impl P for T` paths have no fixtures.)
// ---------------------------------------------------------------------------

// Stdlib-interface protocols visible to every file (the `protocol` decls in the
// CORE/STANDARD `.rssi` interfaces).
fn is_stdlib_protocol(name: read String) -> Bool {
    return name == "Clone" || name == "Eq" || name == "Hashable" || name == "Ord"
}

// Pre-pass: names of all top-level `protocol` decls in the file.
fn collect_protocols(toks: read List<Tok>) -> Set<String> {
    let n = List.len(list: read toks)
    let mut out = Set<String>.new()
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) && is_ident_tok(toks: read toks, i: read (i + 1)) {
            let atStart = i == 0 || tk_line(toks: read toks, i: read (i - 1)) < tk_line(toks: read toks, i: read i) || at_ident(toks: read toks, i: read (i - 1), wid: read WORD_PUB)
            if atStart {
                Set.insert<String>(set: mut out, value: read dotted_name_text(toks: read toks, i: read (i + 1)))
            }
        }
        i = i + 1
    }
    return out
}

// A generic-param segment [s,e) is `Ident : Ident` (exactly three tokens) whose
// bound is a protocol that is neither special nor visible. Any other shape is
// unbounded or malformed (parse_generic_params) and carries no protocol bound.
fn bound_unknown_protocol(toks: read List<Tok>, s: read Int, e: read Int, protocols: read Set<String>) -> Bool {
    if (s + 3) != e { return false }
    if is_ident_tok(toks: read toks, i: read s) == false { return false }
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_COLON) == false { return false }
    if is_ident_tok(toks: read toks, i: read (s + 2)) == false { return false }
    let bound = tk_text(toks: read toks, i: read (s + 2))
    if bound == "Managed" || bound == "Struct" || bound == "Resource" { return false }
    if is_stdlib_protocol(name: read bound) { return false }
    return Set.contains<String>(set: read protocols, value: read bound) == false
}

// True if the generic clause opening at `nameEnd` (`<...>`) has a protocol bound
// naming a protocol that is not visible.
fn generics_unknown_protocol(toks: read List<Tok>, nameEnd: read Int, protocols: read Set<String>) -> Bool {
    if at_symbol(toks: read toks, i: read nameEnd, code: read SYM_LANGLE) == false { return false }
    let close = find_matching(toks: read toks, open: read nameEnd, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 { return false }
    let mut k = nameEnd + 1
    let mut depth = 0
    let mut segStart = nameEnd + 1
    let mut hit = false
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if bound_unknown_protocol(toks: read toks, s: read segStart, e: read k, protocols: read protocols) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if bound_unknown_protocol(toks: read toks, s: read segStart, e: read close, protocols: read protocols) { hit = true }
    return hit
}

// ---------------------------------------------------------------------------
// RS0014 / RS0018 / RS0019 runtime-guarantee bodies.
//
// A fn declaring effects(no_block)/effects(no_panic) may only call constructors,
// enum variants, or functions carrying the same guarantee — an unqualified call
// to a user function lacking it is RS0018 / RS0019. A fn declaring
// effects(noalloc) must not construct a value or `manage` — RS0014. Mirrors
// check_runtime_guarantee_* (the qualified-stdlib-call cases have no fixtures).
// ---------------------------------------------------------------------------

// One effects item [segStart,segEnd) is the valid bare effect `effName`.
fn effect_seg_named(toks: read List<Tok>, segStart: read Int, segEnd: read Int, effName: read String) -> Bool {
    if effect_item_kind(toks: read toks, segStart: read segStart, segEnd: read segEnd) != 1 { return false }
    return tk_text(toks: read toks, i: read segStart) == effName
}

// True if the fn's effects(...) clause lists the bare effect `effName`.
fn fn_has_named_effect(toks: read List<Tok>, start: read Int, effName: read String) -> Bool {
    let effOpen = find_effects_open(toks: read toks, start: read start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: read toks, open: read effOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if effect_seg_named(toks: read toks, segStart: read segStart, segEnd: read k, effName: read effName) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_seg_named(toks: read toks, segStart: read segStart, segEnd: read effClose, effName: read effName) { hit = true }
    return hit
}

// RS0018/RS0019: a guarantee-carrying fn whose body makes an unqualified call to
// a user function that does not carry the same guarantee.
fn fn_guarantee_call_bad(toks: read List<Tok>, start: read Int, effName: read String, allFns: read Set<String>, guaranteeFns: read Set<String>) -> Bool {
    if fn_has_named_effect(toks: read toks, start: read start, effName: read effName) == false { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && tk_kind(toks: read toks, i: read (k - 1)) == TOK_IDENT {
            let name = tk_text(toks: read toks, i: read (k - 1))
            let qualified = at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (k - 3))
            if qualified == false {
                if Set.contains<String>(set: read allFns, value: read name) && Set.contains<String>(set: read guaranteeFns, value: read name) == false { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0014: a fn declaring effects(noalloc) whose body constructs a value (an
// unqualified call to a declared type) or uses `manage`.
fn fn_noalloc_alloc(toks: read List<Tok>, start: read Int, declared: read Set<String>) -> Bool {
    if fn_has_named_effect(toks: read toks, start: read start, effName: read "noalloc") == false { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if tk_text(toks: read toks, i: read k) == "manage" {
            hit = true
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && tk_kind(toks: read toks, i: read (k - 1)) == TOK_IDENT {
            let name = tk_text(toks: read toks, i: read (k - 1))
            let qualified = at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (k - 3))
            if qualified == false {
                if Set.contains<String>(set: read declared, value: read name) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0020 INVALID_NOALLOC_CALL: a `noalloc` fn may call ONLY enum variants or other
// `noalloc` fns (oracle analyzer/diagnostics.rs). Unqualified constructor calls
// (a declared type) allocate and are RS0014, not RS0020, so they are excluded here.

// Simple + dotted names of every `effects(noalloc)` fn (one top-level pre-pass).
fn collect_noalloc_fns(toks: read List<Tok>) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_named_effect(toks: read toks, start: read i, effName: read "noalloc") {
                        let ns = fn_name_start(toks: read toks, i: read i)
                        Set.insert<String>(set: mut out, value: read dotted_name_text(toks: read toks, i: read ns))
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// A noalloc fn body containing a call to something that is neither an enum variant
// nor a noalloc fn (constructors of declared types are RS0014, excluded).
fn noalloc_body_bad(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int, declared: read Set<String>, sumVariants: read Set<String>, noallocFns: read Set<String>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && tk_kind(toks: read toks, i: read (k - 1)) == TOK_IDENT {
            let name = tk_text(toks: read toks, i: read (k - 1))
            let qualified = at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (k - 3))
            if qualified {
                let mut root = k - 3
                let mut walking = true
                while walking {
                    if at_symbol(toks: read toks, i: read (root - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (root - 2)) {
                        root = root - 2
                    } else {
                        walking = false
                    }
                }
                if Set.contains<String>(set: read noallocFns, value: read dotted_name_text(toks: read toks, i: read root)) == false { hit = true }
            } else {
                let isCtor = Set.contains<String>(set: read declared, value: read name)
                let isVariant = Set.contains<String>(set: read sumVariants, value: read name)
                let isNoalloc = Set.contains<String>(set: read noallocFns, value: read name)
                if isCtor == false && isVariant == false && isNoalloc == false { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0020 over one fn: a noalloc fn whose body makes a disallowed call.
fn fn_has_noalloc_call(toks: read List<Tok>, start: read Int, declared: read Set<String>, sumVariants: read Set<String>, noallocFns: read Set<String>) -> Bool {
    if fn_has_named_effect(toks: read toks, start: read start, effName: read "noalloc") == false { return false }
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    return noalloc_body_bad(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose, declared: read declared, sumVariants: read sumVariants, noallocFns: read noallocFns)
}

// RS1003 OWN_STRUCT_ATTEMPT: `own struct` is not part of the language (oracle
// checks/forbidden.rs scans for the adjacent `own` `struct` tokens). Byte-for-byte
// the same check: any `own` immediately followed by `struct`.
fn has_own_struct(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < (ntok - 1) {
        if is_kw_text(toks: read toks, i: read i, word: read "own") && is_kw_text(toks: read toks, i: read (i + 1), word: read "struct") {
            hit = true
        }
        i = i + 1
    }
    return hit
}

// RS0902 INVALID_WEAK_FIELD: a `weak` struct/resource field whose type is not a class
// (oracle analyzer/resource_types.rs). FP-safe: fire only when the field type is a
// KNOWN non-class — a scalar, or a type declared `struct`/`resource` in this file. An
// unknown type name (possibly a builtin/foreign class) never fires.

// Partition every declared type into class names and non-class (struct/resource)
// names in one pass.
fn collect_type_kinds(toks: read List<Tok>, classes: mut Set<String>, nonClasses: mut Set<String>) -> Unit {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks: read toks, i: read i)
                    let nm = dotted_name_text(toks: read toks, i: read nameIdx)
                    if at_ident(toks: read toks, i: read (nameIdx - 1), wid: read WORD_CLASS) {
                        Set.insert<String>(set: mut classes, value: read nm)
                    } else {
                        Set.insert<String>(set: mut nonClasses, value: read nm)
                    }
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return Unit
}

// A type body [bodyOpen..} with a field `name: weak T` (optional `handle`) whose T is
// a known non-class type.
fn type_body_has_invalid_weak(toks: read List<Tok>, bodyOpen: read Int, nonClass: read Set<String>) -> Bool {
    let close = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 { return false }
    let mut k = bodyOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            if is_kw_text(toks: read toks, i: read (k + 2), word: read "weak") {
                let mut u = k + 3
                if is_kw_text(toks: read toks, i: read u, word: read "handle") { u = u + 1 }
                if is_ident_tok(toks: read toks, i: read u) {
                    let tn = tk_text(toks: read toks, i: read u)
                    if is_scalar_name(name: read tn) || Set.contains<String>(set: read nonClass, value: read tn) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0902 over the file: any type with an invalid `weak` field.
fn has_invalid_weak_field(toks: read List<Tok>) -> Bool {
    let mut classes = Set<String>.new()
    let mut nonClass = Set<String>.new()
    collect_type_kinds(toks: read toks, classes: mut classes, nonClasses: mut nonClass)
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        if type_body_has_invalid_weak(toks: read toks, bodyOpen: read ob, nonClass: read nonClass) { hit = true }
                    }
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0306 LOCAL_CLASS_BINDING: a `local` binding whose value is a class instance
// (oracle checks/body/resource_pool.rs) — classes are managed handles, not locals.
// FP-safe subset: the direct-constructor form `local [mut] NAME = ClassName(...)`
// where ClassName is a class declared in this file; indirect (fn-returned) class
// values are a safe false-negative (no corpus file needs them).
fn has_local_class_binding(toks: read List<Tok>) -> Bool {
    let mut classes = Set<String>.new()
    let mut nonClass = Set<String>.new()
    collect_type_kinds(toks: read toks, classes: mut classes, nonClasses: mut nonClass)
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if is_kw_text(toks: read toks, i: read i, word: read "local") {
            let mut q = i + 1
            if is_kw_text(toks: read toks, i: read q, word: read "mut") { q = q + 1 }
            if is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_EQ) && is_ident_tok(toks: read toks, i: read (q + 2)) && at_symbol(toks: read toks, i: read (q + 3), code: read SYM_LPAREN) {
                if Set.contains<String>(set: read classes, value: read tk_text(toks: read toks, i: read (q + 2))) { hit = true }
            }
        }
        i = i + 1
    }
    return hit
}

// RS0701 RESOURCE_FIELD: a non-resource type with a field whose (outer) type is a
// declared resource (oracle analyzer/resource_types.rs) — resources must live behind
// `with`/`ResourcePool`, not as plain fields. FP-safe: fire only when the field type
// root is a KNOWN resource; the containing type must not itself be a resource.
fn type_body_has_resource_field(toks: read List<Tok>, bodyOpen: read Int, resources: read Set<String>) -> Bool {
    let close = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 { return false }
    let mut k = bodyOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let mut u = k + 2
            let mut skipping = true
            while skipping {
                if is_kw_text(toks: read toks, i: read u, word: read "handle") || is_kw_text(toks: read toks, i: read u, word: read "weak") {
                    u = u + 1
                } else {
                    skipping = false
                }
            }
            if is_ident_tok(toks: read toks, i: read u) {
                if Set.contains<String>(set: read resources, value: read tk_text(toks: read toks, i: read u)) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

fn has_resource_field(toks: read List<Tok>, resources: read Set<String>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks: read toks, i: read i)
                    let isResource = at_ident(toks: read toks, i: read (nameIdx - 1), wid: read WORD_RESOURCE)
                    if isResource == false {
                        let ob = find_body_open(toks: read toks, i: read i, end: read r)
                        if ob >= 0 {
                            if type_body_has_resource_field(toks: read toks, bodyOpen: read ob, resources: read resources) { hit = true }
                        }
                    }
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0604 FRESH_REQUIRES_LOCAL_BINDING: a `fresh`-returning call used directly with a
// `mut`/`take` data-effect (oracle checks/body/fresh.rs) — a fresh value must be bound
// to a local before `mut`/`take` use. FP-safe: fire only when the callee is a KNOWN
// fresh-returning fn declared in this file.
fn fn_returns_fresh(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let de = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read de, code: read SYM_LPAREN) == false { return false }
    let close = find_matching(toks: read toks, open: read de, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return false }
    return is_kw_text(toks: read toks, i: read (close + 2), word: read "fresh")
}

// Dotted names of every fn declared `-> fresh T`.
fn collect_fresh_fns(toks: read List<Tok>) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_returns_fresh(toks: read toks, start: read i) {
                        let ns = fn_name_start(toks: read toks, i: read i)
                        Set.insert<String>(set: mut out, value: read dotted_name_text(toks: read toks, i: read ns))
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// RS0604 over the file: a `mut`/`take` immediately applied to a fresh-returning call.
fn has_fresh_requires_local(toks: read List<Tok>) -> Bool {
    let freshFns = collect_fresh_fns(toks: read toks)
    let ntok = List.len(list: read toks)
    let mut k = 0
    let mut hit = false
    while k < ntok {
        if is_kw_text(toks: read toks, i: read k, word: read "mut") || is_kw_text(toks: read toks, i: read k, word: read "take") {
            if is_ident_tok(toks: read toks, i: read (k + 1)) {
                let ce = dotted_end(toks: read toks, i: read (k + 1))
                if at_symbol(toks: read toks, i: read ce, code: read SYM_LPAREN) {
                    if Set.contains<String>(set: read freshFns, value: read dotted_name_text(toks: read toks, i: read (k + 1))) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0603 INVALID_FRESH_RETURN_TYPE: a fn declaring `-> fresh X` where X is a generic
// type parameter, not a struct (oracle checks/body/resource_pool.rs). FP-safe: fire
// only when the fresh return type name is one of the fn's own `<...>` generic params —
// a concrete non-struct fresh return (class/resource) is a safe false-negative.
fn fn_fresh_return_generic_bad(toks: read List<Tok>, start: read Int, classes: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let mut p = dotted_end(toks: read toks, i: read ns)
    let mut genOpen = 0 - 1
    let mut genClose = 0 - 1
    if at_symbol(toks: read toks, i: read p, code: read SYM_LANGLE) {
        genOpen = p
        genClose = find_matching(toks: read toks, open: read p, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if genClose < 0 { return false }
        p = genClose + 1
    }
    if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) == false { return false }
    let close = find_matching(toks: read toks, open: read p, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return false }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return false }
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    // Scan the whole return-type region for a `fresh X` (possibly nested, e.g.
    // `Result<fresh User, E>`) whose X is a KNOWN non-struct: a scalar, a declared
    // class, or one of the fn's own generic params.
    let mut k = close + 2
    let mut hit = false
    while k < sigEnd {
        if is_kw_text(toks: read toks, i: read k, word: read "fresh") && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let xname = tk_text(toks: read toks, i: read (k + 1))
            if is_scalar_name(name: read xname) {
                hit = true
            } else if Set.contains<String>(set: read classes, value: read xname) {
                hit = true
            } else if genOpen >= 0 && region_has_text(toks: read toks, s: read (genOpen + 1), e: read genClose, word: read xname) {
                hit = true
            }
        }
        k = k + 1
    }
    return hit
}

fn has_invalid_fresh_return(toks: read List<Tok>) -> Bool {
    let mut classes = Set<String>.new()
    let mut nonClasses = Set<String>.new()
    collect_type_kinds(toks: read toks, classes: mut classes, nonClasses: mut nonClasses)
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_fresh_return_generic_bad(toks: read toks, start: read i, classes: read classes) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0705 RESOURCE_POOL_NOT_LOCAL: a ResourcePool binding that is not `local` (oracle
// checks/body/resource_pool.rs). A binding is local iff it is a `local` binding OR a
// `mut`/`take` param. So a `let` binding of `ResourcePool<...>.new(...)`, or a
// `read`/no-effect param typed `ResourcePool<...>`, fires.
fn fn_pool_param_bad(toks: read List<Tok>, start: read Int) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let mut p = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read p, code: read SYM_LANGLE) {
        let gc = find_matching(toks: read toks, open: read p, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gc < 0 { return false }
        p = gc + 1
    }
    if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) == false { return false }
    let pclose = find_matching(toks: read toks, open: read p, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let mut depth = 0
    let mut k = p + 1
    let mut hit = false
    while k < pclose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let mut t = k + 2
            let mut eff = ""
            if is_kw_text(toks: read toks, i: read t, word: read "read") || is_kw_text(toks: read toks, i: read t, word: read "mut") || is_kw_text(toks: read toks, i: read t, word: read "take") {
                eff = tk_text(toks: read toks, i: read t)
                t = t + 1
            }
            if is_ident_tok(toks: read toks, i: read t) && tk_text(toks: read toks, i: read t) == "ResourcePool" {
                if eff != "mut" && eff != "take" { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

fn has_resourcepool_not_local(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut hit = false
    let mut j = 0
    let mut running = true
    while running {
        if j >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read j) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read j)
            let isPub = cls.isPub
            if cls.isFeatures {
                j = declaration_line_end(toks: read toks, start: read j)
            } else if cls.isProfile {
                j = declaration_line_end(toks: read toks, start: read j)
            } else if starts_fn_like(toks: read toks, i: read j, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read j)
                if r < 0 {
                    running = false
                } else {
                    if fn_pool_param_bad(toks: read toks, start: read j) { hit = true }
                    j = r
                }
            } else {
                j = j + 1
            }
        }
    }
    let mut i = 0
    while i < ntok {
        if is_kw_text(toks: read toks, i: read i, word: read "let") {
            let mut q = i + 1
            if is_kw_text(toks: read toks, i: read q, word: read "mut") { q = q + 1 }
            if is_ident_tok(toks: read toks, i: read q) && at_symbol(toks: read toks, i: read (q + 1), code: read SYM_EQ) && is_ident_tok(toks: read toks, i: read (q + 2)) {
                if tk_text(toks: read toks, i: read (q + 2)) == "ResourcePool" {
                    let mut r = q + 3
                    if at_symbol(toks: read toks, i: read r, code: read SYM_LANGLE) {
                        let gc = find_matching(toks: read toks, open: read r, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
                        if gc >= 0 { r = gc + 1 }
                    }
                    if at_symbol(toks: read toks, i: read r, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (r + 1)) {
                        if tk_text(toks: read toks, i: read (r + 1)) == "new" { hit = true }
                    }
                }
            }
        }
        i = i + 1
    }
    return hit
}

// RS1002 IMPLICIT_CONVERSION_ATTEMPT: an `as` token that is not part of a `with ... as`
// binding or a `use ... as` alias — a cast-style conversion (oracle checks/forbidden.rs).
// Purely token-decidable, mirrors as_belongs_to_with / as_belongs_to_use exactly.
fn is_stmt_boundary_kw(toks: read List<Tok>, k: read Int) -> Bool {
    return is_kw_text(toks: read toks, i: read k, word: read "let") || is_kw_text(toks: read toks, i: read k, word: read "local") || is_kw_text(toks: read toks, i: read k, word: read "return") || is_kw_text(toks: read toks, i: read k, word: read "fn") || is_kw_text(toks: read toks, i: read k, word: read "class") || is_kw_text(toks: read toks, i: read k, word: read "struct") || is_kw_text(toks: read toks, i: read k, word: read "resource") || is_kw_text(toks: read toks, i: read k, word: read "if") || is_kw_text(toks: read toks, i: read k, word: read "else") || is_kw_text(toks: read toks, i: read k, word: read "loop") || is_kw_text(toks: read toks, i: read k, word: read "while") || is_kw_text(toks: read toks, i: read k, word: read "break") || is_kw_text(toks: read toks, i: read k, word: read "continue")
}

fn as_belongs_to_with(toks: read List<Tok>, asIdx: read Int) -> Bool {
    let mut k = asIdx - 1
    while k >= 0 {
        if is_kw_text(toks: read toks, i: read k, word: read "with") { return true }
        if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || is_stmt_boundary_kw(toks: read toks, k: read k) { return false }
        k = k - 1
    }
    return false
}

fn as_belongs_to_use(toks: read List<Tok>, asIdx: read Int) -> Bool {
    let mut k = asIdx - 1
    while k >= 0 {
        if is_kw_text(toks: read toks, i: read k, word: read "use") { return true }
        let pathTok = is_ident_tok(toks: read toks, i: read k) || at_symbol(toks: read toks, i: read k, code: read SYM_DOT)
        if pathTok == false { return false }
        k = k - 1
    }
    return false
}

fn has_implicit_conversion(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if is_kw_text(toks: read toks, i: read i, word: read "as") {
            if as_belongs_to_with(toks: read toks, asIdx: read i) == false && as_belongs_to_use(toks: read toks, asIdx: read i) == false {
                hit = true
            }
        }
        i = i + 1
    }
    return hit
}

// RS0901 TAKE_HANDLE_FIELD: `take receiver.field` where `field` is a `handle` field of
// the RECEIVER'S type (oracle checks/body/effects.rs) — handle fields are non-owning.
// FP-safe: handle fields are keyed by `Struct.field` and the receiver's type is resolved
// from its param declaration, so a same-named non-handle field on a different struct
// (the `take-inline-field-same-name` case) does not fire.
fn field_key(typeName: read String, field: read String) -> String {
    return String.concat(left: read String.concat(left: read typeName, right: read "."), right: read field)
}

fn collect_modifier_fields_in_body(toks: read List<Tok>, bodyOpen: read Int, typeName: read String, modifier: read String, out: mut Set<String>) -> Unit {
    let close = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 { return Unit }
    let mut k = bodyOpen + 1
    let mut depth = 0
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            if is_kw_text(toks: read toks, i: read (k + 2), word: read modifier) {
                Set.insert<String>(set: mut out, value: read field_key(typeName: read typeName, field: read tk_text(toks: read toks, i: read k)))
            }
        }
        k = k + 1
    }
    return Unit
}

// `Struct.field` keys for every field carrying the type-prefix `modifier` (handle/weak).
fn collect_modifier_field_keys(toks: read List<Tok>, modifier: read String) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks: read toks, i: read i)
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        collect_modifier_fields_in_body(toks: read toks, bodyOpen: read ob, typeName: read dotted_name_text(toks: read toks, i: read nameIdx), modifier: read modifier, out: mut out)
                    }
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// One fn: a `take receiver.field` where `receiver` is a single param whose type has
// `field` declared `handle`.
fn fn_has_take_handle(toks: read List<Tok>, start: read Int, keys: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let popen = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read popen, code: read SYM_LPAREN) == false { return false }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "take") && is_ident_tok(toks: read toks, i: read (k + 1)) {
            let de = dotted_end(toks: read toks, i: read (k + 1))
            if de >= (k + 4) && (de - 3) == (k + 1) && at_symbol(toks: read toks, i: read (de - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (de - 1)) {
                let rtype = param_type_root(toks: read toks, open: read popen, close: read pclose, name: read tk_text(toks: read toks, i: read (k + 1)))
                if String.len(value: read rtype) > 0 {
                    if Set.contains<String>(set: read keys, value: read field_key(typeName: read rtype, field: read tk_text(toks: read toks, i: read (de - 1)))) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0901 over the file: any fn taking a handle field of a param's type.
fn has_take_handle_field(toks: read List<Tok>) -> Bool {
    let keys = collect_modifier_field_keys(toks: read toks, modifier: read "handle")
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_take_handle(toks: read toks, start: read i, keys: read keys) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0903 WEAK_FIELD_REQUIRES_UPGRADE: reading a `weak` field as a value (`read`/`mut`
// RECEIVER.weakfield) without `Weak.upgrade` first (oracle checks/body/async_checks.rs).
// FP-safe: receiver typed from its param decl + weak field key; `Weak.upgrade(...)`
// arguments are exempted (the callee immediately enclosing the access is Weak.upgrade).
fn enclosing_is_weak_upgrade(toks: read List<Tok>, argStart: read Int, bodyOpen: read Int) -> Bool {
    let mut depth = 0
    let mut j = argStart - 1
    let mut found = false
    let mut result = false
    while j > bodyOpen && found == false {
        if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
            if depth == 0 {
                found = true
                if j >= 3 && is_ident_tok(toks: read toks, i: read (j - 1)) && at_symbol(toks: read toks, i: read (j - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (j - 3)) {
                    if tk_text(toks: read toks, i: read (j - 3)) == "Weak" && tk_text(toks: read toks, i: read (j - 1)) == "upgrade" { result = true }
                }
            } else {
                depth = depth - 1
            }
        }
        j = j - 1
    }
    return result
}

fn fn_has_weak_field_read(toks: read List<Tok>, start: read Int, weakKeys: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let popen = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read popen, code: read SYM_LPAREN) == false { return false }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "read") || is_kw_text(toks: read toks, i: read k, word: read "mut") {
            if is_ident_tok(toks: read toks, i: read (k + 1)) {
                let de = dotted_end(toks: read toks, i: read (k + 1))
                if de >= (k + 4) && (de - 3) == (k + 1) && at_symbol(toks: read toks, i: read (de - 2), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (de - 1)) {
                    let rtype = param_type_root(toks: read toks, open: read popen, close: read pclose, name: read tk_text(toks: read toks, i: read (k + 1)))
                    if String.len(value: read rtype) > 0 {
                        if Set.contains<String>(set: read weakKeys, value: read field_key(typeName: read rtype, field: read tk_text(toks: read toks, i: read (de - 1)))) {
                            if enclosing_is_weak_upgrade(toks: read toks, argStart: read k, bodyOpen: read sigEnd) == false { hit = true }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

fn has_weak_field_read(toks: read List<Tok>) -> Bool {
    let weakKeys = collect_modifier_field_keys(toks: read toks, modifier: read "weak")
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_weak_field_read(toks: read toks, start: read i, weakKeys: read weakKeys) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0904 WEAK_FIELD_REQUIRES_WEAK_HANDLE: a constructor initializing a `weak` field
// with anything other than a syntactic `Weak.from(...)`/`Weak.downgrade(...)` (oracle
// checks/body/fresh.rs::is_weak_handle_producing_expr). FP-safe: gated by the weak
// field key `Type.field`, so only a real weak-field initializer is examined.
fn value_is_weak_producing(toks: read List<Tok>, v: read Int) -> Bool {
    if is_ident_tok(toks: read toks, i: read v) == false { return false }
    if tk_text(toks: read toks, i: read v) != "Weak" { return false }
    if at_symbol(toks: read toks, i: read (v + 1), code: read SYM_DOT) == false { return false }
    let m = tk_text(toks: read toks, i: read (v + 2))
    return m == "from" || m == "downgrade"
}

// One simple-name call [open,close]: a named arg for a `weak` field of `callee` whose
// value is not weak-producing.
fn call_weak_field_bad(toks: read List<Tok>, callee: read String, open: read Int, close: read Int, weakKeys: read Set<String>) -> Bool {
    let mut depth = 0
    let mut atArgStart = true
    let mut k = open + 1
    let mut hit = false
    while k < close {
        if depth == 0 && atArgStart && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            if Set.contains<String>(set: read weakKeys, value: read field_key(typeName: read callee, field: read tk_text(toks: read toks, i: read k))) {
                if value_is_weak_producing(toks: read toks, v: read (k + 2)) == false { hit = true }
            }
        }
        atArgStart = false
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            atArgStart = true
        }
        k = k + 1
    }
    return hit
}

// RS0904 over the file: any constructor call with a bad weak-field initializer.
fn has_weak_field_bad_init(toks: read List<Tok>) -> Bool {
    let weakKeys = collect_modifier_field_keys(toks: read toks, modifier: read "weak")
    let ntok = List.len(list: read toks)
    let mut k = 1
    let mut hit = false
    while k < ntok {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (k - 1)) && at_symbol(toks: read toks, i: read (k - 2), code: read SYM_DOT) == false {
            let close = find_matching(toks: read toks, open: read k, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close >= 0 {
                if call_weak_field_bad(toks: read toks, callee: read tk_text(toks: read toks, i: read (k - 1)), open: read k, close: read close, weakKeys: read weakKeys) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0101 FEATURE_VIOLATION (feature-gating).
//
// A feature-requiring construct is used but the file header does not declare the
// required `features:`. FILE-LEVEL: emit "RS0101" once if ANY unfeatured use
// exists (the checker compares a code SET, so only presence matters). Three
// oracle sources are reproduced:
//   * checks/features.rs feature_uses — construct -> required feature:
//       local  : `local` let/closure, `manage` expr, `take` data-effect,
//                `ResourcePool<T>` type/callee
//       native : a fn with `effects(native)`
//       unsafe : a fn with `effects(unsafe)`
//       async  : `async fn`/`async let`/`async for`, `spawn`, `await`,
//                `task_group`, `select`
//   * analyzer/signatures.rs check_native_effect — a `native fn` that does NOT
//     surface `effects(native)` is RS0101 REGARDLESS of the declared features.
//   * checks/body/semantics.rs check_match_pattern_effects — `match take`
//     without `features: local` (subsumed by the `take` keyword probe).
//
// A reserved feature keyword (`local`/`async`/`unsafe`) only appears in a
// `features:` header when that feature is DECLARED, so a header token always
// self-gates; the only other occurrences are real uses. `native` is the sole
// exception (the missing-effect source fires even when declared), so it is
// tracked separately in the fn walk.
// ---------------------------------------------------------------------------

// The `local`/`native`/`unsafe`/`async` features this file declares, collected
// from every top-level `features:` header (order-independent pre-pass).
fn collect_declared_features(toks: read List<Tok>) -> Set<String> {
    let mut declared = Set<String>.new()
    let n = List.len(list: read toks)
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FEATURES) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            let lineEnd = declaration_line_end(toks: read toks, start: read i)
            let mut j = i + 2
            while j < lineEnd {
                if is_ident_tok(toks: read toks, i: read j) {
                    let fname = tk_text(toks: read toks, i: read j)
                    if is_known_feature(name: read fname) {
                        Set.insert<String>(set: mut declared, value: read fname)
                    }
                }
                j = j + 1
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return declared
}

// True if the ident/keyword token at i is `word` and is not a method name (not
// preceded by `.`).
fn kw_not_dotted(toks: read List<Tok>, i: read Int, word: read String) -> Bool {
    if is_kw_text(toks: read toks, i: read i, word: read word) == false { return false }
    return at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) == false
}

// A `local`-feature construct anywhere in the file: a `local` let/closure, a
// `manage` expr, a `take` data-effect, or a `ResourcePool<T>` type/callee. The
// `take` effect is distinguished from a `.take(` method (preceded by `.`) and a
// binding/field named `take` (followed by `:`).
fn file_local_use(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_LOCAL) {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "manage") {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "take") && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) == false {
            hit = true
        } else if is_ident_tok(toks: read toks, i: read i) && tk_text(toks: read toks, i: read i) == "ResourcePool" {
            hit = true
        }
        i = i + 1
    }
    return hit
}

// An `async`-feature construct anywhere: `async` (fn/let/for) modifier keyword,
// or a `spawn`/`await`/`task_group`/`select` prefix/statement keyword.
fn file_async_use(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        // The `async` MODIFIER (`async fn`/`async let`/`async for`) is a feature
        // use; the `async` EFFECT NAME in `effects(..., async, ...)` is a removed
        // runtime effect (RS0012), NOT an async construct, so gate on the next kw.
        if at_ident(toks: read toks, i: read i, wid: read WORD_ASYNC) && (at_ident(toks: read toks, i: read (i + 1), wid: read WORD_FN) || at_ident(toks: read toks, i: read (i + 1), wid: read WORD_FOR) || is_kw_text(toks: read toks, i: read (i + 1), word: read "let")) {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "spawn") {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "await") {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "task_group") {
            hit = true
        } else if kw_not_dotted(toks: read toks, i: read i, word: read "select") {
            hit = true
        }
        i = i + 1
    }
    return hit
}

// An `unsafe`-feature construct anywhere: an `effects(unsafe)` clause. `unsafe`
// is only ever an effect name or a `features: unsafe` header token (the latter
// implies the feature is declared, so it self-gates), so a bare WORD_UNSAFE
// token is a faithful proxy.
fn file_unsafe_use(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_UNSAFE) { hit = true }
        i = i + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0015 UNSUPPORTED_SYNTAX.
//
// This is deliberately a conservative recognizer for the fail-corpus shapes the
// Rust frontend reports as RS0015. It is not a generic parser fallback: the
// self-host checker keeps scanning after malformed items, so broad "parse failed"
// rules would risk false positives on constructs this lightweight parser skips.
// ---------------------------------------------------------------------------

fn rs0015_literal_token(toks: read List<Tok>, i: read Int) -> Bool {
    let k = tk_kind(toks: read toks, i: read i)
    if k == TOK_STRING || k == TOK_MULTILINE || k == TOK_INTERP || k == TOK_NUMBER || k == TOK_CHAR { return true }
    if is_ident_tok(toks: read toks, i: read i) {
        let t = tk_text(toks: read toks, i: read i)
        return t == "true" || t == "false" || t == "Unit" || t == "None" || t == "null"
    }
    return false
}

fn rs0015_has_unmatched_delimiter(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            if find_matching(toks: read toks, open: read i, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN) < 0 { hit = true }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            if find_matching(toks: read toks, open: read i, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE) < 0 { hit = true }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            if find_matching(toks: read toks, open: read i, openSym: read SYM_LBRACKET, closeSym: read SYM_RBRACKET) < 0 { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_supported_derive(name: read String) -> Bool {
    return name == "Clone" || name == "Eq" || name == "Ord" || name == "Hash" || name == "JsonEncode" || name == "JsonDecode" || name == "Schema" || name == "ReviewSchema"
}

fn rs0015_has_bad_derive_name(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_DERIVES) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close > 0 {
                let mut j = i + 2
                while j < close {
                    if is_ident_tok(toks: read toks, i: read j) {
                        if rs0015_supported_derive(name: read tk_text(toks: read toks, i: read j)) == false { hit = true }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_duplicate_use_name(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut seen = Set<String>.new()
    let mut hit = false
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
            let lineEnd = declaration_line_end(toks: read toks, start: read i)
            let mut alias = ""
            let mut last = ""
            let mut j = i + 1
            while j < lineEnd {
                if at_ident(toks: read toks, i: read j, wid: read WORD_AS) && is_ident_tok(toks: read toks, i: read (j + 1)) {
                    alias = tk_text(toks: read toks, i: read (j + 1))
                } else if is_ident_tok(toks: read toks, i: read j) {
                    last = tk_text(toks: read toks, i: read j)
                }
                j = j + 1
            }
            let mut localName = last
            if String.len(value: read alias) > 0 { localName = alias }
            if String.len(value: read localName) > 0 {
                if Set.contains<String>(set: read seen, value: read localName) { hit = true }
                Set.insert<String>(set: mut seen, value: read localName)
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_reserved_or_unknown_top(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_ident_tok(toks: read toks, i: read i) {
            let t = tk_text(toks: read toks, i: read i)
            if t == "namespace" || t == "enum" { hit = true }
            if t == "spawn" { hit = true }
            if String.starts_with(value: read t, prefix: read "__rss_") || String.starts_with(value: read t, prefix: read "__rsscript_") { hit = true }
            if t == "own" && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_STRUCT) { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_bad_type_surface(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_OPAQUE) && starts_type_decl(toks: read toks, i: read i, isPub: read false) {
            let r = parse_type_decl(toks: read toks, i: read i)
            if r > i {
                let ob = find_body_open(toks: read toks, i: read i, end: read r)
                if ob >= 0 { hit = true }
                i = r
            } else {
                hit = true
                i = i + 1
            }
        } else if (at_ident(toks: read toks, i: read i, wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read i, wid: read WORD_CLASS) || at_ident(toks: read toks, i: read i, wid: read WORD_RESOURCE)) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LBRACE) {
            hit = true
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_malformed_field(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if starts_type_decl(toks: read toks, i: read i, isPub: read at_ident(toks: read toks, i: read i, wid: read WORD_PUB)) {
            let r = parse_type_decl(toks: read toks, i: read i)
            if r > i {
                let ob = find_body_open(toks: read toks, i: read i, end: read r)
                if ob >= 0 {
                    let close = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    let mut j = ob + 1
                    while j < close {
                        if is_kw_text(toks: read toks, i: read j, word: read "drop") && at_symbol(toks: read toks, i: read (j + 1), code: read SYM_LBRACE) {
                            let dc = find_matching(toks: read toks, open: read (j + 1), openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                            if dc > j { j = dc + 1 } else { j = j + 1 }
                        } else if is_ident_tok(toks: read toks, i: read j) {
                            let lineEnd = declaration_line_end(toks: read toks, start: read j)
                            if lineEnd <= close {
                                let colon = find_top_sym(toks: read toks, start: read j, end: read lineEnd, code: read SYM_COLON)
                                if colon < 0 || colon == (lineEnd - 1) { hit = true }
                                j = lineEnd
                            } else {
                                j = j + 1
                            }
                        } else {
                            j = j + 1
                        }
                    }
                }
                i = r
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_generic_params(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) && rs0015_is_generic_open(toks: read toks, i: read i) {
            let close = find_matching(toks: read toks, open: read i, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
            if close > i {
                let mut j = i + 1
                while j < close {
                    if is_effect_kw(toks: read toks, i: read j) { hit = true }
                    if at_symbol(toks: read toks, i: read j, code: read SYM_COMMA) {
                        if at_symbol(toks: read toks, i: read (j + 1), code: read SYM_COMMA) || at_symbol(toks: read toks, i: read (j + 1), code: read SYM_RANGLE) { hit = true }
                    }
                    j = j + 1
                }
                if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COMMA) { hit = true }
                i = close + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

// `<` also introduces ordinary comparisons. Only inspect generic lists in a
// declaration (`fn name<...>`) or after a nominal-type-shaped name. Scanning
// every `<` lets `i < limit` consume a later type argument's `>` and creates
// false RS0015 reports in otherwise valid loop-heavy programs.
fn rs0015_is_generic_open(toks: read List<Tok>, i: read Int) -> Bool {
    if i <= 0 || is_ident_tok(toks: read toks, i: read (i - 1)) == false { return false }
    let previous = tk_text(toks: read toks, i: read (i - 1))
    if is_upper_head(name: read previous) { return true }
    return at_ident(toks: read toks, i: read (i - 2), wid: read WORD_FN)
}

fn rs0015_has_unknown_token(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if tk_kind(toks: read toks, i: read i) == TOK_UNKNOWN { hit = true }
        i = i + 1
    }
    return hit
}

// The lexer intentionally preserves an unterminated string as a String token
// so token parity stays faithful. Syntax parity still needs to reject it. Scan
// the original source with the same shared literal scanners to retain that bit
// of information without changing the token ABI.
fn rs0015_has_unterminated_string(source: read String) -> Bool {
    let chars = String.chars(value: read source)
    let n = List.len(list: read chars)
    let mut i = 0
    let mut hit = false
    while i < n {
        let c = List.get(list: read chars, index: read i)
        let c1 = code_at(chars: read chars, n: read n, i: read (i + 1))
        let c2 = code_at(chars: read chars, n: read n, i: read (i + 2))
        if c == '/' && c1 == 47 {
            i = scan_line_comment(chars: read chars, n: read n, i: read i)
        } else if c == '"' && c1 == 34 && c2 == 34 {
            let close = scan_multiline(chars: read chars, n: read n, i: read i)
            if code_at(chars: read chars, n: read n, i: read close) != 34 || code_at(chars: read chars, n: read n, i: read (close + 1)) != 34 || code_at(chars: read chars, n: read n, i: read (close + 2)) != 34 {
                hit = true
                i = n
            } else {
                i = close + 3
            }
        } else if c == '$' && c1 == 34 {
            let close = scan_interp(chars: read chars, n: read n, i: read i)
            if code_at(chars: read chars, n: read n, i: read close) != 34 {
                hit = true
                i = n
            } else {
                i = close + 1
            }
        } else if c == '"' {
            let close = scan_string(chars: read chars, n: read n, i: read i)
            if code_at(chars: read chars, n: read n, i: read close) != 34 {
                hit = true
                i = n
            } else {
                i = close + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

// `async let` is legal only within a task_group body. This small containment
// probe is intentionally limited to the outer placement rule; the checker does
// not claim to reproduce task-group consumption/nesting diagnostics yet.
fn rs0015_has_async_let_outside_task_group(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_ASYNC) && is_kw_text(toks: read toks, i: read (i + 1), word: read "let") {
            let mut inside = false
            let mut j = 0
            while j < i {
                if is_kw_text(toks: read toks, i: read j, word: read "task_group") && at_symbol(toks: read toks, i: read (j + 1), code: read SYM_LBRACE) {
                    let close = find_matching(toks: read toks, open: read (j + 1), openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if close > i { inside = true }
                }
                j = j + 1
            }
            if inside == false { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_call_has_empty_arg(toks: read List<Tok>, open: read Int, close: read Int) -> Bool {
    if at_symbol(toks: read toks, i: read (open + 1), code: read SYM_COMMA) { return true }
    let mut k = open + 1
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COMMA) { return true }
        if at_symbol(toks: read toks, i: read k, code: read SYM_COLON) {
            if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COMMA) || (k + 1) == close { return true }
        }
        k = k + 1
    }
    return false
}

fn rs0015_has_bad_call_forms(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 1
    let mut hit = false
    while i < n {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (i - 1)) {
            let name = tk_text(toks: read toks, i: read (i - 1))
            let close = find_matching(toks: read toks, open: read i, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close > i {
                if name == "None" || name == "Option" || name == "Result" { hit = true }
                if (name == "Some" || name == "Ok" || name == "Err") && find_top_sym(toks: read toks, start: read (i + 1), end: read close, code: read SYM_COLON) >= 0 { hit = true }
                if rs0015_call_has_empty_arg(toks: read toks, open: read i, close: read close) { hit = true }
                if close + 1 < n && name != "fn" && tk_line(toks: read toks, i: read (close + 1)) == tk_line(toks: read toks, i: read close) && is_ident_tok(toks: read toks, i: read (close + 1)) {
                    let next = tk_text(toks: read toks, i: read (close + 1))
                    if next != "as" && next != "else" && next != "captures" && next != "effects" { hit = true }
                }
                i = close + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_const_nonliteral(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_CONST) {
            let lineEnd = declaration_line_end(toks: read toks, start: read i)
            let mut eq = i
            while eq < lineEnd && at_symbol(toks: read toks, i: read eq, code: read SYM_EQ) == false { eq = eq + 1 }
            if eq < lineEnd {
                let rhs = eq + 1
                if rhs >= lineEnd {
                    hit = true
                } else if (rhs + 1) != lineEnd {
                    hit = true
                } else if rs0015_literal_token(toks: read toks, i: read rhs) == false {
                    hit = true
                }
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_control_or_binding(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_kw_text(toks: read toks, i: read i, word: read "else") {
            if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LBRACE) == false && is_kw_text(toks: read toks, i: read (i + 1), word: read "if") == false { hit = true }
        } else if is_kw_text(toks: read toks, i: read i, word: read "loop") {
            if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LBRACE) == false { hit = true }
        } else if is_kw_text(toks: read toks, i: read i, word: read "while") {
            if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LBRACE) { hit = true }
        } else if is_kw_text(toks: read toks, i: read i, word: read "match") {
            if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LBRACE) { hit = true }
        } else if is_kw_text(toks: read toks, i: read i, word: read "let") || is_kw_text(toks: read toks, i: read i, word: read "local") {
            let lineEnd = declaration_line_end(toks: read toks, start: read i)
            let mut eq = i
            while eq < lineEnd && at_symbol(toks: read toks, i: read eq, code: read SYM_EQ) == false { eq = eq + 1 }
            if eq < lineEnd && (eq + 1) >= lineEnd { hit = true }
            i = lineEnd - 1
        } else if is_kw_text(toks: read toks, i: read i, word: read "with") {
            let mut bodyOpen = i + 1
            while bodyOpen < n && at_symbol(toks: read toks, i: read bodyOpen, code: read SYM_LBRACE) == false { bodyOpen = bodyOpen + 1 }
            let mut hasAs = false
            let mut asHasBinding = false
            let mut j = i + 1
            while j < bodyOpen {
                if at_ident(toks: read toks, i: read j, wid: read WORD_AS) {
                    hasAs = true
                    if is_ident_tok(toks: read toks, i: read (j + 1)) { asHasBinding = true }
                }
                j = j + 1
            }
            if hasAs == false || asHasBinding == false { hit = true }
        } else if is_kw_text(toks: read toks, i: read i, word: read "spawn") {
            hit = true
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_bad_param_decl(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        let cls = classify_top(toks: read toks, i: read i)
        if starts_fn_like(toks: read toks, i: read i, isPub: read cls.isPub) {
            let ns = fn_name_start(toks: read toks, i: read i)
            let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
            let open = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
            if open >= 0 {
                let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if close > open {
                    let mut seg = open + 1
                    let mut j = open + 1
                    while j <= close {
                        if j == close || at_symbol(toks: read toks, i: read j, code: read SYM_COMMA) {
                            if seg < j {
                                let colon = find_top_sym(toks: read toks, start: read seg, end: read j, code: read SYM_COLON)
                                if colon < 0 && is_effect_kw(toks: read toks, i: read seg) { hit = true }
                            }
                            seg = j + 1
                        }
                        j = j + 1
                    }
                    i = close + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_match_arm(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_kw_text(toks: read toks, i: read i, word: read "match") {
            let mut ob = i + 1
            let mut paren = 0
            let mut bracket = 0
            let mut foundArmBlock = false
            while ob < n && foundArmBlock == false {
                if at_symbol(toks: read toks, i: read ob, code: read SYM_LPAREN) {
                    paren = paren + 1
                } else if at_symbol(toks: read toks, i: read ob, code: read SYM_RPAREN) {
                    if paren > 0 { paren = paren - 1 }
                } else if at_symbol(toks: read toks, i: read ob, code: read SYM_LBRACKET) {
                    bracket = bracket + 1
                } else if at_symbol(toks: read toks, i: read ob, code: read SYM_RBRACKET) {
                    if bracket > 0 { bracket = bracket - 1 }
                } else if paren == 0 && bracket == 0 && at_symbol(toks: read toks, i: read ob, code: read SYM_LBRACE) {
                    foundArmBlock = true
                }
                if foundArmBlock == false { ob = ob + 1 }
            }
            if foundArmBlock {
                let close = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if close > ob {
                    let mut j = ob + 1
                    let mut depth = 0
                    while j < close {
                        if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
                            depth = depth + 1
                        } else if at_symbol(toks: read toks, i: read j, code: read SYM_RBRACE) {
                            if depth > 0 { depth = depth - 1 }
                        } else if depth == 0 && tk_line(toks: read toks, i: read j) != tk_line(toks: read toks, i: read (j - 1)) {
                            let lineEnd = declaration_line_end(toks: read toks, start: read j)
                            if j < close && lineEnd <= close {
                                let arrow = find_top_sym(toks: read toks, start: read j, end: read lineEnd, code: read SYM_FATARROW)
                                if arrow < 0 && is_ident_tok(toks: read toks, i: read j) { hit = true }
                            }
                        }
                        j = j + 1
                    }
                    i = close
                }
            }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_native_body(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_NATIVE) && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_FN) {
            let sigEnd = function_signature_end(toks: read toks, start: read i)
            if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) { hit = true }
            i = sigEnd + 1
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_protocol_default_body(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
            let r = parse_protocol_decl(toks: read toks, i: read i)
            if r > i {
                let ob = find_body_open(toks: read toks, i: read i, end: read r)
                let close = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                let mut j = ob + 1
                while j < close {
                    if at_ident(toks: read toks, i: read j, wid: read WORD_FN) {
                        let sigEnd = function_signature_end(toks: read toks, start: read j)
                        if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) { hit = true }
                    }
                    j = j + 1
                }
                i = r
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_profile_decl(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    let mut depth = 0
    while i < n {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0
            && at_ident(toks: read toks, i: read i, wid: read WORD_PROFILE)
            && tk_line(toks: read toks, i: read i) != tk_line(toks: read toks, i: read (i - 1))
            && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            hit = true
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_malformed_fn_decl(toks: read List<Tok>) -> Bool {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) && tk_line(toks: read toks, i: read i) != tk_line(toks: read toks, i: read (i - 1)) {
            if is_ident_tok(toks: read toks, i: read (i + 1)) == false {
                hit = true
            }
        }
        i = i + 1
    }
    return hit
}

fn has_unsupported_syntax_rs0015(source: read String, toks: read List<Tok>) -> Bool {
    return rs0015_has_unmatched_delimiter(toks: read toks)
        || rs0015_has_unknown_token(toks: read toks)
        || rs0015_has_unterminated_string(source: read source)
        || rs0015_has_bad_derive_name(toks: read toks)
        || rs0015_has_duplicate_use_name(toks: read toks)
        || rs0015_has_reserved_or_unknown_top(toks: read toks)
        || rs0015_has_bad_type_surface(toks: read toks)
        || rs0015_has_malformed_field(toks: read toks)
        || rs0015_has_bad_generic_params(toks: read toks)
        || rs0015_has_bad_call_forms(toks: read toks)
        || rs0015_has_const_nonliteral(toks: read toks)
        || rs0015_has_bad_control_or_binding(toks: read toks)
        || rs0015_has_bad_param_decl(toks: read toks)
        || rs0015_has_bad_match_arm(toks: read toks)
        || rs0015_has_native_body(toks: read toks)
        || rs0015_has_protocol_default_body(toks: read toks)
        || rs0015_has_malformed_fn_decl(toks: read toks)
        || rs0015_has_async_let_outside_task_group(toks: read toks)
        || has_implicit_conversion(toks: read toks)
        || rs0015_has_profile_decl(toks: read toks)
}

// ---------------------------------------------------------------------------
// Type-inference engine — slice 1: conservative expression type-of + RS0013.
//
// `expr_type_root` computes the type ROOT of an expression region, but ONLY for
// the forms whose type the oracle (crate::hir::infer + checks/shared) computes
// with certainty; everything else (Binary / Index / Field / qualified & receiver
// calls / object / array / closure) returns "" (UNKNOWN). Returning unknown =>
// no diagnostic => no false positive; that conservatism is the safety mechanism
// and the reason this foundation is reused by the later slices (RS0210 operator,
// RS0207 argument, RS0208 return). See crate::checks::shared::builtin_value_type_name,
// crate::hir::number_literal_type_name, and checks/body/try_checks.rs.
//
// RS0013 is in CHECKER_TARGET_CODES: all three oracle sub-rules are reproduced —
// (A) `?` in a function whose return type is not Result/Option, (B) a `?` whose
// operand has a confidently-known concrete non-Result/Option type, and (C) inside
// a fn returning `Result<T, E>`, a `?` whose operand Result error type is known
// and differs from E. Sub-rule C reads the operand error type from a small stdlib
// namespace->error-type map (filesystem->FileError, json/toml/yaml->JsonError) or,
// for an unqualified same-file call, from that fn's declared error type; anything
// else stays UNKNOWN (no fire) — the FP-safety mechanism. See stdlib_error_type,
// return_error_type_at, try_operand_error_type, and checks/body/try_checks.rs.
// ---------------------------------------------------------------------------

// crate::hir::number_literal_type_name reproduced: a numeric literal is Float iff
// its text contains a `.` (code point 46), else Int (`1e5` has no `.` => Int).
fn number_literal_root(text: read String) -> String {
    let cs = String.chars(value: read text)
    let n = List.len(list: read cs)
    let mut i = 0
    let mut isFloat = false
    while i < n {
        if Char.to_code(value: read List.get(list: read cs, index: read i)) == 46 { isFloat = true }
        i = i + 1
    }
    if isFloat { return "Float" }
    return "Int"
}

// Conservative expression type-of: the type ROOT of the region [s0,e), or "" when
// not provably known. Only the SURE forms are typed:
//   * String / number / Char literal      · true|false -> Bool
//   * null -> JsonLiteral · Unit -> Unit  · None -> Option
//   * Some(...) -> Option · Ok|Err(...) -> Result
//   * a sum variant head -> its owning sum
//   * an unqualified call name(...) -> same-file fn return root, or a declared
//     type name it constructs
//   * a bare ident -> a let-typed local (recursively) or a declared-type param
// Anything else (Binary / Index / Field / qualified or receiver call / object /
// array / closure) -> "".
fn expr_type_root(toks: read List<Tok>, s0: read Int, e: read Int, bodyOpen: read Int, exprPos: read Int, popen: read Int, pclose: read Int, declared: read Set<String>, allFns: read Set<String>) -> String {
    let mut s = s0
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if s >= e { return "" }
    let k0 = tk_kind(toks: read toks, i: read s)
    if (s + 1) == e {
        if k0 == TOK_STRING { return "String" }
        if k0 == TOK_NUMBER { return number_literal_root(text: read tk_text(toks: read toks, i: read s)) }
        if k0 == TOK_CHAR { return "Char" }
    }
    if is_ident_tok(toks: read toks, i: read s) == false { return "" }
    let head = tk_text(toks: read toks, i: read s)
    if (s + 1) == e {
        if head == "true" || head == "false" { return "Bool" }
        if head == "null" { return "JsonLiteral" }
        if head == "Unit" { return "Unit" }
        if head == "None" { return "Option" }
    }
    let after = dotted_end(toks: read toks, i: read s)
    // A constructor / unqualified call spanning the whole region: `head ( ... )`.
    if after == (s + 1) && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read (s + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close != (e - 1) { return "" }
        if head == "Some" { return "Option" }
        if head == "Ok" || head == "Err" { return "Result" }
        let owner = variant_owner(toks: read toks, vname: read head)
        if String.len(value: read owner) > 0 { return owner }
        if Set.contains<String>(set: read allFns, value: read head) {
            return fn_return_root(toks: read toks, fnName: read head)
        }
        if Set.contains<String>(set: read declared, value: read head) { return head }
        return ""
    }
    // A bare, unqualified ident spanning the whole region.
    if after == (s + 1) && (s + 1) == e {
        let owner = variant_owner(toks: read toks, vname: read head)
        if String.len(value: read owner) > 0 { return owner }
        let lr = find_let_rhs_start(toks: read toks, bodyOpen: read bodyOpen, matchPos: read exprPos, name: read head)
        if lr >= 0 {
            let re = next_line_or_block_end(toks: read toks, start: read lr, end: read exprPos)
            return expr_type_root(toks: read toks, s0: read lr, e: read re, bodyOpen: read bodyOpen, exprPos: read lr, popen: read popen, pclose: read pclose, declared: read declared, allFns: read allFns)
        }
        if popen >= 0 && pclose >= 0 {
            return param_type_root(toks: read toks, open: read popen, close: read pclose, name: read head)
        }
        return ""
    }
    return ""
}

// The type root of a `?`-operand ending just before the `?` at `qPos`. Only the
// two operand shapes whose start is unambiguous token-level are typed: a call
// `name(...)?` (unqualified only) and a bare ident `x?`; anything else (qualified
// call, index, field, literal) -> "" (unknown => FP-safe).
fn try_operand_root(toks: read List<Tok>, qPos: read Int, bodyOpen: read Int, popen: read Int, pclose: read Int, declared: read Set<String>, allFns: read Set<String>) -> String {
    let prev = qPos - 1
    if prev <= bodyOpen { return "" }
    if at_symbol(toks: read toks, i: read prev, code: read SYM_RPAREN) {
        let mut d = 0
        let mut j = prev
        let mut op = -1
        while j > bodyOpen && op < 0 {
            if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) {
                d = d + 1
            } else if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
                d = d - 1
                if d == 0 { op = j }
            }
            j = j - 1
        }
        if op <= bodyOpen { return "" }
        let callee = op - 1
        if is_ident_tok(toks: read toks, i: read callee) == false { return "" }
        if at_symbol(toks: read toks, i: read (callee - 1), code: read SYM_DOT) { return "" }
        return expr_type_root(toks: read toks, s0: read callee, e: read qPos, bodyOpen: read bodyOpen, exprPos: read callee, popen: read popen, pclose: read pclose, declared: read declared, allFns: read allFns)
    }
    if is_ident_tok(toks: read toks, i: read prev) {
        if at_symbol(toks: read toks, i: read (prev - 1), code: read SYM_DOT) { return "" }
        return expr_type_root(toks: read toks, s0: read prev, e: read qPos, bodyOpen: read bodyOpen, exprPos: read prev, popen: read popen, pclose: read pclose, declared: read declared, allFns: read allFns)
    }
    return ""
}

// ===================================================================
// RS0208 RETURN_TYPE_MISMATCH — type-inference engine.
// Ports crates/rsscript/src/checks/calls.rs check_return_type/expr/payload +
// argument_type_matches. Baked into CHECKER_TARGET_CODES.
// ===================================================================

// The token range [ts, te) of a fn's declared return type (after `->`, up to the
// body `{` / `effects`). ok=false when the fn declares no return type.
struct RetRange {
    ts: Int
    te: Int
    ok: Bool
}

struct FileTypeModel {
    fnIdx: handle Map<String, Int>
    aliasIdx: handle Map<String, String>
    declared: handle Set<String>
    prefix: String
}

struct BodyTypeModel {
    locals: handle Map<String, List<Int>>
    bodyOpen: Int
    bodyClose: Int
    paramOpen: Int
    paramClose: Int
}

// Canonical string of a type token range, mirroring text_util type_ref_name:
// `Root<A, B>` (args joined ", "), `fresh X` / `owned X` / `noescape X` prefixes.
fn type_token_string(toks: read List<Tok>, ts: read Int, te: read Int) -> String {
    let mut sb = ""
    let mut i = ts
    while i < te {
        if at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            sb = String.concat(left: read sb, right: read ", ")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            sb = String.concat(left: read sb, right: read "<")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            sb = String.concat(left: read sb, right: read ">")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            sb = String.concat(left: read sb, right: read "(")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) {
            sb = String.concat(left: read sb, right: read ")")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_ARROW) {
            sb = String.concat(left: read sb, right: read " -> ")
        } else if is_ident_tok(toks: read toks, i: read i) {
            let t = tk_text(toks: read toks, i: read i)
            if t == "fresh" || t == "owned" || t == "noescape" {
                sb = String.concat(left: read String.concat(left: read sb, right: read t), right: read " ")
            } else {
                sb = String.concat(left: read sb, right: read t)
            }
        }
        i = i + 1
    }
    return sb
}

// The enclosing module path (`module rss.package.review` -> "rss.package.review"),
// or "" if the file declares no module. The analyzer canonicalizes a return-type
// annotation's module-local type names to this prefix (see qualified_type_string).
fn module_prefix(toks: read List<Tok>) -> String {
    let n = List.len(list: read toks)
    let mut i = 0
    while i < n {
        if is_kw_text(toks: read toks, i: read i, word: read "module") {
            if i == 0 || tk_line(toks: read toks, i: read (i - 1)) < tk_line(toks: read toks, i: read i) {
                return dotted_name_text(toks: read toks, i: read (i + 1))
            }
        }
        i = i + 1
    }
    return ""
}

// Like type_token_string, but a bare identifier naming a module-local declared type
// is canonicalized to `prefix.Name` — mirroring how the analyzer resolves a return
// annotation's type names to their module-qualified form. A name already preceded by
// a `.` (already qualified / a member) is left alone. Value typing does NOT qualify,
// so a generic-arg-derived value (`List<InterfaceSnapshot>.new()`) stays unqualified
// and correctly mismatches the qualified annotation.
fn qualified_type_string(toks: read List<Tok>, ts: read Int, te: read Int, prefix: read String, declared: read Set<String>) -> String {
    let mut sb = ""
    let mut i = ts
    while i < te {
        if at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            sb = String.concat(left: read sb, right: read ", ")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            sb = String.concat(left: read sb, right: read "<")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            sb = String.concat(left: read sb, right: read ">")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            sb = String.concat(left: read sb, right: read "(")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) {
            sb = String.concat(left: read sb, right: read ")")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_DOT) {
            sb = String.concat(left: read sb, right: read ".")
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_ARROW) {
            sb = String.concat(left: read sb, right: read " -> ")
        } else if is_ident_tok(toks: read toks, i: read i) {
            let t = tk_text(toks: read toks, i: read i)
            if t == "fresh" || t == "owned" || t == "noescape" {
                sb = String.concat(left: read String.concat(left: read sb, right: read t), right: read " ")
            } else {
                let prevDot = i > ts && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT)
                if String.len(value: read prefix) > 0 && prevDot == false && Set.contains<String>(set: read declared, value: read t) {
                    sb = String.concat(left: read sb, right: read String.concat(left: read String.concat(left: read prefix, right: read "."), right: read t))
                } else {
                    sb = String.concat(left: read sb, right: read t)
                }
            }
        }
        i = i + 1
    }
    return sb
}

// Index every non-generic file alias `type NAME = RHS`: NAME -> the canonical RHS type
// string. Built ONCE per file so expand_type_alias is O(1) map lookups instead of an O(n)
// token scan per lookup (which is O(calls * n) when typing every call argument for RS0207 —
// the same perf wall as the fn/local indices). Keeps the FIRST decl of a name, exactly as
// the former type_alias_rhs first-match scan did. Generic aliases (`type Pair<T> = ...`) map
// their RHS too, but type_token_string of a generic-param RHS is harmless (never matched).
fn collect_type_alias_index(toks: read List<Tok>) -> Map<String, String> {
    let n = List.len(list: read toks)
    let mut m = Map<String, String>.new()
    let mut i = 0
    while i < n {
        if is_kw_text(toks: read toks, i: read i, word: read "type") {
            let a = i + 1
            if is_ident_tok(toks: read toks, i: read a) && at_symbol(toks: read toks, i: read (a + 1), code: read SYM_EQ) {
                let nm = tk_text(toks: read toks, i: read a)
                if Map.contains_key<String, String>(map: read m, key: read nm) == false {
                    let ee = next_line_or_block_end(toks: read toks, start: read (a + 2), end: read n)
                    let rhs = type_token_string(toks: read toks, ts: read (a + 2), te: read ee)
                    Map.insert<String, String>(map: mut m, key: read nm, value: read rhs)
                }
            }
        }
        i = i + 1
    }
    return m
}

// Expand a bare type-alias root up to a small depth (alias-of-alias chains) via the O(1)
// alias index. A type that is not a bare declared alias is returned unchanged. Byte-for-byte
// equal to the former O(n)-scan expand_type_alias (same first-match RHS, same guard depth).
fn expand_type_alias(aliasIdx: read Map<String, String>, ty: read String) -> String {
    let mut cur = ty
    let mut guard = 0
    while guard < 4 {
        let rhs = Map.get_or_default<String, String>(map: read aliasIdx, key: read cur, default: read "")
        if String.len(value: read rhs) == 0 { return cur }
        cur = rhs
        guard = guard + 1
    }
    return cur
}

fn build_file_type_model(toks: read List<Tok>) -> FileTypeModel {
    return FileTypeModel(
        fnIdx: read collect_fn_decl_index(toks: read toks),
        aliasIdx: read collect_type_alias_index(toks: read toks),
        declared: read collect_declared_types(toks: read toks),
        prefix: module_prefix(toks: read toks)
    )
}

// The declared-return-type token range of a fn (handles fn generics `<...>`).
fn fn_return_range(toks: read List<Tok>, start: read Int) -> RetRange {
    let ns = fn_name_start(toks: read toks, i: read start)
    let mut p = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read p, code: read SYM_LANGLE) {
        let gc = find_matching(toks: read toks, open: read p, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gc < 0 { return RetRange(ts: 0, te: 0, ok: false) }
        p = gc + 1
    }
    if at_symbol(toks: read toks, i: read p, code: read SYM_LPAREN) == false { return RetRange(ts: 0, te: 0, ok: false) }
    let close = find_matching(toks: read toks, open: read p, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return RetRange(ts: 0, te: 0, ok: false) }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return RetRange(ts: 0, te: 0, ok: false) }
    let rts = close + 2
    let n = List.len(list: read toks)
    let mut e = rts
    let mut depth = 0
    let mut scanning = true
    while scanning {
        if e >= n {
            scanning = false
        } else if depth == 0 && at_symbol(toks: read toks, i: read e, code: read SYM_LBRACE) {
            scanning = false
        } else if depth == 0 && is_kw_text(toks: read toks, i: read e, word: read "effects") {
            scanning = false
        } else if depth == 0 && is_decl_start_kw(toks: read toks, i: read e) {
            scanning = false
        } else {
            if at_symbol(toks: read toks, i: read e, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read e, code: read SYM_LPAREN) {
                depth = depth + 1
            } else if at_symbol(toks: read toks, i: read e, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read e, code: read SYM_RPAREN) {
                depth = depth - 1
            }
            e = e + 1
        }
    }
    return RetRange(ts: rts, te: e, ok: true)
}

// A token that begins a top-level declaration — used to bound a body-less fn
// signature's return type (which ends at the next decl, not a `{`).
fn is_decl_start_kw(toks: read List<Tok>, i: read Int) -> Bool {
    return is_kw_text(toks: read toks, i: read i, word: read "fn") || is_kw_text(toks: read toks, i: read i, word: read "pub") || is_kw_text(toks: read toks, i: read i, word: read "struct") || is_kw_text(toks: read toks, i: read i, word: read "class") || is_kw_text(toks: read toks, i: read i, word: read "resource") || is_kw_text(toks: read toks, i: read i, word: read "const") || is_kw_text(toks: read toks, i: read i, word: read "module") || is_kw_text(toks: read toks, i: read i, word: read "use") || is_kw_text(toks: read toks, i: read i, word: read "protocol") || is_kw_text(toks: read toks, i: read i, word: read "impl") || is_kw_text(toks: read toks, i: read i, word: read "native") || is_kw_text(toks: read toks, i: read i, word: read "opaque") || is_kw_text(toks: read toks, i: read i, word: read "async") || is_kw_text(toks: read toks, i: read i, word: read "features")
}

// (declared_fn_return / declared_qualified_return were replaced by the O(1)
// collect_fn_decl_index + return_type_at_fn lookups used inside return_actual_type.)

// The OPERATION range of a select-arm binding `name = OP => { ... }` before matchPos,
// or ok=false. Reuses RetRange as (opStart, fatArrowPos, ok).
fn find_select_binding(toks: read List<Tok>, bodyOpen: read Int, matchPos: read Int, name: read String) -> RetRange {
    let mut k = bodyOpen + 1
    let mut result = RetRange(ts: 0, te: 0, ok: false)
    while k < matchPos {
        if is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == name && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_EQ) {
            let mut j = k + 2
            let mut depth = 0
            let mut fat = 0 - 1
            let mut scanning = true
            while scanning {
                if j >= matchPos {
                    scanning = false
                } else if depth == 0 && at_symbol(toks: read toks, i: read j, code: read SYM_FATARROW) {
                    fat = j
                    scanning = false
                } else {
                    if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read j, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
                        depth = depth + 1
                    } else if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read j, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read j, code: read SYM_RBRACE) {
                        depth = depth - 1
                    }
                    j = j + 1
                }
            }
            if fat > (k + 2) { result = RetRange(ts: k + 2, te: fat, ok: true) }
        }
        k = k + 1
    }
    return result
}

// The EXPR range of a `with EXPR as name { ... }` binding before matchPos, or ok=false.
// Reuses RetRange as (exprStart, asPos, ok).
fn with_binding_expr(toks: read List<Tok>, bodyOpen: read Int, matchPos: read Int, name: read String) -> RetRange {
    let mut k = bodyOpen + 1
    let mut result = RetRange(ts: 0, te: 0, ok: false)
    while k < matchPos {
        if is_kw_text(toks: read toks, i: read k, word: read "with") {
            let exprStart = k + 1
            let mut j = k + 1
            let mut depth = 0
            let mut asPos = 0 - 1
            let mut scanning = true
            while scanning {
                if j >= matchPos {
                    scanning = false
                } else if depth == 0 && at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
                    scanning = false
                } else if depth == 0 && is_kw_text(toks: read toks, i: read j, word: read "as") {
                    asPos = j
                    scanning = false
                } else {
                    if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read j, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
                        depth = depth + 1
                    } else if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read j, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read j, code: read SYM_RBRACE) {
                        depth = depth - 1
                    }
                    j = j + 1
                }
            }
            if asPos >= 0 && is_ident_tok(toks: read toks, i: read (asPos + 1)) && tk_text(toks: read toks, i: read (asPos + 1)) == name {
                result = RetRange(ts: exprStart, te: asPos, ok: true)
            }
        }
        k = k + 1
    }
    return result
}

// Index every file `fn` declaration: key -> the `fn` token index. An unqualified
// `fn foo` is keyed "foo"; a qualified `fn Ns.method` is keyed "Ns.method". Built ONCE
// per file so the return/param-type lookups inside return_actual_type are O(1) instead
// of an O(n) token scan per call/argument (which is otherwise O(calls * n) — the perf
// wall that reverted RS0207). Mirrors the fn-matching shape of declared_fn_return /
// declared_qualified_return; keeps the FIRST decl of a name (same as those scanners).
fn collect_fn_decl_index(toks: read List<Tok>) -> Map<String, Int> {
    let n = List.len(list: read toks)
    let mut m = Map<String, Int>.new()
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let a = i + 1
            if is_ident_tok(toks: read toks, i: read a) {
                if at_symbol(toks: read toks, i: read (a + 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (a + 2)) {
                    let key = String.concat(left: read String.concat(left: read tk_text(toks: read toks, i: read a), right: read "."), right: read tk_text(toks: read toks, i: read (a + 2)))
                    if Map.contains_key<String, Int>(map: read m, key: read key) == false { Map.insert<String, Int>(map: mut m, key: read key, value: read i) }
                } else {
                    let key2 = tk_text(toks: read toks, i: read a)
                    if Map.contains_key<String, Int>(map: read m, key: read key2) == false { Map.insert<String, Int>(map: mut m, key: read key2, value: read i) }
                }
            }
        }
        i = i + 1
    }
    return m
}

// The full canonical return type of the fn whose declaration begins at token `fnTok`
// (a `fn` keyword), or "" if it has no explicit return annotation. Mirrors the
// fn_return_range + type_token_string body of declared_fn_return / declared_qualified_return.
fn return_type_at_fn(toks: read List<Tok>, fnTok: read Int) -> String {
    let rr = fn_return_range(toks: read toks, start: read fnTok)
    if rr.ok { return type_token_string(toks: read toks, ts: read rr.ts, te: read rr.te) }
    return ""
}

// The type of parameter `label` of the fn whose declaration begins at token `fnTok`
// (a `fn` keyword), or "" if it has no such labeled parameter.
fn param_type_at_fn(toks: read List<Tok>, fnTok: read Int, label: read String) -> String {
    let a = fnTok + 1
    let mut pp = dotted_end(toks: read toks, i: read a)
    if at_symbol(toks: read toks, i: read pp, code: read SYM_LANGLE) {
        let gc = find_matching(toks: read toks, open: read pp, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gc >= 0 { pp = gc + 1 }
    }
    if at_symbol(toks: read toks, i: read pp, code: read SYM_LPAREN) {
        let pc = find_matching(toks: read toks, open: read pp, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if pc >= 0 { return param_type_string(toks: read toks, open: read pp, close: read pc, name: read label) }
    }
    return ""
}

// Per-fn local index: name -> ascending list of the `let/local` keyword token indices
// that declare it, over [bodyOpen, bodyClose). Built ONCE per fn body so that resolving a
// bare-ident's binding is O(occurrences-of-name) instead of find_let_rhs_start's O(body)
// token scan per lookup. The stored positions are exactly the `k` values find_let_rhs_start
// would visit as candidates for that name (same `mut` skip, same is_ident test), so
// find_let_rhs_fast reproduces its result byte-for-byte — including redeclaration, since
// the lookup replays the same stmtEnd/eq computation bounded by matchPos.
fn build_local_index(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int) -> Map<String, List<Int>> {
    let mut m = Map<String, List<Int>>.new()
    let empty = List<Int>.new()
    let mut hasWithSel = false
    let mut k = bodyOpen + 1
    while k < bodyClose {
        let isLet = is_kw_text(toks: read toks, i: read k, word: read "let") || is_kw_text(toks: read toks, i: read k, word: read "local")
        if isLet {
            let mut j = k + 1
            if is_kw_text(toks: read toks, i: read j, word: read "mut") { j = j + 1 }
            if is_ident_tok(toks: read toks, i: read j) {
                let nm = tk_text(toks: read toks, i: read j)
                let mut cur = Map.get_or_default<String, List<Int>>(map: read m, key: read nm, default: read empty)
                List.push<Int>(list: mut cur, value: read k)
                Map.insert<String, List<Int>>(map: mut m, key: read nm, value: read cur)
            }
        }
        if is_kw_text(toks: read toks, i: read k, word: read "with") || is_kw_text(toks: read toks, i: read k, word: read "select") { hasWithSel = true }
        k = k + 1
    }
    // Sentinel (key " ws" — a space is not a valid identifier char, so it cannot
    // collide with a real local) records whether the body uses `with`/`select`, so
    // return_actual_type can skip the O(body) with_binding_expr / find_select_binding
    // scans entirely for the common case (they are otherwise hit per non-local ident).
    if hasWithSel { Map.insert<String, List<Int>>(map: mut m, key: read " ws", value: read empty) }
    return m
}

fn build_body_type_model(toks: read List<Tok>, fnStart: read Int) -> BodyTypeModel {
    let ns = fn_name_start(toks: read toks, i: read fnStart)
    let bo = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read bo, code: read SYM_LBRACE) == false {
        let empty = Map<String, List<Int>>.new()
        return BodyTypeModel(locals: read empty, bodyOpen: 0 - 1, bodyClose: 0 - 1, paramOpen: 0 - 1, paramClose: 0 - 1)
    }
    let bc = find_matching(toks: read toks, open: read bo, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bc < 0 {
        let empty2 = Map<String, List<Int>>.new()
        return BodyTypeModel(locals: read empty2, bodyOpen: 0 - 1, bodyClose: 0 - 1, paramOpen: 0 - 1, paramClose: 0 - 1)
    }
    let mut pp = dotted_end(toks: read toks, i: read ns)
    if at_symbol(toks: read toks, i: read pp, code: read SYM_LANGLE) {
        let gc = find_matching(toks: read toks, open: read pp, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gc >= 0 { pp = gc + 1 }
    }
    let mut popen = 0 - 1
    let mut pclose = 0 - 1
    if at_symbol(toks: read toks, i: read pp, code: read SYM_LPAREN) {
        let pc = find_matching(toks: read toks, open: read pp, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if pc >= 0 {
            popen = pp
            pclose = pc
        }
    }
    return BodyTypeModel(
        locals: read build_local_index(toks: read toks, bodyOpen: read bo, bodyClose: read bc),
        bodyOpen: bo,
        bodyClose: bc,
        paramOpen: popen,
        paramClose: pclose
    )
}

fn body_type_model_ok(body: read BodyTypeModel) -> Bool {
    return body.bodyOpen >= 0 && body.bodyClose >= 0
}

// O(1)-amortized replacement for find_let_rhs_start using the per-fn local index: the
// RHS-start of the MOST RECENT `let/local name` declaration before matchPos, or -1. Visits
// only the recorded declarations of `name` (ascending), replaying find_let_rhs_start's exact
// per-candidate rule (mut skip, next_line_or_block_end bounded by matchPos, find_top_sym for
// the same-statement `=`), so the result is identical to the O(body) scan.
fn find_let_rhs_fast(toks: read List<Tok>, matchPos: read Int, name: read String, locals: read Map<String, List<Int>>) -> Int {
    let mut best = 0 - 1
    match Map.get<String, List<Int>>(map: read locals, key: read name) {
        Some(list) => {
            let cnt = List.len<Int>(list: read list)
            let mut idx = 0
            let mut scanning = true
            while scanning {
                if idx >= cnt {
                    scanning = false
                } else {
                    let k = List.get<Int>(list: read list, index: read idx)
                    if k >= matchPos {
                        scanning = false
                    } else {
                        let mut j = k + 1
                        if is_kw_text(toks: read toks, i: read j, word: read "mut") { j = j + 1 }
                        if is_ident_tok(toks: read toks, i: read j) && tk_text(toks: read toks, i: read j) == name {
                            let stmtEnd = next_line_or_block_end(toks: read toks, start: read k, end: read matchPos)
                            let eq = find_top_sym(toks: read toks, start: read j, end: read stmtEnd, code: read SYM_EQ)
                            if eq >= 0 { best = eq + 1 }
                        }
                        idx = idx + 1
                    }
                }
            }
        }
        None => {
        }
    }
    return best
}

// hir_expr_type_name for the FP-safe subset (literals, builtins, variant-call
// wildcards). Everything else -> "" (unknown); we never over-claim a type, so we
// never false-positive — at worst a false-negative that keeps the code unbaked.
// fnIdx / locals are the precomputed O(1) indices (see collect_fn_decl_index /
// build_local_index) that replace the former O(n)/O(body) declared_fn_return /
// declared_qualified_return / find_let_rhs_start scans; results are unchanged.
fn return_actual_type(toks: read List<Tok>, s0: read Int, e: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> String {
    let mut s = s0
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if is_kw_text(toks: read toks, i: read s, word: read "manage") { s = s + 1 }
    if is_kw_text(toks: read toks, i: read s, word: read "await") || is_kw_text(toks: read toks, i: read s, word: read "spawn") { s = s + 1 }
    if s >= e { return "" }
    let k0 = tk_kind(toks: read toks, i: read s)
    if (s + 1) == e {
        if k0 == TOK_STRING { return "String" }
        if k0 == TOK_NUMBER { return number_literal_root(text: read tk_text(toks: read toks, i: read s)) }
        if k0 == TOK_CHAR { return "Char" }
    }
    if is_ident_tok(toks: read toks, i: read s) == false { return "" }
    let head = tk_text(toks: read toks, i: read s)
    if (s + 1) == e {
        if head == "true" || head == "false" { return "Bool" }
        if head == "null" { return "JsonLiteral" }
        if head == "Unit" { return "Unit" }
        if head == "None" { return "Option<?>" }
        // Local `let/local NAME = ...` SHADOWS a same-named parameter, so resolve the
        // local FIRST (matchPos-bounded: only a decl before this reference wins). Falls
        // through to the parameter only when no local shadow precedes the reference. This
        // mirrors the analyzer's scoping (a param-first order mis-typed a shadowed ident).
        if bodyOpen >= 0 {
            let lr = find_let_rhs_fast(toks: read toks, matchPos: read s0, name: read head, locals: read locals)
            if lr >= 0 {
                let re2 = stmt_expr_end(toks: read toks, start: read lr, end: read s0)
                return return_actual_type(toks: read toks, s0: read lr, e: read re2, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
            }
        }
        if popen >= 0 && pclose >= 0 {
            let pt = param_type_string(toks: read toks, open: read popen, close: read pclose, name: read head)
            if String.len(value: read pt) > 0 { return pt }
        }
        if bodyOpen >= 0 {
            if Map.contains_key<String, List<Int>>(map: read locals, key: read " ws") {
                let wb = with_binding_expr(toks: read toks, bodyOpen: read bodyOpen, matchPos: read s0, name: read head)
                if wb.ok {
                    let te2 = wb.te
                    if te2 > wb.ts && at_symbol(toks: read toks, i: read (te2 - 1), code: read SYM_QUESTION) {
                        // `with EXPR? as name`: name binds the Ok payload of EXPR, fresh-stripped.
                        let inner = return_actual_type(toks: read toks, s0: read wb.ts, e: read (te2 - 1), popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
                        let payload = str_top_arg(s: read inner, which: read 0)
                        if String.len(value: read payload) > 0 { return str_strip_fresh(s: read payload) }
                    } else {
                        // `with EXPR as name` (no `?`): name binds the whole EXPR value type.
                        let whole = return_actual_type(toks: read toks, s0: read wb.ts, e: read te2, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
                        if String.len(value: read whole) > 0 { return whole }
                    }
                }
                let sb = find_select_binding(toks: read toks, bodyOpen: read bodyOpen, matchPos: read s0, name: read head)
                if sb.ok {
                    return return_actual_type(toks: read toks, s0: read sb.ts, e: read sb.te, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
                }
            }
        }
    }
    // Method chain `EXPR.ok()`: Result<T, E> -> Option<T>.
    if (e - s) >= 4 && at_symbol(toks: read toks, i: read (e - 1), code: read SYM_RPAREN) && at_symbol(toks: read toks, i: read (e - 2), code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (e - 3)) && tk_text(toks: read toks, i: read (e - 3)) == "ok" && at_symbol(toks: read toks, i: read (e - 4), code: read SYM_DOT) {
        let inner = return_actual_type(toks: read toks, s0: read s, e: read (e - 4), popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
        if str_type_root(s: read inner) == "Result" {
            let t = str_top_arg(s: read inner, which: read 0)
            if String.len(value: read t) > 0 { return String.concat(left: read String.concat(left: read "Option<", right: read t), right: read ">") }
        }
    }
    let after = dotted_end(toks: read toks, i: read s)
    if after == (s + 1) && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read (s + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == (e - 1) {
            if head == "Some" { return "Option<?>" }
            if head == "Ok" || head == "Err" { return "Result<?>" }
            let ft = Map.get_or_default<String, Int>(map: read fnIdx, key: read head, default: read (0 - 1))
            if ft >= 0 {
                let dr = return_type_at_fn(toks: read toks, fnTok: read ft)
                if String.len(value: read dr) > 0 { return dr }
            }
        }
    }
    // Qualified stdlib call `Ns.method(...)` spanning the whole region.
    if after > (s + 1) && at_symbol(toks: read toks, i: read after, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read after, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == (e - 1) {
            let method = tk_text(toks: read toks, i: read (after - 1))
            let qkey = String.concat(left: read String.concat(left: read head, right: read "."), right: read method)
            let qt = Map.get_or_default<String, Int>(map: read fnIdx, key: read qkey, default: read (0 - 1))
            if qt >= 0 {
                let declared = return_type_at_fn(toks: read toks, fnTok: read qt)
                if String.len(value: read declared) > 0 { return declared }
            }
            let rt = stdlib_return_type(ns: read head, method: read method)
            if String.len(value: read rt) > 0 { return rt }
        }
    }
    // Generic stdlib call `List.fold<A, Acc>(...)` -> Acc: the accumulator type is
    // the last explicit generic argument, typed from its syntactic (unqualified) form.
    if after > (s + 1) && at_symbol(toks: read toks, i: read after, code: read SYM_LANGLE) {
        let gcf = find_matching(toks: read toks, open: read after, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gcf >= 0 && at_symbol(toks: read toks, i: read (gcf + 1), code: read SYM_LPAREN) {
            let closef = find_matching(toks: read toks, open: read (gcf + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if closef == (e - 1) {
                let methodf = tk_text(toks: read toks, i: read (after - 1))
                if head == "List" && methodf == "fold" {
                    let cpos = find_top_sym(toks: read toks, start: read (after + 1), end: read gcf, code: read SYM_COMMA)
                    if cpos >= 0 { return type_token_string(toks: read toks, ts: read (cpos + 1), te: read gcf) }
                }
            }
        }
    }
    // Generic constructor `Ns<Args>.new(...)` -> `Ns<Args>` (collection constructors
    // return their own generic type).
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LANGLE) {
        let gc = find_matching(toks: read toks, open: read (s + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if gc >= 0 && at_symbol(toks: read toks, i: read (gc + 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (gc + 2)) && tk_text(toks: read toks, i: read (gc + 2)) == "new" && at_symbol(toks: read toks, i: read (gc + 3), code: read SYM_LPAREN) {
            let close2 = find_matching(toks: read toks, open: read (gc + 3), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close2 == (e - 1) {
                return type_token_string(toks: read toks, ts: read s, te: read (gc + 1))
            }
        }
    }
    return ""
}

// enum_variant_payload (calls.rs): a bare `None`, or a single-unnamed-arg
// `Ok(x)`/`Err(x)`/`Some(x)` call (leading effect unwrapped). Result fields:
// name = variant or "", hasPayload, and payload range [ps, pe).
struct VarPay {
    name: String
    hasPayload: Bool
    ps: Int
    pe: Int
}

fn variant_payload(toks: read List<Tok>, s0: read Int, e: read Int) -> VarPay {
    let mut s = s0
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if s >= e { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    if is_ident_tok(toks: read toks, i: read s) == false { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    let head = tk_text(toks: read toks, i: read s)
    if (s + 1) == e && head == "None" { return VarPay(name: "None", hasPayload: false, ps: 0, pe: 0) }
    let isVar = head == "Ok" || head == "Err" || head == "Some"
    if isVar == false { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN) == false { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    let close = find_matching(toks: read toks, open: read (s + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close != (e - 1) { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    // single unnamed arg: no top-level comma, and no leading `label :`
    let ps = s + 2
    let pe = close
    if ps >= pe { return VarPay(name: "", hasPayload: false, ps: 0, pe: 0) }
    if find_top_sym(toks: read toks, start: read ps, end: read pe, code: read SYM_COMMA) >= 0 {
        return VarPay(name: "", hasPayload: false, ps: 0, pe: 0)
    }
    if is_ident_tok(toks: read toks, i: read ps) && at_symbol(toks: read toks, i: read (ps + 1), code: read SYM_COLON) {
        return VarPay(name: "", hasPayload: false, ps: 0, pe: 0)
    }
    return VarPay(name: head, hasPayload: true, ps: ps, pe: pe)
}

// expected_variant_payload_type (calls.rs): the payload type a variant expects,
// given the enclosing Option/Result type string. "" when not applicable.
fn expected_variant_payload(expected: read String, variant: read String) -> String {
    let root = str_type_root(s: read expected)
    if root == "Option" && variant == "None" { return "Unit" }
    if root == "Option" && variant == "Some" { return str_top_arg(s: read expected, which: read 0) }
    if root == "Result" && variant == "Ok" { return str_top_arg(s: read expected, which: read 0) }
    if root == "Result" && variant == "Err" { return str_top_arg(s: read expected, which: read 1) }
    return ""
}

// check_return_payload_type (calls.rs): recursively validate a variant payload
// against its expected type. Returns true if a mismatch is found.
fn payload_mismatch(toks: read List<Tok>, ps: read Int, pe: read Int, expected: read String, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let vp = variant_payload(toks: read toks, s0: read ps, e: read pe)
    let ep = expected_variant_payload(expected: read expected, variant: read vp.name)
    if String.len(value: read vp.name) > 0 && String.len(value: read ep) > 0 {
        if vp.hasPayload {
            return payload_mismatch(toks: read toks, ps: read vp.ps, pe: read vp.pe, expected: read ep, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
        }
        if ep != "Unit" { return true }
        return false
    }
    let actual = return_actual_type(toks: read toks, s0: read ps, e: read pe, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    if String.len(value: read actual) == 0 { return false }
    if str_is_unresolved_generic(s: read actual) { return false }
    if arg_type_matches(expected: read expected, actual: read actual) == false { return true }
    return false
}

// check_return_expr_type (calls.rs) for one `return <expr>` at [s, e).
fn return_expr_mismatch(toks: read List<Tok>, s: read Int, e: read Int, expected: read String, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let root = str_type_root(s: read expected)
    let a0 = str_top_arg(s: read expected, which: read 0)
    let a1 = str_top_arg(s: read expected, which: read 1)
    if root == "Result" && String.len(value: read a1) > 0 {
        let vp = variant_payload(toks: read toks, s0: read s, e: read e)
        if vp.name == "Ok" {
            if vp.hasPayload { return payload_mismatch(toks: read toks, ps: read vp.ps, pe: read vp.pe, expected: read a0, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) }
            if a0 != "Unit" { return true }
            return false
        }
        if vp.name == "Err" {
            if vp.hasPayload { return payload_mismatch(toks: read toks, ps: read vp.ps, pe: read vp.pe, expected: read a1, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) }
            if a1 != "Unit" { return true }
            return false
        }
        let actual = return_actual_type(toks: read toks, s0: read s, e: read e, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
        if String.len(value: read actual) == 0 { return false }
        if str_is_unresolved_generic(s: read actual) { return false }
        if str_type_root(s: read actual) == "Result" {
            if arg_type_matches(expected: read expected, actual: read actual) == false { return true }
            return false
        }
        if arg_type_matches(expected: read a0, actual: read actual) == false { return true }
        return false
    }
    if root == "Option" && String.len(value: read a0) > 0 {
        let vp = variant_payload(toks: read toks, s0: read s, e: read e)
        if vp.name == "Some" {
            if vp.hasPayload { return payload_mismatch(toks: read toks, ps: read vp.ps, pe: read vp.pe, expected: read a0, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) }
            if a0 != "Unit" { return true }
            return false
        }
        if vp.name == "None" { return false }
        let actual = return_actual_type(toks: read toks, s0: read s, e: read e, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
        if String.len(value: read actual) == 0 { return false }
        if str_is_unresolved_generic(s: read actual) { return false }
        return arg_type_matches(expected: read expected, actual: read actual) == false
    }
    let actual = return_actual_type(toks: read toks, s0: read s, e: read e, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    if String.len(value: read actual) == 0 { return false }
    if str_is_unresolved_generic(s: read actual) { return false }
    // A variant wildcard (`Result<?>`/`Option<?>`) against a non-Result/Option
    // expected type may be a type alias that expands to Result/Option; we do not
    // expand aliases, so treat it as unknown (FP-safe) rather than a mismatch.
    if actual == "Result<?>" || actual == "Option<?>" { return false }
    if arg_type_matches(expected: read expected, actual: read actual) == false { return true }
    return false
}

// Walk one fn body's top-level `return <expr>` statements and check each.
fn fn_has_return_type_mismatch(toks: read List<Tok>, start: read Int, model: read FileTypeModel) -> Bool {
    let rr = fn_return_range(toks: read toks, start: read start)
    if rr.ok == false { return false }
    let expected = qualified_type_string(toks: read toks, ts: read rr.ts, te: read rr.te, prefix: read model.prefix, declared: read model.declared)
    if str_is_unresolved_generic(s: read expected) { return false }
    let body = build_body_type_model(toks: read toks, fnStart: read start)
    if body_type_model_ok(body: read body) == false { return false }
    let mut i = body.bodyOpen + 1
    let mut hit = false
    while i < body.bodyClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) && is_closure_brace(toks: read toks, b: read i) {
            let cc = find_matching(toks: read toks, open: read i, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if cc < 0 { i = body.bodyClose } else { i = cc + 1 }
        } else if is_kw_text(toks: read toks, i: read i, word: read "return") {
            let re = stmt_expr_end(toks: read toks, start: read (i + 1), end: read body.bodyClose)
            if (i + 1) < re {
                if return_expr_mismatch(toks: read toks, s: read (i + 1), e: read re, expected: read expected, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
            }
            i = i + 1
        } else {
            i = i + 1
        }
    }
    // Fallthrough: a non-Unit fn whose body can reach its end without returning
    // (oracle check_function_fallthrough). FP-safe subset: fire only when no depth-0
    // return/break/continue and no depth-0 if/match/select/with (any of which could
    // terminate all paths); an rss fn has no implicit tail-return, so a straight-line
    // body with no return is a definite fallthrough.
    if hit == false && str_type_root(s: read expected) != "Unit" {
        if body_falls_through(toks: read toks, bodyOpen: read body.bodyOpen, bodyClose: read body.bodyClose) { hit = true }
    }
    return hit
}

// End of a return-expr statement at `start`: the first token on a later line at
// bracket-depth 0, or a closing brace/paren/bracket that ends the enclosing block —
// unlike next_line_or_block_end, this stops at a same-line `}` (e.g. a match/select
// arm `_ => { return x }`), so the expression range does not swallow the arm's `}`.
fn stmt_expr_end(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    if start >= end { return end }
    let line = tk_line(toks: read toks, i: read start)
    let mut depth = 0
    let mut idx = start
    while idx < end {
        if tk_line(toks: read toks, i: read idx) > line { return idx }
        if at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACKET) {
            if depth == 0 { return idx }
            depth = depth - 1
        } else if at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACKET) {
            depth = depth + 1
        }
        idx = idx + 1
    }
    return end
}

// Conservative fallthrough test — see fn_has_return_type_mismatch.
fn body_falls_through(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int) -> Bool {
    let mut i = bodyOpen + 1
    let mut depth = 0
    let mut result = true
    let mut scanning = true
    while scanning {
        if i >= bodyClose {
            scanning = false
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
            i = i + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            depth = depth - 1
            i = i + 1
        } else if depth == 0 && (is_kw_text(toks: read toks, i: read i, word: read "return") || is_kw_text(toks: read toks, i: read i, word: read "break") || is_kw_text(toks: read toks, i: read i, word: read "continue") || is_kw_text(toks: read toks, i: read i, word: read "if") || is_kw_text(toks: read toks, i: read i, word: read "match") || is_kw_text(toks: read toks, i: read i, word: read "select") || is_kw_text(toks: read toks, i: read i, word: read "with")) {
            result = false
            scanning = false
        } else {
            i = i + 1
        }
    }
    return result
}

// A `{` that opens a closure body: preceded by `|` (param-list close), or by an
// explicit `|...| -> Type {` return annotation. Returns inside a closure belong to
// the closure, not the enclosing fn, so they must be skipped.
fn is_closure_brace(toks: read List<Tok>, b: read Int) -> Bool {
    let p = b - 1
    if p < 0 { return false }
    if at_symbol(toks: read toks, i: read p, code: read SYM_PIPE) { return true }
    let mut q = p
    let mut guard = 0
    let mut scanning = true
    while scanning {
        if q < 0 || guard >= 30 {
            scanning = false
        } else if at_symbol(toks: read toks, i: read q, code: read SYM_ARROW) {
            if q >= 1 && at_symbol(toks: read toks, i: read (q - 1), code: read SYM_PIPE) { return true }
            return false
        } else if is_ident_tok(toks: read toks, i: read q) || at_symbol(toks: read toks, i: read q, code: read SYM_DOT) || at_symbol(toks: read toks, i: read q, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) {
            q = q - 1
            guard = guard + 1
        } else {
            scanning = false
        }
    }
    return false
}

// True iff the closure whose body brace is `b` has an EMPTY parameter list (`|| {` or
// `|| -> T {`). Such a closure introduces no bindings that could shadow an enclosing
// name, so the RS0207 arg walker can safely descend into it and resolve captured
// identifiers against the enclosing fn scope (a parameterized closure is still skipped,
// since its params would mis-resolve). Detects adjacent param pipes (`| |`).
fn closure_paramless(toks: read List<Tok>, b: read Int) -> Bool {
    let mut q = b - 1
    let mut guard = 0
    let mut scanning = true
    let mut pipePos = 0 - 1
    while scanning {
        if q < 0 || guard >= 30 {
            scanning = false
        } else if at_symbol(toks: read toks, i: read q, code: read SYM_PIPE) {
            pipePos = q
            scanning = false
        } else if is_ident_tok(toks: read toks, i: read q) || at_symbol(toks: read toks, i: read q, code: read SYM_DOT) || at_symbol(toks: read toks, i: read q, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read q, code: read SYM_COMMA) || at_symbol(toks: read toks, i: read q, code: read SYM_ARROW) {
            q = q - 1
            guard = guard + 1
        } else {
            scanning = false
        }
    }
    if pipePos < 1 { return false }
    return at_symbol(toks: read toks, i: read (pipePos - 1), code: read SYM_PIPE)
}

// Walk all top-level fns and report any RS0208 return-type mismatch.
fn has_return_type_mismatch(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    // File type model: built ONCE, shared across all fns for O(1) return/type lookups.
    let model = build_file_type_model(toks: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_return_type_mismatch(toks: read toks, start: read i, model: read model) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// Generated stdlib parameter types are intentionally consumed through an FP-safe
// allowlist. The generated `selfhost.interfaces` table is broader than the
// current self-host type model: enabling it wholesale adds RS0207 alongside
// primary diagnostics (for example ResourcePool generics and malformed
// `&mut Buffer` surface syntax). The allowlist owns only "which call shapes are
// safe"; the actual type strings come from the real `.rssi` metadata.
fn stdlib_param_type_is_safe(ns: read String, method: read String, label: read String) -> Bool {
    if ns == "Log" && method == "write" && label == "message" { return true }
    if ns == "String" && method == "concat" && label == "left" { return true }
    if ns == "String" && method == "concat" && label == "right" { return true }
    if ns == "String" && method == "len" && label == "value" { return true }
    if ns == "File" && method == "write" && label == "data" { return true }
    if ns == "Image" && method == "inspect" && label == "image" { return true }
    if ns == "Image" && method == "normalize" && label == "image" { return true }
    if ns == "Image" && method == "resize" && label == "image" { return true }
    if ns == "Image" && method == "resize" && label == "width" { return true }
    if ns == "Image" && method == "resize" && label == "height" { return true }
    if ns == "Image" && method == "save" && label == "image" { return true }
    if ns == "Image" && method == "save" && label == "path" { return true }
    if ns == "Image" && method == "load" && label == "path" { return true }
    if ns == "Request" && method == "path" && label == "request" { return true }
    return false
}

fn stdlib_param_type(ns: read String, method: read String, label: read String) -> String {
    if stdlib_param_type_is_safe(ns: read ns, method: read method, label: read label) {
        return generated_stdlib_param_type(ns: read ns, method: read method, pname: read label)
    }
    return ""
}

// Count the comma-separated parameters of a closure whose param pipes are at
// openPipe and closePipe (0 for `||`). Commas nested in ()/[]/<> don't separate.
fn closure_param_count(toks: read List<Tok>, openPipe: read Int, closePipe: read Int) -> Int {
    if closePipe <= openPipe + 1 { return 0 }
    let mut i = openPipe + 1
    let mut depth = 0
    let mut angle = 0
    let mut count = 1
    while i < closePipe {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// RS0207 callback check: an argument `[as0, ae)` passed to a `Fn(...)-> ret` parameter
// should be a closure whose arity and return type match. Fires on (a) arity mismatch
// (closure params vs Fn arity) or (b) a closure-return expression whose inferred type is
// incompatible with the Fn return type (reusing return_expr_mismatch — Ok/Some-payload
// aware). A non-Fn param, a non-closure arg, or an un-typeable return => no fire
// (FP-safe). Closure PARAMS are not typed, so a return expr that uses them stays untyped.
// Map each closure parameter name (between openPipe and closePipe, e.g. `|value|` or
// `|a, b|`) to its type taken positionally from the Fn parameter type `fntype`
// (`Fn(Int) -> ..` => value:Int). Closure params carry no annotation, so the Fn type is
// the only type source. Params whose Fn arg type is unknown are omitted (=> not checked).
fn closure_param_types(toks: read List<Tok>, openPipe: read Int, closePipe: read Int, fntype: read String) -> Map<String, String> {
    let mut m = Map<String, String>.new()
    if closePipe <= openPipe + 1 { return m }
    let mut i = openPipe + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = openPipe + 1
    let mut idx = 0
    while i <= closePipe {
        let atEnd = i == closePipe
        let isComma = depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_COMMA)
        if atEnd || isComma {
            if is_ident_tok(toks: read toks, i: read segStart) {
                let ty = fn_type_arg_at(body: read fntype, which: read idx)
                if String.len(value: read ty) > 0 {
                    Map.insert<String, String>(map: mut m, key: read tk_text(toks: read toks, i: read segStart), value: read ty)
                }
            }
            idx = idx + 1
            segStart = i + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        }
        i = i + 1
    }
    return m
}

// Within a closure body [bodyStart, bodyEnd), find calls whose LABELED argument is a bare
// closure parameter (optionally `read`/`mut`/`take`-prefixed) whose Fn-derived type
// mismatches the callee's declared parameter type. This is the narrow-but-common
// "closure param passed straight into a call" case (RS0207 in a callback body), handled
// without threading closure-param types through return_actual_type. FP-safe: fires only
// when the callee param type and the closure-param type are both concrete and incompatible.
fn closure_body_arg_bad(toks: read List<Tok>, cptypes: read Map<String, String>, bodyStart: read Int, bodyEnd: read Int, fnIdx: read Map<String, Int>) -> Bool {
    let mut i = bodyStart
    let mut bad = false
    while i < bodyEnd {
        if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            let mut ns = ""
            if i >= 2 && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (i - 2)) {
                ns = tk_text(toks: read toks, i: read (i - 2))
            }
            let callee = tk_text(toks: read toks, i: read i)
            let cclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if cclose >= 0 {
                let mut k = i + 2
                let mut depth = 0
                let mut atArg = true
                while k < cclose {
                    if depth == 0 && atArg && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
                        let label = tk_text(toks: read toks, i: read k)
                        let cm = find_top_sym(toks: read toks, start: read (k + 2), end: read cclose, code: read SYM_COMMA)
                        let mut ve = cclose
                        if cm >= 0 { ve = cm }
                        let mut vs = k + 2
                        if is_effect_kw(toks: read toks, i: read vs) { vs = vs + 1 }
                        if (vs + 1) == ve && is_ident_tok(toks: read toks, i: read vs) {
                            let actual = Map.get_or_default<String, String>(map: read cptypes, key: read tk_text(toks: read toks, i: read vs), default: read "")
                            if String.len(value: read actual) > 0 {
                                let expected = resolve_param_type(toks: read toks, ns: read ns, name: read callee, label: read label, fnIdx: read fnIdx)
                                if String.len(value: read expected) > 0 && str_is_unresolved_generic(s: read expected) == false {
                                    if arg_type_matches(expected: read expected, actual: read actual) == false { bad = true }
                                }
                            }
                        }
                    }
                    atArg = false
                    if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
                        depth = depth + 1
                    } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
                        depth = depth - 1
                    } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
                        atArg = true
                    }
                    k = k + 1
                }
            }
        }
        i = i + 1
    }
    return bad
}

// True iff [s, e) is a single (optionally effect-prefixed) identifier that is NOT one of
// the closure's own parameters — i.e. a value CAPTURED from the enclosing scope. A closure
// that returns such a value cannot produce a `fresh` result (captured values are borrowed,
// not fresh), so returning one where a `fresh T` is required is RS0207. FP-safe: valid code
// never returns a captured value as fresh (a fresh result must be produced inside).
fn is_bare_captured(toks: read List<Tok>, s: read Int, e: read Int, cptypes: read Map<String, String>) -> Bool {
    let mut vs = s
    if is_effect_kw(toks: read toks, i: read vs) { vs = vs + 1 }
    if (vs + 1) != e { return false }
    if is_ident_tok(toks: read toks, i: read vs) == false { return false }
    let ct = Map.get_or_default<String, String>(map: read cptypes, key: read tk_text(toks: read toks, i: read vs), default: read "")
    if String.len(value: read ct) > 0 { return false }
    return true
}

fn callback_arg_bad(toks: read List<Tok>, as0: read Int, ae: read Int, pt: read String, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let body = strip_type_prefixes(s: read pt)
    let fnArity = fn_type_arity(body: read body)
    if fnArity < 0 { return false }
    if at_symbol(toks: read toks, i: read as0, code: read SYM_PIPE) == false { return false }
    let mut p = as0 + 1
    let mut cp = 0 - 1
    let mut sc = true
    while sc {
        if p >= ae {
            sc = false
        } else if at_symbol(toks: read toks, i: read p, code: read SYM_PIPE) {
            cp = p
            sc = false
        } else {
            p = p + 1
        }
    }
    if cp < 0 { return false }
    let clArity = closure_param_count(toks: read toks, openPipe: read as0, closePipe: read cp)
    if clArity != fnArity { return true }
    let ret = fn_type_return(body: read body)
    if String.len(value: read ret) == 0 { return false }
    let bs = cp + 1
    if bs >= ae { return false }
    // A parameterized closure: type its params from the Fn arg types and check any call in
    // the body that passes a bare closure param whose type mismatches the callee's param.
    let cptypes = closure_param_types(toks: read toks, openPipe: read as0, closePipe: read cp, fntype: read body)
    if at_symbol(toks: read toks, i: read bs, code: read SYM_LBRACE) {
        let bc = find_matching(toks: read toks, open: read bs, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if bc < 0 { return false }
        if closure_body_arg_bad(toks: read toks, cptypes: read cptypes, bodyStart: read (bs + 1), bodyEnd: read bc, fnIdx: read fnIdx) { return true }
        let freshRet = String.starts_with(value: read ret, prefix: read "fresh ")
        let mut i = bs + 1
        while i < bc {
            if is_kw_text(toks: read toks, i: read i, word: read "return") {
                let re = stmt_expr_end(toks: read toks, start: read (i + 1), end: read bc)
                if (i + 1) < re {
                    if freshRet && is_bare_captured(toks: read toks, s: read (i + 1), e: read re, cptypes: read cptypes) { return true }
                    if return_expr_mismatch(toks: read toks, s: read (i + 1), e: read re, expected: read ret, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { return true }
                }
            }
            i = i + 1
        }
        return false
    }
    if closure_body_arg_bad(toks: read toks, cptypes: read cptypes, bodyStart: read bs, bodyEnd: read ae, fnIdx: read fnIdx) { return true }
    if String.starts_with(value: read ret, prefix: read "fresh ") && is_bare_captured(toks: read toks, s: read bs, e: read ae, cptypes: read cptypes) { return true }
    return return_expr_mismatch(toks: read toks, s: read bs, e: read ae, expected: read ret, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
}

// Resolve a call parameter's declared type via the O(1) fn index: unqualified callee =>
// file fn; qualified callee => file `fn ns.method` (shadowing) else the generated
// stdlib interface table through the FP-safe allowlist above. A callee not in the
// index is stdlib/unknown (O(1)).
fn resolve_param_type(toks: read List<Tok>, ns: read String, name: read String, label: read String, fnIdx: read Map<String, Int>) -> String {
    if String.len(value: read ns) == 0 {
        let ft = Map.get_or_default<String, Int>(map: read fnIdx, key: read name, default: read (0 - 1))
        if ft < 0 { return "" }
        return param_type_at_fn(toks: read toks, fnTok: read ft, label: read label)
    }
    let key = String.concat(left: read String.concat(left: read ns, right: read "."), right: read name)
    let qt = Map.get_or_default<String, Int>(map: read fnIdx, key: read key, default: read (0 - 1))
    if qt >= 0 {
        let d = param_type_at_fn(toks: read toks, fnTok: read qt, label: read label)
        if String.len(value: read d) > 0 { return d }
    }
    return stdlib_param_type(ns: read ns, method: read name, label: read label)
}

// True iff the param segment [s, e) is a bare `name` (optionally effect-prefixed) with
// NO `: type` — i.e. an untyped parameter. The analyzer assigns such a param the empty
// type "", so passing it to a typed parameter fires RS0207 with actual == "".
fn seg_is_untyped_named(toks: read List<Tok>, s: read Int, e: read Int, name: read String) -> Bool {
    let mut t = s
    if t < e && is_effect_kw(toks: read toks, i: read t) { t = t + 1 }
    if t >= e { return false }
    if is_ident_tok(toks: read toks, i: read t) == false { return false }
    if tk_text(toks: read toks, i: read t) != name { return false }
    if (t + 1) >= e { return true }
    return false
}

// True iff `name` is a parameter of the fn whose param parens are (popen, pclose) and it
// was declared WITHOUT a type annotation. Only malformed signatures have untyped params
// (a valid fn types every param — RS0002/0003 otherwise), so firing on this is FP-safe.
fn is_untyped_param(toks: read List<Tok>, popen: read Int, pclose: read Int, name: read String) -> Bool {
    if popen < 0 || pclose <= popen { return false }
    let mut i = popen + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = popen + 1
    while i < pclose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            if seg_is_untyped_named(toks: read toks, s: read segStart, e: read i, name: read name) { return true }
            segStart = i + 1
        }
        i = i + 1
    }
    return seg_is_untyped_named(toks: read toks, s: read segStart, e: read pclose, name: read name)
}

// One positional argument [s, e) at index `idx` of a call whose callee is a Fn-typed
// param with body `cpt`. Fires when the arg's inferred type mismatches the Fn's idx-th
// arg type. Labeled args are skipped (callback calls are positional); un-typeable => skip.
fn positional_arg_bad(toks: read List<Tok>, s: read Int, e: read Int, idx: read Int, cpt: read String, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    if is_ident_tok(toks: read toks, i: read s) && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_COLON) { return false }
    let expected = fn_type_arg_at(body: read cpt, which: read idx)
    if String.len(value: read expected) == 0 { return false }
    let at = return_actual_type(toks: read toks, s0: read s, e: read e, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    if String.len(value: read at) == 0 { return false }
    if str_is_unresolved_generic(s: read at) { return false }
    return arg_type_matches(expected: read expected, actual: read at) == false
}

// RS0207: a call `callee(a, b, ...)` where `callee` is a Fn-typed PARAMETER of the
// enclosing fn (e.g. `return callback("x")` with `callback: noescape Fn(Int) -> Int`).
// Types each positional argument against the Fn parameter's declared arg types. Only a
// Fn-typed param triggers this (param_type_string => strip => `Fn(`), so it is FP-safe.
fn fn_param_call_bad(toks: read List<Tok>, callee: read String, open: read Int, close: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let cpt = strip_type_prefixes(s: read param_type_string(toks: read toks, open: read popen, close: read pclose, name: read callee))
    if String.starts_with(value: read cpt, prefix: read "Fn(") == false { return false }
    let mut i = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut argno = 0
    let mut bad = false
    while i < close {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            if positional_arg_bad(toks: read toks, s: read segStart, e: read i, idx: read argno, cpt: read cpt, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { bad = true }
            argno = argno + 1
            segStart = i + 1
        }
        i = i + 1
    }
    if segStart < close {
        if positional_arg_bad(toks: read toks, s: read segStart, e: read close, idx: read argno, cpt: read cpt, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { bad = true }
    }
    return bad
}

// RS0207 Slice 2: check each labeled argument of one call `callee(label: expr, ...)`
// against the declared parameter type of `callee` (resolve_param_type via the O(1) fn
// index). Fires when both the parameter type (alias-expanded) and the argument type
// (return_actual_type, now index-backed) are concrete and incompatible. UNKNOWN callee /
// param / arg => no fire (matches the oracle's skip-bias).
fn call_arg_type_bad(toks: read List<Tok>, ns: read String, callee: read String, open: read Int, close: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>, aliasIdx: read Map<String, String>, recvGeneric: read String) -> Bool {
    let mut depth = 0
    let mut atArgStart = true
    let mut bad = false
    if String.len(value: read ns) == 0 && fn_param_call_bad(toks: read toks, callee: read callee, open: read open, close: read close, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { bad = true }
    let mut k = open + 1
    while k < close {
        if depth == 0 && atArgStart && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let label = tk_text(toks: read toks, i: read k)
            let mut pt0 = resolve_param_type(toks: read toks, ns: read ns, name: read callee, label: read label, fnIdx: read fnIdx)
            if String.len(value: read pt0) == 0 && ns == "ResourcePool" && callee == "new" && label == "create" && String.len(value: read recvGeneric) > 0 {
                // ResourcePool<T>.new's factory param is `create: Fn() -> T` (T = the pool's
                // resource type from the receiver generic). Curated like stdlib_param_type,
                // but generic-substituted from the call site.
                pt0 = String.concat(left: read "Fn() -> ", right: read recvGeneric)
            }
            if String.len(value: read pt0) > 0 {
                let pt = expand_type_alias(aliasIdx: read aliasIdx, ty: read pt0)
                if str_is_unresolved_generic(s: read pt) == false {
                    let cm = find_top_sym(toks: read toks, start: read (k + 2), end: read close, code: read SYM_COMMA)
                    let mut ae = close
                    if cm >= 0 { ae = cm }
                    if (k + 2) < ae {
                        if callback_arg_bad(toks: read toks, as0: read (k + 2), ae: read ae, pt: read pt, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { bad = true }
                        let at = return_actual_type(toks: read toks, s0: read (k + 2), e: read ae, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
                        if String.len(value: read at) > 0 && str_is_unresolved_generic(s: read at) == false {
                            if arg_type_matches(expected: read pt, actual: read at) == false { bad = true }
                        } else if String.len(value: read at) == 0 {
                            let mut ai = k + 2
                            if is_effect_kw(toks: read toks, i: read ai) { ai = ai + 1 }
                            if (ai + 1) == ae && is_ident_tok(toks: read toks, i: read ai) {
                                if is_untyped_param(toks: read toks, popen: read popen, pclose: read pclose, name: read tk_text(toks: read toks, i: read ai)) { bad = true }
                            }
                        }
                    }
                }
            }
        }
        atArgStart = false
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            atArgStart = true
        }
        k = k + 1
    }
    return bad
}

// RS0207 ARGUMENT_TYPE_MISMATCH — Slice 1: an annotated binding
// `let/local NAME: TYPE = EXPR` whose initializer type is incompatible with the
// annotation (oracle check_binding_type, same argument_type_matches primitive as
// RS0208). Expected = the annotation (module-qualified); actual = return_actual_type
// of the initializer. Reuses return_expr_mismatch (Result/Option payload aware).
// UNKNOWN-biased: an un-typeable initializer yields "" => no fire, matching the
// oracle's skip-bias. Slice 2: each labeled call argument against the callee's declared
// parameter type (call_arg_type_bad), for qualified `ns.method(...)` and unqualified
// `callee(...)` call sites.
// --- Binary-operator parsing (ported from astdump.rss) — shared by the operator/
// control-flow type checks (RS0210, and future RS0209 arm typing). ---

// Two consecutive symbol tokens a,b at i (both within end).
fn two_sym(toks: read List<Tok>, i: read Int, end: read Int, a: read Int, b: read Int) -> Bool {
    if i + 1 >= end { return false }
    return at_symbol(toks: read toks, i: read i, code: read a) && at_symbol(toks: read toks, i: read (i + 1), code: read b)
}

// Token `open` is `<` opening a generic argument list (ident before, matching `>` followed
// by `.` or `(`), not a comparison — so its `<`/`>` are excluded from operator scanning.
fn is_generic_angle(toks: read List<Tok>, start: read Int, end: read Int, open: read Int) -> Bool {
    if open <= start { return false }
    if is_ident_tok(toks: read toks, i: read (open - 1)) == false { return false }
    if at_symbol(toks: read toks, i: read open, code: read SYM_LANGLE) == false { return false }
    let mut depth = 0
    let mut i = open
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            depth = depth - 1
            if depth == 0 {
                return at_symbol(toks: read toks, i: read (i + 1), code: read SYM_DOT) || at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN)
            }
        }
        i = i + 1
    }
    return false
}

// Does the operator at token i belong to precedence `tier`?
// tier: 1=|| 2=&& 3=| 4=^ 5=& 6=cmp(== != <= >= < >) 7=shift(<< >>) 8=+ - 9=* / %
fn op_matches_tier(toks: read List<Tok>, i: read Int, end: read Int, tier: read Int) -> Bool {
    if tier == 1 { return two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) }
    if tier == 2 { return two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) }
    if tier == 3 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) == false
    }
    if tier == 4 { return at_symbol(toks: read toks, i: read i, code: read SYM_CARET) }
    if tier == 5 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_AMP) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) == false
    }
    if tier == 6 {
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_EQ, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_BANG, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_EQ) { return true }
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) == false { return true }
        if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) == false { return true }
        return false
    }
    if tier == 7 {
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) { return true }
        return false
    }
    if tier == 8 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_PLUS) || at_symbol(toks: read toks, i: read i, code: read SYM_MINUS)
    }
    if tier == 9 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_STAR) || at_symbol(toks: read toks, i: read i, code: read SYM_SLASH) || at_symbol(toks: read toks, i: read i, code: read SYM_PERCENT)
    }
    return false
}

// Last top-level operator index for precedence `tier` in [start, end), or -1. Tracks
// (){}[] depth and generic `<...>` angles so only real depth-0 operators count.
fn scan_last_top_op(toks: read List<Tok>, start: read Int, end: read Int, tier: read Int) -> Int {
    let mut depth = 0
    let mut angle = 0
    let mut idx = start
    let mut found = 0 - 1
    while idx < end {
        if at_symbol(toks: read toks, i: read idx, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read idx, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read idx, code: read SYM_LANGLE) && is_generic_angle(toks: read toks, start: read start, end: read end, open: read idx) {
            angle = angle + 1
        } else if depth == 0 && angle > 0 {
            if at_symbol(toks: read toks, i: read idx, code: read SYM_LANGLE) { angle = angle + 1 }
            else if at_symbol(toks: read toks, i: read idx, code: read SYM_RANGLE) { angle = angle - 1 }
        } else if depth == 0 {
            if op_matches_tier(toks: read toks, i: read idx, end: read end, tier: read tier) {
                found = idx
            }
        }
        idx = idx + 1
    }
    return found
}

// Token width (1 or 2) of the operator at i.
fn binop_width_at(toks: read List<Tok>, i: read Int, end: read Int) -> Int {
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_EQ, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_BANG, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) { return 2 }
    return 1
}

// Lowest-precedence top-level operator split index in [start, end), or -1.
fn find_binop(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut tier = 1
    while tier <= 9 {
        let hit = scan_last_top_op(toks: read toks, start: read start, end: read end, tier: read tier)
        if hit >= 0 { return hit }
        tier = tier + 1
    }
    return 0 - 1
}

// RS0210 (OPERATOR_TYPE_MISMATCH): the top-level comparison operator in [start, end) has
// left and right operands of concrete, incompatible root types (`1 == "1"` => Int vs
// String). FP-safe: fires only when both operands type to concrete, non-generic, DIFFERENT
// roots — an un-typeable operand (nested expr, unknown ident) yields "" and is skipped.
// Type an operator operand [s, e). A single (effect-stripped) identifier that is a closure
// parameter (present in cptypes) resolves to its Fn-derived type; everything else goes
// through return_actual_type. cptypes is empty for ordinary (non-closure) contexts.
fn operand_type_cp(toks: read List<Tok>, s: read Int, e: read Int, cptypes: read Map<String, String>, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> String {
    let mut vs = s
    if is_effect_kw(toks: read toks, i: read vs) { vs = vs + 1 }
    if (vs + 1) == e && is_ident_tok(toks: read toks, i: read vs) {
        let ct = Map.get_or_default<String, String>(map: read cptypes, key: read tk_text(toks: read toks, i: read vs), default: read "")
        if String.len(value: read ct) > 0 { return ct }
    }
    return return_actual_type(toks: read toks, s0: read s, e: read e, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
}

fn operator_type_bad(toks: read List<Tok>, start: read Int, end: read Int, cptypes: read Map<String, String>, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    if start >= end { return false }
    let op = find_binop(toks: read toks, start: read start, end: read end)
    if op < 0 { return false }
    let isCmp = op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 6)
    let isLogical = op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 1) || op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 2)
    if isCmp == false && isLogical == false { return false }
    let width = binop_width_at(toks: read toks, i: read op, end: read end)
    if op <= start { return false }
    if (op + width) >= end { return false }
    let lo2 = op + width
    let lt = operand_type_cp(toks: read toks, s: read start, e: read op, cptypes: read cptypes, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    let rt = operand_type_cp(toks: read toks, s: read lo2, e: read end, cptypes: read cptypes, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    if isLogical {
        // `&&` / `||`: each concrete operand must be Bool.
        if String.len(value: read lt) > 0 && str_is_unresolved_generic(s: read lt) == false && str_strip_fresh(s: read lt) != "Bool" { return true }
        if String.len(value: read rt) > 0 && str_is_unresolved_generic(s: read rt) == false && str_strip_fresh(s: read rt) != "Bool" { return true }
        return false
    }
    // comparison: both operands must share a concrete root type.
    if String.len(value: read lt) == 0 || str_is_unresolved_generic(s: read lt) { return false }
    if String.len(value: read rt) == 0 || str_is_unresolved_generic(s: read rt) { return false }
    if str_strip_fresh(s: read lt) == str_strip_fresh(s: read rt) { return false }
    return true
}

// A closure argument `|params| body` passed where a `Fn(..)` is expected: type its params
// from the Fn arg types and check the (single-expr) body for an operator-type mismatch
// (`|value| value == "x"` with `Fn(Int) -> Bool` => value:Int vs String). Block bodies are
// not scanned here (the fn-body operator walker covers non-closure code).
fn closure_arg_operator_bad(toks: read List<Tok>, argStart: read Int, argEnd: read Int, fnType: read String, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    if at_symbol(toks: read toks, i: read argStart, code: read SYM_PIPE) == false { return false }
    let body = strip_type_prefixes(s: read fnType)
    if fn_type_arity(body: read body) < 0 { return false }
    let mut p = argStart + 1
    let mut cp = 0 - 1
    let mut sc = true
    while sc {
        if p >= argEnd {
            sc = false
        } else if at_symbol(toks: read toks, i: read p, code: read SYM_PIPE) {
            cp = p
            sc = false
        } else {
            p = p + 1
        }
    }
    if cp < 0 { return false }
    let cptypes = closure_param_types(toks: read toks, openPipe: read argStart, closePipe: read cp, fntype: read body)
    let bs = cp + 1
    if bs >= argEnd { return false }
    if at_symbol(toks: read toks, i: read bs, code: read SYM_LBRACE) { return false }
    return operator_type_bad(toks: read toks, start: read bs, end: read argEnd, cptypes: read cptypes, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
}

// Scan a call's labeled arguments for a closure passed to a `Fn`-typed parameter whose body
// has an operator-type mismatch (RS0210). Mirrors call_arg_type_bad's arg iteration.
fn call_closure_operator_bad(toks: read List<Tok>, ns: read String, callee: read String, open: read Int, close: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>, aliasIdx: read Map<String, String>) -> Bool {
    let mut k = open + 1
    let mut depth = 0
    let mut atArg = true
    let mut bad = false
    while k < close {
        if depth == 0 && atArg && is_ident_tok(toks: read toks, i: read k) && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let label = tk_text(toks: read toks, i: read k)
            let pt0 = resolve_param_type(toks: read toks, ns: read ns, name: read callee, label: read label, fnIdx: read fnIdx)
            if String.len(value: read pt0) > 0 {
                let pt = expand_type_alias(aliasIdx: read aliasIdx, ty: read pt0)
                let cm = find_top_sym(toks: read toks, start: read (k + 2), end: read close, code: read SYM_COMMA)
                let mut ae = close
                if cm >= 0 { ae = cm }
                if (k + 2) < ae {
                    if closure_arg_operator_bad(toks: read toks, argStart: read (k + 2), argEnd: read ae, fnType: read pt, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { bad = true }
                }
            }
        }
        atArg = false
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            atArg = true
        }
        k = k + 1
    }
    return bad
}

// Matching top-level `}` for an interpolation `{` opening at `start`, or -1 (ported from
// astdump.rss interp_end / find_interpolation_end): string literals are skipped; ([{ nest.
fn interp_end(cs: read List<Char>, n: read Int, start: read Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < n {
        let c = code_at(chars: read cs, n: read n, i: read i)
        if c == 34 {
            i = i + 1
            let mut inStr = true
            while i < n && inStr {
                let sc = code_at(chars: read cs, n: read n, i: read i)
                if sc == 92 {
                    i = i + 2
                } else if sc == 34 {
                    i = i + 1
                    inStr = false
                } else {
                    i = i + 1
                }
            }
        } else if c == 40 || c == 91 || c == 123 {
            depth = depth + 1
            i = i + 1
        } else if c == 41 || c == 93 {
            if depth > 0 { depth = depth - 1 }
            i = i + 1
        } else if c == 125 {
            if depth == 0 { return i }
            depth = depth - 1
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return 0 - 1
}

// Type one embedded interpolation expression (its text). Returns true if it resolves to a
// concrete non-String type — interpolation desugars to String.format over a List<String>,
// so a non-String interpolated value is RS0207 ("list literal item has type X, expected
// String"). A bare identifier is resolved by NAME against the enclosing scope (param, then
// local); other forms are typed via a fresh tokenization (literals, by-name calls).
// Un-typeable / String => false (FP-safe: valid code interpolates only Strings).
fn interp_nonstring_item(toks: read List<Tok>, itemText: read String, tokIdx: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let trimmed = str_trim(s: read itemText)
    if String.len(value: read trimmed) == 0 { return false }
    let sub = tokenize(source: read trimmed)
    let ns2 = List.len<Tok>(list: read sub)
    let mut stop = 0
    while stop < ns2 && tk_kind(toks: read sub, i: read stop) != TOK_EOF {
        stop = stop + 1
    }
    if stop == 0 { return false }
    let mut ty = ""
    if stop == 1 && tk_kind(toks: read sub, i: read 0) == TOK_IDENT {
        let name = tk_text(toks: read sub, i: read 0)
        if popen >= 0 && pclose >= 0 {
            ty = param_type_string(toks: read toks, open: read popen, close: read pclose, name: read name)
        }
        if String.len(value: read ty) == 0 && bodyOpen >= 0 {
            let lr = find_let_rhs_fast(toks: read toks, matchPos: read tokIdx, name: read name, locals: read locals)
            if lr >= 0 {
                let re2 = stmt_expr_end(toks: read toks, start: read lr, end: read tokIdx)
                ty = return_actual_type(toks: read toks, s0: read lr, e: read re2, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
            }
        }
    } else {
        let empty = Map<String, List<Int>>.new()
        ty = return_actual_type(toks: read sub, s0: read 0, e: read stop, popen: read (0 - 1), pclose: read (0 - 1), bodyOpen: read (0 - 1), fnIdx: read fnIdx, locals: read empty)
    }
    if String.len(value: read ty) == 0 { return false }
    if str_is_unresolved_generic(s: read ty) { return false }
    if str_strip_fresh(s: read ty) == "String" { return false }
    return true
}

// True if the interpolation token at tokIdx has an embedded expression of concrete
// non-String type (RS0207). Parses `{expr}` markers from the token text (mirrors
// emit_interp): `\`-escapes and `{{`/`}}` are literal; each `{expr}` is checked.
fn interp_has_nonstring(toks: read List<Tok>, tokIdx: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    let text = tk_text(toks: read toks, i: read tokIdx)
    let cs = String.chars(value: read text)
    let n = List.len<Char>(list: read cs)
    let mut i = 0
    while i < n {
        let c = code_at(chars: read cs, n: read n, i: read i)
        if c == 92 {
            i = i + 2
        } else if c == 123 && code_at(chars: read cs, n: read n, i: read (i + 1)) == 123 {
            i = i + 2
        } else if c == 125 && code_at(chars: read cs, n: read n, i: read (i + 1)) == 125 {
            i = i + 2
        } else if c == 123 {
            let close = interp_end(cs: read cs, n: read n, start: read (i + 1))
            if close < 0 {
                i = i + 1
            } else {
                let item = slice(chars: read cs, from: read (i + 1), to: read close)
                if interp_nonstring_item(toks: read toks, itemText: read item, tokIdx: read tokIdx, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals) { return true }
                i = close + 1
            }
        } else {
            i = i + 1
        }
    }
    return false
}

fn fn_has_binding_type_mismatch(toks: read List<Tok>, start: read Int, model: read FileTypeModel) -> Bool {
    let body = build_body_type_model(toks: read toks, fnStart: read start)
    if body_type_model_ok(body: read body) == false { return false }
    let mut i = body.bodyOpen + 1
    let mut hit = false
    while i < body.bodyClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) && is_closure_brace(toks: read toks, b: read i) && closure_paramless(toks: read toks, b: read i) == false {
            let cc = find_matching(toks: read toks, open: read i, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if cc < 0 { i = body.bodyClose } else { i = cc + 1 }
        } else if tk_kind(toks: read toks, i: read i) == TOK_INTERP {
            if interp_has_nonstring(toks: read toks, tokIdx: read i, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
            i = i + 1
        } else if is_kw_text(toks: read toks, i: read i, word: read "let") || is_kw_text(toks: read toks, i: read i, word: read "local") {
            let mut j = i + 1
            if is_kw_text(toks: read toks, i: read j, word: read "mut") { j = j + 1 }
            if is_ident_tok(toks: read toks, i: read j) && at_symbol(toks: read toks, i: read (j + 1), code: read SYM_COLON) {
                let stmtEnd = next_line_or_block_end(toks: read toks, start: read i, end: read body.bodyClose)
                let eq = find_top_sym(toks: read toks, start: read (j + 2), end: read stmtEnd, code: read SYM_EQ)
                if eq >= 0 {
                    let annotated = qualified_type_string(toks: read toks, ts: read (j + 2), te: read eq, prefix: read model.prefix, declared: read model.declared)
                    let expected = expand_type_alias(aliasIdx: read model.aliasIdx, ty: read annotated)
                    if str_is_unresolved_generic(s: read expected) == false && String.len(value: read expected) > 0 {
                        let ee = stmt_expr_end(toks: read toks, start: read (eq + 1), end: read body.bodyClose)
                        if (eq + 1) < ee {
                            if return_expr_mismatch(toks: read toks, s: read (eq + 1), e: read ee, expected: read expected, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
                        }
                    }
                }
            }
            i = i + 1
        } else if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (i - 2)) {
            let callNs = tk_text(toks: read toks, i: read (i - 2))
            let method = tk_text(toks: read toks, i: read i)
            let cclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if cclose >= 0 {
                if call_arg_type_bad(toks: read toks, ns: read callNs, callee: read method, open: read (i + 1), close: read cclose, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals, aliasIdx: read model.aliasIdx, recvGeneric: read "") { hit = true }
            }
            i = i + 1
        } else if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) && at_symbol(toks: read toks, i: read (i - 2), code: read SYM_RANGLE) {
            // Generic-receiver qualified call: `Ns<Args>.method(`. Walk back over the
            // matching `<..>` to the receiver ident; pass the generic args to the arg
            // checker (used to substitute the ResourcePool<T>.new factory type).
            let method = tk_text(toks: read toks, i: read i)
            let mut a = i - 2
            let mut ad = 0
            let mut ga = 0 - 1
            let mut sc = true
            while sc {
                if a < 0 {
                    sc = false
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_RANGLE) {
                    ad = ad + 1
                    a = a - 1
                } else if at_symbol(toks: read toks, i: read a, code: read SYM_LANGLE) {
                    ad = ad - 1
                    if ad == 0 {
                        ga = a
                        sc = false
                    } else {
                        a = a - 1
                    }
                } else {
                    a = a - 1
                }
            }
            if ga > 0 && is_ident_tok(toks: read toks, i: read (ga - 1)) {
                let callNs = tk_text(toks: read toks, i: read (ga - 1))
                let gen = type_token_string(toks: read toks, ts: read (ga + 1), te: read (i - 2))
                let cclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if cclose >= 0 {
                    if call_arg_type_bad(toks: read toks, ns: read callNs, callee: read method, open: read (i + 1), close: read cclose, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals, aliasIdx: read model.aliasIdx, recvGeneric: read gen) { hit = true }
                }
            }
            i = i + 1
        } else if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) == false && is_kw_text(toks: read toks, i: read (i - 1), word: read "fn") == false {
            let callee = tk_text(toks: read toks, i: read i)
            let cclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if cclose >= 0 {
                if call_arg_type_bad(toks: read toks, ns: read "", callee: read callee, open: read (i + 1), close: read cclose, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals, aliasIdx: read model.aliasIdx, recvGeneric: read "") { hit = true }
            }
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return hit
}

// Walk all top-level fns and report any RS0207 binding-type mismatch (Slice 1).
fn has_binding_type_mismatch(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let model = build_file_type_model(toks: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_binding_type_mismatch(toks: read toks, start: read i, model: read model) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// End of an `if`/`while` condition: the first depth-0 `{` after `start` (the body brace),
// tracking (){}[] paren/bracket depth so a call/index in the condition doesn't stop it.
fn cond_expr_end(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < limit {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            return i
        }
        i = i + 1
    }
    return 0 - 1
}

// RS0210: scan a fn body for `if`/`while` conditions whose top-level comparison has
// operands of incompatible concrete types. Shares the param/local setup of the RS0207
// walker so operands resolve against the fn's params and locals.
fn fn_has_operator_type_mismatch(toks: read List<Tok>, start: read Int, model: read FileTypeModel) -> Bool {
    let body = build_body_type_model(toks: read toks, fnStart: read start)
    if body_type_model_ok(body: read body) == false { return false }
    let noCp = Map<String, String>.new()
    let mut i = body.bodyOpen + 1
    let mut hit = false
    while i < body.bodyClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) && is_closure_brace(toks: read toks, b: read i) && closure_paramless(toks: read toks, b: read i) == false {
            // Skip a parameterized closure body — its params aren't in this fn's scope
            // (the callback operator case is handled in callback_arg_bad instead).
            let cc = find_matching(toks: read toks, open: read i, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            if cc < 0 { i = body.bodyClose } else { i = cc + 1 }
        } else if is_kw_text(toks: read toks, i: read i, word: read "if") || is_kw_text(toks: read toks, i: read i, word: read "while") {
            let lo = i + 1
            let ce = cond_expr_end(toks: read toks, start: read lo, limit: read body.bodyClose)
            if ce > lo {
                if operator_type_bad(toks: read toks, start: read lo, end: read ce, cptypes: read noCp, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
            }
            i = i + 1
        } else if is_kw_text(toks: read toks, i: read i, word: read "let") || is_kw_text(toks: read toks, i: read i, word: read "local") {
            let se = next_line_or_block_end(toks: read toks, start: read i, end: read body.bodyClose)
            let eq = find_top_sym(toks: read toks, start: read (i + 1), end: read se, code: read SYM_EQ)
            if eq >= 0 {
                let vs = eq + 1
                let ee = stmt_expr_end(toks: read toks, start: read vs, end: read body.bodyClose)
                if ee > vs {
                    if operator_type_bad(toks: read toks, start: read vs, end: read ee, cptypes: read noCp, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
                }
            }
            i = i + 1
        } else if is_kw_text(toks: read toks, i: read i, word: read "return") {
            let vs = i + 1
            let ee = stmt_expr_end(toks: read toks, start: read vs, end: read body.bodyClose)
            if ee > vs {
                if operator_type_bad(toks: read toks, start: read vs, end: read ee, cptypes: read noCp, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
            }
            i = i + 1
        } else if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            // A call: check any closure argument (`|p| body`) passed to a Fn param for an
            // operator-type mismatch in its body (the closure has no enclosing-scope params).
            let mut cns = ""
            if i >= 2 && at_symbol(toks: read toks, i: read (i - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (i - 2)) {
                cns = tk_text(toks: read toks, i: read (i - 2))
            }
            let cclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if cclose >= 0 {
                if call_closure_operator_bad(toks: read toks, ns: read cns, callee: read tk_text(toks: read toks, i: read i), open: read (i + 1), close: read cclose, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals, aliasIdx: read model.aliasIdx) { hit = true }
            }
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return hit
}

// Walk all top-level fns and report any RS0210 operator-type mismatch.
fn has_operator_type_mismatch(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let model = build_file_type_model(toks: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_operator_type_mismatch(toks: read toks, start: read i, model: read model) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0209 (CONTROL_FLOW_TYPE_MISMATCH), non-Bool-condition case: an `if`/`while` condition
// [start, end) whose whole expression types to a concrete non-Bool. A condition with a
// top-level comparison/logical operator (`==`, `&&`, …) or a leading `!` is Bool by
// construction and skipped; only a plainly-typed non-Bool value (`if "yes"`, `if count`)
// fires. FP-safe: an un-typeable condition yields "" and is skipped.
fn cond_non_bool(toks: read List<Tok>, start: read Int, end: read Int, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    if start >= end { return false }
    if at_symbol(toks: read toks, i: read start, code: read SYM_BANG) { return false }
    let op = find_binop(toks: read toks, start: read start, end: read end)
    if op >= 0 {
        if op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 1) { return false }
        if op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 2) { return false }
        if op_matches_tier(toks: read toks, i: read op, end: read end, tier: read 6) { return false }
    }
    let ty = return_actual_type(toks: read toks, s0: read start, e: read end, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
    if String.len(value: read ty) == 0 { return false }
    if str_is_unresolved_generic(s: read ty) { return false }
    if str_strip_fresh(s: read ty) == "Bool" { return false }
    return true
}

// A concrete scalar (non-iterable) type: String/Int/Bool/Float/Char. "" / generics / a
// collection root (List/Map/Set/user type) yield false.
fn is_scalar_root(ty: read String) -> Bool {
    if String.len(value: read ty) == 0 { return false }
    if str_is_unresolved_generic(s: read ty) { return false }
    let r = str_type_root(s: read ty)
    return r == "String" || r == "Int" || r == "Bool" || r == "Float" || r == "Char"
}

// RS0209, match case: a `match` whose scrutinee type is incompatible with its patterns.
// Two FP-safe checks over a concrete scrutinee type (root, `<..>` stripped):
//   * enum-variant: `Some`/`None` patterns imply the scrutinee is `Option`, `Ok`/`Err`
//     imply `Result` — a concrete scrutinee of a different root fires.
//   * literal pattern: a single literal pattern (`1`, `"x"`, `'c'`) whose scalar type
//     differs from the scrutinee root fires.
// Arm-result-type consistency is NOT checked here (it needs pattern-binding typing).
// Arm-iteration mirrors astdump.rss emit_match_arms.
fn match_bad(toks: read List<Tok>, braceOpen: read Int, braceClose: read Int, scrutTy: read String, declared: read Set<String>, popen: read Int, pclose: read Int, bodyOpen: read Int, fnIdx: read Map<String, Int>, locals: read Map<String, List<Int>>) -> Bool {
    if String.len(value: read scrutTy) == 0 { return false }
    if str_is_unresolved_generic(s: read scrutTy) { return false }
    let scrutRoot = str_type_root(s: read scrutTy)
    // A matchable scrutinee is Option/Result/List, a scalar, or a type DECLARED in this file
    // (the analyzer resolves each file in isolation, so an imported type is unknown here and
    // is not matchable — tools.rss: `match runtime` where `runtime: ToolRuntime` and the sum
    // ToolRuntime lives in another file).
    let isTuple = String.starts_with(value: read scrutTy, prefix: read "(")
    let matchable = isTuple || scrutRoot == "Option" || scrutRoot == "Result" || scrutRoot == "List" || is_scalar_root(ty: read scrutTy) || Set.contains<String>(set: read declared, value: read scrutRoot)
    if matchable == false { return true }
    let innerTy = str_top_arg(s: read scrutTy, which: read 0)
    let mut impliedOption = false
    let mut impliedResult = false
    let mut litBad = false
    // Arm-result-type consistency: the first arm that produces a concrete value sets the
    // expected type; a later arm of a different concrete type fires.
    let mut firstArmTy = ""
    let mut armBad = false
    let mut i = braceOpen + 1
    while i < braceClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) || at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read braceClose)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks: read toks, start: read i, end: read arrow)
                let mut patEnd = arrow
                if ifPos >= 0 { patEnd = ifPos }
                // Per-arm binding: `Some(x)`/`Ok(x)` bind x to the scrutinee's first generic.
                let armCp = Map<String, String>.new()
                if i < patEnd {
                    let ph = tk_text(toks: read toks, i: read i)
                    if ph == "Some" || ph == "None" { impliedOption = true }
                    if ph == "Ok" || ph == "Err" { impliedResult = true }
                    if (ph == "Some" || ph == "Ok") && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) && is_ident_tok(toks: read toks, i: read (i + 2)) && String.len(value: read innerTy) > 0 {
                        Map.insert<String, String>(map: mut armCp, key: read tk_text(toks: read toks, i: read (i + 2)), value: read innerTy)
                    }
                    if (i + 1) == patEnd {
                        let k0 = tk_kind(toks: read toks, i: read i)
                        if k0 == TOK_NUMBER && scrutRoot != "Int" { litBad = true }
                        if k0 == TOK_STRING && scrutRoot != "String" { litBad = true }
                        if k0 == TOK_CHAR && scrutRoot != "Char" { litBad = true }
                    }
                    // A tuple pattern `(..)` can't match a scalar scrutinee; a list pattern
                    // `[..]` only matches a List.
                    if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) && is_scalar_root(ty: read scrutTy) { litBad = true }
                    if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) && scrutRoot != "List" { litBad = true }
                    // A scalar scrutinee (Int/String/…) admits only literal patterns and `_`;
                    // a bare-identifier pattern (`other`) cannot match it (`true`/`false` are
                    // the Bool literals, not bindings).
                    if is_scalar_root(ty: read scrutTy) && (i + 1) == patEnd && tk_kind(toks: read toks, i: read i) == TOK_IDENT {
                        let pn = tk_text(toks: read toks, i: read i)
                        if pn != "_" && pn != "true" && pn != "false" { litBad = true }
                    }
                }
                let bodyStart = arrow + 1
                // Produced value range [pvs, pve) — a block's single statement (skipped if it
                // `return`s, i.e. diverges) or a bare expr arm.
                let mut pvs = 0 - 1
                let mut pve = 0 - 1
                if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                    let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if bclose < 0 {
                        i = braceClose
                    } else {
                        let cs2 = bodyStart + 1
                        if cs2 < bclose && is_kw_text(toks: read toks, i: read cs2, word: read "return") == false && next_line_or_block_end(toks: read toks, start: read cs2, end: read bclose) >= bclose {
                            pvs = cs2
                            pve = bclose
                        }
                        i = bclose + 1
                    }
                } else {
                    let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read braceClose)
                    if is_kw_text(toks: read toks, i: read bodyStart, word: read "return") == false {
                        pvs = bodyStart
                        pve = bEnd
                    }
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
                if pvs >= 0 && pve > pvs {
                    let at2 = operand_type_cp(toks: read toks, s: read pvs, e: read pve, cptypes: read armCp, popen: read popen, pclose: read pclose, bodyOpen: read bodyOpen, fnIdx: read fnIdx, locals: read locals)
                    if String.len(value: read at2) > 0 && str_is_unresolved_generic(s: read at2) == false {
                        let ar = str_strip_fresh(s: read at2)
                        if String.len(value: read firstArmTy) == 0 {
                            firstArmTy = ar
                        } else if ar != firstArmTy {
                            armBad = true
                        }
                    }
                }
            }
        }
    }
    if impliedOption && scrutRoot != "Option" { return true }
    if impliedResult && scrutRoot != "Result" { return true }
    if litBad { return true }
    if armBad { return true }
    return false
}

// RS0209 per-fn walker: `if`/`while` conditions that are non-Bool.
fn fn_has_control_flow_mismatch(toks: read List<Tok>, start: read Int, model: read FileTypeModel) -> Bool {
    let body = build_body_type_model(toks: read toks, fnStart: read start)
    if body_type_model_ok(body: read body) == false { return false }
    let mut i = body.bodyOpen + 1
    let mut hit = false
    while i < body.bodyClose {
        if is_kw_text(toks: read toks, i: read i, word: read "if") || is_kw_text(toks: read toks, i: read i, word: read "while") {
            let lo = i + 1
            let ce = cond_expr_end(toks: read toks, start: read lo, limit: read body.bodyClose)
            if ce > lo {
                if cond_non_bool(toks: read toks, start: read lo, end: read ce, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
            }
        } else if is_kw_text(toks: read toks, i: read i, word: read "match") {
            let mut vs = i + 1
            if is_effect_kw(toks: read toks, i: read vs) { vs = vs + 1 }
            let mbo = cond_expr_end(toks: read toks, start: read vs, limit: read body.bodyClose)
            if mbo > vs {
                let scrutTy = return_actual_type(toks: read toks, s0: read vs, e: read mbo, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals)
                let mbc = find_matching(toks: read toks, open: read mbo, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if mbc >= 0 {
                    if match_bad(toks: read toks, braceOpen: read mbo, braceClose: read mbc, scrutTy: read scrutTy, declared: read model.declared, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals) { hit = true }
                }
            }
        } else if is_kw_text(toks: read toks, i: read i, word: read "for") {
            // Find the `in` keyword, then type the loop subject; a concrete scalar
            // (String/Int/Bool/Float/Char) is not iterable => RS0209 (for-unsupported).
            let fbo = cond_expr_end(toks: read toks, start: read (i + 1), limit: read body.bodyClose)
            if fbo > (i + 1) {
                let mut inPos = 0 - 1
                let mut j = i + 1
                while j < fbo {
                    if is_kw_text(toks: read toks, i: read j, word: read "in") { inPos = j }
                    j = j + 1
                }
                if inPos >= 0 {
                    let ss = inPos + 1
                    if ss < fbo {
                        let subjTy = return_actual_type(toks: read toks, s0: read ss, e: read fbo, popen: read body.paramOpen, pclose: read body.paramClose, bodyOpen: read body.bodyOpen, fnIdx: read model.fnIdx, locals: read body.locals)
                        if is_scalar_root(ty: read subjTy) { hit = true }
                    }
                }
            }
        }
        i = i + 1
    }
    return hit
}

// Walk all top-level fns and report any RS0209 control-flow-type mismatch.
fn has_control_flow_mismatch(toks: read List<Tok>) -> Bool {
    let ntok = List.len(list: read toks)
    let model = build_file_type_model(toks: read toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_control_flow_mismatch(toks: read toks, start: read i, model: read model) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// Stdlib signatures are generated from the real `.rssi` interfaces by the test
// harness as `selfhost.interfaces`; absent Ns.method yields "" (unknown => no
// diagnostic => FP-safe).
fn stdlib_return_type(ns: read String, method: read String) -> String {
    return generated_stdlib_return_type(ns: read ns, method: read method)
}

fn stdlib_error_type(ns: read String, method: read String) -> String {
    return generated_stdlib_error_type(ns: read ns, method: read method)
}

// Second (error) type-arg root of a `Result<T, E>` return type for the fn whose
// keyword-anchor sits at `fnkw`, or "" when the return is not a 2-arg Result.
// Mirrors return_type_root_at but yields E instead of the head root.
fn return_error_type_at(toks: read List<Tok>, fnkw: read Int) -> String {
    let sigEnd = function_signature_end(toks: read toks, start: read fnkw)
    let open = find_param_open(toks: read toks, from: read fnkw, end: read sigEnd)
    if open < 0 { return "" }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return "" }
    if at_symbol(toks: read toks, i: read (close + 1), code: read SYM_ARROW) == false { return "" }
    let rs = close + 2
    let mut re = rs
    let mut scanning = true
    while scanning {
        let stop = at_ident(toks: read toks, i: read re, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read re, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read re, code: read SYM_EQ)
        if re < sigEnd && stop == false {
            re = re + 1
        } else {
            scanning = false
        }
    }
    return result_error_root(toks: read toks, s: read rs, e: read re)
}

// Error root of a `Result< T , E >` type region [s,e): the root of its second
// top-level type argument, or "" when the region is not a 2-arg Result.
fn result_error_root(toks: read List<Tok>, s: read Int, e: read Int) -> String {
    let p = skip_type_prefixes(toks: read toks, s: read s, e: read e)
    if p >= e { return "" }
    if is_ident_tok(toks: read toks, i: read p) == false { return "" }
    if tk_text(toks: read toks, i: read p) != "Result" { return "" }
    let lt = p + 1
    if at_symbol(toks: read toks, i: read lt, code: read SYM_LANGLE) == false { return "" }
    let mut k = lt + 1
    let mut angle = 0
    let mut depth = 0
    let mut commaPos = -1
    let mut rangle = -1
    while k < e && rangle < 0 {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle == 0 { rangle = k } else { angle = angle - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if angle == 0 && depth == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if commaPos < 0 { commaPos = k }
        }
        k = k + 1
    }
    if commaPos < 0 || rangle < 0 { return "" }
    return type_region_root(toks: read toks, s: read (commaPos + 1), e: read rangle)
}

// Error root of the `Result<T, E>` return of the first unqualified same-file
// `fn fnName(...)`, or "". Mirrors fn_return_root but yields E.
fn fn_error_type_by_name(toks: read List<Tok>, fnName: read String) -> String {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut result = ""
    let mut done = false
    while i < n && done == false {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let nameIdx = i + 1
            let named = is_ident_tok(toks: read toks, i: read nameIdx) && tk_text(toks: read toks, i: read nameIdx) == fnName
            if named && at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT) == false {
                result = return_error_type_at(toks: read toks, fnkw: read i)
                done = true
            }
        }
        i = i + 1
    }
    return result
}

// Result error type of the `?`-operand ending just before the `?` at `qPos`, or
// "" when it is not confidently known. Only two operand shapes yield an error
// type: a qualified stdlib call `Ns.method(...)?` (via the namespace map) and an
// unqualified same-file call `name(...)?` (via that fn's declared error type).
// Anything else (bare ident, index, field, Ok/Err/Some literal) -> "" (FP-safe).
fn try_operand_error_type(toks: read List<Tok>, qPos: read Int, bodyOpen: read Int, allFns: read Set<String>) -> String {
    let prev = qPos - 1
    if prev <= bodyOpen { return "" }
    if at_symbol(toks: read toks, i: read prev, code: read SYM_RPAREN) == false { return "" }
    let mut d = 0
    let mut j = prev
    let mut op = -1
    while j > bodyOpen && op < 0 {
        if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) {
            d = d + 1
        } else if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
            d = d - 1
            if d == 0 { op = j }
        }
        j = j - 1
    }
    if op <= bodyOpen { return "" }
    let callee = op - 1
    if is_ident_tok(toks: read toks, i: read callee) == false { return "" }
    let method = tk_text(toks: read toks, i: read callee)
    if at_symbol(toks: read toks, i: read (callee - 1), code: read SYM_DOT) {
        let nsPos = callee - 2
        if is_ident_tok(toks: read toks, i: read nsPos) == false { return "" }
        if at_symbol(toks: read toks, i: read (nsPos - 1), code: read SYM_DOT) { return "" }
        return stdlib_error_type(ns: read tk_text(toks: read toks, i: read nsPos), method: read method)
    }
    if Set.contains<String>(set: read allFns, value: read method) {
        return fn_error_type_by_name(toks: read toks, fnName: read method)
    }
    return ""
}

// RS0013 INVALID_TRY_OPERATOR (sub-rules A + B + C): true iff the fn at `start`
// uses `?` in a way that is invalid. (A) any `?` in a fn whose return root is not
// Result/Option (check_try_operator_result_returns). (B) a `?` whose operand has
// a confidently-known concrete non-Result/Option type (check_try_value_is_result).
// (C) inside a fn returning `Result<T, E>`, a `?` whose operand's Result error
// type is confidently known and differs from E (check_try_error_types).
fn fn_invalid_try(toks: read List<Tok>, start: read Int, declared: read Set<String>, allFns: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let popen = find_param_open(toks: read toks, from: read ns, end: read sigEnd)
    let mut pclose = -1
    if popen >= 0 {
        pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    }
    let retRoot = return_type_root_at(toks: read toks, fnkw: read (ns - 1))
    let returnsResult = retRoot == "Result" || retRoot == "Option"
    let fnErr = return_error_type_at(toks: read toks, fnkw: read (ns - 1))
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_QUESTION) {
            if returnsResult == false {
                hit = true
            } else {
                let root = try_operand_root(toks: read toks, qPos: read k, bodyOpen: read sigEnd, popen: read popen, pclose: read pclose, declared: read declared, allFns: read allFns)
                if String.len(value: read root) > 0 && root != "Result" && root != "Option" { hit = true }
                if retRoot == "Result" && String.len(value: read fnErr) > 0 {
                    let opErr = try_operand_error_type(toks: read toks, qPos: read k, bodyOpen: read sigEnd, allFns: read allFns)
                    if String.len(value: read opErr) > 0 && opErr != fnErr { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0201 UNNAMED_ARGUMENT (check_argument_naming, checks/calls.rs).
//
// A call argument passed WITHOUT a `name:` label where the callee requires named
// arguments. Named args are REQUIRED for public same-file functions, and for
// core/native/stdlib qualified calls (`Ns.method(...)`); they are NOT required
// for receiver-call shorthand (`value.method(...)`), private same-file helpers,
// enum-variant constructors (`Ok`/`Some`/user variants), or type constructors
// (which also permit field shorthand). The parser (syntax/parser/expr.rs
// is_qualified_namespace_receiver) treats an UPPERCASE dotted head as a qualified
// namespace call and a lowercase head as a receiver call — replicated here by the
// first-character-uppercase test. FILE-LEVEL: emit once if ANY resolved call site
// carries an unnamed argument. Conservative on anything not confidently a
// named-required call (skip => no false positive).
// ---------------------------------------------------------------------------

// Index of the `<` that matches the `>` at `closePos`, scanning backwards, or -1.
fn back_match_angle(toks: read List<Tok>, closePos: read Int) -> Int {
    let mut depth = 0
    let mut k = closePos
    let mut res = -1
    while k >= 0 && res < 0 {
        if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            depth = depth - 1
            if depth == 0 { res = k }
        }
        k = k - 1
    }
    return res
}

// Collect same-file fn name sets: `pubFns` = unqualified fn names declared `pub`;
// `dottedFns` = full dotted names of same-file dotted fns (e.g. `Cache.put`), used
// to treat a qualified call to a same-file method as positional-allowed.
fn collect_call_fn_sigs(toks: read List<Tok>, pubFns: mut Set<String>, dottedFns: mut Set<String>) -> Unit {
    let n = List.len(list: read toks)
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let nameIdx = i + 1
            if is_ident_tok(toks: read toks, i: read nameIdx) {
                let full = dotted_name_text(toks: read toks, i: read nameIdx)
                let isDotted = at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT)
                let mut isPub = false
                let mut b = i - 1
                let mut scanning = true
                while scanning {
                    if at_ident(toks: read toks, i: read b, wid: read WORD_PUB) {
                        isPub = true
                        b = b - 1
                    } else if at_ident(toks: read toks, i: read b, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read b, wid: read WORD_NATIVE) {
                        b = b - 1
                    } else {
                        scanning = false
                    }
                }
                if isDotted {
                    Set.insert<String>(set: mut dottedFns, value: read full)
                } else if isPub {
                    Set.insert<String>(set: mut pubFns, value: read full)
                }
            }
        }
        i = i + 1
    }
    return Unit
}

// Core function-namespaces whose qualified calls (`Ns.method(...)`) require named
// arguments. Curated (measure-first) to the namespaces the corpus oracle actually
// flags: broadening to every stdlib/builtin type would risk false positives on
// stdlib sum-variant construction (`JsonValue.String(...)`) and on unknown/imported
// namespaces (`ChatMessage.system(...)`, which the oracle leaves as UNKNOWN_CALLEE
// with no naming diagnostic). See checks/calls.rs check_argument_naming.
fn is_core_named_namespace(head: read String) -> Bool {
    return head == "String" || head == "Image" || head == "Log"
}

// True iff the call whose arg-list `(` is at `op` requires named arguments: a
// public same-file unqualified fn, or a core qualified call to a curated
// function-namespace. Bails (false) on receiver calls, private same-file helpers,
// variant/type constructors, and any callee shape it cannot resolve confidently.
fn call_requires_named(toks: read List<Tok>, op: read Int, pubFns: read Set<String>, dottedFns: read Set<String>) -> Bool {
    let mut nameLast = op - 1
    if at_symbol(toks: read toks, i: read nameLast, code: read SYM_RANGLE) {
        let openAngle = back_match_angle(toks: read toks, closePos: read nameLast)
        if openAngle < 0 { return false }
        nameLast = openAngle - 1
    }
    if is_ident_tok(toks: read toks, i: read nameLast) == false { return false }
    if at_symbol(toks: read toks, i: read (nameLast - 1), code: read SYM_DOT) {
        if is_ident_tok(toks: read toks, i: read (nameLast - 2)) == false { return false }
        let dotHead = nameLast - 2
        if at_symbol(toks: read toks, i: read (dotHead - 1), code: read SYM_DOT) { return false }
        let head = tk_text(toks: read toks, i: read dotHead)
        let full = String.concat(left: read String.concat(left: read head, right: read "."), right: read tk_text(toks: read toks, i: read nameLast))
        if Set.contains<String>(set: read dottedFns, value: read full) { return false }
        return is_core_named_namespace(head: read head)
    }
    let name = tk_text(toks: read toks, i: read nameLast)
    return Set.contains<String>(set: read pubFns, value: read name)
}

// True iff a call-arg segment [s,e) is an unnamed argument: empty (a malformed
// slot from a leading/double comma), or a value not prefixed by a `name:` label.
fn seg_is_unnamed(toks: read List<Tok>, s: read Int, e: read Int) -> Bool {
    if s >= e { return true }
    if is_ident_tok(toks: read toks, i: read s) && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_COLON) {
        return false
    }
    return true
}

// True iff the arg list [op+1, close) has any unnamed argument. A single trailing
// empty segment (trailing comma) does NOT count; empty leading/middle segments do.
fn args_have_unnamed(toks: read List<Tok>, op: read Int, close: read Int) -> Bool {
    let mut k = op + 1
    let mut depth = 0
    let mut angle = 0
    let mut inPipe = false
    let mut segStart = op + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_PIPE) {
            inPipe = inPipe == false
        } else if depth == 0 && angle == 0 && inPipe == false && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_is_unnamed(toks: read toks, s: read segStart, e: read k) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if segStart < close {
        if seg_is_unnamed(toks: read toks, s: read segStart, e: read close) { hit = true }
    }
    return hit
}

// RS0201 over a fn body [sigEnd+1, bodyClose): any resolved named-required call
// site with an unnamed argument.
fn fn_has_unnamed_arg(toks: read List<Tok>, start: read Int, pubFns: read Set<String>, dottedFns: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut op = sigEnd + 1
    let mut hit = false
    while op < bodyClose {
        if at_symbol(toks: read toks, i: read op, code: read SYM_LPAREN) {
            if call_requires_named(toks: read toks, op: read op, pubFns: read pubFns, dottedFns: read dottedFns) {
                let close = find_matching(toks: read toks, open: read op, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if close >= 0 && close <= bodyClose {
                    if args_have_unnamed(toks: read toks, op: read op, close: read close) { hit = true }
                }
            }
        }
        op = op + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0202 MISSING_DATA_EFFECT — a FILE-LEVEL OR over four oracle sub-cases:
//   (1) argument-effect      — a resolved call arg whose callee param declares a
//                              data effect, supplied with the wrong (or no) effect
//                              (checks/calls.rs check_argument_effects);
//   (2) receiver self-effect — `recv.method(...)` whose visible receiver effect
//                              disagrees with the method's `self` effect
//                              (checks/calls.rs check_receiver_call_self_effect);
//   (3) constructor inline managed field — a non-Copy, non-`handle`, non-`weak`
//                              INLINE struct/class field initialized from a managed
//                              binding (checks/body/fresh.rs, managed-inline branch);
//   (4) match scrutinee      — a structured (`[...]`/tuple/`Name {...}`) match arm
//                              pattern with no `read`/`mut`/`take` scrutinee effect
//                              (checks/body/semantics.rs check_match_pattern_effects).
// Callee param effects come from same-file signatures (parsed on demand) plus a
// curated (measure-first) stdlib method→param-effect map. Managed bindings are the
// plain-`let` names of the enclosing body (a `let` is always a managed binding;
// `local` is not). Value-model pieces reused by later type codes (RS0207-0210).
// ---------------------------------------------------------------------------

// The namespaces the curated stdlib param-effect map knows about. Cheap gate so a
// qualified call to any other namespace (`List.get`, `Set.insert`, …) short-circuits
// before the arg list is split — the hot path over a large file.
fn is_effect_stdlib_ns(ns: read String) -> Bool {
    return ns == "Log" || ns == "File" || ns == "Image" || ns == "ResourcePool"
}

// The last-segment method names of same-file `fn <Type>.method(...)` decls. A cheap
// membership gate so a receiver call only pays the full method-resolution scan when a
// same-file method of that name actually exists.
fn collect_method_names(toks: read List<Tok>) -> Set<String> {
    let n = List.len(list: read toks)
    let mut names = Set<String>.new()
    let mut i = 0
    while i < n {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let nameIdx = i + 1
            if is_ident_tok(toks: read toks, i: read nameIdx) && at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT) {
                let de = dotted_end(toks: read toks, i: read nameIdx)
                Set.insert<String>(set: mut names, value: read tk_text(toks: read toks, i: read (de - 1)))
            }
        }
        i = i + 1
    }
    return names
}

// Stdlib method parameter effects are generated from the real `.rssi` interfaces.
// Returns the required call-site effect for `ns.method(pname:)`, or "" (no rule).
fn stdlib_param_effect(ns: read String, method: read String, pname: read String) -> String {
    return generated_stdlib_param_effect(ns: read ns, method: read method, pname: read pname)
}

// True iff `name` begins with an uppercase ASCII letter — the rss convention for a
// type or function-namespace (`Log`, `File`, `ResourcePool`). Lowercase heads are
// value bindings, so `head.method(...)` is a receiver call rather than a qualified one.
fn is_upper_head(name: read String) -> Bool {
    let cs = String.chars(value: read name)
    if List.len(list: read cs) == 0 { return false }
    let f = Char.to_code(value: read List.get(list: read cs, index: read 0))
    return f >= 65 && f <= 90
}

// The supplied call-site data effect at value-start `vs` ("read"/"mut"/"take"), or
// "" if the value has no leading effect keyword.
fn value_effect(toks: read List<Tok>, vs: read Int) -> String {
    if is_effect_kw(toks: read toks, i: read vs) { return tk_text(toks: read toks, i: read vs) }
    return ""
}

// The declared data effect of param `pname` in a same-file signature param list
// [open,close] ("read"/"mut"/"take"), or "" if the param is absent / unannotated.
fn sig_param_effect(toks: read List<Tok>, open: read Int, close: read Int, pname: read String) -> String {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut result = ""
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if seg_name_matches(toks: read toks, segStart: read segStart, name: read pname) {
                result = value_effect(toks: read toks, vs: read (segStart + 2))
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_name_matches(toks: read toks, segStart: read segStart, name: read pname) {
        result = value_effect(toks: read toks, vs: read (segStart + 2))
    }
    return result
}

// The index of the last token of the callee name whose arg-list `(` is at `op`
// (skipping a trailing generic `<...>` clause), or -1 for a shape we do not handle.
fn callee_name_last(toks: read List<Tok>, op: read Int) -> Int {
    let mut nameLast = op - 1
    if at_symbol(toks: read toks, i: read nameLast, code: read SYM_RANGLE) {
        let openAngle = back_match_angle(toks: read toks, closePos: read nameLast)
        if openAngle < 0 { return -1 }
        nameLast = openAngle - 1
    }
    if is_ident_tok(toks: read toks, i: read nameLast) == false { return -1 }
    return nameLast
}

// The param-list open `(` of the first same-file `fn <Type>.method(...)` decl whose
// last dotted name segment is `method`, or -1 if none. Used to resolve a receiver
// call to its method signature (self effect + per-param effects).
fn method_decl_param_open(toks: read List<Tok>, method: read String) -> Int {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut result = -1
    while i < n && result < 0 {
        if at_ident(toks: read toks, i: read i, wid: read WORD_FN) {
            let nameIdx = i + 1
            if is_ident_tok(toks: read toks, i: read nameIdx) && at_symbol(toks: read toks, i: read (nameIdx + 1), code: read SYM_DOT) {
                let de = dotted_end(toks: read toks, i: read nameIdx)
                if tk_text(toks: read toks, i: read (de - 1)) == method {
                    let sigEnd = function_signature_end(toks: read toks, start: read i)
                    result = find_param_open(toks: read toks, from: read nameIdx, end: read sigEnd)
                }
            }
        }
        i = i + 1
    }
    return result
}

// True iff any NAMED argument in the arg list [op+1,close) supplies an effect that
// differs from its callee param's expected effect. `mode` selects the expected
// source: 0 = stdlib map (ns/method), 1 = same-file signature params [sopen,sclose].
fn arg_effect_bad(toks: read List<Tok>, op: read Int, close: read Int, mode: read Int, ns: read String, method: read String, sopen: read Int, sclose: read Int) -> Bool {
    let mut k = op + 1
    let mut depth = 0
    let mut angle = 0
    let mut inPipe = false
    let mut segStart = op + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_PIPE) {
            inPipe = inPipe == false
        } else if depth == 0 && angle == 0 && inPipe == false && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if arg_seg_effect_bad(toks: read toks, s: read segStart, e: read k, mode: read mode, ns: read ns, method: read method, sopen: read sopen, sclose: read sclose) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if arg_seg_effect_bad(toks: read toks, s: read segStart, e: read close, mode: read mode, ns: read ns, method: read method, sopen: read sopen, sclose: read sclose) { hit = true }
    return hit
}

// One arg segment [s,e): RS0202 iff it is a named arg `pname: value` whose callee
// param demands an effect and whose supplied effect differs. Positional args and
// params with no declared effect are skipped (conservative — no false positive).
fn arg_seg_effect_bad(toks: read List<Tok>, s: read Int, e: read Int, mode: read Int, ns: read String, method: read String, sopen: read Int, sclose: read Int) -> Bool {
    if s >= e { return false }
    if is_ident_tok(toks: read toks, i: read s) == false { return false }
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_COLON) == false { return false }
    let pname = tk_text(toks: read toks, i: read s)
    let mut expected = ""
    if mode == 0 {
        expected = stdlib_param_effect(ns: read ns, method: read method, pname: read pname)
    } else {
        expected = sig_param_effect(toks: read toks, open: read sopen, close: read sclose, pname: read pname)
    }
    if String.len(value: read expected) == 0 { return false }
    let supplied = value_effect(toks: read toks, vs: read (s + 2))
    return supplied != expected
}

// The first `{` of a same-file `struct`/`class`/`resource` decl named `typeName`,
// or -1. The name always immediately follows the type keyword.
fn type_body_open(toks: read List<Tok>, typeName: read String) -> Int {
    let n = List.len(list: read toks)
    let mut i = 0
    let mut result = -1
    while i < n && result < 0 {
        let isType = at_ident(toks: read toks, i: read i, wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read i, wid: read WORD_CLASS) || at_ident(toks: read toks, i: read i, wid: read WORD_RESOURCE)
        if isType && is_ident_tok(toks: read toks, i: read (i + 1)) && tk_text(toks: read toks, i: read (i + 1)) == typeName {
            result = find_body_open(toks: read toks, i: read i, end: read n)
        }
        i = i + 1
    }
    return result
}

// The inline type-root of field `field` in the type body [ob,close), or "" when the
// field is absent OR declared `handle`/`weak` (handle/weak fields are non-owning, so
// they are NOT inline-managed and never drive sub-case 3).
fn struct_field_inline_root(toks: read List<Tok>, ob: read Int, close: read Int, field: read String) -> String {
    let mut k = ob + 1
    let mut paren = 0
    let mut br = 0
    let mut ang = 0
    let mut brace = 0
    let mut result = ""
    let mut done = false
    while k < close && done == false {
        let atTop = paren == 0 && br == 0 && ang == 0 && brace == 0
        if atTop && at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) && is_ident_tok(toks: read toks, i: read k) && tk_text(toks: read toks, i: read k) == field {
            let ts = k + 2
            if tk_text(toks: read toks, i: read ts) == "handle" || tk_text(toks: read toks, i: read ts) == "weak" {
                result = ""
            } else {
                result = type_region_root(toks: read toks, s: read ts, e: read close)
            }
            done = true
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) {
            br = br + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) {
            if br > 0 { br = br - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if ang > 0 { ang = ang - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            if brace > 0 { brace = brace - 1 }
        }
        k = k + 1
    }
    return result
}

// True iff `fieldType` is a known-type-kind (declared struct/class/resource/sum or
// stdlib) non-Copy type — i.e. `type_kind(fieldType).is_some() && !is_copy(...)`.
fn is_managed_field_type(fieldType: read String, declared: read Set<String>) -> Bool {
    if is_scalar_name(name: read fieldType) { return false }
    return Set.contains<String>(set: read declared, value: read fieldType) || is_stdlib_type(name: read fieldType)
}

// The plain-`let` binding names of the body [bodyOpen,bodyClose) — the managed
// bindings (a plain `let` is always a managed binding; `local` is excluded).
fn collect_managed_names(toks: read List<Tok>, bodyOpen: read Int, bodyClose: read Int) -> Set<String> {
    let mut managed = Set<String>.new()
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks: read toks, i: read k, word: read "let") {
            let mut nameIdx = k + 1
            if is_kw_text(toks: read toks, i: read nameIdx, word: read "mut") { nameIdx = nameIdx + 1 }
            if is_ident_tok(toks: read toks, i: read nameIdx) {
                Set.insert<String>(set: mut managed, value: read tk_text(toks: read toks, i: read nameIdx))
            }
        }
        k = k + 1
    }
    return managed
}

// True iff the value at [vs,ve) is a managed place: a plain ident/field path whose
// base binding is managed (after stripping a leading data effect). Call/literal
// values are not places and are conservatively treated as non-managed.
fn value_is_managed(toks: read List<Tok>, vs: read Int, managed: read Set<String>) -> Bool {
    let mut s = vs
    if is_effect_kw(toks: read toks, i: read s) { s = s + 1 }
    if is_ident_tok(toks: read toks, i: read s) == false { return false }
    return Set.contains<String>(set: read managed, value: read tk_text(toks: read toks, i: read s))
}

// Sub-case 3 over a constructor arg list [op+1,close) for `typeName`: RS0202 iff any
// named field arg names an inline, non-Copy, known-type-kind field initialized from a
// managed binding.
fn ctor_managed_bad(toks: read List<Tok>, op: read Int, close: read Int, ob: read Int, obClose: read Int, declared: read Set<String>, managed: read Set<String>) -> Bool {
    let mut k = op + 1
    let mut depth = 0
    let mut angle = 0
    let mut inPipe = false
    let mut segStart = op + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE)
        let closer = at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_PIPE) {
            inPipe = inPipe == false
        } else if depth == 0 && angle == 0 && inPipe == false && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            if ctor_field_seg_bad(toks: read toks, s: read segStart, e: read k, ob: read ob, obClose: read obClose, declared: read declared, managed: read managed) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if ctor_field_seg_bad(toks: read toks, s: read segStart, e: read close, ob: read ob, obClose: read obClose, declared: read declared, managed: read managed) { hit = true }
    return hit
}

// One constructor field arg [s,e): RS0202 iff it is `field: value` where `field` is an
// inline non-Copy known-type-kind field (looked up in the type body [ob,obClose)) and
// `value` is a managed place.
fn ctor_field_seg_bad(toks: read List<Tok>, s: read Int, e: read Int, ob: read Int, obClose: read Int, declared: read Set<String>, managed: read Set<String>) -> Bool {
    if s >= e { return false }
    if is_ident_tok(toks: read toks, i: read s) == false { return false }
    if at_symbol(toks: read toks, i: read (s + 1), code: read SYM_COLON) == false { return false }
    let field = tk_text(toks: read toks, i: read s)
    let fieldType = struct_field_inline_root(toks: read toks, ob: read ob, close: read obClose, field: read field)
    if String.len(value: read fieldType) == 0 { return false }
    if is_managed_field_type(fieldType: read fieldType, declared: read declared) == false { return false }
    return value_is_managed(toks: read toks, vs: read (s + 2), managed: read managed)
}

// True iff any arm pattern in [braceOpen+1,braceClose) is structured (`[...]` list,
// `(...)` tuple, or `Name {...}` struct) — the shapes that project fields and so
// require a scrutinee effect (MatchPattern::List | MatchPattern::Struct).
fn match_has_structured_arm(toks: read List<Tok>, braceOpen: read Int, braceClose: read Int) -> Bool {
    let mut i = braceOpen + 1
    let mut hit = false
    while i < braceClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) || at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read braceClose)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks: read toks, start: read i, end: read arrow)
                let pe = arrow
                if pattern_is_structured(toks: read toks, ps: read i, pe: read pe) { hit = true }
                let bodyStart = arrow + 1
                if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                    let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if bclose < 0 { i = braceClose } else { i = bclose + 1 }
                } else {
                    let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read braceClose)
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    return hit
}

// True iff the guardless pattern [ps,pe) is a List (`[...]`), tuple (`(...)`), or
// struct (`Name {...}`) pattern. Variant patterns (`Some(x)`, `Ok(e)`), bare idents,
// literals and `_` are NOT structured.
fn pattern_is_structured(toks: read List<Tok>, ps: read Int, pe: read Int) -> Bool {
    if ps >= pe { return false }
    if at_symbol(toks: read toks, i: read ps, code: read SYM_LBRACKET) { return true }
    if at_symbol(toks: read toks, i: read ps, code: read SYM_LPAREN) { return true }
    if is_ident_tok(toks: read toks, i: read ps) {
        let after = dotted_end(toks: read toks, i: read ps)
        if at_symbol(toks: read toks, i: read after, code: read SYM_LBRACE) { return true }
    }
    return false
}

// --- RS0037: positional variant-pattern arity mismatch ----------------------

// Comma-separated top-level segment count of the paren group (open,close). Empty => 0.
fn count_top_segments(toks: read List<Tok>, open: read Int, close: read Int) -> Int {
    if (open + 1) >= close { return 0 }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segs = 1
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            depth = depth - 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) {
            segs = segs + 1
        }
        k = k + 1
    }
    return segs
}

// True iff the paren group (open,close) has a top-level `:` — a named/struct-style
// pattern (`V(field: p)`), which the oracle does NOT positional-arity-check.
fn region_has_top_colon(toks: read List<Tok>, open: read Int, close: read Int) -> Bool {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut hit = false
    while k < close {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read k, code: read SYM_RBRACE) {
            depth = depth - 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read k, code: read SYM_COLON) {
            hit = true
        }
        k = k + 1
    }
    return hit
}

// The Set key encoding a variant's declared arity: `Name:arity`.
fn arity_key(name: read String, arity: read Int) -> String {
    return String.concat(left: read String.concat(left: read name, right: read ":"), right: read String.from_int(value: arity))
}

// Look up variant `name`'s declared arity in the precomputed set, or -1 if absent.
// Arities are small, so a bounded probe (0..11) beats storing/reading a map value.
fn variant_arity_of(arities: read Set<String>, name: read String) -> Int {
    let mut a = 0
    let mut result = -1
    while a < 12 {
        if Set.contains<String>(set: read arities, value: read arity_key(name: read name, arity: read a)) {
            result = a
            a = 12
        } else {
            a = a + 1
        }
    }
    return result
}

// Insert `Name:arity` for every variant in one sum body `{...}` (bodyOpen is the `{`).
fn collect_variant_arities_in_body(toks: read List<Tok>, bodyOpen: read Int, arities: mut Set<String>) -> Unit {
    let close = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 { return Unit }
    let mut k = bodyOpen + 1
    while k < close {
        if is_ident_tok(toks: read toks, i: read k) {
            let vname = tk_text(toks: read toks, i: read k)
            if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_LPAREN) {
                let pclose = find_matching(toks: read toks, open: read (k + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if pclose < 0 {
                    k = close
                } else {
                    let a = count_top_segments(toks: read toks, open: read (k + 1), close: read pclose)
                    Set.insert<String>(set: mut arities, value: read arity_key(name: read vname, arity: read a))
                    k = pclose + 1
                }
            } else {
                Set.insert<String>(set: mut arities, value: read arity_key(name: read vname, arity: read 0))
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// Precompute the whole file's variant->arity table ONCE (as `Name:arity` keys), so
// per-pattern arity lookup is O(1) instead of re-walking every declaration (which is
// O(patterns * tokens) — pathological on the 4k-line self-hosted tools).
fn collect_variant_arities(toks: read List<Tok>) -> Set<String> {
    let ntok = List.len(list: read toks)
    let mut arities = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        collect_variant_arities_in_body(toks: read toks, bodyOpen: read ob, arities: mut arities)
                    }
                    i = r
                }
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return arities
}

// One arm pattern [ps,pe): RS0037 iff it is a positional `Variant(b1,…,bn)` whose
// head is a known sum variant, is not named (`field:`), binds n>0 sub-patterns, and
// n != the variant's declared field count.
fn arm_pattern_arity_bad(toks: read List<Tok>, ps: read Int, pe: read Int, arities: read Set<String>) -> Bool {
    if ps >= pe { return false }
    if is_ident_tok(toks: read toks, i: read ps) == false { return false }
    if at_symbol(toks: read toks, i: read (ps + 1), code: read SYM_LPAREN) == false { return false }
    let close = find_matching(toks: read toks, open: read (ps + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 || close > pe { return false }
    if region_has_top_colon(toks: read toks, open: read (ps + 1), close: read close) { return false }
    let arity = variant_arity_of(arities: read arities, name: read tk_text(toks: read toks, i: read ps))
    if arity < 0 { return false }
    let found = count_top_segments(toks: read toks, open: read (ps + 1), close: read close)
    if found == 0 { return false }
    return found != arity
}

// One match's arm brace [braceOpen,braceClose]: any positional-arity-bad arm.
fn match_arm_arity_bad(toks: read List<Tok>, braceOpen: read Int, braceClose: read Int, arities: read Set<String>) -> Bool {
    let mut i = braceOpen + 1
    let mut hit = false
    while i < braceClose {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) || at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read braceClose)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                if arm_pattern_arity_bad(toks: read toks, ps: read i, pe: read arrow, arities: read arities) { hit = true }
                let bodyStart = arrow + 1
                if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                    let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if bclose < 0 { i = braceClose } else { i = bclose + 1 }
                } else {
                    let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read braceClose)
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    return hit
}

// RS0037 over the whole file: any `match` with a positional-arity-bad variant arm.
fn has_variant_arity_mismatch(toks: read List<Tok>) -> Bool {
    let arities = collect_variant_arities(toks: read toks)
    let ntok = List.len(list: read toks)
    let mut k = 0
    let mut hit = false
    while k < ntok {
        if tk_kind(toks: read toks, i: read k) == TOK_EOF {
            k = ntok
        } else if is_kw_text(toks: read toks, i: read k, word: read "match") && (k == 0 || at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) == false) {
            let braceOpen = find_match_arms_open(toks: read toks, start: read (k + 1), end: read ntok)
            if braceOpen >= 0 {
                let braceClose = find_matching(toks: read toks, open: read braceOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                if braceClose >= 0 {
                    if match_arm_arity_bad(toks: read toks, braceOpen: read braceOpen, braceClose: read braceClose, arities: read arities) { hit = true }
                }
            }
            k = k + 1
        } else {
            k = k + 1
        }
    }
    return hit
}

// RS0202 over a single fn body: any of the four sub-cases fires. Walks each call
// `(` for arg-effect + receiver self-effect + constructor-managed, and each `match`
// for the structured-pattern-without-scrutinee-effect rule.
fn fn_data_effect_bad(toks: read List<Tok>, start: read Int, declared: read Set<String>, methodNames: read Set<String>) -> Bool {
    let ns = fn_name_start(toks: read toks, i: read start)
    let sigEnd = function_signature_end(toks: read toks, start: read (ns - 1))
    if at_symbol(toks: read toks, i: read sigEnd, code: read SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: read toks, open: read sigEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if bodyClose < 0 { return false }
    let managed = collect_managed_names(toks: read toks, bodyOpen: read sigEnd, bodyClose: read bodyClose)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: read toks, i: read k, code: read SYM_LPAREN) {
            if call_site_effect_bad(toks: read toks, op: read k, bodyClose: read bodyClose, declared: read declared, managed: read managed, methodNames: read methodNames) { hit = true }
        } else if is_kw_text(toks: read toks, i: read k, word: read "match") && at_symbol(toks: read toks, i: read (k - 1), code: read SYM_DOT) == false {
            if is_effect_kw(toks: read toks, i: read (k + 1)) == false {
                let braceOpen = find_match_arms_open(toks: read toks, start: read (k + 1), end: read bodyClose)
                if braceOpen >= 0 {
                    let braceClose = find_matching(toks: read toks, open: read braceOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    if braceClose >= 0 {
                        if match_has_structured_arm(toks: read toks, braceOpen: read braceOpen, braceClose: read braceClose) { hit = true }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// One call site whose arg-list `(` is at `op`: dispatch by callee shape and check
// arg-effects (sub-case 1), receiver self-effect (sub-case 2), and constructor
// managed-inline fields (sub-case 3).
fn call_site_effect_bad(toks: read List<Tok>, op: read Int, bodyClose: read Int, declared: read Set<String>, managed: read Set<String>, methodNames: read Set<String>) -> Bool {
    let nameLast = callee_name_last(toks: read toks, op: read op)
    if nameLast < 0 { return false }
    let method = tk_text(toks: read toks, i: read nameLast)
    // Classify the callee shape from cheap token checks BEFORE the (costly)
    // matching-paren scan, so the common bare/qualified calls short-circuit.
    if at_symbol(toks: read toks, i: read (nameLast - 1), code: read SYM_DOT) == false {
        // Bare `Name(...)`: only a same-file struct/class constructor is relevant.
        if Set.contains<String>(set: read declared, value: read method) == false { return false }
        let ob = type_body_open(toks: read toks, typeName: read method)
        if ob < 0 { return false }
        let obClose = find_matching(toks: read toks, open: read ob, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if obClose < 0 { return false }
        let close = find_matching(toks: read toks, open: read op, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close < 0 || close > bodyClose { return false }
        return ctor_managed_bad(toks: read toks, op: read op, close: read close, ob: read ob, obClose: read obClose, declared: read declared, managed: read managed)
    }
    // The receiver/namespace ends just before the `.`; skip a `Type<...>` generic
    // clause (e.g. `ResourcePool<DbConnection>.borrow`) back to the head ident.
    let mut head = nameLast - 2
    if at_symbol(toks: read toks, i: read head, code: read SYM_RANGLE) {
        let openAngle = back_match_angle(toks: read toks, closePos: read head)
        if openAngle < 0 { return false }
        head = openAngle - 1
    }
    if is_ident_tok(toks: read toks, i: read head) == false { return false }
    let headText = tk_text(toks: read toks, i: read head)
    let headChained = at_symbol(toks: read toks, i: read (head - 1), code: read SYM_DOT)
    if headChained == false && is_upper_head(name: read headText) {
        // Qualified call `Namespace.method(...)` — only curated stdlib namespaces.
        if is_effect_stdlib_ns(ns: read headText) == false { return false }
        let close = find_matching(toks: read toks, open: read op, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close < 0 || close > bodyClose { return false }
        return arg_effect_bad(toks: read toks, op: read op, close: read close, mode: read 0, ns: read headText, method: read method, sopen: read 0, sclose: read 0)
    }
    // Receiver call `recv.method(...)` — resolve to a same-file method signature.
    if Set.contains<String>(set: read methodNames, value: read method) == false { return false }
    let popen = method_decl_param_open(toks: read toks, method: read method)
    if popen < 0 { return false }
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pclose < 0 { return false }
    let close = find_matching(toks: read toks, open: read op, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 || close > bodyClose { return false }
    let mut hit = false
    if arg_effect_bad(toks: read toks, op: read op, close: read close, mode: read 1, ns: read "", method: read method, sopen: read popen, sclose: read pclose) { hit = true }
    if receiver_self_effect_bad(toks: read toks, head: read head, popen: read popen, pclose: read pclose) { hit = true }
    return hit
}

// Sub-case 2: the receiver whose head ident is at `head`, resolving to a method whose
// self param list is [popen,pclose]. RS0202 iff the method's `self` effect exists and
// differs from the visible receiver effect (the leading `read`/`mut`/`take`, default
// `read`).
fn receiver_self_effect_bad(toks: read List<Tok>, head: read Int, popen: read Int, pclose: read Int) -> Bool {
    let selfEffect = value_effect(toks: read toks, vs: read (popen + 3))
    if is_ident_tok(toks: read toks, i: read (popen + 1)) == false { return false }
    if tk_text(toks: read toks, i: read (popen + 1)) != "self" { return false }
    if String.len(value: read selfEffect) == 0 { return false }
    // Walk back over a dotted receiver path `a.b.c` to its base ident.
    let mut rstart = head
    let mut going = true
    while going {
        if at_symbol(toks: read toks, i: read (rstart - 1), code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (rstart - 2)) {
            rstart = rstart - 2
        } else {
            going = false
        }
    }
    let mut visible = "read"
    if is_effect_kw(toks: read toks, i: read (rstart - 1)) { visible = tk_text(toks: read toks, i: read (rstart - 1)) }
    return selfEffect != visible
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let ntok = List.len(list: read toks)
    let mut callable = Set<String>.new()
    let mut types = Set<String>.new()
    let mut found = false
    // Feature-header diagnostics: RS0016 (unknown feature), RS0017 (duplicate
    // feature within a header), RS0006 (a second `features:` header).
    let mut headerCount = 0
    let mut hasUnknownFeat = false
    let mut hasDupFeat = false
    // RS0002 (any fn missing an explicit return type) / RS0003 (any untyped param).
    let mut missingReturn = false
    let mut untypedParam = false
    // Signature-family diagnostics: RS0004 (unknown effect), RS0010 (removed
    // profile), RS0011 (removed share data effect), RS0012 (removed runtime effect).
    let mut hasProfile = false
    let mut shareParam = false
    let mut unknownEffect = false
    let mut removedRuntime = false
    let mut invalidSelf = false
    let mut retainsBad = false
    let mut unknownType = false
    let mut missingEffect = false
    let mut pureBad = false
    // RS0020: a noalloc fn that calls a non-variant, non-noalloc function.
    let mut noallocCall = false
    // RS0029: any `await` in a non-async function.
    let mut badAwait = false
    // RS0013: an invalid `?` (non-Result return, concrete non-Result operand, or
    // known Result error-type mismatch).
    let mut invalidTry = false
    // RS0015: unsupported/malformed syntax covered by the self-hosted frontend
    // parity corpus.
    let unsupportedSyntax = has_unsupported_syntax_rs0015(source: read source, toks: read toks)
    // RS0023: `Fd` in a non-native fn signature or a non-resource type field.
    let mut fdSurface = false
    // RS0021: any non-exhaustive match statement or expression in the file.
    let mut nonExhaustive = false
    // RS0035: an invalid `#lower_name` pin or a lowered-name collision.
    let mut lowerConflict = false
    let mut seenLowered = Set<String>.new()
    let mut firstPinnedLowered = Set<String>.new()
    // RS0027: an unknown protocol named by a generic bound.
    let mut unknownProtocol = false
    let protocols = collect_protocols(toks: read toks)
    // RS0014/0018/0019: runtime-guarantee body violations.
    let mut noallocAlloc = false
    let mut noBlockCall = false
    let mut noPanicCall = false
    // RS0024: forward-reference-tolerant known-type set for the whole file.
    let declared = collect_declared_types(toks: read toks)
    // RS0008: user sum names whose every variant is payloadless.
    let payloadlessSums = collect_payloadless_sums(toks: read toks)
    // RS0009: resource types, sum variants, and pure/all fn names.
    let mut resources = Set<String>.new()
    let mut sumVariants = Set<String>.new()
    let mut pureFns = Set<String>.new()
    let mut allFns = Set<String>.new()
    let mut noBlockFns = Set<String>.new()
    let mut noPanicFns = Set<String>.new()
    // RS0201: public unqualified fn names + dotted (method) fn names, for the
    // named-argument requirement.
    let mut pubFns = Set<String>.new()
    let mut dottedFns = Set<String>.new()
    collect_call_fn_sigs(toks: read toks, pubFns: mut pubFns, dottedFns: mut dottedFns)
    let mut unnamedArg = false
    // Signature table (cross-function): same-file async fn names, for RS0022.
    let mut asyncFns = Set<String>.new()
    collect_rs0009(toks: read toks, resources: mut resources, sumVariants: mut sumVariants, pureFns: mut pureFns, allFns: mut allFns, noBlockFns: mut noBlockFns, noPanicFns: mut noPanicFns, asyncFns: mut asyncFns)
    // RS0020: names of `effects(noalloc)` fns (allowed callees inside noalloc fns).
    let noallocFns = collect_noalloc_fns(toks: read toks)
    // RS0022: an unconsumed call to a same-file async fn.
    let asyncNotConsumed = has_unconsumed_async_call(toks: read toks, asyncFns: read asyncFns)
    // RS0033: any decimal integer literal in the file that overflows i64.
    let outOfRangeInt = has_out_of_range_int(toks: read toks)
    // RS0212: a value derive (Clone/Eq/Ord/Hash/JsonEncode/JsonDecode) on a resource.
    let resourceDerive = has_bad_resource_derive(toks: read toks)
    // RS0211: a value-derive trait unsupported by a field type (Float/handle not Eq/Ord/Hash).
    let deriveFieldBad = has_bad_derive_field(toks: read toks)
    // RS0032: a generic method's type arg doesn't satisfy the required protocol (Hashable/Ord).
    let protocolBad = has_protocol_violation(toks: read toks)
    // RS1004: surface reference syntax (`&T`/`&mut T`) is not part of RSScript.
    let surfaceRef = has_surface_reference(toks: read toks)
    // RS0708: eager ResourcePool<T>.new needs a positive-literal / const max_size.
    let poolMaxSize = has_resourcepool_maxsize_bad(toks: read toks)
    // RS0037: a positional variant pattern binding != the variant's declared arity.
    let variantArity = has_variant_arity_mismatch(toks: read toks)
    // RS0902: a `weak` field whose type is a known non-class.
    let invalidWeak = has_invalid_weak_field(toks: read toks)
    // RS1003: an `own struct` declaration (removed from the language).
    let ownStruct = has_own_struct(toks: read toks)
    // RS0306: a `local` binding of a class instance.
    let localClass = has_local_class_binding(toks: read toks)
    // RS0701: a non-resource type with a resource-typed field.
    let resourceField = has_resource_field(toks: read toks, resources: read resources)
    // RS0805: an explicit closure's captures(...) contract doesn't match its body's external uses.
    let captureContract = has_capture_contract_bad(toks: read toks)
    // RS0703: a ResourcePool<X> whose X is a non-resource type or non-Resource-bounded generic param.
    let resourcePoolTypeBad = has_resource_pool_type_bad(toks: read toks, resources: read resources, declared: read declared)
    // RS0704: a resource used as a generic argument, or a bad resource-decl generic param.
    let resourceGenericBad = has_resource_generic_bad(toks: read toks, resources: read resources)
    // RS0604: a fresh-returning call used directly with mut/take.
    let freshMut = has_fresh_requires_local(toks: read toks)
    // RS0603: a fresh return type that is a generic param, not a struct.
    let invalidFreshRet = has_invalid_fresh_return(toks: read toks)
    // RS0705: a ResourcePool value bound with let instead of local.
    let poolNotLocal = has_resourcepool_not_local(toks: read toks)
    // RS1002: a cast-style `as` conversion (not a with/use binding).
    let implicitConv = has_implicit_conversion(toks: read toks)
    // RS0208: return-type mismatch (type-inference engine).
    let retTypeMismatch = has_return_type_mismatch(toks: read toks)
    // RS0207: argument/binding-type mismatch.
    let bindTypeMismatch = has_binding_type_mismatch(toks: read toks)
    // RS0210: operator-type mismatch.
    let opTypeMismatch = has_operator_type_mismatch(toks: read toks)
    // RS0209: control-flow type mismatch.
    let cfTypeMismatch = has_control_flow_mismatch(toks: read toks)
    // RS0901: `take` of a `handle` field.
    let takeHandle = has_take_handle_field(toks: read toks)
    // RS0904: a weak field initialized without Weak.from/downgrade.
    let weakInit = has_weak_field_bad_init(toks: read toks)
    // RS0903: reading a weak field without Weak.upgrade.
    let weakRead = has_weak_field_read(toks: read toks)
    // RS0101: feature-gating. Declared features (pre-pass, order-independent) and
    // whole-file construct probes for local/async/unsafe; native is tracked in the
    // fn walk below (the missing-effect source fires even when native is declared).
    let declaredFeatures = collect_declared_features(toks: read toks)
    let localViol = file_local_use(toks: read toks) && Set.contains<String>(set: read declaredFeatures, value: read "local") == false
    let asyncViol = file_async_use(toks: read toks) && Set.contains<String>(set: read declaredFeatures, value: read "async") == false
    let unsafeViol = file_unsafe_use(toks: read toks) && Set.contains<String>(set: read declaredFeatures, value: read "unsafe") == false
    let mut nativeEffect = false
    let mut nativeMissing = false
    // RS0202: a missing/mismatched call-site data effect (any of four sub-cases).
    // Precompute the same-file method-name set (receiver-call resolution gate).
    let mut missingDataEffect = false
    // RS0034: a bare Ok/Err/None bound to an unused, unannotated name.
    let mut uninferable = false
    // RS0311: reassigning an immutable `let` local.
    let mut immutableAssign = false
    let mut manageNonLocal = false
    let mut takeNonLocal = false
    let mut managedToLocal = false
    let mut useAfterManage = false
    let mut retainedLocal = false
    let mut placeConflict0303 = false
    let mut placeConflict0305 = false
    let mut placeConflict0309 = false
    let mut placeConflict0302 = false
    let mut placeConflict0304 = false
    let mut freshReturnBad = false
    let mut closureCapture0801 = false
    let mut closureCapture0804 = false
    let mut lazyCaptureBad = false
    let mut noescapeEscape = false
    let mut localClosureEscape = false
    let freshFnReg = collect_fresh_fns(toks: read toks)
    let mut retainsReg = Set.new<String>()
    collect_retains(toks: read toks, out: mut retainsReg)
    let mut noescapeReg = Set.new<String>()
    collect_noescape_params(toks: read toks, out: mut noescapeReg)
    let mut handleFieldNames = Set.new<String>()
    collect_handle_field_names(toks: read toks, out: mut handleFieldNames)
    // RS0702: a resource escaping its `with`/`view` scope (5 paths).
    let resourceEscape = has_resource_escape(toks: read toks, resources: read resources, retains: read retainsReg)
    let fallibleProducers = collect_fallible_producers(toks: read toks, resources: read resources)
    add_builtin_fallible_producers(out: mut fallibleProducers, allFns: read allFns)
    let missingTry = has_missing_try_producer(toks: read toks, fallible: read fallibleProducers)
    let fallibleFactory = has_fallible_factory(toks: read toks, fallible: read fallibleProducers)
    let leaseConflict = has_active_lease_conflict(toks: read toks)
    let discardNonLease = has_discard_non_lease(toks: read toks)
    let nonTransferPayload = has_nontransferable_channel(toks: read toks)
    let mut assignTypeMismatch = false
    // RS0312: index assignment on a non-List container.
    let indexAssignBad = has_index_assign_non_list(toks: read toks)
    // RS0205: a call that repeats a named argument.
    let mut dupArg = false
    let methodNames = collect_method_names(toks: read toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            let isPub = cls.isPub
            let isFeatures = cls.isFeatures
            let isProfile = cls.isProfile
            let isSum = cls.isSum
            let isNativeMod = cls.isNativeMod
            let isTypeAlias = cls.isTypeAlias
            let isConst = cls.isConst
            if isFeatures {
                headerCount = headerCount + 1
                let lineEnd = declaration_line_end(toks: read toks, start: read i)
                // Feature list is [i+2, lineEnd) (skip the `features :` prefix).
                // Duplicate detection is per-header (seen is reset each header),
                // matching parse_features.
                let mut seen = Set<String>.new()
                let mut j = i + 2
                while j < lineEnd {
                    if at_symbol(toks: read toks, i: read j, code: read SYM_COMMA) {
                        j = j + 1
                    } else if tk_kind(toks: read toks, i: read j) == TOK_EOF {
                        j = j + 1
                    } else {
                        let fname = tk_text(toks: read toks, i: read j)
                        if is_known_feature(name: read fname) {
                            if Set.contains<String>(set: read seen, value: read fname) {
                                hasDupFeat = true
                            } else {
                                Set.insert<String>(set: mut seen, value: read fname)
                            }
                        } else {
                            hasUnknownFeat = true
                        }
                        j = j + 1
                    }
                }
                i = lineEnd
            } else if isProfile {
                hasProfile = true
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = type_name_start(toks: read toks, i: read i)
                    let name = dotted_name_text(toks: read toks, i: read ns)
                    let inTypes = Set.contains<String>(set: read types, value: read name)
                    let inCallable = Set.contains<String>(set: read callable, value: read name)
                    if inTypes || inCallable {
                        found = true
                    }
                    Set.insert<String>(set: mut types, value: read name)
                    Set.insert<String>(set: mut callable, value: read name)
                    let ob = find_body_open(toks: read toks, i: read i, end: read r)
                    if ob >= 0 {
                        if body_has_duplicate_field(toks: read toks, ob: read ob, close: read (r - 1)) {
                            found = true
                        }
                    }
                    if type_decl_unknown(toks: read toks, i: read i, r: read r, declared: read declared) { unknownType = true }
                    // RS0027: an unknown protocol in this type's generic bounds.
                    if generics_unknown_protocol(toks: read toks, nameEnd: read dotted_end(toks: read toks, i: read ns), protocols: read protocols) { unknownProtocol = true }
                    // RS0023: an `Fd`-typed field on a non-resource type. Resource
                    // types are the trusted internal boundary and are skipped.
                    if at_ident(toks: read toks, i: read (ns - 1), wid: read WORD_RESOURCE) == false {
                        if ob >= 0 {
                            if region_has_text(toks: read toks, s: read (ob + 1), e: read (r - 1), word: read "Fd") { fdSurface = true }
                        }
                    }
                    i = r
                }
            } else if isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = sum_name_start(toks: read toks, i: read i)
                    let name = dotted_name_text(toks: read toks, i: read ns)
                    if Set.contains<String>(set: read types, value: read name) {
                        found = true
                    }
                    Set.insert<String>(set: mut types, value: read name)
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    running = false
                } else {
                    let ns = fn_name_start(toks: read toks, i: read i)
                    let name = dotted_name_text(toks: read toks, i: read ns)
                    if Set.contains<String>(set: read callable, value: read name) {
                        found = true
                    }
                    Set.insert<String>(set: mut callable, value: read name)
                    if fn_missing_return(toks: read toks, start: read i) { missingReturn = true }
                    if fn_has_untyped_param(toks: read toks, start: read i) { untypedParam = true }
                    if fn_has_share_param(toks: read toks, start: read i) { shareParam = true }
                    if effects_name_probe(toks: read toks, start: read i, mode: read 0) { unknownEffect = true }
                    if effects_name_probe(toks: read toks, start: read i, mode: read 1) { removedRuntime = true }
                    if fn_has_invalid_self(toks: read toks, start: read i) { invalidSelf = true }
                    if fn_retains_bad(toks: read toks, start: read i) { retainsBad = true }
                    if fn_types_unknown(toks: read toks, start: read i, declared: read declared) { unknownType = true }
                    if fn_missing_param_effect(toks: read toks, start: read i, sums: read payloadlessSums) { missingEffect = true }
                    if fn_pure_bad(toks: read toks, start: read i, resources: read resources, sumVariants: read sumVariants, pureFns: read pureFns, allFns: read allFns, declared: read declared) { pureBad = true }
                    if fn_has_noalloc_call(toks: read toks, start: read i, declared: read declared, sumVariants: read sumVariants, noallocFns: read noallocFns) { noallocCall = true }
                    if fn_has_nonexhaustive_match(toks: read toks, start: read i, declared: read declared, allFns: read allFns) { nonExhaustive = true }
                    if fn_has_bad_await(toks: read toks, start: read i) { badAwait = true }
                    if fn_invalid_try(toks: read toks, start: read i, declared: read declared, allFns: read allFns) { invalidTry = true }
                    if fn_has_unnamed_arg(toks: read toks, start: read i, pubFns: read pubFns, dottedFns: read dottedFns) { unnamedArg = true }
                    if fn_data_effect_bad(toks: read toks, start: read i, declared: read declared, methodNames: read methodNames) { missingDataEffect = true }
                    if fn_has_uninferable_binding(toks: read toks, start: read i) { uninferable = true }
                    if fn_has_immutable_assign(toks: read toks, start: read i) { immutableAssign = true }
                    if fn_manage_take_bad(toks: read toks, start: read i, keyword: read "manage") { manageNonLocal = true }
                    if fn_manage_take_bad(toks: read toks, start: read i, keyword: read "take") { takeNonLocal = true }
                    if fn_has_managed_to_local(toks: read toks, start: read i, handleFields: read handleFieldNames) { managedToLocal = true }
                    if fn_has_use_after_manage(toks: read toks, start: read i) { useAfterManage = true }
                    if fn_has_retained_local(toks: read toks, start: read i, retains: read retainsReg) { retainedLocal = true }
                    let mut pcMutParams = Set.new<String>()
                    collect_mut_params(toks: read toks, ns: read (fn_name_start(toks: read toks, i: read i)), sigEnd: read (function_signature_end(toks: read toks, start: read (fn_name_start(toks: read toks, i: read i) - 1))), out: mut pcMutParams)
                    let pcMask = fn_place_conflicts(toks: read toks, start: read i, handleFields: read handleFieldNames, mutParams: read pcMutParams)
                    if bit_set(mask: read pcMask, bitval: read 1) { placeConflict0303 = true }
                    if bit_set(mask: read pcMask, bitval: read 2) { placeConflict0305 = true }
                    if bit_set(mask: read pcMask, bitval: read 4) { placeConflict0309 = true }
                    if bit_set(mask: read pcMask, bitval: read 8) { placeConflict0302 = true }
                    if bit_set(mask: read pcMask, bitval: read 16) { placeConflict0304 = true }
                    if fn_has_fresh_return_bad(toks: read toks, start: read i, handleFields: read handleFieldNames, retains: read retainsReg, freshFns: read freshFnReg) { freshReturnBad = true }
                    if fn_has_lazy_capture_bad(toks: read toks, start: read i) { lazyCaptureBad = true }
                    if fn_noescape_escape(toks: read toks, start: read i, noescape: read noescapeReg) { noescapeEscape = true }
                    if fn_local_closure_escape(toks: read toks, start: read i, noescape: read noescapeReg) { localClosureEscape = true }
                    let ccMask = fn_has_closure_capture_bad(toks: read toks, start: read i, retains: read retainsReg, noescape: read noescapeReg)
                    if bit_set(mask: read ccMask, bitval: read 1) { closureCapture0801 = true }
                    if bit_set(mask: read ccMask, bitval: read 2) { closureCapture0804 = true }
                    if fn_has_assign_type_mismatch(toks: read toks, start: read i) { assignTypeMismatch = true }
                    if fn_has_dup_arg(toks: read toks, start: read i) { dupArg = true }
                    if fn_has_fd_surface(toks: read toks, start: read i) { fdSurface = true }
                    // RS0027: an unknown protocol in this fn's generic bounds.
                    if generics_unknown_protocol(toks: read toks, nameEnd: read dotted_end(toks: read toks, i: read ns), protocols: read protocols) { unknownProtocol = true }
                    // RS0014/0018/0019: runtime-guarantee body violations.
                    if fn_noalloc_alloc(toks: read toks, start: read i, declared: read declared) { noallocAlloc = true }
                    if fn_guarantee_call_bad(toks: read toks, start: read i, effName: read "no_block", allFns: read allFns, guaranteeFns: read noBlockFns) { noBlockCall = true }
                    if fn_guarantee_call_bad(toks: read toks, start: read i, effName: read "no_panic", allFns: read allFns, guaranteeFns: read noPanicFns) { noPanicCall = true }
                    // RS0101: a fn with `effects(native)` (gated by the `native`
                    // feature), and a `native fn` missing that effect (ungated).
                    let hasNativeEff = effects_name_probe(toks: read toks, start: read i, mode: read 2)
                    if hasNativeEff { nativeEffect = true }
                    if fn_is_native(toks: read toks, start: read i) && hasNativeEff == false { nativeMissing = true }
                    // RS0035: an invalid `#lower_name` pin or a lowered-name collision.
                    if fn_has_lower_name(toks: read toks, start: read i) {
                        let pin = fn_lower_name_pin(toks: read toks, start: read i)
                        if is_valid_rust_ident(name: read pin) == false {
                            lowerConflict = true
                        } else if Set.contains<String>(set: read seenLowered, value: read pin) {
                            lowerConflict = true
                        } else {
                            Set.insert<String>(set: mut seenLowered, value: read pin)
                            Set.insert<String>(set: mut firstPinnedLowered, value: read pin)
                        }
                    } else {
                        let lowered = default_lowered_name(name: read name)
                        if Set.contains<String>(set: read seenLowered, value: read lowered) {
                            if Set.contains<String>(set: read firstPinnedLowered, value: read lowered) { lowerConflict = true }
                        } else {
                            Set.insert<String>(set: mut seenLowered, value: read lowered)
                        }
                    }
                    i = r
                }
            } else {
                // Unrecognized top-level token: skip it and keep scanning, so a
                // single malformed item doesn't truncate the scan and miss a later
                // duplicate. The Rust analyzer recovers here too; advancing by one
                // token guarantees progress (no infinite loop).
                i = i + 1
            }
        }
    }
    if missingReturn {
        Log.write(message: read "RS0002")
    }
    if untypedParam {
        Log.write(message: read "RS0003")
    }
    if unknownEffect {
        Log.write(message: read "RS0004")
    }
    if found {
        Log.write(message: read "RS0005")
    }
    if hasProfile {
        Log.write(message: read "RS0010")
    }
    if shareParam {
        Log.write(message: read "RS0011")
    }
    if removedRuntime {
        Log.write(message: read "RS0012")
    }
    if invalidSelf {
        Log.write(message: read "RS0028")
    }
    if retainsBad {
        Log.write(message: read "RS0007")
    }
    if missingEffect {
        Log.write(message: read "RS0008")
    }
    if pureBad {
        Log.write(message: read "RS0009")
    }
    if nonExhaustive {
        Log.write(message: read "RS0021")
    }
    if badAwait {
        Log.write(message: read "RS0029")
    }
    if invalidTry {
        Log.write(message: read "RS0013")
    }
    if unsupportedSyntax {
        Log.write(message: read "RS0015")
    }
    if unnamedArg {
        Log.write(message: read "RS0201")
    }
    if missingDataEffect {
        Log.write(message: read "RS0202")
    }
    if asyncNotConsumed {
        Log.write(message: read "RS0022")
    }
    if fdSurface {
        Log.write(message: read "RS0023")
    }
    if lowerConflict {
        Log.write(message: read "RS0035")
    }
    if unknownProtocol {
        Log.write(message: read "RS0027")
    }
    if noallocAlloc {
        Log.write(message: read "RS0014")
    }
    if noBlockCall {
        Log.write(message: read "RS0018")
    }
    if noPanicCall {
        Log.write(message: read "RS0019")
    }
    if unknownType {
        Log.write(message: read "RS0024")
    }
    if outOfRangeInt {
        Log.write(message: read "RS0033")
    }
    if hasUnknownFeat {
        Log.write(message: read "RS0016")
    }
    if hasDupFeat {
        Log.write(message: read "RS0017")
    }
    if headerCount >= 2 {
        Log.write(message: read "RS0006")
    }
    if resourceDerive {
        Log.write(message: read "RS0212")
    }
    if deriveFieldBad {
        Log.write(message: read "RS0211")
    }
    if protocolBad {
        Log.write(message: read "RS0032")
    }
    if surfaceRef {
        Log.write(message: read "RS1004")
    }
    if poolMaxSize {
        Log.write(message: read "RS0708")
    }
    if variantArity {
        Log.write(message: read "RS0037")
    }
    if uninferable {
        Log.write(message: read "RS0034")
    }
    if immutableAssign {
        Log.write(message: read "RS0311")
    }
    if dupArg {
        Log.write(message: read "RS0205")
    }
    if noallocCall {
        Log.write(message: read "RS0020")
    }
    if invalidWeak {
        Log.write(message: read "RS0902")
    }
    if ownStruct {
        Log.write(message: read "RS1003")
    }
    if localClass {
        Log.write(message: read "RS0306")
    }
    if assignTypeMismatch {
        Log.write(message: read "RS0313")
    }
    if indexAssignBad {
        Log.write(message: read "RS0312")
    }
    if manageNonLocal {
        Log.write(message: read "RS0307")
    }
    if takeNonLocal {
        Log.write(message: read "RS0308")
    }
    if managedToLocal {
        Log.write(message: read "RS0301")
    }
    if useAfterManage {
        Log.write(message: read "RS0401")
    }
    if retainedLocal {
        Log.write(message: read "RS0501")
    }
    if placeConflict0303 {
        Log.write(message: read "RS0303")
    }
    if placeConflict0305 {
        Log.write(message: read "RS0305")
    }
    if placeConflict0309 {
        Log.write(message: read "RS0309")
    }
    if placeConflict0302 {
        Log.write(message: read "RS0302")
    }
    if placeConflict0304 {
        Log.write(message: read "RS0304")
    }
    if freshReturnBad {
        Log.write(message: read "RS0601")
    }
    if closureCapture0801 {
        Log.write(message: read "RS0801")
    }
    if closureCapture0804 {
        Log.write(message: read "RS0804")
    }
    if captureContract {
        Log.write(message: read "RS0805")
    }
    if resourcePoolTypeBad {
        Log.write(message: read "RS0703")
    }
    if resourceGenericBad {
        Log.write(message: read "RS0704")
    }
    if lazyCaptureBad {
        Log.write(message: read "RS0711")
    }
    if noescapeEscape {
        Log.write(message: read "RS0802")
    }
    if localClosureEscape {
        Log.write(message: read "RS0803")
    }
    if resourceEscape {
        Log.write(message: read "RS0702")
    }
    if missingTry {
        Log.write(message: read "RS0706")
    }
    if fallibleFactory {
        Log.write(message: read "RS0707")
    }
    if leaseConflict {
        Log.write(message: read "RS0709")
    }
    if discardNonLease {
        Log.write(message: read "RS0710")
    }
    if nonTransferPayload {
        Log.write(message: read "RS0036")
    }
    if resourceField {
        Log.write(message: read "RS0701")
    }
    if freshMut {
        Log.write(message: read "RS0604")
    }
    if invalidFreshRet {
        Log.write(message: read "RS0603")
    }
    if poolNotLocal {
        Log.write(message: read "RS0705")
    }
    if implicitConv {
        Log.write(message: read "RS1002")
    }
    if retTypeMismatch {
        Log.write(message: read "RS0208")
    }
    if bindTypeMismatch {
        Log.write(message: read "RS0207")
    }
    if opTypeMismatch {
        Log.write(message: read "RS0210")
    }
    if cfTypeMismatch {
        Log.write(message: read "RS0209")
    }
    if takeHandle {
        Log.write(message: read "RS0901")
    }
    if weakInit {
        Log.write(message: read "RS0904")
    }
    if weakRead {
        Log.write(message: read "RS0903")
    }
    // RS0101: any unfeatured feature-requiring construct. Native fires if a fn has
    // `effects(native)` without the feature, OR a `native fn` omits that effect.
    let nativeViol = nativeMissing || (nativeEffect && Set.contains<String>(set: read declaredFeatures, value: read "native") == false)
    let featureViol = localViol || asyncViol || unsafeViol || nativeViol
    if featureViol {
        Log.write(message: read "RS0101")
    }
    let anyDiag = found || hasUnknownFeat || hasDupFeat || headerCount >= 2 || missingReturn || untypedParam || hasProfile || shareParam || unknownEffect || removedRuntime || invalidSelf || outOfRangeInt || retainsBad || unknownType || missingEffect || pureBad || nonExhaustive || badAwait || invalidTry || unsupportedSyntax || fdSurface || lowerConflict || unknownProtocol || noallocAlloc || noBlockCall || noPanicCall || asyncNotConsumed || featureViol || unnamedArg || missingDataEffect || resourceDerive || variantArity || uninferable || immutableAssign || dupArg || noallocCall || invalidWeak || ownStruct || localClass || resourceField || freshMut || invalidFreshRet || poolNotLocal || implicitConv || retTypeMismatch || bindTypeMismatch || opTypeMismatch || cfTypeMismatch || deriveFieldBad || protocolBad || surfaceRef || poolMaxSize || assignTypeMismatch || indexAssignBad || manageNonLocal || takeNonLocal || managedToLocal || useAfterManage || retainedLocal || placeConflict0303 || placeConflict0305 || placeConflict0309 || placeConflict0302 || placeConflict0304 || freshReturnBad || closureCapture0801 || closureCapture0804 || captureContract || resourcePoolTypeBad || resourceGenericBad || lazyCaptureBad || resourceEscape || noescapeEscape || localClosureEscape || missingTry || fallibleFactory || leaseConflict || discardNonLease || nonTransferPayload || takeHandle || weakInit || weakRead
    if anyDiag == false {
        Log.write(message: read "CLEAN")
    }
    return Unit
}
