// Self-hosted rss checker — Phase 3 (semantic diagnostic parity, driver only).
//
// Reads rss source as argv[0] and prints the analyzer diagnostic codes it finds,
// one per line, or `CLEAN` if none. Oracle: crate::analyze_source filtered to the
// target codes (see SELFHOST_CHECKER_TARGET_CODES and selfhost_parity.rs).
//
// Diagnostic collection, output, and checker-local models live under
// selfhost/checker. This module owns orchestration and output ordering only.

module selfhost.check

use selfhost.scan.*
use selfhost.interfaces.*
use selfhost.checker.support.*
use selfhost.checker.output.*
use selfhost.checker.type_model.*
use selfhost.checker.diagnostics.syntax_declarations.*
use selfhost.checker.diagnostics.effects_calls.*
use selfhost.semantics.check_types.*
use selfhost.semantics.check_bindings.*
use selfhost.semantics.check_calls.*
use selfhost.semantics.declarations.*
use selfhost.semantics.diagnostics.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*
use selfhost.syntax.token_ranges.*
use selfhost.types.*

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let structured = Args.get_or_default(index: 1, default: "") == "records"
    let toks = tokenize(source: source)
    let program = parse_program(toks: toks)
    let semanticIndex = SemanticIndex.prepare(program: program)
    let mut typeDiagnostics = DiagnosticBag.empty()
    collect_program_type_diagnostics(program: program, semantics: semanticIndex, diagnostics: mut typeDiagnostics)
    collect_program_binding_diagnostics(program: program, diagnostics: mut typeDiagnostics)
    let mut callDiagnostics = DiagnosticBag.empty()
    let mut callEffectOwnedSites = Set<String>.new()
    let mut callTypeOwnedSites = Set<String>.new()
    collect_program_call_contract_diagnostics(
        program: program,
        semantics: semanticIndex,
        diagnostics: mut callDiagnostics,
        effectOwnedSites: mut callEffectOwnedSites,
        typeOwnedSites: mut callTypeOwnedSites
    )
    let astMatchExpressionSites = collect_match_expression_sites(program: program)
    let mut astControlSites = Set<String>.new()
    let mut astNonExhaustiveSites = Set<String>.new()
    let mut astAwaitSites = Set<String>.new()
    let mut astAsyncCallSites = Set<String>.new()
    let mut astDiagnosticIndex = 0
    while astDiagnosticIndex < List.len(list: typeDiagnostics.items) {
        let diagnostic = List.get<Diagnostic>(list: typeDiagnostics.items, index: astDiagnosticIndex)
        let key = condition_site_key(line: diagnostic.line, column: diagnostic.column, length: diagnostic.length)
        Set.insert<String>(set: mut astControlSites, value: key)
        if diagnostic.code == "RS0021" { Set.insert<String>(set: mut astNonExhaustiveSites, value: key) }
        if diagnostic.code == "RS0029" { Set.insert<String>(set: mut astAwaitSites, value: key) }
        if diagnostic.code == "RS0022" { Set.insert<String>(set: mut astAsyncCallSites, value: key) }
        astDiagnosticIndex = astDiagnosticIndex + 1
    }
    let ntok = List.len(list: toks)
    // Feature-header diagnostics: RS0016 (unknown feature), RS0017 (duplicate
    // feature within a header), RS0006 (a second `features:` header).
    let mut headerCount = 0
    let mut hasUnknownFeat = false
    let mut hasDupFeat = false
    // RS0002 (any fn missing an explicit return type) / RS0003 (any untyped param).
    let mut missingReturn = false
    let mut untypedParam = false
    let mut signatureDiagnostics = DiagnosticBag.empty()
    // Signature-family diagnostics: RS0004 (unknown effect), RS0010 (removed
    // profile), RS0011 (removed share data effect), RS0012 (removed runtime effect).
    let mut hasProfile = false
    let mut shareParam = false
    let mut unknownEffect = false
    let mut removedRuntime = false
    let mut retainsBad = false
    let mut unknownType = false
    let mut unknownTypeTokens = List<Int>.new()
    let mut pureBad = false
    let mut pureBadTokens = List<Int>.new()
    // RS0020: a noalloc fn that calls a non-variant, non-noalloc function.
    let mut noallocCall = false
    let mut noallocCallTokens = List<Int>.new()
    // RS0029: any `await` in a non-async function.
    let mut badAwait = false
    let mut badAwaitTokens = List<Int>.new()
    // RS0013: an invalid `?` (non-Result return, concrete non-Result operand, or
    // known Result error-type mismatch).
    let mut invalidTry = false
    let mut invalidTryTokens = List<Int>.new()
    // RS0015: unsupported/malformed syntax covered by the self-hosted frontend
    // parity corpus.
    let unsupportedSyntax = has_unsupported_syntax_rs0015(source, toks, program)
    // RS0023: `Fd` in a non-fn signature or a non-resource type field.
    let mut fdSurface = false
    let mut fdSurfaceTokens = List<Int>.new()
    // RS0021: any non-exhaustive match statement or expression in the file.
    let mut nonExhaustive = false
    let mut nonExhaustiveTokens = List<Int>.new()
    // RS0035: an invalid `#lower_name` pin or a lowered-name collision.
    let mut lowerConflict = false
    // RS0014/0018/0019: runtime-guarantee body violations.
    let mut noallocAlloc = false
    let mut noallocAllocSites = List<DiagnosticSite>.new()
    let mut noBlockCall = false
    let mut noBlockCallSites = List<DiagnosticSite>.new()
    let mut noPanicCall = false
    let mut noPanicCallSites = List<DiagnosticSite>.new()
    // RS0024: forward-reference-tolerant known-type set for the whole file.
    let declared = collect_declared_types(toks)
    // RS0009: resource types, sum variants, and pure/all fn names.
    let mut resources = Set<String>.new()
    let mut sumVariants = Set<String>.new()
    let mut pureFns = Set<String>.new()
    let mut allFns = Set<String>.new()
    let mut noBlockFns = Set<String>.new()
    let mut noPanicFns = Set<String>.new()
    // RS0201: public unqualified fn names + dotted (method) fn names, for the
    // named-argument requirement.
    let mut pubFns = Set<String>.new()
    let mut dottedFns = Set<String>.new()
    collect_call_fn_sigs(toks, pubFns: mut pubFns, dottedFns: mut dottedFns)
    let mut unnamedArg = false
    let mut unnamedArgTokens = List<Int>.new()
    // Signature table (cross-function): same-file async fn names, for RS0022.
    let mut asyncFns = Set<String>.new()
    let mut unsafeFns = Set<String>.new()
    collect_rs0009(toks, resources: mut resources, sumVariants: mut sumVariants, pureFns: mut pureFns, allFns: mut allFns, noBlockFns: mut noBlockFns, noPanicFns: mut noPanicFns, asyncFns: mut asyncFns, unsafeFns: mut unsafeFns)
    // RS0020: names of `` fns (allowed callees inside noalloc fns).
    let noallocFns = collect_noalloc_fns(toks)
    // RS0022: an unconsumed call to a same-file async fn.
    let mut asyncNotConsumedTokens = List<Int>.new()
    let mut asyncNotConsumed = collect_unconsumed_async_call_tokens(
        toks,
        asyncFns,
        astAsyncCallSites,
        out: mut asyncNotConsumedTokens
    )
    // RS0033: any decimal integer literal in the file that overflows i64.
    let mut outOfRangeIntTokens = List<Int>.new()
    let outOfRangeInt = collect_out_of_range_int_tokens(toks, out: mut outOfRangeIntTokens)
    let mut cyclicAliasTokens = List<Int>.new()
    let cyclicAlias = collect_cyclic_type_alias_tokens(toks, out: mut cyclicAliasTokens)
    // RS0212: a value derive (Clone/Eq/Ord/Hash/JsonEncode/JsonDecode) on a resource.
    let mut resourceDeriveTokens = List<Int>.new()
    let resourceDerive = collect_bad_resource_derives(toks, out: mut resourceDeriveTokens)
    // RS0211: a value-derive trait unsupported by a field type (Float/handle not Eq/Ord/Hash).
    let mut deriveFieldBadTokens = List<Int>.new()
    let deriveFieldBad = collect_bad_derive_field_tokens(toks, out: mut deriveFieldBadTokens)
    // RS0032: a generic method's type arg doesn't satisfy the required protocol (Hashable/Ord).
    let mut protocolBadTokens = List<Int>.new()
    let mut protocolBad = collect_protocol_violation_tokens(toks, out: mut protocolBadTokens)
    // RS1004: surface reference syntax (`&T`/`&mut T`) is not part of RSScript.
    let mut surfaceRefTokens = List<Int>.new()
    let surfaceRef = collect_surface_references(toks, out: mut surfaceRefTokens)
    // RS0037: a positional variant pattern binding != the variant's declared arity.
    let mut variantArity = false
    // RS0902: a `weak` field whose type is a known non-class.
    let mut invalidWeakTokens = List<Int>.new()
    let invalidWeak = collect_invalid_weak_fields(toks, out: mut invalidWeakTokens)
    // RS1003: an `own struct` declaration (removed from the language).
    let mut ownStructTokens = List<Int>.new()
    let ownStruct = collect_own_struct_tokens(toks, out: mut ownStructTokens)
    // RS0306: a `local` binding of a class instance.
    let mut localClassTokens = List<Int>.new()
    let localClass = collect_local_class_bindings(toks, out: mut localClassTokens)
    // RS0701: a non-resource type with a resource-typed field.
    let mut resourceFieldTokens = List<Int>.new()
    let resourceField = collect_resource_fields(toks, resources, out: mut resourceFieldTokens)
    // RS0805: an explicit closure's captures(...) contract doesn't match its body's external uses.
    let mut captureContractTokens = List<Int>.new()
    let captureContract = collect_capture_contract_bad_tokens(toks, out: mut captureContractTokens)
    // RS0704: a resource used as a generic argument, or a bad resource-decl generic param.
    let mut resourceGenericBadTokens = List<Int>.new()
    let tokenResourceGenericBad = collect_resource_generic_bad_tokens(toks, resources, out: mut resourceGenericBadTokens)
    // RS0604: a fresh-returning call used directly with mut/take.
    let mut freshMutSites = List<DiagnosticSite>.new()
    let freshMut = collect_fresh_requires_local_sites(source, toks, out: mut freshMutSites)
    // RS1002: a cast-style `as` conversion (not a with/use binding).
    let mut implicitConvTokens = List<Int>.new()
    let implicitConv = collect_implicit_conversions(toks, out: mut implicitConvTokens)
    // RS0208: return-type mismatch (type-inference engine).
    let mut retTypeMismatchTokens = List<Int>.new()
    let retTypeMismatch = collect_return_type_mismatch_tokens(toks, out: mut retTypeMismatchTokens)
    // RS0207: argument/binding-type mismatch.
    let mut bindTypeMismatchTokens = List<Int>.new()
    collect_binding_type_mismatch_tokens(toks, out: mut bindTypeMismatchTokens)
    bindTypeMismatchTokens = filter_owned_token_sites(
        toks: toks,
        tokenIndices: bindTypeMismatchTokens,
        ownedSites: callTypeOwnedSites
    )
    let bindTypeMismatch = List.len(list: bindTypeMismatchTokens) > 0
        || DiagnosticBag.has_code(self: callDiagnostics, code: "RS0207")
        || has_legacy_binding_type_mismatch(toks)
    // RS0210: operator-type mismatch.
    let mut opTypeMismatchTokens = List<Int>.new()
    let opTypeMismatch = collect_operator_type_mismatch_tokens(toks, out: mut opTypeMismatchTokens)
    // RS1001: arithmetic or bitwise operator with a known non-numeric operand.
    let mut operatorOverloadTokens = List<Int>.new()
    let operatorOverload = collect_operator_overload_tokens(toks, out: mut operatorOverloadTokens)
    // RS0209: control-flow type mismatch.
    let mut cfTypeMismatchTokens = List<Int>.new()
    let mut cfTypeMismatch = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0209")
    if collect_control_flow_mismatch_tokens(toks, astControlSites, astMatchExpressionSites, out: mut cfTypeMismatchTokens) { cfTypeMismatch = true }
    // RS0901: `take` of a `handle` field.
    let mut takeHandleTokens = List<Int>.new()
    let takeHandle = collect_take_handle_field_tokens(toks, out: mut takeHandleTokens)
    // RS0904: a weak field initialized without Weak.from/downgrade.
    let mut weakInitTokens = List<Int>.new()
    let weakInit = collect_weak_field_bad_init_tokens(toks, out: mut weakInitTokens)
    // RS0903: reading a weak field without Weak.upgrade.
    let mut weakReadTokens = List<Int>.new()
    let weakRead = collect_weak_field_read_tokens(toks, out: mut weakReadTokens)
    // RS0202: a missing/mismatched call-site data effect (any of four sub-cases).
    // Precompute the same-file method-name set (receiver-call resolution gate).
    let mut missingDataEffect = false
    let mut missingDataEffectSites = List<DiagnosticSite>.new()
    // RS0034 is owned by the shared AST binding rules.
    let uninferable = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0034")
    // RS0311 is owned by the shared AST binding rules.
    let immutableAssign = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0311")
    let mut manageNonLocal = false
    let mut manageNonLocalTokens = List<Int>.new()
    let mut takeNonLocal = false
    let mut takeNonLocalTokens = List<Int>.new()
    let mut managedToLocal = false
    let mut managedToLocalTokens = List<Int>.new()
    let mut useAfterManage = false
    let mut useAfterManageTokens = List<Int>.new()
    let mut retainedLocal = false
    let mut retainedLocalTokens = List<Int>.new()
    let mut placeConflict0303 = false
    let mut placeConflict0305 = false
    let mut placeConflict0309 = false
    let mut placeConflict0302 = false
    let mut placeConflict0304 = false
    let mut placeConflict0302Sites = List<DiagnosticSite>.new()
    let mut placeConflict0303Sites = List<DiagnosticSite>.new()
    let mut placeConflict0304Sites = List<DiagnosticSite>.new()
    let mut placeConflict0305Sites = List<DiagnosticSite>.new()
    let mut placeConflict0309Sites = List<DiagnosticSite>.new()
    let mut freshReturnBad = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0601")
    let mut freshReturnBadSites = List<DiagnosticSite>.new()
    let mut closureCapture0801 = false
    let mut closureCapture0804 = false
    let mut closureCapture0801Tokens = List<Int>.new()
    let mut closureCapture0804Tokens = List<Int>.new()
    let mut noescapeEscape = false
    let mut localClosureEscape = false
    let mut noescapeEscapeTokens = List<Int>.new()
    let mut localClosureEscapeTokens = List<Int>.new()
    let freshFnReg = collect_fresh_fns(toks)
    let mut retainsReg = Set.new<String>()
    collect_retains(toks, out: mut retainsReg)
    let mut noescapeReg = Set.new<String>()
    collect_noescape_params(toks, out: mut noescapeReg)
    let mut handleFieldNames = Set.new<String>()
    collect_handle_field_names(toks, out: mut handleFieldNames)
    // RS0702: a resource escaping its `with`/`view` scope (5 paths).
    let mut resourceEscapeTokens = List<Int>.new()
    let resourceEscape = collect_resource_escape_tokens(toks, resources, retains: retainsReg, out: mut resourceEscapeTokens)
    let fallibleProducers = collect_fallible_producers(toks, resources)
    let mut missingTryTokens = List<Int>.new()
    let missingTry = collect_missing_try_producer_tokens(toks, fallible: fallibleProducers, out: mut missingTryTokens)
    let mut nonTransferPayloadTokens = List<Int>.new()
    let nonTransferPayload = collect_nontransferable_channel_tokens(toks, out: mut nonTransferPayloadTokens)
    let assignTypeMismatch = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0313")
    // RS0312: index assignment on a non-List container.
    let indexAssignBad = DiagnosticBag.has_code(self: typeDiagnostics, code: "RS0312")
    // RS0205: a call that repeats a named argument.
    let mut dupArg = false
    let methodNames = collect_method_names(toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            let isFeatures = cls.isFeatures
            let isProfile = cls.isProfile
            let isSum = cls.isSum
            let isNativeMod = cls.isNativeMod
            let isTypeAlias = cls.isTypeAlias
            let isConst = cls.isConst
            if isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ns = type_name_start(toks, i)
                    let ob = find_body_open(toks, i, end: r)
                    if collect_type_decl_unknown_tokens(toks, i, r, declared, out: mut unknownTypeTokens) { unknownType = true }
                    // RS0023: an `Fd`-typed field on a non-resource type. Resource
                    // types are the trusted internal boundary and are skipped.
                    if at_ident(toks: toks, i: (ns - 1), wid: WORD_RESOURCE) == false {
                        if ob >= 0 {
                            if collect_text_tokens(toks, s: (ob + 1), e: (r - 1), word: "Fd", out: mut fdSurfaceTokens) { fdSurface = true }
                        }
                    }
                    i = r
                }
            } else if isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ns = fn_name_start(toks, i)
                    let name = dotted_name_text(toks, i: ns)
                    if collect_fn_unknown_type_tokens(toks, start: i, declared, out: mut unknownTypeTokens) { unknownType = true }
                    if collect_fn_pure_bad_tokens(toks, start: i, resources, sumVariants, pureFns, allFns, declared, out: mut pureBadTokens) { pureBad = true }
                    if collect_fn_noalloc_call_tokens(toks, start: i, declared, sumVariants, noallocFns, out: mut noallocCallTokens) { noallocCall = true }
                    if collect_fn_nonexhaustive_match_tokens(toks, start: i, declared, allFns, astNonExhaustiveSites, out: mut nonExhaustiveTokens) { nonExhaustive = true }
                    if collect_fn_bad_await_tokens(toks, start: i, astAwaitSites, out: mut badAwaitTokens) { badAwait = true }
                    if collect_fn_invalid_try_tokens(toks, start: i, declared, allFns, out: mut invalidTryTokens) { invalidTry = true }
                    if collect_fn_unnamed_arg_tokens(toks, start: i, pubFns, dottedFns, out: mut unnamedArgTokens) { unnamedArg = true }
                    if collect_fn_data_effect_sites(source, toks, start: i, declared, methodNames, out: mut missingDataEffectSites) { missingDataEffect = true }
                    if collect_fn_manage_take_bad_tokens(toks, start: i, keyword: "manage", out: mut manageNonLocalTokens) { manageNonLocal = true }
                    if collect_fn_manage_take_bad_tokens(toks, start: i, keyword: "take", out: mut takeNonLocalTokens) { takeNonLocal = true }
                    if collect_fn_managed_to_local_tokens(toks, start: i, handleFields: handleFieldNames, out: mut managedToLocalTokens) { managedToLocal = true }
                    if collect_fn_use_after_manage_tokens(toks, start: i, out: mut useAfterManageTokens) { useAfterManage = true }
                    if collect_fn_retained_local_tokens(toks, start: i, retains: retainsReg, out: mut retainedLocalTokens) { retainedLocal = true }
                    let mut pcMutParams = Set.new<String>()
                    collect_mut_params(toks, ns: (fn_name_start(toks, i)), sigEnd: (function_signature_end(toks: toks, start: (fn_name_start(toks, i) - 1))), out: mut pcMutParams)
                    let pcMask = collect_fn_place_conflicts(
                        source,
                        toks,
                        start: i,
                        handleFields: handleFieldNames,
                        mutParams: pcMutParams,
                        out0302: mut placeConflict0302Sites,
                        out0303: mut placeConflict0303Sites,
                        out0304: mut placeConflict0304Sites,
                        out0305: mut placeConflict0305Sites,
                        out0309: mut placeConflict0309Sites
                    )
                    if bit_set(mask: pcMask, bitval: 1) { placeConflict0303 = true }
                    if bit_set(mask: pcMask, bitval: 2) { placeConflict0305 = true }
                    if bit_set(mask: pcMask, bitval: 4) { placeConflict0309 = true }
                    if bit_set(mask: pcMask, bitval: 8) { placeConflict0302 = true }
                    if bit_set(mask: pcMask, bitval: 16) { placeConflict0304 = true }
                    if collect_fn_fresh_return_bad_sites(source, toks, start: i, handleFields: handleFieldNames, retains: retainsReg, freshFns: freshFnReg, out: mut freshReturnBadSites) { freshReturnBad = true }
                    if collect_fn_noescape_escape_tokens(toks, start: i, noescape: noescapeReg, out: mut noescapeEscapeTokens) { noescapeEscape = true }
                    if collect_fn_local_closure_escape_tokens(toks, start: i, noescape: noescapeReg, out: mut localClosureEscapeTokens) { localClosureEscape = true }
                    let ccMask = collect_fn_closure_capture_bad(
                        toks,
                        start: i,
                        retains: retainsReg,
                        noescape: noescapeReg,
                        out0801: mut closureCapture0801Tokens,
                        out0804: mut closureCapture0804Tokens
                    )
                    if bit_set(mask: ccMask, bitval: 1) { closureCapture0801 = true }
                    if bit_set(mask: ccMask, bitval: 2) { closureCapture0804 = true }
                    if collect_fn_fd_surface_tokens(toks, start: i, out: mut fdSurfaceTokens) { fdSurface = true }
                    // RS0014/0018/0019: runtime-guarantee body violations.
                    if collect_fn_noalloc_alloc_sites(source, toks, start: i, declared, out: mut noallocAllocSites) { noallocAlloc = true }
                    if collect_fn_guarantee_call_bad_sites(source, toks, start: i, effName: "no_block", allFns, guaranteeFns: noBlockFns, out: mut noBlockCallSites) { noBlockCall = true }
                    if collect_fn_guarantee_call_bad_sites(source, toks, start: i, effName: "no_panic", allFns, guaranteeFns: noPanicFns, out: mut noPanicCallSites) { noPanicCall = true }
                    i = r
                }
            } else {
                // Unrecognized top-level token: skip it and keep scanning, so a
                // single malformed item doesn't truncate the scan and miss a later
                // duplicate. The Rust analyzer recovers here too; advancing by one
                // token guarantees progress (no infinite loop).
                i = i + 1
            }
        }
    }
    collect_program_declaration_diagnostics(program, diagnostics: mut signatureDiagnostics)
    lowerConflict = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0035")
    collect_program_variant_arity_diagnostics(program, diagnostics: mut signatureDiagnostics)
    collect_program_call_diagnostics(program, semantics: semanticIndex, diagnostics: mut signatureDiagnostics)
    missingDataEffectSites = filter_owned_diagnostic_sites(
        sites: missingDataEffectSites,
        ownedSites: callEffectOwnedSites
    )
    missingDataEffect = List.len(list: missingDataEffectSites) > 0
        || DiagnosticBag.has_code(self: callDiagnostics, code: "RS0202")
    missingReturn = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0002")
    untypedParam = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0003")
    unknownEffect = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0004")
    let invalidSelf = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0028")
    retainsBad = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0007")
    variantArity = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0037")
    dupArg = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0205")
    let duplicateFound = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0005")
    shareParam = DiagnosticBag.has_code(self: signatureDiagnostics, code: "RS0011")
