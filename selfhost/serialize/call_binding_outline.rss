// Test-only outline for canonical call binding.

module selfhost.serialize.call_binding_outline

use selfhost.scan.*
use selfhost.semantics.call_binding.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

fn source_name(argument: BoundArgument) -> String {
    if argument.sourceKind == BOUND_SOURCE_RECEIVER { return "receiver" }
    if argument.sourceKind == BOUND_SOURCE_EXPLICIT {
        return String.concat(left: "arg", right: String.from_int(value: argument.sourceIndex))
    }
    if argument.sourceKind == BOUND_SOURCE_DEFAULT { return "default" }
    return "none"
}

fn emit_bound_slot(callee: String, parameter: String, argument: BoundArgument) -> Unit {
    let head = String.concat(left: String.concat(left: callee, right: "\t"), right: parameter)
    let source = String.concat(left: String.concat(left: "\t", right: source_name(argument: argument)), right: String.concat(left: "\teval=", right: String.from_int(value: argument.evaluationIndex)))
    Log.write(message: String.concat(left: head, right: source))
    return Unit
}

fn emit_binding_status(callee: String, binding: CallBinding) -> Unit {
    let mut status = "invalid"
    if CallBinding.is_complete(self: binding) { status = "complete" }
    Log.write(message: String.concat(left: String.concat(left: callee, right: "\tstatus\t"), right: status))
    return Unit
}

fn emit_field_slots(callee: String, fields: List<Field>, binding: CallBinding) -> Unit {
    let mut fieldIndex = 0
    while fieldIndex < List.len(list: fields) {
        let field = List.get<Field>(list: fields, index: fieldIndex)
        let argument = List.get<BoundArgument>(list: binding.byParameter, index: fieldIndex)
        emit_bound_slot(callee: callee, parameter: field.name, argument: argument)
        fieldIndex = fieldIndex + 1
    }
    return Unit
}

fn emit_call_binding(program: Program, semantics: SemanticIndex, expressionIndex: Int) -> Unit {
    if expressionIndex < 0 || expressionIndex >= List.len(list: program.expressions) { return Unit }
    let expression = List.get<Expr>(list: program.expressions, index: expressionIndex)
    if expression.kind != EXPR_CALL { return Unit }
    let preparedIndex = SemanticIndex.call_index(self: semantics, expressionIndex: expressionIndex)
    if preparedIndex < 0 { return Unit }
    let prepared = List.get<PreparedCall>(list: semantics.calls, index: preparedIndex)
    let callable = List.get<CallableDecl>(list: semantics.callables, index: prepared.callableIndex)
    let item = List.get<Item>(list: program.items, index: callable.itemIndex)
    if callable.kind == CALLABLE_FUNCTION {
        let mut parameterIndex = 0
        while parameterIndex < List.len(list: item.params) {
            let parameter = List.get<Param>(list: item.params, index: parameterIndex)
            let argument = List.get<BoundArgument>(list: prepared.binding.byParameter, index: parameterIndex)
            emit_bound_slot(callee: expression.text, parameter: parameter.name, argument: argument)
            parameterIndex = parameterIndex + 1
        }
    } else if callable.kind == CALLABLE_CONSTRUCTOR {
        emit_field_slots(callee: expression.text, fields: item.fields, binding: prepared.binding)
    } else {
        let variant = List.get<Variant>(list: item.variants, index: callable.variantIndex)
        emit_field_slots(callee: expression.text, fields: variant.fields, binding: prepared.binding)
    }
    emit_binding_status(callee: expression.text, binding: prepared.binding)
    return Unit
}

fn walk_expression(program: Program, semantics: SemanticIndex, index: Int) -> Unit {
    if index < 0 || index >= List.len(list: program.expressions) { return Unit }
    let expression = List.get<Expr>(list: program.expressions, index: index)
    emit_call_binding(program: program, semantics: semantics, expressionIndex: index)
    let mut childIndex = 0
    while childIndex < List.len(list: expression.children) {
        walk_expression(
            program: program,
            semantics: semantics,
            index: List.get<Int>(list: expression.children, index: childIndex)
        )
        childIndex = childIndex + 1
    }
    return Unit
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let program = parse_program(toks: toks)
    let semanticIndex = SemanticIndex.prepare(program: program)
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION {
            let mut statementIndex = 0
            while statementIndex < List.len(list: item.statements) {
                let statement = List.get<Stmt>(list: program.statements, index: List.get<Int>(list: item.statements, index: statementIndex))
                walk_expression(program: program, semantics: semanticIndex, index: statement.expression)
                statementIndex = statementIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}
