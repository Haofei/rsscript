// Test-only outline for canonical call binding.

module selfhost.serialize.call_binding_outline

use selfhost.scan.*
use selfhost.semantics.call_binding.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

fn receiver_method_name(name: String) -> String {
    let parts = String.split(value: name, delimiter: ".")
    if List.len(list: parts) < 2 { return "" }
    return List.get<String>(list: parts, index: (List.len(list: parts) - 1))
}

fn find_function(program: Program, expression: Expr) -> Int {
    let mut index = 0
    let mut found = -1
    while index < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: index)
        if item.kind == ITEM_FUNCTION {
            if expression.calleeKind == CALLEE_NAME && item.name == expression.text { return index }
            if expression.calleeKind == CALLEE_RECEIVER && receiver_method_name(name: item.name) == expression.text {
                if found >= 0 { return -1 }
                found = index
            }
        }
        index = index + 1
    }
    return found
}

fn source_name(argument: BoundArgument) -> String {
    if argument.sourceKind == BOUND_SOURCE_RECEIVER { return "receiver" }
    if argument.sourceKind == BOUND_SOURCE_EXPLICIT {
        return String.concat(left: "arg", right: String.from_int(value: argument.sourceIndex))
    }
    if argument.sourceKind == BOUND_SOURCE_DEFAULT { return "default" }
    return "none"
}

fn emit_bound_slot(callee: String, parameter: String, argument: BoundArgument) -> Unit {
    let head = String.concat(left: String.concat(left: callee, right: "\t"), right: parameter)
    let source = String.concat(left: String.concat(left: "\t", right: source_name(argument: argument)), right: String.concat(left: "\teval=", right: String.from_int(value: argument.evaluationIndex)))
    Log.write(message: String.concat(left: head, right: source))
    return Unit
}

fn emit_binding_status(callee: String, binding: CallBinding) -> Unit {
    let mut status = "invalid"
    if CallBinding.is_complete(self: binding) { status = "complete" }
    Log.write(message: String.concat(left: String.concat(left: callee, right: "\tstatus\t"), right: status))
    return Unit
}

fn emit_field_binding(program: Program, expression: Expr) -> Bool {
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_TYPE && item.name == expression.text {
            let binding = CallBinding.bind_fields(program: program, fields: item.fields, args: expression.args)
            let mut fieldIndex = 0
            while fieldIndex < List.len(list: item.fields) {
                let field = List.get<Field>(list: item.fields, index: fieldIndex)
                let argument = List.get<BoundArgument>(list: binding.byParameter, index: fieldIndex)
                emit_bound_slot(callee: expression.text, parameter: field.name, argument: argument)
                fieldIndex = fieldIndex + 1
            }
            emit_binding_status(callee: expression.text, binding: binding)
            return true
        }
        if item.kind == ITEM_SUM {
            let mut variantIndex = 0
            while variantIndex < List.len(list: item.variants) {
                let variant = List.get<Variant>(list: item.variants, index: variantIndex)
                if variant.name == expression.text {
                    let binding = CallBinding.bind_fields(program: program, fields: variant.fields, args: expression.args)
                    let mut fieldIndex = 0
                    while fieldIndex < List.len(list: variant.fields) {
                        let field = List.get<Field>(list: variant.fields, index: fieldIndex)
                        let argument = List.get<BoundArgument>(list: binding.byParameter, index: fieldIndex)
                        emit_bound_slot(callee: expression.text, parameter: field.name, argument: argument)
                        fieldIndex = fieldIndex + 1
                    }
                    emit_binding_status(callee: expression.text, binding: binding)
                    return true
                }
                variantIndex = variantIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return false
}

fn emit_call_binding(program: Program, expression: Expr) -> Unit {
    if expression.kind != EXPR_CALL { return Unit }
    let itemIndex = find_function(program: program, expression: expression)
    if itemIndex < 0 {
        emit_field_binding(program: program, expression: expression)
        return Unit
    }
    let item = List.get<Item>(list: program.items, index: itemIndex)
    let mut receiverOffset = 0
    if expression.calleeKind == CALLEE_RECEIVER { receiverOffset = 1 }
    let binding = CallBinding.bind(program: program, params: item.params, args: expression.args, receiverOffset: receiverOffset, allowPositional: item.isPublic == false || receiverOffset == 1)
    let mut parameterIndex = 0
    while parameterIndex < List.len(list: binding.byParameter) {
        let parameter = List.get<Param>(list: item.params, index: parameterIndex)
        let argument = List.get<BoundArgument>(list: binding.byParameter, index: parameterIndex)
        emit_bound_slot(callee: expression.text, parameter: parameter.name, argument: argument)
        parameterIndex = parameterIndex + 1
    }
    emit_binding_status(callee: expression.text, binding: binding)
    return Unit
}

fn walk_expression(program: Program, index: Int) -> Unit {
    if index < 0 || index >= List.len(list: program.expressions) { return Unit }
    let expression = List.get<Expr>(list: program.expressions, index: index)
    emit_call_binding(program: program, expression: expression)
    let mut childIndex = 0
    while childIndex < List.len(list: expression.children) {
        walk_expression(program: program, index: List.get<Int>(list: expression.children, index: childIndex))
        childIndex = childIndex + 1
    }
    return Unit
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let program = parse_program(toks: toks)
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION {
            let mut statementIndex = 0
            while statementIndex < List.len(list: item.statements) {
                let statement = List.get<Stmt>(list: program.statements, index: List.get<Int>(list: item.statements, index: statementIndex))
                walk_expression(program: program, index: statement.expression)
                statementIndex = statementIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}
