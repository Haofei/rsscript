// Test-only semantic-context probe for the shared body AST.

module selfhost.serialize.type_outline

use selfhost.scan.*
use selfhost.semantics.context.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

fn statement_kind_name(kind: Int) -> String {
    if kind == STMT_RETURN { return "return" }
    if kind == STMT_LET { return "let" }
    if kind == STMT_EXPR { return "expr" }
    if kind == STMT_IF { return "if" }
    if kind == STMT_WHILE { return "while" }
    if kind == STMT_LOOP { return "loop" }
    if kind == STMT_FOR { return "for" }
    if kind == STMT_MATCH { return "match" }
    return "unknown"
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let program = parse_program(toks: toks)
    let semanticIndex = SemanticIndex.prepare(program: program)
    let mut itemIndex = 0
    while itemIndex < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: itemIndex)
        if item.kind == ITEM_FUNCTION {
            let mut context = FunctionContext.from_item(item: item, semantics: semanticIndex)
            let mut statementIndex = 0
            while statementIndex < List.len(list: item.statements) {
                let index = List.get<Int>(list: item.statements, index: statementIndex)
                let statement = List.get<Stmt>(list: program.statements, index)
                let ty = infer_statement_type(program: program, context: mut context, index: index)
                Output.write(message: String.concat(left: String.concat(left: String.concat(left: item.name, right: "\t"), right: statement_kind_name(kind: statement.kind)), right: String.concat(left: "\t", right: ty)))
                statementIndex = statementIndex + 1
            }
        }
        itemIndex = itemIndex + 1
    }
    return Unit
}
