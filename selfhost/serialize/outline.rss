// Deterministic Stage 2 serializer for the materialized top-level Program.
// This is test-only infrastructure, not a user-facing RSS command.

module selfhost.serialize.outline

use selfhost.scan.*
use selfhost.syntax.ast.*
use selfhost.syntax.parser_items.*

fn kind_name(kind: Int) -> String {
    if kind == ITEM_MODULE { return "module" }
    if kind == ITEM_USE { return "use" }
    if kind == ITEM_TYPE { return "type" }
    if kind == ITEM_SUM { return "sum" }
    if kind == ITEM_TYPE_ALIAS { return "type-alias" }
    if kind == ITEM_CONST { return "const" }
    if kind == ITEM_FUNCTION { return "function" }
    if kind == ITEM_PROTOCOL { return "protocol" }
    if kind == ITEM_IMPL { return "impl" }
    if kind == ITEM_NATIVE_MODULE { return "native-module" }
    if kind == ITEM_FEATURES { return "features" }
    if kind == ITEM_PROFILE { return "profile" }
    return "unknown"
}

fn item_line(item: read Item) -> String {
    let head = String.concat(left: read String.concat(left: read kind_name(kind: item.kind), right: read "\t"), right: read item.name)
    let pos = String.concat(left: read String.concat(left: read String.from_int(value: item.line), right: read ":"), right: read String.from_int(value: item.column))
    return String.concat(left: read String.concat(left: read head, right: read "\t"), right: read String.concat(left: read pos, right: read String.concat(left: read ":", right: read String.from_int(value: item.length))))
}

fn param_line(param: read Param) -> String {
    let mut out = String.concat(left: read "  param\t", right: read param.name)
    if String.len(value: read param.effect) > 0 { out = String.concat(left: read String.concat(left: read out, right: read "\t"), right: read param.effect) }
    return String.concat(left: read String.concat(left: read out, right: read "\t"), right: read param.typeText)
}

fn expression_kind_name(kind: Int) -> String {
    if kind == EXPR_NAME { return "name" }
    if kind == EXPR_LITERAL { return "literal" }
    if kind == EXPR_CALL { return "call" }
    if kind == EXPR_BINARY { return "binary" }
    if kind == EXPR_UNARY { return "unary" }
    return "unknown"
}

fn statement_kind_name(kind: Int) -> String {
    if kind == STMT_RETURN { return "return" }
    if kind == STMT_LET { return "let" }
    if kind == STMT_EXPR { return "expr" }
    if kind == STMT_IF { return "if" }
    if kind == STMT_WHILE { return "while" }
    if kind == STMT_LOOP { return "loop" }
    if kind == STMT_FOR { return "for" }
    if kind == STMT_MATCH { return "match" }
    return "unknown"
}

fn statement_line(program: read Program, statement: read Stmt) -> String {
    let mut expressionKind = "none"
    let mut expressionText = ""
    if statement.expression >= 0 {
        let expression = List.get<Expr>(list: read program.expressions, index: read statement.expression)
        expressionKind = expression_kind_name(kind: expression.kind)
        expressionText = expression.text
    }
    let a = String.concat(left: read String.concat(left: read "  stmt\t", right: read statement_kind_name(kind: statement.kind)), right: read String.concat(left: read "\t", right: read statement.name))
    let b = String.concat(left: read a, right: read String.concat(left: read "\t", right: read statement.typeText))
    let mut out = String.concat(left: read String.concat(left: read b, right: read String.concat(left: read "\t", right: read expressionKind)), right: read String.concat(left: read "\t", right: read expressionText))
    if List.len(list: read statement.children) > 0 || List.len(list: read statement.elseChildren) > 0 {
        out = String.concat(left: read out, right: read String.concat(left: read "\tthen=", right: read String.concat(left: read String.from_int(value: List.len(list: read statement.children)), right: read String.concat(left: read "\telse=", right: read String.from_int(value: List.len(list: read statement.elseChildren))))))
    }
    if statement.kind == STMT_MATCH {
        out = String.concat(left: read out, right: read String.concat(left: read "\tarms=", right: read String.from_int(value: List.len(list: read statement.arms))))
    }
    return out
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let program = parse_program(toks: read toks)
    let mut i = 0
    while i < Program.len(self: read program) {
        let item = List.get<Item>(list: read program.items, index: read i)
        Log.write(message: read item_line(item: read item))
        if item.kind == ITEM_FUNCTION {
            Log.write(message: read String.concat(left: read "  header\tpublic=", right: read String.concat(left: read String.from_bool(value: item.isPublic), right: read String.concat(left: read "\tasync=", right: read String.concat(left: read String.from_bool(value: item.isAsync), right: read String.concat(left: read "\tnative=", right: read String.concat(left: read String.from_bool(value: item.isNative), right: read String.concat(left: read "\tbody=", right: read String.concat(left: read String.from_bool(value: item.hasBody), right: read String.concat(left: read "\treturn=", right: read item.returnType))))))))))
            let mut g = 0
            while g < List.len(list: read item.generics) {
                let generic = List.get<GenericParam>(list: read item.generics, index: read g)
                Log.write(message: read String.concat(left: read String.concat(left: read "  generic\t", right: read generic.name), right: read String.concat(left: read "\t", right: read generic.boundText)))
                g = g + 1
            }
            let mut p = 0
            while p < List.len(list: read item.params) {
                let param = List.get<Param>(list: read item.params, index: read p)
                Log.write(message: read param_line(param: read param))
                if param.hasDefault {
                    let pos = String.concat(left: read String.concat(left: read String.from_int(value: param.defaultLine), right: read ":"), right: read String.concat(left: read String.from_int(value: param.defaultColumn), right: read String.concat(left: read ":", right: read String.from_int(value: param.defaultLength))))
                    Log.write(message: read String.concat(left: read "  default\t", right: read pos))
                }
                p = p + 1
            }
            let mut e = 0
            while e < List.len(list: read item.effects) {
                let effect = List.get<EffectName>(list: read item.effects, index: read e)
                let pos = String.concat(left: read String.concat(left: read String.from_int(value: effect.line), right: read ":"), right: read String.concat(left: read String.from_int(value: effect.column), right: read String.concat(left: read ":", right: read String.from_int(value: effect.length))))
                Log.write(message: read String.concat(left: read String.concat(left: read "  effect\t", right: read effect.name), right: read String.concat(left: read "\t", right: read pos)))
                e = e + 1
            }
            let mut s = 0
            while s < List.len(list: read item.statements) {
                let statementIndex = List.get<Int>(list: read item.statements, index: read s)
                let statement = List.get<Stmt>(list: read program.statements, index: read statementIndex)
                Log.write(message: read statement_line(program: read program, statement: read statement))
                s = s + 1
            }
        }
        i = i + 1
    }
    return Unit
}
