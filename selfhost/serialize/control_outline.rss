// Test-only AST-backed control-flow type-rule probe.

module selfhost.serialize.control_outline

use selfhost.scan.*
use selfhost.semantics.check_types.*
use selfhost.semantics.diagnostics.*
use selfhost.semantics.semantic_index.*
use selfhost.syntax.parser_items.*

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let program = parse_program(toks: toks)
    let semanticIndex = SemanticIndex.prepare(program: program)
    local diagnostics = DiagnosticBag.empty()
    collect_program_type_diagnostics(
        program: program,
        semantics: semanticIndex,
        diagnostics: mut diagnostics
    )
    let mut i = 0
    while i < List.len(list: diagnostics.items) {
        let diagnostic = List.get<Diagnostic>(list: diagnostics.items, index: i)
        if diagnostic.code == "RS0209" {
            Log.write(message: String.concat(left: String.concat(left: String.concat(left: String.concat(left: String.concat(left: diagnostic.code, right: "\t"), right: String.from_int(value: diagnostic.line)), right: "\t"), right: String.from_int(value: diagnostic.column)), right: String.concat(left: "\t", right: String.from_int(value: diagnostic.length))))
        }
        i = i + 1
    }
    return Unit
}
