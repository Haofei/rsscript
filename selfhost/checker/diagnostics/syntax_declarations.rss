                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0306 LOCAL_CLASS_BINDING: a `local` binding whose value is a class instance.
// FP-safe subset: the direct-constructor form `local [mut] NAME = ClassName(...)`
// where ClassName is a class declared in this file; indirect (fn-returned) class
// values are a safe false-negative (no corpus file needs them).
fn collect_local_class_bindings(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let mut classes = Set<String>.new()
    let mut nonClass = Set<String>.new()
    collect_type_kinds(toks, classes: mut classes, nonClasses: mut nonClass)
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if is_kw_text(toks, i, word: "local") {
            let mut q = i + 1
            if is_kw_text(toks, i: q, word: "mut") { q = q + 1 }
            if is_ident_tok(toks: toks, i: q) && at_symbol(toks: toks, i: (q + 1), code: SYM_EQ) && is_ident_tok(toks: toks, i: (q + 2)) && at_symbol(toks: toks, i: (q + 3), code: SYM_LPAREN) {
                if Set.contains<String>(set: classes, value: tk_text(toks, i: (q + 2))) {
                    hit = true
                    List.push<Int>(list: mut out, value: i)
                }
            }
        }
        i = i + 1
    }
    return hit
}

// RS0701 RESOURCE_FIELD: a non-resource type with a field whose (outer) type is a
// declared resource (oracle analyzer/resource_types.rs) — resources must be used through
// `with`, not as plain fields. FP-safe: fire only when the field type
// root is a KNOWN resource; the containing type must not itself be a resource.
fn collect_type_body_resource_fields(toks: List<Tok>, bodyOpen: Int, resources: Set<String>, out: mut List<Int>) -> Bool {
    let close = find_matching(toks: toks, open: bodyOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 { return false }
    let mut k = bodyOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            let mut u = k + 2
            let mut skipping = true
            while skipping {
                if is_kw_text(toks, i: u, word: "handle") || is_kw_text(toks, i: u, word: "weak") {
                    u = u + 1
                } else {
                    skipping = false
                }
            }
            if is_ident_tok(toks: toks, i: u) {
                if Set.contains<String>(set: resources, value: tk_text(toks, i: u)) {
                    hit = true
                    List.push<Int>(list: mut out, value: k)
                }
            }
        }
        k = k + 1
    }
    return hit
}

fn collect_resource_fields(toks: List<Tok>, resources: Set<String>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks, i)
                    let isResource = at_ident(toks: toks, i: (nameIdx - 1), wid: WORD_RESOURCE)
                    if !isResource  {
                        let ob = find_body_open(toks, i, end: r)
                        if ob >= 0 {
                            if collect_type_body_resource_fields(toks, bodyOpen: ob, resources, out: mut out) { hit = true }
                        }
                    }
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0604 FRESH_REQUIRES_LOCAL_BINDING: a `fresh`-returning call used directly with a
// `mut`/`take` data-effect (oracle checks/body/fresh.rs) — a fresh value must be bound
// to a local before `mut`/`take` use. FP-safe: fire only when the callee is a KNOWN
// fresh-returning fn declared in this file.
fn fn_returns_fresh(toks: List<Tok>, start: Int) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let de = dotted_end(toks, i: ns)
    if at_symbol(toks: toks, i: de, code: SYM_LPAREN) == false { return false }
    let close = find_matching(toks: toks, open: de, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return false }
    if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) == false { return false }
    return is_kw_text(toks, i: (close + 2), word: "fresh")
}

// Dotted names of every fn declared `-> fresh T`.
fn collect_fresh_fns(toks: List<Tok>) -> Set<String> {
    let ntok = List.len(list: toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    if fn_returns_fresh(toks, start: i) {
                        let ns = fn_name_start(toks, i)
                        Set.insert<String>(set: mut out, value: dotted_name_text(toks, i: ns))
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// RS0604 over the file: a `mut`/`take` immediately applied to a fresh-returning call.
fn collect_fresh_requires_local_sites(source: String, toks: List<Tok>, out: mut List<DiagnosticSite>) -> Bool {
    let freshFns = collect_fresh_fns(toks)
    let ntok = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < ntok {
        if is_kw_text(toks, i: k, word: "mut") || is_kw_text(toks, i: k, word: "take") {
            if is_ident_tok(toks: toks, i: (k + 1)) {
                let ce = dotted_end(toks, i: (k + 1))
                if at_symbol(toks: toks, i: ce, code: SYM_LPAREN) {
                    if Set.contains<String>(set: freshFns, value: dotted_name_text(toks, i: (k + 1))) {
                        // The HIR effect span is anchored at the effect keyword.
                        List.push<DiagnosticSite>(list: mut out, value: token_range_diagnostic_site(source, toks, start: k, endInclusive: k))
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS1002 IMPLICIT_CONVERSION_ATTEMPT: an `as` token that is not part of a `with ... as`
// binding or a `use ... as` alias — a cast-style conversion (oracle checks/forbidden.rs).
// Purely token-decidable, mirrors as_belongs_to_with / as_belongs_to_use exactly.
fn is_stmt_boundary_kw(toks: List<Tok>, k: Int) -> Bool {
    return is_kw_text(toks, i: k, word: "let") || is_kw_text(toks, i: k, word: "local") || is_kw_text(toks, i: k, word: "return") || is_kw_text(toks, i: k, word: "fn") || is_kw_text(toks, i: k, word: "class") || is_kw_text(toks, i: k, word: "struct") || is_kw_text(toks, i: k, word: "resource") || is_kw_text(toks, i: k, word: "if") || is_kw_text(toks, i: k, word: "else") || is_kw_text(toks, i: k, word: "loop") || is_kw_text(toks, i: k, word: "while") || is_kw_text(toks, i: k, word: "break") || is_kw_text(toks, i: k, word: "continue")
}

fn as_belongs_to_with(toks: List<Tok>, asIdx: Int) -> Bool {
    let mut k = asIdx - 1
    while k >= 0 {
        if is_kw_text(toks, i: k, word: "with") { return true }
        if at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || is_stmt_boundary_kw(toks, k) { return false }
        k = k - 1
    }
    return false
}

fn as_belongs_to_use(toks: List<Tok>, asIdx: Int) -> Bool {
    let mut k = asIdx - 1
    while k >= 0 {
        if is_kw_text(toks, i: k, word: "use") { return true }
        let pathTok = is_ident_tok(toks: toks, i: k) || at_symbol(toks: toks, i: k, code: SYM_DOT)
        if !pathTok  { return false }
        k = k - 1
    }
    return false
}

fn collect_implicit_conversions(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        if is_kw_text(toks, i, word: "as") {
            if as_belongs_to_with(toks, asIdx: i) == false && as_belongs_to_use(toks, asIdx: i) == false {
                hit = true
                List.push<Int>(list: mut out, value: i)
            }
        }
        i = i + 1
    }
    return hit
}

fn has_implicit_conversion(toks: List<Tok>) -> Bool {
    let mut ignored = List<Int>.new()
    return collect_implicit_conversions(toks, out: mut ignored)
}

// RS0901 TAKE_HANDLE_FIELD: `take receiver.field` where `field` is a `handle` field of
// the RECEIVER'S type (oracle checks/body/effects.rs) — handle fields are non-owning.
// FP-safe: handle fields are keyed by `Struct.field` and the receiver's type is resolved
// from its param declaration, so a same-named non-handle field on a different struct
// (the `take-inline-field-same-name` case) does not fire.
fn field_key(typeName: String, field: String) -> String {
    return String.concat(left: String.concat(left: typeName, right: "."), right: field)
}

fn collect_modifier_fields_in_body(toks: List<Tok>, bodyOpen: Int, typeName: String, modifier: String, out: mut Set<String>) -> Unit {
    let close = find_matching(toks: toks, open: bodyOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 { return Unit }
    let mut k = bodyOpen + 1
    let mut depth = 0
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            if is_kw_text(toks, i: (k + 2), word: modifier) {
                Set.insert<String>(set: mut out, value: field_key(typeName, field: tk_text(toks, i: k)))
            }
        }
        k = k + 1
    }
    return Unit
}

// `Struct.field` keys for every field carrying the type-prefix `modifier` (handle/weak).
fn collect_modifier_field_keys(toks: List<Tok>, modifier: String) -> Set<String> {
    let ntok = List.len(list: toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks, i)
                    let ob = find_body_open(toks, i, end: r)
                    if ob >= 0 {
                        collect_modifier_fields_in_body(toks, bodyOpen: ob, typeName: dotted_name_text(toks, i: nameIdx), modifier, out: mut out)
                    }
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// One fn: a `take receiver.field` where `receiver` is a single param whose type has
// `field` declared `handle`.
fn collect_fn_take_handle_tokens(toks: List<Tok>, start: Int, keys: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let popen = dotted_end(toks, i: ns)
    if at_symbol(toks: toks, i: popen, code: SYM_LPAREN) == false { return false }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return false }
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "take") && is_ident_tok(toks: toks, i: (k + 1)) {
            let de = dotted_end(toks, i: (k + 1))
            if de >= (k + 4) && (de - 3) == (k + 1) && at_symbol(toks: toks, i: (de - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (de - 1)) {
                let rtype = param_type_root(toks, open: popen, close: pclose, name: tk_text(toks, i: (k + 1)))
                if String.len(value: rtype) > 0 {
                    if Set.contains<String>(set: keys, value: field_key(typeName: rtype, field: tk_text(toks, i: (de - 1)))) {
                        List.push<Int>(list: mut out, value: k)
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0901 over the file: any fn taking a handle field of a param's type.
fn collect_take_handle_field_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let keys = collect_modifier_field_keys(toks, modifier: "handle")
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    if collect_fn_take_handle_tokens(toks, start: i, keys, out: mut out) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

fn has_take_handle_field(toks: List<Tok>) -> Bool {
    let mut ignored = List<Int>.new()
    return collect_take_handle_field_tokens(toks, out: mut ignored)
}

// RS0903 WEAK_FIELD_REQUIRES_UPGRADE: reading a `weak` field as a value (`read`/`mut`
// RECEIVER.weakfield) without `Weak.upgrade` first (oracle checks/body/async_checks.rs).
// FP-safe: receiver typed from its param decl + weak field key; `Weak.upgrade(...)`
// arguments are exempted (the callee immediately enclosing the access is Weak.upgrade).
fn enclosing_is_weak_upgrade(toks: List<Tok>, argStart: Int, bodyOpen: Int) -> Bool {
    let mut depth = 0
    let mut j = argStart - 1
    let mut found = false
    let mut result = false
    while j > bodyOpen && !found  {
        if at_symbol(toks: toks, i: j, code: SYM_RPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: j, code: SYM_LPAREN) {
            if depth == 0 {
                found = true
                if j >= 3 && is_ident_tok(toks: toks, i: (j - 1)) && at_symbol(toks: toks, i: (j - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (j - 3)) {
                    if tk_text(toks, i: (j - 3)) == "Weak" && tk_text(toks, i: (j - 1)) == "upgrade" { result = true }
                }
            } else {
                depth = depth - 1
            }
        }
        j = j - 1
    }
    return result
}

fn collect_fn_weak_field_read_tokens(toks: List<Tok>, start: Int, weakKeys: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let popen = dotted_end(toks, i: ns)
    if at_symbol(toks: toks, i: popen, code: SYM_LPAREN) == false { return false }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return false }
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "read") || is_kw_text(toks, i: k, word: "mut") {
            if is_ident_tok(toks: toks, i: (k + 1)) {
                let de = dotted_end(toks, i: (k + 1))
                if de >= (k + 4) && (de - 3) == (k + 1) && at_symbol(toks: toks, i: (de - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (de - 1)) {
                    let rtype = param_type_root(toks, open: popen, close: pclose, name: tk_text(toks, i: (k + 1)))
                    if String.len(value: rtype) > 0 {
                        if Set.contains<String>(set: weakKeys, value: field_key(typeName: rtype, field: tk_text(toks, i: (de - 1)))) {
                            if enclosing_is_weak_upgrade(toks, argStart: k, bodyOpen: sigEnd) == false {
                                List.push<Int>(list: mut out, value: (k + 1))
                                hit = true
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

fn collect_weak_field_read_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let weakKeys = collect_modifier_field_keys(toks, modifier: "weak")
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    if collect_fn_weak_field_read_tokens(toks, start: i, weakKeys, out: mut out) { hit = true }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0904 WEAK_FIELD_REQUIRES_WEAK_HANDLE: a constructor initializing a `weak` field
// with anything other than a syntactic `Weak.from(...)`/`Weak.downgrade(...)` (oracle
// checks/body/fresh.rs::is_weak_handle_producing_expr). FP-safe: gated by the weak
// field key `Type.field`, so only a real weak-field initializer is examined.
fn value_is_weak_producing(toks: List<Tok>, v: Int) -> Bool {
    if is_ident_tok(toks: toks, i: v) == false { return false }
    if tk_text(toks, i: v) != "Weak" { return false }
    if at_symbol(toks: toks, i: (v + 1), code: SYM_DOT) == false { return false }
    let m = tk_text(toks, i: (v + 2))
    return m == "from" || m == "downgrade"
}

// One simple-name call [open,close]: a named arg for a `weak` field of `callee` whose
// value is not weak-producing.
fn collect_call_weak_field_bad_tokens(toks: List<Tok>, callee: String, open: Int, close: Int, weakKeys: Set<String>, out: mut List<Int>) -> Bool {
    let mut depth = 0
    let mut atArgStart = true
    let mut k = open + 1
    let mut hit = false
    while k < close {
        if depth == 0 && atArgStart && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            if Set.contains<String>(set: weakKeys, value: field_key(typeName: callee, field: tk_text(toks, i: k))) {
                if value_is_weak_producing(toks, v: (k + 2)) == false {
                    List.push<Int>(list: mut out, value: (k + 2))
                    hit = true
                }
            }
        }
        atArgStart = false
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            atArgStart = true
        }
        k = k + 1
    }
    return hit
}

// RS0904 over the file: any constructor call with a bad weak-field initializer.
fn collect_weak_field_bad_init_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let weakKeys = collect_modifier_field_keys(toks, modifier: "weak")
    let ntok = List.len(list: toks)
    let mut k = 1
    let mut hit = false
    while k < ntok {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (k - 1)) && at_symbol(toks: toks, i: (k - 2), code: SYM_DOT) == false {
            let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close >= 0 {
                if collect_call_weak_field_bad_tokens(toks, callee: tk_text(toks, i: (k - 1)), open: k, close, weakKeys, out: mut out) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0101 FEATURE_VIOLATION (feature-gating).
//
// A feature-requiring construct is used but the file header does not declare the
// required `features:`. FILE-LEVEL: emit "RS0101" once if ANY unfeatured use
// exists (the checker compares a code SET, so only presence matters). Three
// oracle sources are reproduced:
//   * checks/features.rs feature_uses — construct -> required feature:
//       local  : `local` let/closure, `manage` expr, `take` data-effect
//       native : a fn with `effects(native)`
//       unsafe : a fn with `effects(unsafe)`
//       async  : `async fn`/`async let`/`async for`, `spawn`, `await`,
//                `task_group`, `select`
//   * analyzer/signatures.rs check_native_effect — a `native fn` that does NOT
//     surface `effects(native)` is RS0101 REGARDLESS of the declared features.
//   * checks/body/semantics.rs check_match_pattern_effects — `match take`
//     without `features: local` (subsumed by the `take` keyword probe).
//
// A reserved feature keyword (`local`/`async`/`unsafe`) only appears in a
// `features:` header when that feature is DECLARED, so a header token always
// self-gates; the only other occurrences are real uses. `native` is the sole
// exception (the missing-effect source fires even when declared), so it is
// tracked separately in the fn walk.
// ---------------------------------------------------------------------------

// The `local`/`native`/`unsafe`/`async` features this file declares, collected
// from every top-level `features:` header (order-independent pre-pass).
fn collect_declared_features(toks: List<Tok>) -> Set<String> {
    let mut declared = Set<String>.new()
    let n = List.len(list: toks)
    let mut i = 0
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_FEATURES) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            let lineEnd = declaration_line_end(toks: toks, start: i)
            let mut j = i + 2
            while j < lineEnd {
                if is_ident_tok(toks: toks, i: j) {
                    let fname = tk_text(toks, i: j)
                    if is_known_feature(name: fname) {
                        Set.insert<String>(set: mut declared, value: fname)
                    }
                }
                j = j + 1
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return declared
}

// True if the ident/keyword token at i is `word` and is not a method name (not
// preceded by `.`).
fn kw_not_dotted(toks: List<Tok>, i: Int, word: String) -> Bool {
    if is_kw_text(toks, i, word) == false { return false }
    return at_symbol(toks: toks, i: (i - 1), code: SYM_DOT) == false
}

// A `local`-feature construct anywhere in the file: a `local` let/closure, a
// `manage` expr, or a `take` data-effect. The
// `take` effect is distinguished from a `.take(` method (preceded by `.`) and a
// binding/field named `take` (followed by `:`).
fn file_local_use(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_LOCAL) {
            hit = true
        } else if kw_not_dotted(toks, i, word: "manage") {
            hit = true
        } else if kw_not_dotted(toks, i, word: "take") && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) == false {
            hit = true
        }
        i = i + 1
    }
    return hit
}

// Record body/type feature uses at the same token spans used by HIR lowering.
// Declaration-level async/native/unsafe uses are added by the top-level fn walk,
// because their span is the declaration start rather than the effect keyword.
fn collect_feature_use_tokens(
    toks: List<Tok>,
    declared: Set<String>,
    asyncFns: Set<String>,
    unsafeFns: Set<String>,
    out: mut List<Int>
) -> Bool {
    let needLocal = Set.contains<String>(set: declared, value: "local") == false
    let needAsync = Set.contains<String>(set: declared, value: "async") == false
    let needUnsafe = Set.contains<String>(set: declared, value: "unsafe") == false
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_FEATURES) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            i = declaration_line_end(toks: toks, start: i)
        } else {
            if needLocal {
                if at_ident(toks: toks, i: i, wid: WORD_LOCAL) || kw_not_dotted(toks, i, word: "manage") {
                    List.push<Int>(list: mut out, value: i)
                    hit = true
                } else if kw_not_dotted(toks, i, word: "take") && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) == false {
                    let mut site = i
                    if at_symbol(toks: toks, i: (i - 1), code: SYM_COLON) && is_ident_tok(toks: toks, i: (i - 2)) { site = i - 2 }
                    List.push<Int>(list: mut out, value: site)
                    hit = true
                }
            }
            if needAsync {
                let asyncStmt = at_ident(toks: toks, i: i, wid: WORD_ASYNC) && (at_ident(toks: toks, i: (i + 1), wid: WORD_FOR) || is_kw_text(toks, i: (i + 1), word: "let"))
                if asyncStmt || kw_not_dotted(toks, i, word: "spawn") || kw_not_dotted(toks, i, word: "await") || kw_not_dotted(toks, i, word: "task_group") || kw_not_dotted(toks, i, word: "select") {
                    List.push<Int>(list: mut out, value: i)
                    hit = true
                }
            }
            if is_ident_tok(toks: toks, i: i) && at_ident(toks: toks, i: (i - 1), wid: WORD_FN) == false && at_symbol(toks: toks, i: (i - 1), code: SYM_DOT) == false {
                let afterName = dotted_end(toks, i)
                let mut callOpen = afterName
                if at_symbol(toks: toks, i: afterName, code: SYM_LANGLE) {
                    let genericClose = find_matching(toks: toks, open: afterName, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
                    if genericClose >= 0 { callOpen = genericClose + 1 }
                }
                if at_symbol(toks: toks, i: callOpen, code: SYM_LPAREN) {
                    let name = dotted_name_text(toks, i)
                    if needAsync && Set.contains<String>(set: asyncFns, value: name) {
                        List.push<Int>(list: mut out, value: i)
                        hit = true
                    }
                    if needUnsafe && Set.contains<String>(set: unsafeFns, value: name) {
                        List.push<Int>(list: mut out, value: i)
                        hit = true
                    }
                }
            }
            i = i + 1
        }
    }
    return hit
}

// An `async`-feature construct anywhere: `async` (fn/let/for) modifier keyword,
// or a `spawn`/`await`/`task_group`/`select` prefix/statement keyword.
fn file_async_use(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        // The `async` MODIFIER (`async fn`/`async let`/`async for`) is a feature
        // use; the `async` EFFECT NAME in `effects(..., async, ...)` is a removed
        // runtime effect (RS0012), NOT an async construct, so gate on the next kw.
        if at_ident(toks: toks, i: i, wid: WORD_ASYNC) && (at_ident(toks: toks, i: (i + 1), wid: WORD_FN) || at_ident(toks: toks, i: (i + 1), wid: WORD_FOR) || is_kw_text(toks, i: (i + 1), word: "let")) {
            hit = true
        } else if kw_not_dotted(toks, i, word: "spawn") {
            hit = true
        } else if kw_not_dotted(toks, i, word: "await") {
            hit = true
        } else if kw_not_dotted(toks, i, word: "task_group") {
            hit = true
        } else if kw_not_dotted(toks, i, word: "select") {
            hit = true
        }
        i = i + 1
    }
    return hit
}

// An `unsafe`-feature construct anywhere: an `effects(unsafe)` clause. `unsafe`
// is only ever an effect name or a `features: unsafe` header token (the latter
// implies the feature is declared, so it self-gates), so a bare WORD_UNSAFE
// token is a faithful proxy.
fn file_unsafe_use(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_UNSAFE) { hit = true }
        i = i + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0015 UNSUPPORTED_SYNTAX.
//
// This is deliberately a conservative recognizer for the fail-corpus shapes the
// Rust frontend reports as RS0015. It is not a generic parser fallback: the
// self-host checker keeps scanning after malformed items, so broad "parse failed"
// rules would risk false positives on constructs this lightweight parser skips.
// ---------------------------------------------------------------------------

fn rs0015_literal_token(toks: List<Tok>, i: Int) -> Bool {
    let k = tk_kind(toks: toks, i: i)
    if k == TOK_STRING || k == TOK_MULTILINE || k == TOK_INTERP || k == TOK_NUMBER || k == TOK_CHAR { return true }
    if is_ident_tok(toks: toks, i: i) {
        let t = tk_text(toks, i)
        return t == "true" || t == "false" || t == "Unit" || t == "None" || t == "null"
    }
    return false
}

fn rs0015_has_unmatched_delimiter(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) {
            if find_matching(toks: toks, open: i, openSym: SYM_LPAREN, closeSym: SYM_RPAREN) < 0 { hit = true }
        } else if at_symbol(toks: toks, i: i, code: SYM_LBRACE) {
            if find_matching(toks: toks, open: i, openSym: SYM_LBRACE, closeSym: SYM_RBRACE) < 0 { hit = true }
        } else if at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            if find_matching(toks: toks, open: i, openSym: SYM_LBRACKET, closeSym: SYM_RBRACKET) < 0 { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_supported_derive(name: String) -> Bool {
    return name == "Clone" || name == "Eq" || name == "Ord" || name == "Hash" || name == "JsonEncode" || name == "JsonDecode" || name == "Schema" || name == "ReviewSchema"
}

fn rs0015_has_bad_derive_name(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_DERIVES) && at_symbol(toks: toks, i: (i + 1), code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: (i + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close > 0 {
                let mut j = i + 2
                while j < close {
                    if is_ident_tok(toks: toks, i: j) {
                        if rs0015_supported_derive(name: tk_text(toks, i: j)) == false { hit = true }
                    }
                    j = j + 1
                }
            }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_duplicate_use_name(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut seen = Set<String>.new()
    let mut hit = false
    let mut i = 0
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_USE) {
            let lineEnd = declaration_line_end(toks: toks, start: i)
            let mut alias = ""
            let mut last = ""
            let mut j = i + 1
            while j < lineEnd {
                if at_ident(toks: toks, i: j, wid: WORD_AS) && is_ident_tok(toks: toks, i: (j + 1)) {
                    alias = tk_text(toks, i: (j + 1))
                } else if is_ident_tok(toks: toks, i: j) {
                    last = tk_text(toks, i: j)
                }
                j = j + 1
            }
            let mut localName = last
            if String.len(value: alias) > 0 { localName = alias }
            if String.len(value: localName) > 0 {
                if Set.contains<String>(set: seen, value: localName) { hit = true }
                Set.insert<String>(set: mut seen, value: localName)
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_reserved_or_unknown_top(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_ident_tok(toks: toks, i: i) {
            let t = tk_text(toks, i)
            if t == "namespace" || t == "enum" { hit = true }
            if t == "spawn" { hit = true }
            if String.starts_with(value: t, prefix: "__rss_") || String.starts_with(value: t, prefix: "__rsscript_") { hit = true }
            if t == "own" && at_ident(toks: toks, i: (i + 1), wid: WORD_STRUCT) { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_bad_type_surface(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_OPAQUE) && starts_type_decl(toks: toks, i: i, isPub: false) {
            let r = parse_type_decl(toks: toks, i: i)
            if r > i {
                let ob = find_body_open(toks, i, end: r)
                if ob >= 0 { hit = true }
                i = r
            } else {
                hit = true
                i = i + 1
            }
        } else if (at_ident(toks: toks, i: i, wid: WORD_STRUCT) || at_ident(toks: toks, i: i, wid: WORD_CLASS) || at_ident(toks: toks, i: i, wid: WORD_RESOURCE)) && at_symbol(toks: toks, i: (i + 1), code: SYM_LBRACE) {
            hit = true
            i = i + 1
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_malformed_field(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if starts_type_decl(toks: toks, i: i, isPub: at_ident(toks: toks, i: i, wid: WORD_PUB)) {
            let r = parse_type_decl(toks: toks, i: i)
            if r > i {
                let ob = find_body_open(toks, i, end: r)
                if ob >= 0 {
                    let close = find_matching(toks: toks, open: ob, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    let mut j = ob + 1
                    while j < close {
                        if is_kw_text(toks, i: j, word: "drop") && at_symbol(toks: toks, i: (j + 1), code: SYM_LBRACE) {
                            let dc = find_matching(toks: toks, open: (j + 1), openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                            if dc > j { j = dc + 1 } else { j = j + 1 }
                        } else if is_ident_tok(toks: toks, i: j) {
                            let lineEnd = declaration_line_end(toks: toks, start: j)
                            if lineEnd <= close {
                                let colon = find_top_sym(toks, start: j, end: lineEnd, code: SYM_COLON)
                                if colon < 0 || colon == (lineEnd - 1) { hit = true }
                                j = lineEnd
                            } else {
                                j = j + 1
                            }
                        } else {
                            j = j + 1
                        }
                    }
                }
                i = r
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_generic_params(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) && rs0015_is_generic_open(toks, i) {
            let close = find_matching(toks: toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
            if close > i {
                let mut j = i + 1
                while j < close {
                    if is_effect_kw(toks, i: j) { hit = true }
                    if at_symbol(toks: toks, i: j, code: SYM_COMMA) {
                        if at_symbol(toks: toks, i: (j + 1), code: SYM_COMMA) || at_symbol(toks: toks, i: (j + 1), code: SYM_RANGLE) { hit = true }
                    }
                    j = j + 1
                }
                if at_symbol(toks: toks, i: (i + 1), code: SYM_COMMA) { hit = true }
                i = close + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

// `<` also introduces ordinary comparisons. Only inspect generic lists in a
// declaration (`fn name<...>`) or after a nominal-type-shaped name. Scanning
// every `<` lets `i < limit` consume a later type argument's `>` and creates
// false RS0015 reports in otherwise valid loop-heavy programs.
fn rs0015_is_generic_open(toks: List<Tok>, i: Int) -> Bool {
    if i <= 0 || is_ident_tok(toks: toks, i: (i - 1)) == false { return false }
    let previous = tk_text(toks, i: (i - 1))
    if is_upper_head(name: previous) { return true }
    return at_ident(toks: toks, i: (i - 2), wid: WORD_FN)
}

fn rs0015_has_unknown_token(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if tk_kind(toks: toks, i: i) == TOK_UNKNOWN { hit = true }
        i = i + 1
    }
    return hit
}

// The lexer intentionally preserves an unterminated string as a String token
// so token parity stays faithful. Syntax parity still needs to reject it. Scan
// the original source with the same shared literal scanners to retain that bit
// of information without changing the token ABI.
fn rs0015_has_unterminated_string(source: String) -> Bool {
    let chars = String.chars(value: source)
    let n = List.len(list: chars)
    let mut i = 0
    let mut hit = false
    while i < n {
        let c = List.get(list: chars, index: i)
        let c1 = code_at(chars: chars, n: n, i: (i + 1))
        let c2 = code_at(chars: chars, n: n, i: (i + 2))
        if c == '/' && c1 == 47 {
            i = scan_line_comment(chars: chars, n: n, i: i)
        } else if c == '"' && c1 == 34 && c2 == 34 {
            let close = scan_multiline(chars: chars, n: n, i: i)
            if code_at(chars: chars, n: n, i: close) != 34 || code_at(chars: chars, n: n, i: (close + 1)) != 34 || code_at(chars: chars, n: n, i: (close + 2)) != 34 {
                hit = true
                i = n
            } else {
                i = close + 3
            }
        } else if c == '$' && c1 == 34 {
            let close = scan_interp(chars: chars, n: n, i: i)
            if code_at(chars: chars, n: n, i: close) != 34 {
                hit = true
                i = n
            } else {
                i = close + 1
            }
        } else if c == '"' {
            let close = scan_string(chars: chars, n: n, i: i)
            if code_at(chars: chars, n: n, i: close) != 34 {
                hit = true
                i = n
            } else {
                i = close + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

// `async let` is legal only within a task_group body. This small containment
// probe is intentionally limited to the outer placement rule; the checker does
// not claim to reproduce task-group consumption/nesting diagnostics yet.
fn rs0015_has_async_let_outside_task_group(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_ASYNC) && is_kw_text(toks, i: (i + 1), word: "let") {
            let mut inside = false
            let mut j = 0
            while j < i {
                if is_kw_text(toks, i: j, word: "task_group") && at_symbol(toks: toks, i: (j + 1), code: SYM_LBRACE) {
                    let close = find_matching(toks: toks, open: (j + 1), openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    if close > i { inside = true }
                }
                j = j + 1
            }
            if !inside  { hit = true }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_call_has_empty_arg(toks: List<Tok>, open: Int, close: Int) -> Bool {
    if at_symbol(toks: toks, i: (open + 1), code: SYM_COMMA) { return true }
    let mut k = open + 1
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_COMMA) && at_symbol(toks: toks, i: (k + 1), code: SYM_COMMA) { return true }
        if at_symbol(toks: toks, i: k, code: SYM_COLON) {
            if at_symbol(toks: toks, i: (k + 1), code: SYM_COMMA) || (k + 1) == close { return true }
        }
        k = k + 1
    }
    return false
}

fn rs0015_has_bad_call_forms(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 1
    let mut hit = false
    while i < n {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (i - 1)) {
            let name = tk_text(toks, i: (i - 1))
            let close = find_matching(toks: toks, open: i, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close > i {
                if name == "None" || name == "Option" || name == "Result" { hit = true }
                if (name == "Some" || name == "Ok" || name == "Err") && find_top_sym(toks, start: (i + 1), end: close, code: SYM_COLON) >= 0 { hit = true }
                if rs0015_call_has_empty_arg(toks, open: i, close) { hit = true }
                if close + 1 < n && name != "fn" && tk_line(toks: toks, i: (close + 1)) == tk_line(toks: toks, i: close) && is_ident_tok(toks: toks, i: (close + 1)) {
                    let next = tk_text(toks, i: (close + 1))
                    if next != "as" && next != "else" && next != "captures" && next != "effects" { hit = true }
                }
                i = close + 1
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_const_nonliteral(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_CONST) {
            let lineEnd = declaration_line_end(toks: toks, start: i)
            let mut eq = i
            while eq < lineEnd && at_symbol(toks: toks, i: eq, code: SYM_EQ) == false { eq = eq + 1 }
            if eq < lineEnd {
                let rhs = eq + 1
                if rhs >= lineEnd {
                    hit = true
                } else if (rhs + 1) != lineEnd {
                    hit = true
                } else if rs0015_literal_token(toks, i: rhs) == false {
                    hit = true
                }
            }
            i = lineEnd
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_control_or_binding(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_kw_text(toks, i, word: "else") {
            if at_symbol(toks: toks, i: (i + 1), code: SYM_LBRACE) == false && is_kw_text(toks, i: (i + 1), word: "if") == false { hit = true }
        } else if is_kw_text(toks, i, word: "loop") {
            if at_symbol(toks: toks, i: (i + 1), code: SYM_LBRACE) == false { hit = true }
        } else if is_kw_text(toks, i, word: "while") {
            if at_symbol(toks: toks, i: (i + 1), code: SYM_LBRACE) { hit = true }
        } else if is_kw_text(toks, i, word: "match") {
            if at_symbol(toks: toks, i: (i + 1), code: SYM_LBRACE) { hit = true }
        } else if is_kw_text(toks, i, word: "let") || is_kw_text(toks, i, word: "local") {
            let lineEnd = declaration_line_end(toks: toks, start: i)
            let mut eq = i
            while eq < lineEnd && at_symbol(toks: toks, i: eq, code: SYM_EQ) == false { eq = eq + 1 }
            if eq < lineEnd && (eq + 1) >= lineEnd { hit = true }
            i = lineEnd - 1
        } else if is_kw_text(toks, i, word: "with") {
            let mut bodyOpen = i + 1
            while bodyOpen < n && at_symbol(toks: toks, i: bodyOpen, code: SYM_LBRACE) == false { bodyOpen = bodyOpen + 1 }
            let mut hasAs = false
            let mut asHasBinding = false
            let mut j = i + 1
            while j < bodyOpen {
                if at_ident(toks: toks, i: j, wid: WORD_AS) {
                    hasAs = true
                    if is_ident_tok(toks: toks, i: (j + 1)) { asHasBinding = true }
                }
                j = j + 1
            }
            if !hasAs  || !asHasBinding  { hit = true }
        } else if is_kw_text(toks, i, word: "spawn") {
            hit = true
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_bad_param_decl(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        let cls = classify_top(toks: toks, i: i)
        if starts_fn_like(toks: toks, i: i, isPub: cls.isPub) {
            let ns = fn_name_start(toks, i)
            let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
            let open = find_param_open(toks, from: ns, end: sigEnd)
            if open >= 0 {
                let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                if close > open {
                    let mut seg = open + 1
                    let mut j = open + 1
                    while j <= close {
                        if j == close || at_symbol(toks: toks, i: j, code: SYM_COMMA) {
                            if seg < j {
                                let colon = find_top_sym(toks, start: seg, end: j, code: SYM_COLON)
                                if colon < 0 && is_effect_kw(toks, i: seg) { hit = true }
                            }
                            seg = j + 1
                        }
                        j = j + 1
                    }
                    i = close + 1
                } else {
                    i = i + 1
                }
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_bad_match_arm(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if is_kw_text(toks, i, word: "match") && at_symbol(toks: toks, i: (i - 1), code: SYM_DOT) == false {
            let mut ob = i + 1
            let mut paren = 0
            let mut bracket = 0
            let mut foundArmBlock = false
            while ob < n && !foundArmBlock  {
                if at_symbol(toks: toks, i: ob, code: SYM_LPAREN) {
                    paren = paren + 1
                } else if at_symbol(toks: toks, i: ob, code: SYM_RPAREN) {
                    if paren > 0 { paren = paren - 1 }
                } else if at_symbol(toks: toks, i: ob, code: SYM_LBRACKET) {
                    bracket = bracket + 1
                } else if at_symbol(toks: toks, i: ob, code: SYM_RBRACKET) {
                    if bracket > 0 { bracket = bracket - 1 }
                } else if paren == 0 && bracket == 0 && at_symbol(toks: toks, i: ob, code: SYM_LBRACE) {
                    foundArmBlock = true
                }
                if !foundArmBlock  { ob = ob + 1 }
            }
            if foundArmBlock {
                let close = find_matching(toks: toks, open: ob, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if close > ob {
                    let mut j = ob + 1
                    let mut depth = 0
                    while j < close {
                        if at_symbol(toks: toks, i: j, code: SYM_LBRACE) {
                            depth = depth + 1
                        } else if at_symbol(toks: toks, i: j, code: SYM_RBRACE) {
                            if depth > 0 { depth = depth - 1 }
                        } else if depth == 0 && tk_line(toks: toks, i: j) != tk_line(toks: toks, i: (j - 1)) {
                            let lineEnd = declaration_line_end(toks: toks, start: j)
                            if j < close && lineEnd <= close {
                                let arrow = find_top_sym(toks, start: j, end: lineEnd, code: SYM_FATARROW)
                                if arrow < 0 && is_ident_tok(toks: toks, i: j) { hit = true }
                            }
                        }
                        j = j + 1
                    }
                    i = close
                }
            }
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_native_body(program: Program) -> Bool {
    let mut i = 0
    while i < Program.len(self: program) {
        let item = List.get<Item>(list: program.items, index: i)
        if item.kind == ITEM_FUNCTION && item.isNative && item.hasBody { return true }
        i = i + 1
    }
    return false
}

fn rs0015_has_protocol_default_body(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
            let r = parse_protocol_decl(toks: toks, i: i)
            if r > i {
                let ob = find_body_open(toks, i, end: r)
                let close = find_matching(toks: toks, open: ob, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                let mut j = ob + 1
                while j < close {
                    if at_ident(toks: toks, i: j, wid: WORD_FN) {
                        let sigEnd = function_signature_end(toks: toks, start: j)
                        if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) { hit = true }
                    }
                    j = j + 1
                }
                i = r
            } else {
                i = i + 1
            }
        } else {
            i = i + 1
        }
    }
    return hit
}

fn rs0015_has_profile_decl(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    let mut depth = 0
    while i < n {
        if at_symbol(toks: toks, i: i, code: SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0
            && at_ident(toks: toks, i: i, wid: WORD_PROFILE)
            && tk_line(toks: toks, i: i) != tk_line(toks: toks, i: (i - 1))
            && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            hit = true
        }
        i = i + 1
    }
    return hit
}

fn rs0015_has_malformed_fn_decl(toks: List<Tok>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if at_ident(toks: toks, i: i, wid: WORD_FN) && tk_line(toks: toks, i: i) != tk_line(toks: toks, i: (i - 1)) {
            if is_ident_tok(toks: toks, i: (i + 1)) == false {
                hit = true
            }
        }
        i = i + 1
    }
    return hit
}

fn has_unsupported_syntax_rs0015(source: String, toks: List<Tok>, program: Program) -> Bool {
    return rs0015_has_unmatched_delimiter(toks)
        || rs0015_has_unknown_token(toks)
        || rs0015_has_unterminated_string(source)
        || rs0015_has_bad_derive_name(toks)
        || rs0015_has_duplicate_use_name(toks)
        || rs0015_has_reserved_or_unknown_top(toks)
        || rs0015_has_bad_type_surface(toks)
        || rs0015_has_malformed_field(toks)
        || rs0015_has_bad_generic_params(toks)
        || rs0015_has_bad_call_forms(toks)
        || rs0015_has_const_nonliteral(toks)
        || rs0015_has_bad_control_or_binding(toks)
        || rs0015_has_bad_param_decl(toks)
        || rs0015_has_bad_match_arm(toks)
        || rs0015_has_native_body(program)
        || rs0015_has_protocol_default_body(toks)
        || rs0015_has_malformed_fn_decl(toks)
        || rs0015_has_async_let_outside_task_group(toks)
        || has_implicit_conversion(toks)
        || rs0015_has_profile_decl(toks)
}

// ---------------------------------------------------------------------------
// Type-inference engine — slice 1: conservative expression type-of + RS0013.
//
// `expr_type_root` computes the type ROOT of an expression region, but ONLY for
// the forms whose type the oracle (crate::hir::infer + checks/shared) computes
// with certainty; everything else (Binary / Index / Field / qualified & receiver
// calls / object / array / closure) returns "" (UNKNOWN). Returning unknown =>
// no diagnostic => no false positive; that conservatism is the safety mechanism
// and the reason this foundation is reused by the later slices (RS0210 operator,
// RS0207 argument, RS0208 return). See crate::checks::shared::builtin_value_type_name,
// crate::hir::number_literal_type_name, and checks/body/try_checks.rs.
//
// RS0013 is in CHECKER_TARGET_CODES: all three oracle sub-rules are reproduced —
// (A) `?` in a function whose return type is not Result/Option, (B) a `?` whose
// operand has a confidently-known concrete non-Result/Option type, and (C) inside
// a fn returning `Result<T, E>`, a `?` whose operand Result error type is known
// and differs from E. Sub-rule C reads the operand error type from a small stdlib
// namespace->error-type map (filesystem->FileError, json/toml/yaml->JsonError) or,
// for an unqualified same-file call, from that fn's declared error type; anything
