fn is_effect_kw(toks: List<Tok>, i: Int) -> Bool {
    let t = tk_text(toks, i)
    return t == "read" || t == "mut" || t == "take"
}

// First top-level `(` (param-list open) at/after `from`, skipping a generic
// `<…>` clause (whose bounds may themselves contain `Fn(…)` parens).
fn find_param_open(toks: List<Tok>, from: Int, end: Int) -> Int {
    let mut k = from
    let mut angle = 0
    let mut r = -1
    while k < end && r < 0 {
        if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if angle == 0 && at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            r = k
        }
        k = k + 1
    }
    return r
}

// Valid v0.6 effect names for an `effects(...)` clause (check_function_effects).
fn is_valid_effect_name(name: String) -> Bool {
    return name == "no_panic" || name == "noalloc" || name == "no_block" || name == "pure" || name == "unsafe" || name == "native" || name == "parallel"
}

// Removed runtime effects → RS0012 (removed_runtime_effect_replacement set).
fn is_removed_runtime_effect(name: String) -> Bool {
    return name == "io" || name == "allocates" || name == "may_panic" || name == "may_fail" || name == "async" || name == "suspends"
}

// Index of the `(` of a top-level `effects(...)` clause in a function signature,
// or -1. The clause sits after the param list, before the body.
fn find_effects_open(toks: List<Tok>, start: Int) -> Int {
    let ns = fn_name_start(toks, i: start)
    // Signature scan must begin at the `fn` keyword (ns - 1), not the decl start:
    // when the decl is attribute-led (`#deprecated(...) fn …`), starting at `#`
    // makes function_signature_end stop at the later `fn` (a top-level-item start).
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let open = find_param_open(toks, from: ns, end: sigEnd)
    if open < 0 { return -1 }
    let pclose = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return -1 }
    let mut k = pclose + 1
    let mut depth = 0
    let mut r = -1
    while k < sigEnd && r < 0 {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && tk_text(toks, i: k) == "effects" && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) {
            r = k + 1
        }
        k = k + 1
    }
    return r
}

// Classify one effects-clause item [segStart,segEnd) exactly like parse_effects:
//   1 = a valid bare `Name` (single-token effect name)
//   2 = a valid `retains(ident)` item
//   0 = malformed (empty, non-ident, `name(args)`, bad retains) → skipped, no check
fn effect_item_kind(toks: List<Tok>, segStart: Int, segEnd: Int) -> Int {
    if segStart >= segEnd { return 0 }
    if is_ident_tok(toks: toks, i: segStart) == false { return 0 }
    let name = tk_text(toks, i: segStart)
    if name == "retains" {
        if at_symbol(toks: toks, i: (segStart + 1), code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: (segStart + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close >= 0 && (close + 1) == segEnd && (segStart + 3) == close && is_ident_tok(toks: toks, i: (segStart + 2)) {
                return 2
            }
        }
        return 0
    }
    if (segStart + 1) == segEnd { return 1 }
    return 0
}

// Walk a function's `effects(...)` items (only the VALID ones — malformed items
// recover to RS0015 and are skipped). `mode`: 0 = RS0004 (unknown effect: `fresh`
// or an unrecognized name), 1 = RS0012 (removed runtime effect).
fn effects_name_probe(toks: List<Tok>, start: Int, mode: Int) -> Bool {
    let mut ignored = List<Int>.new()
    return collect_effect_name_tokens(toks, start, mode, out: mut ignored)
}

fn collect_effect_name_tokens(toks: List<Tok>, start: Int, mode: Int, out: mut List<Int>) -> Bool {
    let effOpen = find_effects_open(toks, start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: toks, open: effOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if effect_name_hits(toks, segStart, segEnd: k, mode) {
                hit = true
                List.push<Int>(list: mut out, value: start)
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_name_hits(toks, segStart, segEnd: effClose, mode) {
        hit = true
        List.push<Int>(list: mut out, value: start)
    }
    return hit
}

// Does a single VALID bare-name item trigger `mode`? (retains/malformed items
// never trigger RS0004/RS0012.)
fn effect_name_hits(toks: List<Tok>, segStart: Int, segEnd: Int, mode: Int) -> Bool {
    if effect_item_kind(toks, segStart, segEnd) != 1 { return false }
    let name = tk_text(toks, i: segStart)
    if mode == 1 { return is_removed_runtime_effect(name) }
    // mode 2: RS0101 — the `native` effect (a `native fn` boundary, or any fn with
    // `effects(native)`). Used to gate the `native` file feature.
    if mode == 2 { return name == "native" }
    if name == "fresh" { return true }
    if is_removed_runtime_effect(name) { return false }
    return is_valid_effect_name(name) == false
}

// RS0033: a decimal integer literal that does not fit i64 (check_integer_literal_
// range: all-ASCII-digit text whose value overflows). Non-decimal / float literals
// (containing `.`, `e`, `x`, …) are left alone — their text isn't all digits.
fn is_int_out_of_range(text: String) -> Bool {
    let cs = String.chars(value: text)
    let n = List.len(list: cs)
    if n == 0 { return false }
    let mut allDigit = true
    let mut i = 0
    while i < n {
        let code = Char.to_code(value: List.get(list: cs, index: i))
        if code < 48 || code > 57 { allDigit = false }
        i = i + 1
    }
    if !allDigit  { return false }
    // Strip leading zeros (Rust's i64 parse accepts them: `007` → 7).
    let mut start = 0
    while start < (n - 1) && Char.to_code(value: List.get(list: cs, index: start)) == 48 {
        start = start + 1
    }
    let digits = n - start
    if digits > 19 { return true }
    if digits < 19 { return false }
    // Exactly 19 significant digits: compare against i64::MAX digit-by-digit.
    let ms = String.chars(value: "9223372036854775807")
    let mut j = 0
    let mut result = false
    let mut decided = false
    while j < 19 && !decided  {
        let a = Char.to_code(value: List.get(list: cs, index: (start + j)))
        let b = Char.to_code(value: List.get(list: ms, index: j))
        if a > b {
            result = true
            decided = true
        } else if a < b {
            decided = true
        }
        j = j + 1
    }
    return result
}

// Whole-file scan: any decimal integer literal token out of i64 range → RS0033.
fn collect_out_of_range_int_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        if tk_kind(toks: toks, i: i) == TOK_NUMBER {
            if is_int_out_of_range(text: tk_text(toks, i)) {
                hit = true
                List.push<Int>(list: mut out, value: i)
            }
        }
        i = i + 1
    }
    return hit
}

// RS0212: a value derive on a `resource` type. Resources are move-only RAII values
// that support only `Debug`/`Schema`/`ReviewSchema`; `Clone`/`Eq`/`Ord`/`Hash`/
// `JsonEncode`/`JsonDecode` would copy or compare the resource (analyzer/derives.rs
// check_resource_derives). Decidable from declaration structure alone.
fn is_banned_resource_derive(name: String) -> Bool {
    return name == "Clone" || name == "Eq" || name == "Ord" || name == "Hash" || name == "JsonEncode" || name == "JsonDecode"
}

// Scan a resource decl's header [nameIdx, declEnd) for a `derives(...)` clause and
// report a banned value derive. The body `{` terminates the header.
fn collect_bad_resource_derive_tokens(toks: List<Tok>, nameIdx: Int, declEnd: Int, declToken: Int, out: mut List<Int>) -> Bool {
    let mut k = nameIdx + 1
    let mut hit = false
    let mut going = true
    while going {
        if k >= declEnd {
            going = false
        } else if at_symbol(toks: toks, i: k, code: SYM_LBRACE) {
            going = false
        } else if tk_text(toks, i: k) == "derives" && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: (k + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close < 0 {
                going = false
            } else {
                let mut m = k + 2
                while m < close {
                    if is_ident_tok(toks: toks, i: m) && is_banned_resource_derive(name: tk_text(toks, i: m)) {
                        hit = true
                        List.push<Int>(list: mut out, value: declToken)
                    }
                    m = m + 1
                }
                k = close + 1
            }
        } else {
            k = k + 1
        }
    }
    return hit
}

fn collect_bad_resource_derives(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            if starts_type_decl(toks: toks, i: i, isPub: cls.isPub) {
                let ns = type_name_start(toks, i)
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    if at_ident(toks: toks, i: (ns - 1), wid: WORD_RESOURCE) {
                        if collect_bad_resource_derive_tokens(toks, nameIdx: ns, declEnd: r, declToken: i, out: mut out) { hit = true }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0211: DERIVE_FIELD_UNSUPPORTED. A value-derive trait whose field types don't satisfy
// the trait constraint. Float is not Eq/Ord/Hash (but IS Clone); a `handle` field is not
// Eq/Ord/Hash; a Map keyed by Float or List is not Eq/Ord/Hash, and a Float Map key is not
// JsonDecode-able. A field type that transitively contains Float (e.g. `GenericKeyHolder
// <Float>`) fails the same way (the inner Float is not Eq). Message: "`<Trait>` derive is
// not supported by field `<name>`." (analyzer/derives.rs). Scans type-decl headers for a
// `derives(...)` clause, then each `name: Type` field in the body.

// Whether the derives(...) clause in [nameIdx, bodyOpen) contains the given trait name.
fn derive_has_trait(toks: List<Tok>, nameIdx: Int, bodyOpen: Int, traitName: String) -> Bool {
    let mut k = nameIdx + 1
    let mut found = false
    while k < bodyOpen {
        if tk_text(toks, i: k) == "derives" && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: (k + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close < 0 {
                k = bodyOpen
            } else {
                let mut m = k + 2
                while m < close {
                    if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == traitName { found = true }
                    m = m + 1
                }
                k = close + 1
            }
        } else {
            k = k + 1
        }
    }
    return found
}

// Generic params declared in `struct Name<T, U>` — the idents inside the `<...>` right after
// the type name. Empty if the type is non-generic.
fn collect_struct_generics(toks: List<Tok>, nameIdx: Int, bodyOpen: Int) -> Set<String> {
    let mut params = Set.new<String>()
    if (nameIdx + 1) < bodyOpen && at_symbol(toks: toks, i: (nameIdx + 1), code: SYM_LANGLE) {
        let close = find_matching(toks: toks, open: (nameIdx + 1), openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if close >= 0 {
            let mut m = nameIdx + 2
            while m < close {
                if is_ident_tok(toks: toks, i: m) {
                    let nm = tk_text(toks, i: m)
                    Set.insert<String>(set: mut params, value: nm)
                }
                m = m + 1
            }
        }
    }
    return params
}

// Whether the type in [ts, te) is usable as a Map key — i.e. is Hash. Int/String/Bool/Char
// are Hash; Float is not; List<E>/Map<E,_> are Hash iff their key/element is; a generic param
// is Hash only if the enclosing struct also derives Hash (which bounds it); any other user
// type is assumed Hash-safe (avoids false positives — the direct Float/handle scan catches
// the concrete non-Eq cases). Only the root token and its first generic arg are inspected.
fn type_is_hash_safe(toks: List<Tok>, ts: Int, te: Int, genParams: Set<String>, derivesHash: Bool) -> Bool {
    if ts >= te { return true }
    let root = tk_text(toks, i: ts)
    if root == "Int" || root == "String" || root == "Bool" || root == "Char" { return true }
    if root == "Float" { return false }
    if root == "List" || root == "Map" {
        // recurse on the first generic argument (List<E> element, Map<K,_> key)
        if (ts + 1) < te && at_symbol(toks: toks, i: (ts + 1), code: SYM_LANGLE) {
            let close = find_matching(toks: toks, open: (ts + 1), openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
            let inner = arg_end(toks, start: (ts + 2), limit: te)
            return type_is_hash_safe(toks, ts: (ts + 2), te: inner, genParams, derivesHash)
        }
        return true
    }
    if Set.contains<String>(set: genParams, value: root) { return derivesHash }
    return true
}

// The first `{` in [nameIdx, declEnd) — the type body open (derives(...) uses parens, and a
// generic `<T>` uses angles, so the first brace is always the body).
fn derive_type_body_open(toks: List<Tok>, nameIdx: Int, declEnd: Int) -> Int {
    let mut k = nameIdx + 1
    let mut result = -1
    let mut going = true
    while going {
        if k >= declEnd {
            going = false
        } else if at_symbol(toks: toks, i: k, code: SYM_LBRACE) {
            result = k
            going = false
        } else {
            k = k + 1
        }
    }
    return result
}

// RS0032: a type used where a generic method requires a protocol it does not satisfy —
// `Set.new<T>`/`Map.new<K,_>`/`Set.insert`/`Map.insert` require the element/key to be
// Hashable, `List.sort<T>` requires Ord. Message: "type `T` does not satisfy protocol
// `Hashable`/`Ord` required by `<call>`." The parity check is presence-per-file, so the
// explicit-type-arg forms (`Set.new<T>`, `Map.new<K,V>`, `List.sort<T>`) suffice — every
// RS0032 file carries one. A user struct/class/sum is Hashable/Ord only if it derives
// Hash/Ord; Int/String/Bool/Char are both; Float is neither. Unknown (imported) types are
// left alone to avoid false positives.

// Whether a type DECLARED in this file with the given name derives the given trait. Handles
// both struct/class/resource decls (parse_type_decl) and `sum` decls (parse_sum_decl); a
// parse failure just advances one token rather than aborting the scan.
fn local_type_derives(toks: List<Tok>, typeName: String, traitName: String) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut found = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isTypeDecl = starts_type_decl(toks: toks, i: i, isPub: cls.isPub)
            let isSumDecl = at_ident(toks: toks, i: i, wid: WORD_SUM) || (cls.isPub && at_ident(toks: toks, i: (i + 1), wid: WORD_SUM))
            if isTypeDecl || isSumDecl {
                let ns = type_name_start(toks, i)
                let mut r = parse_type_decl(toks: toks, i: i)
                if isSumDecl { r = parse_sum_decl(toks: toks, i: i) }
                if r < 0 {
                    i = i + 1
                } else {
                    if is_ident_tok(toks: toks, i: ns) && tk_text(toks, i: ns) == typeName {
                        let bo = derive_type_body_open(toks, nameIdx: ns, declEnd: r)
                        let mut hdrEnd = r
                        if bo >= 0 { hdrEnd = bo }
                        if derive_has_trait(toks, nameIdx: ns, bodyOpen: hdrEnd, traitName) { found = true }
                        running = false
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return found
}

// Whether the root type at `ts` satisfies a protocol: `wantHash` = Hashable, else Ord.
// Returns true (satisfies, no fire) for scalars and for unknown/imported types.
fn arg_root_satisfies(toks: List<Tok>, ts: Int, te: Int, declared: Set<String>, wantHash: Bool) -> Bool {
    if ts >= te { return true }
    let root = tk_text(toks, i: ts)
    if root == "Int" || root == "String" || root == "Char" || root == "Bool" { return true }
    if root == "Float" { return false }
    if Set.contains<String>(set: declared, value: root) {
        if wantHash {
            return local_type_derives(toks, typeName: root, traitName: "Hash")
        }
        return local_type_derives(toks, typeName: root, traitName: "Ord")
    }
    return true
}

// Fire when `recv.method<TypeArg, ..>` requires a protocol the first type arg lacks.
fn call_protocol_bad(toks: List<Tok>, i: Int, recv: String, method: String, declared: Set<String>, wantHash: Bool) -> Bool {
    if tk_text(toks, i) == recv && at_symbol(toks: toks, i: (i + 1), code: SYM_DOT) && tk_text(toks, i: (i + 2)) == method && at_symbol(toks: toks, i: (i + 3), code: SYM_LANGLE) {
        let rangle = find_matching(toks: toks, open: (i + 3), openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if rangle > (i + 4) {
            let te = arg_end(toks, start: (i + 4), limit: rangle)
            if arg_root_satisfies(toks, ts: (i + 4), te, declared, wantHash) == false { return true }
        }
    }
    return false
}

fn collect_protocol_violation_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let declared = collect_declared_types(toks)
    let mut i = 0
    let mut hit = false
    while i < ntok {
        let badSet = call_protocol_bad(toks, i, recv: "Set", method: "new", declared, wantHash: true)
        let badMap = call_protocol_bad(toks, i, recv: "Map", method: "new", declared, wantHash: true)
        let badSort = call_protocol_bad(toks, i, recv: "List", method: "sort", declared, wantHash: false)
        if badSet || badMap || badSort {
            List.push<Int>(list: mut out, value: i)
            hit = true
        }
        i = i + 1
    }
    return hit
}

// RS1004: surface reference syntax (`&T` / `&mut T`) is not part of RSScript — it only ever
// appears in a TYPE position (borrow-passing uses the `read`/`mut`/`take` effect keywords, not
// `&`). Message: "surface reference syntax is not part of RSScript." Detect `& mut` (mut is a
// reserved keyword, so this is never a bitwise-and), `: &` (a type starting with `&`), or
// `-> &` (a return type starting with `&`). Bitwise-and `a & b` never matches these.
fn collect_surface_references(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while (i + 1) < ntok {
        if at_symbol(toks: toks, i: i, code: SYM_AMP) {
            let typePrefix = at_symbol(toks: toks, i: (i - 1), code: SYM_COLON) || at_symbol(toks: toks, i: (i - 1), code: SYM_ARROW)
            if typePrefix || tk_text(toks, i: (i + 1)) == "mut" {
                hit = true
                List.push<Int>(list: mut out, value: i)
            }
        }
        i = i + 1
    }
    return hit
}

// End of the field type that starts at `ts`: the next top-level (nesting-depth 0) `name:`
// field header, or bodyClose. `< ( [` open and `> ) ]` close a nesting level.
fn field_type_end(toks: List<Tok>, ts: Int, bodyClose: Int) -> Int {
    let mut m = ts
    let mut depth = 0
    let mut result = bodyClose
    let mut going = true
    while going {
        if m >= bodyClose {
            result = bodyClose
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_LANGLE) || at_symbol(toks: toks, i: m, code: SYM_LPAREN) || at_symbol(toks: toks, i: m, code: SYM_LBRACKET) {
            depth = depth + 1
            m = m + 1
        } else if at_symbol(toks: toks, i: m, code: SYM_RANGLE) || at_symbol(toks: toks, i: m, code: SYM_RPAREN) || at_symbol(toks: toks, i: m, code: SYM_RBRACKET) {
            depth = depth - 1
            m = m + 1
        } else if depth == 0 && m > ts && is_ident_tok(toks: toks, i: m) && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) {
            result = m
            going = false
        } else {
            m = m + 1
        }
    }
    return result
}

// Whether the field type in [ts, te) violates a derived trait: (Eq/Ord/Hash) a `Float` type
// token or a `handle` modifier anywhere; (Eq/Ord/Hash/JsonDecode) a `Map<Float, ..>` or
// `Map<List.., ..>` key.
fn field_type_bad_for_derive(toks: List<Tok>, ts: Int, te: Int, hasEOH: Bool, hasJD: Bool, genParams: Set<String>, derivesHash: Bool) -> Bool {
    let mut k = ts
    let mut bad = false
    while k < te {
        if hasEOH {
            if is_ident_tok(toks: toks, i: k) && tk_text(toks, i: k) == "Float" { bad = true }
            if tk_text(toks, i: k) == "handle" { bad = true }
        }
        // A Map key must be Hash. Applies to any derive (Eq/Ord/Hash need the field to be
        // Eq/Ord/Hash, which needs the Map well-formed; JsonDecode needs string-decodable keys).
        if (hasEOH || hasJD) && tk_text(toks, i: k) == "Map" && at_symbol(toks: toks, i: (k + 1), code: SYM_LANGLE) {
            let keyEnd = arg_end(toks, start: (k + 2), limit: te)
            if type_is_hash_safe(toks, ts: (k + 2), te: keyEnd, genParams, derivesHash) == false { bad = true }
        }
        k = k + 1
    }
    return bad
}

// Iterate `name: Type` fields in the body [bodyOpen, bodyClose) and test each type.
fn collect_derive_body_field_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, hasEq: Bool, hasOrd: Bool, hasHash: Bool, hasJD: Bool, genParams: Set<String>, out: mut List<Int>) -> Bool {
    let mut i = bodyOpen + 1
    let mut hit = false
    while i < bodyClose {
        if is_ident_tok(toks: toks, i: i) && at_symbol(toks: toks, i: (i + 1), code: SYM_COLON) {
            let ts = i + 2
            let te = field_type_end(toks, ts, bodyClose)
            if (hasOrd || hasEq) && field_type_bad_for_derive(toks, ts, te, hasEOH: true, hasJD: false, genParams, derivesHash: hasHash) {
                List.push<Int>(list: mut out, value: i)
                hit = true
            }
            if hasHash && field_type_bad_for_derive(toks, ts, te, hasEOH: true, hasJD: false, genParams, derivesHash: true) {
                List.push<Int>(list: mut out, value: i)
                hit = true
            }
            if hasJD && field_type_bad_for_derive(toks, ts, te, hasEOH: false, hasJD: true, genParams, derivesHash: hasHash) {
                List.push<Int>(list: mut out, value: i)
                hit = true
            }
            i = te
        } else {
            i = i + 1
        }
    }
    return hit
}

fn collect_bad_derive_field_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            if starts_type_decl(toks: toks, i: i, isPub: cls.isPub) {
                let ns = type_name_start(toks, i)
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let bo = derive_type_body_open(toks, nameIdx: ns, declEnd: r)
                    if bo >= 0 {
                        let hasEq = derive_has_trait(toks, nameIdx: ns, bodyOpen: bo, traitName: "Eq")
                        let hasOrd = derive_has_trait(toks, nameIdx: ns, bodyOpen: bo, traitName: "Ord")
                        let hasHash = derive_has_trait(toks, nameIdx: ns, bodyOpen: bo, traitName: "Hash")
                        let hasEOH = hasEq || hasOrd || hasHash
                        let hasJD = derive_has_trait(toks, nameIdx: ns, bodyOpen: bo, traitName: "JsonDecode")
                        if hasEOH || hasJD {
                            let bc = find_matching(toks: toks, open: bo, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                            if bc >= 0 {
                                let genParams = collect_struct_generics(toks, nameIdx: ns, bodyOpen: bo)
                                if collect_derive_body_field_tokens(toks, bodyOpen: bo, bodyClose: bc, hasEq, hasOrd, hasHash, hasJD, genParams, out: mut out) { hit = true }
                            }
                        }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return hit
}

// RS0311: reassigning an immutable `let` local (oracle analyzer/assign.rs). We fire
// only the FP-safe core — a bare-name simple assignment `NAME = e` where NAME is a
// plain `let` local (not `let mut`, not a param). Compound (`x.f = e`) and param
// cases are also RS0311 but are left as safe false-negatives (no corpus file needs
// them). The scanner emits `==` as two SYM_EQ and never fuses `=`, so a SYM_EQ whose
// next token isn't `=` and whose previous token is an ident (not after `let`/`mut`)
// is exactly an assignment.
fn collect_let_kinds(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, immut: mut Set<String>, mutable: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "let") {
            let mut q = k + 1
            let isMut = is_kw_text(toks, i: q, word: "mut")
            if isMut { q = q + 1 }
            if is_ident_tok(toks: toks, i: q) {
                let name = tk_text(toks, i: q)
                if isMut {
                    Set.insert<String>(set: mut mutable, value: name)
                } else {
                    Set.insert<String>(set: mut immut, value: name)
                }
            }
        }
        k = k + 1
    }
    return Unit
}

// RS0307 (`manage`) / RS0308 (`take`): both require an OWNED local value. `manage <x>` /
// `take <x>` fires only when `x` is a MANAGED source — a `read`/`mut` parameter, a `let`
// binding, or a `local` captured across a closure boundary. It is OK (no fire) when `x` is:
// a field access `x.f` (RS0901/other own it); a Type (uppercase — a nested closure's `take T`
// param effect); a `take`-effect parameter (already owned, re-takeable); a `with … as x`
// resource lease (RS0013 owns escapes); or a `local` reachable in the same closure scope. Only
// a closure `|…| { }` is a capture boundary — `if`/`loop`/`while`/`with` blocks share the
// function's locals.

// Parameter names declared with the `take` effect (`name: take Type`).
fn collect_take_params(toks: List<Tok>, ns: Int, sigEnd: Int, out: mut Set<String>) -> Unit {
    // The first `(` after the name (find_top_sym can't match an opening bracket — it counts it
    // as depth before the match check).
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: toks, i: tt, code: SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) && is_kw_text(toks, i: (k + 2), word: "take") {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: k))
        }
        k = k + 1
    }
    return Unit
}

// Lowercase idents bound by a match arm: the payload idents of `Variant(a, b) =>` and a bare
// `name =>` catch-all. Such bindings own their value, so `take`/`manage` of them is allowed.
fn collect_match_bindings(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_FATARROW) && k >= 1 {
            if at_symbol(toks: toks, i: (k - 1), code: SYM_RPAREN) {
                let lp = matching_lparen(toks, closePos: (k - 1))
                if lp >= 0 {
                    let mut m = lp + 1
                    while m < (k - 1) {
                        if is_ident_tok(toks: toks, i: m) && is_upper_head(name: tk_text(toks, i: m)) == false {
                            Set.insert<String>(set: mut out, value: tk_text(toks, i: m))
                        }
                        m = m + 1
                    }
                }
            } else if is_ident_tok(toks: toks, i: (k - 1)) && is_upper_head(name: tk_text(toks, i: (k - 1))) == false {
                Set.insert<String>(set: mut out, value: tk_text(toks, i: (k - 1)))
            }
        }
        k = k + 1
    }
    return Unit
}

// Names bound by `with … as <name>` (a resource lease).
fn collect_with_bindings(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "as") && is_ident_tok(toks: toks, i: (k + 1)) {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: (k + 1)))
        }
        k = k + 1
    }
    return Unit
}

// The `{` opening the nearest CLOSURE body enclosing `p` (its `{` is preceded by a `|`), or
// `fnBody` if no closure intervenes. Ordinary `{}` blocks are transparent (shared scope).
fn enclosing_capture_open(toks: List<Tok>, p: Int, fnBody: Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = fnBody
    let mut going = true
    while going {
        if m < 0 {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_RBRACE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: toks, i: m, code: SYM_LBRACE) {
            if depth == 0 {
                if m == fnBody {
                    result = fnBody
                    going = false
                } else if m > 0 && at_symbol(toks: toks, i: (m - 1), code: SYM_PIPE) {
                    result = m
                    going = false
                } else {
                    m = m - 1
                }
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// Whether `local [mut] <x>` is declared anywhere in [open, close).
fn local_in_scope_all(toks: List<Tok>, open: Int, close: Int, x: String) -> Bool {
    let mut k = open + 1
    let mut found = false
    while k < close {
        if is_kw_text(toks, i: k, word: "local") {
            let mut q = k + 1
            if is_kw_text(toks, i: q, word: "mut") { q = q + 1 }
            if is_ident_tok(toks: toks, i: q) && tk_text(toks, i: q) == x { found = true }
        }
        k = k + 1
    }
    return found
}

fn collect_fn_manage_take_bad_tokens(toks: List<Tok>, start: Int, keyword: String, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut takeParams = Set.new<String>()
    collect_take_params(toks, ns, sigEnd, out: mut takeParams)
    let mut withBinds = Set.new<String>()
    collect_with_bindings(toks, bodyOpen: sigEnd, bodyClose, out: mut withBinds)
    let mut matchBinds = Set.new<String>()
    collect_match_bindings(toks, bodyOpen: sigEnd, bodyClose, out: mut matchBinds)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: keyword) && is_ident_tok(toks: toks, i: (k + 1)) {
            let x = tk_text(toks, i: (k + 1))
            // A PLAIN field access `x.f` is owned (RS0901 territory) — but a METHOD-CALL result
            // `x.m(…)` is a managed temp and DOES fire. Exclude only the former (dot, no call).
            let isField = at_symbol(toks: toks, i: (k + 2), code: SYM_DOT) && at_symbol(toks: toks, i: (k + 4), code: SYM_LPAREN) == false
            let isType = is_upper_head(name: x)
            let isTakeParam = Set.contains<String>(set: takeParams, value: x)
            // A `with … as x` lease is owned for `take` (RS0013 owns the escape) but managed
            // for `manage` (RS0307 fires on `manage <lease>`).
            let isWith = keyword == "take" && Set.contains<String>(set: withBinds, value: x)
            let isMatch = Set.contains<String>(set: matchBinds, value: x)
            if !isField  && !isType  && !isTakeParam  && !isWith  && !isMatch  {
                let scopeOpen = enclosing_capture_open(toks, p: k, fnBody: sigEnd)
                let mut scopeClose = find_matching(toks: toks, open: scopeOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if scopeClose < 0 { scopeClose = bodyClose }
                if local_in_scope_all(toks, open: scopeOpen, close: scopeClose, x) == false {
                    List.push<Int>(list: mut out, value: k)
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0301 MANAGED_TO_LOCAL: `local X = RHS` where RHS is a managed place — a plain `let`
// binding (ALWAYS managed, even scalar — confirmed via oracle), a `handle`-field access, or a
// `Some(…)`/`Ok(…)` wrapper around one (after an optional leading `read`/`mut`). Params,
// `local` bindings, literals, and normal (non-handle) field accesses are NOT managed.

// Field names declared with the `handle` modifier anywhere (`name: handle Type`).
fn collect_handle_field_names(toks: List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: toks)
    let mut k = 0
    while k + 2 < n {
        if is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) && is_kw_text(toks, i: (k + 2), word: "handle") {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: k))
        }
        k = k + 1
    }
    return Unit
}

// Whether the RHS value at `vs` is a managed place for RS0301: a `let` binding, a
// `handle`-field access `_.f`, or `Some(…)`/`Ok(…)` wrapping one (after an optional effect).
fn rhs_managed_token_for_local(toks: List<Tok>, vs: Int, end: Int, managed: Set<String>, handleFields: Set<String>) -> Int {
    let mut s = vs
    if is_effect_kw(toks, i: s) { s = s + 1 }
    if s >= end { return 0 - 1 }
    if is_ident_tok(toks: toks, i: s) == false { return 0 - 1 }
    let head = tk_text(toks, i: s)
    if (head == "Some" || head == "Ok") && at_symbol(toks: toks, i: (s + 1), code: SYM_LPAREN) {
        return rhs_managed_token_for_local(toks, vs: (s + 2), end, managed, handleFields)
    }
    if at_symbol(toks: toks, i: (s + 1), code: SYM_DOT) && is_ident_tok(toks: toks, i: (s + 2)) {
        let field = tk_text(toks, i: (s + 2))
        if Set.contains<String>(set: handleFields, value: field) { return s }
        return 0 - 1
    }
    if Set.contains<String>(set: managed, value: head) { return s }
    return 0 - 1
}

fn collect_fn_managed_to_local_tokens(toks: List<Tok>, start: Int, handleFields: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let managed = collect_managed_names(toks, bodyOpen: sigEnd, bodyClose)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "local") {
            let mut nameIdx = k + 1
            if is_kw_text(toks, i: nameIdx, word: "mut") { nameIdx = nameIdx + 1 }
            if is_ident_tok(toks: toks, i: nameIdx) {
                let mut eqPos = 0 - 1
                let mut t = nameIdx + 1
                let mut scan = true
                while scan {
                    if t >= bodyClose {
                        scan = false
                    } else if at_symbol(toks: toks, i: t, code: SYM_LBRACE) || at_symbol(toks: toks, i: t, code: SYM_RBRACE) {
                        scan = false
                    } else if at_symbol(toks: toks, i: t, code: SYM_EQ) && at_symbol(toks: toks, i: (t + 1), code: SYM_EQ) == false {
                        eqPos = t
                        scan = false
                    } else {
                        t = t + 1
                    }
                }
                if eqPos > 0 {
                    let managedToken = rhs_managed_token_for_local(toks, vs: (eqPos + 1), end: bodyClose, managed, handleFields)
                    if managedToken >= 0 {
                        List.push<Int>(list: mut out, value: managedToken)
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0401 USE_AFTER_MANAGE: a `manage x` / `take x` moves `x`, so any USE of `x` later in the
// function body is an error — even when the move sits inside a branch or loop (rss treats a
// conditionally-moved value as moved on the continuation). A "use" is an occurrence of the
// ident `x` that is not an arg/field label (`x:`), not a field of another place (`_.x`), not a
// (re)binding position (`let`/`local`/`mut x`), and not an assignment target (`x =`).
fn collect_uses_after_move(toks: List<Tok>, from: Int, close: Int, x: String, out: mut List<Int>) -> Bool {
    let mut m = from
    let mut found = false
    while m < close {
        if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == x {
            let prevDot = at_symbol(toks: toks, i: (m - 1), code: SYM_DOT)
            let prevBind = is_kw_text(toks, i: (m - 1), word: "let") || is_kw_text(toks, i: (m - 1), word: "local") || is_kw_text(toks, i: (m - 1), word: "mut")
            let nextColon = at_symbol(toks: toks, i: (m + 1), code: SYM_COLON)
            let nextAssign = at_symbol(toks: toks, i: (m + 1), code: SYM_EQ) && at_symbol(toks: toks, i: (m + 2), code: SYM_EQ) == false
            if !prevDot  && !prevBind  && !nextColon  && !nextAssign  {
                List.push<Int>(list: mut out, value: m)
                found = true
            }
        }
        m = m + 1
    }
    return found
}

// The `{` opening the immediate block enclosing `p`, floored at `fnBody` (the fn body `{`).
fn enclosing_block_open(toks: List<Tok>, p: Int, fnBody: Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = fnBody
    let mut going = true
    while going {
        if m <= fnBody {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_RBRACE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: toks, i: m, code: SYM_LBRACE) {
            if depth == 0 {
                result = m
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// Whether a `return` keyword appears in [from, to). Only `return` exits the FUNCTION, so a move
// on that path never taints the continuation; a `break` merely exits a loop and execution
// continues after it, so a move before a `break` still taints the post-loop continuation.
fn has_return_or_break(toks: List<Tok>, from: Int, to: Int) -> Bool {
    let mut m = from
    let mut found = false
    while m < to {
        if is_kw_text(toks, i: m, word: "return") { found = true }
        m = m + 1
    }
    return found
}

// Whether the field path `base . field` is used in [from, close), excluding a binding position.
fn collect_field_uses_after_move(toks: List<Tok>, from: Int, close: Int, base: String, field: String, out: mut List<Int>) -> Bool {
    let mut m = from
    let mut found = false
    while m < close {
        if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == base && at_symbol(toks: toks, i: (m + 1), code: SYM_DOT) && is_ident_tok(toks: toks, i: (m + 2)) && tk_text(toks, i: (m + 2)) == field {
            let prevBind = is_kw_text(toks, i: (m - 1), word: "let") || is_kw_text(toks, i: (m - 1), word: "local")
            let prevDot = at_symbol(toks: toks, i: (m - 1), code: SYM_DOT)
            if !prevBind  && !prevDot  {
                List.push<Int>(list: mut out, value: m)
                found = true
            }
        }
        m = m + 1
    }
    return found
}

fn collect_fn_use_after_manage_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        let isMove = is_kw_text(toks, i: k, word: "manage") || is_kw_text(toks, i: k, word: "take")
        if isMove && is_ident_tok(toks: toks, i: (k + 1)) {
            let x = tk_text(toks, i: (k + 1))
            if is_upper_head(name: x) == false {
                // A move in a block that returns/breaks does not taint the continuation past
                // that block — limit the scan to the enclosing block in that case.
                let bo = enclosing_block_open(toks, p: k, fnBody: sigEnd)
                let mut bc = find_matching(toks: toks, open: bo, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if bc < 0 { bc = bodyClose }
                let exits = has_return_or_break(toks, from: (k + 1), to: bc)
                let mut scanEnd = bodyClose
                if exits { scanEnd = bc }
                if at_symbol(toks: toks, i: (k + 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (k + 3)) {
                    let field = tk_text(toks, i: (k + 3))
                    if collect_field_uses_after_move(toks, from: (k + 4), close: scanEnd, base: x, field, out: mut out) { hit = true }
                } else {
                    if collect_uses_after_move(toks, from: (k + 2), close: scanEnd, x, out: mut out) { hit = true }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0501 LOCAL_VALUE_RETAINED: passing a `local` value as an argument to a parameter the callee
// declares `effects(retains(P))`. A local's lifetime is the caller's frame, so it can't be
// retained beyond the call. (A `let`/managed value passed there is a different error — the take
// itself is RS0308; a managed value can legitimately be retained.)

// Registry of retained params as composite keys `shortFnName|paramName`, across all fn decls in
// the file (analyze_source is per-file, so callee decls are in-scope here).
fn collect_retains(toks: List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks, i: k, word: "fn") {
            let mut p = k + 1
            let mut scan = true
            while scan {
                if p >= n {
                    scan = false
                } else if at_symbol(toks: toks, i: p, code: SYM_LPAREN) || is_kw_text(toks, i: p, word: "fn") || at_symbol(toks: toks, i: p, code: SYM_LBRACE) {
                    scan = false
                } else {
                    p = p + 1
                }
            }
            if p < n && at_symbol(toks: toks, i: p, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (p - 1)) {
                let shortName = tk_text(toks, i: (p - 1))
                let pclose = find_matching(toks: toks, open: p, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                if pclose > 0 {
                    let mut e = pclose + 1
                    let mut go = true
                    while go {
                        if e >= n {
                            go = false
                        } else if at_symbol(toks: toks, i: e, code: SYM_LBRACE) || is_kw_text(toks, i: e, word: "fn") {
                            go = false
                        } else if is_ident_tok(toks: toks, i: e) && tk_text(toks, i: e) == "retains" && at_symbol(toks: toks, i: (e + 1), code: SYM_LPAREN) {
                            let rclose = find_matching(toks: toks, open: (e + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                            if rclose > 0 {
                                let mut m = e + 2
                                while m < rclose {
                                    if is_ident_tok(toks: toks, i: m) {
                                        let key = String.concat(left: String.concat(left: shortName, right: "|"), right: tk_text(toks, i: m))
                                        Set.insert<String>(set: mut out, value: key)
                                    }
                                    m = m + 1
                                }
                                e = rclose
                            } else {
                                e = e + 1
                            }
                        } else {
                            e = e + 1
                        }
                    }
                }
                k = p
            } else {
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// Whether the binding of `name` in scope at `from` (nearest preceding `local`/`let` decl,
// scanning back to bodyOpen) is a `local`. Proximity handles shadowing — a later `let name`
// supersedes an earlier `local name` in a since-closed sibling block. No decl found → false.
fn nearest_binding_is_local(toks: List<Tok>, from: Int, bodyOpen: Int, name: String) -> Bool {
    let mut m = from - 1
    let mut result = false
    let mut found = false
    while m > bodyOpen && !found  {
        if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == name {
            let mut prev = m - 1
            if is_kw_text(toks, i: prev, word: "mut") { prev = m - 2 }
            if is_kw_text(toks, i: prev, word: "local") {
                result = true
                found = true
            } else if is_kw_text(toks, i: prev, word: "let") {
                result = false
                found = true
            }
        }
        m = m - 1
    }
    return result
}

// A builtin collection `insert` retains its `key`/`value` (the collection outlives the call).
fn builtin_retains_label(toks: List<Tok>, callPos: Int, label: String) -> Bool {
    if tk_text(toks, i: (callPos - 1)) != "insert" { return false }
    if at_symbol(toks: toks, i: (callPos - 2), code: SYM_DOT) == false { return false }
    if is_ident_tok(toks: toks, i: (callPos - 3)) == false { return false }
    let recv = tk_text(toks, i: (callPos - 3))
    let isColl = recv == "Map" || recv == "Set" || recv == "Deque" || recv == "HashMap"
    if !isColl  { return false }
    return label == "key" || label == "value"
}

fn collect_fn_retained_local_tokens(toks: List<Tok>, start: Int, retains: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (k - 1)) {
            let callee = tk_text(toks, i: (k - 1))
            let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close > 0 {
                let mut q = k + 1
                let mut depth = 0
                let mut atStart = true
                while q < close {
                    let opener = at_symbol(toks: toks, i: q, code: SYM_LPAREN) || at_symbol(toks: toks, i: q, code: SYM_LBRACKET) || at_symbol(toks: toks, i: q, code: SYM_LBRACE)
                    let closer = at_symbol(toks: toks, i: q, code: SYM_RPAREN) || at_symbol(toks: toks, i: q, code: SYM_RBRACKET) || at_symbol(toks: toks, i: q, code: SYM_RBRACE)
                    if opener {
                        depth = depth + 1
                        atStart = false
                    } else if closer {
                        if depth > 0 { depth = depth - 1 }
                        atStart = false
                    } else if depth == 0 && at_symbol(toks: toks, i: q, code: SYM_COMMA) {
                        atStart = true
                    } else if depth == 0 && atStart && is_ident_tok(toks: toks, i: q) && at_symbol(toks: toks, i: (q + 1), code: SYM_COLON) {
                        let label = tk_text(toks, i: q)
                        let key = String.concat(left: String.concat(left: callee, right: "|"), right: label)
                        let retained = Set.contains<String>(set: retains, value: key) || builtin_retains_label(toks, callPos: k, label)
                        if retained {
                            // Base of the value: strip effect, unwrap Some(…)/Ok(…), to the base ident.
                            let mut v = q + 2
                            if is_effect_kw(toks, i: v) { v = v + 1 }
                            let mut unwrap = true
                            while unwrap {
                                if is_ident_tok(toks: toks, i: v) && (tk_text(toks, i: v) == "Some" || tk_text(toks, i: v) == "Ok") && at_symbol(toks: toks, i: (v + 1), code: SYM_LPAREN) {
                                    v = v + 2
                                    if is_effect_kw(toks, i: v) { v = v + 1 }
                                } else {
                                    unwrap = false
                                }
                            }
                            if is_ident_tok(toks: toks, i: v) && nearest_binding_is_local(toks, from: k, bodyOpen: sigEnd, name: tk_text(toks, i: v)) {
                                List.push<Int>(list: mut out, value: v)
                                hit = true
                            }
                        }
                        atStart = false
                    } else {
                        atStart = false
                    }
                    q = q + 1
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0303 / RS0305 / RS0309: three place-pair conflict codes emitted by the same routine
// (checks/body/place.rs::check_place_pair_conflict). For each call, every effect-wrapped place
// argument (`read`/`mut`/`take`/`manage <place>`, including places inside a closure argument) is
// collected; each unordered same-base pair dispatches, in order, to:
//   RS0305 — a MOVE (`take`/`manage`) whose path is not provably disjoint from the other access
//            (bare base on either side, an index, a handle crossing, or prefix-or-equal fields).
//   RS0303 — a mut pair (≥1 `mut`, no move) whose paths are prefix-or-equal OR cross a `handle`
//            field, excluding whole-vs-field (that is RS0302) and indexed paths (RS0304).
//   RS0309 — genuinely DISJOINT inline fields of a non-splittable base (a `mut` parameter), ≥1
//            `mut`/`take`, no index/handle/prefix.
// A base that is a `local` binding or a `take` parameter (a provably-exclusive local value) is
// splittable, so disjoint inline fields there are clean.

// Parameter names declared with the `mut` effect (`name: mut Type`).
fn collect_mut_params(toks: List<Tok>, ns: Int, sigEnd: Int, out: mut Set<String>) -> Unit {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: toks, i: tt, code: SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) && is_kw_text(toks, i: (k + 2), word: "mut") {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: k))
        }
        k = k + 1
    }
    return Unit
}

// The base ident position of an arg value at `v`: skip leading effect kws and `(`, return the
// first ident, or -1.
fn arg_base_pos(toks: List<Tok>, v: Int, argEnd: Int) -> Int {
    let mut m = v
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m >= argEnd {
            going = false
        } else {
            let t = tk_text(toks, i: m)
            if t == "read" || t == "mut" || t == "take" || t == "manage" || at_symbol(toks: toks, i: m, code: SYM_LPAREN) {
                m = m + 1
            } else if is_ident_tok(toks: toks, i: m) {
                result = m
                going = false
            } else {
                going = false
            }
        }
    }
    return result
}

// 2 if a `take`/`manage` precedes the base (a move), 1 if a `mut` does, 0 otherwise.
fn arg_move_kind(toks: List<Tok>, v: Int, basePos: Int) -> Int {
    let mut m = v
    let mut kind = 0
    while m < basePos {
        let t = tk_text(toks, i: m)
        if t == "take" || t == "manage" {
            kind = 2
        } else if t == "mut" && kind == 0 {
            kind = 1
        }
        m = m + 1
    }
    return kind
}

// End of the place path starting at `basePos` (base + `.field` chain + `[index]`), bounded by end.
fn place_end(toks: List<Tok>, basePos: Int, argEnd: Int) -> Int {
    let mut m = basePos + 1
    let mut going = true
    while going {
        if m >= argEnd {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_DOT) && is_ident_tok(toks: toks, i: (m + 1)) {
            m = m + 2
        } else if at_symbol(toks: toks, i: m, code: SYM_LBRACKET) {
            let cl = find_matching(toks: toks, open: m, openSym: SYM_LBRACKET, closeSym: SYM_RBRACKET)
            if cl < 0 { going = false } else { m = cl + 1 }
        } else {
            going = false
        }
    }
    return m
}

fn place_has_index(toks: List<Tok>, basePos: Int, end: Int) -> Bool {
    let mut m = basePos + 1
    let mut found = false
    while m < end {
        if at_symbol(toks: toks, i: m, code: SYM_LBRACKET) { found = true }
        m = m + 1
    }
    return found
}

fn place_crosses_handle(toks: List<Tok>, basePos: Int, end: Int, handleFields: Set<String>) -> Bool {
    let mut m = basePos + 1
    let mut found = false
    while m < end {
        if at_symbol(toks: toks, i: m, code: SYM_DOT) && is_ident_tok(toks: toks, i: (m + 1)) && Set.contains<String>(set: handleFields, value: tk_text(toks, i: (m + 1))) { found = true }
        m = m + 1
    }
    return found
}

// The `.field` chain as a dotted string ("" if bare, "f1.f2" otherwise), skipping indices.
fn place_comps(toks: List<Tok>, basePos: Int, end: Int) -> String {
    let mut out = ""
    let mut m = basePos + 1
    while m < end {
        if at_symbol(toks: toks, i: m, code: SYM_DOT) && is_ident_tok(toks: toks, i: (m + 1)) {
            if String.len(value: out) > 0 { out = String.concat(left: out, right: ".") }
            out = String.concat(left: out, right: tk_text(toks, i: (m + 1)))
            m = m + 2
        } else {
            m = m + 1
        }
    }
    return out
}

fn comps_prefix_or_equal(a: String, b: String) -> Bool {
    if a == b { return true }
    if String.starts_with(value: b, prefix: String.concat(left: a, right: ".")) { return true }
    if String.starts_with(value: a, prefix: String.concat(left: b, right: ".")) { return true }
    return false
}

// Whether an effect kw (`read`/`mut`/`take`/`manage`) appears in [from, to).
fn has_effect_prefix(toks: List<Tok>, from: Int, to: Int) -> Bool {
    let mut m = from
    let mut found = false
    while m < to {
        let t = tk_text(toks, i: m)
        if t == "read" || t == "mut" || t == "take" || t == "manage" { found = true }
        m = m + 1
    }
    return found
}

// Collect effect-places of one argument segment [sStart, sEnd). A closure argument (`|…| …`) is
// scanned in full (its captured accesses join the call's conflict set); a plain argument
// contributes its single leading effect-place.
fn collect_segment_places(toks: List<Tok>, sStart: Int, sEnd: Int, startOut: mut List<Int>, posOut: mut List<Int>, kindOut: mut List<Int>) -> Unit {
    let mut vStart = sStart
    if is_ident_tok(toks: toks, i: sStart) && at_symbol(toks: toks, i: (sStart + 1), code: SYM_COLON) { vStart = sStart + 2 }
    if at_symbol(toks: toks, i: vStart, code: SYM_PIPE) {
        // Only variables CAPTURED from outside the closure join the enclosing call's conflict
        // set; the closure's own params and `local`/`let` bindings are internal, not captures.
        let mut declInside = Set.new<String>()
        let mut pp = vStart + 1
        let mut inParams = true
        while pp < sEnd && inParams {
            if at_symbol(toks: toks, i: pp, code: SYM_PIPE) {
                inParams = false
            } else {
                if is_ident_tok(toks: toks, i: pp) { Set.insert<String>(set: mut declInside, value: tk_text(toks, i: pp)) }
                pp = pp + 1
            }
        }
        collect_local_names(toks, bodyOpen: pp, bodyClose: sEnd, out: mut declInside)
        let mut dl = pp + 1
        while dl < sEnd {
            if is_kw_text(toks, i: dl, word: "let") {
                let mut nm = dl + 1
                if is_kw_text(toks, i: nm, word: "mut") { nm = nm + 1 }
                if is_ident_tok(toks: toks, i: nm) { Set.insert<String>(set: mut declInside, value: tk_text(toks, i: nm)) }
            }
            dl = dl + 1
        }
        let mut m = vStart
        while m < sEnd {
            let t = tk_text(toks, i: m)
            if t == "read" || t == "mut" || t == "take" || t == "manage" {
                let bp = arg_base_pos(toks, v: m, argEnd: sEnd)
                if bp >= 0 && is_upper_head(name: tk_text(toks, i: bp)) == false && Set.contains<String>(set: declInside, value: tk_text(toks, i: bp)) == false {
                    List.push<Int>(list: mut startOut, value: m)
                    List.push<Int>(list: mut posOut, value: bp)
                    List.push<Int>(list: mut kindOut, value: arg_move_kind(toks, v: m, basePos: bp))
                }
            }
            m = m + 1
        }
    } else {
        let bp = arg_base_pos(toks, v: vStart, argEnd: sEnd)
        if bp >= 0 && is_upper_head(name: tk_text(toks, i: bp)) == false && has_effect_prefix(toks, from: vStart, to: bp) {
            List.push<Int>(list: mut startOut, value: vStart)
            List.push<Int>(list: mut posOut, value: bp)
            List.push<Int>(list: mut kindOut, value: arg_move_kind(toks, v: vStart, basePos: bp))
        }
    }
    return Unit
}

// Collect the effect-place args of the call `(op..close)` — split into arg segments at depth-0
// commas, each processed by collect_segment_places.
fn collect_call_places(toks: List<Tok>, op: Int, close: Int, startOut: mut List<Int>, posOut: mut List<Int>, kindOut: mut List<Int>) -> Unit {
    let mut q = op + 1
    let mut depth = 0
    let mut segStart = op + 1
    while q < close {
        if at_symbol(toks: toks, i: q, code: SYM_LPAREN) || at_symbol(toks: toks, i: q, code: SYM_LBRACKET) || at_symbol(toks: toks, i: q, code: SYM_LBRACE) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: q, code: SYM_RPAREN) || at_symbol(toks: toks, i: q, code: SYM_RBRACKET) || at_symbol(toks: toks, i: q, code: SYM_RBRACE) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: q, code: SYM_COMMA) {
            collect_segment_places(toks, sStart: segStart, sEnd: q, startOut: mut startOut, posOut: mut posOut, kindOut: mut kindOut)
            segStart = q + 1
        }
        q = q + 1
    }
    collect_segment_places(toks, sStart: segStart, sEnd: close, startOut: mut startOut, posOut: mut posOut, kindOut: mut kindOut)
    return Unit
}

// Whether `bitval` (a power of two) is set in `mask` (no bitwise ops in the dialect).
fn bit_set(mask: Int, bitval: Int) -> Bool {
    let q = mask / bitval
    return q - (q / 2) * 2 == 1
}

// Bitmask over one function's calls: bit0 RS0303, bit1 RS0305, bit2 RS0309, bit3 RS0302, bit4 RS0304.
fn collect_fn_place_conflicts(
    source: String,
    toks: List<Tok>,
    start: Int,
    handleFields: Set<String>,
    mutParams: Set<String>,
    out0302: mut List<DiagnosticSite>,
    out0303: mut List<DiagnosticSite>,
    out0304: mut List<DiagnosticSite>,
    out0305: mut List<DiagnosticSite>,
    out0309: mut List<DiagnosticSite>
) -> Int {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return 0 }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return 0 }
    let mut has0303 = false
    let mut has0305 = false
    let mut has0309 = false
    let mut has0302 = false
    let mut has0304 = false
    let mut k = sigEnd + 1
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (k - 1)) {
            let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close > 0 {
                let mut posList = List.new<Int>()
                let mut startList = List.new<Int>()
                let mut kindList = List.new<Int>()
                collect_call_places(toks, op: k, close, startOut: mut startList, posOut: mut posList, kindOut: mut kindList)
                let np = List.len(list: posList)
                let mut a = 0
                while a < np {
                    let mut b = a + 1
                    while b < np {
                        let pa = List.get<Int>(list: posList, index: a)
                        let pb = List.get<Int>(list: posList, index: b)
                        if tk_text(toks, i: pa) == tk_text(toks, i: pb) {
                            let ka = List.get<Int>(list: kindList, index: a)
                            let kb = List.get<Int>(list: kindList, index: b)
                            let ea = place_end(toks, basePos: pa, argEnd: close)
                            let eb = place_end(toks, basePos: pb, argEnd: close)
                            let leftStart = List.get<Int>(list: startList, index: a)
                            let rightStart = List.get<Int>(list: startList, index: b)
                            let rightSite = token_range_diagnostic_site(source, toks, start: rightStart, endInclusive: rightStart)
                            let compsA = place_comps(toks, basePos: pa, end: ea)
                            let compsB = place_comps(toks, basePos: pb, end: eb)
                            let bareA = String.len(value: compsA) == 0
                            let bareB = String.len(value: compsB) == 0
                            let idx = place_has_index(toks, basePos: pa, end: ea) || place_has_index(toks, basePos: pb, end: eb)
                            let hdl = place_crosses_handle(toks, basePos: pa, end: ea, handleFields) || place_crosses_handle(toks, basePos: pb, end: eb, handleFields)
                            let prefixEq = comps_prefix_or_equal(a: compsA, b: compsB)
                            let anyMove = ka == 2 || kb == 2
                            let anyMut = ka == 1 || kb == 1
                            let mutates = anyMove || anyMut
                            let mut handled = false
                            if mutates {
                                if anyMove {
                                    if bareA || bareB || idx || hdl || prefixEq {
                                        has0305 = true
                                        let mut moveStart = rightStart
                                        if ka == 2 { moveStart = leftStart }
                                        let moveSite = token_range_diagnostic_site(source, toks, start: moveStart, endInclusive: moveStart)
                                        List.push<DiagnosticSite>(list: mut out0305, value: moveSite)
                                        handled = true
                                    }
                                }
                                if !handled  && idx {
                                    has0304 = true
                                    List.push<DiagnosticSite>(list: mut out0304, value: rightSite)
                                    handled = true
                                }
                                let oneBare = (bareA && !bareB ) || (bareB && !bareA )
                                if !handled  && oneBare {
                                    has0302 = true
                                    List.push<DiagnosticSite>(list: mut out0302, value: rightSite)
                                    handled = true
                                }
                                if !handled  && hdl {
                                    has0303 = true
                                    List.push<DiagnosticSite>(list: mut out0303, value: rightSite)
                                    handled = true
                                }
                                if !handled  && prefixEq {
                                    has0303 = true
                                    List.push<DiagnosticSite>(list: mut out0303, value: rightSite)
                                    handled = true
                                }
                                if !handled  && Set.contains<String>(set: mutParams, value: tk_text(toks, i: pa)) {
                                    has0309 = true
                                    List.push<DiagnosticSite>(list: mut out0309, value: rightSite)
                                }
                            }
                        }
                        b = b + 1
                    }
                    a = a + 1
                }
            }
        }
        k = k + 1
    }
    let mut result = 0
    if has0303 { result = result + 1 }
    if has0305 { result = result + 2 }
    if has0309 { result = result + 4 }
    if has0302 { result = result + 8 }
    if has0304 { result = result + 16 }
    return result
}

// `local` binding names of the body [bodyOpen,bodyClose).
fn collect_local_names(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "local") {
            let mut q = k + 1
            if is_kw_text(toks, i: q, word: "mut") { q = q + 1 }
            if is_ident_tok(toks: toks, i: q) {
                Set.insert<String>(set: mut out, value: tk_text(toks, i: q))
            }
        }
        k = k + 1
    }
    return Unit
}

// RS0601 FRESH_RETURN_NOT_CLEAN: a `-> fresh …` function that `return`s a value which is not a
// clean, freshly-owned value. Not clean: a `mut`/`take` param, a non-scalar `read` param, a
// `let` bound to a non-fresh call, a `local`/`let` that has been tainted (retained / captured in
// a closure / `manage`d / moved), a match-arm binding of a managed scrutinee, or a handle-field
// access. Clean: a fresh call, a constructor, a literal, an untainted fresh-sourced local/let.

// Whether this fn's return type contains `fresh` anywhere (covers `-> fresh T`,
// `-> Option<fresh T>`, `-> Result<fresh T, E>`) — broader than the direct-only `fn_returns_fresh`.
fn fn_return_type_has_fresh(toks: List<Tok>, ns: Int, sigEnd: Int) -> Bool {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: toks, i: tt, code: SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return false }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return false }
    let mut m = pclose + 1
    let mut found = false
    while m < sigEnd {
        if is_kw_text(toks, i: m, word: "fresh") { found = true }
        m = m + 1
    }
    return found
}

fn collect_fire_params(toks: List<Tok>, ns: Int, sigEnd: Int, out: mut Set<String>) -> Unit {
    let mut popen = 0 - 1
    let mut tt = ns
    while tt < sigEnd {
        if at_symbol(toks: toks, i: tt, code: SYM_LPAREN) {
            popen = tt
            tt = sigEnd
        } else {
            tt = tt + 1
        }
    }
    if popen < 0 { return Unit }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return Unit }
    let mut depth = 0
    let mut k = popen + 1
    while k < pclose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            let pname = tk_text(toks, i: k)
            let eff = tk_text(toks, i: (k + 2))
            if eff == "mut" || eff == "take" {
                Set.insert<String>(set: mut out, value: pname)
            } else if eff == "read" && is_scalar_name(name: tk_text(toks, i: (k + 3))) == false {
                Set.insert<String>(set: mut out, value: pname)
            }
        }
        k = k + 1
    }
    return Unit
}

// `let` names bound to a call of a file-DECLARED non-fresh function — a managed, non-fresh value
// (returning it from a `-> fresh` fn is not clean). A builtin call (`List.new()`), a constructor,
// or a fresh-fn call is NOT managed-non-fresh. Only `let` (a `local` is owned).
fn collect_managed_nonfresh_lets(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, freshFns: Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "let") {
            let mut nameIdx = k + 1
            if is_kw_text(toks, i: nameIdx, word: "mut") { nameIdx = nameIdx + 1 }
            if is_ident_tok(toks: toks, i: nameIdx) {
                let mut eqPos = 0 - 1
                let mut t = nameIdx + 1
                let mut scan = true
                while scan {
                    if t >= bodyClose {
                        scan = false
                    } else if at_symbol(toks: toks, i: t, code: SYM_LBRACE) || at_symbol(toks: toks, i: t, code: SYM_RBRACE) {
                        scan = false
                    } else if at_symbol(toks: toks, i: t, code: SYM_EQ) && at_symbol(toks: toks, i: (t + 1), code: SYM_EQ) == false {
                        eqPos = t
                        scan = false
                    } else {
                        t = t + 1
                    }
                }
                if eqPos > 0 {
                    let mut s = eqPos + 1
                    if is_effect_kw(toks, i: s) { s = s + 1 }
                    // A `let` bound to a CALL is managed-non-fresh unless the call is a fresh
                    // source: a bare constructor `Foo(...)`, a registered `-> fresh` fn, or a
                    // stdlib-type receiver (`List.new()`, whose builtin result is fresh). Any other
                    // call — including an unknown/user `Cache.get()` — yields a managed value.
                    let isCtor = is_ident_tok(toks: toks, i: s) && is_upper_head(name: tk_text(toks, i: s)) && at_symbol(toks: toks, i: (s + 1), code: SYM_LPAREN)
                    if is_ident_tok(toks: toks, i: s) && !isCtor  {
                        let de = dotted_end(toks, i: s)
                        if at_symbol(toks: toks, i: de, code: SYM_LPAREN) {
                            let dn = dotted_name_text(toks, i: s)
                            let recvStdlib = at_symbol(toks: toks, i: (s + 1), code: SYM_DOT) && is_stdlib_type(name: tk_text(toks, i: s))
                            if Set.contains<String>(set: freshFns, value: dn) == false && !recvStdlib  {
                                Set.insert<String>(set: mut out, value: tk_text(toks, i: nameIdx))
                            }
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return Unit
}

fn collect_tainted_bindings(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, retains: Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if (is_kw_text(toks, i: k, word: "manage") || is_kw_text(toks, i: k, word: "take")) && is_ident_tok(toks: toks, i: (k + 1)) {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: (k + 1)))
        }
        k = k + 1
    }
    k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LBRACE) && k > bodyOpen && at_symbol(toks: toks, i: (k - 1), code: SYM_PIPE) {
            // Only a STORED closure (`= |…| { }`) retains its captures; a `noescape` callback
            // argument does not. Find the closure's opening `|` and require `=` before it.
            let mut op = k - 2
            let mut findPipe = true
            while findPipe {
                if op <= bodyOpen {
                    findPipe = false
                } else if at_symbol(toks: toks, i: op, code: SYM_PIPE) {
                    findPipe = false
                } else {
                    op = op - 1
                }
            }
            let stored = op > bodyOpen && at_symbol(toks: toks, i: (op - 1), code: SYM_EQ)
            let cbClose = find_matching(toks: toks, open: k, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            if cbClose > 0 {
                if stored {
                    let mut m = k + 1
                    while m < cbClose {
                        if is_ident_tok(toks: toks, i: m) {
                            Set.insert<String>(set: mut out, value: tk_text(toks, i: m))
                        }
                        m = m + 1
                    }
                }
                k = cbClose
            }
        }
        k = k + 1
    }
    k = bodyOpen + 1
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (k - 1)) {
            let callee = tk_text(toks, i: (k - 1))
            let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close > 0 {
                let mut q = k + 1
                let mut depth = 0
                let mut atStart = true
                while q < close {
                    let opener = at_symbol(toks: toks, i: q, code: SYM_LPAREN) || at_symbol(toks: toks, i: q, code: SYM_LBRACKET) || at_symbol(toks: toks, i: q, code: SYM_LBRACE)
                    let closer = at_symbol(toks: toks, i: q, code: SYM_RPAREN) || at_symbol(toks: toks, i: q, code: SYM_RBRACKET) || at_symbol(toks: toks, i: q, code: SYM_RBRACE)
                    if opener {
                        depth = depth + 1
                        atStart = false
                    } else if closer {
                        if depth > 0 { depth = depth - 1 }
                        atStart = false
                    } else if depth == 0 && at_symbol(toks: toks, i: q, code: SYM_COMMA) {
                        atStart = true
                    } else if depth == 0 && atStart && is_ident_tok(toks: toks, i: q) && at_symbol(toks: toks, i: (q + 1), code: SYM_COLON) {
                        let label = tk_text(toks, i: q)
                        let key = String.concat(left: String.concat(left: callee, right: "|"), right: label)
                        let isR = Set.contains<String>(set: retains, value: key) || builtin_retains_label(toks, callPos: k, label)
                        if isR {
                            let mut v = q + 2
                            if is_effect_kw(toks, i: v) { v = v + 1 }
                            if is_ident_tok(toks: toks, i: v) {
                                Set.insert<String>(set: mut out, value: tk_text(toks, i: v))
                            }
                        }
                        atStart = false
                    } else {
                        atStart = false
                    }
                    q = q + 1
                }
            }
        }
        k = k + 1
    }
    return Unit
}

fn collect_managed_match_binds(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, managed: Set<String>, out: mut Set<String>) -> Unit {
    let mut k = bodyOpen + 1
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "match") && is_ident_tok(toks: toks, i: (k + 1)) && Set.contains<String>(set: managed, value: tk_text(toks, i: (k + 1))) {
            let mut b = k + 2
            let mut go = true
            while go {
                if b >= bodyClose {
                    go = false
                } else if at_symbol(toks: toks, i: b, code: SYM_LBRACE) {
                    go = false
                } else {
                    b = b + 1
                }
            }
            if b < bodyClose && at_symbol(toks: toks, i: b, code: SYM_LBRACE) {
                let mClose = find_matching(toks: toks, open: b, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if mClose > 0 {
                    collect_match_bindings(toks, bodyOpen: b, bodyClose: mClose, out: mut out)
                    k = mClose
                }
            }
        }
        k = k + 1
    }
    return Unit
}

// Registry of `noescape Fn()` params as `shortFn|param` composite keys.
fn collect_noescape_params(toks: List<Tok>, out: mut Set<String>) -> Unit {
    let n = List.len(list: toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks, i: k, word: "fn") {
            let mut p = k + 1
            let mut scan = true
            while scan {
                if p >= n {
                    scan = false
                } else if at_symbol(toks: toks, i: p, code: SYM_LPAREN) || is_kw_text(toks, i: p, word: "fn") || at_symbol(toks: toks, i: p, code: SYM_LBRACE) {
                    scan = false
                } else {
                    p = p + 1
                }
            }
            if p < n && at_symbol(toks: toks, i: p, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (p - 1)) {
                let shortName = tk_text(toks, i: (p - 1))
                let pclose = find_matching(toks: toks, open: p, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                if pclose > 0 {
                    let mut depth = 0
                    let mut q = p + 1
                    while q < pclose {
                        if at_symbol(toks: toks, i: q, code: SYM_LPAREN) || at_symbol(toks: toks, i: q, code: SYM_LBRACE) || at_symbol(toks: toks, i: q, code: SYM_LBRACKET) {
                            depth = depth + 1
                        } else if at_symbol(toks: toks, i: q, code: SYM_RPAREN) || at_symbol(toks: toks, i: q, code: SYM_RBRACE) || at_symbol(toks: toks, i: q, code: SYM_RBRACKET) {
                            depth = depth - 1
                        } else if depth == 0 && is_ident_tok(toks: toks, i: q) && at_symbol(toks: toks, i: (q + 1), code: SYM_COLON) && is_kw_text(toks, i: (q + 2), word: "noescape") {
                            let key = String.concat(left: String.concat(left: shortName, right: "|"), right: tk_text(toks, i: q))
                            Set.insert<String>(set: mut out, value: key)
                        }
                        q = q + 1
                    }
                }
                k = p
            } else {
                k = k + 1
            }
        } else {
            k = k + 1
        }
    }
    return Unit
}

// The opening `|` of a closure whose body `{` is at `cb` (cb-1 is the closing `|`).
fn find_closure_open_pipe(toks: List<Tok>, cb: Int, floor: Int) -> Int {
    let mut m = cb - 2
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m <= floor {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_PIPE) {
            result = m
            going = false
        } else {
            m = m - 1
        }
    }
    return result
}

// The `(` opening the nearest call whose argument list encloses `p`, or -1.
fn enclosing_paren_open(toks: List<Tok>, p: Int, floor: Int) -> Int {
    let mut m = p - 1
    let mut depth = 0
    let mut result = 0 - 1
    let mut going = true
    while going {
        if m <= floor {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_RPAREN) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: toks, i: m, code: SYM_LPAREN) {
            if depth == 0 {
                result = m
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// The `(` of the call whose argument directly holds the closure at `p`, seeing through variant
// wrappers `Some(`/`Ok(`/`Err(` (whose callee is an uppercase constructor, not the real callee).
fn closure_outer_call_open(toks: List<Tok>, p: Int, floor: Int) -> Int {
    let mut cur = p
    let mut result = 0 - 1
    let mut going = true
    while going {
        let pOpen = enclosing_paren_open(toks, p: cur, floor)
        if pOpen <= 0 {
            going = false
        } else if is_ident_tok(toks: toks, i: (pOpen - 1)) {
            let nm = tk_text(toks, i: (pOpen - 1))
            if nm == "Some" || nm == "Ok" || nm == "Err" {
                cur = pOpen
            } else {
                result = pOpen
                going = false
            }
        } else {
            going = false
        }
    }
    return result
}

// The label of the top-level argument of call `callOpen` that contains `target`, or "".
fn arg_label_at(toks: List<Tok>, callOpen: Int, target: Int) -> String {
    let callClose = find_matching(toks: toks, open: callOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if callClose < 0 { return "" }
    let mut depth = 0
    let mut segStart = callOpen + 1
    let mut q = callOpen + 1
    let mut result = ""
    while q < callClose {
        if at_symbol(toks: toks, i: q, code: SYM_LPAREN) || at_symbol(toks: toks, i: q, code: SYM_LBRACE) || at_symbol(toks: toks, i: q, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: q, code: SYM_RPAREN) || at_symbol(toks: toks, i: q, code: SYM_RBRACE) || at_symbol(toks: toks, i: q, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: q, code: SYM_COMMA) {
            if segStart <= target && target < q {
                if is_ident_tok(toks: toks, i: segStart) && at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) {
                    result = tk_text(toks, i: segStart)
                }
                q = callClose
            }
            segStart = q + 1
        }
        q = q + 1
    }
    if result == "" && segStart <= target && target < callClose {
        if is_ident_tok(toks: toks, i: segStart) && at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) {
            result = tk_text(toks, i: segStart)
        }
    }
    return result
}

// bit0 = RS0801 (managed/retained closure captures a local), bit1 = RS0804 (noescape closure
// consumes — take/manage — a captured local).
fn collect_fn_closure_capture_bad(
    toks: List<Tok>,
    start: Int,
    retains: Set<String>,
    noescape: Set<String>,
    out0801: mut List<Int>,
    out0804: mut List<Int>
) -> Int {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return 0 }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return 0 }
    let mut localNames = Set.new<String>()
    collect_local_names(toks, bodyOpen: sigEnd, bodyClose, out: mut localNames)
    let mut has0801 = false
    let mut has0804 = false
    let mut k = sigEnd + 1
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LBRACE) && k > sigEnd && at_symbol(toks: toks, i: (k - 1), code: SYM_PIPE) {
            let cbClose = find_matching(toks: toks, open: k, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            let op = find_closure_open_pipe(toks, cb: k, floor: sigEnd)
            if cbClose > 0 && op > 0 {
                let mut declInside = Set.new<String>()
                let mut pp = op + 1
                while pp < (k - 1) {
                    if is_ident_tok(toks: toks, i: pp) { Set.insert<String>(set: mut declInside, value: tk_text(toks, i: pp)) }
                    pp = pp + 1
                }
                collect_local_names(toks, bodyOpen: k, bodyClose: cbClose, out: mut declInside)
                let mut dl = k + 1
                while dl < cbClose {
                    if is_kw_text(toks, i: dl, word: "let") {
                        let mut nm = dl + 1
                        if is_kw_text(toks, i: nm, word: "mut") { nm = nm + 1 }
                        if is_ident_tok(toks: toks, i: nm) { Set.insert<String>(set: mut declInside, value: tk_text(toks, i: nm)) }
                    }
                    dl = dl + 1
                }
                let mut captured = Set.new<String>()
                let mut capturePositions = List<Int>.new()
                let mut anyCapture = false
                let mut m = k + 1
                while m < cbClose {
                    // Capturing a local's handle-field (`holder.image`) yields a managed value,
                    // not the local itself — only a bare local reference is a capture.
                    if is_ident_tok(toks: toks, i: m) && at_symbol(toks: toks, i: (m + 1), code: SYM_DOT) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) == false {
                        let nmv = tk_text(toks, i: m)
                        if Set.contains<String>(set: localNames, value: nmv) && Set.contains<String>(set: declInside, value: nmv) == false {
                            Set.insert<String>(set: mut captured, value: nmv)
                            List.push<Int>(list: mut capturePositions, value: m)
                            anyCapture = true
                        }
                    }
                    m = m + 1
                }
                let mut bpos = op - 1
                if is_effect_kw(toks, i: bpos) { bpos = bpos - 1 }
                if at_symbol(toks: toks, i: bpos, code: SYM_EQ) {
                    // stored: `let NAME = |…| {…}` — RS0801 only for a `let` (managed) closure
                    let mut kw = bpos - 2
                    if is_kw_text(toks, i: kw, word: "mut") { kw = kw - 1 }
                    if is_kw_text(toks, i: kw, word: "let") && anyCapture {
                        let mut cp = 0
                        while cp < List.len<Int>(list: capturePositions) {
                            List.push<Int>(list: mut out0801, value: List.get<Int>(list: capturePositions, index: cp))
                            cp = cp + 1
                        }
                        has0801 = true
                    }
                } else {
                    // call argument (possibly wrapped in `Some(…)`/`Ok(…)`)
                    let callOpen = closure_outer_call_open(toks, p: op, floor: sigEnd)
                    if callOpen > 0 && is_ident_tok(toks: toks, i: (callOpen - 1)) {
                        let callee = tk_text(toks, i: (callOpen - 1))
                        let label = arg_label_at(toks, callOpen, target: op)
                        if label != "" {
                            let key = String.concat(left: String.concat(left: callee, right: "|"), right: label)
                            if Set.contains<String>(set: retains, value: key) && anyCapture {
                                let mut cp2 = 0
                                while cp2 < List.len<Int>(list: capturePositions) {
                                    List.push<Int>(list: mut out0801, value: List.get<Int>(list: capturePositions, index: cp2))
                                    cp2 = cp2 + 1
                                }
                                has0801 = true
                            }
                            if Set.contains<String>(set: noescape, value: key) {
                                let mut c = k + 1
                                while c < cbClose {
                                    if (is_kw_text(toks, i: c, word: "manage") || is_kw_text(toks, i: c, word: "take")) && is_ident_tok(toks: toks, i: (c + 1)) && Set.contains<String>(set: captured, value: tk_text(toks, i: (c + 1))) {
                                        List.push<Int>(list: mut out0804, value: c)
                                        has0804 = true
                                    }
                                    c = c + 1
                                }
                            }
                        }
                    }
                }
                k = cbClose
            }
        }
        k = k + 1
    }
    let mut result = 0
    if has0801 { result = result + 1 }
    if has0804 { result = result + 2 }
    return result
}

// The container head immediately enclosing the type-arg at `pos` (ident before the opening `<` of
// the innermost generic clause containing `pos`), or "".
fn enclosing_generic_head(toks: List<Tok>, pos: Int) -> String {
    let mut m = pos - 1
    let mut depth = 0
    let mut result = ""
    let mut going = true
    while going {
        if m <= 0 {
            going = false
        } else if at_symbol(toks: toks, i: m, code: SYM_RANGLE) {
            depth = depth + 1
            m = m - 1
        } else if at_symbol(toks: toks, i: m, code: SYM_LANGLE) {
            if depth == 0 {
                if is_ident_tok(toks: toks, i: (m - 1)) { result = tk_text(toks, i: (m - 1)) }
                going = false
            } else {
                depth = depth - 1
                m = m - 1
            }
        } else {
            m = m - 1
        }
    }
    return result
}

// A resource-decl generic-param segment: returns true if UNBOUNDED (B1); records a Resource-bounded
// param name into `resParams`.
fn seg_generic_kind(toks: List<Tok>, segStart: Int, resParams: mut Set<String>) -> Bool {
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    let nm = tk_text(toks, i: segStart)
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false {
        return true
    }
    if tk_text(toks, i: (segStart + 2)) == "Resource" {
        Set.insert<String>(set: mut resParams, value: nm)
    }
    return false
}

// RS0704 sub-rule A: a file-declared resource used as a generic type argument.
// Result<Resource, E> at arg 0 in a return type remains valid.
fn collect_resource_generic_arg_tokens(toks: List<Tok>, resources: Set<String>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        if is_ident_tok(toks: toks, i: k) && Set.contains<String>(set: resources, value: tk_text(toks, i: k)) && k >= 1 && (at_symbol(toks: toks, i: (k - 1), code: SYM_LANGLE) || at_symbol(toks: toks, i: (k - 1), code: SYM_COMMA)) {
            let head = enclosing_generic_head(toks, pos: k)
            let mut skip = false
            if head == "Result" && at_symbol(toks: toks, i: (k - 1), code: SYM_LANGLE) {
                let mut bp = k - 3
                if is_kw_text(toks, i: bp, word: "fresh") { bp = bp - 1 }
                if at_symbol(toks: toks, i: bp, code: SYM_ARROW) { skip = true }
            }
            if !skip  {
                List.push<Int>(list: mut out, value: k)
                hit = true
            }
        }
        k = k + 1
    }
    return hit
}

// RS0704 sub-rules B1/B2: a `resource Name<params>` with an unbounded param (B1), or a
// Resource-bounded param used directly in a field type (B2).
fn collect_resource_decl_generic_bad_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        if is_kw_text(toks, i: k, word: "resource") && is_ident_tok(toks: toks, i: (k + 1)) && at_symbol(toks: toks, i: (k + 2), code: SYM_LANGLE) {
            let gOpen = k + 2
            let gClose = find_matching(toks: toks, open: gOpen, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
            if gClose > 0 {
                let mut resParams = Set.new<String>()
                let mut depth = 0
                let mut segStart = gOpen + 1
                let mut j = gOpen + 1
                while j < gClose {
                    if at_symbol(toks: toks, i: j, code: SYM_LANGLE) || at_symbol(toks: toks, i: j, code: SYM_LPAREN) {
                        depth = depth + 1
                    } else if at_symbol(toks: toks, i: j, code: SYM_RANGLE) || at_symbol(toks: toks, i: j, code: SYM_RPAREN) {
                        if depth > 0 { depth = depth - 1 }
                    } else if depth == 0 && at_symbol(toks: toks, i: j, code: SYM_COMMA) {
                        if seg_generic_kind(toks, segStart, resParams: mut resParams) {
                            List.push<Int>(list: mut out, value: segStart)
                            hit = true
                        }
                        segStart = j + 1
                    }
                    j = j + 1
                }
                if seg_generic_kind(toks, segStart, resParams: mut resParams) {
                    List.push<Int>(list: mut out, value: segStart)
                    hit = true
                }
                let mut bOpen = gClose + 1
                let mut findBody = true
                while findBody {
                    if bOpen >= n {
                        findBody = false
                    } else if at_symbol(toks: toks, i: bOpen, code: SYM_LBRACE) {
                        findBody = false
                    } else {
                        bOpen = bOpen + 1
                    }
                }
                if bOpen < n {
                    let bClose = find_matching(toks: toks, open: bOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    if bClose > 0 {
                        let mut f = bOpen + 1
                        while f < bClose {
                            if is_ident_tok(toks: toks, i: f) && Set.contains<String>(set: resParams, value: tk_text(toks, i: f)) && f >= 1 && (at_symbol(toks: toks, i: (f - 1), code: SYM_COLON) || at_symbol(toks: toks, i: (f - 1), code: SYM_LANGLE) || at_symbol(toks: toks, i: (f - 1), code: SYM_COMMA)) {
                                List.push<Int>(list: mut out, value: f)
                                hit = true
                            }
                            f = f + 1
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0704 whole-file predicate.
fn collect_resource_generic_bad_tokens(toks: List<Tok>, resources: Set<String>, out: mut List<Int>) -> Bool {
    return collect_resource_generic_arg_tokens(toks, resources, out: mut out)
}

// A declaration keyword sits at index i (start of a decl whose name+generics follow).
fn decl_kw_before(toks: List<Tok>, i: Int) -> Bool {
    return is_kw_text(toks, i, word: "fn") || is_kw_text(toks, i, word: "struct") || is_kw_text(toks, i, word: "class") || is_kw_text(toks, i, word: "resource") || is_kw_text(toks, i, word: "sum") || is_kw_text(toks, i, word: "protocol") || is_kw_text(toks, i, word: "impl")
}

// A generic-clause segment starting at `segStart` declares `name` with a non-Resource bound.
fn seg_is_nonresource_param(toks: List<Tok>, segStart: Int, name: String) -> Bool {
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if tk_text(toks, i: segStart) != name { return false }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) && tk_text(toks, i: (segStart + 2)) == "Resource" {
        return false
    }
    return true
}

// True if `name` is declared as a generic parameter (in some `fn/struct/class/resource/sum/
// protocol/impl` header `Name<…>`) whose bound is NOT exactly `Resource`.
fn nonresource_generic_param(toks: List<Tok>, name: String) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut found = false
    while k < n {
        if at_symbol(toks: toks, i: k, code: SYM_LANGLE) && k >= 2 && is_ident_tok(toks: toks, i: (k - 1)) && decl_kw_before(toks, i: (k - 2)) {
            let close = find_matching(toks: toks, open: k, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
            if close > 0 {
                let mut depth = 0
                let mut segStart = k + 1
                let mut j = k + 1
                while j < close {
                    if at_symbol(toks: toks, i: j, code: SYM_LANGLE) || at_symbol(toks: toks, i: j, code: SYM_LPAREN) {
                        depth = depth + 1
                    } else if at_symbol(toks: toks, i: j, code: SYM_RANGLE) || at_symbol(toks: toks, i: j, code: SYM_RPAREN) {
                        if depth > 0 { depth = depth - 1 }
                    } else if depth == 0 && at_symbol(toks: toks, i: j, code: SYM_COMMA) {
                        if seg_is_nonresource_param(toks, segStart, name) { found = true }
                        segStart = j + 1
                    }
                    j = j + 1
                }
                if seg_is_nonresource_param(toks, segStart, name) { found = true }
            }
        }
        k = k + 1
    }
    return found
}

// The aggregate access effect of `name` across an explicit closure body: "take" > "mut" > "read",
// or "" if `name` never appears as an external use.
fn capture_body_effect(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, name: String, params: Set<String>, inner: Set<String>) -> String {
    let mut eff = ""
    let mut m = bodyOpen + 1
    while m < bodyClose {
        if tk_kind(toks: toks, i: m) == TOK_IDENT && tk_text(toks, i: m) == name && at_symbol(toks: toks, i: (m - 1), code: SYM_DOT) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_LPAREN) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) == false && Set.contains<String>(set: params, value: name) == false && Set.contains<String>(set: inner, value: name) == false {
            let mut occ = "read"
            if is_kw_text(toks, i: (m - 1), word: "take") || is_kw_text(toks, i: (m - 1), word: "manage") {
                occ = "take"
            } else if at_symbol(toks: toks, i: (m + 1), code: SYM_EQ) && at_symbol(toks: toks, i: (m + 2), code: SYM_EQ) == false {
                occ = "mut"
            }
            if occ == "take" {
                eff = "take"
            } else if occ == "mut" && eff != "take" {
                eff = "mut"
            } else if eff == "" {
                eff = "read"
            }
        }
        m = m + 1
    }
    return eff
}

fn capture_effect_rank(effect: String) -> Int {
    if effect == "take" { return 3 }
    if effect == "mut" { return 2 }
    if effect == "read" { return 1 }
    return 0
}

fn declared_capture_effect(toks: List<Tok>, start: Int, close: Int, name: String) -> String {
    let mut i = start
    let mut result = ""
    while i < close {
        if is_effect_kw(toks, i) && is_ident_tok(toks: toks, i: (i + 1)) && tk_text(toks, i: (i + 1)) == name {
            result = tk_text(toks, i)
            i = close
        } else {
            i = i + 1
        }
    }
    return result
}

fn declared_capture_site(toks: List<Tok>, start: Int, close: Int, name: String) -> Int {
    let mut i = start
    let mut result = -1
    while i < close {
        if is_effect_kw(toks, i) && is_ident_tok(toks: toks, i: (i + 1)) && tk_text(toks, i: (i + 1)) == name {
            result = i
            i = close
        } else {
            i = i + 1
        }
    }
    return result
}

// True if the explicit closure at `cp` (the `captures` keyword) violates its capture contract:
// a used-but-undeclared external (Missing), a declared-but-unused capture (Unused), or a declared
// effect that differs from the body's use (Mismatch).
fn collect_one_capture_contract_bad_tokens(toks: List<Tok>, cp: Int, out: mut List<Int>) -> Bool {
    let pClose = cp - 1
    if at_symbol(toks: toks, i: pClose, code: SYM_RPAREN) == false { return false }
    let mut pOpen = 0 - 1
    let mut depth = 0
    let mut s = pClose - 1
    let mut findOpen = true
    while findOpen {
        if s <= 0 {
            findOpen = false
        } else if at_symbol(toks: toks, i: s, code: SYM_RPAREN) {
            depth = depth + 1
            s = s - 1
        } else if at_symbol(toks: toks, i: s, code: SYM_LPAREN) {
            if depth == 0 {
                pOpen = s
                findOpen = false
            } else {
                depth = depth - 1
                s = s - 1
            }
        } else {
            s = s - 1
        }
    }
    if pOpen <= 0 || is_kw_text(toks, i: (pOpen - 1), word: "fn") == false { return false }
    if at_symbol(toks: toks, i: (cp + 1), code: SYM_LPAREN) == false { return false }
    let capClose = find_matching(toks: toks, open: (cp + 1), openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if capClose < 0 { return false }
    let mut bOpen = 0 - 1
    let mut b = capClose + 1
    let mut findBody = true
    while findBody {
        if b >= List.len(list: toks) {
            findBody = false
        } else if at_symbol(toks: toks, i: b, code: SYM_LBRACE) {
            bOpen = b
            findBody = false
        } else {
            b = b + 1
        }
    }
    if bOpen <= 0 { return false }
    let bClose = find_matching(toks: toks, open: bOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bClose < 0 { return false }
    // param names: ident right after `(` or a comma
    let mut params = Set.new<String>()
    let mut pp = pOpen + 1
    while pp < pClose {
        if is_ident_tok(toks: toks, i: pp) && (pp == (pOpen + 1) || at_symbol(toks: toks, i: (pp - 1), code: SYM_COMMA)) {
            Set.insert<String>(set: mut params, value: tk_text(toks, i: pp))
        }
        pp = pp + 1
    }
    // inner-declared names (local/let inside the body)
    let mut inner = Set.new<String>()
    let mut di = bOpen + 1
    while di < bClose {
        if is_kw_text(toks, i: di, word: "let") || is_kw_text(toks, i: di, word: "local") {
            let mut nm = di + 1
            if is_kw_text(toks, i: nm, word: "mut") { nm = nm + 1 }
            if is_ident_tok(toks: toks, i: nm) { Set.insert<String>(set: mut inner, value: tk_text(toks, i: nm)) }
        }
        di = di + 1
    }
    // observed external uses (distinct); Missing/Mismatch fire here. Only plain identifiers
    // (TOK_IDENT) are captures — keywords (return/if/let/…) are is_ident_tok but not variables.
    let mut observedNames = Set.new<String>()
    let mut m = bOpen + 1
    let mut hit = false
    while m < bClose {
        if tk_kind(toks: toks, i: m) == TOK_IDENT {
            let nm = tk_text(toks, i: m)
            if is_upper_head(name: nm) == false && Set.contains<String>(set: params, value: nm) == false && Set.contains<String>(set: inner, value: nm) == false && Set.contains<String>(set: observedNames, value: nm) == false && at_symbol(toks: toks, i: (m - 1), code: SYM_DOT) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_LPAREN) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) == false {
                let eff = capture_body_effect(toks, bodyOpen: bOpen, bodyClose: bClose, name: nm, params, inner)
                if eff != "" {
                    Set.insert<String>(set: mut observedNames, value: nm)
                    let declaredEffect = declared_capture_effect(toks, start: (cp + 2), close: capClose, name: nm)
                    if declaredEffect == "" {
                        List.push<Int>(list: mut out, value: bOpen)
                        hit = true
                    } else if capture_effect_rank(effect: eff) > capture_effect_rank(effect: declaredEffect) {
                        let site = declared_capture_site(toks, start: (cp + 2), close: capClose, name: nm)
                        if site >= 0 {
                            List.push<Int>(list: mut out, value: site)
                            hit = true
                        }
                    }
                }
            }
        }
        m = m + 1
    }
    // Unused: a declared capture name never used in the body
    let mut c2 = cp + 2
    while c2 < capClose {
        if is_ident_tok(toks: toks, i: c2) && is_effect_kw(toks, i: c2) == false {
            let dn = tk_text(toks, i: c2)
            if Set.contains<String>(set: observedNames, value: dn) == false {
                let site = c2 - 1
                if is_effect_kw(toks, i: site) {
                    List.push<Int>(list: mut out, value: site)
                    hit = true
                }
            }
        }
        c2 = c2 + 1
    }
    return hit
}

// Any explicit closure in the file whose capture contract is violated (RS0805).
fn collect_capture_contract_bad_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        if is_kw_text(toks, i: k, word: "captures") && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) {
            if collect_one_capture_contract_bad_tokens(toks, cp: k, out: mut out) { hit = true }
        }
        k = k + 1
    }
    return hit
}

// Dotted names of fns whose return type root is a resource, or Result<Resource, E>.
fn collect_producer_fns(toks: List<Tok>, resources: Set<String>) -> Set<String> {
    let n = List.len(list: toks)
    let mut out = Set.new<String>()
    let mut k = 0
    while k < n {
        if is_kw_text(toks, i: k, word: "fn") && is_ident_tok(toks: toks, i: (k + 1)) {
            let ns = k + 1
            // find `->` at depth 0 (works for bodyless fn decls too — don't rely on the body `{`)
            let mut a = ns + 1
            let mut arrow = 0 - 1
            let mut d = 0
            let mut scanning = true
            while scanning {
                if a >= n {
                    scanning = false
                } else if at_symbol(toks: toks, i: a, code: SYM_LPAREN) || at_symbol(toks: toks, i: a, code: SYM_LBRACKET) || at_symbol(toks: toks, i: a, code: SYM_LANGLE) {
                    d = d + 1
                    a = a + 1
                } else if at_symbol(toks: toks, i: a, code: SYM_RPAREN) || at_symbol(toks: toks, i: a, code: SYM_RBRACKET) || at_symbol(toks: toks, i: a, code: SYM_RANGLE) {
                    if d > 0 { d = d - 1 }
                    a = a + 1
                } else if d == 0 && at_symbol(toks: toks, i: a, code: SYM_ARROW) {
                    arrow = a
                    scanning = false
                } else if d == 0 && (at_symbol(toks: toks, i: a, code: SYM_LBRACE) || is_kw_text(toks, i: a, word: "fn")) {
                    scanning = false
                } else {
                    a = a + 1
                }
            }
            if arrow > 0 {
                let mut r = arrow + 1
                if is_kw_text(toks, i: r, word: "fresh") { r = r + 1 }
                let root = tk_text(toks, i: r)
                let mut isProducer = false
                if Set.contains<String>(set: resources, value: root) {
                    isProducer = true
                } else if root == "Result" && at_symbol(toks: toks, i: (r + 1), code: SYM_LANGLE) && Set.contains<String>(set: resources, value: tk_text(toks, i: (r + 2))) {
                    isProducer = true
                }
                if isProducer {
                    Set.insert<String>(set: mut out, value: dotted_name_text(toks, i: ns))
                }
            }
            k = ns
        } else {
            k = k + 1
        }
    }
    return out
}

// M4: a resource producer (a producer-fn call or a resource constructor `R(`) that is not the
// resource expression of a `with` (its root ident is not immediately preceded by `with`), and is
// not the producer fn's own declaration (`fn R.open(...)`).
fn collect_producer_escape_tokens(toks: List<Tok>, resources: Set<String>, producerFns: Set<String>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        if is_ident_tok(toks: toks, i: k) && (is_kw_text(toks, i: (k - 1), word: "return") || at_symbol(toks: toks, i: (k - 1), code: SYM_EQ)) {
            // Only a producer that is directly returned or bound (`let x = producer`) escapes.
            // resource constructor `R(`
            let mut isProducer = false
            if Set.contains<String>(set: resources, value: tk_text(toks, i: k)) && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) {
                isProducer = true
            } else {
                // producer-fn call `A.b(` — match the dotted name against the registry
                let de = dotted_end(toks, i: k)
                if de > k && at_symbol(toks: toks, i: de, code: SYM_LPAREN) && Set.contains<String>(set: producerFns, value: dotted_name_text(toks, i: k)) {
                    isProducer = true
                }
            }
            if isProducer {
                List.push<Int>(list: mut out, value: k)
                hit = true
            }
        }
        k = k + 1
    }
    return hit
}

// The operand base of an escape after skipping read/mut/take, `?`, and Ok/Err/Some wrappers.
fn escape_operand_pos(toks: List<Tok>, pos: Int, name: String) -> Int {
    let mut p = pos
    let mut going = true
    while going {
        if is_effect_kw(toks, i: p) {
            p = p + 1
        } else if (tk_text(toks, i: p) == "Ok" || tk_text(toks, i: p) == "Err" || tk_text(toks, i: p) == "Some") && at_symbol(toks: toks, i: (p + 1), code: SYM_LPAREN) {
            p = p + 2
        } else {
            going = false
        }
    }
    if tk_text(toks, i: p) == name { return p }
    return 0 - 1
}

// M1: within a `with … as B { body }`, B escapes via return / plain `let` / manage / take-arg /
// retains-arg. (Closure captures are M2/M5.)
fn collect_with_binding_escape_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, name: String, retains: Set<String>, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "return") {
            let p = escape_operand_pos(toks, pos: (k + 1), name)
            if p >= 0 { List.push<Int>(list: mut out, value: p); hit = true }
        } else if is_kw_text(toks, i: k, word: "let") {
            // let [mut] x = <wrap> B
            let mut e = k + 1
            while e < bodyClose && at_symbol(toks: toks, i: e, code: SYM_EQ) == false && at_symbol(toks: toks, i: e, code: SYM_LBRACE) == false {
                e = e + 1
            }
            if e < bodyClose && at_symbol(toks: toks, i: e, code: SYM_EQ) {
                let p2 = escape_operand_pos(toks, pos: (e + 1), name)
                if p2 >= 0 { List.push<Int>(list: mut out, value: p2); hit = true }
            }
        } else if is_kw_text(toks, i: k, word: "manage") {
            if tk_text(toks, i: (k + 1)) == name { List.push<Int>(list: mut out, value: k); hit = true }
        } else if is_kw_text(toks, i: k, word: "take") && tk_text(toks, i: (k + 1)) == name && (at_symbol(toks: toks, i: (k + 2), code: SYM_RPAREN) || at_symbol(toks: toks, i: (k + 2), code: SYM_COMMA)) {
            List.push<Int>(list: mut out, value: k)
            hit = true
        } else if is_ident_tok(toks: toks, i: k) && tk_text(toks, i: k) == name && is_effect_kw(toks, i: (k - 1)) && at_symbol(toks: toks, i: (k - 2), code: SYM_COLON) {
            // retains-arg: `callee(… label: <effect> B …)` where callee|label declares retains(label)
            let label = tk_text(toks, i: (k - 3))
            let callOpen = enclosing_paren_open(toks, p: k, floor: bodyOpen)
            if callOpen > 0 && is_ident_tok(toks: toks, i: (callOpen - 1)) {
                let key = String.concat(left: String.concat(left: tk_text(toks, i: (callOpen - 1)), right: "|"), right: label)
                if Set.contains<String>(set: retains, value: key) { List.push<Int>(list: mut out, value: k); hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// Within a `with … as B { body }`, reject a stored closure that captures B.
fn collect_with_binding_closure_capture_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, name: String, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        // closure body `{` preceded by a `|`
        if at_symbol(toks: toks, i: k, code: SYM_LBRACE) && at_symbol(toks: toks, i: (k - 1), code: SYM_PIPE) {
            let cbClose = find_matching(toks: toks, open: k, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            let op = find_closure_open_pipe(toks, cb: k, floor: bodyOpen)
            if cbClose > 0 && op > 0 {
                // does the body reference B (bare)?
                let mut refsB = false
                let mut m = k + 1
                while m < cbClose {
                    if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == name && at_symbol(toks: toks, i: (m - 1), code: SYM_DOT) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) == false {
                        refsB = true
                    }
                    m = m + 1
                }
                if refsB {
                    // A stored `let` closure can outlive the resource scope.
                    let mut bpos = op - 1
                    if is_effect_kw(toks, i: bpos) { bpos = bpos - 1 }
                    // see through a `Some(`/`Ok(`/`Err(` wrapper around the closure
                    if at_symbol(toks: toks, i: bpos, code: SYM_LPAREN) && is_ident_tok(toks: toks, i: (bpos - 1)) && (tk_text(toks, i: (bpos - 1)) == "Some" || tk_text(toks, i: (bpos - 1)) == "Ok" || tk_text(toks, i: (bpos - 1)) == "Err") {
                        bpos = bpos - 2
                        if is_effect_kw(toks, i: bpos) { bpos = bpos - 1 }
                    }
                    if at_symbol(toks: toks, i: bpos, code: SYM_EQ) {
                        let mut kw = bpos - 2
                        if is_kw_text(toks, i: kw, word: "mut") { kw = kw - 1 }
                        if is_kw_text(toks, i: kw, word: "let") { List.push<Int>(list: mut out, value: op); hit = true }
                    }
                }
            }
            k = cbClose
        }
        k = k + 1
    }
    return hit
}

// RS0702 whole-file predicate combining all five paths.
fn collect_resource_escape_tokens(toks: List<Tok>, resources: Set<String>, retains: Set<String>, out: mut List<Int>) -> Bool {
    let mut hit = false
    let producerFns = collect_producer_fns(toks, resources)
    if collect_producer_escape_tokens(toks, resources, producerFns, out: mut out) { hit = true }
    // M1/M2/M5: iterate `with EXPR as B { body }`
    let n = List.len(list: toks)
    let mut k = 0
    while k < n {
        if is_kw_text(toks, i: k, word: "with") {
            // find `as B {` — the binding name follows `as`, the body `{` follows the name
            let mut a = k + 1
            let mut asPos = 0 - 1
            while a < n {
                if is_kw_text(toks, i: a, word: "as") {
                    asPos = a
                    a = n
                } else if at_symbol(toks: toks, i: a, code: SYM_LBRACE) {
                    a = n
                } else {
                    a = a + 1
                }
            }
            if asPos > 0 && is_ident_tok(toks: toks, i: (asPos + 1)) && at_symbol(toks: toks, i: (asPos + 2), code: SYM_LBRACE) {
                let name = tk_text(toks, i: (asPos + 1))
                let bodyOpen = asPos + 2
                let bodyClose = find_matching(toks: toks, open: bodyOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if bodyClose > 0 {
                    if collect_with_binding_escape_tokens(toks, bodyOpen, bodyClose, name, retains, out: mut out) { hit = true }
                    if collect_with_binding_closure_capture_tokens(toks, bodyOpen, bodyClose, name, out: mut out) { hit = true }
                }
            }
        } else if is_kw_text(toks, i: k, word: "view") && is_ident_tok(toks: toks, i: (k + 1)) && at_symbol(toks: toks, i: (k + 2), code: SYM_EQ) {
            // `view NAME = EXPR` desugars to a with-lease scoped to the rest of the enclosing block
            let name = tk_text(toks, i: (k + 1))
            let mut depth = 0
            let mut e = k + 3
            let mut ec = 0 - 1
            while e < n {
                if at_symbol(toks: toks, i: e, code: SYM_LBRACE) {
                    depth = depth + 1
                    e = e + 1
                } else if at_symbol(toks: toks, i: e, code: SYM_RBRACE) {
                    if depth == 0 {
                        ec = e
                        e = n
                    } else {
                        depth = depth - 1
                        e = e + 1
                    }
                } else {
                    e = e + 1
                }
            }
            if ec > 0 {
                if collect_with_binding_escape_tokens(toks, bodyOpen: (k + 2), bodyClose: ec, name, retains, out: mut out) { hit = true }
                if collect_with_binding_closure_capture_tokens(toks, bodyOpen: (k + 2), bodyClose: ec, name, out: mut out) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

fn is_copy_scalar_name(name: String) -> Bool {
    return name == "Bool" || name == "Byte" || name == "Char" || name == "Float" || name == "Float32" || name == "Float64" || name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Unit"
}

// Is the payload type in token range [lo, hi) transferable? Bare enclosing fn
// type params are unresolved here, so mirror Rust and leave them for a future
// Sendable-style bound instead of false-positiveing.
fn channel_payload_transferable(toks: List<Tok>, lo: Int, hi: Int, generics: Set<String>) -> Bool {
    // any nested generic (`<`) ⇒ not Copy, not String/Bytes ⇒ non-transferable
    let mut i = lo
    while i < hi {
        if at_symbol(toks: toks, i: i, code: SYM_LANGLE) { return false }
        i = i + 1
    }
    // strip a leading `fresh`
    let mut s = lo
    if is_kw_text(toks, i: s, word: "fresh") { s = s + 1 }
    if s == hi - 1 {
        let t = tk_text(toks, i: s)
        if Set.contains<String>(set: generics, value: t) { return true }
        return is_copy_scalar_name(name: t) || t == "String" || t == "Bytes"
    }
    return false
}

// RS0036 inside [start,end): any `Channel.message<T>` whose payload `T` is not transferable.
fn collect_region_nontransferable_channel_tokens(
    toks: List<Tok>,
    start: Int,
    end: Int,
    generics: Set<String>,
    out: mut List<Int>
) -> Bool {
    let mut k = start
    let mut hit = false
    while k < end {
        if tk_text(toks, i: k) == "Channel" && at_symbol(toks: toks, i: (k + 1), code: SYM_DOT) && tk_text(toks, i: (k + 2)) == "message" && at_symbol(toks: toks, i: (k + 3), code: SYM_LANGLE) {
            let open = k + 3
            let mut depth = 0
            let mut j = open
            let mut close = 0 - 1
            while j < end && close < 0 {
                if at_symbol(toks: toks, i: j, code: SYM_LANGLE) {
                    depth = depth + 1
                } else if at_symbol(toks: toks, i: j, code: SYM_RANGLE) {
                    depth = depth - 1
                    if depth == 0 { close = j }
                }
                j = j + 1
            }
            if close > open + 1 {
                if channel_payload_transferable(toks, lo: (open + 1), hi: close, generics) == false {
                    List.push<Int>(list: mut out, value: k)
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0036: whole-file wrapper. Walk function bodies so bare function generics can
// be skipped exactly like the Rust analyzer.
fn collect_nontransferable_channel_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        let isPub = at_ident(toks: toks, i: k, wid: WORD_PUB)
        if starts_fn_like(toks: toks, i: k, isPub: isPub) {
            let ns = fn_name_start(toks, i: k)
            let nameEnd = dotted_end(toks, i: ns)
            let generics = collect_generics(toks, nameEnd)
            let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
            if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) {
                let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if bodyClose > 0 {
                    if collect_region_nontransferable_channel_tokens(
                        toks,
                        start: sigEnd,
                        end: bodyClose,
                        generics,
                        out: mut out
                    ) { hit = true }
                    k = bodyClose
                }
            }
        }
        k = k + 1
    }
    return hit
}

// Dotted names of fns whose return type is `Result<Resource, E>` (or `Result<fresh Resource, E>`) —
// i.e. FALLIBLE resource producers. Mirrors collect_producer_fns but only the Result<Resource> case.
fn collect_fallible_producers(toks: List<Tok>, resources: Set<String>) -> Set<String> {
    let n = List.len(list: toks)
    let mut out = Set.new<String>()
    let mut k = 0
    while k < n {
        if is_kw_text(toks, i: k, word: "fn") {
            let ns = k + 1
            // find `->` at depth 0 (handles bodyless decls)
            let mut a = ns + 1
            let mut arrow = 0 - 1
            let mut d = 0
            let mut scanning = true
            while scanning {
                if a >= n {
                    scanning = false
                } else if at_symbol(toks: toks, i: a, code: SYM_LPAREN) || at_symbol(toks: toks, i: a, code: SYM_LBRACKET) || at_symbol(toks: toks, i: a, code: SYM_LANGLE) {
                    d = d + 1
                    a = a + 1
                } else if at_symbol(toks: toks, i: a, code: SYM_RPAREN) || at_symbol(toks: toks, i: a, code: SYM_RBRACKET) || at_symbol(toks: toks, i: a, code: SYM_RANGLE) {
                    if d > 0 { d = d - 1 }
                    a = a + 1
                } else if d == 0 && at_symbol(toks: toks, i: a, code: SYM_ARROW) {
                    arrow = a
                    scanning = false
                } else if d == 0 && (at_symbol(toks: toks, i: a, code: SYM_LBRACE) || is_kw_text(toks, i: a, word: "fn")) {
                    scanning = false
                } else {
                    a = a + 1
                }
            }
            if arrow > 0 {
                let r = arrow + 1
                if tk_text(toks, i: r) == "Result" && at_symbol(toks: toks, i: (r + 1), code: SYM_LANGLE) {
                    // inner type root (skip a leading `fresh`)
                    let mut inner = r + 2
                    if is_kw_text(toks, i: inner, word: "fresh") { inner = inner + 1 }
                    if Set.contains<String>(set: resources, value: tk_text(toks, i: inner)) {
                        Set.insert<String>(set: mut out, value: dotted_name_text(toks, i: ns))
                    }
                }
            }
        }
        k = k + 1
    }
    return out
}

// RS0706: `with <fallible-producer call> as B` with no `?` before `as` (the Result is not unwrapped).
fn collect_missing_try_producer_tokens(toks: List<Tok>, fallible: Set<String>, out: mut List<Int>) -> Bool {
    let n = List.len(list: toks)
    let mut k = 0
    let mut hit = false
    while k < n {
        if is_kw_text(toks, i: k, word: "with") && is_ident_tok(toks: toks, i: (k + 1)) {
            let de = dotted_end(toks, i: (k + 1))
            if de > k + 1 && at_symbol(toks: toks, i: de, code: SYM_LPAREN) && Set.contains<String>(set: fallible, value: dotted_name_text(toks, i: (k + 1))) {
                // scan from the call's close-paren to the `as`: fire if there is no `?`
                let close = find_matching(toks: toks, open: de, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                if close > 0 {
                    let mut hasTry = false
                    let mut m = close + 1
                    while m < n && is_kw_text(toks, i: m, word: "as") == false {
                        if at_symbol(toks: toks, i: m, code: SYM_QUESTION) { hasTry = true }
                        m = m + 1
                    }
                    if !hasTry  {
                        List.push<Int>(list: mut out, value: (k + 1))
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// `name` escapes as an ordinary value: return name / let y = name / pass to a non-noescape param.
fn collect_value_escape_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, name: String, noescape: Set<String>, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "return") {
            let mut p = k + 1
            if is_effect_kw(toks, i: p) { p = p + 1 }
            // `return name` escapes; `return name()` (a direct call) does not
            if tk_text(toks, i: p) == name && at_symbol(toks: toks, i: (p + 1), code: SYM_LPAREN) == false && at_symbol(toks: toks, i: (p + 1), code: SYM_DOT) == false {
                List.push<Int>(list: mut out, value: p)
                hit = true
            }
        } else if is_kw_text(toks, i: k, word: "let") {
            let mut e = k + 1
            while e < bodyClose && at_symbol(toks: toks, i: e, code: SYM_EQ) == false && at_symbol(toks: toks, i: e, code: SYM_LBRACE) == false {
                e = e + 1
            }
            if e < bodyClose && at_symbol(toks: toks, i: e, code: SYM_EQ) {
                let mut r = e + 1
                if is_effect_kw(toks, i: r) { r = r + 1 }
                if tk_text(toks, i: r) == name && at_symbol(toks: toks, i: (r + 1), code: SYM_LPAREN) == false && at_symbol(toks: toks, i: (r + 1), code: SYM_DOT) == false {
                    List.push<Int>(list: mut out, value: r)
                    hit = true
                }
            }
        } else if is_ident_tok(toks: toks, i: k) && tk_text(toks, i: k) == name && is_effect_kw(toks, i: (k - 1)) && at_symbol(toks: toks, i: (k - 2), code: SYM_COLON) && at_symbol(toks: toks, i: (k + 1), code: SYM_LPAREN) == false {
            // pass as arg `callee(label: <effect> name)` — escapes unless the target is noescape
            let label = tk_text(toks, i: (k - 3))
            let callOpen = enclosing_paren_open(toks, p: k, floor: bodyOpen)
            if callOpen > 0 && is_ident_tok(toks: toks, i: (callOpen - 1)) {
                let key = String.concat(left: String.concat(left: tk_text(toks, i: (callOpen - 1)), right: "|"), right: label)
                if Set.contains<String>(set: noescape, value: key) == false {
                    List.push<Int>(list: mut out, value: k)
                    // The production checker reports both ordinary-value use and
                    // non-noescape parameter forwarding at this same span.
                    List.push<Int>(list: mut out, value: k)
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// A stored `let X = |…| { … name … }` closure captures `name` (RS0802 stored-closure escape).
fn collect_stored_closure_capture_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, name: String, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LBRACE) && at_symbol(toks: toks, i: (k - 1), code: SYM_PIPE) {
            let cbClose = find_matching(toks: toks, open: k, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            let op = find_closure_open_pipe(toks, cb: k, floor: bodyOpen)
            if cbClose > 0 && op > 0 {
                // stored: opening pipe preceded (skip effect) by `=` and a `let`
                let mut bpos = op - 1
                if is_effect_kw(toks, i: bpos) { bpos = bpos - 1 }
                let mut stored = false
                if at_symbol(toks: toks, i: bpos, code: SYM_EQ) {
                    let mut kw = bpos - 2
                    if is_kw_text(toks, i: kw, word: "mut") { kw = kw - 1 }
                    if is_kw_text(toks, i: kw, word: "let") { stored = true }
                }
                if stored {
                    let mut m = k + 1
                    while m < cbClose {
                        if is_ident_tok(toks: toks, i: m) && tk_text(toks, i: m) == name && at_symbol(toks: toks, i: (m - 1), code: SYM_DOT) == false && at_symbol(toks: toks, i: (m + 1), code: SYM_COLON) == false {
                            List.push<Int>(list: mut out, value: m)
                            hit = true
                        }
                        m = m + 1
                    }
                }
            }
            k = cbClose
        }
        k = k + 1
    }
    return hit
}

// RS0802: a `noescape Fn()` parameter that is retained by its own fn (signature variant) or escapes
// in the body (return / let-store / pass-ordinary / stored-closure capture).
fn collect_fn_noescape_escape_tokens(toks: List<Tok>, start: Int, noescape: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let mut hit = false
    // signature-retains variant: a noescape param `p` with `retains(p)` in the same signature
    let mut q = ns
    while q < sigEnd {
        if is_ident_tok(toks: toks, i: q) && at_symbol(toks: toks, i: (q + 1), code: SYM_COLON) && is_kw_text(toks, i: (q + 2), word: "noescape") {
            let pname = tk_text(toks, i: q)
            let mut rr = ns
            while rr < sigEnd {
                if is_kw_text(toks, i: rr, word: "retains") && at_symbol(toks: toks, i: (rr + 1), code: SYM_LPAREN) && tk_text(toks, i: (rr + 2)) == pname {
                    List.push<Int>(list: mut out, value: start)
                    hit = true
                }
                rr = rr + 1
            }
        }
        q = q + 1
    }
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return hit }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return hit }
    // escape variant: any noescape param escaping in the body
    let mut pit = ns
    while pit < sigEnd {
        if is_ident_tok(toks: toks, i: pit) && at_symbol(toks: toks, i: (pit + 1), code: SYM_COLON) && is_kw_text(toks, i: (pit + 2), word: "noescape") {
            let pname = tk_text(toks, i: pit)
            if collect_value_escape_tokens(toks, bodyOpen: sigEnd, bodyClose, name: pname, noescape, out: mut out) { hit = true }
            if collect_stored_closure_capture_tokens(toks, bodyOpen: sigEnd, bodyClose, name: pname, out: mut out) { hit = true }
        }
        pit = pit + 1
    }
    return hit
}

// RS0803: a `local`-bound closure that escapes (return / let-store / pass-ordinary).
fn collect_fn_local_closure_escape_tokens(toks: List<Tok>, start: Int, noescape: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        // `local X = |` — a local closure binding
        if is_kw_text(toks, i: k, word: "local") && is_ident_tok(toks: toks, i: (k + 1)) && at_symbol(toks: toks, i: (k + 2), code: SYM_EQ) && at_symbol(toks: toks, i: (k + 3), code: SYM_PIPE) {
            let cname = tk_text(toks, i: (k + 1))
            if collect_value_escape_tokens(toks, bodyOpen: sigEnd, bodyClose, name: cname, noescape, out: mut out) { hit = true }
        }
        k = k + 1
    }
    return hit
}

fn collect_fn_fresh_return_bad_sites(source: String, toks: List<Tok>, start: Int, handleFields: Set<String>, retains: Set<String>, freshFns: Set<String>, out: mut List<DiagnosticSite>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    if fn_return_type_has_fresh(toks, ns, sigEnd) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let managed = collect_managed_names(toks, bodyOpen: sigEnd, bodyClose)
    let mut fireParams = Set.new<String>()
    collect_fire_params(toks, ns, sigEnd, out: mut fireParams)
    let mut nonFreshLets = Set.new<String>()
    collect_managed_nonfresh_lets(toks, bodyOpen: sigEnd, bodyClose, freshFns, out: mut nonFreshLets)
    let mut tainted = Set.new<String>()
    collect_tainted_bindings(toks, bodyOpen: sigEnd, bodyClose, retains, out: mut tainted)
    let mut matchBinds = Set.new<String>()
    collect_managed_match_binds(toks, bodyOpen: sigEnd, bodyClose, managed, out: mut matchBinds)
    let mut localNames = Set.new<String>()
    collect_local_names(toks, bodyOpen: sigEnd, bodyClose, out: mut localNames)
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "return") {
            let mut v = k + 1
            if is_effect_kw(toks, i: v) { v = v + 1 }
            let exprStart = v
            let mut unwrap = true
            while unwrap {
                if is_ident_tok(toks: toks, i: v) && (tk_text(toks, i: v) == "Some" || tk_text(toks, i: v) == "Ok") && at_symbol(toks: toks, i: (v + 1), code: SYM_LPAREN) {
                    v = v + 2
                    if is_ident_tok(toks: toks, i: v) && at_symbol(toks: toks, i: (v + 1), code: SYM_COLON) { v = v + 2 }
                    if is_effect_kw(toks, i: v) { v = v + 1 }
                } else {
                    unwrap = false
                }
            }
            if is_ident_tok(toks: toks, i: v) {
                let base = tk_text(toks, i: v)
                let nextDot = at_symbol(toks: toks, i: (v + 1), code: SYM_DOT)
                let nextParen = at_symbol(toks: toks, i: (v + 1), code: SYM_LPAREN)
                let mut issue = false
                if nextDot {
                    // a handle-field access `x.f` (not a method call) is not clean
                    if is_ident_tok(toks: toks, i: (v + 2)) && at_symbol(toks: toks, i: (v + 3), code: SYM_LPAREN) == false && Set.contains<String>(set: handleFields, value: tk_text(toks, i: (v + 2))) { issue = true }
                } else if !nextParen  {
                    if Set.contains<String>(set: fireParams, value: base) {
                        issue = true
                    } else if Set.contains<String>(set: matchBinds, value: base) {
                        issue = true
                    } else if Set.contains<String>(set: nonFreshLets, value: base) {
                        issue = true
                    } else if (Set.contains<String>(set: localNames, value: base) || Set.contains<String>(set: managed, value: base)) && Set.contains<String>(set: tainted, value: base) {
                        issue = true
                    }
                }
                if issue {
                    // Production anchors this diagnostic at the return proof's
                    // root identifier, not the entire wrapper or field path.
                    List.push<DiagnosticSite>(list: mut out, value: token_range_diagnostic_site(source, toks, start: exprStart, endInclusive: exprStart))
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0205: a call that repeats a named argument, e.g. `f(x: 1, x: 2)` (oracle
// checks/calls.rs). We detect the syntactic case — the same explicit `name:` label
// twice in one call's arg list. An arg label is an `IDENT:` that sits at an argument
// START: right after the call's `(` or after a depth-0 `,`. That anchoring excludes
// struct-field colons (`{x: 1}` — inside `{}`, depth>0), nested-call labels, and
// typed closure params. Positional duplicates (same param filled twice without a
// label) need callee resolution and are left as a safe false-negative.
fn collect_call_dup_arg_tokens(toks: List<Tok>, open: Int, close: Int, out: mut List<Int>) -> Bool {
    let mut seen = Set<String>.new()
    let mut dup = false
    let mut depth = 0
    let mut atArgStart = true
    let mut k = open + 1
    while k < close {
        if depth == 0 && atArgStart && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            let label = tk_text(toks, i: k)
            if Set.contains<String>(set: seen, value: label) {
                List.push<Int>(list: mut out, value: k)
                dup = true
            } else {
                Set.insert<String>(set: mut seen, value: label)
            }
        }
        atArgStart = false
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            atArgStart = true
        }
        k = k + 1
    }
    return dup
}

// RS0205 over one fn body: any `(...)` whose arg list repeats a label. Runs on every
// paren (grouping parens carry no labels, so this is safe); cost is O(tokens * depth),
// fine for the shallow call nesting in real code.
fn collect_fn_dup_arg_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close >= 0 {
                if collect_call_dup_arg_tokens(toks, open: k, close, out: mut out) { hit = true }
            }
        }
        k = k + 1
    }
    return hit
}

// `name : share` — ident, `:`, then `share` as the type's first token.
fn seg_is_share(toks: List<Tok>, segStart: Int, segEnd: Int) -> Bool {
    if (segStart + 2) >= segEnd { return false }
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false { return false }
    return tk_text(toks, i: (segStart + 2)) == "share"
}

// The 17 Copy scalar type names (crate scalar/primitive set).
fn is_scalar_name(name: String) -> Bool {
    return name == "Bool" || name == "Byte" || name == "Char" || name == "Float" || name == "Float32" || name == "Float64" || name == "Int" || name == "Int8" || name == "Int16" || name == "Int32" || name == "Int64" || name == "UInt" || name == "UInt8" || name == "UInt16" || name == "UInt32" || name == "UInt64" || name == "Unit"
}

// Copy classification of a param type region for RS0007. The type begins after
// `name :` and an optional data-effect; then optional prefixes precede the base.
// Copy iff (no fresh/noescape prefix) AND base ∈ scalars AND next token is not `<`.
fn seg_type_is_copy(toks: List<Tok>, segStart: Int, segEnd: Int) -> Bool {
    let mut k = segStart + 2
    if is_effect_kw(toks, i: k) { k = k + 1 }
    let mut sawFreshNoescape = false
    let mut scanning = true
    while scanning {
        let t = tk_text(toks, i: k)
        if t == "fresh" || t == "noescape" {
            sawFreshNoescape = true
            k = k + 1
        } else if t == "owned" || t == "handle" || t == "weak" {
            k = k + 1
        } else {
            scanning = false
        }
    }
    if sawFreshNoescape { return false }
    let base = tk_text(toks, i: k)
    if is_scalar_name(name: base) == false { return false }
    if at_symbol(toks: toks, i: (k + 1), code: SYM_LANGLE) { return false }
    return true
}

// Status of a named param for RS0007: -1 = this segment is not param `pname`,
// 2 = matched and Copy, 1 = matched and non-Copy.
fn one_param_status(toks: List<Tok>, segStart: Int, segEnd: Int, pname: String) -> Int {
    if segStart >= segEnd { return -1 }
    if is_ident_tok(toks: toks, i: segStart) == false { return -1 }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false { return -1 }
    if tk_text(toks, i: segStart) != pname { return -1 }
    if seg_type_is_copy(toks, segStart, segEnd) { return 2 }
    return 1
}

// Walk the param list [open,close] looking for param `pname`. Returns 0 (not a
// param), 1 (param, non-Copy), or 2 (param, Copy).
fn param_retains_status(toks: List<Tok>, open: Int, close: Int, pname: String) -> Int {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut status = 0
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            let s = one_param_status(toks, segStart, segEnd: k, pname)
            if s != -1 { status = s }
            segStart = k + 1
        }
        k = k + 1
    }
    let s = one_param_status(toks, segStart, segEnd: close, pname)
    if s != -1 { status = s }
    return status
}

fn param_retains_token(toks: List<Tok>, open: Int, close: Int, pname: String) -> Int {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if one_param_status(toks, segStart, segEnd: k, pname) != -1 { return segStart }
            segStart = k + 1
        }
        k = k + 1
    }
    if one_param_status(toks, segStart, segEnd: close, pname) != -1 { return segStart }
    return -1
}

// One effects-clause item [segStart,segEnd): a `retains(p)` where p is not a
// param, or is a Copy param → RS0007.
fn retains_item_bad(toks: List<Tok>, segStart: Int, segEnd: Int, popen: Int, pclose: Int) -> Bool {
    if effect_item_kind(toks, segStart, segEnd) != 2 { return false }
    let pname = tk_text(toks, i: (segStart + 2))
    let status = param_retains_status(toks, open: popen, close: pclose, pname)
    return status == 0 || status == 2
}

// RS0007: an `effects(retains(p))` item whose p is not a param, or is a Copy param.
fn collect_bad_retains_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    let effOpen = find_effects_open(toks, start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: toks, open: effOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if effClose < 0 { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let popen = find_param_open(toks, from: ns, end: sigEnd)
    if popen < 0 { return false }
    let pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if pclose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if retains_item_bad(toks, segStart, segEnd: k, popen, pclose) {
                hit = true
                let pname = tk_text(toks, i: (segStart + 2))
                let paramToken = param_retains_token(toks, open: popen, close: pclose, pname)
                if paramToken >= 0 { List.push<Int>(list: mut out, value: paramToken) } else { List.push<Int>(list: mut out, value: start) }
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if retains_item_bad(toks, segStart, segEnd: effClose, popen, pclose) {
        hit = true
        let pname = tk_text(toks, i: (segStart + 2))
        let paramToken = param_retains_token(toks, open: popen, close: pclose, pname)
        if paramToken >= 0 { List.push<Int>(list: mut out, value: paramToken) } else { List.push<Int>(list: mut out, value: start) }
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0009 INVALID_PURE_EFFECT.
// ---------------------------------------------------------------------------

// Index of the base type token after skipping data effects, `&`, and the
// fresh/noescape/owned/handle/weak prefixes, bounded by e.
fn skip_type_prefixes(toks: List<Tok>, s: Int, e: Int) -> Int {
    let mut p = s
    let mut going = true
    while going {
        let t = tk_text(toks, i: p)
        if p < e && (t == "fresh" || t == "noescape" || t == "owned" || t == "handle" || t == "weak" || t == "&" || t == "read" || t == "mut" || t == "take") {
            p = p + 1
        } else {
            going = false
        }
    }
    return p
}

// One effects-clause item is the bare `pure` effect.
fn item_is_pure(toks: List<Tok>, segStart: Int, segEnd: Int) -> Bool {
    if effect_item_kind(toks, segStart, segEnd) != 1 { return false }
    return tk_text(toks, i: segStart) == "pure"
}

// True if the fn declares `effects(pure)` (a bare `pure` item).
fn fn_is_pure(toks: List<Tok>, start: Int) -> Bool {
    let effOpen = find_effects_open(toks, start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: toks, open: effOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut pure = false
    while k < effClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if item_is_pure(toks, segStart, segEnd: k) { pure = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if item_is_pure(toks, segStart, segEnd: effClose) { pure = true }
    return pure
}

// True if the fn has a `retains(...)` effect item.
fn collect_fn_pure_retains_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    let effOpen = find_effects_open(toks, start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: toks, open: effOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if effect_item_kind(toks, segStart, segEnd: k) == 2 {
                List.push<Int>(list: mut out, value: start)
                hit = true
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_item_kind(toks, segStart, segEnd: effClose) == 2 {
        List.push<Int>(list: mut out, value: start)
        hit = true
    }
    return hit
}

// True if any param uses the `mut` or `take` data effect.
fn collect_fn_pure_mut_take_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let open = find_param_open(toks, from: ns, end: sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if seg_is_mut_take(toks, segStart, segEnd: k) {
                List.push<Int>(list: mut out, value: segStart)
                hit = true
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_is_mut_take(toks, segStart, segEnd: close) {
        List.push<Int>(list: mut out, value: segStart)
        hit = true
    }
    return hit
}

// `name : mut|take …`
fn seg_is_mut_take(toks: List<Tok>, segStart: Int, segEnd: Int) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false { return false }
    let e = tk_text(toks, i: (segStart + 2))
    return e == "mut" || e == "take"
}

// True if a resource-typed value is returned. Mirrors resource_return_type_name:
// for Result/Option the first type arg is the target, else the return itself.
fn collect_fn_pure_resource_return_token(toks: List<Tok>, start: Int, resources: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let open = find_param_open(toks, from: ns, end: sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return false }
    if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) == false { return false }
    let rs = close + 2
    let mut re = rs
    let mut scanning = true
    while scanning {
        let stop = at_ident(toks: toks, i: re, wid: WORD_EFFECTS) || at_symbol(toks: toks, i: re, code: SYM_LBRACE) || at_symbol(toks: toks, i: re, code: SYM_EQ)
        if re < sigEnd && !stop  {
            re = re + 1
        } else {
            scanning = false
        }
    }
    let p = skip_type_prefixes(toks, s: rs, e: re)
    let base = dotted_name_text(toks, i: p)
    let after = dotted_end(toks, i: p)
    let mut target = base
    if (base == "Result" || base == "Option") && at_symbol(toks: toks, i: after, code: SYM_LANGLE) {
        let ac = find_matching(toks: toks, open: after, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if ac >= 0 {
            let q = skip_type_prefixes(toks, s: (after + 1), e: ac)
            target = dotted_name_text(toks, i: q)
        }
    }
    let bad = is_stdlib_resource(name: target) || Set.contains<String>(set: resources, value: target)
    if bad { List.push<Int>(list: mut out, value: rs) }
    return bad
}

// Stdlib resource types (the `resource` Item::Type decls in the .rssi interfaces).
fn is_stdlib_resource(name: String) -> Bool {
    return name == "File" || name == "TempDir"
}

// A qualified call `Ns.method(...)` is pure-allowed iff Ns is a known type.
fn qualified_call_allowed(name: String, declared: Set<String>) -> Bool {
    return is_builtin_type(name) || is_stdlib_type(name) || Set.contains<String>(set: declared, value: name)
}

// An unqualified call `name(...)` in a pure fn: FLAG iff it resolves to a declared
// non-pure function; constructors / enum variants / pure fns are allowed; an
// unresolved name is ignored.
fn unqual_call_bad(name: String, sumVariants: Set<String>, pureFns: Set<String>, allFns: Set<String>, declared: Set<String>) -> Bool {
    if name == "Some" || name == "Ok" || name == "Err" || name == "None" { return false }
    if is_builtin_type(name) || is_stdlib_type(name) || Set.contains<String>(set: declared, value: name) { return false }
    if Set.contains<String>(set: sumVariants, value: name) { return false }
    if Set.contains<String>(set: pureFns, value: name) { return false }
    if Set.contains<String>(set: allFns, value: name) { return true }
    return false
}

// Scan a pure fn body [bodyOpen,bodyClose) for a `with`/`manage` or a non-pure call.
fn collect_pure_body_bad_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, sumVariants: Set<String>, pureFns: Set<String>, allFns: Set<String>, declared: Set<String>, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        let t = tk_text(toks, i: k)
        if t == "with" {
            List.push<Int>(list: mut out, value: k)
            hit = true
        } else if t == "manage" {
            List.push<Int>(list: mut out, value: k)
            hit = true
        } else if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && tk_kind(toks: toks, i: (k - 1)) == TOK_IDENT {
            let name = tk_text(toks, i: (k - 1))
            let qualified = at_symbol(toks: toks, i: (k - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (k - 3))
            if qualified {
                let mut root = k - 3
                let mut walking = true
                while walking {
                    if at_symbol(toks: toks, i: (root - 1), code: SYM_DOT) && is_ident_tok(toks: toks, i: (root - 2)) {
                        root = root - 2
                    } else {
                        walking = false
                    }
                }
                if qualified_call_allowed(name: tk_text(toks, i: root), declared) == false {
                    List.push<Int>(list: mut out, value: root)
                    hit = true
                }
            } else {
                if unqual_call_bad(name, sumVariants, pureFns, allFns, declared) {
                    List.push<Int>(list: mut out, value: (k - 1))
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0009: a `pure` fn that returns a resource, has a mut/take param, retains a
// param, or whose body uses `with`/`manage`/a non-pure call.
fn collect_fn_pure_bad_tokens(toks: List<Tok>, start: Int, resources: Set<String>, sumVariants: Set<String>, pureFns: Set<String>, allFns: Set<String>, declared: Set<String>, out: mut List<Int>) -> Bool {
    if fn_is_pure(toks, start) == false { return false }
    let mut bad = false
    if collect_fn_pure_resource_return_token(toks, start, resources, out: mut out) { bad = true }
    if collect_fn_pure_mut_take_tokens(toks, start, out: mut out) { bad = true }
    if collect_fn_pure_retains_tokens(toks, start, out: mut out) { bad = true }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) {
        let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if bodyClose >= 0 {
            if collect_pure_body_bad_tokens(toks, bodyOpen: sigEnd, bodyClose, sumVariants, pureFns, allFns, declared, out: mut out) { bad = true }
        }
    }
    return bad
}

// Pre-pass filling RS0009 lookup sets: user resource type names, sum variant
// names, pure fn (simple) names, and all fn (simple) names.
fn collect_rs0009(toks: List<Tok>, resources: mut Set<String>, sumVariants: mut Set<String>, pureFns: mut Set<String>, allFns: mut Set<String>, noBlockFns: mut Set<String>, noPanicFns: mut Set<String>, asyncFns: mut Set<String>, unsafeFns: mut Set<String>) -> Unit {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks, i)
                    if at_ident(toks: toks, i: (nameIdx - 1), wid: WORD_RESOURCE) {
                        Set.insert<String>(set: mut resources, value: dotted_name_text(toks, i: nameIdx))
                    }
                    i = r
                }
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ob = find_body_open(toks, i, end: r)
                    if ob >= 0 {
                        let mut k = ob + 1
                        let mut depth = 0
                        while k < (r - 1) {
                            if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
                                depth = depth + 1
                            } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
                                if depth > 0 { depth = depth - 1 }
                            } else if depth == 0 && is_ident_tok(toks: toks, i: k) {
                                Set.insert<String>(set: mut sumVariants, value: tk_text(toks, i: k))
                            }
                            k = k + 1
                        }
                    }
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = fn_name_start(toks, i)
                    let fullName = dotted_name_text(toks, i: nameIdx)
                    if fn_is_async(toks, start: i) {
                        Set.insert<String>(set: mut asyncFns, value: fullName)
                    }
                    if fn_has_named_effect(toks, start: i, effName: "unsafe") {
                        Set.insert<String>(set: mut unsafeFns, value: fullName)
                    }
                    if at_symbol(toks: toks, i: (nameIdx + 1), code: SYM_DOT) == false {
                        let fname = tk_text(toks, i: nameIdx)
                        Set.insert<String>(set: mut allFns, value: fname)
                        if fn_is_pure(toks, start: i) {
                            Set.insert<String>(set: mut pureFns, value: fname)
                        }
                        if fn_has_named_effect(toks, start: i, effName: "no_block") {
                            Set.insert<String>(set: mut noBlockFns, value: fname)
                        }
                        if fn_has_named_effect(toks, start: i, effName: "no_panic") {
                            Set.insert<String>(set: mut noPanicFns, value: fname)
                        }
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return Unit
}

// Does any token in [s,e) have the given identifier text?
fn region_has_text(toks: List<Tok>, s: Int, e: Int, word: String) -> Bool {
    let mut k = s
    let mut hit = false
    while k < e {
        if tk_text(toks, i: k) == word { hit = true }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0024 UNKNOWN_TYPE.
// ---------------------------------------------------------------------------

// Generic-param names in scope for an item whose `<...>` clause opens at nameEnd
// (or an empty set if none). First ident of each top-level comma segment.
fn collect_generics(toks: List<Tok>, nameEnd: Int) -> Set<String> {
    let mut g = Set<String>.new()
    if at_symbol(toks: toks, i: nameEnd, code: SYM_LANGLE) == false { return g }
    let close = find_matching(toks: toks, open: nameEnd, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 { return g }
    let mut k = nameEnd + 1
    let mut depth = 0
    let mut segStart = nameEnd + 1
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_LANGLE) || at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) || at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if is_ident_tok(toks: toks, i: segStart) {
                Set.insert<String>(set: mut g, value: tk_text(toks, i: segStart))
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if is_ident_tok(toks: toks, i: segStart) {
        Set.insert<String>(set: mut g, value: tk_text(toks, i: segStart))
    }
    return g
}

// True if any TypeRef in the comma-separated argument region [s,e) is unknown.
fn collect_args_unknown_tokens(toks: List<Tok>, s: Int, e: Int, generics: Set<String>, declared: Set<String>, out: mut List<Int>) -> Bool {
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut unknown = false
    while k < e {
        if at_symbol(toks: toks, i: k, code: SYM_LANGLE) || at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) || at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if collect_type_ref_unknown_tokens(toks, s: segStart, e: k, generics, declared, out: mut out) { unknown = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if collect_type_ref_unknown_tokens(toks, s: segStart, e, generics, declared, out: mut out) { unknown = true }
    return unknown
}

// Validate one TypeRef region [s,e): unknown base, or unknown nested arg / Fn part.
fn collect_type_ref_unknown_tokens(toks: List<Tok>, s: Int, e: Int, generics: Set<String>, declared: Set<String>, out: mut List<Int>) -> Bool {
    let mut p = s
    let mut going = true
    while going {
        let t = tk_text(toks, i: p)
        if p < e && (t == "fresh" || t == "noescape" || t == "owned" || t == "handle" || t == "weak" || t == "&" || t == "read" || t == "mut" || t == "take") {
            p = p + 1
        } else {
            going = false
        }
    }
    if p >= e { return false }
    if is_ident_tok(toks: toks, i: p) == false { return false }
    let base = dotted_name_text(toks, i: p)
    let after = dotted_end(toks, i: p)
    let mut unknown = false
    // Capability is treated as always-known and its protocol arg is not recursed.
    if base == "Capability" {
        return false
    }
    let known = Set.contains<String>(set: generics, value: base) || is_builtin_type(name: base) || is_stdlib_type(name: base) || Set.contains<String>(set: declared, value: base)
    if !known  {
        List.push<Int>(list: mut out, value: p)
        unknown = true
    }
    if at_symbol(toks: toks, i: after, code: SYM_LANGLE) {
        let close = find_matching(toks: toks, open: after, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
        if close >= 0 {
            if collect_args_unknown_tokens(toks, s: (after + 1), e: close, generics, declared, out: mut out) { unknown = true }
        }
    } else if base == "Fn" && at_symbol(toks: toks, i: after, code: SYM_LPAREN) {
        let close = find_matching(toks: toks, open: after, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if close >= 0 {
            if collect_args_unknown_tokens(toks, s: (after + 1), e: close, generics, declared, out: mut out) { unknown = true }
            if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) {
                if collect_type_ref_unknown_tokens(toks, s: (close + 2), e, generics, declared, out: mut out) { unknown = true }
            }
        }
    }
    return unknown
}

// RS0024 over a type decl [i,r): every FIELD type. generics = the type's params.
fn collect_type_decl_unknown_tokens(toks: List<Tok>, i: Int, r: Int, declared: Set<String>, out: mut List<Int>) -> Bool {
    let ns = type_name_start(toks, i)
    let nameEnd = dotted_end(toks, i: ns)
    let generics = collect_generics(toks, nameEnd)
    let ob = find_body_open(toks, i, end: r)
    if ob < 0 { return false }
    let close = r - 1
    let mut k = ob + 1
    let mut paren = 0
    let mut br = 0
    let mut ang = 0
    let mut brace = 0
    let mut unknown = false
    while k < close {
        let isColon = at_symbol(toks: toks, i: k, code: SYM_COLON)
        let atTop = paren == 0 && br == 0 && ang == 0 && brace == 0
        if isColon && atTop && is_ident_tok(toks: toks, i: (k - 1)) {
            let fieldEnd = declaration_line_end(toks: toks, start: (k + 1))
            if collect_type_ref_unknown_tokens(toks, s: (k + 1), e: fieldEnd, generics, declared, out: mut out) { unknown = true }
        }
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            br = br + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            if br > 0 { br = br - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if ang > 0 { ang = ang - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RBRACE) {
            if brace > 0 { brace = brace - 1 }
        }
        k = k + 1
    }
    return unknown
}

// RS0024 over a fn: every PARAM type and the RETURN type. generics = fn's params.
fn collect_fn_unknown_type_tokens(toks: List<Tok>, start: Int, declared: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let nameEnd = dotted_end(toks, i: ns)
    let generics = collect_generics(toks, nameEnd)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let open = find_param_open(toks, from: ns, end: sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut unknown = false
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if collect_param_seg_unknown_type_tokens(toks, segStart, segEnd: k, generics, declared, out: mut out) { unknown = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if collect_param_seg_unknown_type_tokens(toks, segStart, segEnd: close, generics, declared, out: mut out) { unknown = true }
    // Return type: after the param-list close, an optional `-> Type` before
    // `effects`/`{`/`=` (mirror parse_function_decl's return-type scan).
    if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) {
        let rs = close + 2
        let mut re = rs
        let mut scanning = true
        while scanning {
            let stop = at_ident(toks: toks, i: re, wid: WORD_EFFECTS) || at_symbol(toks: toks, i: re, code: SYM_LBRACE) || at_symbol(toks: toks, i: re, code: SYM_EQ)
            if re < sigEnd && !stop  {
                re = re + 1
            } else {
                scanning = false
            }
        }
        if collect_type_ref_unknown_tokens(toks, s: rs, e: re, generics, declared, out: mut out) { unknown = true }
    }
    return unknown
}

// One param segment's type region → unknown? Type starts after `name :` and an
// optional data-effect; runs to the segment end.
fn collect_param_seg_unknown_type_tokens(toks: List<Tok>, segStart: Int, segEnd: Int, generics: Set<String>, declared: Set<String>, out: mut List<Int>) -> Bool {
    if segStart >= segEnd { return false }
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false { return false }
    let mut ts = segStart + 2
    if is_effect_kw(toks, i: ts) { ts = ts + 1 }
    return collect_type_ref_unknown_tokens(toks, s: ts, e: segEnd, generics, declared, out: mut out)
}

// Pre-pass: names of all declared nominal types (struct/class/resource/opaque/
// sum/type-alias LHS). Protocols are NOT included. Mirrors the main dispatch.
fn collect_declared_types(toks: List<Tok>) -> Set<String> {
    let ntok = List.len(list: toks)
    let mut declared = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ns = type_name_start(toks, i)
                    Set.insert<String>(set: mut declared, value: dotted_name_text(toks, i: ns))
                    i = r
                }
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ns = sum_name_start(toks, i)
                    Set.insert<String>(set: mut declared, value: dotted_name_text(toks, i: ns))
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let mut ns = i
                    if isPub { ns = ns + 1 }
                    ns = ns + 1
                    Set.insert<String>(set: mut declared, value: dotted_name_text(toks, i: ns))
                    i = r
                }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return declared
}

// ---------------------------------------------------------------------------
// RS0021 NON_EXHAUSTIVE_MATCH.
//
// A `match SCRUT { arm... }` (statement or expression form) is non-exhaustive
// unless it covers its scrutinee type: Some/None (Option), Ok/Err (Result),
// true/false (Bool), every variant of a declared sum, or an irrefutable pattern
// for a single-constructor tuple/struct — or it contains a `_` wildcard. Only
// GUARDLESS arms contribute coverage; malformed arms (no `=>`) contribute none.
// Ported from crate::analyzer::exhaustiveness (simplified for the corpus).
// ---------------------------------------------------------------------------

// True if token i is the keyword/ident with the given text (copied from astdump).
fn is_kw_text(toks: List<Tok>, i: Int, word: String) -> Bool {
    if is_ident_tok(toks: toks, i: i) == false { return false }
    return tk_text(toks, i) == word
}

// First top-level `if` keyword in [start,end) — from astdump.
fn find_top_if(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: toks, i: i, code: SYM_LPAREN) || at_symbol(toks: toks, i: i, code: SYM_LBRACE) || at_symbol(toks: toks, i: i, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: i, code: SYM_RPAREN) || at_symbol(toks: toks, i: i, code: SYM_RBRACE) || at_symbol(toks: toks, i: i, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks, i, word: "if") {
            return i
        }
        i = i + 1
    }
    return -1
}

// Collect the head ident of each variant in a sum body [ob+1, close) into `out`.
// Variant heads are the idents at paren/angle/brace depth 0 (payload fields sit
// inside `(...)`/`{...}` so they are excluded).
fn collect_variant_heads(toks: List<Tok>, ob: Int, close: Int, out: mut Set<String>) -> Unit {
    let mut k = ob + 1
    let mut paren = 0
    let mut ang = 0
    let mut brace = 0
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            paren = paren + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if paren > 0 { paren = paren - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            ang = ang + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if ang > 0 { ang = ang - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LBRACE) {
            brace = brace + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RBRACE) {
            if brace > 0 { brace = brace - 1 }
        } else if paren == 0 && ang == 0 && brace == 0 && is_ident_tok(toks: toks, i: k) {
            Set.insert<String>(set: mut out, value: tk_text(toks, i: k))
        }
        k = k + 1
    }
    return Unit
}

// True if the `sum` keyword at i heads a real top-level sum DECL (not a variable
// named `sum`): a name ident follows on the same line, and the `sum` starts a
// line or is preceded by `pub`. The tokenizer tags every `sum` text with
// WORD_SUM, so this guard is what separates `sum Color { … }` from `sum = …`.
fn real_sum_at(toks: List<Tok>, i: Int) -> Bool {
    if at_ident(toks: toks, i: i, wid: WORD_SUM) == false { return false }
    if is_ident_tok(toks: toks, i: (i + 1)) == false { return false }
    if tk_line(toks: toks, i: (i + 1)) != tk_line(toks: toks, i: i) { return false }
    if i == 0 { return true }
    if tk_line(toks: toks, i: (i - 1)) < tk_line(toks: toks, i: i) { return true }
    return at_ident(toks: toks, i: (i - 1), wid: WORD_PUB)
}

// The variant-name set of the declared `sum sumName` (empty if there is no such
// sum). A non-sum root therefore yields an empty set.
fn sum_variants_of(toks: List<Tok>, sumName: String) -> Set<String> {
    let n = List.len(list: toks)
    let mut out = Set<String>.new()
    if String.len(value: sumName) == 0 { return out }
    let mut i = 0
    let mut done = false
    while i < n && !done  {
        if real_sum_at(toks, i) {
            let name = dotted_name_text(toks, i: (i + 1))
            if name == sumName {
                let ob = find_body_open(toks, i: (i + 1), end: n)
                if ob >= 0 {
                    let close = find_matching(toks: toks, open: ob, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    if close >= 0 {
                        collect_variant_heads(toks, ob, close, out: mut out)
                    }
                }
                done = true
            }
        }
        i = i + 1
    }
    return out
}

// The declared sum that owns variant `vname`, or "" if none.
fn variant_owner(toks: List<Tok>, vname: String) -> String {
    let n = List.len(list: toks)
    let mut i = 0
    let mut result = ""
    let mut done = false
    while i < n && !done  {
        if real_sum_at(toks, i) {
            let sname = dotted_name_text(toks, i: (i + 1))
            let ob = find_body_open(toks, i: (i + 1), end: n)
            if ob >= 0 {
                let close = find_matching(toks: toks, open: ob, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                if close >= 0 {
                    let mut heads = Set<String>.new()
                    collect_variant_heads(toks, ob, close, out: mut heads)
                    if Set.contains<String>(set: heads, value: vname) {
                        result = sname
                        done = true
                    }
                }
            }
        }
        i = i + 1
    }
    return result
}

// Root of a TypeRef region [s,e): tuple `(...)` → "__Tuple", else the base
// (possibly dotted) name after skipping data-effects/reference prefixes; "" if
// the region has no nominal head.
fn type_region_root(toks: List<Tok>, s: Int, e: Int) -> String {
    let p = skip_type_prefixes(toks, s, e)
    if p >= e { return "" }
    if at_symbol(toks: toks, i: p, code: SYM_LPAREN) { return "__Tuple" }
    if is_ident_tok(toks: toks, i: p) == false { return "" }
    return dotted_name_text(toks, i: p)
}

// Return-type root of the fn whose keyword sits at `fnkw` (the `-> RET` head).
fn return_type_root_at(toks: List<Tok>, fnkw: Int) -> String {
    let sigEnd = function_signature_end(toks: toks, start: fnkw)
    let open = find_param_open(toks, from: fnkw, end: sigEnd)
    if open < 0 { return "" }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return "" }
    if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) == false { return "" }
    let rs = close + 2
    let mut re = rs
    let mut scanning = true
    while scanning {
        let stop = at_ident(toks: toks, i: re, wid: WORD_EFFECTS) || at_symbol(toks: toks, i: re, code: SYM_LBRACE) || at_symbol(toks: toks, i: re, code: SYM_EQ)
        if re < sigEnd && !stop  {
            re = re + 1
        } else {
            scanning = false
        }
    }
    return type_region_root(toks, s: rs, e: re)
}

// Return-type root of the first unqualified `fn fnName(...)` in the file, or "".
fn fn_return_root(toks: List<Tok>, fnName: String) -> String {
    let n = List.len(list: toks)
    let mut i = 0
    let mut result = ""
    let mut done = false
    while i < n && !done  {
        if at_ident(toks: toks, i: i, wid: WORD_FN) {
            let nameIdx = i + 1
            let named = is_ident_tok(toks: toks, i: nameIdx) && tk_text(toks, i: nameIdx) == fnName
            if named && at_symbol(toks: toks, i: (nameIdx + 1), code: SYM_DOT) == false {
                result = return_type_root_at(toks, fnkw: i)
                done = true
            }
        }
        i = i + 1
    }
    return result
}

// Type root of param `name` in the param list [open,close], or "" if absent.
fn param_type_root(toks: List<Tok>, open: Int, close: Int, name: String) -> String {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut result = ""
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if seg_name_matches(toks, segStart, name) {
                result = type_region_root(toks, s: (segStart + 2), e: k)
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_name_matches(toks, segStart, name) {
        result = type_region_root(toks, s: (segStart + 2), e: close)
    }
    return result
}

// Full canonical type string of the param named `name` (effect read/mut/take
// stripped; noescape/owned/fresh kept), or "" if not found. Used by the RS0208
// engine to type a bare-ident return whose value is a parameter.
fn param_type_string(toks: List<Tok>, open: Int, close: Int, name: String) -> String {
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut result = ""
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if seg_name_matches(toks, segStart, name) {
                let mut t = segStart + 2
                if is_effect_kw(toks, i: t) { t = t + 1 }
                result = type_token_string(toks, ts: t, te: k)
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_name_matches(toks, segStart, name) {
        let mut t2 = segStart + 2
        if is_effect_kw(toks, i: t2) { t2 = t2 + 1 }
        result = type_token_string(toks, ts: t2, te: close)
    }
    return result
}

// A param segment starts with `name :`.
fn seg_name_matches(toks: List<Tok>, segStart: Int, name: String) -> Bool {
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if tk_text(toks, i: segStart) != name { return false }
    return at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON)
}

// Root of the scrutinee expression region [s,e) (expr_root in the spec).
fn expr_root(toks: List<Tok>, s0: Int, e: Int, declared: Set<String>, allFns: Set<String>) -> String {
    let mut s = s0
    if is_effect_kw(toks, i: s) { s = s + 1 }
    if s >= e { return "" }
    if is_ident_tok(toks: toks, i: s) == false {
        let k = tk_kind(toks: toks, i: s)
        if k == TOK_STRING { return "String" }
        if k == TOK_NUMBER { return "Int" }
        if k == TOK_CHAR { return "Char" }
        return ""
    }
    let t = tk_text(toks, i: s)
    if t == "Some" || t == "None" { return "Option" }
    if t == "Ok" || t == "Err" { return "Result" }
    if t == "true" || t == "false" { return "Bool" }
    let after = dotted_end(toks, i: s)
    if after > (s + 1) { return "" }
    let owner = variant_owner(toks, vname: t)
    if String.len(value: owner) > 0 { return owner }
    if at_symbol(toks: toks, i: after, code: SYM_LPAREN) {
        if Set.contains<String>(set: allFns, value: t) {
            return fn_return_root(toks, fnName: t)
        }
        if Set.contains<String>(set: declared, value: t) { return t }
        return ""
    }
    return ""
}

// RHS start index (`=`+1) of the nearest preceding `let/local [mut] name = …`
// before matchPos in the body, or -1.
fn find_let_rhs_start(toks: List<Tok>, bodyOpen: Int, matchPos: Int, name: String) -> Int {
    let mut k = bodyOpen + 1
    let mut best = -1
    while k < matchPos {
        let isLet = is_kw_text(toks, i: k, word: "let") || is_kw_text(toks, i: k, word: "local")
        if isLet {
            let mut j = k + 1
            if is_kw_text(toks, i: j, word: "mut") { j = j + 1 }
            if is_ident_tok(toks: toks, i: j) && tk_text(toks, i: j) == name {
                let stmtEnd = next_line_or_block_end(toks: toks, start: k, end: matchPos)
                let eq = find_top_sym(toks, start: j, end: stmtEnd, code: SYM_EQ)
                if eq >= 0 { best = eq + 1 }
            }
        }
        k = k + 1
    }
    return best
}

// Scrutinee type root (spec's scrutinee inference).
fn scrutinee_root(toks: List<Tok>, s0: Int, e: Int, bodyOpen: Int, matchPos: Int, popen: Int, pclose: Int, declared: Set<String>, allFns: Set<String>) -> String {
    // A `?`-terminated scrutinee (`maybe()?`) matches the UNWRAPPED payload type,
    // which we do not track — treat as unknown so the arms drive the fallback.
    if e > 0 && at_symbol(toks: toks, i: (e - 1), code: SYM_QUESTION) {
        return ""
    }
    let mut s = s0
    if is_effect_kw(toks, i: s) { s = s + 1 }
    if (s + 1) == e && is_ident_tok(toks: toks, i: s) {
        let name = tk_text(toks, i: s)
        let lr = find_let_rhs_start(toks, bodyOpen, matchPos, name)
        if lr >= 0 {
            let re = next_line_or_block_end(toks: toks, start: lr, end: matchPos)
            return expr_root(toks, s0: lr, e: re, declared, allFns)
        }
        if popen >= 0 && pclose >= 0 {
            let pr = param_type_root(toks, open: popen, close: pclose, name)
            if String.len(value: pr) > 0 { return pr }
        }
        // Not a let-bound local or a typed param: fall through so a bare value
        // literal scrutinee (`true`, `None`, …) still resolves via expr_root.
        return expr_root(toks, s0, e, declared, allFns)
    }
    return expr_root(toks, s0, e, declared, allFns)
}

// A single-token payload/tuple element that is a binding (`name`) or `_`.
fn elem_is_binding(toks: List<Tok>, s: Int, e: Int) -> Bool {
    if (s + 1) != e { return false }
    return is_ident_tok(toks: toks, i: s)
}

// Every top-level comma-separated element of [s,e) is a bare binding / `_`.
fn elems_all_bindings(toks: List<Tok>, s: Int, e: Int) -> Bool {
    if s >= e { return true }
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut ok = true
    while k < e {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LANGLE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if elem_is_binding(toks, s: segStart, e: k) == false { ok = false }
            segStart = k + 1
        }
        k = k + 1
    }
    if elem_is_binding(toks, s: segStart, e) == false { ok = false }
    return ok
}

// True if the pattern [ps,pe) is irrefutable (a `_`, an all-binding tuple, a
// bare/empty-payload constructor, or a constructor whose every field binds).
fn pattern_irref(toks: List<Tok>, ps: Int, pe: Int) -> Bool {
    if (ps + 1) == pe && tk_text(toks, i: ps) == "_" { return true }
    if at_symbol(toks: toks, i: ps, code: SYM_LPAREN) && at_symbol(toks: toks, i: (pe - 1), code: SYM_RPAREN) {
        let close = find_matching(toks: toks, open: ps, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if close == (pe - 1) {
            return elems_all_bindings(toks, s: (ps + 1), e: close)
        }
    }
    if is_ident_tok(toks: toks, i: ps) {
        let after = dotted_end(toks, i: ps)
        if after == pe { return true }
        if at_symbol(toks: toks, i: after, code: SYM_LPAREN) {
            let close = find_matching(toks: toks, open: after, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
            if close == (pe - 1) {
                return elems_all_bindings(toks, s: (after + 1), e: close)
            }
            return false
        }
        if at_symbol(toks: toks, i: after, code: SYM_LBRACE) {
            let close = find_matching(toks: toks, open: after, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
            if close == (pe - 1) {
                return elems_all_bindings(toks, s: (after + 1), e: close)
            }
            return false
        }
    }
    return false
}

// Classify one guardless pattern [ps,pe) into the running coverage sets.
fn classify_pattern(toks: List<Tok>, ps: Int, pe: Int, variants: mut Set<String>, flags: mut Set<String>) -> Unit {
    let single = (ps + 1) == pe
    if single && tk_text(toks, i: ps) == "_" {
        Set.insert<String>(set: mut flags, value: "wild")
        return Unit
    }
    let k0 = tk_kind(toks: toks, i: ps)
    if single && (k0 == TOK_STRING || k0 == TOK_NUMBER || k0 == TOK_CHAR) {
        return Unit
    }
    if single && is_ident_tok(toks: toks, i: ps) && tk_text(toks, i: ps) == "true" {
        Set.insert<String>(set: mut flags, value: "true")
        return Unit
    }
    if single && is_ident_tok(toks: toks, i: ps) && tk_text(toks, i: ps) == "false" {
        Set.insert<String>(set: mut flags, value: "false")
        return Unit
    }
    if at_symbol(toks: toks, i: ps, code: SYM_LBRACKET) && at_symbol(toks: toks, i: (pe - 1), code: SYM_RBRACKET) {
        let close = find_matching(toks: toks, open: ps, openSym: SYM_LBRACKET, closeSym: SYM_RBRACKET)
        if close == (pe - 1) {
            classify_list_pattern(toks, s: (ps + 1), e: close, flags: mut flags)
            return Unit
        }
    }
    if is_ident_tok(toks: toks, i: ps) {
        let after = dotted_end(toks, i: ps)
        Set.insert<String>(set: mut variants, value: tk_text(toks, i: (after - 1)))
    }
    if pattern_irref(toks, ps, pe) {
        Set.insert<String>(set: mut flags, value: "irref")
    }
    return Unit
}

// A top-level list element [a,e) that is a rest binding (`..` or `..name`).
fn elem_is_rest(toks: List<Tok>, a: Int, e: Int) -> Bool {
    if (a + 1) >= e { return false }
    return at_symbol(toks: toks, i: a, code: SYM_DOT) && at_symbol(toks: toks, i: (a + 1), code: SYM_DOT)
}

// Record a list slice pattern's shape into `flags`: "F<n>" for a fixed-length
// pattern of `n` elements, or "R<n>" for a rest pattern with `n` fixed elements.
fn classify_list_pattern(toks: List<Tok>, s: Int, e: Int, flags: mut Set<String>) -> Unit {
    let mut k = s
    let mut depth = 0
    let mut segStart = s
    let mut count = 0
    let mut hasRest = false
    while k < e {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LANGLE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if elem_is_rest(toks, a: segStart, e: k) {
                hasRest = true
            } else {
                count = count + 1
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if segStart < e {
        if elem_is_rest(toks, a: segStart, e) {
            hasRest = true
        } else {
            count = count + 1
        }
    }
    let mut marker = "F"
    if hasRest { marker = "R" }
    Set.insert<String>(set: mut flags, value: String.concat(left: marker, right: String.from_int(value: count)))
    return Unit
}

// True if the match with arms [braceOpen+1, braceClose) over scrutinee root `root`
// is NON-exhaustive.
fn match_is_non_exhaustive(toks: List<Tok>, braceOpen: Int, braceClose: Int, root: String, declared: Set<String>, allFns: Set<String>) -> Bool {
    let mut variants = Set<String>.new()
    let mut flags = Set<String>.new()
    let mut i = braceOpen + 1
    while i < braceClose {
        if at_symbol(toks: toks, i: i, code: SYM_SEMI) || at_symbol(toks: toks, i: i, code: SYM_COMMA) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: toks, start: i, end: braceClose)
            let arrow = find_top_sym(toks, start: i, end: lineEnd, code: SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks, start: i, end: arrow)
                if ifPos < 0 {
                    classify_pattern(toks, ps: i, pe: arrow, variants: mut variants, flags: mut flags)
                }
                let bodyStart = arrow + 1
                if at_symbol(toks: toks, i: bodyStart, code: SYM_LBRACE) {
                    let bclose = find_matching(toks: toks, open: bodyStart, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    if bclose < 0 { i = braceClose } else { i = bclose + 1 }
                } else {
                    let bEnd = next_line_or_block_end(toks: toks, start: bodyStart, end: braceClose)
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    if Set.contains<String>(set: flags, value: "wild") { return false }
    if root == "Option" {
        let ok = Set.contains<String>(set: variants, value: "Some") && Set.contains<String>(set: variants, value: "None")
        return !ok
    }
    if root == "Result" {
        let ok = Set.contains<String>(set: variants, value: "Ok") && Set.contains<String>(set: variants, value: "Err")
        return !ok
    }
    if root == "Bool" {
        let ok = Set.contains<String>(set: flags, value: "true") && Set.contains<String>(set: flags, value: "false")
        return !ok
    }
    if root == "__Tuple" {
        return Set.contains<String>(set: flags, value: "irref") == false
    }
    if root == "List" {
        // Exhaustive iff some rest pattern caps the open tail (min fixed count
        // `minRest`) AND every shorter length 0..minRest has a fixed-length arm.
        let mut minRest = -1
        let mut q = 0
        while q <= 32 {
            if minRest < 0 && Set.contains<String>(set: flags, value: String.concat(left: "R", right: String.from_int(value: q))) {
                minRest = q
            }
            q = q + 1
        }
        if minRest < 0 { return true }
        let mut covered = true
        let mut len = 0
        while len < minRest {
            if Set.contains<String>(set: flags, value: String.concat(left: "F", right: String.from_int(value: len))) == false {
                covered = false
            }
            len = len + 1
        }
        return !covered
    }
    let sv = sum_variants_of(toks, sumName: root)
    if Set.is_empty<String>(set: sv) == false {
        return Set.is_subset<String>(left: sv, right: variants) == false
    }
    if String.len(value: root) > 0 && Set.contains<String>(set: declared, value: root) {
        return Set.contains<String>(set: flags, value: "irref") == false
    }
    let fb = (Set.contains<String>(set: variants, value: "Some") && Set.contains<String>(set: variants, value: "None")) || (Set.contains<String>(set: variants, value: "Ok") && Set.contains<String>(set: variants, value: "Err"))
    return !fb
}

// RS0021: any `match` inside the fn body [i,r) whose arms are non-exhaustive.
fn collect_fn_nonexhaustive_match_tokens(toks: List<Tok>, start: Int, declared: Set<String>, allFns: Set<String>, astSites: Set<String>, out: mut List<Int>) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let popen = find_param_open(toks, from: ns, end: sigEnd)
    let mut pclose = -1
    if popen >= 0 {
        pclose = find_matching(toks: toks, open: popen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        let isMatch = is_kw_text(toks, i: k, word: "match") && at_symbol(toks: toks, i: (k - 1), code: SYM_DOT) == false
        if isMatch {
            let matchToken = List.get<Tok>(list: toks, index: k)
            let key = condition_site_key(line: matchToken.line, column: matchToken.col, length: matchToken.len)
            if Set.contains<String>(set: astSites, value: key) == false {
                let braceOpen = find_match_arms_open(toks, start: (k + 1), end: bodyClose)
                if braceOpen >= 0 {
                    let braceClose = find_matching(toks: toks, open: braceOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
                    if braceClose >= 0 {
                        let root = scrutinee_root(toks, s0: (k + 1), e: braceOpen, bodyOpen: sigEnd, matchPos: k, popen, pclose, declared, allFns)
                        if match_is_non_exhaustive(toks, braceOpen, braceClose, root, declared, allFns) {
                            List.push<Int>(list: mut out, value: k)
                            hit = true
                        }
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0029 AWAIT_OUTSIDE_ASYNC.
//
// An `await` expression in a function that is not `async` (check_await_placement,
// async_context = function_is_async || in_task_group). Token-level: a non-async
// top-level fn whose body has an `await` keyword and no `async let` (task_group)
// binding suppressing it. Awaits are always checked non-async inside closures, so
// over-suppressing on any `async` token in the body is safe for the corpus.
// ---------------------------------------------------------------------------

// True if the fn decl at `start` carries the `async` modifier (a WORD_ASYNC
// keyword between the decl start / attributes and the `fn` keyword at ns-1).
fn fn_is_async(toks: List<Tok>, start: Int) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let mut k = start
    let mut hit = false
    while k < (ns - 1) {
        if at_ident(toks: toks, i: k, wid: WORD_ASYNC) { hit = true }
        k = k + 1
    }
    return hit
}

// RS0029: a non-async fn body that contains an `await` keyword and no `async`
// (task_group `async let`) binding to make the await valid.
fn collect_fn_bad_await_tokens(
    toks: List<Tok>,
    start: Int,
    astSites: Set<String>,
    out: mut List<Int>
) -> Bool {
    if fn_is_async(toks, start) { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hasAwait = false
    let mut suppress = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "await") { hasAwait = true }
        // `async let` (task_group) makes an await valid; `select` arm operations
        // are a structured await boundary; both suppress RS0029 for this fn.
        if at_ident(toks: toks, i: k, wid: WORD_ASYNC) { suppress = true }
        if is_kw_text(toks, i: k, word: "select") { suppress = true }
        if is_kw_text(toks, i: k, word: "task_group") { suppress = true }
        k = k + 1
    }
    if !hasAwait  || suppress { return false }
    k = sigEnd + 1
    let mut emitted = false
    while k < bodyClose {
        if is_kw_text(toks, i: k, word: "await") {
            let awaitToken = List.get<Tok>(list: toks, index: k)
            let key = condition_site_key(line: awaitToken.line, column: awaitToken.col, length: awaitToken.len)
            if Set.contains<String>(set: astSites, value: key) == false {
                List.push<Int>(list: mut out, value: k)
                emitted = true
            }
        }
        k = k + 1
    }
    return emitted
}

// ---------------------------------------------------------------------------
// RS0023 FD_OUTSIDE_INTERNAL_BOUNDARY.
//
// `Fd` used in a param/return type of a non-native fn, or in a field type of a
// non-resource type decl (check_fd_surface, type_ref_contains_name(ty, "Fd")).
// Native fns and resource types are the trusted internal boundary and skipped.
// ---------------------------------------------------------------------------

// True if the fn decl at `start` carries the `native` modifier.
fn fn_is_native(toks: List<Tok>, start: Int) -> Bool {
    let ns = fn_name_start(toks, i: start)
    let mut k = start
    let mut hit = false
    while k < (ns - 1) {
        if at_ident(toks: toks, i: k, wid: WORD_NATIVE) { hit = true }
        k = k + 1
    }
    return hit
}

// RS0023 over a non-native fn: any param type or the return type names `Fd`.
fn collect_text_tokens(toks: List<Tok>, s: Int, e: Int, word: String, out: mut List<Int>) -> Bool {
    let mut k = s
    let mut hit = false
    while k < e {
        if tk_text(toks, i: k) == word {
            List.push<Int>(list: mut out, value: k)
            hit = true
        }
        k = k + 1
    }
    return hit
}

fn collect_fn_fd_surface_tokens(toks: List<Tok>, start: Int, out: mut List<Int>) -> Bool {
    if fn_is_native(toks, start) { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    let open = find_param_open(toks, from: ns, end: sigEnd)
    if open < 0 { return false }
    let close = find_matching(toks: toks, open: open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 { return false }
    let mut k = open + 1
    let mut depth = 0
    let mut angle = 0
    let mut segStart = open + 1
    let mut hit = false
    while k < close {
        let opener = at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) || at_symbol(toks: toks, i: k, code: SYM_LBRACE)
        let closer = at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) || at_symbol(toks: toks, i: k, code: SYM_RBRACE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if at_symbol(toks: toks, i: k, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if depth == 0 && angle == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if seg_type_has_fd(toks, segStart, segEnd: k) {
                if collect_text_tokens(toks, s: (segStart + 2), e: k, word: "Fd", out: mut out) { hit = true }
            }
            segStart = k + 1
        }
        k = k + 1
    }
    if seg_type_has_fd(toks, segStart, segEnd: close) {
        if collect_text_tokens(toks, s: (segStart + 2), e: close, word: "Fd", out: mut out) { hit = true }
    }
    // Return type region: `-> Type` before effects/`{`/`=`.
    if at_symbol(toks: toks, i: (close + 1), code: SYM_ARROW) {
        let rs = close + 2
        let mut re = rs
        let mut scanning = true
        while scanning {
            let stop = at_ident(toks: toks, i: re, wid: WORD_EFFECTS) || at_symbol(toks: toks, i: re, code: SYM_LBRACE) || at_symbol(toks: toks, i: re, code: SYM_EQ)
            if re < sigEnd && !stop  {
                re = re + 1
            } else {
                scanning = false
            }
        }
        if collect_text_tokens(toks, s: rs, e: re, word: "Fd", out: mut out) { hit = true }
    }
    return hit
}

// ---------------------------------------------------------------------------
// RS0022 ASYNC_CALL_NOT_CONSUMED (signature-table decidable).
//
// A call whose callee resolves to a same-file `async fn` must be consumed: it is
// the direct operand of `await` or `spawn`, or the RHS of an `async let` binding.
// A bare/`let`-bound async call is unconsumed (check_async_call_consumed). Only
// same-file async fns register a signature; stdlib/native fns are never async, so
// qualified/receiver calls (`Ns.method(...)`) never resolve to an async signature
// and are skipped. Consumption threads through the AST, but the corpus only ever
// consumes an async call as the immediate `await`/`spawn` operand or `async let`
// RHS, so a token-adjacency probe is exact here.
// ---------------------------------------------------------------------------

fn collect_unconsumed_async_call_tokens(
    toks: List<Tok>,
    asyncFns: Set<String>,
    astSites: Set<String>,
    out: mut List<Int>
) -> Bool {
    let n = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < n {
        let isCall = is_ident_tok(toks: toks, i: i) && at_symbol(toks: toks, i: (i + 1), code: SYM_LPAREN)
        if isCall && Set.contains<String>(set: asyncFns, value: tk_text(toks, i)) {
            // A method call (`x.name(...)`) or the fn's own declaration (`fn name(`)
            // is not a resolvable unqualified async call site.
            let prevDot = at_symbol(toks: toks, i: (i - 1), code: SYM_DOT)
            let prevFn = at_ident(toks: toks, i: (i - 1), wid: WORD_FN)
            if !prevDot  && !prevFn  {
                let awaited = is_kw_text(toks, i: (i - 1), word: "await")
                let spawned = is_kw_text(toks, i: (i - 1), word: "spawn")
                let asyncLet = at_symbol(toks: toks, i: (i - 1), code: SYM_EQ) && is_kw_text(toks, i: (i - 3), word: "let") && at_ident(toks: toks, i: (i - 4), wid: WORD_ASYNC)
                let callToken = List.get<Tok>(list: toks, index: i)
                let key = condition_site_key(line: callToken.line, column: callToken.col, length: callToken.len)
                if !awaited  && !spawned  && !asyncLet  && Set.contains<String>(set: astSites, value: key) == false {
                    List.push<Int>(list: mut out, value: i)
                    hit = true
                }
            }
        }
        i = i + 1
    }
    return hit
}

// A param segment's type region [segStart+2, segEnd) names `Fd`.
fn seg_type_has_fd(toks: List<Tok>, segStart: Int, segEnd: Int) -> Bool {
    if (segStart + 2) >= segEnd { return false }
    if is_ident_tok(toks: toks, i: segStart) == false { return false }
    if at_symbol(toks: toks, i: (segStart + 1), code: SYM_COLON) == false { return false }
    return region_has_text(toks, s: (segStart + 2), e: segEnd, word: "Fd")
}

// ---------------------------------------------------------------------------
// RS0035 LOWER_NAME_CONFLICT.
//
// A `#lower_name("x")` pin that is not a valid Rust identifier, or two functions
// whose lowered backend names collide with at least one pinned. The default
// lowered name flattens dotted names (`.`->`_`) and raw-escapes Rust keywords
// (`gen`->`r#gen`); a pin overrides it. Mirrors check_lowered_name_conflicts.
// ---------------------------------------------------------------------------

// The Rust (strict + reserved) keyword set (rust_lower::is_rust_keyword).
fn is_rust_keyword(name: String) -> Bool {
    return name == "abstract" || name == "as" || name == "async" || name == "await" || name == "become" || name == "box" || name == "break" || name == "const" || name == "continue" || name == "crate" || name == "do" || name == "dyn" || name == "else" || name == "enum" || name == "extern" || name == "false" || name == "final" || name == "fn" || name == "for" || name == "gen" || name == "if" || name == "impl" || name == "in" || name == "let" || name == "loop" || name == "macro" || name == "match" || name == "mod" || name == "move" || name == "mut" || name == "override" || name == "priv" || name == "pub" || name == "ref" || name == "return" || name == "self" || name == "Self" || name == "static" || name == "struct" || name == "super" || name == "trait" || name == "true" || name == "try" || name == "type" || name == "typeof" || name == "unsafe" || name == "unsized" || name == "use" || name == "virtual" || name == "where" || name == "while" || name == "yield"
}

// A valid Rust identifier: ASCII alpha/`_` first, ASCII alnum/`_` rest, and not a
// Rust keyword. Empty strings and any other character make a pin invalid.
fn is_valid_rust_ident(name: String) -> Bool {
    let cs = String.chars(value: name)
    let n = List.len(list: cs)
    if n == 0 { return false }
    let f = Char.to_code(value: List.get(list: cs, index: 0))
    let firstOk = (f >= 65 && f <= 90) || (f >= 97 && f <= 122) || f == 95
    if !firstOk  { return false }
    let mut i = 1
    let mut ok = true
    while i < n {
        let c = Char.to_code(value: List.get(list: cs, index: i))
        let alnum = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95
        if !alnum  { ok = false }
        i = i + 1
    }
    if !ok  { return false }
    return is_rust_keyword(name) == false
}

// The default backend symbol name for a source fn name: dotted names flatten to
// `_`, then a Rust keyword is raw-escaped (`gen` -> `r#gen`).
fn default_lowered_name(name: String) -> String {
    let cs = String.chars(value: name)
    let n = List.len(list: cs)
    let mut out = ""
    let mut i = 0
    while i < n {
        let ch = List.get(list: cs, index: i)
        if Char.to_code(value: ch) == 46 {
            out = String.concat(left: out, right: "_")
        } else {
            out = String.concat(left: out, right: Char.to_string(value: ch))
        }
        i = i + 1
    }
    if is_rust_keyword(name: out) {
        return String.concat(left: "r#", right: out)
    }
    return out
}

// True if the fn decl at `start` carries a `#lower_name(...)` attribute (each
// attribute is `#name(arg)`, five tokens).
fn fn_has_lower_name(toks: List<Tok>, start: Int) -> Bool {
    let mut j = start
    let mut going = true
    let mut has = false
    while going {
        if at_symbol(toks: toks, i: j, code: SYM_HASH) {
            if tk_text(toks, i: (j + 1)) == "lower_name" {
                has = true
            }
            j = j + 5
        } else {
            going = false
        }
    }
    return has
}

// The `#lower_name("...")` pin string of a fn decl at `start`, or "" if none.
fn fn_lower_name_pin(toks: List<Tok>, start: Int) -> String {
    let mut j = start
    let mut going = true
    let mut pin = ""
    while going {
        if at_symbol(toks: toks, i: j, code: SYM_HASH) {
            if tk_text(toks, i: (j + 1)) == "lower_name" && at_symbol(toks: toks, i: (j + 2), code: SYM_LPAREN) && tk_kind(toks: toks, i: (j + 3)) == TOK_STRING {
                pin = tk_text(toks, i: (j + 3))
            }
            j = j + 5
        } else {
            going = false
        }
    }
    return pin
}

// ---------------------------------------------------------------------------
// RS0027 UNKNOWN_PROTOCOL.
//
// A generic protocol bound `<T: P>` naming a protocol P that is neither a special
// bound (`Managed`/`Struct`/`Resource`) nor visible. Visible protocols are the
// stdlib-interface protocols plus the file's own `protocol` decls. Mirrors
// check_protocol_bound over the exact 3-token `Ident : Ident` param form the
// parser accepts. (The Capability<P> and `impl P for T` paths have no fixtures.)
// ---------------------------------------------------------------------------

// Stdlib-interface protocols visible to every file (the `protocol` decls in the
// CORE/STANDARD `.rssi` interfaces).
// ---------------------------------------------------------------------------
// RS0014 / RS0018 / RS0019 runtime-guarantee bodies.
//
// A fn declaring effects(no_block)/effects(no_panic) may only call constructors,
// enum variants, or functions carrying the same guarantee — an unqualified call
// to a user function lacking it is RS0018 / RS0019. A fn declaring
// effects(noalloc) must not construct a value or `manage` — RS0014. Mirrors
// check_runtime_guarantee_* (the qualified-stdlib-call cases have no fixtures).
// ---------------------------------------------------------------------------

// One effects item [segStart,segEnd) is the valid bare effect `effName`.
fn effect_seg_named(toks: List<Tok>, segStart: Int, segEnd: Int, effName: String) -> Bool {
    if effect_item_kind(toks, segStart, segEnd) != 1 { return false }
    return tk_text(toks, i: segStart) == effName
}

// True if the fn's effects(...) clause lists the bare effect `effName`.
fn fn_has_named_effect(toks: List<Tok>, start: Int, effName: String) -> Bool {
    let effOpen = find_effects_open(toks, start)
    if effOpen < 0 { return false }
    let effClose = find_matching(toks: toks, open: effOpen, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if effClose < 0 { return false }
    let mut k = effOpen + 1
    let mut segStart = effOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < effClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: toks, i: k, code: SYM_COMMA) {
            if effect_seg_named(toks, segStart, segEnd: k, effName) { hit = true }
            segStart = k + 1
        }
        k = k + 1
    }
    if effect_seg_named(toks, segStart, segEnd: effClose, effName) { hit = true }
    return hit
}

// RS0018/RS0019: a guarantee-carrying fn whose body makes an unqualified call to
// a user function that does not carry the same guarantee.
fn collect_fn_guarantee_call_bad_sites(source: String, toks: List<Tok>, start: Int, effName: String, allFns: Set<String>, guaranteeFns: Set<String>, out: mut List<DiagnosticSite>) -> Bool {
    if fn_has_named_effect(toks, start, effName) == false { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && tk_kind(toks: toks, i: (k - 1)) == TOK_IDENT {
            let name = tk_text(toks, i: (k - 1))
            let qualified = at_symbol(toks: toks, i: (k - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (k - 3))
            if !qualified  {
                if Set.contains<String>(set: allFns, value: name) && Set.contains<String>(set: guaranteeFns, value: name) == false {
                    let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                    if close > 0 {
                        List.push<DiagnosticSite>(list: mut out, value: token_range_diagnostic_site(source, toks, start: (k - 1), endInclusive: (k - 1)))
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0014: a fn declaring effects(noalloc) whose body constructs a value (an
// unqualified call to a declared type) or uses `manage`.
fn collect_fn_noalloc_alloc_sites(source: String, toks: List<Tok>, start: Int, declared: Set<String>, out: mut List<DiagnosticSite>) -> Bool {
    if fn_has_named_effect(toks, start, effName: "noalloc") == false { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    let mut k = sigEnd + 1
    let mut hit = false
    while k < bodyClose {
        if tk_text(toks, i: k) == "manage" {
            List.push<DiagnosticSite>(list: mut out, value: token_range_diagnostic_site(source, toks, start: k, endInclusive: k))
            hit = true
        } else if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && tk_kind(toks: toks, i: (k - 1)) == TOK_IDENT {
            let name = tk_text(toks, i: (k - 1))
            let qualified = at_symbol(toks: toks, i: (k - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (k - 3))
            if !qualified  {
                if Set.contains<String>(set: declared, value: name) {
                    let close = find_matching(toks: toks, open: k, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
                    if close > 0 {
                        List.push<DiagnosticSite>(list: mut out, value: token_range_diagnostic_site(source, toks, start: (k - 1), endInclusive: (k - 1)))
                        hit = true
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0020 INVALID_NOALLOC_CALL: a `noalloc` fn may call ONLY enum variants or other
// `noalloc` fns (oracle analyzer/diagnostics.rs). Unqualified constructor calls
// (a declared type) allocate and are RS0014, not RS0020, so they are excluded here.

// Simple + dotted names of every `effects(noalloc)` fn (one top-level pre-pass).
fn collect_noalloc_fns(toks: List<Tok>) -> Set<String> {
    let ntok = List.len(list: toks)
    let mut out = Set<String>.new()
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    if fn_has_named_effect(toks, start: i, effName: "noalloc") {
                        let ns = fn_name_start(toks, i)
                        Set.insert<String>(set: mut out, value: dotted_name_text(toks, i: ns))
                    }
                    i = r
                }
            } else {
                i = i + 1
            }
        }
    }
    return out
}

// A noalloc fn body containing a call to something that is neither an enum variant
// nor a noalloc fn (constructors of declared types are RS0014, excluded).
fn collect_noalloc_body_bad_tokens(toks: List<Tok>, bodyOpen: Int, bodyClose: Int, declared: Set<String>, sumVariants: Set<String>, noallocFns: Set<String>, out: mut List<Int>) -> Bool {
    let mut k = bodyOpen + 1
    let mut hit = false
    while k < bodyClose {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) && tk_kind(toks: toks, i: (k - 1)) == TOK_IDENT {
            let name = tk_text(toks, i: (k - 1))
            let qualified = at_symbol(toks: toks, i: (k - 2), code: SYM_DOT) && is_ident_tok(toks: toks, i: (k - 3))
            if qualified {
                let mut root = k - 3
                let mut walking = true
                while walking {
                    if at_symbol(toks: toks, i: (root - 1), code: SYM_DOT) && is_ident_tok(toks: toks, i: (root - 2)) {
                        root = root - 2
                    } else {
                        walking = false
                    }
                }
                if Set.contains<String>(set: noallocFns, value: dotted_name_text(toks, i: root)) == false {
                    List.push<Int>(list: mut out, value: root)
                    hit = true
                }
            } else {
                let isCtor = Set.contains<String>(set: declared, value: name)
                let isVariant = Set.contains<String>(set: sumVariants, value: name)
                let isNoalloc = Set.contains<String>(set: noallocFns, value: name)
                if !isCtor  && !isVariant  && !isNoalloc  {
                    List.push<Int>(list: mut out, value: (k - 1))
                    hit = true
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0020 over one fn: a noalloc fn whose body makes a disallowed call.
fn collect_fn_noalloc_call_tokens(toks: List<Tok>, start: Int, declared: Set<String>, sumVariants: Set<String>, noallocFns: Set<String>, out: mut List<Int>) -> Bool {
    if fn_has_named_effect(toks, start, effName: "noalloc") == false { return false }
    let ns = fn_name_start(toks, i: start)
    let sigEnd = function_signature_end(toks: toks, start: (ns - 1))
    if at_symbol(toks: toks, i: sigEnd, code: SYM_LBRACE) == false { return false }
    let bodyClose = find_matching(toks: toks, open: sigEnd, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if bodyClose < 0 { return false }
    return collect_noalloc_body_bad_tokens(toks, bodyOpen: sigEnd, bodyClose, declared, sumVariants, noallocFns, out: mut out)
}

// RS1003 OWN_STRUCT_ATTEMPT: `own struct` is not part of the language (oracle
// checks/forbidden.rs scans for the adjacent `own` `struct` tokens). Byte-for-byte
// the same check: any `own` immediately followed by `struct`.
fn collect_own_struct_tokens(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut hit = false
    while i < (ntok - 1) {
        if is_kw_text(toks, i, word: "own") && is_kw_text(toks, i: (i + 1), word: "struct") {
            hit = true
            List.push<Int>(list: mut out, value: i)
        }
        i = i + 1
    }
    return hit
}

// RS0902 INVALID_WEAK_FIELD: a `weak` struct/resource field whose type is not a class
// (oracle analyzer/resource_types.rs). FP-safe: fire only when the field type is a
// KNOWN non-class — a scalar, or a type declared `struct`/`resource` in this file. An
// unknown type name (possibly a builtin/foreign class) never fires.

// Partition every declared type into class names and non-class (struct/resource)
// names in one pass.
fn collect_type_kinds(toks: List<Tok>, classes: mut Set<String>, nonClasses: mut Set<String>) -> Unit {
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let nameIdx = type_name_start(toks, i)
                    let nm = dotted_name_text(toks, i: nameIdx)
                    if at_ident(toks: toks, i: (nameIdx - 1), wid: WORD_CLASS) {
                        Set.insert<String>(set: mut classes, value: nm)
                    } else {
                        Set.insert<String>(set: mut nonClasses, value: nm)
                    }
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if cls.isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 { i = i + 1 } else { i = r }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else {
                i = i + 1
            }
        }
    }
    return Unit
}

// A type body [bodyOpen..} with a field `name: weak T` (optional `handle`) whose T is
// a known non-class type.
fn collect_type_body_invalid_weak(toks: List<Tok>, bodyOpen: Int, nonClass: Set<String>, out: mut List<Int>) -> Bool {
    let close = find_matching(toks: toks, open: bodyOpen, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 { return false }
    let mut k = bodyOpen + 1
    let mut depth = 0
    let mut hit = false
    while k < close {
        if at_symbol(toks: toks, i: k, code: SYM_LPAREN) || at_symbol(toks: toks, i: k, code: SYM_LBRACE) || at_symbol(toks: toks, i: k, code: SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: toks, i: k, code: SYM_RPAREN) || at_symbol(toks: toks, i: k, code: SYM_RBRACE) || at_symbol(toks: toks, i: k, code: SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_ident_tok(toks: toks, i: k) && at_symbol(toks: toks, i: (k + 1), code: SYM_COLON) {
            if is_kw_text(toks, i: (k + 2), word: "weak") {
                let mut u = k + 3
                if is_kw_text(toks, i: u, word: "handle") { u = u + 1 }
                if is_ident_tok(toks: toks, i: u) {
                    let tn = tk_text(toks, i: u)
                    if is_scalar_name(name: tn) || Set.contains<String>(set: nonClass, value: tn) {
                        hit = true
                        List.push<Int>(list: mut out, value: k)
                    }
                }
            }
        }
        k = k + 1
    }
    return hit
}

// RS0902 over the file: any type with an invalid `weak` field.
fn collect_invalid_weak_fields(toks: List<Tok>, out: mut List<Int>) -> Bool {
    let mut classes = Set<String>.new()
    let mut nonClass = Set<String>.new()
    collect_type_kinds(toks, classes: mut classes, nonClasses: mut nonClass)
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut running = true
    let mut hit = false
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            if cls.isFeatures {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isProfile {
                i = declaration_line_end(toks: toks, start: i)
            } else if cls.isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 { running = false } else { i = r }
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    running = false
                } else {
                    let ob = find_body_open(toks, i, end: r)
                    if ob >= 0 {
