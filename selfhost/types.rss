// Shared self-hosted type helpers.
//
// This is the first small slice of a checker-side type model: canonical type
// strings still carry the representation, but root/argument/fresh/generic
// handling lives in one module instead of being embedded in check.rss.

module selfhost.types

// index of `needle` in `s`, or -1 (String.index_of returns Option<Int>).
fn str_find(s: String, needle: String) -> Int {
    match String.index_of(value: s, needle) {
        Some(i) => {
            return i
        }
        None => {
            return 0 - 1
        }
    }
}

// strip a leading "fresh " marker (text_util strip_fresh_type).
fn str_strip_fresh(s: String) -> String {
    if String.starts_with(value: s, prefix: "fresh ") {
        let n = String.len(value: s)
        return String.slice(value: s, start: 6, len: (n - 6))
    }
    return s
}

// root name before the first `<` (after stripping type prefixes). text_util type_root_name.
fn str_type_root(s: String) -> String {
    let b = strip_type_prefixes(s)
    let lt = str_find(s: b, needle: "<")
    if lt < 0 { return b }
    return String.slice(value: b, start: 0, len: lt)
}

// trim ASCII spaces from both ends.
fn str_trim(s: String) -> String {
    let cs = String.chars(value: s)
    let n = List.len(list: cs)
    let mut a = 0
    let mut sc = true
    while sc {
        if a >= n { sc = false } else if List.get(list: cs, index: a) == ' ' { a = a + 1 } else { sc = false }
    }
    let mut b = n
    let mut sc2 = true
    while sc2 {
        if b <= a { sc2 = false } else if List.get(list: cs, index: (b - 1)) == ' ' { b = b - 1 } else { sc2 = false }
    }
    return String.slice(value: s, start: a, len: (b - a))
}

// Strip leading `noescape `/`owned `/`fresh ` type prefixes (analyzer type_util).
fn strip_type_prefixes(s: String) -> String {
    let mut t = s
    let mut go = true
    while go {
        go = false
        if String.starts_with(value: t, prefix: "noescape ") {
            t = String.slice(value: t, start: 9, len: (String.len(value: t) - 9))
            go = true
        } else if String.starts_with(value: t, prefix: "owned ") {
            t = String.slice(value: t, start: 6, len: (String.len(value: t) - 6))
            go = true
        } else if String.starts_with(value: t, prefix: "fresh ") {
            t = String.slice(value: t, start: 6, len: (String.len(value: t) - 6))
            go = true
        }
    }
    return t
}

// The `which`-th top-level generic argument of a canonical type string, or "".
// Commas nested in <>/() are not separators.
fn str_top_arg(s: String, which: Int) -> String {
    let b = strip_type_prefixes(s)
    let lt = str_find(s: b, needle: "<")
    if lt < 0 { return "" }
    let n = String.len(value: b)
    let inner = String.slice(value: b, start: (lt + 1), len: ((n - 1) - (lt + 1)))
    let cs = String.chars(value: inner)
    let m = List.len(list: cs)
    let mut depth = 0
    let mut start = 0
    let mut argno = 0
    let mut idx = 0
    let mut result = ""
    let mut found = false
    while idx < m {
        let c = List.get(list: cs, index: idx)
        if c == '<' || c == '(' {
            depth = depth + 1
        } else if c == '>' || c == ')' {
            depth = depth - 1
        } else if c == ',' && depth == 0 {
            if argno == which && !found  {
                result = String.slice(value: inner, start, len: (idx - start))
                found = true
            }
            argno = argno + 1
            start = idx + 1
        }
        idx = idx + 1
    }
    if !found  && argno == which {
        result = String.slice(value: inner, start, len: (m - start))
        found = true
    }
    if !found  { return "" }
    return str_trim(s: result)
}

// Arity of a `Fn(a, b, ...) -> ret` type body (prefixes already stripped): the count of
// top-level comma-separated arg types in the paren group (0 for `Fn()`), or -1 if `body`
// is not a Fn type. Commas nested in ()/[]/<> are not separators.
fn fn_type_arity(body: String) -> Int {
    if String.starts_with(value: body, prefix: "Fn(") == false { return 0 - 1 }
    let cs = String.chars(value: body)
    let n = List.len(list: cs)
    let mut i = 3
    let mut depth = 0
    let mut angle = 0
    let mut args = 0
    let mut sawContent = false
    let mut scanning = true
    while scanning {
        if i >= n {
            scanning = false
        } else {
            let c = List.get(list: cs, index: i)
            if c == '(' || c == '[' {
                depth = depth + 1
                sawContent = true
            } else if c == ')' || c == ']' {
                if depth == 0 {
                    scanning = false
                } else {
                    depth = depth - 1
                }
            } else if c == '<' {
                angle = angle + 1
                sawContent = true
            } else if c == '>' {
                if angle > 0 { angle = angle - 1 }
            } else if c == ',' && depth == 0 && angle == 0 {
                args = args + 1
                sawContent = true
            } else if c != ' ' {
                sawContent = true
            }
            if scanning { i = i + 1 }
        }
    }
    if !sawContent  { return 0 }
    return args + 1
}

// The return type of a `Fn(...) -> ret` body (prefixes stripped): the text after the
// Fn's own closing paren and `-> `, trimmed. "" if not a well-formed Fn type.
fn fn_type_return(body: String) -> String {
    if String.starts_with(value: body, prefix: "Fn(") == false { return "" }
    let cs = String.chars(value: body)
    let n = List.len(list: cs)
    let mut i = 3
    let mut depth = 0
    let mut close = 0 - 1
    let mut scanning = true
    while scanning {
        if i >= n {
            scanning = false
        } else {
            let c = List.get(list: cs, index: i)
            if c == '(' || c == '[' {
                depth = depth + 1
            } else if c == ')' || c == ']' {
                if depth == 0 {
                    close = i
                    scanning = false
                } else {
                    depth = depth - 1
                }
            }
            if scanning { i = i + 1 }
        }
    }
    if close < 0 { return "" }
    let rest = String.slice(value: body, start: (close + 1), len: (n - (close + 1)))
    let ar = str_find(s: rest, needle: "-> ")
    if ar < 0 { return "" }
    let rn = String.len(value: rest)
    return str_trim(s: String.slice(value: rest, start: (ar + 3), len: (rn - (ar + 3))))
}

// The `which`-th argument type of a `Fn(a, b, ...) -> ret` body (prefixes stripped), or
// "" if absent. Commas nested in ()/[]/<> are not separators. Used to type positional
// arguments of a call whose callee is a Fn-typed parameter.
fn fn_type_arg_at(body: String, which: Int) -> String {
    if String.starts_with(value: body, prefix: "Fn(") == false { return "" }
    let cs = String.chars(value: body)
    let n = List.len(list: cs)
    let mut i = 3
    let mut depth = 0
    let mut angle = 0
    let mut segStart = 3
    let mut argno = 0
    let mut result = ""
    let mut found = false
    let mut scanning = true
    while scanning {
        if i >= n {
            scanning = false
        } else {
            let c = List.get(list: cs, index: i)
            if c == '(' || c == '[' {
                depth = depth + 1
            } else if c == ')' || c == ']' {
                if depth == 0 {
                    if argno == which && i > segStart {
                        result = String.slice(value: body, start: segStart, len: (i - segStart))
                        found = true
                    }
                    scanning = false
                } else {
                    depth = depth - 1
                }
            } else if c == '<' {
                angle = angle + 1
            } else if c == '>' {
                if angle > 0 { angle = angle - 1 }
            } else if c == ',' && depth == 0 && angle == 0 {
                if argno == which {
                    result = String.slice(value: body, start: segStart, len: (i - segStart))
                    found = true
                    scanning = false
                }
                argno = argno + 1
                segStart = i + 1
            }
            if scanning { i = i + 1 }
        }
    }
    if !found  { return "" }
    return str_trim(s: result)
}

// argument_type_matches (calls.rs): equality, Self, fresh-stripped equality, and the
// Option<?>/Result<?> wildcards produced by variant constructors.
fn arg_type_matches(expected: String, actual: String) -> Bool {
    if expected == actual { return true }
    if expected == "Self" { return true }
    if str_strip_fresh(s: expected) == str_strip_fresh(s: actual) { return true }
    if actual == "Option<?>" { return str_type_root(s: expected) == "Option" }
    if actual == "Result<?>" { return str_type_root(s: expected) == "Result" }
    return false
}

// unresolved_generic_type (calls.rs): a single uppercase-letter root, or any generic
// arg that is itself unresolved. (type prefixes handled via strip + root.)
fn str_is_unresolved_generic(s: String) -> Bool {
    let root = str_type_root(s)
    if String.len(value: root) == 1 {
        let rc = String.chars(value: root)
        let ch = List.get(list: rc, index: 0)
        if Char.is_upper(value: ch) { return true }
    }
    let mut idx = 0
    let mut scanning = true
    while scanning {
        let arg = str_top_arg(s, which: idx)
        if String.len(value: arg) == 0 {
            scanning = false
        } else {
            if str_is_unresolved_generic(s: arg) { return true }
            idx = idx + 1
        }
    }
    return false
}

const TYPE_SUBSTITUTION_DEPTH_LIMIT: Int = 100

fn str_type_arg_count(s: String) -> Int {
    let mut count = 0
    let mut scanning = true
    while scanning {
        let argument = str_top_arg(s: s, which: count)
        if String.len(value: argument) == 0 {
            scanning = false
        } else {
            count = count + 1
        }
    }
    return count
}

fn collect_type_parameter_names(ty: String, names: mut List<String>, seen: mut Set<String>, depth: Int) -> Unit {
    if depth >= TYPE_SUBSTITUTION_DEPTH_LIMIT { return Unit }
    let body = strip_type_prefixes(s: str_trim(s: ty))
    let root = str_type_root(s: body)
    if String.len(value: root) == 1 {
        let chars = String.chars(value: root)
        if List.len(list: chars) == 1 && Char.is_upper(value: List.get<Char>(list: chars, index: 0)) {
            if Set.contains<String>(set: seen, value: root) == false {
                Set.insert<String>(set: mut seen, value: root)
                List.push<String>(list: mut names, value: root)
            }
            return Unit
        }
    }
    if String.starts_with(value: body, prefix: "Fn(") {
        let arity = fn_type_arity(body: body)
        let mut index = 0
        while index < arity {
            collect_type_parameter_names(
                ty: fn_type_arg_at(body: body, which: index),
                names: mut names,
                seen: mut seen,
                depth: depth + 1
            )
            index = index + 1
        }
        collect_type_parameter_names(
            ty: fn_type_return(body: body),
            names: mut names,
            seen: mut seen,
            depth: depth + 1
        )
        return Unit
    }
    let count = str_type_arg_count(s: body)
    let mut index = 0
    while index < count {
        collect_type_parameter_names(
            ty: str_top_arg(s: body, which: index),
            names: mut names,
            seen: mut seen,
            depth: depth + 1
        )
        index = index + 1
    }
    return Unit
}

fn substitute_type_parameters(ty: String, substitutions: Map<String, String>, depth: Int) -> String {
    if depth >= TYPE_SUBSTITUTION_DEPTH_LIMIT { return ty }
    let trimmed = str_trim(s: ty)
    if Map.contains_key<String, String>(map: substitutions, key: trimmed) {
        return Map.get_or_default<String, String>(
            map: substitutions,
            key: trimmed,
            default: trimmed
        )
    }
    if String.starts_with(value: trimmed, prefix: "fresh ") {
        let target = String.slice(value: trimmed, start: 6, len: (String.len(value: trimmed) - 6))
        return String.concat(
            left: "fresh ",
            right: substitute_type_parameters(
                ty: target,
                substitutions: substitutions,
                depth: depth + 1
            )
        )
    }
    if String.starts_with(value: trimmed, prefix: "noescape ") {
        let target = String.slice(value: trimmed, start: 9, len: (String.len(value: trimmed) - 9))
        return String.concat(
            left: "noescape ",
            right: substitute_type_parameters(
                ty: target,
                substitutions: substitutions,
                depth: depth + 1
            )
        )
    }
    if String.starts_with(value: trimmed, prefix: "owned ") {
        let target = String.slice(value: trimmed, start: 6, len: (String.len(value: trimmed) - 6))
        return String.concat(
            left: "owned ",
            right: substitute_type_parameters(
                ty: target,
                substitutions: substitutions,
                depth: depth + 1
            )
        )
    }
    if String.starts_with(value: trimmed, prefix: "Fn(") {
        let arity = fn_type_arity(body: trimmed)
        if arity < 0 { return trimmed }
        let mut out = "Fn("
        let mut index = 0
        while index < arity {
            if index > 0 { out = String.concat(left: out, right: ", ") }
            out = String.concat(
                left: out,
                right: substitute_type_parameters(
                    ty: fn_type_arg_at(body: trimmed, which: index),
                    substitutions: substitutions,
                    depth: depth + 1
                )
            )
            index = index + 1
        }
        out = String.concat(left: out, right: ") -> ")
        return String.concat(
            left: out,
            right: substitute_type_parameters(
                ty: fn_type_return(body: trimmed),
                substitutions: substitutions,
                depth: depth + 1
            )
        )
    }
    let count = str_type_arg_count(s: trimmed)
    if count == 0 { return trimmed }
    let mut out = String.concat(left: str_type_root(s: trimmed), right: "<")
    let mut index = 0
    while index < count {
        if index > 0 { out = String.concat(left: out, right: ", ") }
        out = String.concat(
            left: out,
            right: substitute_type_parameters(
                ty: str_top_arg(s: trimmed, which: index),
                substitutions: substitutions,
                depth: depth + 1
            )
        )
        index = index + 1
    }
    return String.concat(left: out, right: ">")
}

fn collect_type_substitutions(
    pattern: String,
    actual: String,
    genericNames: Set<String>,
    substitutions: mut Map<String, String>,
    depth: Int
) -> Unit {
    if depth >= TYPE_SUBSTITUTION_DEPTH_LIMIT { return Unit }
    let patternBody = strip_type_prefixes(s: str_trim(s: pattern))
    let actualBody = strip_type_prefixes(s: str_trim(s: actual))
    if actualBody == "?" || String.len(value: actualBody) == 0 { return Unit }
    if Set.contains<String>(set: genericNames, value: patternBody) {
        if Map.contains_key<String, String>(map: substitutions, key: patternBody) == false {
            Map.insert<String, String>(
                map: mut substitutions,
                key: patternBody,
                value: actualBody
            )
        }
        return Unit
    }
    if String.starts_with(value: patternBody, prefix: "Fn(")
        && String.starts_with(value: actualBody, prefix: "Fn(") {
        let patternArity = fn_type_arity(body: patternBody)
        let actualArity = fn_type_arity(body: actualBody)
        if patternArity != actualArity { return Unit }
        let mut index = 0
        while index < patternArity {
            collect_type_substitutions(
                pattern: fn_type_arg_at(body: patternBody, which: index),
                actual: fn_type_arg_at(body: actualBody, which: index),
                genericNames: genericNames,
                substitutions: mut substitutions,
                depth: depth + 1
            )
            index = index + 1
        }
        collect_type_substitutions(
            pattern: fn_type_return(body: patternBody),
            actual: fn_type_return(body: actualBody),
            genericNames: genericNames,
            substitutions: mut substitutions,
            depth: depth + 1
        )
        return Unit
    }
    let patternCount = str_type_arg_count(s: patternBody)
    let actualCount = str_type_arg_count(s: actualBody)
    if patternCount == 0
        || patternCount != actualCount
        || str_type_root(s: patternBody) != str_type_root(s: actualBody) {
        return Unit
    }
    let mut index = 0
    while index < patternCount {
        collect_type_substitutions(
            pattern: str_top_arg(s: patternBody, which: index),
            actual: str_top_arg(s: actualBody, which: index),
            genericNames: genericNames,
            substitutions: mut substitutions,
            depth: depth + 1
        )
        index = index + 1
    }
    return Unit
}
