// Self-hosted rss shared scanner prelude.
//
// This file is the single source of truth for low-level tokenization shared by
// the self-hosted lexer, parser, and checker. The test harness
// (selfhost_parity.rs) compiles this file and each tool as separate VM sources;
// tools import it with `use selfhost.scan.*`.
// This file declares `features: local` for its own tokenizer helpers; tool files
// that use local-only constructs declare their own feature header.
//
// Contents:
//   * the unified `Tok` struct (carries kind, val, line, col, and identifier/
//     literal TEXT so both the parser and the checker can use it);
//   * the shared character/keyword/symbol predicates;
//   * the shared low-level scanners (comment, char, string, multiline, interp,
//     number, ident) — each returns an end index (pure scans, no emission);
//   * `word_id`, mapping declaration keywords to small ids;
//   * a single `tokenize` that builds the token list.
//
// rss constraints honored (ledger SH-016/017/018): char literals used for
// code-point tests (SH-016), long `||` predicate chains wrap across lines via
// operator/line continuation (SH-017), cursors threaded positionally.
// SH-022: string building uses StringBuilder (O(n)); the hot per-char scanners
// keep `chars: read List<Char>` DIRECT so the DeepCopy-elision holds (extracted
// Chars flow only into `Char.*` intrinsics / compares / `List.get`).

features: local

module selfhost.scan

// The unified token. `kind` is one of the TOK_* constants below; `val` carries
// the symbol code (SYM_*) for symbols or the declaration-keyword id (WORD_*) for
// idents/keywords.
struct Tok {
    kind: Int
    val: Int
    line: Int
    col: Int
    len: Int
    text: String
    // Matching `()`, `[]`, or `{}` close index for an opening delimiter; -1
    // otherwise. Built once by tokenize so range parsers do not rescan bodies.
    matching: Int
}

// --- Named ids (replace the raw numeric tables the scanner/parser/checker share).
// These are the single source of truth for the three id spaces: token KINDS
// (Tok.kind), symbol token CODES (Tok.val for symbols), and declaration-keyword
// WORD ids (Tok.val for idents/keywords). Every token-kind, symbol-code, and
// word-id site — assignments, `code:`/`wid:` args, `word_id` returns, and the
// comparisons in is_ident_tok / starts_top_level_item / is_feature_tok — refers
// to one of these constants. NOT covered (intentionally): the raw ASCII
// character-code compares inside the low-level char scanners (e.g. `c1 == 34`
// for `"`), which pair with adjacent char literals, and the 0 / -1 sentinels.

// Token kinds (Tok.kind). 0 = "no token emitted this step" and -1 = "index past
// end" are sentinels, NOT token kinds, so they stay as bare literals.
const TOK_IDENT: Int = 1
const TOK_NUMBER: Int = 2
const TOK_STRING: Int = 3
const TOK_INTERP: Int = 4
const TOK_MULTILINE: Int = 5
const TOK_KEYWORD: Int = 6
const TOK_SYMBOL: Int = 7
const TOK_EOF: Int = 8
const TOK_CHAR: Int = 9
const TOK_UNKNOWN: Int = 10

// Symbol token codes (Tok.val when kind == TOK_SYMBOL): the ASCII code of the
// single char, or a synthetic code for a multi-char operator.
const SYM_HASH: Int = 35        // '#'
const SYM_BANG: Int = 33        // '!'
const SYM_LPAREN: Int = 40      // '('
const SYM_RPAREN: Int = 41      // ')'
const SYM_STAR: Int = 42        // '*'
const SYM_COMMA: Int = 44       // ','
const SYM_DOT: Int = 46         // '.'
const SYM_COLON: Int = 58       // ':'
const SYM_LANGLE: Int = 60      // '<'
const SYM_EQ: Int = 61          // '='
const SYM_RANGLE: Int = 62      // '>'
const SYM_LBRACKET: Int = 91    // '['
const SYM_RBRACKET: Int = 93    // ']'
const SYM_QUESTION: Int = 63    // '?'
const SYM_LBRACE: Int = 123     // '{'
const SYM_RBRACE: Int = 125     // '}'
const SYM_PIPE: Int = 124       // '|'
const SYM_ARROW: Int = 256      // '->'
const SYM_FATARROW: Int = 257   // '=>'

// Declaration-keyword ids (word_id → Tok.val for the lead ident/keyword of a
// top-level declaration). 0 means "not a declaration keyword".
const WORD_FN: Int = 1
const WORD_STRUCT: Int = 2
const WORD_CLASS: Int = 3
const WORD_RESOURCE: Int = 4
const WORD_OPAQUE: Int = 5
const WORD_SUM: Int = 6
const WORD_PROTOCOL: Int = 7
const WORD_IMPL: Int = 8
const WORD_NATIVE: Int = 9
const WORD_MODULE: Int = 10
const WORD_TYPE: Int = 11
const WORD_CONST: Int = 12
const WORD_PUB: Int = 13
const WORD_ASYNC: Int = 14
const WORD_USE: Int = 15
const WORD_PROFILE: Int = 16
const WORD_FEATURES: Int = 17
const WORD_FOR: Int = 18
const WORD_DEPRECATED: Int = 19
const WORD_LOWER_NAME: Int = 20
const WORD_DERIVES: Int = 21
const WORD_EFFECTS: Int = 22
const WORD_FRESH: Int = 23
const WORD_UNDERSCORE: Int = 24
const WORD_AS: Int = 25
const WORD_LOCAL: Int = 26
const WORD_UNSAFE: Int = 27
const WORD_DEVICE: Int = 28
const WORD_FFI: Int = 29
const WORD_REFLECTION: Int = 30

// The 30 reserved keywords (crate::lexer::KEYWORDS). Contextual words
// (await, native) and builtin constants (true false Ok Err Some None Unit)
// are NOT here — they lex as Ident.
fn is_kw(word: String) -> Bool {
    return word == "if" || word == "else" || word == "for" || word == "in"
        || word == "match" || word == "loop" || word == "while" || word == "break"
        || word == "continue" || word == "return" || word == "features" || word == "class"
        || word == "struct" || word == "resource" || word == "handle" || word == "fn"
        || word == "let" || word == "pub" || word == "async" || word == "effects"
        || word == "drop" || word == "with" || word == "as" || word == "read"
        || word == "mut" || word == "take" || word == "fresh" || word == "manage"
        || word == "weak" || word == "local"
}

// Single-char symbols the oracle recognizes (crate::lexer push_one). Any other
// char falls through to payload "?".
fn is_known_symbol(c: Char) -> Bool {
    return c == ':' || c == ',' || c == '.' || c == '(' || c == ')'
        || c == '{' || c == '}' || c == '<' || c == '>' || c == '['
        || c == ']' || c == '?' || c == '|' || c == '&' || c == '~'
        || c == '^' || c == '+' || c == '-' || c == '*' || c == '/'
        || c == '%' || c == '=' || c == '!' || c == ';' || c == '#'
}

fn is_ident_start(c: Char) -> Bool {
    return Char.is_alpha(value: c) || c == '_'
}

fn is_ident_cont(c: Char) -> Bool {
    return Char.is_alphanumeric(value: c) || c == '_'
}

// Code point at index i, or -1 if out of bounds.
fn code_at(chars: List<Char>, n: Int, i: Int) -> Int {
    if i < n {
        let c = List.get(list: chars, index: i)
        return Char.to_code(value: c)
    }
    return -1
}

// Raw substring chars[from..to].
fn slice(chars: List<Char>, from: Int, to: Int) -> String {
    local out = StringBuilder.new()
    let mut k = from
    while k < to {
        let c = List.get(list: chars, index: k)
        StringBuilder.push(builder: mut out, value: Char.to_string(value: c))
        k = k + 1
    }
    return StringBuilder.finish(builder: take out)
}

// Escape a payload exactly like the harness: backslash->\\, \n, \t, \r.
fn escape(s: String) -> String {
    let cs = String.chars(value: s)
    let m = List.len(list: cs)
    local out = StringBuilder.new()
    let mut k = 0
    while k < m {
        let c = List.get(list: cs, index: k)
        if c == '\\' {
            StringBuilder.push(builder: mut out, value: "\\\\")
        } else if c == '\n' {
            StringBuilder.push(builder: mut out, value: "\\n")
        } else if c == '\t' {
            StringBuilder.push(builder: mut out, value: "\\t")
        } else if c == '\r' {
            StringBuilder.push(builder: mut out, value: "\\r")
        } else {
            StringBuilder.push(builder: mut out, value: Char.to_string(value: c))
        }
        k = k + 1
    }
    return StringBuilder.finish(builder: take out)
}

// Line comment `//` to end of line (newline consumed). Returns end index.
fn scan_line_comment(chars: List<Char>, n: Int, i: Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: chars, index: j)
            j = j + 1
            if c == '\n' {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    return j
}

// Character literal `'c'` — returns the content-end index (position of the
// closing `'`, or the newline/EOF where the scan stopped). The closing quote is
// NOT consumed by this scan; the caller advances past it. Content is
// chars[i+1..result]. Mirrors the Rust lexer's `lex_char_literal`: one `\`-escape
// is honored (a `\'` does not terminate the literal). Escapes are decoded later.
fn scan_char(chars: List<Char>, n: Int, i: Int) -> Int {
    let mut j = i + 1
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: chars, index: j)
            if c == '\'' {
                scanning = false
            } else if c == '\n' {
                scanning = false
            } else if c == '\\' {
                // Skip the backslash and its escaped char, but stay in bounds so a
                // file ending in `'\` cannot advance past `n` (mirrors scan_string /
                // scan_interp; the Rust reference lexer recovers here too).
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// String literal `"..."` — returns the content-end index (position of the
// closing quote, or n). The closing quote is NOT consumed by this scan; the
// caller advances past it. Content is chars[i+1..result].
fn scan_string(chars: List<Char>, n: Int, i: Int) -> Int {
    let start = i + 1
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: chars, index: j)
            if c == '"' {
                scanning = false
            } else if c == '\\' {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// Multiline string `"""..."""` — returns the content-end index (position of the
// closing `"""`, or n). Content is chars[i+3..result]; delimiter not consumed.
fn scan_multiline(chars: List<Char>, n: Int, i: Int) -> Int {
    let start = i + 3
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c0 = List.get(list: chars, index: j)
            let mut triple = false
            if c0 == '"' && j + 2 < n {
                let cc1 = List.get(list: chars, index: (j + 1))
                let cc2 = List.get(list: chars, index: (j + 2))
                triple = cc1 == '"' && cc2 == '"'
            }
            if triple {
                scanning = false
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// Interpolated string `$"..."` — returns the content-end index (position of the
// closing quote, or n). Content is chars[i+2..result]; delimiter not consumed.
// Brace-depth scan mirrors crate::lexer::lex_interpolated_string.
fn scan_interp(chars: List<Char>, n: Int, i: Int) -> Int {
    let start = i + 2
    let mut j = start
    let mut depth = 0
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: chars, index: j)
            if c == '"' && depth == 0 {
                scanning = false
            } else if c == '\\' {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else if depth > 0 && c == '"' {
                j = j + 1
                let mut inner = true
                while inner {
                    if j >= n {
                        inner = false
                    } else {
                        let sc = List.get(list: chars, index: j)
                        if sc == '\\' {
                            j = j + 1
                            if j < n {
                                j = j + 1
                            }
                        } else {
                            j = j + 1
                            if sc == '"' {
                                inner = false
                            }
                        }
                    }
                }
            } else if c == '{' && depth == 0 && code_at(chars, n, i: (j + 1)) == 123 {
                j = j + 2
            } else if c == '}' && depth == 0 && code_at(chars, n, i: (j + 1)) == 125 {
                j = j + 2
            } else {
                if c == '{' {
                    depth = depth + 1
                } else if c == '}' {
                    if depth > 0 {
                        depth = depth - 1
                    }
                }
                j = j + 1
            }
        }
    }
    return j
}

// Number: integer digits, optional single `.` followed by >=1 digit.
// Returns the end index; content is chars[i..result].
fn scan_number(chars: List<Char>, n: Int, i: Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: chars, index: j)
            if Char.is_digit(value: c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    let mut dot = false
    if j < n {
        let cdot = List.get(list: chars, index: j)
        dot = cdot == '.'
    }
    if dot {
        let after = j + 1
        if after < n {
            let cd = List.get(list: chars, index: after)
            if Char.is_digit(value: cd) {
                j = after
                let mut frac = true
                while frac {
                    if j < n {
                        let c = List.get(list: chars, index: j)
                        if Char.is_digit(value: c) {
                            j = j + 1
                        } else {
                            frac = false
                        }
                    } else {
                        frac = false
                    }
                }
            }
        }
    }
    return j
}

// Ident or keyword. Returns the end index; content is chars[i..result].
fn scan_ident(chars: List<Char>, n: Int, i: Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: chars, index: j)
            if is_ident_cont(c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    return j
}

// Map an identifier/keyword's text to a small word id the tools recognize.
// Anything the tools never check by name maps to 0.
fn word_id(word: String) -> Int {
    if word == "fn" { return WORD_FN }
    if word == "struct" { return WORD_STRUCT }
    if word == "class" { return WORD_CLASS }
    if word == "resource" { return WORD_RESOURCE }
    if word == "opaque" { return WORD_OPAQUE }
    if word == "sum" { return WORD_SUM }
    if word == "protocol" { return WORD_PROTOCOL }
    if word == "impl" { return WORD_IMPL }
    if word == "native" { return WORD_NATIVE }
    if word == "module" { return WORD_MODULE }
    if word == "type" { return WORD_TYPE }
    if word == "const" { return WORD_CONST }
    if word == "pub" { return WORD_PUB }
    if word == "async" { return WORD_ASYNC }
    if word == "use" { return WORD_USE }
    if word == "profile" { return WORD_PROFILE }
    if word == "features" { return WORD_FEATURES }
    if word == "for" { return WORD_FOR }
    if word == "deprecated" { return WORD_DEPRECATED }
    if word == "lower_name" { return WORD_LOWER_NAME }
    if word == "derives" { return WORD_DERIVES }
    if word == "effects" { return WORD_EFFECTS }
    if word == "fresh" { return WORD_FRESH }
    if word == "_" { return WORD_UNDERSCORE }
    if word == "as" { return WORD_AS }
    if word == "local" { return WORD_LOCAL }
    if word == "unsafe" { return WORD_UNSAFE }
    if word == "device" { return WORD_DEVICE }
    if word == "ffi" { return WORD_FFI }
    if word == "reflection" { return WORD_REFLECTION }
    return 0
}

// Build the token list. Each token carries kind, val, line, col, and text.
// SH-019: returns a `fresh List<Tok>` built via List.new + List.push + return.
fn tokenize(source: String) -> fresh List<Tok> {
    let chars = String.chars(value: source)
    let n = List.len(list: chars)
    let mut toks = List.new<Tok>()
    let mut i = 0
    let mut curLine = 1
    let mut curCol = 1
    while i < n {
        let startLine = curLine
        let startCol = curCol
        let c = List.get(list: chars, index: i)
        let c1 = code_at(chars, n, i: (i + 1))
        let c2 = code_at(chars, n, i: (i + 2))
        let mut j = i
        let mut kind = 0
        let mut val = 0
        let mut text = ""
        if Char.is_whitespace(value: c) {
            j = i + 1
            kind = 0
        } else if c == '/' && c1 == 47 {
            j = scan_line_comment(chars, n, i)
            kind = 0
        } else if c == '"' && c1 == 34 && c2 == 34 {
            let cend = scan_multiline(chars, n, i)
            text = slice(chars, from: (i + 3), to: cend)
            kind = TOK_MULTILINE
            let d0 = code_at(chars, n, i: cend)
            let d1 = code_at(chars, n, i: (cend + 1))
            let d2 = code_at(chars, n, i: (cend + 2))
            if d0 == 34 && d1 == 34 && d2 == 34 {
                j = cend + 3
            } else {
                j = cend
            }
        } else if c == '$' && c1 == 34 {
            let cend = scan_interp(chars, n, i)
            text = slice(chars, from: (i + 2), to: cend)
            kind = TOK_INTERP
            if code_at(chars, n, i: cend) == 34 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if c == '"' {
            let cend = scan_string(chars, n, i)
            text = slice(chars, from: (i + 1), to: cend)
            kind = TOK_STRING
            if code_at(chars, n, i: cend) == 34 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if c == '\'' {
            let cend = scan_char(chars, n, i)
            text = slice(chars, from: (i + 1), to: cend)
            kind = TOK_CHAR
            if code_at(chars, n, i: cend) == 39 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if Char.is_digit(value: c) {
            j = scan_number(chars, n, i)
            kind = TOK_NUMBER
            text = slice(chars, from: i, to: j)
        } else if is_ident_start(c) {
            j = scan_ident(chars, n, i)
            let word = slice(chars, from: i, to: j)
            if is_kw(word) {
                kind = TOK_KEYWORD
            } else {
                kind = TOK_IDENT
            }
            val = word_id(word)
            text = word
        } else if c == '-' && c1 == 62 {
            j = i + 2
            kind = TOK_SYMBOL
            val = SYM_ARROW
            text = "->"
        } else if c == '=' && c1 == 62 {
            j = i + 2
            kind = TOK_SYMBOL
            val = SYM_FATARROW
            text = "=>"
        } else {
            j = i + 1
            if is_known_symbol(c) {
                kind = TOK_SYMBOL
                val = Char.to_code(value: c)
                text = Char.to_string(value: c)
            } else {
                // Outside the lexical inventory: emit an Unknown token carrying the
                // raw char (kind 10), mirroring crate::lexer's TokenKind::Unknown.
                // (Previously mapped to Symbol "?", which aliased a stray char to
                // the try operator.)
                kind = TOK_UNKNOWN
                val = Char.to_code(value: c)
                text = Char.to_string(value: c)
            }
        }
        if kind != 0 {
            let t = Tok(kind: kind, val: val, line: startLine, col: startCol, len: (j - i), text: text, matching: -1)
            List.push(list: mut toks, value: t)
        }
        // Advance line/col over the consumed span [i, j).
        let mut k = i
        while k < j {
            let ch = List.get(list: chars, index: k)
            if ch == '\n' {
                curLine = curLine + 1
                curCol = 1
            } else {
                curCol = curCol + 1
            }
            k = k + 1
        }
        i = j
    }
    let eof = Tok(kind: TOK_EOF, val: 0, line: curLine, col: curCol, len: 0, text: "", matching: -1)
    List.push(list: mut toks, value: eof)
    return attach_delimiter_matches(toks: toks)
}

fn opens_delimiter(code: Int) -> Bool {
    return code == SYM_LPAREN || code == SYM_LBRACE || code == SYM_LBRACKET
}

fn closes_delimiter(code: Int) -> Bool {
    return code == SYM_RPAREN || code == SYM_RBRACE || code == SYM_RBRACKET
}

fn delimiters_match(open: Int, close: Int) -> Bool {
    return (open == SYM_LPAREN && close == SYM_RPAREN)
        || (open == SYM_LBRACE && close == SYM_RBRACE)
        || (open == SYM_LBRACKET && close == SYM_RBRACKET)
}

// Precompute delimiter partners in one pass. Angle brackets intentionally stay
// uncached: they may be generic arguments or comparison operators, and the
// existing range-aware matcher is the authority for that distinction.
fn attach_delimiter_matches(toks: List<Tok>) -> fresh List<Tok> {
    let n = List.len(list: toks)
    local partners = List<Int>.new()
    local stackIndexes = List<Int>.new()
    local stackCodes = List<Int>.new()
    let mut i = 0
    while i < n {
        List.push<Int>(list: mut partners, value: -1)
        i = i + 1
    }
    let mut stackLen = 0
    i = 0
    while i < n {
        let code = tk_val(toks: toks, i: i)
        if tk_kind(toks: toks, i: i) == TOK_SYMBOL && opens_delimiter(code: code) {
            if stackLen == List.len(list: stackIndexes) {
                List.push<Int>(list: mut stackIndexes, value: i)
                List.push<Int>(list: mut stackCodes, value: code)
            } else {
                List.set<Int>(list: mut stackIndexes, index: stackLen, value: i)
                List.set<Int>(list: mut stackCodes, index: stackLen, value: code)
            }
            stackLen = stackLen + 1
        } else if tk_kind(toks: toks, i: i) == TOK_SYMBOL && closes_delimiter(code: code) && stackLen > 0 {
            let open = List.get<Int>(list: stackIndexes, index: (stackLen - 1))
            let openCode = List.get<Int>(list: stackCodes, index: (stackLen - 1))
            if delimiters_match(open: openCode, close: code) {
                List.set<Int>(list: mut partners, index: open, value: i)
                stackLen = stackLen - 1
            }
        }
        i = i + 1
    }
    local matched = List<Tok>.new()
    i = 0
    while i < n {
        let token = List.get<Tok>(list: toks, index: i)
        let copy = Tok(kind: token.kind, val: token.val, line: token.line, col: token.col, len: token.len, text: token.text, matching: List.get<Int>(list: partners, index: i))
        List.push<Tok>(list: mut matched, value: copy)
        i = i + 1
    }
    return matched
}

// ---------------------------------------------------------------------------
// Token accessors and declaration-boundary helpers shared by the parser and
// checker (byte-identical in both tools before dedup). Out-of-range reads
// return kind -1 (treated as "nothing").
// ---------------------------------------------------------------------------

fn tk_kind(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return -1 }
    if i >= List.len(list: toks) { return -1 }
    let t = List.get(list: toks, index: i)
    return t.kind
}

fn tk_val(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: toks) { return 0 }
    let t = List.get(list: toks, index: i)
    return t.val
}

fn tk_line(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: toks) { return 0 }
    let t = List.get(list: toks, index: i)
    return t.line
}

fn is_ident_tok(toks: List<Tok>, i: Int) -> Bool {
    let k = tk_kind(toks, i)
    return k == TOK_IDENT || k == TOK_KEYWORD
}

// at_ident: token i is an Ident/Keyword with the given word id.
fn at_ident(toks: List<Tok>, i: Int, wid: Int) -> Bool {
    if is_ident_tok(toks, i) {
        return tk_val(toks, i) == wid
    }
    return false
}

// at_symbol: token i is a Symbol with the given symbol code.
fn at_symbol(toks: List<Tok>, i: Int, code: Int) -> Bool {
    if tk_kind(toks, i) == TOK_SYMBOL {
        return tk_val(toks, i) == code
    }
    return false
}

fn find_matching(toks: List<Tok>, open: Int, openSym: Int, closeSym: Int) -> Int {
    if at_symbol(toks, i: open, code: openSym) == false {
        return -1
    }
    if (openSym == SYM_LPAREN && closeSym == SYM_RPAREN)
        || (openSym == SYM_LBRACE && closeSym == SYM_RBRACE)
        || (openSym == SYM_LBRACKET && closeSym == SYM_RBRACKET) {
        let token = List.get<Tok>(list: toks, index: open)
        if token.matching >= 0 { return token.matching }
    }
    let n = List.len(list: toks)
    let mut depth = 0
    let mut idx = open
    let mut result = -1
    let mut scanning = true
    while scanning {
        if idx >= n {
            scanning = false
        } else {
            if at_symbol(toks, i: idx, code: openSym) {
                depth = depth + 1
            } else if at_symbol(toks, i: idx, code: closeSym) {
                depth = depth - 1
                if depth == 0 {
                    result = idx
                    scanning = false
                }
            }
            idx = idx + 1
        }
    }
    return result
}

fn declaration_line_end(toks: List<Tok>, start: Int) -> Int {
    let n = List.len(list: toks)
    if start >= n {
        return start
    }
    let line = tk_line(toks, i: start)
    let mut idx = start
    while idx < n {
        if tk_line(toks, i: idx) > line {
            return idx
        }
        if tk_kind(toks, i: idx) == TOK_EOF {
            return idx
        }
        idx = idx + 1
    }
    return n
}

fn next_line_or_block_end(toks: List<Tok>, start: Int, end: Int) -> Int {
    if start >= end {
        return end
    }
    let line = tk_line(toks, i: start)
    let mut idx = start
    while idx < end {
        if tk_line(toks, i: idx) > line {
            return idx
        }
        idx = idx + 1
    }
    return end
}

fn starts_top_level_item(toks: List<Tok>, index: Int) -> Bool {
    let n = List.len(list: toks)
    if index < 0 || index >= n {
        return false
    }
    if index > 0 && tk_line(toks, i: (index - 1)) == tk_line(toks, i: index) {
        return false
    }
    // Attributes begin a declaration even though `#` is a symbol. In
    // particular, a body-less native function may be followed immediately by
    // `#lower_name(...) fn ...`; signature scanning must stop before it.
    if at_symbol(toks, i: index, code: SYM_HASH) {
        return true
    }
    if is_ident_tok(toks, i: index) == false { return false }
    let v = tk_val(toks, i: index)
    return v == WORD_FEATURES || v == WORD_PROFILE || v == WORD_CLASS || v == WORD_STRUCT || v == WORD_RESOURCE || v == WORD_FN || v == WORD_PUB || v == WORD_ASYNC || v == WORD_NATIVE || v == WORD_PROTOCOL || v == WORD_IMPL
}

fn function_signature_end(toks: List<Tok>, start: Int) -> Int {
    let n = List.len(list: toks)
    let mut depth = 0
    let mut idx = start
    while idx < n {
        if depth == 0 && at_symbol(toks, i: idx, code: SYM_LBRACE) {
            return idx
        }
        if depth == 0 && at_symbol(toks, i: idx, code: SYM_RBRACE) {
            return idx
        }
        if idx > start && depth == 0 && starts_top_level_item(toks, index: idx) {
            return idx
        }
        let opener = at_symbol(toks, i: idx, code: SYM_LPAREN) || at_symbol(toks, i: idx, code: SYM_LBRACKET) || at_symbol(toks, i: idx, code: SYM_LANGLE)
        let closer = at_symbol(toks, i: idx, code: SYM_RPAREN) || at_symbol(toks, i: idx, code: SYM_RBRACKET) || at_symbol(toks, i: idx, code: SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 {
                depth = depth - 1
            }
        }
        if tk_kind(toks, i: idx) == TOK_EOF {
            return idx
        }
        idx = idx + 1
    }
    return n
}

// ---------------------------------------------------------------------------
// Name helpers. Return the new index, or -1 on failure.
// ---------------------------------------------------------------------------

fn take_ident_name(toks: List<Tok>, i: Int) -> Int {
    if is_ident_tok(toks, i) {
        return i + 1
    }
    return -1
}

fn take_function_name(toks: List<Tok>, i: Int) -> Int {
    let mut j = take_ident_name(toks, i)
    if j < 0 {
        return -1
    }
    let mut going = true
    while going {
        if at_symbol(toks, i: j, code: SYM_DOT) {
            let j2 = take_ident_name(toks, i: (j + 1))
            if j2 < 0 {
                return -1
            }
            j = j2
        } else {
            going = false
        }
    }
    return j
}

// The first identifier of a function name after attributes, modifiers, and
// `fn`. This is shared syntax information; consumers must not each rediscover
// the declaration prefix with their own token walk.
fn function_decl_name_start(toks: List<Tok>, i: Int) -> Int {
    let mut j = i
    while at_symbol(toks, i: j, code: SYM_HASH) {
        j = j + 5
    }
    let mut modifiers = true
    while modifiers {
        if at_ident(toks, i: j, wid: WORD_PUB) || at_ident(toks, i: j, wid: WORD_ASYNC) || at_ident(toks, i: j, wid: WORD_NATIVE) {
            j = j + 1
        } else {
            modifiers = false
        }
    }
    if at_ident(toks, i: j, wid: WORD_FN) {
        return j + 1
    }
    return -1
}

// The first parameter-list `(` after a function name, skipping its generic
// clause. Bounds may themselves contain parentheses.
fn function_param_open(toks: List<Tok>, from: Int, end: Int) -> Int {
    let mut i = from
    let mut angle = 0
    while i < end {
        if at_symbol(toks, i, code: SYM_LANGLE) {
            angle = angle + 1
        } else if at_symbol(toks, i, code: SYM_RANGLE) {
            if angle > 0 { angle = angle - 1 }
        } else if angle == 0 && at_symbol(toks, i, code: SYM_LPAREN) {
            return i
        }
        i = i + 1
    }
    return -1
}

// First comma at nesting depth zero in [start,end), or -1. Parameter and
// generic parsers share this rule so nested type arguments remain intact.
fn split_top_level_comma(toks: List<Tok>, start: Int, end: Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < end {
        let opener = at_symbol(toks, i, code: SYM_LPAREN) || at_symbol(toks, i, code: SYM_LBRACKET) || at_symbol(toks, i, code: SYM_LBRACE) || at_symbol(toks, i, code: SYM_LANGLE)
        let closer = at_symbol(toks, i, code: SYM_RPAREN) || at_symbol(toks, i, code: SYM_RBRACKET) || at_symbol(toks, i, code: SYM_RBRACE) || at_symbol(toks, i, code: SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks, i, code: SYM_COMMA) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Stable textual representation for a type token range. It is intentionally
// syntax-only: resolution and canonical package qualification belong to the
// semantic model, not to the parser.
fn canonical_type_text(toks: List<Tok>, start: Int, end: Int) -> String {
    let mut out = ""
    let mut i = start
    while i < end {
        if at_symbol(toks, i, code: SYM_COMMA) {
            out = String.concat(left: out, right: ", ")
        } else if at_symbol(toks, i, code: SYM_LANGLE) {
            out = String.concat(left: out, right: "<")
        } else if at_symbol(toks, i, code: SYM_RANGLE) {
            out = String.concat(left: out, right: ">")
        } else if at_symbol(toks, i, code: SYM_LPAREN) {
            out = String.concat(left: out, right: "(")
        } else if at_symbol(toks, i, code: SYM_RPAREN) {
            out = String.concat(left: out, right: ")")
        } else if at_symbol(toks, i, code: SYM_ARROW) {
            out = String.concat(left: out, right: " -> ")
        } else if at_symbol(toks, i, code: SYM_DOT) {
            out = String.concat(left: out, right: ".")
        } else if is_ident_tok(toks, i) {
            let tok = List.get(list: toks, index: i)
            let text = tok.text
            if text == "fresh" || text == "owned" || text == "noescape" {
                out = String.concat(left: String.concat(left: out, right: text), right: " ")
            } else {
                out = String.concat(left: out, right: text)
            }
        }
        i = i + 1
    }
    return out
}

fn parse_generic_params(toks: List<Tok>, i: Int) -> Int {
    if at_symbol(toks, i, code: SYM_LANGLE) == false {
        return i
    }
    let close = find_matching(toks, open: i, openSym: SYM_LANGLE, closeSym: SYM_RANGLE)
    if close < 0 {
        return i
    }
    return close + 1
}

fn parse_derives(toks: List<Tok>, i: Int) -> Int {
    if at_ident(toks, i, wid: WORD_DERIVES) == false {
        return i
    }
    let j = i + 1
    if at_symbol(toks, i: j, code: SYM_LPAREN) == false {
        return j
    }
    let close = find_matching(toks, open: j, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
    if close < 0 {
        return j
    }
    return close + 1
}

// ---------------------------------------------------------------------------
// Declaration parsers. Return new index on success, or -1 = malformed.
// ---------------------------------------------------------------------------

fn parse_type_decl(toks: List<Tok>, i: Int) -> Int {
    let startLine = tk_line(toks, i)
    let mut j = i
    if at_ident(toks, i: j, wid: WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks, i: j, wid: WORD_OPAQUE) {
        j = j + 1
    }
    let isKind = at_ident(toks, i: j, wid: WORD_CLASS) || at_ident(toks, i: j, wid: WORD_STRUCT) || at_ident(toks, i: j, wid: WORD_RESOURCE)
    if !isKind  {
        return -1
    }
    j = j + 1
    j = take_function_name(toks, i: j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks, i: j)
    j = parse_derives(toks, i: j)
    if at_symbol(toks, i: j, code: SYM_LBRACE) {
        let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if close < 0 {
            return -1
        }
        return close + 1
    }
    let n = List.len(list: toks)
    if j < n && tk_line(toks, i: j) == startLine {
        return declaration_line_end(toks, start: j)
    }
    return j
}

fn parse_sum_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i
    if at_ident(toks, i: j, wid: WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks, i: j, wid: WORD_SUM) == false {
        return -1
    }
    j = j + 1
    j = take_ident_name(toks, i: j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks, i: j)
    j = parse_derives(toks, i: j)
    if at_symbol(toks, i: j, code: SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_protocol_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i + 1
    j = take_ident_name(toks, i: j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks, i: j, code: SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_impl_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i + 1
    j = take_ident_name(toks, i: j)
    if j < 0 {
        return -1
    }
    if at_ident(toks, i: j, wid: WORD_FOR) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks, i: j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks, i: j, code: SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_native_module_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i + 2
    j = take_ident_name(toks, i: j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks, i: j, code: SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_type_alias_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i
    if at_ident(toks, i: j, wid: WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks, i: j, wid: WORD_TYPE) == false {
        return -1
    }
    j = j + 1
    j = take_ident_name(toks, i: j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks, i: j)
    if at_symbol(toks, i: j, code: SYM_EQ) == false {
        return -1
    }
    j = j + 1
    let n = List.len(list: toks)
    // The type reference itself is recognize-and-skipped: parse_type_ref only
    // rejects on shapes no accepted corpus file (nor any rejected-corpus file) hit.
    return next_line_or_block_end(toks, start: j, end: n)
}

fn parse_const_decl(toks: List<Tok>, i: Int) -> Int {
    let n = List.len(list: toks)
    let mut j = i
    if at_ident(toks, i: j, wid: WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks, i: j, wid: WORD_CONST) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks, i: j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks, i: j, code: SYM_COLON) {
        j = j + 1
        let mut eq = j
        let mut scanning = true
        while scanning {
            if eq >= n {
                scanning = false
            } else if at_symbol(toks, i: eq, code: SYM_EQ) {
                scanning = false
            } else {
                eq = eq + 1
            }
        }
        j = eq
    }
    if at_symbol(toks, i: j, code: SYM_EQ) == false {
        return -1
    }
    j = j + 1
    // Value expression recognize-and-skipped (parse_expr cannot reject any file
    // in the corpus that the oracle accepts, nor any rejected-corpus file).
    return next_line_or_block_end(toks, start: j, end: n)
}

fn parse_function_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = i
    // Attributes: #deprecated("...") / #lower_name("...").
    let mut attrs = true
    while attrs {
        if at_symbol(toks, i: j, code: SYM_HASH) {
            j = j + 1
            let isAttr = at_ident(toks, i: j, wid: WORD_DEPRECATED) || at_ident(toks, i: j, wid: WORD_LOWER_NAME)
            if !isAttr  {
                return -1
            }
            j = j + 1
            if at_symbol(toks, i: j, code: SYM_LPAREN) == false {
                return -1
            }
            j = j + 1
            if tk_kind(toks, i: j) != TOK_STRING {
                return -1
            }
            j = j + 1
            if at_symbol(toks, i: j, code: SYM_RPAREN) == false {
                return -1
            }
            j = j + 1
        } else {
            attrs = false
        }
    }
    // Modifiers: pub / async / native.
    let mut mods = true
    while mods {
        let isMod = at_ident(toks, i: j, wid: WORD_PUB) || at_ident(toks, i: j, wid: WORD_ASYNC) || at_ident(toks, i: j, wid: WORD_NATIVE)
        if isMod {
            j = j + 1
        } else {
            mods = false
        }
    }
    if at_ident(toks, i: j, wid: WORD_FN) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks, i: j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks, i: j)
    if at_symbol(toks, i: j, code: SYM_LPAREN) {
        let close = find_matching(toks, open: j, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    let sigEnd = function_signature_end(toks, start: j)
    if j < sigEnd && at_symbol(toks, i: j, code: SYM_ARROW) {
        j = j + 1
        if j < sigEnd && at_ident(toks, i: j, wid: WORD_FRESH) {
            j = j + 1
        }
        let mut rt = true
        while rt {
            let stop = at_ident(toks, i: j, wid: WORD_EFFECTS) || at_symbol(toks, i: j, code: SYM_LBRACE) || at_symbol(toks, i: j, code: SYM_EQ)
            if j < sigEnd && !stop  {
                j = j + 1
            } else {
                rt = false
            }
        }
    }
    if j < sigEnd && at_ident(toks, i: j, wid: WORD_EFFECTS) && at_symbol(toks, i: (j + 1), code: SYM_LPAREN) {
        let open = j + 1
        let close = find_matching(toks, open, openSym: SYM_LPAREN, closeSym: SYM_RPAREN)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    if j + 1 < sigEnd && at_symbol(toks, i: j, code: SYM_EQ) && at_ident(toks, i: (j + 1), wid: WORD_UNDERSCORE) {
        j = j + 2
    }
    if at_symbol(toks, i: j, code: SYM_LBRACE) {
        let close = find_matching(toks, open: j, openSym: SYM_LBRACE, closeSym: SYM_RBRACE)
        if close < 0 {
            return -1
        }
        return close + 1
    }
    return sigEnd
}

// Dotted path for module/use. Returns new index, or -1 if no leading ident.
fn parse_dotted_path(toks: List<Tok>, i: Int) -> Int {
    let mut j = take_ident_name(toks, i)
    if j < 0 {
        return -1
    }
    let mut going = true
    while going {
        if at_symbol(toks, i: j, code: SYM_DOT) {
            let j2 = take_ident_name(toks, i: (j + 1))
            if j2 < 0 {
                going = false
            } else {
                j = j2
            }
        } else {
            going = false
        }
    }
    return j
}

fn parse_module_decl(toks: List<Tok>, i: Int) -> Int {
    return parse_dotted_path(toks, i: (i + 1))
}

fn parse_use_decl(toks: List<Tok>, i: Int) -> Int {
    let mut j = parse_dotted_path(toks, i: (i + 1))
    if j < 0 {
        return -1
    }
    if at_symbol(toks, i: j, code: SYM_DOT) && at_symbol(toks, i: (j + 1), code: SYM_STAR) {
        j = j + 2
    } else if at_symbol(toks, i: j, code: SYM_STAR) {
        j = j + 1
    } else if at_ident(toks, i: j, wid: WORD_AS) {
        j = j + 1
        let j2 = take_ident_name(toks, i: j)
        if j2 >= 0 {
            j = j2
        }
    }
    return j
}

// ---------------------------------------------------------------------------
// Dispatch predicates (kept single-line-friendly per SH-017).
// ---------------------------------------------------------------------------

fn starts_type_decl(toks: List<Tok>, i: Int, isPub: Bool) -> Bool {
    if at_ident(toks, i, wid: WORD_CLASS) || at_ident(toks, i, wid: WORD_STRUCT) || at_ident(toks, i, wid: WORD_RESOURCE) || at_ident(toks, i, wid: WORD_OPAQUE) {
        return true
    }
    if isPub {
        return at_ident(toks, i: (i + 1), wid: WORD_CLASS) || at_ident(toks, i: (i + 1), wid: WORD_STRUCT) || at_ident(toks, i: (i + 1), wid: WORD_RESOURCE) || at_ident(toks, i: (i + 1), wid: WORD_OPAQUE)
    }
    return false
}

fn starts_fn_like(toks: List<Tok>, i: Int, isPub: Bool) -> Bool {
    return isPub || at_ident(toks, i, wid: WORD_ASYNC) || at_ident(toks, i, wid: WORD_NATIVE) || at_ident(toks, i, wid: WORD_FN) || at_symbol(toks, i, code: SYM_HASH)
}

// Top-level declaration classification shared by the parser and the checker
// drivers, which both dispatch on exactly these predicates at token `i`. Keeping
// the logic here (rather than duplicated in each `main`) is the single source of
// truth so the two drivers can never drift as more declaration forms are added.
struct TopClass {
    isPub: Bool
    isFeatures: Bool
    isProfile: Bool
    isSum: Bool
    isNativeMod: Bool
    isTypeAlias: Bool
    isConst: Bool
}

fn classify_top(toks: List<Tok>, i: Int) -> TopClass {
    let isPub = at_ident(toks, i, wid: WORD_PUB)
    let isFeatures = at_ident(toks, i, wid: WORD_FEATURES) && at_symbol(toks, i: (i + 1), code: SYM_COLON)
    let isProfile = at_ident(toks, i, wid: WORD_PROFILE) && at_symbol(toks, i: (i + 1), code: SYM_COLON)
    let isSum = at_ident(toks, i, wid: WORD_SUM) || (isPub && at_ident(toks, i: (i + 1), wid: WORD_SUM))
    let isNativeMod = at_ident(toks, i, wid: WORD_NATIVE) && at_ident(toks, i: (i + 1), wid: WORD_MODULE)
    let isTypeAlias = at_ident(toks, i, wid: WORD_TYPE) || (isPub && at_ident(toks, i: (i + 1), wid: WORD_TYPE))
    let isConst = at_ident(toks, i, wid: WORD_CONST) || (isPub && at_ident(toks, i: (i + 1), wid: WORD_CONST))
    return TopClass(isPub: isPub, isFeatures: isFeatures, isProfile: isProfile, isSum: isSum, isNativeMod: isNativeMod, isTypeAlias: isTypeAlias, isConst: isConst)
}
