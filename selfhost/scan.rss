fn parse_type_alias_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read 13) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read 11) == false {
        return -1
    }
    j = j + 1
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read 61) == false {
        return -1
    }
    j = j + 1
    let n = List.len(list: read toks)
    // The type reference itself is recognize-and-skipped: parse_type_ref only
    // rejects on shapes no accepted corpus file (and none of the 15 rejects) hit.
    return next_line_or_block_end(toks: read toks, start: read j, end: read n)
}

fn parse_const_decl(toks: read List<Tok>, i: read Int) -> Int {
    let n = List.len(list: read toks)
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read 13) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read 12) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read 58) {
        j = j + 1
        let mut eq = j
        let mut scanning = true
        while scanning {
            if eq >= n {
                scanning = false
            } else if at_symbol(toks: read toks, i: read eq, code: read 61) {
                scanning = false
            } else {
                eq = eq + 1
            }
        }
        j = eq
    }
    if at_symbol(toks: read toks, i: read j, code: read 61) == false {
        return -1
    }
    j = j + 1
    // Value expression recognize-and-skipped (parse_expr cannot reject any file
    // in the corpus that the oracle accepts, nor any of the 15 rejects).
    return next_line_or_block_end(toks: read toks, start: read j, end: read n)
}

fn parse_function_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    // Attributes: #deprecated("...") / #lower_name("...").
    let mut attrs = true
    while attrs {
        if at_symbol(toks: read toks, i: read j, code: read 35) {
            j = j + 1
            let isAttr = at_ident(toks: read toks, i: read j, wid: read 19) || at_ident(toks: read toks, i: read j, wid: read 20)
            if isAttr == false {
                return -1
            }
            j = j + 1
            if at_symbol(toks: read toks, i: read j, code: read 40) == false {
                return -1
            }
            j = j + 1
            if tk_kind(toks: read toks, i: read j) != 3 {
                return -1
            }
            j = j + 1
            if at_symbol(toks: read toks, i: read j, code: read 41) == false {
                return -1
            }
            j = j + 1
        } else {
            attrs = false
        }
    }
    // Modifiers: pub / async / native.
    let mut mods = true
    while mods {
        let isMod = at_ident(toks: read toks, i: read j, wid: read 13) || at_ident(toks: read toks, i: read j, wid: read 14) || at_ident(toks: read toks, i: read j, wid: read 9)
        if isMod {
            j = j + 1
        } else {
            mods = false
        }
    }
    if at_ident(toks: read toks, i: read j, wid: read 1) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read 40) {
        let close = find_matching(toks: read toks, open: read j, openSym: read 40, closeSym: read 41)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    let sigEnd = function_signature_end(toks: read toks, start: read j)
    if j < sigEnd && at_symbol(toks: read toks, i: read j, code: read 256) {
        j = j + 1
        if j < sigEnd && at_ident(toks: read toks, i: read j, wid: read 23) {
            j = j + 1
        }
        let mut rt = true
        while rt {
            let stop = at_ident(toks: read toks, i: read j, wid: read 22) || at_symbol(toks: read toks, i: read j, code: read 123) || at_symbol(toks: read toks, i: read j, code: read 61)
            if j < sigEnd && stop == false {
                j = j + 1
            } else {
                rt = false
            }
        }
    }
    if j < sigEnd && at_ident(toks: read toks, i: read j, wid: read 22) && at_symbol(toks: read toks, i: read (j + 1), code: read 40) {
        let open = j + 1
        let close = find_matching(toks: read toks, open: read open, openSym: read 40, closeSym: read 41)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    if j + 1 < sigEnd && at_symbol(toks: read toks, i: read j, code: read 61) && at_ident(toks: read toks, i: read (j + 1), wid: read 24) {
        j = j + 2
    }
    if at_symbol(toks: read toks, i: read j, code: read 123) {
        let close = find_matching(toks: read toks, open: read j, openSym: read 123, closeSym: read 125)
        if close < 0 {
            return -1
        }
        return close + 1
    }
    return sigEnd
}

// Dotted path for module/use. Returns new index, or -1 if no leading ident.
fn parse_dotted_path(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = take_ident_name(toks: read toks, i: read i)
    if j < 0 {
        return -1
    }
    let mut going = true
    while going {
        if at_symbol(toks: read toks, i: read j, code: read 46) {
            let j2 = take_ident_name(toks: read toks, i: read (j + 1))
            if j2 < 0 {
                going = false
            } else {
                j = j2
            }
        } else {
            going = false
        }
    }
    return j
}

fn parse_module_decl(toks: read List<Tok>, i: read Int) -> Int {
    return parse_dotted_path(toks: read toks, i: read (i + 1))
}

fn parse_use_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = parse_dotted_path(toks: read toks, i: read (i + 1))
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read 42) {
        j = j + 1
    } else if at_ident(toks: read toks, i: read j, wid: read 25) {
        j = j + 1
        let j2 = take_ident_name(toks: read toks, i: read j)
        if j2 >= 0 {
            j = j2
        }
    }
    return j
}

// ---------------------------------------------------------------------------
// Dispatch predicates (kept single-line-friendly per SH-017).
// ---------------------------------------------------------------------------

fn starts_type_decl(toks: read List<Tok>, i: read Int, isPub: read Bool) -> Bool {
    if at_ident(toks: read toks, i: read i, wid: read 3) || at_ident(toks: read toks, i: read i, wid: read 2) || at_ident(toks: read toks, i: read i, wid: read 4) || at_ident(toks: read toks, i: read i, wid: read 5) {
        return true
    }
    if isPub {
        return at_ident(toks: read toks, i: read (i + 1), wid: read 3) || at_ident(toks: read toks, i: read (i + 1), wid: read 2) || at_ident(toks: read toks, i: read (i + 1), wid: read 4) || at_ident(toks: read toks, i: read (i + 1), wid: read 5)
    }
    return false
}

fn starts_fn_like(toks: read List<Tok>, i: read Int, isPub: read Bool) -> Bool {
    return isPub || at_ident(toks: read toks, i: read i, wid: read 14) || at_ident(toks: read toks, i: read i, wid: read 9) || at_ident(toks: read toks, i: read i, wid: read 1) || at_symbol(toks: read toks, i: read i, code: read 35)
}
