// Self-hosted rss shared scanner prelude.
//
// This file is the single source of truth for low-level tokenization shared by
// the self-hosted lexer, parser, and checker. The single-file VM model has no
// cross-file import, so the test harness (selfhost_parity.rs) PREPENDS this file
// to each tool at compile time (scan.rss first, then the tool). `features: local`
// therefore appears here EXACTLY ONCE for the whole concatenated program.
//
// Contents:
//   * the unified `Tok` struct (carries kind, val, line, col, and identifier/
//     literal TEXT so both the parser and the checker can use it);
//   * the shared character/keyword/symbol predicates;
//   * the shared low-level scanners (comment, char, string, multiline, interp,
//     number, ident) — each returns an end index (pure scans, no emission);
//   * `word_id`, mapping declaration keywords to small ids;
//   * a single `tokenize` that builds the token list.
//
// rss constraints honored (ledger SH-016/017/018): char literals used for
// code-point tests (SH-016), long `||` predicate chains wrap across lines via
// operator/line continuation (SH-017), cursors threaded positionally.
// SH-022: string building uses StringBuilder (O(n)); the hot per-char scanners
// keep `chars: read List<Char>` DIRECT so the DeepCopy-elision holds (extracted
// Chars flow only into `Char.*` intrinsics / compares / `List.get`).

features: local

// The unified token. `kind` is one of the TOK_* constants below; `val` carries
// the symbol code (SYM_*) for symbols or the declaration-keyword id (WORD_*) for
// idents/keywords.
struct Tok {
    kind: Int
    val: Int
    line: Int
    col: Int
    text: String
}

// --- Named ids (replace the raw numeric tables the scanner/parser/checker share).
// These are the single source of truth for token kinds, symbol codes, and
// declaration-keyword ids; every `kind`/`code:`/`wid:` site refers to one of them.

// Token kinds (Tok.kind). 0 = "no token emitted this step" and -1 = "index past
// end" are sentinels, NOT token kinds, so they stay as bare literals.
const TOK_IDENT: Int = 1
const TOK_NUMBER: Int = 2
const TOK_STRING: Int = 3
const TOK_INTERP: Int = 4
const TOK_MULTILINE: Int = 5
const TOK_KEYWORD: Int = 6
const TOK_SYMBOL: Int = 7
const TOK_EOF: Int = 8
const TOK_CHAR: Int = 9
const TOK_UNKNOWN: Int = 10

// Symbol token codes (Tok.val when kind == TOK_SYMBOL): the ASCII code of the
// single char, or a synthetic code for a multi-char operator.
const SYM_HASH: Int = 35        // '#'
const SYM_LPAREN: Int = 40      // '('
const SYM_RPAREN: Int = 41      // ')'
const SYM_STAR: Int = 42        // '*'
const SYM_COMMA: Int = 44       // ','
const SYM_DOT: Int = 46         // '.'
const SYM_COLON: Int = 58       // ':'
const SYM_LANGLE: Int = 60      // '<'
const SYM_EQ: Int = 61          // '='
const SYM_RANGLE: Int = 62      // '>'
const SYM_LBRACKET: Int = 91    // '['
const SYM_RBRACKET: Int = 93    // ']'
const SYM_LBRACE: Int = 123     // '{'
const SYM_RBRACE: Int = 125     // '}'
const SYM_ARROW: Int = 256      // '->'
const SYM_FATARROW: Int = 257   // '=>'

// Declaration-keyword ids (word_id → Tok.val for the lead ident/keyword of a
// top-level declaration). 0 means "not a declaration keyword".
const WORD_FN: Int = 1
const WORD_STRUCT: Int = 2
const WORD_CLASS: Int = 3
const WORD_RESOURCE: Int = 4
const WORD_OPAQUE: Int = 5
const WORD_SUM: Int = 6
const WORD_PROTOCOL: Int = 7
const WORD_IMPL: Int = 8
const WORD_NATIVE: Int = 9
const WORD_MODULE: Int = 10
const WORD_TYPE: Int = 11
const WORD_CONST: Int = 12
const WORD_PUB: Int = 13
const WORD_ASYNC: Int = 14
const WORD_USE: Int = 15
const WORD_PROFILE: Int = 16
const WORD_FEATURES: Int = 17
const WORD_FOR: Int = 18
const WORD_DEPRECATED: Int = 19
const WORD_LOWER_NAME: Int = 20
const WORD_DERIVES: Int = 21
const WORD_EFFECTS: Int = 22
const WORD_FRESH: Int = 23
const WORD_UNDERSCORE: Int = 24
const WORD_AS: Int = 25
const WORD_LOCAL: Int = 26
const WORD_UNSAFE: Int = 27
const WORD_DEVICE: Int = 28
const WORD_FFI: Int = 29
const WORD_REFLECTION: Int = 30

// The 30 reserved keywords (crate::lexer::KEYWORDS). Contextual words
// (await, native) and builtin constants (true false Ok Err Some None Unit)
// are NOT here — they lex as Ident.
fn is_kw(word: read String) -> Bool {
    return word == "if" || word == "else" || word == "for" || word == "in"
        || word == "match" || word == "loop" || word == "while" || word == "break"
        || word == "continue" || word == "return" || word == "features" || word == "class"
        || word == "struct" || word == "resource" || word == "handle" || word == "fn"
        || word == "let" || word == "pub" || word == "async" || word == "effects"
        || word == "drop" || word == "with" || word == "as" || word == "read"
        || word == "mut" || word == "take" || word == "fresh" || word == "manage"
        || word == "weak" || word == "local"
}

// Single-char symbols the oracle recognizes (crate::lexer push_one). Any other
// char falls through to payload "?".
fn is_known_symbol(c: read Char) -> Bool {
    return c == ':' || c == ',' || c == '.' || c == '(' || c == ')'
        || c == '{' || c == '}' || c == '<' || c == '>' || c == '['
        || c == ']' || c == '?' || c == '|' || c == '&' || c == '~'
        || c == '^' || c == '+' || c == '-' || c == '*' || c == '/'
        || c == '%' || c == '=' || c == '!' || c == ';' || c == '#'
}

fn is_ident_start(c: read Char) -> Bool {
    return Char.is_alpha(value: read c) || c == '_'
}

fn is_ident_cont(c: read Char) -> Bool {
    return Char.is_alphanumeric(value: read c) || c == '_'
}

// Code point at index i, or -1 if out of bounds.
fn code_at(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    if i < n {
        let c = List.get(list: read chars, index: read i)
        return Char.to_code(value: read c)
    }
    return -1
}

// Raw substring chars[from..to].
fn slice(chars: read List<Char>, from: read Int, to: read Int) -> String {
    local out = StringBuilder.new()
    let mut k = from
    while k < to {
        let c = List.get(list: read chars, index: read k)
        StringBuilder.push(builder: mut out, value: read Char.to_string(value: read c))
        k = k + 1
    }
    return StringBuilder.finish(builder: take out)
}

// Escape a payload exactly like the harness: backslash->\\, \n, \t, \r.
fn escape(s: read String) -> String {
    let cs = String.chars(value: read s)
    let m = List.len(list: read cs)
    local out = StringBuilder.new()
    let mut k = 0
    while k < m {
        let c = List.get(list: read cs, index: read k)
        if c == '\\' {
            StringBuilder.push(builder: mut out, value: read "\\\\")
        } else if c == '\n' {
            StringBuilder.push(builder: mut out, value: read "\\n")
        } else if c == '\t' {
            StringBuilder.push(builder: mut out, value: read "\\t")
        } else if c == '\r' {
            StringBuilder.push(builder: mut out, value: read "\\r")
        } else {
            StringBuilder.push(builder: mut out, value: read Char.to_string(value: read c))
        }
        k = k + 1
    }
    return StringBuilder.finish(builder: take out)
}

// Line comment `//` to end of line (newline consumed). Returns end index.
fn scan_line_comment(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: read chars, index: read j)
            j = j + 1
            if c == '\n' {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    return j
}

// Character literal `'c'` — returns the content-end index (position of the
// closing `'`, or the newline/EOF where the scan stopped). The closing quote is
// NOT consumed by this scan; the caller advances past it. Content is
// chars[i+1..result]. Mirrors the Rust lexer's `lex_char_literal`: one `\`-escape
// is honored (a `\'` does not terminate the literal). Escapes are decoded later.
fn scan_char(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i + 1
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: read chars, index: read j)
            if c == '\'' {
                scanning = false
            } else if c == '\n' {
                scanning = false
            } else if c == '\\' {
                // Skip the backslash and its escaped char, but stay in bounds so a
                // file ending in `'\` cannot advance past `n` (mirrors scan_string /
                // scan_interp; the Rust reference lexer recovers here too).
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// String literal `"..."` — returns the content-end index (position of the
// closing quote, or n). The closing quote is NOT consumed by this scan; the
// caller advances past it. Content is chars[i+1..result].
fn scan_string(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 1
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: read chars, index: read j)
            if c == '"' {
                scanning = false
            } else if c == '\\' {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// Multiline string `"""..."""` — returns the content-end index (position of the
// closing `"""`, or n). Content is chars[i+3..result]; delimiter not consumed.
fn scan_multiline(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 3
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c0 = List.get(list: read chars, index: read j)
            let mut triple = false
            if c0 == '"' && j + 2 < n {
                let cc1 = List.get(list: read chars, index: read (j + 1))
                let cc2 = List.get(list: read chars, index: read (j + 2))
                triple = cc1 == '"' && cc2 == '"'
            }
            if triple {
                scanning = false
            } else {
                j = j + 1
            }
        }
    }
    return j
}

// Interpolated string `$"..."` — returns the content-end index (position of the
// closing quote, or n). Content is chars[i+2..result]; delimiter not consumed.
// Brace-depth scan mirrors crate::lexer::lex_interpolated_string.
fn scan_interp(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 2
    let mut j = start
    let mut depth = 0
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c = List.get(list: read chars, index: read j)
            if c == '"' && depth == 0 {
                scanning = false
            } else if c == '\\' {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else if depth > 0 && c == '"' {
                j = j + 1
                let mut inner = true
                while inner {
                    if j >= n {
                        inner = false
                    } else {
                        let sc = List.get(list: read chars, index: read j)
                        if sc == '\\' {
                            j = j + 1
                            if j < n {
                                j = j + 1
                            }
                        } else {
                            j = j + 1
                            if sc == '"' {
                                inner = false
                            }
                        }
                    }
                }
            } else if c == '{' && depth == 0 && code_at(chars: read chars, n: read n, i: read (j + 1)) == 123 {
                j = j + 2
            } else if c == '}' && depth == 0 && code_at(chars: read chars, n: read n, i: read (j + 1)) == 125 {
                j = j + 2
            } else {
                if c == '{' {
                    depth = depth + 1
                } else if c == '}' {
                    if depth > 0 {
                        depth = depth - 1
                    }
                }
                j = j + 1
            }
        }
    }
    return j
}

// Number: integer digits, optional single `.` followed by >=1 digit.
// Returns the end index; content is chars[i..result].
fn scan_number(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: read chars, index: read j)
            if Char.is_digit(value: read c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    let mut dot = false
    if j < n {
        let cdot = List.get(list: read chars, index: read j)
        dot = cdot == '.'
    }
    if dot {
        let after = j + 1
        if after < n {
            let cd = List.get(list: read chars, index: read after)
            if Char.is_digit(value: read cd) {
                j = after
                let mut frac = true
                while frac {
                    if j < n {
                        let c = List.get(list: read chars, index: read j)
                        if Char.is_digit(value: read c) {
                            j = j + 1
                        } else {
                            frac = false
                        }
                    } else {
                        frac = false
                    }
                }
            }
        }
    }
    return j
}

// Ident or keyword. Returns the end index; content is chars[i..result].
fn scan_ident(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: read chars, index: read j)
            if is_ident_cont(c: read c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    return j
}

// Map an identifier/keyword's text to a small word id the tools recognize.
// Anything the tools never check by name maps to 0.
fn word_id(word: read String) -> Int {
    if word == "fn" { return 1 }
    if word == "struct" { return 2 }
    if word == "class" { return 3 }
    if word == "resource" { return 4 }
    if word == "opaque" { return 5 }
    if word == "sum" { return 6 }
    if word == "protocol" { return 7 }
    if word == "impl" { return 8 }
    if word == "native" { return 9 }
    if word == "module" { return 10 }
    if word == "type" { return 11 }
    if word == "const" { return 12 }
    if word == "pub" { return 13 }
    if word == "async" { return 14 }
    if word == "use" { return 15 }
    if word == "profile" { return 16 }
    if word == "features" { return 17 }
    if word == "for" { return 18 }
    if word == "deprecated" { return 19 }
    if word == "lower_name" { return 20 }
    if word == "derives" { return 21 }
    if word == "effects" { return 22 }
    if word == "fresh" { return 23 }
    if word == "_" { return 24 }
    if word == "as" { return 25 }
    if word == "local" { return 26 }
    if word == "unsafe" { return 27 }
    if word == "device" { return 28 }
    if word == "ffi" { return 29 }
    if word == "reflection" { return 30 }
    return 0
}

// Build the token list. Each token carries kind, val, line, col, and text.
// SH-019: returns a `fresh List<Tok>` built via List.new + List.push + return.
fn tokenize(source: read String) -> fresh List<Tok> {
    let chars = String.chars(value: read source)
    let n = List.len(list: read chars)
    let mut toks = List.new<Tok>()
    let mut i = 0
    let mut curLine = 1
    let mut curCol = 1
    while i < n {
        let startLine = curLine
        let startCol = curCol
        let c = List.get(list: read chars, index: read i)
        let c1 = code_at(chars: read chars, n: read n, i: read (i + 1))
        let c2 = code_at(chars: read chars, n: read n, i: read (i + 2))
        let mut j = i
        let mut kind = 0
        let mut val = 0
        let mut text = ""
        if Char.is_whitespace(value: read c) {
            j = i + 1
            kind = 0
        } else if c == '/' && c1 == 47 {
            j = scan_line_comment(chars: read chars, n: read n, i: read i)
            kind = 0
        } else if c == '"' && c1 == 34 && c2 == 34 {
            let cend = scan_multiline(chars: read chars, n: read n, i: read i)
            text = slice(chars: read chars, from: read (i + 3), to: read cend)
            kind = TOK_MULTILINE
            let d0 = code_at(chars: read chars, n: read n, i: read cend)
            let d1 = code_at(chars: read chars, n: read n, i: read (cend + 1))
            let d2 = code_at(chars: read chars, n: read n, i: read (cend + 2))
            if d0 == 34 && d1 == 34 && d2 == 34 {
                j = cend + 3
            } else {
                j = cend
            }
        } else if c == '$' && c1 == 34 {
            let cend = scan_interp(chars: read chars, n: read n, i: read i)
            text = slice(chars: read chars, from: read (i + 2), to: read cend)
            kind = TOK_INTERP
            if code_at(chars: read chars, n: read n, i: read cend) == 34 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if c == '"' {
            let cend = scan_string(chars: read chars, n: read n, i: read i)
            text = slice(chars: read chars, from: read (i + 1), to: read cend)
            kind = TOK_STRING
            if code_at(chars: read chars, n: read n, i: read cend) == 34 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if c == '\'' {
            let cend = scan_char(chars: read chars, n: read n, i: read i)
            text = slice(chars: read chars, from: read (i + 1), to: read cend)
            kind = TOK_CHAR
            if code_at(chars: read chars, n: read n, i: read cend) == 39 {
                j = cend + 1
            } else {
                j = cend
            }
        } else if Char.is_digit(value: read c) {
            j = scan_number(chars: read chars, n: read n, i: read i)
            kind = TOK_NUMBER
            text = slice(chars: read chars, from: read i, to: read j)
        } else if is_ident_start(c: read c) {
            j = scan_ident(chars: read chars, n: read n, i: read i)
            let word = slice(chars: read chars, from: read i, to: read j)
            if is_kw(word: read word) {
                kind = TOK_KEYWORD
            } else {
                kind = TOK_IDENT
            }
            val = word_id(word: read word)
            text = word
        } else if c == '-' && c1 == 62 {
            j = i + 2
            kind = TOK_SYMBOL
            val = SYM_ARROW
            text = "->"
        } else if c == '=' && c1 == 62 {
            j = i + 2
            kind = TOK_SYMBOL
            val = SYM_FATARROW
            text = "=>"
        } else {
            j = i + 1
            if is_known_symbol(c: read c) {
                kind = TOK_SYMBOL
                val = Char.to_code(value: read c)
                text = Char.to_string(value: read c)
            } else {
                // Outside the lexical inventory: emit an Unknown token carrying the
                // raw char (kind 10), mirroring crate::lexer's TokenKind::Unknown.
                // (Previously mapped to Symbol "?", which aliased a stray char to
                // the try operator.)
                kind = TOK_UNKNOWN
                val = Char.to_code(value: read c)
                text = Char.to_string(value: read c)
            }
        }
        if kind != 0 {
            let t = Tok(kind: kind, val: val, line: startLine, col: startCol, text: text)
            List.push(list: mut toks, value: read t)
        }
        // Advance line/col over the consumed span [i, j).
        let mut k = i
        while k < j {
            let ch = List.get(list: read chars, index: read k)
            if ch == '\n' {
                curLine = curLine + 1
                curCol = 1
            } else {
                curCol = curCol + 1
            }
            k = k + 1
        }
        i = j
    }
    let eof = Tok(kind: TOK_EOF, val: 0, line: curLine, col: curCol, text: "")
    List.push(list: mut toks, value: read eof)
    return toks
}

// ---------------------------------------------------------------------------
// Token accessors and declaration-boundary helpers shared by the parser and
// checker (byte-identical in both tools before dedup). Out-of-range reads
// return kind -1 (treated as "nothing").
// ---------------------------------------------------------------------------

fn tk_kind(toks: read List<Tok>, i: read Int) -> Int {
    if i < 0 { return -1 }
    if i >= List.len(list: read toks) { return -1 }
    let t = List.get(list: read toks, index: read i)
    return t.kind
}

fn tk_val(toks: read List<Tok>, i: read Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: read toks) { return 0 }
    let t = List.get(list: read toks, index: read i)
    return t.val
}

fn tk_line(toks: read List<Tok>, i: read Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: read toks) { return 0 }
    let t = List.get(list: read toks, index: read i)
    return t.line
}

fn is_ident_tok(toks: read List<Tok>, i: read Int) -> Bool {
    let k = tk_kind(toks: read toks, i: read i)
    return k == 1 || k == 6
}

// at_ident: token i is an Ident/Keyword with the given word id.
fn at_ident(toks: read List<Tok>, i: read Int, wid: read Int) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) {
        return tk_val(toks: read toks, i: read i) == wid
    }
    return false
}

// at_symbol: token i is a Symbol with the given symbol code.
fn at_symbol(toks: read List<Tok>, i: read Int, code: read Int) -> Bool {
    if tk_kind(toks: read toks, i: read i) == TOK_SYMBOL {
        return tk_val(toks: read toks, i: read i) == code
    }
    return false
}

fn find_matching(toks: read List<Tok>, open: read Int, openSym: read Int, closeSym: read Int) -> Int {
    if at_symbol(toks: read toks, i: read open, code: read openSym) == false {
        return -1
    }
    let n = List.len(list: read toks)
    let mut depth = 0
    let mut idx = open
    let mut result = -1
    let mut scanning = true
    while scanning {
        if idx >= n {
            scanning = false
        } else {
            if at_symbol(toks: read toks, i: read idx, code: read openSym) {
                depth = depth + 1
            } else if at_symbol(toks: read toks, i: read idx, code: read closeSym) {
                depth = depth - 1
                if depth == 0 {
                    result = idx
                    scanning = false
                }
            }
            idx = idx + 1
        }
    }
    return result
}

fn declaration_line_end(toks: read List<Tok>, start: read Int) -> Int {
    let n = List.len(list: read toks)
    if start >= n {
        return start
    }
    let line = tk_line(toks: read toks, i: read start)
    let mut idx = start
    while idx < n {
        if tk_line(toks: read toks, i: read idx) > line {
            return idx
        }
        if tk_kind(toks: read toks, i: read idx) == TOK_EOF {
            return idx
        }
        idx = idx + 1
    }
    return n
}

fn next_line_or_block_end(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    if start >= end {
        return end
    }
    let line = tk_line(toks: read toks, i: read start)
    let mut idx = start
    while idx < end {
        if tk_line(toks: read toks, i: read idx) > line {
            return idx
        }
        idx = idx + 1
    }
    return end
}

fn starts_top_level_item(toks: read List<Tok>, index: read Int) -> Bool {
    let n = List.len(list: read toks)
    if index < 0 || index >= n {
        return false
    }
    if index > 0 && tk_line(toks: read toks, i: read (index - 1)) == tk_line(toks: read toks, i: read index) {
        return false
    }
    if is_ident_tok(toks: read toks, i: read index) == false {
        return false
    }
    let v = tk_val(toks: read toks, i: read index)
    return v == 17 || v == 16 || v == 3 || v == 2 || v == 4 || v == 1 || v == 13 || v == 14 || v == 9 || v == 7 || v == 8
}

fn function_signature_end(toks: read List<Tok>, start: read Int) -> Int {
    let n = List.len(list: read toks)
    let mut depth = 0
    let mut idx = start
    while idx < n {
        if depth == 0 && at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACE) {
            return idx
        }
        if depth == 0 && at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACE) {
            return idx
        }
        if idx > start && depth == 0 && starts_top_level_item(toks: read toks, index: read idx) {
            return idx
        }
        let opener = at_symbol(toks: read toks, i: read idx, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read idx, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read idx, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read idx, code: read SYM_RANGLE)
        if opener {
            depth = depth + 1
        } else if closer {
            if depth > 0 {
                depth = depth - 1
            }
        }
        if tk_kind(toks: read toks, i: read idx) == TOK_EOF {
            return idx
        }
        idx = idx + 1
    }
    return n
}

// ---------------------------------------------------------------------------
// Name helpers. Return the new index, or -1 on failure.
// ---------------------------------------------------------------------------

fn take_ident_name(toks: read List<Tok>, i: read Int) -> Int {
    if is_ident_tok(toks: read toks, i: read i) {
        return i + 1
    }
    return -1
}

fn take_function_name(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = take_ident_name(toks: read toks, i: read i)
    if j < 0 {
        return -1
    }
    let mut going = true
    while going {
        if at_symbol(toks: read toks, i: read j, code: read SYM_DOT) {
            let j2 = take_ident_name(toks: read toks, i: read (j + 1))
            if j2 < 0 {
                return -1
            }
            j = j2
        } else {
            going = false
        }
    }
    return j
}

fn parse_generic_params(toks: read List<Tok>, i: read Int) -> Int {
    if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) == false {
        return i
    }
    let close = find_matching(toks: read toks, open: read i, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 {
        return i
    }
    return close + 1
}

fn parse_derives(toks: read List<Tok>, i: read Int) -> Int {
    if at_ident(toks: read toks, i: read i, wid: read WORD_DERIVES) == false {
        return i
    }
    let j = i + 1
    if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) == false {
        return j
    }
    let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 {
        return j
    }
    return close + 1
}

// ---------------------------------------------------------------------------
// Declaration parsers. Return new index on success, or -1 = malformed.
// ---------------------------------------------------------------------------

fn parse_type_decl(toks: read List<Tok>, i: read Int) -> Int {
    let startLine = tk_line(toks: read toks, i: read i)
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_OPAQUE) {
        j = j + 1
    }
    let isKind = at_ident(toks: read toks, i: read j, wid: read WORD_CLASS) || at_ident(toks: read toks, i: read j, wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read j, wid: read WORD_RESOURCE)
    if isKind == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    j = parse_derives(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
        let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if close < 0 {
            return -1
        }
        return close + 1
    }
    let n = List.len(list: read toks)
    if j < n && tk_line(toks: read toks, i: read j) == startLine {
        return declaration_line_end(toks: read toks, start: read j)
    }
    return j
}

fn parse_sum_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_SUM) == false {
        return -1
    }
    j = j + 1
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    j = parse_derives(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_protocol_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i + 1
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_impl_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i + 1
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_FOR) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_native_module_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i + 2
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) == false {
        return -1
    }
    let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    if close < 0 {
        return -1
    }
    return close + 1
}

fn parse_type_alias_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_TYPE) == false {
        return -1
    }
    j = j + 1
    j = take_ident_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read SYM_EQ) == false {
        return -1
    }
    j = j + 1
    let n = List.len(list: read toks)
    // The type reference itself is recognize-and-skipped: parse_type_ref only
    // rejects on shapes no accepted corpus file (nor any rejected-corpus file) hit.
    return next_line_or_block_end(toks: read toks, start: read j, end: read n)
}

fn parse_const_decl(toks: read List<Tok>, i: read Int) -> Int {
    let n = List.len(list: read toks)
    let mut j = i
    if at_ident(toks: read toks, i: read j, wid: read WORD_PUB) {
        j = j + 1
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_CONST) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_COLON) {
        j = j + 1
        let mut eq = j
        let mut scanning = true
        while scanning {
            if eq >= n {
                scanning = false
            } else if at_symbol(toks: read toks, i: read eq, code: read SYM_EQ) {
                scanning = false
            } else {
                eq = eq + 1
            }
        }
        j = eq
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_EQ) == false {
        return -1
    }
    j = j + 1
    // Value expression recognize-and-skipped (parse_expr cannot reject any file
    // in the corpus that the oracle accepts, nor any rejected-corpus file).
    return next_line_or_block_end(toks: read toks, start: read j, end: read n)
}

fn parse_function_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = i
    // Attributes: #deprecated("...") / #lower_name("...").
    let mut attrs = true
    while attrs {
        if at_symbol(toks: read toks, i: read j, code: read SYM_HASH) {
            j = j + 1
            let isAttr = at_ident(toks: read toks, i: read j, wid: read WORD_DEPRECATED) || at_ident(toks: read toks, i: read j, wid: read WORD_LOWER_NAME)
            if isAttr == false {
                return -1
            }
            j = j + 1
            if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) == false {
                return -1
            }
            j = j + 1
            if tk_kind(toks: read toks, i: read j) != TOK_STRING {
                return -1
            }
            j = j + 1
            if at_symbol(toks: read toks, i: read j, code: read SYM_RPAREN) == false {
                return -1
            }
            j = j + 1
        } else {
            attrs = false
        }
    }
    // Modifiers: pub / async / native.
    let mut mods = true
    while mods {
        let isMod = at_ident(toks: read toks, i: read j, wid: read WORD_PUB) || at_ident(toks: read toks, i: read j, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read j, wid: read WORD_NATIVE)
        if isMod {
            j = j + 1
        } else {
            mods = false
        }
    }
    if at_ident(toks: read toks, i: read j, wid: read WORD_FN) == false {
        return -1
    }
    j = j + 1
    j = take_function_name(toks: read toks, i: read j)
    if j < 0 {
        return -1
    }
    j = parse_generic_params(toks: read toks, i: read j)
    if at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    let sigEnd = function_signature_end(toks: read toks, start: read j)
    if j < sigEnd && at_symbol(toks: read toks, i: read j, code: read SYM_ARROW) {
        j = j + 1
        if j < sigEnd && at_ident(toks: read toks, i: read j, wid: read WORD_FRESH) {
            j = j + 1
        }
        let mut rt = true
        while rt {
            let stop = at_ident(toks: read toks, i: read j, wid: read WORD_EFFECTS) || at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read j, code: read SYM_EQ)
            if j < sigEnd && stop == false {
                j = j + 1
            } else {
                rt = false
            }
        }
    }
    if j < sigEnd && at_ident(toks: read toks, i: read j, wid: read WORD_EFFECTS) && at_symbol(toks: read toks, i: read (j + 1), code: read SYM_LPAREN) {
        let open = j + 1
        let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close < 0 {
            return -1
        }
        j = close + 1
    }
    if j + 1 < sigEnd && at_symbol(toks: read toks, i: read j, code: read SYM_EQ) && at_ident(toks: read toks, i: read (j + 1), wid: read WORD_UNDERSCORE) {
        j = j + 2
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_LBRACE) {
        let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if close < 0 {
            return -1
        }
        return close + 1
    }
    return sigEnd
}

// Dotted path for module/use. Returns new index, or -1 if no leading ident.
fn parse_dotted_path(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = take_ident_name(toks: read toks, i: read i)
    if j < 0 {
        return -1
    }
    let mut going = true
    while going {
        if at_symbol(toks: read toks, i: read j, code: read SYM_DOT) {
            let j2 = take_ident_name(toks: read toks, i: read (j + 1))
            if j2 < 0 {
                going = false
            } else {
                j = j2
            }
        } else {
            going = false
        }
    }
    return j
}

fn parse_module_decl(toks: read List<Tok>, i: read Int) -> Int {
    return parse_dotted_path(toks: read toks, i: read (i + 1))
}

fn parse_use_decl(toks: read List<Tok>, i: read Int) -> Int {
    let mut j = parse_dotted_path(toks: read toks, i: read (i + 1))
    if j < 0 {
        return -1
    }
    if at_symbol(toks: read toks, i: read j, code: read SYM_STAR) {
        j = j + 1
    } else if at_ident(toks: read toks, i: read j, wid: read WORD_AS) {
        j = j + 1
        let j2 = take_ident_name(toks: read toks, i: read j)
        if j2 >= 0 {
            j = j2
        }
    }
    return j
}

// ---------------------------------------------------------------------------
// Dispatch predicates (kept single-line-friendly per SH-017).
// ---------------------------------------------------------------------------

fn starts_type_decl(toks: read List<Tok>, i: read Int, isPub: read Bool) -> Bool {
    if at_ident(toks: read toks, i: read i, wid: read WORD_CLASS) || at_ident(toks: read toks, i: read i, wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read i, wid: read WORD_RESOURCE) || at_ident(toks: read toks, i: read i, wid: read WORD_OPAQUE) {
        return true
    }
    if isPub {
        return at_ident(toks: read toks, i: read (i + 1), wid: read WORD_CLASS) || at_ident(toks: read toks, i: read (i + 1), wid: read WORD_STRUCT) || at_ident(toks: read toks, i: read (i + 1), wid: read WORD_RESOURCE) || at_ident(toks: read toks, i: read (i + 1), wid: read WORD_OPAQUE)
    }
    return false
}

fn starts_fn_like(toks: read List<Tok>, i: read Int, isPub: read Bool) -> Bool {
    return isPub || at_ident(toks: read toks, i: read i, wid: read WORD_ASYNC) || at_ident(toks: read toks, i: read i, wid: read WORD_NATIVE) || at_ident(toks: read toks, i: read i, wid: read WORD_FN) || at_symbol(toks: read toks, i: read i, code: read SYM_HASH)
}

// Top-level declaration classification shared by the parser and the checker
// drivers, which both dispatch on exactly these predicates at token `i`. Keeping
// the logic here (rather than duplicated in each `main`) is the single source of
// truth so the two drivers can never drift as more declaration forms are added.
struct TopClass {
    isPub: Bool
    isFeatures: Bool
    isProfile: Bool
    isSum: Bool
    isNativeMod: Bool
    isTypeAlias: Bool
    isConst: Bool
}

fn classify_top(toks: read List<Tok>, i: read Int) -> TopClass {
    let isPub = at_ident(toks: read toks, i: read i, wid: read WORD_PUB)
    let isFeatures = at_ident(toks: read toks, i: read i, wid: read WORD_FEATURES) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON)
    let isProfile = at_ident(toks: read toks, i: read i, wid: read WORD_PROFILE) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON)
    let isSum = at_ident(toks: read toks, i: read i, wid: read WORD_SUM) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_SUM))
    let isNativeMod = at_ident(toks: read toks, i: read i, wid: read WORD_NATIVE) && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_MODULE)
    let isTypeAlias = at_ident(toks: read toks, i: read i, wid: read WORD_TYPE) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_TYPE))
    let isConst = at_ident(toks: read toks, i: read i, wid: read WORD_CONST) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_CONST))
    return TopClass(isPub: isPub, isFeatures: isFeatures, isProfile: isProfile, isSum: isSum, isNativeMod: isNativeMod, isTypeAlias: isTypeAlias, isConst: isConst)
}
