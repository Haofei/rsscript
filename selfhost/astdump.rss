// Self-hosted rss AST-dump producer — step 2 of frontend object parity.
//
// Streams the canonical AST dump defined in selfhost/AST_FORMAT.md, matching the
// Rust oracle (crate::syntax::parse_source_raw serialized by crate::selfhost_parity)
// byte-for-byte at tier 0. Reads rss source as argv[0]; prints the dump.
//
// KEY DESIGN: the AST dump is a pre-order traversal, so this recursive-descent
// parser STREAMS the dump directly — no handle-based AST is materialized. Each
// parse fn emits its node line(s) at a threaded `depth` and returns the token
// index just past what it consumed (the same cursor convention as the recognition
// parser in scan.rss). The shared tokenizer / accessors / constants come from the
// prepended scan.rss prelude.
//
// COVERAGE: this is a growing core, not yet full-grammar. It targets the curated
// samples under selfhost/samples/ast/ (byte-exact, gated non-ignored) and is
// measured unaided over the whole corpus by the ignored ast_parity_corpus gate.
// Constructs outside the core emit `unknown-expr`/`unknown-stmt` markers rather
// than desyncing — divergences are tracked as SH-025.
//
// rss constraints honored (SH-016/017/018): char literals, `||` chains kept on one
// line / wrapped via operator continuation, cursors threaded positionally.

// Symbol codes not already named in scan.rss (single-char ASCII).
const SYM_QUESTION: Int = 63    // '?'
const SYM_BANG: Int = 33        // '!'
const SYM_TILDE: Int = 126      // '~'
const SYM_SEMI: Int = 59        // ';'
const SYM_AMP: Int = 38         // '&'
const SYM_PIPE: Int = 124       // '|'
const SYM_PLUS: Int = 43        // '+'
const SYM_MINUS: Int = 45       // '-'
const SYM_SLASH: Int = 47       // '/'
const SYM_CARET: Int = 94       // '^'
const SYM_PERCENT: Int = 37     // '%'

// -------------------------------------------------------------------------
// Emit helpers.
// -------------------------------------------------------------------------

fn indent(depth: read Int) -> String {
    local sb = StringBuilder.new()
    let mut k = 0
    while k < depth {
        StringBuilder.push(builder: mut sb, value: read "  ")
        k = k + 1
    }
    return StringBuilder.finish(builder: take sb)
}

fn emit(depth: read Int, s: read String) -> Unit {
    let line = String.concat(left: read indent(depth: read depth), right: read s)
    Log.write(message: read line)
    return Unit
}

fn tk_text(toks: read List<Tok>, i: read Int) -> String {
    if i < 0 { return "" }
    if i >= List.len(list: read toks) { return "" }
    let t = List.get(list: read toks, index: read i)
    return t.text
}

// bool -> "true"/"false" for attribute values.
fn boolstr(b: read Bool) -> String {
    if b { return "true" }
    return "false"
}

// -------------------------------------------------------------------------
// Expression parser (range-based, mirrors crate::syntax::parser::expr).
// emit_expr renders the expression occupying tokens [start, end) at depth d.
// -------------------------------------------------------------------------

// Last top-level operator index for the lowest-precedence tier present in
// [start, end), or -1. `tier` selects the operator group (see find_binop).
// Tracks (){}[ ] bracket depth; operators only count at depth 0.
fn scan_last_top_op(toks: read List<Tok>, start: read Int, end: read Int, tier: read Int) -> Int {
    let mut depth = 0
    let mut angle = 0
    let mut idx = start
    let mut found = -1
    while idx < end {
        if at_symbol(toks: read toks, i: read idx, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read idx, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read idx, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read idx, code: read SYM_LANGLE) && is_generic_angle(toks: read toks, start: read start, end: read end, open: read idx) {
            // A generic `<...>` (e.g. `Deque<Int>.new()`) — count its angles so its
            // `<`/`>` are never mistaken for comparison operators.
            angle = angle + 1
        } else if depth == 0 && angle > 0 {
            if at_symbol(toks: read toks, i: read idx, code: read SYM_LANGLE) { angle = angle + 1 }
            else if at_symbol(toks: read toks, i: read idx, code: read SYM_RANGLE) { angle = angle - 1 }
        } else if depth == 0 {
            if op_matches_tier(toks: read toks, i: read idx, end: read end, tier: read tier) {
                found = idx
            }
        }
        idx = idx + 1
    }
    return found
}

// Mirrors is_generic_angle_open: token `open` is `<`, preceded by an ident, and
// its matching `>` (by angle nesting) is followed by `.` or `(` — i.e. it opens a
// generic argument list, not a comparison.
fn is_generic_angle(toks: read List<Tok>, start: read Int, end: read Int, open: read Int) -> Bool {
    if open <= start { return false }
    if is_ident_tok(toks: read toks, i: read (open - 1)) == false { return false }
    if at_symbol(toks: read toks, i: read open, code: read SYM_LANGLE) == false { return false }
    let mut depth = 0
    let mut i = open
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            depth = depth - 1
            if depth == 0 {
                return at_symbol(toks: read toks, i: read (i + 1), code: read SYM_DOT) || at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN)
            }
        }
        i = i + 1
    }
    return false
}

// Does the operator at token i (within [.., end)) belong to precedence `tier`?
// tier: 1=|| 2=&& 3=| 4=^ 5=& 6=cmp(== != <= >= < >) 7=shift(<< >>) 8=+ - 9=* / %
fn op_matches_tier(toks: read List<Tok>, i: read Int, end: read Int, tier: read Int) -> Bool {
    if tier == 1 { return two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) }
    if tier == 2 { return two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) }
    if tier == 3 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) == false
    }
    if tier == 4 { return at_symbol(toks: read toks, i: read i, code: read SYM_CARET) }
    if tier == 5 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_AMP) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) == false
    }
    if tier == 6 {
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_EQ, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_BANG, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_EQ) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_EQ) { return true }
        // bare < or > (not part of << >> which tier 7 owns, and not <= >=)
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) == false { return true }
        if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) && two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) == false { return true }
        return false
    }
    if tier == 7 {
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) { return true }
        if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) { return true }
        return false
    }
    if tier == 8 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_PLUS) || at_symbol(toks: read toks, i: read i, code: read SYM_MINUS)
    }
    if tier == 9 {
        return at_symbol(toks: read toks, i: read i, code: read SYM_STAR) || at_symbol(toks: read toks, i: read i, code: read SYM_SLASH) || at_symbol(toks: read toks, i: read i, code: read SYM_PERCENT)
    }
    return false
}

// Two consecutive symbol tokens a,b at i (both within end).
fn two_sym(toks: read List<Tok>, i: read Int, end: read Int, a: read Int, b: read Int) -> Bool {
    if i + 1 >= end { return false }
    return at_symbol(toks: read toks, i: read i, code: read a) && at_symbol(toks: read toks, i: read (i + 1), code: read b)
}

// Dump op name for the operator at index i (assumes it is a real binop split point).
fn binop_name_at(toks: read List<Tok>, i: read Int, end: read Int) -> String {
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) { return "logical-or" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) { return "logical-and" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_EQ, b: read SYM_EQ) { return "equal" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_BANG, b: read SYM_EQ) { return "not-equal" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_EQ) { return "less-equal" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_EQ) { return "greater-equal" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) { return "shift-left" }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) { return "shift-right" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) { return "bit-or" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_CARET) { return "bit-xor" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_AMP) { return "bit-and" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) { return "less" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) { return "greater" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_PLUS) { return "add" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_MINUS) { return "subtract" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_STAR) { return "multiply" }
    if at_symbol(toks: read toks, i: read i, code: read SYM_SLASH) { return "divide" }
    return "modulo"
}

// Token width of the operator at i (1 or 2).
fn binop_width_at(toks: read List<Tok>, i: read Int, end: read Int) -> Int {
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_PIPE, b: read SYM_PIPE) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_AMP, b: read SYM_AMP) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_EQ, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_BANG, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_EQ) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_LANGLE, b: read SYM_LANGLE) { return 2 }
    if two_sym(toks: read toks, i: read i, end: read end, a: read SYM_RANGLE, b: read SYM_RANGLE) { return 2 }
    return 1
}

// Lowest-precedence top-level operator split index in [start, end), or -1.
fn find_binop(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut tier = 1
    while tier <= 9 {
        let hit = scan_last_top_op(toks: read toks, start: read start, end: read end, tier: read tier)
        if hit >= 0 { return hit }
        tier = tier + 1
    }
    return -1
}

fn emit_expr(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    // Trim parens wrapping the whole range: (expr) -> expr.
    let mut s = start
    let mut e = end
    let mut trimming = true
    while trimming {
        if s < e && at_symbol(toks: read toks, i: read s, code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read s, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close == e - 1 {
                s = s + 1
                e = close
            } else {
                trimming = false
            }
        } else {
            trimming = false
        }
    }
    if s >= e {
        emit(depth: read d, s: read "unknown-expr")
        return Unit
    }
    // Negative number literal: `-` <number> exactly (before binary/closure, as in
    // parse_expr) so it doesn't split as subtraction.
    if e - s == 2 && at_symbol(toks: read toks, i: read s, code: read SYM_MINUS) && tk_kind(toks: read toks, i: read (s + 1)) == TOK_NUMBER {
        emit(depth: read d, s: read String.concat(left: read "number -", right: read escape(s: read tk_text(toks: read toks, i: read (s + 1)))))
        return Unit
    }
    // Closure `|params| body` — checked before binary split so its `|` pipes are
    // not read as bit-or (matches parse_expr's ordering).
    if at_symbol(toks: read toks, i: read s, code: read SYM_PIPE) {
        emit_closure(toks: read toks, start: read s, end: read e, d: read d)
        return Unit
    }
    // Explicit closure: `fn(params) captures(...) [effects(...)] { body }`.
    if is_kw_text(toks: read toks, i: read s, word: read "fn") && at_symbol(toks: read toks, i: read (s + 1), code: read SYM_LPAREN) {
        emit_explicit_fn(toks: read toks, start: read s, end: read e, d: read d)
        return Unit
    }
    // Binary split (lowest precedence, last top-level occurrence).
    let opIdx = find_binop(toks: read toks, start: read s, end: read e)
    if opIdx >= 0 {
        let name = binop_name_at(toks: read toks, i: read opIdx, end: read e)
        let w = binop_width_at(toks: read toks, i: read opIdx, end: read e)
        emit(depth: read d, s: read String.concat(left: read "binary op=", right: read name))
        emit_expr(toks: read toks, start: read s, end: read opIdx, d: read (d + 1))
        emit_expr(toks: read toks, start: read (opIdx + w), end: read e, d: read (d + 1))
        return Unit
    }
    // Prefix `!x` desugars to `x == false`; `~x` to `Int.bit_not(value: x)`.
    if at_symbol(toks: read toks, i: read s, code: read SYM_BANG) {
        emit(depth: read d, s: read "binary op=equal")
        emit_unary_operand(toks: read toks, start: read (s + 1), end: read e, d: read (d + 1))
        emit(depth: read (d + 1), s: read "ident false")
        return Unit
    }
    if at_symbol(toks: read toks, i: read s, code: read SYM_TILDE) {
        emit(depth: read d, s: read "call")
        emit(depth: read (d + 1), s: read "callee-qualified namespace=Int name=bit_not")
        emit(depth: read (d + 1), s: read "arg name=value")
        emit_unary_operand(toks: read toks, start: read (s + 1), end: read e, d: read (d + 2))
        return Unit
    }
    // Trailing top-level `?` => try.
    if at_symbol(toks: read toks, i: read (e - 1), code: read SYM_QUESTION) {
        emit(depth: read d, s: read "try")
        emit_expr(toks: read toks, start: read s, end: read (e - 1), d: read (d + 1))
        return Unit
    }
    // Match expression: match [effect] value { arms }.
    if is_kw_text(toks: read toks, i: read s, word: read "match") && at_symbol(toks: read toks, i: read (e - 1), code: read SYM_RBRACE) {
        let braceOpen = matching_open_brace(toks: read toks, close: read (e - 1), start: read s)
        if braceOpen > s {
            emit_match(toks: read toks, matchPos: read s, braceOpen: read braceOpen, braceClose: read (e - 1), tag: read "match-expr", d: read d)
            return Unit
        }
    }
    // Effect prefix: read/mut/take <value>. The receiver-call shorthand
    // `<effect> recv.method(args)` (lowercase receiver) parses as a ReceiverCall,
    // NOT an Effect wrapper; an uppercase namespace (`read Cache.put()`) stays a
    // qualified call under the effect.
    let effWord = effect_kw(toks: read toks, i: read s)
    if String.len(value: read effWord) > 0 {
        let recvStart = s + 1
        if at_symbol(toks: read toks, i: read recvStart, code: read SYM_BANG) == false {
            let dot = find_receiver_call_dot(toks: read toks, recvStart: read recvStart, end: read e)
            if dot > recvStart && is_qualified_ns_receiver(toks: read toks, start: read recvStart, dot: read dot) == false {
                let mpos = dot + 1
                let open = find_call_open(toks: read toks, start: read mpos, end: read e)
                let method = named_segment_str(toks: read toks, start: read mpos, end: read open)
                if open > 0 && String.len(value: read method) > 0 {
                    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                    emit(depth: read d, s: read "call")
                    let cl = String.concat(left: read "callee-receiver method=", right: read method)
                    emit(depth: read (d + 1), s: read String.concat(left: read String.concat(left: read cl, right: read " effect="), right: read effWord))
                    emit_expr(toks: read toks, start: read recvStart, end: read dot, d: read (d + 2))
                    emit_args(toks: read toks, start: read (open + 1), end: read close, d: read (d + 1))
                    return Unit
                }
            }
        }
        emit(depth: read d, s: read String.concat(left: read "effect kind=", right: read effWord))
        emit_expr(toks: read toks, start: read (s + 1), end: read e, d: read (d + 1))
        return Unit
    }
    // Prefix expression forms `manage X` / `spawn X` / `await X` (value child).
    if is_kw_text(toks: read toks, i: read s, word: read "manage") {
        emit(depth: read d, s: read "manage")
        emit_expr(toks: read toks, start: read (s + 1), end: read e, d: read (d + 1))
        return Unit
    }
    if is_kw_text(toks: read toks, i: read s, word: read "spawn") {
        emit(depth: read d, s: read "spawn")
        emit_expr(toks: read toks, start: read (s + 1), end: read e, d: read (d + 1))
        return Unit
    }
    if is_kw_text(toks: read toks, i: read s, word: read "await") {
        emit(depth: read d, s: read "await")
        emit_expr(toks: read toks, start: read (s + 1), end: read e, d: read (d + 1))
        return Unit
    }
    emit_postfix(toks: read toks, start: read s, end: read e, d: read d)
    return Unit
}

// Closure `|params| body`. `body` is a `{ }` block or a single expression (which
// becomes a block with one expr-stmt). Captures/declared-effects are the explicit
// `fn(...)` form only (a documented gap); the `|...|` form has neither.
fn emit_closure(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    // Second `|` closes the parameter list.
    let mut closePipe = -1
    let mut i = start + 1
    while i < end && closePipe < 0 {
        if at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) { closePipe = i }
        i = i + 1
    }
    if closePipe < 0 { emit(depth: read d, s: read "unknown-expr"); return Unit }
    emit(depth: read d, s: read "closure explicit=false")
    // Params: comma-separated single idents.
    let mut k = start + 1
    while k < closePipe {
        let comma = split_comma(toks: read toks, start: read k, end: read closePipe)
        let pEnd = pick_end(comma: read comma, end: read closePipe)
        if is_ident_tok(toks: read toks, i: read k) {
            emit(depth: read (d + 1), s: read String.concat(left: read "closure-param ", right: read tk_text(toks: read toks, i: read k)))
        }
        if comma < 0 { k = closePipe } else { k = comma + 1 }
    }
    emit(depth: read (d + 1), s: read "body")
    let bodyStart = closePipe + 1
    if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
        let close = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if close == end - 1 {
            emit_block(toks: read toks, open: read bodyStart, close: read close, d: read (d + 2))
            return Unit
        }
    }
    // Single-expression body → a block with one expr-stmt.
    emit(depth: read (d + 2), s: read "block")
    emit(depth: read (d + 3), s: read "expr-stmt")
    emit_expr(toks: read toks, start: read bodyStart, end: read end, d: read (d + 4))
    return Unit
}

// Explicit closure `fn(params) captures(<eff name>, ...) [effects(a, ...)] { body }`.
// Mirrors parse_explicit_fn_expr: explicit=true, capture/declared-effect children.
fn emit_explicit_fn(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let pOpen = start + 1
    let pClose = find_matching(toks: read toks, open: read pOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if pClose < 0 { emit(depth: read d, s: read "unknown-expr"); return Unit }
    emit(depth: read d, s: read "closure explicit=true")
    // params: comma-separated single idents.
    let mut k = pOpen + 1
    while k < pClose {
        let comma = split_comma(toks: read toks, start: read k, end: read pClose)
        if is_ident_tok(toks: read toks, i: read k) {
            emit(depth: read (d + 1), s: read String.concat(left: read "closure-param ", right: read tk_text(toks: read toks, i: read k)))
        }
        if comma < 0 { k = pClose } else { k = comma + 1 }
    }
    // captures(...) — each entry is `<effect> <ident>`.
    let mut cur = pClose + 1
    if is_kw_text(toks: read toks, i: read cur, word: read "captures") && at_symbol(toks: read toks, i: read (cur + 1), code: read SYM_LPAREN) {
        let cOpen = cur + 1
        let cClose = find_matching(toks: read toks, open: read cOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        let mut j = cOpen + 1
        while j < cClose {
            let comma = split_comma(toks: read toks, start: read j, end: read cClose)
            let eff = effect_kw(toks: read toks, i: read j)
            if String.len(value: read eff) > 0 && is_ident_tok(toks: read toks, i: read (j + 1)) {
                let a = String.concat(left: read "capture effect=", right: read eff)
                let b = String.concat(left: read a, right: read " name=")
                emit(depth: read (d + 1), s: read String.concat(left: read b, right: read tk_text(toks: read toks, i: read (j + 1))))
            }
            if comma < 0 { j = cClose } else { j = comma + 1 }
        }
        cur = cClose + 1
    }
    // optional effects(a, b) — each entry a single ident → `declared-effect <n>`.
    if is_kw_text(toks: read toks, i: read cur, word: read "effects") && at_symbol(toks: read toks, i: read (cur + 1), code: read SYM_LPAREN) {
        let eOpen = cur + 1
        let eClose = find_matching(toks: read toks, open: read eOpen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        let mut m = eOpen + 1
        while m < eClose {
            let comma = split_comma(toks: read toks, start: read m, end: read eClose)
            if is_ident_tok(toks: read toks, i: read m) {
                emit(depth: read (d + 1), s: read String.concat(left: read "declared-effect ", right: read tk_text(toks: read toks, i: read m)))
            }
            if comma < 0 { m = eClose } else { m = comma + 1 }
        }
        cur = eClose + 1
    }
    emit(depth: read (d + 1), s: read "body")
    if at_symbol(toks: read toks, i: read cur, code: read SYM_LBRACE) {
        let bClose = find_matching(toks: read toks, open: read cur, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if bClose == end - 1 {
            emit_block(toks: read toks, open: read cur, close: read bClose, d: read (d + 2))
            return Unit
        }
    }
    emit(depth: read (d + 2), s: read "block")
    return Unit
}

// A unary operand [start, end): strip parens wrapping the whole operand (matches
// unary_operand_range), then emit the expression.
fn emit_unary_operand(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let mut s = start
    let mut e = end
    if s < e && at_symbol(toks: read toks, i: read s, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read s, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if close == e - 1 { s = s + 1; e = close }
    }
    emit_expr(toks: read toks, start: read s, end: read e, d: read d)
    return Unit
}

// "read"/"mut"/"take" if token i is that effect keyword, else "".
fn effect_kw(toks: read List<Tok>, i: read Int) -> String {
    if is_kw_text(toks: read toks, i: read i, word: read "read") { return "read" }
    if is_kw_text(toks: read toks, i: read i, word: read "mut") { return "mut" }
    if is_kw_text(toks: read toks, i: read i, word: read "take") { return "take" }
    return ""
}

// Postfix / primary. Handles calls, field access, index, and primaries.
fn emit_postfix(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    // Trailing call: <callee>(args) where the ( ) closes exactly at end-1.
    if end - start >= 2 && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RPAREN) {
        let openp = matching_open_paren(toks: read toks, close: read (end - 1), start: read start)
        if openp > start {
            // No-effect receiver call: `recv.method(args)` with a lowercase/complex
            // receiver parses as ReceiverCall{effect:None}, not Qualified (only an
            // uppercase namespace path is Qualified).
            let dot = find_receiver_call_dot(toks: read toks, recvStart: read start, end: read end)
            if dot > start && is_qualified_ns_receiver(toks: read toks, start: read start, dot: read dot) == false {
                let method = named_segment_str(toks: read toks, start: read (dot + 1), end: read openp)
                if String.len(value: read method) > 0 {
                    emit(depth: read d, s: read "call")
                    emit(depth: read (d + 1), s: read String.concat(left: read "callee-receiver method=", right: read method))
                    emit_expr(toks: read toks, start: read start, end: read dot, d: read (d + 2))
                    emit_args(toks: read toks, start: read (openp + 1), end: read (end - 1), d: read (d + 1))
                    return Unit
                }
            }
            // callee is [start, openp); args in (openp, end-1)
            emit(depth: read d, s: read "call")
            emit_callee(toks: read toks, start: read start, end: read openp, d: read (d + 1))
            emit_args(toks: read toks, start: read (openp + 1), end: read (end - 1), d: read (d + 1))
            return Unit
        }
    }
    // Trailing index: <base>[idx].
    if end - start >= 2 && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RBRACKET) {
        let openb = matching_open_bracket(toks: read toks, close: read (end - 1), start: read start)
        if openb > start {
            emit(depth: read d, s: read "index")
            emit_expr(toks: read toks, start: read start, end: read openb, d: read (d + 1))
            emit_expr(toks: read toks, start: read (openb + 1), end: read (end - 1), d: read (d + 1))
            return Unit
        }
    }
    // Trailing field access: <base>.name  (name is the last token, preceded by `.`).
    if end - start >= 3 && is_ident_tok(toks: read toks, i: read (end - 1)) && at_symbol(toks: read toks, i: read (end - 2), code: read SYM_DOT) {
        let nm = tk_text(toks: read toks, i: read (end - 1))
        emit(depth: read d, s: read String.concat(left: read "field-access name=", right: read nm))
        emit_expr(toks: read toks, start: read start, end: read (end - 2), d: read (d + 1))
        return Unit
    }
    emit_primary(toks: read toks, start: read start, end: read end, d: read d)
    return Unit
}

// The matching '(' for the ')' at `close`, scanning back to `start`, or -1.
fn matching_open_paren(toks: read List<Tok>, close: read Int, start: read Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) { depth = depth + 1 }
        else if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

fn matching_open_bracket(toks: read List<Tok>, close: read Int, start: read Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) { depth = depth + 1 }
        else if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

// First top-level dot in [start, end) with `<`/`[`/`(` treated as depth, or -1.
fn find_first_dot_angle(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_DOT) {
            return i
        }
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) {
            depth = depth - 1
        }
        i = i + 1
    }
    return -1
}

// Reproduce parse_named_callee_segment: "" unless [start,end) is `name` or
// `name<arg, ...>` (args canonicalized via type_name_str, joined ", ").
fn named_segment_str(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    if start >= end || is_ident_tok(toks: read toks, i: read start) == false { return "" }
    let name = tk_text(toks: read toks, i: read start)
    if start + 1 == end { return name }
    if at_symbol(toks: read toks, i: read (start + 1), code: read SYM_LANGLE) == false { return "" }
    let close = find_matching(toks: read toks, open: read (start + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 || close + 1 != end || start + 2 >= close { return "" }
    let args = type_args_str(toks: read toks, start: read (start + 2), end: read close)
    let a = String.concat(left: read name, right: read "<")
    let b = String.concat(left: read a, right: read args)
    return String.concat(left: read b, right: read ">")
}

// Opening `(` of a call in [start, end), or -1. Skips generic `<...>`/`[...]`
// (mirrors find_call_open: only `<`/`[` nest, `>`/`]` close). Scan begins at
// start+1 (the callee/method name occupies start).
fn find_call_open(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start + 1
    while i < end {
        if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) { return i }
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        }
        i = i + 1
    }
    return -1
}

// Last top-level `.` in [recvStart, end) that opens a valid receiver call:
// dot+1 is an ident, a call `(` follows, and its matching `)` closes at end-1.
// Mirrors find_receiver_call_dot (()[]{} nest; `<>` do NOT). -1 if none.
fn find_receiver_call_dot(toks: read List<Tok>, recvStart: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut best = -1
    let mut i = recvStart
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_DOT) && i > recvStart && (i + 1) < end && is_ident_tok(toks: read toks, i: read (i + 1)) {
            let open = find_call_open(toks: read toks, start: read (i + 1), end: read end)
            if open > 0 {
                let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                if close == end - 1 { best = i }
            }
        }
        i = i + 1
    }
    return best
}

// True when the receiver [start, dot) is an uppercase-led namespace path (only
// idents / `<` / `>` / `,`) — those parse as Qualified, not a ReceiverCall.
fn is_qualified_ns_receiver(toks: read List<Tok>, start: read Int, dot: read Int) -> Bool {
    if is_ident_tok(toks: read toks, i: read start) == false { return false }
    if is_upper_first(name: read tk_text(toks: read toks, i: read start)) == false { return false }
    let mut i = start + 1
    while i < dot {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) || at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) || is_ident_tok(toks: read toks, i: read i) {
            i = i + 1
        } else {
            return false
        }
    }
    return true
}

// Canonical type name for [start, end): `Name` or `Name<arg, ...>` (matches
// type_ref_name for the common subset; Fn/noescape/owned/fresh are not rendered).
fn type_name_str(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    if start >= end || is_ident_tok(toks: read toks, i: read start) == false { return "" }
    let name = tk_text(toks: read toks, i: read start)
    if start + 1 < end && at_symbol(toks: read toks, i: read (start + 1), code: read SYM_LANGLE) {
        let close = find_matching(toks: read toks, open: read (start + 1), openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if close == end - 1 {
            let args = type_args_str(toks: read toks, start: read (start + 2), end: read close)
            let a = String.concat(left: read name, right: read "<")
            let b = String.concat(left: read a, right: read args)
            return String.concat(left: read b, right: read ">")
        }
    }
    return name
}

// Comma-join canonical type names for the arg list [start, end), separator ", ".
fn type_args_str(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    local sb = StringBuilder.new()
    let mut k = start
    let mut first = true
    while k < end {
        let comma = split_comma(toks: read toks, start: read k, end: read end)
        let aEnd = pick_end(comma: read comma, end: read end)
        if first == false { StringBuilder.push(builder: mut sb, value: read ", ") }
        StringBuilder.push(builder: mut sb, value: read type_name_str(toks: read toks, start: read k, end: read aEnd))
        first = false
        if comma < 0 { k = end } else { k = comma + 1 }
    }
    return StringBuilder.finish(builder: take sb)
}

// Callee occupying [start, end). Mirrors crate::syntax::parser::expr::parse_callee:
// a whole-range named segment (`name` / `name<args>`) is Callee::Name; otherwise
// the FIRST top-level dot splits a type-ref namespace from a method segment,
// giving Callee::Qualified{namespace, name}. Bare `x.m()` is Qualified (namespace
// "x"); Callee::ReceiverCall only arises with an explicit effect (handled in
// emit_expr's effect branch).
fn emit_callee(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let whole = named_segment_str(toks: read toks, start: read start, end: read end)
    if String.len(value: read whole) > 0 {
        emit(depth: read d, s: read String.concat(left: read "callee-name name=", right: read whole))
        return Unit
    }
    let dot = find_first_dot_angle(toks: read toks, start: read start, end: read end)
    if dot > start {
        let ns = type_name_str(toks: read toks, start: read start, end: read dot)
        let meth = named_segment_str(toks: read toks, start: read (dot + 1), end: read end)
        if String.len(value: read ns) > 0 && String.len(value: read meth) > 0 {
            let a = String.concat(left: read "callee-qualified namespace=", right: read ns)
            let b = String.concat(left: read a, right: read " name=")
            emit(depth: read d, s: read String.concat(left: read b, right: read meth))
            return Unit
        }
    }
    // Fallback: a receiver expression `<expr>.method` (rare without an effect).
    if end - start >= 3 && is_ident_tok(toks: read toks, i: read (end - 1)) && at_symbol(toks: read toks, i: read (end - 2), code: read SYM_DOT) {
        let nm = tk_text(toks: read toks, i: read (end - 1))
        emit(depth: read d, s: read String.concat(left: read "callee-receiver method=", right: read nm))
        emit_expr(toks: read toks, start: read start, end: read (end - 2), d: read (d + 1))
        return Unit
    }
    emit(depth: read d, s: read "callee-name name=")
    return Unit
}

// Call arguments in [start, end): comma-separated, each optionally `name:` labeled.
fn emit_args(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let mut i = start
    while i < end {
        let comma = split_comma(toks: read toks, start: read i, end: read end)
        let argEnd = pick_end(comma: read comma, end: read end)
        // Named arg: `name: value` when a top-level `:` follows an ident at i.
        let mut vstart = i
        let mut line = "arg"
        if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            line = String.concat(left: read "arg name=", right: read tk_text(toks: read toks, i: read i))
            vstart = i + 2
        }
        emit(depth: read d, s: read line)
        emit_expr(toks: read toks, start: read vstart, end: read argEnd, d: read (d + 1))
        if comma < 0 { i = end } else { i = comma + 1 }
    }
    return Unit
}

fn pick_end(comma: read Int, end: read Int) -> Int {
    if comma < 0 { return end }
    return comma
}

// First top-level comma in [start, end), or -1. Mirrors split_param_ranges: a
// single `depth` counts ()[]{} AND generic `<>`, and a `|` at depth 0 toggles
// `pipe` so closure-parameter commas (`|acc, x|`) don't split. This is the
// canonical splitter for args, params, generic args, and pattern payloads.
fn split_comma(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut pipe = 0
    let mut i = start
    while i < end {
        if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) {
            pipe = 1 - pipe
        } else if pipe == 0 && (at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE)) {
            depth = depth + 1
        } else if pipe == 0 && (at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE)) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && pipe == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_COMMA) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Primary expressions: literals and bracketed literals.
fn emit_primary(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    if end - start == 1 {
        let k = tk_kind(toks: read toks, i: read start)
        let t = tk_text(toks: read toks, i: read start)
        if k == TOK_NUMBER {
            emit(depth: read d, s: read String.concat(left: read "number ", right: read escape(s: read t)))
            return Unit
        }
        if k == TOK_STRING {
            emit(depth: read d, s: read String.concat(left: read "string ", right: read escape(s: read t)))
            return Unit
        }
        if k == TOK_CHAR {
            emit(depth: read d, s: read String.concat(left: read "char ", right: read escape(s: read t)))
            return Unit
        }
        if k == TOK_MULTILINE {
            emit(depth: read d, s: read String.concat(left: read "multiline ", right: read escape(s: read t)))
            return Unit
        }
        if k == TOK_INTERP {
            emit_interp(text: read t, d: read d)
            return Unit
        }
        // Ident or keyword-as-ident (true/false/etc lex as ident).
        emit(depth: read d, s: read String.concat(left: read "ident ", right: read escape(s: read t)))
        return Unit
    }
    // Array literal: [ items ].
    if at_symbol(toks: read toks, i: read start, code: read SYM_LBRACKET) && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RBRACKET) {
        let close = find_matching(toks: read toks, open: read start, openSym: read SYM_LBRACKET, closeSym: read SYM_RBRACKET)
        if close == end - 1 {
            emit(depth: read d, s: read "array")
            let mut i = start + 1
            while i < end - 1 {
                let comma = split_comma(toks: read toks, start: read i, end: read (end - 1))
                let itemEnd = pick_end(comma: read comma, end: read (end - 1))
                emit_expr(toks: read toks, start: read i, end: read itemEnd, d: read (d + 1))
                if comma < 0 { i = end - 1 } else { i = comma + 1 }
            }
            return Unit
        }
    }
    // Object / map literal: { fields } or { k => v, ... }.
    if at_symbol(toks: read toks, i: read start, code: read SYM_LBRACE) && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RBRACE) {
        let close = find_matching(toks: read toks, open: read start, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if close == end - 1 {
            emit_object_or_map(toks: read toks, start: read start, close: read close, d: read d)
            return Unit
        }
    }
    emit(depth: read d, s: read "unknown-expr")
    return Unit
}

// Interpolated string `"...{expr}..."` desugars to
// String.format(template: read "<{}-collapsed>", args: read [<exprs>]).
// Mirrors parse_interpolated_string_parts. The only unreproducible case is a
// syntactically-invalid embedded expr (emit_expr can't signal parse failure), so
// `malformed` is set only for an unterminated `{` — a documented residual.
fn emit_interp(text: read String, d: read Int) -> Unit {
    local tmpl = StringBuilder.new()
    local items = List.new()
    let mut malformed = false
    let cs = String.chars(value: read text)
    let n = List.len(list: read cs)
    let mut i = 0
    while i < n {
        let c = code_at(chars: read cs, n: read n, i: read i)
        if c == 92 {
            // backslash: copy it and the next char verbatim (escaped later).
            StringBuilder.push(builder: mut tmpl, value: read Char.to_string(value: read List.get(list: read cs, index: read i)))
            i = i + 1
            if i < n {
                StringBuilder.push(builder: mut tmpl, value: read Char.to_string(value: read List.get(list: read cs, index: read i)))
                i = i + 1
            }
        } else if c == 123 && code_at(chars: read cs, n: read n, i: read (i + 1)) == 123 {
            StringBuilder.push(builder: mut tmpl, value: read "{{"); i = i + 2
        } else if c == 125 && code_at(chars: read cs, n: read n, i: read (i + 1)) == 125 {
            StringBuilder.push(builder: mut tmpl, value: read "}}"); i = i + 2
        } else if c == 123 {
            let close = interp_end(cs: read cs, n: read n, start: read (i + 1))
            if close < 0 {
                malformed = true
                StringBuilder.push(builder: mut tmpl, value: read "{")
                i = i + 1
            } else {
                StringBuilder.push(builder: mut tmpl, value: read "{}")
                List.push(list: mut items, value: read slice(chars: read cs, from: read (i + 1), to: read close))
                i = close + 1
            }
        } else if c == 125 {
            StringBuilder.push(builder: mut tmpl, value: read "}}"); i = i + 1
        } else {
            StringBuilder.push(builder: mut tmpl, value: read Char.to_string(value: read List.get(list: read cs, index: read i)))
            i = i + 1
        }
    }
    let template = StringBuilder.finish(builder: take tmpl)
    let mut suffix = ""
    if malformed { suffix = " malformed=true" }
    emit(depth: read d, s: read "call")
    emit(depth: read (d + 1), s: read "callee-qualified namespace=String name=format")
    emit(depth: read (d + 1), s: read String.concat(left: read "arg name=template", right: read suffix))
    emit(depth: read (d + 2), s: read "effect kind=read")
    emit(depth: read (d + 3), s: read String.concat(left: read "string ", right: read escape(s: read template)))
    emit(depth: read (d + 1), s: read String.concat(left: read "arg name=args", right: read suffix))
    emit(depth: read (d + 2), s: read "effect kind=read")
    emit(depth: read (d + 3), s: read "array")
    let m = List.len(list: read items)
    let mut j = 0
    while j < m {
        let subToks = tokenize(source: read List.get(list: read items, index: read j))
        let stop = first_eof(toks: read subToks)
        emit_expr(toks: read subToks, start: read 0, end: read stop, d: read (d + 4))
        j = j + 1
    }
    return Unit
}

// Matching top-level `}` for an interpolation opening at `start`, or -1. Mirrors
// find_interpolation_end (skips string literals; `([{` nest, `)]` and `}` close).
fn interp_end(cs: read List<Char>, n: read Int, start: read Int) -> Int {
    let mut i = start
    let mut depth = 0
    while i < n {
        let c = code_at(chars: read cs, n: read n, i: read i)
        if c == 34 {
            i = i + 1
            let mut inStr = true
            while i < n && inStr {
                let sc = code_at(chars: read cs, n: read n, i: read i)
                if sc == 92 { i = i + 2 }
                else if sc == 34 { i = i + 1; inStr = false }
                else { i = i + 1 }
            }
        } else if c == 40 || c == 91 || c == 123 {
            depth = depth + 1; i = i + 1
        } else if c == 41 || c == 93 {
            if depth > 0 { depth = depth - 1 }
            i = i + 1
        } else if c == 125 {
            if depth == 0 { return i }
            depth = depth - 1; i = i + 1
        } else {
            i = i + 1
        }
    }
    return -1
}

// Index of the first TOK_EOF in a freshly tokenized list (its logical end).
fn first_eof(toks: read List<Tok>) -> Int {
    let m = List.len(list: read toks)
    let mut i = 0
    while i < m {
        if tk_kind(toks: read toks, i: read i) == TOK_EOF { return i }
        i = i + 1
    }
    return m
}

// `{ "field": v, ... }` (object) or `{ k => v, ... }` (map). A top-level `=>` in
// any entry makes it a map; otherwise an object (empty `{}` is an object).
fn emit_object_or_map(toks: read List<Tok>, start: read Int, close: read Int, d: read Int) -> Unit {
    // Decide map vs object.
    let mut isMap = false
    let mut i = start + 1
    while i < close {
        let comma = split_comma(toks: read toks, start: read i, end: read close)
        let entEnd = pick_end(comma: read comma, end: read close)
        if find_top_sym(toks: read toks, start: read i, end: read entEnd, code: read SYM_FATARROW) >= 0 {
            isMap = true
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    if isMap {
        emit(depth: read d, s: read "map")
        let mut k = start + 1
        while k < close {
            let comma = split_comma(toks: read toks, start: read k, end: read close)
            let entEnd = pick_end(comma: read comma, end: read close)
            let arrow = find_top_sym(toks: read toks, start: read k, end: read entEnd, code: read SYM_FATARROW)
            emit(depth: read (d + 1), s: read "map-entry")
            emit(depth: read (d + 2), s: read "key")
            emit_expr(toks: read toks, start: read k, end: read arrow, d: read (d + 3))
            emit(depth: read (d + 2), s: read "value")
            emit_expr(toks: read toks, start: read (arrow + 1), end: read entEnd, d: read (d + 3))
            if comma < 0 { k = close } else { k = comma + 1 }
        }
        return Unit
    }
    emit(depth: read d, s: read "object")
    let mut k = start + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let entEnd = pick_end(comma: read comma, end: read close)
        let colon = find_top_sym(toks: read toks, start: read k, end: read entEnd, code: read SYM_COLON)
        if colon >= 0 {
            let nm = tk_text(toks: read toks, i: read k)
            emit(depth: read (d + 1), s: read String.concat(left: read "object-field name=", right: read nm))
            emit_expr(toks: read toks, start: read (colon + 1), end: read entEnd, d: read (d + 2))
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Type references (subset: [fresh] Name [< args >]).
// emit_type_ref renders one type starting at token i and returns the next index.
// -------------------------------------------------------------------------

// True if token j is a type-level prefix keyword skipped when locating the name
// (read/mut/take effects + fresh/handle/weak/noescape/owned), matching name_index
// in parse_type_ref.
fn is_type_prefix(toks: read List<Tok>, j: read Int) -> Bool {
    return is_kw_text(toks: read toks, i: read j, word: read "read") || is_kw_text(toks: read toks, i: read j, word: read "mut") || is_kw_text(toks: read toks, i: read j, word: read "take") || is_kw_text(toks: read toks, i: read j, word: read "fresh") || is_kw_text(toks: read toks, i: read j, word: read "handle") || is_kw_text(toks: read toks, i: read j, word: read "weak") || is_kw_text(toks: read toks, i: read j, word: read "noescape") || is_kw_text(toks: read toks, i: read j, word: read "owned")
}

fn emit_type_ref(toks: read List<Tok>, i: read Int, tag: read String, eff: read String, d: read Int) -> Int {
    // Prefix flags reflect ONLY the token at `i` (matching parse_type_ref, which
    // reads is_fresh/is_noescape/is_owned from tokens[start]).
    let mut isFresh = false
    let mut isNoescape = false
    let mut isOwned = false
    if at_ident(toks: read toks, i: read i, wid: read WORD_FRESH) { isFresh = true }
    else if is_kw_text(toks: read toks, i: read i, word: read "noescape") { isNoescape = true }
    else if is_kw_text(toks: read toks, i: read i, word: read "owned") { isOwned = true }
    // Name is the first non-prefix token.
    let mut j = i
    while is_type_prefix(toks: read toks, j: read j) { j = j + 1 }
    let name = tk_text(toks: read toks, i: read j)
    j = j + 1
    local sb = StringBuilder.new()
    StringBuilder.push(builder: mut sb, value: read tag)
    if String.len(value: read eff) > 0 {
        StringBuilder.push(builder: mut sb, value: read " effect=")
        StringBuilder.push(builder: mut sb, value: read eff)
    }
    StringBuilder.push(builder: mut sb, value: read " name=")
    StringBuilder.push(builder: mut sb, value: read name)
    StringBuilder.push(builder: mut sb, value: read " fresh=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isFresh))
    StringBuilder.push(builder: mut sb, value: read " noescape=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isNoescape))
    StringBuilder.push(builder: mut sb, value: read " owned=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isOwned))
    emit(depth: read d, s: read StringBuilder.finish(builder: take sb))
    // Generic args `<...>`.
    if at_symbol(toks: read toks, i: read j, code: read SYM_LANGLE) {
        let close = find_matching(toks: read toks, open: read j, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
        if close > j {
            let mut k = j + 1
            while k < close {
                k = emit_type_ref(toks: read toks, i: read k, tag: read "arg", eff: read "", d: read (d + 1))
                if at_symbol(toks: read toks, i: read k, code: read SYM_COMMA) { k = k + 1 }
            }
            j = close + 1
        }
    }
    // Fn types: `Fn(<params>) -> <ret>` → fn-param (with optional effect) + fn-return.
    if name == "Fn" && at_symbol(toks: read toks, i: read j, code: read SYM_LPAREN) {
        let pclose = find_matching(toks: read toks, open: read j, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        let mut k = j + 1
        while k < pclose {
            let comma = split_comma(toks: read toks, start: read k, end: read pclose)
            let pEff = effect_kw(toks: read toks, i: read k)
            let mut pStart = k
            if String.len(value: read pEff) > 0 { pStart = k + 1 }
            emit_type_ref(toks: read toks, i: read pStart, tag: read "fn-param", eff: read pEff, d: read (d + 1))
            if comma < 0 { k = pclose } else { k = comma + 1 }
        }
        j = pclose + 1
        if at_symbol(toks: read toks, i: read j, code: read SYM_ARROW) {
            j = emit_type_ref(toks: read toks, i: read (j + 1), tag: read "fn-return", eff: read "", d: read (d + 1))
        }
    }
    return j
}

// -------------------------------------------------------------------------
// Statements. emit_stmt renders one statement in [start, limit) and returns the
// index of the next statement (statement_end semantics from scan.rss's line model).
// -------------------------------------------------------------------------

// Statement end: first token on a strictly-later line at bracket depth 0 (simple
// line model; operator-continuation and postfix chains are a documented gap).
// Statement boundary, mirroring parser/scan.rs statement_end. A statement ends at
// the first token on a strictly-later line at bracket+angle depth 0, EXCEPT: a
// top-level `;` terminates immediately; a line starting with `.`/`?` (postfix) or
// with/after a continuation operator (`| & + * / % ^`) continues the statement.
fn stmt_end(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let mut line = tk_line(toks: read toks, i: read start)
    let mut depth = 0
    let mut angle = 0
    let mut postfixLine = -1
    let mut i = start + 1
    while i < limit {
        if depth == 0 && angle == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) {
            return i
        }
        if depth == 0 && angle == 0 && tk_line(toks: read toks, i: read i) > line {
            if postfixLine == tk_line(toks: read toks, i: read i) {
                // still on a postfix-continuation line — keep scanning.
            } else if is_stmt_postfix(toks: read toks, i: read i) {
                postfixLine = tk_line(toks: read toks, i: read i)
            } else if is_cont_op(toks: read toks, i: read i) || is_cont_op(toks: read toks, i: read (i - 1)) {
                line = tk_line(toks: read toks, i: read i)
            } else {
                return i
            }
        }
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            if depth > 0 { depth = depth - 1 }
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) && is_generic_angle(toks: read toks, start: read start, end: read limit, open: read i) {
            angle = angle + 1
        } else if depth == 0 && angle > 0 && at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE) {
            angle = angle - 1
        }
        i = i + 1
    }
    return limit
}

fn is_stmt_postfix(toks: read List<Tok>, i: read Int) -> Bool {
    return at_symbol(toks: read toks, i: read i, code: read SYM_QUESTION) || at_symbol(toks: read toks, i: read i, code: read SYM_DOT)
}

// Continuation operators (SH-017): `| & + * / % ^` — a statement-level expression
// wraps across a newline when a line begins with, or ends before, one of these.
// `< > - = !` are deliberately excluded (see scan.rs).
fn is_cont_op(toks: read List<Tok>, i: read Int) -> Bool {
    return at_symbol(toks: read toks, i: read i, code: read SYM_PIPE) || at_symbol(toks: read toks, i: read i, code: read SYM_AMP) || at_symbol(toks: read toks, i: read i, code: read SYM_PLUS) || at_symbol(toks: read toks, i: read i, code: read SYM_STAR) || at_symbol(toks: read toks, i: read i, code: read SYM_SLASH) || at_symbol(toks: read toks, i: read i, code: read SYM_PERCENT) || at_symbol(toks: read toks, i: read i, code: read SYM_CARET)
}

// First top-level standalone `=` (assignment, not == != <= >=) in [start, end), or -1.
// First `=` symbol token in [start, end), or -1 (used for let value split;
// `=>` is a distinct FatArrow token, not matched).
fn first_eq(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_EQ) { return i }
        i = i + 1
    }
    return -1
}

fn top_assign(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_EQ) {
            let prevJoin = i > start && (at_symbol(toks: read toks, i: read (i - 1), code: read SYM_EQ) || at_symbol(toks: read toks, i: read (i - 1), code: read SYM_BANG) || at_symbol(toks: read toks, i: read (i - 1), code: read SYM_LANGLE) || at_symbol(toks: read toks, i: read (i - 1), code: read SYM_RANGLE))
            let nextJoin = at_symbol(toks: read toks, i: read (i + 1), code: read SYM_EQ)
            if prevJoin == false && nextJoin == false {
                return i
            }
        }
        i = i + 1
    }
    return -1
}

fn emit_stmt(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    // return [value]
    if is_kw_text(toks: read toks, i: read start, word: read "return") {
        let e = stmt_end(toks: read toks, start: read start, limit: read limit)
        emit(depth: read d, s: read "return")
        if start + 1 < e {
            emit(depth: read (d + 1), s: read "value")
            emit_expr(toks: read toks, start: read (start + 1), end: read e, d: read (d + 2))
        }
        return e
    }
    // if cond { then } [else { ... }]
    if is_kw_text(toks: read toks, i: read start, word: read "if") {
        return emit_if(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // while/loop [cond] { body }
    if is_kw_text(toks: read toks, i: read start, word: read "while") || is_kw_text(toks: read toks, i: read start, word: read "loop") {
        return emit_loop(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // match [effect] value { arms }
    if is_kw_text(toks: read toks, i: read start, word: read "match") {
        let openb = find_block_open(toks: read toks, start: read (start + 1), limit: read limit)
        if openb < 0 {
            emit(depth: read d, s: read "malformed-match")
            return stmt_end(toks: read toks, start: read start, limit: read limit)
        }
        let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        emit_match(toks: read toks, matchPos: read start, braceOpen: read openb, braceClose: read close, tag: read "match", d: read d)
        return close + 1
    }
    // for binding in iterable { body }  (and `await for ...`)
    if is_kw_text(toks: read toks, i: read start, word: read "for") {
        return emit_for(toks: read toks, forPos: read start, limit: read limit, d: read d, isAsync: read false)
    }
    if is_kw_text(toks: read toks, i: read start, word: read "await") && is_kw_text(toks: read toks, i: read (start + 1), word: read "for") {
        return emit_for(toks: read toks, forPos: read (start + 1), limit: read limit, d: read d, isAsync: read true)
    }
    // with <resource> as <binding> { body }
    if is_kw_text(toks: read toks, i: read start, word: read "with") {
        return emit_with(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // task_group { body }
    if is_kw_text(toks: read toks, i: read start, word: read "task_group") {
        return emit_task_group(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // select { arms }
    if is_kw_text(toks: read toks, i: read start, word: read "select") {
        return emit_select(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // break / continue
    if is_kw_text(toks: read toks, i: read start, word: read "break") {
        emit(depth: read d, s: read "break")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    if is_kw_text(toks: read toks, i: read start, word: read "continue") {
        emit(depth: read d, s: read "continue")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    // async let name = value  (managed, no annotation, async=true)
    if is_kw_text(toks: read toks, i: read start, word: read "async") && is_kw_text(toks: read toks, i: read (start + 1), word: read "let") {
        let e = stmt_end(toks: read toks, start: read start, limit: read limit)
        let name = tk_text(toks: read toks, i: read (start + 2))
        emit(depth: read d, s: read String.concat(left: read String.concat(left: read "let kind=managed name=", right: read name), right: read " mut=false async=true"))
        let asg = first_eq(toks: read toks, start: read (start + 3), end: read e)
        if asg >= 0 {
            emit(depth: read (d + 1), s: read "value")
            emit_expr(toks: read toks, start: read (asg + 1), end: read e, d: read (d + 2))
        }
        return e
    }
    // let / local [mut] name [: type] = value
    if is_kw_text(toks: read toks, i: read start, word: read "let") || is_kw_text(toks: read toks, i: read start, word: read "local") {
        return emit_let(toks: read toks, start: read start, limit: read limit, d: read d)
    }
    // Assignment or expression statement.
    let e = stmt_end(toks: read toks, start: read start, limit: read limit)
    let asg = top_assign(toks: read toks, start: read start, end: read e)
    if asg >= 0 {
        emit(depth: read d, s: read "assign")
        emit(depth: read (d + 1), s: read "target")
        emit_expr(toks: read toks, start: read start, end: read asg, d: read (d + 2))
        emit(depth: read (d + 1), s: read "value")
        emit_expr(toks: read toks, start: read (asg + 1), end: read e, d: read (d + 2))
        return e
    }
    emit(depth: read d, s: read "expr-stmt")
    emit_expr(toks: read toks, start: read start, end: read e, d: read (d + 1))
    return e
}

// Token i is a keyword/ident with the exact text `word`.
fn is_kw_text(toks: read List<Tok>, i: read Int, word: read String) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) == false { return false }
    return tk_text(toks: read toks, i: read i) == word
}

fn emit_let(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    let e = stmt_end(toks: read toks, start: read start, limit: read limit)
    let mut kind = "managed"
    if is_kw_text(toks: read toks, i: read start, word: read "local") { kind = "local" }
    let mut j = start + 1
    let mut isMut = false
    if kind == "managed" && is_kw_text(toks: read toks, i: read j, word: read "mut") {
        isMut = true
        j = j + 1
    }
    let name = tk_text(toks: read toks, i: read j)
    j = j + 1
    let a = String.concat(left: read "let kind=", right: read kind)
    let b = String.concat(left: read a, right: read " name=")
    let c = String.concat(left: read b, right: read name)
    let f = String.concat(left: read c, right: read " mut=")
    let g = String.concat(left: read f, right: read boolstr(b: read isMut))
    let h = String.concat(left: read g, right: read " async=false")
    emit(depth: read d, s: read h)
    // Value split is the FIRST `=` after the name (matching parse_let_stmt): a
    // let's name/annotation never contains `=`, so no `>=`/`==` guard is needed —
    // and top_assign's guard would wrongly skip the `=` after a generic `>`
    // (`let x: Option<Int> = …`).
    let asg = first_eq(toks: read toks, start: read j, end: read e)
    if at_symbol(toks: read toks, i: read j, code: read SYM_COLON) {
        emit_type_ref(toks: read toks, i: read (j + 1), tag: read "type", eff: read "", d: read (d + 1))
    }
    // Value.
    if asg >= 0 {
        emit(depth: read (d + 1), s: read "value")
        emit_expr(toks: read toks, start: read (asg + 1), end: read e, d: read (d + 2))
    }
    return e
}

fn emit_if(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    // Find the `{` opening the then-block at top level.
    let openb = find_block_open(toks: read toks, start: read (start + 1), limit: read limit)
    if openb < 0 { emit(depth: read d, s: read "malformed-if"); return stmt_end(toks: read toks, start: read start, limit: read limit) }
    let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    emit(depth: read d, s: read "if")
    emit(depth: read (d + 1), s: read "cond")
    emit_expr(toks: read toks, start: read (start + 1), end: read openb, d: read (d + 2))
    emit(depth: read (d + 1), s: read "then")
    emit_block(toks: read toks, open: read openb, close: read close, d: read (d + 2))
    // else?
    let mut next = close + 1
    if is_kw_text(toks: read toks, i: read next, word: read "else") {
        if is_kw_text(toks: read toks, i: read (next + 1), word: read "if") {
            emit(depth: read (d + 1), s: read "else")
            emit(depth: read (d + 2), s: read "block")
            let r = emit_if(toks: read toks, start: read (next + 1), limit: read limit, d: read (d + 3))
            return r
        }
        let eopen = find_block_open(toks: read toks, start: read (next + 1), limit: read limit)
        if eopen >= 0 {
            let eclose = find_matching(toks: read toks, open: read eopen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            emit(depth: read (d + 1), s: read "else")
            emit_block(toks: read toks, open: read eopen, close: read eclose, d: read (d + 2))
            return eclose + 1
        }
    }
    return next
}

fn emit_for(toks: read List<Tok>, forPos: read Int, limit: read Int, d: read Int, isAsync: read Bool) -> Int {
    let openb = find_block_open(toks: read toks, start: read forPos, limit: read limit)
    if openb < 0 {
        emit(depth: read d, s: read "malformed-for")
        return stmt_end(toks: read toks, start: read forPos, limit: read limit)
    }
    let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    let binding = tk_text(toks: read toks, i: read (forPos + 1))
    let a = String.concat(left: read "for binding=", right: read binding)
    let b = String.concat(left: read a, right: read " async=")
    emit(depth: read d, s: read String.concat(left: read b, right: read boolstr(b: read isAsync)))
    emit(depth: read (d + 1), s: read "iter")
    emit_expr(toks: read toks, start: read (forPos + 3), end: read openb, d: read (d + 2))
    emit_block(toks: read toks, open: read openb, close: read close, d: read (d + 1))
    return close + 1
}

// with <resource> as <binding> { body }. Mirrors parse_with_stmt: the FIRST `as`
// (not depth-aware) splits resource from binding; `as` must be immediately before
// the body brace.
fn emit_with(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    let mut asIdx = -1
    let mut i = start + 1
    while i < limit && asIdx < 0 {
        if is_kw_text(toks: read toks, i: read i, word: read "as") { asIdx = i }
        i = i + 1
    }
    if asIdx < 0 {
        emit(depth: read d, s: read "malformed-with")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    let open = find_block_open(toks: read toks, start: read (asIdx + 1), limit: read limit)
    if open < 0 {
        emit(depth: read d, s: read "malformed-with")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    let binding = tk_text(toks: read toks, i: read (asIdx + 1))
    emit(depth: read d, s: read String.concat(left: read "with binding=", right: read binding))
    emit(depth: read (d + 1), s: read "resource")
    emit_expr(toks: read toks, start: read (start + 1), end: read asIdx, d: read (d + 2))
    emit_block(toks: read toks, open: read open, close: read close, d: read (d + 1))
    return close + 1
}

// task_group { body }
fn emit_task_group(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    let open = start + 1
    if at_symbol(toks: read toks, i: read open, code: read SYM_LBRACE) == false {
        emit(depth: read d, s: read "unknown-stmt")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    emit(depth: read d, s: read "task-group")
    emit_block(toks: read toks, open: read open, close: read close, d: read (d + 1))
    return close + 1
}

// select { <binding> = <operation> => { body } ... }
fn emit_select(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    let open = start + 1
    if at_symbol(toks: read toks, i: read open, code: read SYM_LBRACE) == false {
        emit(depth: read d, s: read "unknown-stmt")
        return stmt_end(toks: read toks, start: read start, limit: read limit)
    }
    let close = find_matching(toks: read toks, open: read open, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    emit(depth: read d, s: read "select")
    emit_select_arms(toks: read toks, start: read (open + 1), end: read close, d: read (d + 1))
    return close + 1
}

fn emit_select_arms(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read end)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let eq = find_top_sym(toks: read toks, start: read i, end: read arrow, code: read SYM_EQ)
                if eq < 0 {
                    i = arrow + 1
                } else {
                    let mut binding = "_"
                    if is_ident_tok(toks: read toks, i: read i) { binding = tk_text(toks: read toks, i: read i) }
                    emit(depth: read d, s: read String.concat(left: read "select-arm binding=", right: read binding))
                    emit(depth: read (d + 1), s: read "operation")
                    emit_expr(toks: read toks, start: read (eq + 1), end: read arrow, d: read (d + 2))
                    let bodyStart = arrow + 1
                    if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                        let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                        emit_block(toks: read toks, open: read bodyStart, close: read bclose, d: read (d + 1))
                        i = bclose + 1
                    } else {
                        let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read end)
                        emit(depth: read (d + 1), s: read "block")
                        emit_stmt(toks: read toks, start: read bodyStart, limit: read bEnd, d: read (d + 2))
                        if bEnd > i { i = bEnd } else { i = i + 1 }
                    }
                }
            }
        }
    }
    return Unit
}

fn emit_loop(toks: read List<Tok>, start: read Int, limit: read Int, d: read Int) -> Int {
    let isWhile = is_kw_text(toks: read toks, i: read start, word: read "while")
    let openb = find_block_open(toks: read toks, start: read (start + 1), limit: read limit)
    if openb < 0 { emit(depth: read d, s: read "malformed-loop"); return stmt_end(toks: read toks, start: read start, limit: read limit) }
    let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    emit(depth: read d, s: read "loop")
    if isWhile && start + 1 < openb {
        emit(depth: read (d + 1), s: read "cond")
        emit_expr(toks: read toks, start: read (start + 1), end: read openb, d: read (d + 2))
    }
    emit_block(toks: read toks, open: read openb, close: read close, d: read (d + 1))
    return close + 1
}

// Index of the top-level `{` at or after `start` (before `limit`), or -1.
fn find_block_open(toks: read List<Tok>, start: read Int, limit: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < limit {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            return i
        }
        i = i + 1
    }
    return -1
}

// Emit a `block` node and its statements for the braces [open, close].
fn emit_block(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    emit(depth: read d, s: read "block")
    let mut i = open + 1
    while i < close {
        // Skip stray semicolons/commas that are statement trivia.
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) {
            i = i + 1
        } else {
            let next = emit_stmt(toks: read toks, start: read i, limit: read close, d: read (d + 1))
            if next > i { i = next } else { i = i + 1 }
        }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Items: functions (core), plus struct/sum/const shells.
// -------------------------------------------------------------------------

fn emit_function(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let mut j = start
    // Attributes: #deprecated("...") / #lower_name("...")  (before pub/async/native).
    let mut depReason = ""
    let mut haveDep = false
    let mut lowerName = ""
    let mut haveLower = false
    let mut attrs = true
    while attrs {
        if at_symbol(toks: read toks, i: read j, code: read SYM_HASH) {
            let isDep = at_ident(toks: read toks, i: read (j + 1), wid: read WORD_DEPRECATED)
            let sval = tk_text(toks: read toks, i: read (j + 3))
            if isDep { depReason = sval; haveDep = true } else { lowerName = sval; haveLower = true }
            j = j + 5
        } else {
            attrs = false
        }
    }
    let mut isPub = false
    let mut isAsync = false
    let mut isNative = false
    if is_kw_text(toks: read toks, i: read j, word: read "pub") { isPub = true; j = j + 1 }
    if is_kw_text(toks: read toks, i: read j, word: read "async") { isAsync = true; j = j + 1 }
    if is_kw_text(toks: read toks, i: read j, word: read "native") { isNative = true; j = j + 1 }
    // `fn`
    j = j + 1
    let nameEnd = take_function_name(toks: read toks, i: read j)
    let name = dotted_text(toks: read toks, start: read j, end: read nameEnd)
    let genStart = nameEnd
    // params
    let popen = parse_generic_params(toks: read toks, i: read genStart)
    let pclose = find_matching(toks: read toks, open: read popen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    j = pclose + 1
    // return type
    let mut hasRet = false
    let mut retFresh = false
    let mut retStart = -1
    if at_symbol(toks: read toks, i: read j, code: read SYM_ARROW) {
        hasRet = true
        retStart = j + 1
        // `-> fresh T` sets the fn's returns-fresh and the type ref begins AT T
        // (the return TypeRef itself is fresh=false — matches parse_function_decl).
        if at_ident(toks: read toks, i: read (j + 1), wid: read WORD_FRESH) {
            retFresh = true
            retStart = j + 2
        }
    }
    // body
    let bodyOpen = find_block_open(toks: read toks, start: read j, limit: read List.len(list: read toks))
    let hasBody = bodyOpen >= 0 && (isNative == false || same_stmt_line(toks: read toks, a: read start, b: read bodyOpen))
    // Signature region [pclose+1, sigEnd): return type, effects(...), and the
    // default-impl marker `= _`.
    let sigEnd = function_signature_end(toks: read toks, start: read (pclose + 1))
    let effPos = find_effects_kw(toks: read toks, start: read (pclose + 1), end: read sigEnd)
    let defaultImpl = has_default_impl(toks: read toks, start: read (pclose + 1), end: read sigEnd)
    // A `fresh` anywhere in the return-type region (e.g. `-> Result<fresh String, E>`)
    // also sets returns-fresh, matching parse_function_decl's region scan.
    if hasRet && fresh_in_return(toks: read toks, start: read retStart, sigEnd: read sigEnd) {
        retFresh = true
    }
    // Emit fn line.
    local sb = StringBuilder.new()
    StringBuilder.push(builder: mut sb, value: read "fn name=")
    StringBuilder.push(builder: mut sb, value: read name)
    StringBuilder.push(builder: mut sb, value: read " public=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isPub))
    StringBuilder.push(builder: mut sb, value: read " async=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isAsync))
    StringBuilder.push(builder: mut sb, value: read " native=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read isNative))
    StringBuilder.push(builder: mut sb, value: read " has-body=")
    StringBuilder.push(builder: mut sb, value: read boolstr(b: read hasBody))
    if defaultImpl {
        StringBuilder.push(builder: mut sb, value: read " default-impl=true")
    }
    if hasRet && retFresh {
        StringBuilder.push(builder: mut sb, value: read " returns-fresh=true")
    }
    emit(depth: read d, s: read StringBuilder.finish(builder: take sb))
    // deprecated / lower-name attribute child lines (before generics).
    if haveDep {
        emit(depth: read (d + 1), s: read String.concat(left: read "deprecated ", right: read escape(s: read depReason)))
    }
    if haveLower {
        emit(depth: read (d + 1), s: read String.concat(left: read "lower-name ", right: read lowerName))
    }
    // generics
    emit_generics(toks: read toks, i: read genStart, d: read (d + 1))
    // params
    emit_params(toks: read toks, open: read popen, close: read pclose, d: read (d + 1))
    // return type
    if hasRet {
        emit_type_ref(toks: read toks, i: read retStart, tag: read "return-type", eff: read "", d: read (d + 1))
    }
    // effect-name / effect-retains clauses.
    if effPos >= 0 {
        let eopen = effPos + 1
        let eclose = find_matching(toks: read toks, open: read eopen, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        emit_effects(toks: read toks, open: read eopen, close: read eclose, d: read (d + 1))
    }
    // body — the oracle always emits `body`/`block`, empty when there is no body.
    emit(depth: read (d + 1), s: read "body")
    if hasBody {
        let bclose = find_matching(toks: read toks, open: read bodyOpen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        emit_block(toks: read toks, open: read bodyOpen, close: read bclose, d: read (d + 2))
        return bclose + 1
    }
    emit(depth: read (d + 2), s: read "block")
    // native no-body: consume to end of declaration line.
    return declaration_line_end(toks: read toks, start: read start)
}

fn same_stmt_line(toks: read List<Tok>, a: read Int, b: read Int) -> Bool {
    return tk_line(toks: read toks, i: read a) == tk_line(toks: read toks, i: read b)
}

// True if `fresh` appears in the return-type region [start, sigEnd) before the
// effects clause / body `{` / default-impl `=` (mirrors parse_function_decl).
fn fresh_in_return(toks: read List<Tok>, start: read Int, sigEnd: read Int) -> Bool {
    let mut k = start
    while k < sigEnd {
        if is_kw_text(toks: read toks, i: read k, word: read "effects") || at_symbol(toks: read toks, i: read k, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read k, code: read SYM_EQ) {
            return false
        }
        if at_ident(toks: read toks, i: read k, wid: read WORD_FRESH) { return true }
        k = k + 1
    }
    return false
}

// Index of a top-level `effects(` keyword in [start, end), or -1.
fn find_effects_kw(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        let opener = at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE)
        if depth == 0 && at_ident(toks: read toks, i: read i, wid: read WORD_EFFECTS) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            return i
        }
        if opener { depth = depth + 1 } else if closer { if depth > 0 { depth = depth - 1 } }
        i = i + 1
    }
    return -1
}

// The default-impl marker `= _` appears at top level in the signature region.
fn has_default_impl(toks: read List<Tok>, start: read Int, end: read Int) -> Bool {
    let mut depth = 0
    let mut i = start
    while i < end {
        let opener = at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE)
        let closer = at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) || at_symbol(toks: read toks, i: read i, code: read SYM_RANGLE)
        if depth == 0 && at_symbol(toks: read toks, i: read i, code: read SYM_EQ) && at_ident(toks: read toks, i: read (i + 1), wid: read WORD_UNDERSCORE) {
            return true
        }
        if opener { depth = depth + 1 } else if closer { if depth > 0 { depth = depth - 1 } }
        i = i + 1
    }
    return false
}

// `effects(a, retains(self), ...)` → one `effect-name`/`effect-retains` per entry.
fn emit_effects(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks: read toks, start: read i, end: read close)
        let segEnd = pick_end(comma: read comma, end: read close)
        if is_kw_text(toks: read toks, i: read i, word: read "retains") && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
            emit(depth: read d, s: read String.concat(left: read "effect-retains ", right: read tk_text(toks: read toks, i: read (i + 2))))
        } else if is_ident_tok(toks: read toks, i: read i) && (i + 1) == segEnd {
            emit(depth: read d, s: read String.concat(left: read "effect-name ", right: read tk_text(toks: read toks, i: read i)))
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

// Join a dotted name's identifier tokens [start,end) with '.'.
fn dotted_text(toks: read List<Tok>, start: read Int, end: read Int) -> String {
    local sb = StringBuilder.new()
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_DOT) == false {
            StringBuilder.push(builder: mut sb, value: read tk_text(toks: read toks, i: read i))
        } else {
            StringBuilder.push(builder: mut sb, value: read ".")
        }
        i = i + 1
    }
    return StringBuilder.finish(builder: take sb)
}

// Params in the parens [open, close]: each `name: [effect] Type [= default]`.
fn emit_params(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks: read toks, start: read i, end: read close)
        // name
        let pname = tk_text(toks: read toks, i: read i)
        // after `name :`
        let mut k = i + 2
        let mut effStr = ""
        if is_kw_text(toks: read toks, i: read k, word: read "read") { effStr = "read"; k = k + 1 }
        else if is_kw_text(toks: read toks, i: read k, word: read "mut") { effStr = "mut"; k = k + 1 }
        else if is_kw_text(toks: read toks, i: read k, word: read "take") { effStr = "take"; k = k + 1 }
        let mut line = String.concat(left: read "param name=", right: read pname)
        if String.len(value: read effStr) > 0 {
            let l2 = String.concat(left: read line, right: read " effect=")
            line = String.concat(left: read l2, right: read effStr)
        }
        emit(depth: read d, s: read line)
        emit_type_ref(toks: read toks, i: read k, tag: read "type", eff: read "", d: read (d + 1))
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Generic params, derives, fields, and declaration items.
// -------------------------------------------------------------------------

// Emit `generic` children for a `<...>` param list at i; return index past `>`.
fn emit_generics(toks: read List<Tok>, i: read Int, d: read Int) -> Int {
    if at_symbol(toks: read toks, i: read i, code: read SYM_LANGLE) == false { return i }
    let close = find_matching(toks: read toks, open: read i, openSym: read SYM_LANGLE, closeSym: read SYM_RANGLE)
    if close < 0 { return i }
    let mut k = i + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let name = tk_text(toks: read toks, i: read k)
        emit(depth: read d, s: read String.concat(left: read "generic name=", right: read name))
        // Optional bound: `Name: Bound`.
        if at_symbol(toks: read toks, i: read (k + 1), code: read SYM_COLON) {
            let bw = tk_text(toks: read toks, i: read (k + 2))
            emit(depth: read (d + 1), s: read bound_line(word: read bw))
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return close + 1
}

fn bound_line(word: read String) -> String {
    if word == "Managed" { return "bound managed" }
    if word == "Struct" { return "bound struct" }
    if word == "Resource" { return "bound resource" }
    return String.concat(left: read "bound protocol=", right: read word)
}

// Emit `derive` children for `derives(...)` at i; return index past `)`.
fn emit_derives(toks: read List<Tok>, i: read Int, d: read Int) -> Int {
    if at_ident(toks: read toks, i: read i, wid: read WORD_DERIVES) == false { return i }
    if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) == false { return i }
    let close = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
    if close < 0 { return i }
    let mut k = i + 2
    while k < close {
        if is_ident_tok(toks: read toks, i: read k) {
            emit(depth: read d, s: read String.concat(left: read "derive ", right: read tk_text(toks: read toks, i: read k)))
        }
        k = k + 1
    }
    return close + 1
}

// Index of a top-level `drop` keyword followed by `{` in body (open,close), or -1.
fn find_drop(toks: read List<Tok>, open: read Int, close: read Int) -> Int {
    let mut depth = 0
    let mut i = open + 1
    while i < close {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks: read toks, i: read i, word: read "drop") {
            return i
        }
        i = i + 1
    }
    return -1
}

// One field `name: [handle|weak] Type [= default]` on the line ending at lineEnd.
fn emit_field(toks: read List<Tok>, start: read Int, lineEnd: read Int, d: read Int) -> Unit {
    let name = tk_text(toks: read toks, i: read start)
    let mut k = start + 2
    let mut isHandle = false
    let mut isWeak = false
    if is_kw_text(toks: read toks, i: read k, word: read "handle") { isHandle = true; k = k + 1 }
    else if is_kw_text(toks: read toks, i: read k, word: read "weak") { isWeak = true; k = k + 1 }
    let a = String.concat(left: read "field name=", right: read name)
    let b = String.concat(left: read a, right: read " handle=")
    let c = String.concat(left: read b, right: read boolstr(b: read isHandle))
    let e2 = String.concat(left: read c, right: read " weak=")
    let f = String.concat(left: read e2, right: read boolstr(b: read isWeak))
    emit(depth: read d, s: read f)
    let afterType = emit_type_ref(toks: read toks, i: read k, tag: read "type", eff: read "", d: read (d + 1))
    if at_symbol(toks: read toks, i: read afterType, code: read SYM_EQ) {
        emit(depth: read (d + 1), s: read "default")
        emit_expr(toks: read toks, start: read (afterType + 1), end: read lineEnd, d: read (d + 2))
    }
    return Unit
}

// Emit `field` children for a type/variant body region [start, end).
fn emit_fields(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let mut i = start
    while i < end {
        if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            let le = stmt_end(toks: read toks, start: read i, limit: read end)
            emit_field(toks: read toks, start: read i, lineEnd: read le, d: read d)
            i = le
        } else {
            i = i + 1
        }
    }
    return Unit
}

// class/struct/resource declaration. Returns the next token index.
fn emit_type_decl(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let mut j = start
    let mut isPub = false
    let mut isOpaque = false
    if is_kw_text(toks: read toks, i: read j, word: read "pub") { isPub = true; j = j + 1 }
    if is_kw_text(toks: read toks, i: read j, word: read "opaque") { isOpaque = true; j = j + 1 }
    let mut kind = "struct"
    if is_kw_text(toks: read toks, i: read j, word: read "class") { kind = "class" }
    else if is_kw_text(toks: read toks, i: read j, word: read "resource") { kind = "resource" }
    j = j + 1
    let name = tk_text(toks: read toks, i: read j)
    j = j + 1
    let a = String.concat(left: read "type kind=", right: read kind)
    let b = String.concat(left: read a, right: read " name=")
    let c = String.concat(left: read b, right: read name)
    let e2 = String.concat(left: read c, right: read " public=")
    let f = String.concat(left: read e2, right: read boolstr(b: read isPub))
    let g = String.concat(left: read f, right: read " opaque=")
    let h = String.concat(left: read g, right: read boolstr(b: read isOpaque))
    emit(depth: read d, s: read h)
    j = emit_generics(toks: read toks, i: read j, d: read (d + 1))
    j = emit_derives(toks: read toks, i: read j, d: read (d + 1))
    let openb = find_block_open(toks: read toks, start: read j, limit: read List.len(list: read toks))
    if openb < 0 { return declaration_line_end(toks: read toks, start: read start) }
    let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    let dropPos = find_drop(toks: read toks, open: read openb, close: read close)
    let mut fieldsEnd = close
    if dropPos >= 0 { fieldsEnd = dropPos }
    emit_fields(toks: read toks, start: read (openb + 1), end: read fieldsEnd, d: read (d + 1))
    if dropPos >= 0 {
        let dopen = find_block_open(toks: read toks, start: read dropPos, limit: read close)
        if dopen >= 0 {
            let dclose = find_matching(toks: read toks, open: read dopen, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
            emit(depth: read (d + 1), s: read "drop")
            emit_block(toks: read toks, open: read dopen, close: read dclose, d: read (d + 2))
        }
    }
    return close + 1
}

// sum declaration. Returns the next token index.
fn emit_sum(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let mut j = start
    let mut isPub = false
    if is_kw_text(toks: read toks, i: read j, word: read "pub") { isPub = true; j = j + 1 }
    j = j + 1
    let name = tk_text(toks: read toks, i: read j)
    j = j + 1
    let a = String.concat(left: read "sum name=", right: read name)
    let b = String.concat(left: read a, right: read " public=")
    let c = String.concat(left: read b, right: read boolstr(b: read isPub))
    emit(depth: read d, s: read c)
    j = emit_generics(toks: read toks, i: read j, d: read (d + 1))
    j = emit_derives(toks: read toks, i: read j, d: read (d + 1))
    let openb = find_block_open(toks: read toks, start: read j, limit: read List.len(list: read toks))
    if openb < 0 { return declaration_line_end(toks: read toks, start: read start) }
    let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
    // Variants: newline-separated `Name` or `Name(fields)`.
    let mut i = openb + 1
    while i < close {
        if is_ident_tok(toks: read toks, i: read i) {
            let vname = tk_text(toks: read toks, i: read i)
            emit(depth: read (d + 1), s: read String.concat(left: read "variant name=", right: read vname))
            if at_symbol(toks: read toks, i: read (i + 1), code: read SYM_LPAREN) {
                let vclose = find_matching(toks: read toks, open: read (i + 1), openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
                emit_variant_fields(toks: read toks, open: read (i + 1), close: read vclose, d: read (d + 2))
                i = stmt_end(toks: read toks, start: read i, limit: read close)
            } else {
                i = stmt_end(toks: read toks, start: read i, limit: read close)
            }
        } else {
            i = i + 1
        }
    }
    return close + 1
}

// Variant fields inside parens: comma-separated `name: Type`.
fn emit_variant_fields(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks: read toks, start: read i, end: read close)
        let fend = pick_end(comma: read comma, end: read close)
        if is_ident_tok(toks: read toks, i: read i) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_COLON) {
            emit_field(toks: read toks, start: read i, lineEnd: read fend, d: read d)
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

// const declaration. Returns the next token index.
fn emit_const(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let mut j = start
    let mut isPub = false
    if is_kw_text(toks: read toks, i: read j, word: read "pub") { isPub = true; j = j + 1 }
    j = j + 1
    let nameEnd = take_function_name(toks: read toks, i: read j)
    let name = dotted_text(toks: read toks, start: read j, end: read nameEnd)
    let e = stmt_end(toks: read toks, start: read start, limit: read List.len(list: read toks))
    let a = String.concat(left: read "const name=", right: read name)
    let b = String.concat(left: read a, right: read " public=")
    let c = String.concat(left: read b, right: read boolstr(b: read isPub))
    emit(depth: read d, s: read c)
    let mut k = nameEnd
    if at_symbol(toks: read toks, i: read k, code: read SYM_COLON) {
        k = emit_type_ref(toks: read toks, i: read (k + 1), tag: read "type", eff: read "", d: read (d + 1))
    }
    let asg = top_assign(toks: read toks, start: read k, end: read e)
    if asg >= 0 {
        emit(depth: read (d + 1), s: read "value")
        emit_expr(toks: read toks, start: read (asg + 1), end: read e, d: read (d + 2))
    }
    return e
}

// type alias declaration. Returns the next token index.
fn emit_type_alias(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let mut j = start
    let mut isPub = false
    if is_kw_text(toks: read toks, i: read j, word: read "pub") { isPub = true; j = j + 1 }
    j = j + 1
    let name = tk_text(toks: read toks, i: read j)
    j = j + 1
    let e = stmt_end(toks: read toks, start: read start, limit: read List.len(list: read toks))
    let a = String.concat(left: read "type-alias name=", right: read name)
    let b = String.concat(left: read a, right: read " public=")
    let c = String.concat(left: read b, right: read boolstr(b: read isPub))
    emit(depth: read d, s: read c)
    j = emit_generics(toks: read toks, i: read j, d: read (d + 1))
    let asg = top_assign(toks: read toks, start: read j, end: read e)
    if asg >= 0 {
        emit_type_ref(toks: read toks, i: read (asg + 1), tag: read "target", eff: read "", d: read (d + 1))
    }
    return e
}

// module declaration: `module a.b.c`.
fn emit_module(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let e = stmt_end(toks: read toks, start: read start, limit: read List.len(list: read toks))
    let path = dotted_text(toks: read toks, start: read (start + 1), end: read e)
    emit(depth: read d, s: read String.concat(left: read "module path=", right: read path))
    return e
}

// use declaration: `use a.b.c [as alias]` or `use a.b.*`.
fn emit_use(toks: read List<Tok>, start: read Int, d: read Int) -> Int {
    let e = stmt_end(toks: read toks, start: read start, limit: read List.len(list: read toks))
    // Find `as` alias / `*` glob within the line.
    let mut isGlob = false
    let mut aliasName = ""
    let mut pathEnd = e
    let mut k = start + 1
    while k < e {
        if is_kw_text(toks: read toks, i: read k, word: read "as") {
            pathEnd = k
            aliasName = tk_text(toks: read toks, i: read (k + 1))
            k = e
        } else if at_symbol(toks: read toks, i: read k, code: read SYM_STAR) {
            isGlob = true
            pathEnd = k - 1
            k = e
        } else {
            k = k + 1
        }
    }
    let path = dotted_text(toks: read toks, start: read (start + 1), end: read pathEnd)
    let a = String.concat(left: read "use path=", right: read path)
    let b = String.concat(left: read a, right: read " glob=")
    let mut line = String.concat(left: read b, right: read boolstr(b: read isGlob))
    if String.len(value: read aliasName) > 0 {
        let l2 = String.concat(left: read line, right: read " alias=")
        line = String.concat(left: read l2, right: read aliasName)
    }
    emit(depth: read d, s: read line)
    return e
}

// -------------------------------------------------------------------------
// match (statement + expression) and patterns.
// -------------------------------------------------------------------------

// First top-level symbol with `code` in [start, end), or -1.
fn find_top_sym(toks: read List<Tok>, start: read Int, end: read Int, code: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && at_symbol(toks: read toks, i: read i, code: read code) {
            return i
        }
        i = i + 1
    }
    return -1
}

// First top-level `if` keyword in [start, end), or -1.
fn find_top_if(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut depth = 0
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_LPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_LBRACKET) {
            depth = depth + 1
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_RPAREN) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) || at_symbol(toks: read toks, i: read i, code: read SYM_RBRACKET) {
            depth = depth - 1
        } else if depth == 0 && is_kw_text(toks: read toks, i: read i, word: read "if") {
            return i
        }
        i = i + 1
    }
    return -1
}

// The matching '{' for the '}' at close, scanning back to start, or -1.
fn matching_open_brace(toks: read List<Tok>, close: read Int, start: read Int) -> Int {
    let mut depth = 0
    let mut i = close
    while i >= start {
        if at_symbol(toks: read toks, i: read i, code: read SYM_RBRACE) { depth = depth + 1 }
        else if at_symbol(toks: read toks, i: read i, code: read SYM_LBRACE) {
            depth = depth - 1
            if depth == 0 { return i }
        }
        i = i - 1
    }
    return -1
}

// End index of a dotted pattern/name head starting at `start` (Ident(.Ident)*).
fn dotted_name_end(toks: read List<Tok>, start: read Int, end: read Int) -> Int {
    let mut j = start + 1
    let mut going = true
    while going {
        if j + 1 < end && at_symbol(toks: read toks, i: read j, code: read SYM_DOT) && is_ident_tok(toks: read toks, i: read (j + 1)) {
            j = j + 2
        } else {
            going = false
        }
    }
    return j
}

// True if the name's first char is ASCII-uppercase (constructor-like).
fn is_upper_first(name: read String) -> Bool {
    let cs = String.chars(value: read name)
    if List.len(list: read cs) == 0 { return false }
    let c0 = List.get(list: read cs, index: read 0)
    let code = Char.to_code(value: read c0)
    return code >= 65 && code <= 90
}

fn emit_match(toks: read List<Tok>, matchPos: read Int, braceOpen: read Int, braceClose: read Int, tag: read String, d: read Int) -> Unit {
    let mut vstart = matchPos + 1
    let eff = effect_kw(toks: read toks, i: read vstart)
    let mut line = tag
    if String.len(value: read eff) > 0 {
        let l2 = String.concat(left: read tag, right: read " effect=")
        line = String.concat(left: read l2, right: read eff)
        vstart = vstart + 1
    }
    emit(depth: read d, s: read line)
    emit(depth: read (d + 1), s: read "value")
    emit_expr(toks: read toks, start: read vstart, end: read braceOpen, d: read (d + 2))
    emit_match_arms(toks: read toks, start: read (braceOpen + 1), end: read braceClose, d: read (d + 1))
    return Unit
}

fn emit_match_arms(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    let mut i = start
    while i < end {
        if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) {
            i = i + 1
        } else {
            let lineEnd = next_line_or_block_end(toks: read toks, start: read i, end: read end)
            let arrow = find_top_sym(toks: read toks, start: read i, end: read lineEnd, code: read SYM_FATARROW)
            if arrow < 0 {
                emit(depth: read d, s: read "malformed-arm")
                if lineEnd > i { i = lineEnd } else { i = i + 1 }
            } else {
                let ifPos = find_top_if(toks: read toks, start: read i, end: read arrow)
                let mut patEnd = arrow
                if ifPos >= 0 { patEnd = ifPos }
                emit(depth: read d, s: read "arm")
                emit(depth: read (d + 1), s: read "pattern")
                emit_pattern(toks: read toks, start: read i, end: read patEnd, d: read (d + 2))
                if ifPos >= 0 {
                    emit(depth: read (d + 1), s: read "guard")
                    emit_expr(toks: read toks, start: read (ifPos + 1), end: read arrow, d: read (d + 2))
                }
                let bodyStart = arrow + 1
                if at_symbol(toks: read toks, i: read bodyStart, code: read SYM_LBRACE) {
                    let bclose = find_matching(toks: read toks, open: read bodyStart, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
                    emit_block(toks: read toks, open: read bodyStart, close: read bclose, d: read (d + 1))
                    i = bclose + 1
                } else {
                    let bEnd = next_line_or_block_end(toks: read toks, start: read bodyStart, end: read end)
                    emit(depth: read (d + 1), s: read "block")
                    emit_stmt(toks: read toks, start: read bodyStart, limit: read bEnd, d: read (d + 2))
                    if bEnd > i { i = bEnd } else { i = i + 1 }
                }
            }
        }
    }
    return Unit
}

fn emit_pattern(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    // Tuple pattern `(p0, .., pN)` (>=2 elements) — checked before paren-trim, which
    // would otherwise strip the wrapping parens. Desugars to a `__TupleN` struct.
    if at_symbol(toks: read toks, i: read start, code: read SYM_LPAREN) && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RPAREN) {
        let tclose = find_matching(toks: read toks, open: read start, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        if tclose == end - 1 && count_pat_elems(toks: read toks, open: read start, close: read tclose) >= 2 {
            emit_tuple(toks: read toks, open: read start, close: read tclose, d: read d)
            return Unit
        }
    }
    // List / slice pattern `[a, ..rest, z]`.
    if at_symbol(toks: read toks, i: read start, code: read SYM_LBRACKET) && at_symbol(toks: read toks, i: read (end - 1), code: read SYM_RBRACKET) {
        let lclose = find_matching(toks: read toks, open: read start, openSym: read SYM_LBRACKET, closeSym: read SYM_RBRACKET)
        if lclose == end - 1 {
            emit_list_pattern(toks: read toks, open: read start, close: read lclose, d: read d)
            return Unit
        }
    }
    // Trim wrapping parens.
    let mut s = start
    let mut e = end
    let mut trimming = true
    while trimming {
        if s < e && at_symbol(toks: read toks, i: read s, code: read SYM_LPAREN) {
            let close = find_matching(toks: read toks, open: read s, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
            if close == e - 1 { s = s + 1; e = close } else { trimming = false }
        } else { trimming = false }
    }
    if s >= e { emit(depth: read d, s: read "pat-wildcard"); return Unit }
    // Single-token: literal / wildcard / bare variant.
    if s + 1 == e {
        let k = tk_kind(toks: read toks, i: read s)
        let t = tk_text(toks: read toks, i: read s)
        if k == TOK_NUMBER { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=int ", right: read escape(s: read t))); return Unit }
        if k == TOK_STRING { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=string ", right: read escape(s: read t))); return Unit }
        if k == TOK_CHAR { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=char ", right: read escape(s: read t))); return Unit }
        if t == "true" || t == "false" { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=bool ", right: read t)); return Unit }
        if t == "_" { emit(depth: read d, s: read "pat-wildcard"); return Unit }
        emit(depth: read d, s: read String.concat(left: read "pat-variant name=", right: read t))
        return Unit
    }
    // Dotted head.
    let headEnd = dotted_name_end(toks: read toks, start: read s, end: read e)
    let name = dotted_text(toks: read toks, start: read s, end: read headEnd)
    if at_symbol(toks: read toks, i: read headEnd, code: read SYM_LBRACE) {
        let close = find_matching(toks: read toks, open: read headEnd, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        let rest = struct_pattern_has_rest(toks: read toks, open: read headEnd, close: read close)
        let a = String.concat(left: read "pat-struct name=", right: read name)
        let b = String.concat(left: read a, right: read " rest=")
        let c = String.concat(left: read b, right: read boolstr(b: read rest))
        emit(depth: read d, s: read c)
        emit_struct_fields(toks: read toks, open: read headEnd, close: read close, d: read (d + 1))
        return Unit
    }
    if at_symbol(toks: read toks, i: read headEnd, code: read SYM_LPAREN) {
        let close = find_matching(toks: read toks, open: read headEnd, openSym: read SYM_LPAREN, closeSym: read SYM_RPAREN)
        emit(depth: read d, s: read String.concat(left: read "pat-variant name=", right: read name))
        let mut k = headEnd + 1
        while k < close {
            let comma = split_comma(toks: read toks, start: read k, end: read close)
            let elEnd = pick_end(comma: read comma, end: read close)
            emit_payload_element(toks: read toks, start: read k, end: read elEnd, d: read (d + 1))
            if comma < 0 { k = close } else { k = comma + 1 }
        }
        return Unit
    }
    // Bare (possibly dotted) name → variant with no bindings.
    emit(depth: read d, s: read String.concat(left: read "pat-variant name=", right: read name))
    return Unit
}

// A payload element: single-token disambiguates binding/literal/constructor;
// multi-token is a nested pattern.
fn emit_payload_element(toks: read List<Tok>, start: read Int, end: read Int, d: read Int) -> Unit {
    if start + 1 == end {
        let k = tk_kind(toks: read toks, i: read start)
        let t = tk_text(toks: read toks, i: read start)
        if k == TOK_NUMBER { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=int ", right: read escape(s: read t))); return Unit }
        if k == TOK_STRING { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=string ", right: read escape(s: read t))); return Unit }
        if k == TOK_CHAR { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=char ", right: read escape(s: read t))); return Unit }
        if t == "true" || t == "false" { emit(depth: read d, s: read String.concat(left: read "pat-literal kind=bool ", right: read t)); return Unit }
        if t == "_" { emit(depth: read d, s: read "pat-wildcard"); return Unit }
        if is_upper_first(name: read t) {
            emit(depth: read d, s: read String.concat(left: read "pat-variant name=", right: read t))
        } else {
            emit(depth: read d, s: read String.concat(left: read "pat-binding name=", right: read t))
        }
        return Unit
    }
    emit_pattern(toks: read toks, start: read start, end: read end, d: read d)
    return Unit
}

// True if the struct-pattern body (open,close) contains a top-level `..` rest.
fn struct_pattern_has_rest(toks: read List<Tok>, open: read Int, close: read Int) -> Bool {
    let mut i = open + 1
    while i < close {
        if at_symbol(toks: read toks, i: read i, code: read SYM_DOT) && at_symbol(toks: read toks, i: read (i + 1), code: read SYM_DOT) {
            return true
        }
        i = i + 1
    }
    return false
}

// Struct-pattern fields: `name` | `name: _` | `name: [effect] binding|pattern`.
fn emit_struct_fields(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    let mut i = open + 1
    while i < close {
        let comma = split_comma(toks: read toks, start: read i, end: read close)
        let fEnd = pick_end(comma: read comma, end: read close)
        // Skip a `..` rest segment.
        if at_symbol(toks: read toks, i: read i, code: read SYM_DOT) {
            // rest, already reflected in rest=; emit nothing
            let x = 0
        } else if is_ident_tok(toks: read toks, i: read i) {
            let fname = tk_text(toks: read toks, i: read i)
            let colon = find_top_sym(toks: read toks, start: read i, end: read fEnd, code: read SYM_COLON)
            if colon < 0 {
                // shorthand `name` → binding=name
                let a = String.concat(left: read "pat-field name=", right: read fname)
                let b = String.concat(left: read a, right: read " ignored=false binding=")
                emit(depth: read d, s: read String.concat(left: read b, right: read fname))
            } else {
                emit_struct_field_rhs(toks: read toks, fname: read fname, rhsStart: read (colon + 1), fEnd: read fEnd, d: read d)
            }
        }
        if comma < 0 { i = close } else { i = comma + 1 }
    }
    return Unit
}

fn emit_struct_field_rhs(toks: read List<Tok>, fname: read String, rhsStart: read Int, fEnd: read Int, d: read Int) -> Unit {
    // `name: _` → ignored.
    if rhsStart + 1 == fEnd && is_kw_text(toks: read toks, i: read rhsStart, word: read "_") {
        let a = String.concat(left: read "pat-field name=", right: read fname)
        emit(depth: read d, s: read String.concat(left: read a, right: read " ignored=true"))
        return Unit
    }
    // Optional effect prefix.
    let mut bstart = rhsStart
    let eff = effect_kw(toks: read toks, i: read rhsStart)
    if String.len(value: read eff) > 0 { bstart = rhsStart + 1 }
    let a = String.concat(left: read "pat-field name=", right: read fname)
    let mut head = String.concat(left: read a, right: read " ignored=false")
    if bstart + 1 == fEnd {
        let t = tk_text(toks: read toks, i: read bstart)
        let k = tk_kind(toks: read toks, i: read bstart)
        let isLit = k == TOK_NUMBER || k == TOK_STRING || k == TOK_CHAR || t == "true" || t == "false"
        if isLit || is_upper_first(name: read t) {
            // literal/constructor → nested pattern child, no binding=
            if String.len(value: read eff) > 0 { head = add_effect(line: read head, eff: read eff) }
            emit(depth: read d, s: read head)
            emit_payload_element(toks: read toks, start: read bstart, end: read fEnd, d: read (d + 1))
            return Unit
        }
        // binding
        head = String.concat(left: read head, right: read " binding=")
        head = String.concat(left: read head, right: read t)
        if String.len(value: read eff) > 0 { head = add_effect(line: read head, eff: read eff) }
        emit(depth: read d, s: read head)
        return Unit
    }
    // Nested multi-token pattern.
    if String.len(value: read eff) > 0 { head = add_effect(line: read head, eff: read eff) }
    emit(depth: read d, s: read head)
    emit_pattern(toks: read toks, start: read bstart, end: read fEnd, d: read (d + 1))
    return Unit
}

fn add_effect(line: read String, eff: read String) -> String {
    let a = String.concat(left: read line, right: read " effect=")
    return String.concat(left: read a, right: read eff)
}

// Count comma-separated pattern elements in (open, close).
fn count_pat_elems(toks: read List<Tok>, open: read Int, close: read Int) -> Int {
    let mut n = 0
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        n = n + 1
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return n
}

// Tuple pattern → `pat-struct name=__TupleN rest=false` with item0..itemN fields
// (element mapping identical to a struct-field RHS; no effects).
fn emit_tuple(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    let n = count_pat_elems(toks: read toks, open: read open, close: read close)
    let hdr = String.concat(left: read String.concat(left: read "pat-struct name=__Tuple", right: read String.from_int(value: n)), right: read " rest=false")
    emit(depth: read d, s: read hdr)
    let mut k = open + 1
    let mut idx = 0
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let elEnd = pick_end(comma: read comma, end: read close)
        let fname = String.concat(left: read "item", right: read String.from_int(value: idx))
        emit_struct_field_rhs(toks: read toks, fname: read fname, rhsStart: read k, fEnd: read elEnd, d: read (d + 1))
        idx = idx + 1
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// True if the comma-segment at [segStart, segEnd) is a `..`/`..name` rest segment.
fn is_rest_segment(toks: read List<Tok>, segStart: read Int) -> Bool {
    return at_symbol(toks: read toks, i: read segStart, code: read SYM_DOT) && at_symbol(toks: read toks, i: read (segStart + 1), code: read SYM_DOT)
}

// List pattern: `rest=none|ignore|NAME`, with non-empty `list-prefix`/`list-suffix`.
fn emit_list_pattern(toks: read List<Tok>, open: read Int, close: read Int, d: read Int) -> Unit {
    // Pass 1: find the rest segment and its rendered name.
    let mut restStart = -1
    let mut restStr = "none"
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let segEnd = pick_end(comma: read comma, end: read close)
        if is_rest_segment(toks: read toks, segStart: read k) {
            restStart = k
            let aft = k + 2
            if aft >= segEnd { restStr = "ignore" }
            else if is_kw_text(toks: read toks, i: read aft, word: read "_") { restStr = "ignore" }
            else if is_ident_tok(toks: read toks, i: read aft) { restStr = tk_text(toks: read toks, i: read aft) }
            else { restStr = "ignore" }
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    emit(depth: read d, s: read String.concat(left: read "pat-list rest=", right: read restStr))
    // Prefix: elements before the rest (or all elements when there is no rest).
    let prefixCount = count_list_side(toks: read toks, open: read open, close: read close, restStart: read restStart, before: read true)
    if prefixCount > 0 {
        emit(depth: read (d + 1), s: read "list-prefix")
        emit_list_side(toks: read toks, open: read open, close: read close, restStart: read restStart, before: read true, d: read (d + 2))
    }
    // Suffix: elements after the rest.
    if restStart >= 0 {
        let suffixCount = count_list_side(toks: read toks, open: read open, close: read close, restStart: read restStart, before: read false)
        if suffixCount > 0 {
            emit(depth: read (d + 1), s: read "list-suffix")
            emit_list_side(toks: read toks, open: read open, close: read close, restStart: read restStart, before: read false, d: read (d + 2))
        }
    }
    return Unit
}

// Whether the element starting at k falls on the requested side of the rest.
// (rss has no if-expression, so this is a helper rather than an inline ternary.)
fn on_list_side(restStart: read Int, k: read Int, before: read Bool) -> Bool {
    if before { return restStart < 0 || k < restStart }
    return restStart >= 0 && k > restStart
}

// Count list elements on one side of the rest (before/after), excluding the rest.
fn count_list_side(toks: read List<Tok>, open: read Int, close: read Int, restStart: read Int, before: read Bool) -> Int {
    let mut n = 0
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let isRest = k == restStart
        let onSide = on_list_side(restStart: read restStart, k: read k, before: read before)
        if isRest == false && onSide { n = n + 1 }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return n
}

fn emit_list_side(toks: read List<Tok>, open: read Int, close: read Int, restStart: read Int, before: read Bool, d: read Int) -> Unit {
    let mut k = open + 1
    while k < close {
        let comma = split_comma(toks: read toks, start: read k, end: read close)
        let segEnd = pick_end(comma: read comma, end: read close)
        let isRest = k == restStart
        let onSide = on_list_side(restStart: read restStart, k: read k, before: read before)
        if isRest == false && onSide {
            emit_payload_element(toks: read toks, start: read k, end: read segEnd, d: read d)
        }
        if comma < 0 { k = close } else { k = comma + 1 }
    }
    return Unit
}

// -------------------------------------------------------------------------
// Driver.
// -------------------------------------------------------------------------

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let ntok = List.len(list: read toks)
    emit(depth: read 0, s: read "program")
    let mut i = 0
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == TOK_EOF {
            running = false
        } else if at_symbol(toks: read toks, i: read i, code: read SYM_SEMI) {
            i = i + 1
        } else {
            let cls = classify_top(toks: read toks, i: read i)
            if cls.isFeatures {
                // features line: emit `feature <name>` per known feature word.
                let fend = declaration_line_end(toks: read toks, start: read (i + 2))
                let mut k = i + 2
                while k < fend {
                    if is_feature_word(toks: read toks, i: read k) {
                        emit(depth: read 1, s: read String.concat(left: read "feature ", right: read tk_text(toks: read toks, i: read k)))
                    }
                    k = k + 1
                }
                i = fend
            } else if cls.isProfile {
                i = declaration_line_end(toks: read toks, start: read i)
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read cls.isPub) {
                i = advance(toks: read toks, i: read i, r: read emit_type_decl(toks: read toks, start: read i, d: read 1))
            } else if cls.isSum {
                i = advance(toks: read toks, i: read i, r: read emit_sum(toks: read toks, start: read i, d: read 1))
            } else if cls.isTypeAlias {
                i = advance(toks: read toks, i: read i, r: read emit_type_alias(toks: read toks, start: read i, d: read 1))
            } else if cls.isConst {
                i = advance(toks: read toks, i: read i, r: read emit_const(toks: read toks, start: read i, d: read 1))
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_MODULE) {
                i = advance(toks: read toks, i: read i, r: read emit_module(toks: read toks, start: read i, d: read 1))
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_USE) {
                i = advance(toks: read toks, i: read i, r: read emit_use(toks: read toks, start: read i, d: read 1))
            } else if at_ident(toks: read toks, i: read i, wid: read WORD_PROTOCOL) || at_ident(toks: read toks, i: read i, wid: read WORD_IMPL) || cls.isNativeMod {
                // protocols/impls/native-modules emit in a separate program section
                // (not source order) — skip to keep the stream valid (SH-025).
                i = advance(toks: read toks, i: read i, r: read next_decl_skip(toks: read toks, start: read i))
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read cls.isPub) {
                i = advance(toks: read toks, i: read i, r: read emit_function(toks: read toks, start: read i, d: read 1))
            } else {
                i = advance(toks: read toks, i: read i, r: read next_decl_skip(toks: read toks, start: read i))
            }
        }
    }
    return Unit
}

// Progress guard: never let the driver stall on a decl that returned <= i.
fn advance(toks: read List<Tok>, i: read Int, r: read Int) -> Int {
    if r > i { return r }
    return i + 1
}

fn is_feature_word(toks: read List<Tok>, i: read Int) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) == false { return false }
    let v = tk_val(toks: read toks, i: read i)
    return v == WORD_LOCAL || v == WORD_NATIVE || v == WORD_UNSAFE || v == WORD_ASYNC || v == WORD_DEVICE || v == WORD_FFI || v == WORD_REFLECTION
}

// Skip an unsupported top-level item: to its block end if it has one, else its line end.
fn next_decl_skip(toks: read List<Tok>, start: read Int) -> Int {
    let n = List.len(list: read toks)
    let openb = find_block_open(toks: read toks, start: read start, limit: read n)
    if openb >= 0 && tk_line(toks: read toks, i: read openb) == tk_line(toks: read toks, i: read start) {
        let close = find_matching(toks: read toks, open: read openb, openSym: read SYM_LBRACE, closeSym: read SYM_RBRACE)
        if close > openb { return close + 1 }
    }
    return declaration_line_end(toks: read toks, start: read start)
}
