// Self-hosted rss parser — Phase 2 (recognition parity, driver only).
//
// Reads rss source as argv[0] and prints a verdict:
//   OK               — accepts (no syntax error)
//   ERR <line> <col> — first syntax error position
//
// Oracle: crate::syntax::parse_source_raw (see selfhost_parity.rs). That parser
// is LENIENT: it only rejects on four span vectors — unknown_top_level_spans,
// malformed_declaration_spans, unknown_features, duplicate_features. Function
// and type BODIES are never validated for these; acceptance turns on top-level
// dispatch, declaration-name presence, and balanced ()/{}/<>. This recognizer
// replicates crate::syntax::parser::mod.rs::parse_program and the None-conditions
// of each declaration parser faithfully; it recognize-and-skips statement,
// expression and pattern interiors (they cannot produce an oracle rejection).
//
// The tokenizer, token accessors, declaration parsers and dispatch predicates
// live in selfhost/scan.rss (the shared prelude the harness prepends at compile
// time). Only the parser-unique column accessor, feature-line predicates, and
// the driver remain here.
//
// rss constraints honored (ledger SH-016/SH-017/SH-018): char literals for
// code-point tests, `||` chains wrapped via operator continuation (both in the
// shared scan.rss prelude), cursors threaded positionally.

fn tk_col(toks: read List<Tok>, i: read Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: read toks) { return 0 }
    let t = List.get(list: read toks, index: read i)
    return t.col
}

// ---------------------------------------------------------------------------
// Feature-line predicates.
// ---------------------------------------------------------------------------

fn is_feature_tok(toks: read List<Tok>, i: read Int) -> Bool {
    if is_ident_tok(toks: read toks, i: read i) == false {
        return false
    }
    let v = tk_val(toks: read toks, i: read i)
    return v == 26 || v == 9 || v == 27 || v == 14 || v == 28 || v == 29 || v == 30
}

fn feature_dup(toks: read List<Tok>, fstart: read Int, k: read Int) -> Bool {
    let wk = tk_val(toks: read toks, i: read k)
    let mut j = fstart
    let mut found = false
    while j < k {
        if is_feature_tok(toks: read toks, i: read j) {
            if tk_val(toks: read toks, i: read j) == wk {
                found = true
            }
        }
        j = j + 1
    }
    return found
}

// ---------------------------------------------------------------------------
// Driver.
// ---------------------------------------------------------------------------

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let ntok = List.len(list: read toks)
    let mut i = 0
    let mut errLine = -1
    let mut errCol = -1
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: read toks, i: read i) == 8 {
            running = false
        } else {
            let isPub = at_ident(toks: read toks, i: read i, wid: read 13)
            let isFeatures = at_ident(toks: read toks, i: read i, wid: read 17) && at_symbol(toks: read toks, i: read (i + 1), code: read 58)
            let isProfile = at_ident(toks: read toks, i: read i, wid: read 16) && at_symbol(toks: read toks, i: read (i + 1), code: read 58)
            let isSum = at_ident(toks: read toks, i: read i, wid: read 6) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read 6))
            let isNativeMod = at_ident(toks: read toks, i: read i, wid: read 9) && at_ident(toks: read toks, i: read (i + 1), wid: read 10)
            let isTypeAlias = at_ident(toks: read toks, i: read i, wid: read 11) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read 11))
            let isConst = at_ident(toks: read toks, i: read i, wid: read 12) || (isPub && at_ident(toks: read toks, i: read (i + 1), wid: read 12))
            if isFeatures {
                let fstart = i + 2
                let fend = declaration_line_end(toks: read toks, start: read fstart)
                let mut k = fstart
                let mut ferr = -1
                while k < fend {
                    if at_symbol(toks: read toks, i: read k, code: read 44) {
                        k = k + 1
                    } else {
                        if is_feature_tok(toks: read toks, i: read k) {
                            if ferr < 0 && feature_dup(toks: read toks, fstart: read fstart, k: read k) {
                                ferr = k
                            }
                        } else {
                            let kd = tk_kind(toks: read toks, i: read k)
                            if ferr < 0 && kd != 8 && kd != -1 {
                                ferr = k
                            }
                        }
                        k = k + 1
                    }
                }
                if ferr >= 0 {
                    errLine = tk_line(toks: read toks, i: read ferr)
                    errCol = tk_col(toks: read toks, i: read ferr)
                    running = false
                } else {
                    i = fend
                }
            } else if isProfile {
                i = i + 1
            } else if starts_type_decl(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_type_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if isSum {
                let r = parse_sum_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read 7) {
                let r = parse_protocol_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read 8) {
                let r = parse_impl_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if isNativeMod {
                let r = parse_native_module_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if isTypeAlias {
                let r = parse_type_alias_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if isConst {
                let r = parse_const_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read 10) {
                let r = parse_module_decl(toks: read toks, i: read i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if at_ident(toks: read toks, i: read i, wid: read 15) {
                let r = parse_use_decl(toks: read toks, i: read i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if starts_fn_like(toks: read toks, i: read i, isPub: read isPub) {
                let r = parse_function_decl(toks: read toks, i: read i)
                if r < 0 {
                    errLine = tk_line(toks: read toks, i: read i)
                    errCol = tk_col(toks: read toks, i: read i)
                    running = false
                } else {
                    i = r
                }
            } else {
                errLine = tk_line(toks: read toks, i: read i)
                errCol = tk_col(toks: read toks, i: read i)
                running = false
            }
        }
    }
    if errLine < 0 {
        Log.write(message: read "OK")
    } else {
        let a = String.concat(left: read "ERR ", right: read String.from_int(value: errLine))
        let b = String.concat(left: read a, right: read " ")
        let c = String.concat(left: read b, right: read String.from_int(value: errCol))
        Log.write(message: read c)
    }
    return Unit
}
