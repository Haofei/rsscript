// Self-hosted rss parser — Phase 2 (recognition parity, driver only).
//
// Reads rss source as argv[0] and prints a verdict:
//   OK               — accepts (no syntax error)
//   ERR <line> <col> — first syntax error position
//
// Oracle: crate::syntax::parse_source_raw (see selfhost_parity.rs). That parser
// is LENIENT: it only rejects on four span vectors — unknown_top_level_spans,
// malformed_declaration_spans, unknown_features, duplicate_features. Function
// and type BODIES are never validated for these; acceptance turns on top-level
// dispatch, declaration-name presence, and balanced ()/{}/<>. This recognizer
// replicates crate::syntax::parser::mod.rs::parse_program and the None-conditions
// of each declaration parser faithfully; it recognize-and-skips statement,
// expression and pattern interiors (they cannot produce an oracle rejection).
//
// The tokenizer, token accessors, declaration parsers and dispatch predicates
// live in selfhost/scan.rss. Only the parser-unique column accessor,
// feature-line predicates, and the driver remain here.
//
// rss constraints honored (ledger SH-016/SH-017/SH-018): char literals for
// code-point tests, `||` chains wrapped via operator continuation (both in the
// shared scan.rss prelude), cursors threaded positionally.

module selfhost.parser

use selfhost.scan.*

fn tk_col(toks: List<Tok>, i: Int) -> Int {
    if i < 0 { return 0 }
    if i >= List.len(list: toks) { return 0 }
    let t = List.get(list: toks, index: i)
    return t.col
}

// ---------------------------------------------------------------------------
// Feature-line predicates.
// ---------------------------------------------------------------------------

fn is_feature_tok(toks: List<Tok>, i: Int) -> Bool {
    if is_ident_tok(toks: toks, i: i) == false {
        return false
    }
    let v = tk_val(toks: toks, i: i)
    return v == WORD_LOCAL || v == WORD_NATIVE || v == WORD_UNSAFE || v == WORD_ASYNC || v == WORD_DEVICE || v == WORD_FFI || v == WORD_REFLECTION
}

fn feature_dup(toks: List<Tok>, fstart: Int, k: Int) -> Bool {
    let wk = tk_val(toks: toks, i: k)
    let mut j = fstart
    let mut found = false
    while j < k {
        if is_feature_tok(toks, i: j) {
            if tk_val(toks: toks, i: j) == wk {
                found = true
            }
        }
        j = j + 1
    }
    return found
}

// ---------------------------------------------------------------------------
// Driver.
// ---------------------------------------------------------------------------

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let ntok = List.len(list: toks)
    let mut i = 0
    let mut errLine = -1
    let mut errCol = -1
    let mut running = true
    while running {
        if i >= ntok {
            running = false
        } else if tk_kind(toks: toks, i: i) == TOK_EOF {
            running = false
        } else {
            let cls = classify_top(toks: toks, i: i)
            let isPub = cls.isPub
            let isFeatures = cls.isFeatures
            let isProfile = cls.isProfile
            let isSum = cls.isSum
            let isNativeMod = cls.isNativeMod
            let isTypeAlias = cls.isTypeAlias
            let isConst = cls.isConst
            if isFeatures {
                let fstart = i + 2
                let fend = declaration_line_end(toks: toks, start: fstart)
                let mut k = fstart
                let mut ferr = -1
                while k < fend {
                    if at_symbol(toks: toks, i: k, code: SYM_COMMA) {
                        k = k + 1
                    } else {
                        if is_feature_tok(toks, i: k) {
                            if ferr < 0 && feature_dup(toks, fstart, k) {
                                ferr = k
                            }
                        } else {
                            let kd = tk_kind(toks: toks, i: k)
                            if ferr < 0 && kd != TOK_EOF && kd != -1 {
                                ferr = k
                            }
                        }
                        k = k + 1
                    }
                }
                if ferr >= 0 {
                    errLine = tk_line(toks: toks, i: ferr)
                    errCol = tk_col(toks, i: ferr)
                    running = false
                } else {
                    i = fend
                }
            } else if isProfile {
                i = i + 1
            } else if starts_type_decl(toks: toks, i: i, isPub: isPub) {
                let r = parse_type_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if isSum {
                let r = parse_sum_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_PROTOCOL) {
                let r = parse_protocol_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_IMPL) {
                let r = parse_impl_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if isNativeMod {
                let r = parse_native_module_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if isTypeAlias {
                let r = parse_type_alias_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if isConst {
                let r = parse_const_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_MODULE) {
                let r = parse_module_decl(toks: toks, i: i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if at_ident(toks: toks, i: i, wid: WORD_USE) {
                let r = parse_use_decl(toks: toks, i: i)
                if r < 0 {
                    i = i + 1
                } else {
                    i = r
                }
            } else if starts_fn_like(toks: toks, i: i, isPub: isPub) {
                let r = parse_function_decl(toks: toks, i: i)
                if r < 0 {
                    errLine = tk_line(toks: toks, i: i)
                    errCol = tk_col(toks, i)
                    running = false
                } else {
                    i = r
                }
            } else {
                errLine = tk_line(toks: toks, i: i)
                errCol = tk_col(toks, i)
                running = false
            }
        }
    }
    if errLine < 0 {
        Log.write(message: "OK")
    } else {
        let a = String.concat(left: "ERR ", right: String.from_int(value: errLine))
        let b = String.concat(left: a, right: " ")
        let c = String.concat(left: b, right: String.from_int(value: errCol))
        Log.write(message: c)
    }
    return Unit
}
