// Self-hosted rss lexer — Phase 1.
//
// Reads rss source as argv[0], emits the canonical token dump (see FORMAT.md):
//   <line>:<col>:<len>\t<KIND>\t<PAYLOAD>   one token per line, in lex order.
// Replicates crate::lexer::lex (the oracle) tokenization at tier 0: positions
// are placeholders (0:0:0) — tier-0 parity ignores them.
//
// rss constraints honored throughout (see ledger SH-016/SH-017):
//  - no character literals: compare code points via Char.to_code.
//  - statement-level expressions stay on ONE line.

// The 30 reserved keywords (crate::lexer::KEYWORDS). Contextual words
// (await, native) and builtin constants (true false Ok Err Some None Unit)
// are NOT here — they lex as Ident.
fn is_kw(word: read String) -> Bool {
    return word == "if" || word == "else" || word == "for" || word == "in" || word == "match" || word == "loop" || word == "while" || word == "break" || word == "continue" || word == "return" || word == "features" || word == "class" || word == "struct" || word == "resource" || word == "handle" || word == "fn" || word == "let" || word == "pub" || word == "async" || word == "effects" || word == "drop" || word == "with" || word == "as" || word == "read" || word == "mut" || word == "take" || word == "fresh" || word == "manage" || word == "weak" || word == "local"
}

// Single-char symbols the oracle recognizes (crate::lexer push_one). Any other
// char falls through to payload "?".
fn is_known_symbol(code: read Int) -> Bool {
    return code == 58 || code == 44 || code == 46 || code == 40 || code == 41 || code == 123 || code == 125 || code == 60 || code == 62 || code == 91 || code == 93 || code == 63 || code == 124 || code == 38 || code == 126 || code == 94 || code == 43 || code == 45 || code == 42 || code == 47 || code == 37 || code == 61 || code == 33 || code == 59 || code == 35
}

fn is_ident_start(c: read Char) -> Bool {
    return Char.is_alpha(value: read c) || Char.to_code(value: read c) == 95
}

fn is_ident_cont(c: read Char) -> Bool {
    return Char.is_alphanumeric(value: read c) || Char.to_code(value: read c) == 95
}

// Code point at index i, or -1 if out of bounds.
fn code_at(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    if i < n {
        let c = List.get(list: read chars, index: read i)
        return Char.to_code(value: read c)
    }
    return -1
}

// Raw substring chars[from..to].
fn slice(chars: read List<Char>, from: read Int, to: read Int) -> String {
    let mut out = ""
    let mut k = from
    while k < to {
        let c = List.get(list: read chars, index: read k)
        out = String.concat(left: read out, right: read Char.to_string(value: read c))
        k = k + 1
    }
    return out
}

// Escape a payload exactly like the harness: backslash->\\, \n, \t, \r.
fn escape(s: read String) -> String {
    let cs = String.chars(value: read s)
    let m = List.len(list: read cs)
    let mut out = ""
    let mut k = 0
    while k < m {
        let c = List.get(list: read cs, index: read k)
        let code = Char.to_code(value: read c)
        if code == 92 {
            out = String.concat(left: read out, right: read "\\\\")
        } else if code == 10 {
            out = String.concat(left: read out, right: read "\\n")
        } else if code == 9 {
            out = String.concat(left: read out, right: read "\\t")
        } else if code == 13 {
            out = String.concat(left: read out, right: read "\\r")
        } else {
            out = String.concat(left: read out, right: read Char.to_string(value: read c))
        }
        k = k + 1
    }
    return out
}

fn emit(kind: read String, payload: read String) -> Unit {
    let esc = escape(s: read payload)
    let a = String.concat(left: read "0:0:0\t", right: read kind)
    let b = String.concat(left: read a, right: read "\t")
    let line = String.concat(left: read b, right: read esc)
    Log.write(message: read line)
    return Unit
}

// Line comment `//` to end of line (newline consumed). Skipped, emits nothing.
fn scan_line_comment(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let code = code_at(chars: read chars, n: read n, i: read j)
            j = j + 1
            if code == 10 {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    return j
}

// String literal `"..."` -> String, raw content (escapes bumped, not unescaped).
fn scan_string(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 1
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let code = code_at(chars: read chars, n: read n, i: read j)
            if code == 34 {
                scanning = false
            } else if code == 92 {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else {
                j = j + 1
            }
        }
    }
    let content = slice(chars: read chars, from: read start, to: read j)
    emit(kind: read "String", payload: read content)
    if code_at(chars: read chars, n: read n, i: read j) == 34 {
        return j + 1
    }
    return j
}

// Multiline string `"""..."""` -> MultilineString, raw content, no escapes.
fn scan_multiline(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 3
    let mut j = start
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let c0 = code_at(chars: read chars, n: read n, i: read j)
            let c1 = code_at(chars: read chars, n: read n, i: read (j + 1))
            let c2 = code_at(chars: read chars, n: read n, i: read (j + 2))
            if c0 == 34 && c1 == 34 && c2 == 34 {
                scanning = false
            } else {
                j = j + 1
            }
        }
    }
    let content = slice(chars: read chars, from: read start, to: read j)
    emit(kind: read "MultilineString", payload: read content)
    let d0 = code_at(chars: read chars, n: read n, i: read j)
    let d1 = code_at(chars: read chars, n: read n, i: read (j + 1))
    let d2 = code_at(chars: read chars, n: read n, i: read (j + 2))
    if d0 == 34 && d1 == 34 && d2 == 34 {
        return j + 3
    }
    return j
}

// Interpolated string `$"..."` -> InterpolatedString. Brace-depth scan mirrors
// crate::lexer::lex_interpolated_string.
fn scan_interp(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let start = i + 2
    let mut j = start
    let mut depth = 0
    let mut scanning = true
    while scanning {
        if j >= n {
            scanning = false
        } else {
            let code = code_at(chars: read chars, n: read n, i: read j)
            if code == 34 && depth == 0 {
                scanning = false
            } else if code == 92 {
                j = j + 1
                if j < n {
                    j = j + 1
                }
            } else if depth > 0 && code == 34 {
                j = j + 1
                let mut inner = true
                while inner {
                    if j >= n {
                        inner = false
                    } else {
                        let sc = code_at(chars: read chars, n: read n, i: read j)
                        if sc == 92 {
                            j = j + 1
                            if j < n {
                                j = j + 1
                            }
                        } else {
                            j = j + 1
                            if sc == 34 {
                                inner = false
                            }
                        }
                    }
                }
            } else if code == 123 && depth == 0 && code_at(chars: read chars, n: read n, i: read (j + 1)) == 123 {
                j = j + 2
            } else if code == 125 && depth == 0 && code_at(chars: read chars, n: read n, i: read (j + 1)) == 125 {
                j = j + 2
            } else {
                if code == 123 {
                    depth = depth + 1
                } else if code == 125 {
                    if depth > 0 {
                        depth = depth - 1
                    }
                }
                j = j + 1
            }
        }
    }
    let content = slice(chars: read chars, from: read start, to: read j)
    emit(kind: read "InterpolatedString", payload: read content)
    if code_at(chars: read chars, n: read n, i: read j) == 34 {
        return j + 1
    }
    return j
}

// Number: integer digits, optional single `.` followed by >=1 digit.
fn scan_number(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: read chars, index: read j)
            if Char.is_digit(value: read c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    if code_at(chars: read chars, n: read n, i: read j) == 46 {
        let after = j + 1
        if after < n {
            let cd = List.get(list: read chars, index: read after)
            if Char.is_digit(value: read cd) {
                j = after
                let mut frac = true
                while frac {
                    if j < n {
                        let c = List.get(list: read chars, index: read j)
                        if Char.is_digit(value: read c) {
                            j = j + 1
                        } else {
                            frac = false
                        }
                    } else {
                        frac = false
                    }
                }
            }
        }
    }
    let content = slice(chars: read chars, from: read i, to: read j)
    emit(kind: read "Number", payload: read content)
    return j
}

// Ident or keyword.
fn scan_ident(chars: read List<Char>, n: read Int, i: read Int) -> Int {
    let mut j = i
    let mut scanning = true
    while scanning {
        if j < n {
            let c = List.get(list: read chars, index: read j)
            if is_ident_cont(c: read c) {
                j = j + 1
            } else {
                scanning = false
            }
        } else {
            scanning = false
        }
    }
    let word = slice(chars: read chars, from: read i, to: read j)
    if is_kw(word: read word) {
        emit(kind: read "Keyword", payload: read word)
    } else {
        emit(kind: read "Ident", payload: read word)
    }
    return j
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let chars = String.chars(value: read source)
    let n = List.len(list: read chars)
    let mut i = 0
    while i < n {
        let c = List.get(list: read chars, index: read i)
        let code = Char.to_code(value: read c)
        let c1 = code_at(chars: read chars, n: read n, i: read (i + 1))
        let c2 = code_at(chars: read chars, n: read n, i: read (i + 2))
        if Char.is_whitespace(value: read c) {
            i = i + 1
        } else if code == 47 && c1 == 47 {
            i = scan_line_comment(chars: read chars, n: read n, i: read i)
        } else if code == 34 && c1 == 34 && c2 == 34 {
            i = scan_multiline(chars: read chars, n: read n, i: read i)
        } else if code == 36 && c1 == 34 {
            i = scan_interp(chars: read chars, n: read n, i: read i)
        } else if code == 34 {
            i = scan_string(chars: read chars, n: read n, i: read i)
        } else if Char.is_digit(value: read c) {
            i = scan_number(chars: read chars, n: read n, i: read i)
        } else if is_ident_start(c: read c) {
            i = scan_ident(chars: read chars, n: read n, i: read i)
        } else if code == 45 && c1 == 62 {
            emit(kind: read "Symbol", payload: read "->")
            i = i + 2
        } else if code == 61 && c1 == 62 {
            emit(kind: read "Symbol", payload: read "=>")
            i = i + 2
        } else {
            if is_known_symbol(code: read code) {
                emit(kind: read "Symbol", payload: read Char.to_string(value: read c))
            } else {
                emit(kind: read "Symbol", payload: read "?")
            }
            i = i + 1
        }
    }
    emit(kind: read "Eof", payload: read "")
    return Unit
}
