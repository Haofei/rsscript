// Self-hosted rss lexer — Phase 1 (driver only).
//
// Reads rss source as argv[0], emits the canonical token dump (see docs/self-hosting.md):
//   <line>:<col>:<len>\t<KIND>\t<PAYLOAD>   one token per line, in lex order.
// Replicates crate::lexer::lex (the oracle) tokenization at tier 0: positions
// are placeholders (0:0:0) — tier-0 parity ignores them.
//
module selfhost.lexer

use selfhost.scan.*

// The scanner itself lives in selfhost/scan.rss. This driver simply runs
// `tokenize` and prints one dump line per token: `0:0:0\t<KIND>\t<escape(text)>`.

// Map a Tok.kind int to the canonical KIND name.
fn kind_name(k: read Int) -> String {
    if k == TOK_IDENT { return "Ident" }
    if k == TOK_NUMBER { return "Number" }
    if k == TOK_STRING { return "String" }
    if k == TOK_INTERP { return "InterpolatedString" }
    if k == TOK_MULTILINE { return "MultilineString" }
    if k == TOK_KEYWORD { return "Keyword" }
    if k == TOK_SYMBOL { return "Symbol" }
    if k == TOK_EOF { return "Eof" }
    if k == TOK_CHAR { return "Char" }
    if k == TOK_UNKNOWN { return "Unknown" }
    return "UnknownKind"
}

// Source char length of a token (span length), tier-2 field.
fn tok_len(t: read Tok) -> Int {
    return t.len
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let ntok = List.len(list: read toks)
    let mut i = 0
    while i < ntok {
        let t = List.get(list: read toks, index: read i)
        let kn = kind_name(k: read t.kind)
        let esc = escape(s: read t.text)
        // <line>:<col>:<len>  — line/col are real (tier 1); len is the token's
        // char length (tier 2), 0 for the synthetic EOF.
        let pos = String.concat(left: read String.concat(left: read String.concat(left: read String.from_int(value: t.line), right: read ":"), right: read String.from_int(value: t.col)), right: read ":")
        let plen = String.concat(left: read pos, right: read String.from_int(value: tok_len(t: read t)))
        let a = String.concat(left: read plen, right: read "\t")
        let b = String.concat(left: read a, right: read kn)
        let c = String.concat(left: read b, right: read "\t")
        let line = String.concat(left: read c, right: read esc)
        Log.write(message: read line)
        i = i + 1
    }
    return Unit
}
