// Self-hosted rss lexer — Phase 1 (driver only).
//
// Reads rss source as argv[0], emits the canonical token dump (see FORMAT.md):
//   <line>:<col>:<len>\t<KIND>\t<PAYLOAD>   one token per line, in lex order.
// Replicates crate::lexer::lex (the oracle) tokenization at tier 0: positions
// are placeholders (0:0:0) — tier-0 parity ignores them.
//
// The scanner itself lives in selfhost/scan.rss (the shared prelude the harness
// prepends at compile time). This driver simply runs `tokenize` and prints one
// dump line per token: `0:0:0\t<KIND>\t<escape(text)>`.

// Map a Tok.kind int to the canonical KIND name.
fn kind_name(k: read Int) -> String {
    if k == 1 { return "Ident" }
    if k == 2 { return "Number" }
    if k == 3 { return "String" }
    if k == 4 { return "InterpolatedString" }
    if k == 5 { return "MultilineString" }
    if k == 6 { return "Keyword" }
    if k == 7 { return "Symbol" }
    return "Eof"
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: read "")
    let toks = tokenize(source: read source)
    let ntok = List.len(list: read toks)
    let mut i = 0
    while i < ntok {
        let t = List.get(list: read toks, index: read i)
        let kn = kind_name(k: read t.kind)
        let esc = escape(s: read t.text)
        let a = String.concat(left: read "0:0:0\t", right: read kn)
        let b = String.concat(left: read a, right: read "\t")
        let line = String.concat(left: read b, right: read esc)
        Log.write(message: read line)
        i = i + 1
    }
    return Unit
}
