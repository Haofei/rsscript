// Self-hosted rss lexer — Phase 1 (driver only).
//
// Reads rss source as argv[0], emits the canonical token dump (see docs/self-hosting.md):
//   <line>:<col>:<len>\t<KIND>\t<PAYLOAD>   one token per line, in lex order.
// Replicates crate::lexer::lex (the oracle) tokenization. The dump always emits
// real line/column positions and Unicode-scalar token length; tier-0 parity
// ignores those fields.
//
module selfhost.lexer

use selfhost.scan.*

// The scanner itself lives in selfhost/scan.rss. This driver simply runs
// `tokenize` and prints one dump line per token.

// Map a Tok.kind int to the canonical KIND name.
fn kind_name(k: Int) -> String {
    if k == TOK_IDENT { return "Ident" }
    if k == TOK_NUMBER { return "Number" }
    if k == TOK_STRING { return "String" }
    if k == TOK_INTERP { return "InterpolatedString" }
    if k == TOK_MULTILINE { return "MultilineString" }
    if k == TOK_KEYWORD { return "Keyword" }
    if k == TOK_SYMBOL { return "Symbol" }
    if k == TOK_EOF { return "Eof" }
    if k == TOK_CHAR { return "Char" }
    if k == TOK_UNKNOWN { return "Unknown" }
    return "UnknownKind"
}

// Source char length of a token (span length), tier-2 field.
fn tok_len(t: Tok) -> Int {
    return t.len
}

fn main() -> Unit {
    let source = Args.get_or_default(index: 0, default: "")
    let toks = tokenize(source: source)
    let ntok = List.len(list: toks)
    let mut i = 0
    while i < ntok {
        let t = List.get(list: toks, index: i)
        let kn = kind_name(k: t.kind)
        let esc = escape(s: t.text)
        // <line>:<col>:<len>  — line/col are real (tier 1); len is the token's
        // char length (tier 2), 0 for the synthetic EOF.
        let pos = String.concat(left: String.concat(left: String.concat(left: String.from_int(value: t.line), right: ":"), right: String.from_int(value: t.col)), right: ":")
        let plen = String.concat(left: pos, right: String.from_int(value: tok_len(t)))
        let a = String.concat(left: plen, right: "\t")
        let b = String.concat(left: a, right: kn)
        let c = String.concat(left: b, right: "\t")
        let line = String.concat(left: c, right: esc)
        Log.write(message: line)
        i = i + 1
    }
    return Unit
}
