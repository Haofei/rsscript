
pub fn Directory.exists(path: Path) -> Bool


pub fn Directory.is_file(path: Path) -> Bool


pub fn Directory.is_dir(path: Path) -> Bool


pub fn Directory.create_all(path: Path) -> Result<Unit, FileError>


pub fn Directory.create_dir_all(path: Path) -> Result<Unit, FileError>


pub fn Directory.list_files(path: Path) -> Result<fresh List<String>, FileError>


pub fn Directory.list_paths(path: Path) -> Result<fresh List<Path>, FileError>


pub fn Directory.create(path: Path) -> Result<Unit, FileError>


pub fn Directory.remove_file(path: Path) -> Result<Unit, FileError>


pub fn Directory.remove_dir_all(path: Path) -> Result<Unit, FileError>


pub fn Directory.copy_file(from: Path, to: Path) -> Result<Unit, FileError>


pub fn Directory.rename(from: Path, to: Path) -> Result<Unit, FileError>


struct FileMetadata {
    is_file: Bool
    is_dir: Bool
    len: Int
}

pub fn Directory.metadata(path: Path) -> Result<fresh FileMetadata, FileError>


pub fn Directory.read_string(path: Path) -> Result<fresh String, FileError>


pub fn Directory.write_string(path: Path, content: String) -> Result<Unit, FileError>
