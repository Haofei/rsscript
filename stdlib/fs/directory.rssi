features: native

pub native fn Directory.exists(path: Path) -> Bool
    effects(native)

pub native fn Directory.is_file(path: Path) -> Bool
    effects(native)

pub native fn Directory.is_dir(path: Path) -> Bool
    effects(native)

pub native fn Directory.create_all(path: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.create_dir_all(path: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.list_files(path: Path) -> Result<fresh List<String>, FileError>
    effects(native)

pub native fn Directory.list_paths(path: Path) -> Result<fresh List<Path>, FileError>
    effects(native)

pub native fn Directory.create(path: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.remove_file(path: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.remove_dir_all(path: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.copy_file(from: Path, to: Path) -> Result<Unit, FileError>
    effects(native)

pub native fn Directory.rename(from: Path, to: Path) -> Result<Unit, FileError>
    effects(native)

struct FileMetadata {
    is_file: Bool
    is_dir: Bool
    len: Int
}

pub native fn Directory.metadata(path: Path) -> Result<fresh FileMetadata, FileError>
    effects(native)

pub native fn Directory.read_string(path: Path) -> Result<fresh String, FileError>
    effects(native)

pub native fn Directory.write_string(path: Path, content: String) -> Result<Unit, FileError>
    effects(native)
