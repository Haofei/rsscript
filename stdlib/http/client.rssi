
struct HttpResponse
struct HttpRequest
struct HttpError

pub fn HttpRequest.json(url: Url, body: String) -> fresh HttpRequest


pub fn HttpRequest.with_timeout(
    request: take HttpRequest,
    timeout_ms: Int,
) -> fresh HttpRequest


pub fn HttpRequest.with_retry(
    request: take HttpRequest,
    attempts: Int,
    backoff_ms: Int,
) -> fresh HttpRequest


pub fn HttpRequest.with_header(
    request: take HttpRequest,
    name: String,
    value: String,
) -> fresh HttpRequest


pub fn Http.get(url: Url) -> Result<fresh HttpResponse, HttpError>


pub fn Http.post_json(url: Url, body: String) -> Result<fresh HttpResponse, HttpError>


pub fn Http.post_form(url: Url, body: String) -> Result<fresh HttpResponse, HttpError>


pub fn HttpResponse.status(response: HttpResponse) -> Int


pub fn HttpResponse.text(response: HttpResponse) -> fresh String


pub fn HttpResponse.bytes(response: HttpResponse) -> fresh Bytes


pub fn HttpResponse.lines(response: HttpResponse) -> fresh List<String>


pub fn HttpResponse.is_success(response: HttpResponse) -> Bool


pub fn HttpError.message(error: HttpError) -> String
