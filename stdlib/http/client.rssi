features: native, local

struct HttpResponse
struct HttpRequest
struct HttpError

pub native fn HttpRequest.json(url: Url, body: String) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_timeout(
    request: take HttpRequest,
    timeout_ms: Int,
) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_retry(
    request: take HttpRequest,
    attempts: Int,
    backoff_ms: Int,
) -> fresh HttpRequest
    effects(native)

pub native fn HttpRequest.with_header(
    request: take HttpRequest,
    name: String,
    value: String,
) -> fresh HttpRequest
    effects(native)

pub native fn Http.get(url: Url) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn Http.post_json(url: Url, body: String) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn Http.post_form(url: Url, body: String) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub native fn HttpResponse.status(response: HttpResponse) -> Int
    effects(native)

pub native fn HttpResponse.text(response: HttpResponse) -> fresh String
    effects(native)

pub native fn HttpResponse.bytes(response: HttpResponse) -> fresh Bytes
    effects(native)

pub native fn HttpResponse.lines(response: HttpResponse) -> fresh List<String>
    effects(native)

pub native fn HttpResponse.is_success(response: HttpResponse) -> Bool
    effects(native)

pub native fn HttpError.message(error: HttpError) -> String
    effects(native)
