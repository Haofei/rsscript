features: native

struct Instant
struct Duration

pub native fn Clock.now() -> fresh Instant
    effects(native)

pub native fn Clock.system_unix_ms() -> Int
    effects(native)

pub native fn Instant.elapsed(start: Instant) -> fresh Duration
    effects(native)

pub native fn Duration.ms(value: Int) -> fresh Duration
    effects(native)

pub native fn Duration.seconds(value: Int) -> fresh Duration
    effects(native)

pub native fn Duration.as_ms(value: Duration) -> Int
    effects(native)

pub native fn Duration.as_seconds(value: Duration) -> Int
    effects(native)

pub native fn Duration.add(left: Duration, right: Duration) -> fresh Duration
    effects(native)
