features: native

struct Instant
struct Duration

pub native fn Clock.now() -> fresh Instant
    effects(native)

pub native fn Clock.system_unix_ms() -> Int
    effects(native)

pub native fn Instant.elapsed(start: read Instant) -> fresh Duration
    effects(native)

pub native fn Duration.ms(value: Int) -> fresh Duration
    effects(native)

pub native fn Duration.seconds(value: Int) -> fresh Duration
    effects(native)

pub native fn Duration.as_ms(value: read Duration) -> Int
    effects(native)

pub native fn Duration.as_seconds(value: read Duration) -> Int
    effects(native)

pub native fn Duration.add(left: read Duration, right: read Duration) -> fresh Duration
    effects(native)
