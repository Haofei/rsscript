
pub fn Path.from_string(value: String) -> fresh Path

pub fn Path.join(base: Path, child: String) -> fresh Path

pub fn Path.safe_relative(value: String) -> Result<fresh Path, String>


pub fn Path.resolve_relative(
    root: Path,
    relative: String,
) -> Result<fresh Path, String>


pub fn Path.normalize(path: Path) -> fresh Path


pub fn Path.to_string(path: Path) -> fresh String


pub fn Path.file_name(path: Path) -> Option<String>


pub fn Path.extension(path: Path) -> Option<String>


pub fn Path.parent(path: Path) -> Option<Path>


pub fn Path.is_absolute(path: Path) -> Bool


pub fn Path.with_extension(path: Path, extension: String) -> fresh Path


pub fn Path.starts_with(path: Path, base: Path) -> Bool
