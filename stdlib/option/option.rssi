pub fn Option.is_some<T>(value: Option<T>) -> Bool


pub fn Option.is_none<T>(value: Option<T>) -> Bool


pub fn Option.unwrap_or<T>(value: Option<T>, default: T) -> T


pub fn Option.map<T, U>(
    value: Option<T>,
    mapper: noescape Fn(T) -> U,
) -> Option<U>

pub fn Option.and_then<T, U>(
    value: Option<T>,
    mapper: noescape Fn(T) -> Option<U>,
) -> Option<U>

pub fn Option.ok_or<T, E>(
    value: Option<T>,
    error: E,
) -> Result<T, E>

pub fn Option.or<T>(
    value: Option<T>,
    fallback: Option<T>,
) -> Option<T>

pub fn Option.filter<T>(
    value: Option<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Option<T>

pub fn Option.unwrap_or_else<T>(
    value: Option<T>,
    default: noescape Fn() -> T,
) -> T
