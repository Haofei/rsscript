
struct Regex
struct RegexError

pub fn Regex.compile(pattern: String) -> Result<fresh Regex, RegexError>


pub fn Regex.is_match(regex: Regex, value: String) -> Bool


pub fn Regex.find(regex: Regex, value: String) -> Option<fresh String>


pub fn Regex.captures(regex: Regex, value: String) -> fresh List<String>


pub fn Regex.replace_all(
    regex: Regex,
    value: String,
    replacement: String,
) -> fresh String


pub fn Regex.split(regex: Regex, value: String) -> fresh List<String>


pub fn RegexError.message(error: RegexError) -> String
