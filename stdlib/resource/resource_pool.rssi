features: local

// A resource pool hands out scoped leases of `T: Resource`. Eager constructors
// (`new`/`try_new`) create every resource up front; lazy constructors
// (`lazy`/`try_lazy`) create on demand up to `max_size`, so the size can come
// from configuration. Leases are taken with `with pool.borrow() as x { ... }`
// (or the fallible `with pool.try_borrow()? as x { ... }`) and return to the pool
// when the scope ends. A broken resource can be evicted with `discard` so a lazy
// pool recreates it on the next borrow (transaction rollback).

struct ResourcePool<T: Resource>
struct PoolStats
struct PoolError

pub fn ResourcePool.new<T: Resource>(
    create: noescape Fn() -> T,
    max_size: Int,
) -> fresh ResourcePool<T>

pub fn ResourcePool.try_new<T: Resource, E>(
    create: noescape Fn() -> Result<T, E>,
    max_size: Int,
) -> Result<fresh ResourcePool<T>, E>

// The lazy factory is stored in the pool and called on demand, so it is an
// `owned Fn` (a stored/owning closure), not `noescape`. It must own what it
// captures: capture owned `local` values, which are moved into the factory.
// Capturing a parameter or a non-owned binding is rejected (RS0711).
pub fn ResourcePool.lazy<T: Resource>(
    create: owned Fn() -> T,
    max_size: Int,
) -> fresh ResourcePool<T>

pub fn ResourcePool.try_lazy<T: Resource>(
    create: owned Fn() -> Result<T, PoolError>,
    max_size: Int,
) -> fresh ResourcePool<T>

pub fn ResourcePool.borrow<T: Resource>(pool: mut ResourcePool<T>) -> T

pub fn ResourcePool.try_borrow<T: Resource>(pool: mut ResourcePool<T>) -> Result<T, PoolError>

pub fn ResourcePool.discard<T: Resource>(lease: mut T) -> Unit

pub fn ResourcePool.stats<T: Resource>(pool: mut ResourcePool<T>) -> fresh PoolStats

pub fn PoolStats.capacity(stats: PoolStats) -> Int

pub fn PoolStats.created(stats: PoolStats) -> Int

pub fn PoolStats.available(stats: PoolStats) -> Int

pub fn PoolStats.in_use(stats: PoolStats) -> Int

pub fn PoolError.message(error: PoolError) -> fresh String
