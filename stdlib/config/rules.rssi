struct Rule

struct Config

struct GlobalConfig

pub fn RuleLoader.load_rules(path: Path) -> Result<fresh List<Rule>, ConfigError>

pub fn Config.new(name: String, rules: List<Rule>) -> fresh Config

pub fn Config.rule_count(config: Config) -> Int

pub fn GlobalConfig.new(value: Config) -> fresh GlobalConfig
    effects(retains(value))

pub fn GlobalConfig.replace(
    global: mut GlobalConfig,
    value: Config,
) -> Unit
    effects(retains(value))

pub fn GlobalConfig.rule_count(global: GlobalConfig) -> Int
