struct ConfigValue

struct ConfigStore

pub fn Config.load(path: Path) -> Result<fresh ConfigValue, ConfigError>

pub fn Config.name(value: ConfigValue) -> String

pub fn ConfigStore.new(value: ConfigValue) -> fresh ConfigStore

pub fn ConfigStore.replace(
    store: mut ConfigStore,
    value: ConfigValue,
) -> Unit
    effects(retains(value))

pub fn ConfigStore.name(store: ConfigStore) -> String
