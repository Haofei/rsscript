features: local

struct Deque<T>

pub fn Deque.new<T>() -> fresh Deque<T>

pub fn Deque.push_back<T>(
    deque: mut Deque<T>,
    value: T,
) -> Unit
    effects(retains(value))

pub fn Deque.push_front<T>(
    deque: mut Deque<T>,
    value: T,
) -> Unit
    effects(retains(value))

pub fn Deque.pop_back<T>(deque: mut Deque<T>) -> Option<T>

pub fn Deque.pop_front<T>(deque: mut Deque<T>) -> Option<T>

pub fn Deque.clear<T>(deque: mut Deque<T>) -> Unit

pub fn Deque.len<T>(deque: Deque<T>) -> Int

pub fn Deque.is_empty<T>(deque: Deque<T>) -> Bool

pub fn Deque.to_list<T>(deque: Deque<T>) -> fresh List<T>
