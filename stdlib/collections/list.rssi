
pub fn List.new<T>() -> fresh List<T>

pub fn List.push<T>(
    list: mut List<T>,
    value: T,
) -> Unit
    retains(value)

pub fn List.set<T>(
    list: mut List<T>,
    index: Int,
    value: T,
) -> Unit
    retains(value)

pub fn List.pop<T>(list: mut List<T>) -> Option<T>

pub fn List.clear<T>(list: mut List<T>) -> Unit

pub fn List.append<T>(
    list: mut List<T>,
    values: List<T>,
) -> Unit
    retains(values)

pub fn List.len<T>(list: List<T>) -> Int

pub fn List.get<T>(
    list: List<T>,
    index: Int,
) -> T

pub fn List.count_where<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Int

pub fn List.any<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Bool

pub fn List.all<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Bool

pub fn List.find<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Option<T>

pub fn List.filter<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> fresh List<T>

pub fn List.map<T, U>(
    list: List<T>,
    mapper: noescape Fn(T) -> U,
) -> fresh List<U>

pub fn List.fold<T, U: Struct>(
    list: List<T>,
    initial: U,
    folder: noescape Fn(U, T) -> fresh U,
) -> fresh U

pub fn List.try_fold<T, U: Struct, E>(
    list: List<T>,
    initial: U,
    folder: noescape Fn(U, T) -> Result<fresh U, E>,
) -> Result<fresh U, E>

pub fn List.consume<T>(list: take List<T>) -> Unit

pub fn List.contains<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> Bool

pub fn List.contains_value<T>(
    list: List<T>,
    value: T,
) -> Bool

pub fn List.is_empty<T>(list: List<T>) -> Bool

pub fn List.sum(list: List<Int>) -> Int

pub fn List.min(list: List<Int>) -> Option<Int>

pub fn List.max(list: List<Int>) -> Option<Int>

pub fn List.flatten<T>(list: List<List<T>>) -> fresh List<T>

pub fn List.dedup<T>(list: List<T>) -> fresh List<T>

pub fn List.zip<T>(
    left: List<T>,
    right: List<T>,
) -> fresh List<List<T>>

pub fn List.enumerate(list: List<Int>) -> fresh List<List<Int>>

pub fn List.reverse<T>(list: List<T>) -> fresh List<T>

pub fn List.sort<T: Ord>(
    list: mut List<T>,
) -> Unit

pub fn List.sort_with<T>(
    list: mut List<T>,
    compare: noescape Fn(T, T) -> Int,
) -> Unit

pub fn List.sort_by<T, K>(
    list: List<T>,
    key: noescape Fn(T) -> K,
    compare: noescape Fn(K, K) -> Int,
) -> fresh List<T>

pub fn List.group_by<T, K>(
    list: List<T>,
    key: noescape Fn(T) -> K,
) -> fresh Map<K, List<T>>

pub fn List.partition<T>(
    list: List<T>,
    predicate: noescape Fn(T) -> Bool,
) -> fresh List<List<T>>

pub fn List.flat_map<T, U>(
    list: List<T>,
    mapper: noescape Fn(T) -> List<U>,
) -> fresh List<U>

pub fn List.take<T>(
    list: List<T>,
    count: Int,
) -> fresh List<T>

pub fn List.slice<T>(
    list: List<T>,
    start: Int,
    len: Int,
) -> fresh List<T>

pub fn List.skip<T>(
    list: List<T>,
    count: Int,
) -> fresh List<T>

pub fn List.first<T>(list: List<T>) -> Option<T>

pub fn List.last<T>(list: List<T>) -> Option<T>

pub fn List.remove_at<T>(
    list: mut List<T>,
    index: Int,
) -> Option<T>

pub fn List.join(list: List<String>, separator: String) -> fresh String

pub fn List.to_json_strings(list: List<String>) -> fresh JsonValue


pub fn List.to_json_values(list: List<JsonValue>) -> fresh JsonValue
