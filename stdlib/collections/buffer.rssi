
struct BufferView

pub fn Buffer.new(size: Int) -> fresh Buffer

pub fn Buffer.len(buffer: Buffer) -> Int

pub fn Buffer.is_empty(buffer: Buffer) -> Bool

pub fn Buffer.clear(buffer: mut Buffer) -> Unit

pub fn Buffer.view(
    buffer: Buffer,
    start: Int,
    len: Int,
) -> BufferView

pub fn Buffer.consume(buffer: take Buffer) -> Unit

pub fn BufferView.slice(
    value: BufferView,
    start: Int,
    len: Int,
) -> BufferView

pub fn BufferView.len(value: BufferView) -> Int

pub fn BufferView.is_empty(value: BufferView) -> Bool

pub fn BufferView.to_bytes(value: BufferView) -> fresh Bytes
