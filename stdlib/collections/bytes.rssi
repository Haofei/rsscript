features: local

struct BytesView

pub fn Bytes.from_string(value: read String) -> fresh Bytes

pub fn Bytes.from_buffer(buffer: read Buffer) -> fresh Bytes

pub fn Bytes.from_uints(values: read List<Int>) -> fresh Bytes

pub fn Bytes.to_uints(value: read Bytes) -> fresh List<Int>

pub fn Bytes.len(value: read Bytes) -> Int

pub fn Bytes.is_empty(value: read Bytes) -> Bool

pub fn Bytes.concat(left: read Bytes, right: read Bytes) -> fresh Bytes

pub fn Bytes.slice(
    value: read Bytes,
    start: Int,
    len: Int,
) -> fresh Bytes

pub fn Bytes.view(
    value: read Bytes,
    start: Int,
    len: Int,
) -> BytesView

pub fn Bytes.consume(bytes: take Bytes) -> Unit

pub fn BytesView.slice(
    value: read BytesView,
    start: Int,
    len: Int,
) -> BytesView

pub fn BytesView.len(value: read BytesView) -> Int

pub fn BytesView.is_empty(value: read BytesView) -> Bool

pub fn BytesView.to_bytes(value: read BytesView) -> fresh Bytes

pub fn BytesView.starts_with(value: read BytesView, prefix: read BytesView) -> Bool
