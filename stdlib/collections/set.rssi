struct Set<T>

pub fn Set.new<T>() -> fresh Set<T>

pub fn Set.len<T>(set: read Set<T>) -> Int

pub fn Set.is_empty<T>(set: read Set<T>) -> Bool

pub fn Set.contains<T>(
    set: read Set<T>,
    value: read T,
) -> Bool

pub fn Set.insert<T>(
    set: mut Set<T>,
    value: read T,
) -> Bool
    effects(retains(value))

pub fn Set.remove<T>(
    set: mut Set<T>,
    value: read T,
) -> Bool

pub fn Set.clear<T>(set: mut Set<T>) -> Unit

pub fn Set.to_list<T>(set: read Set<T>) -> fresh List<T>

pub fn Set.for_each<T>(
    set: read Set<T>,
    callback: noescape Fn(T) -> Unit,
) -> Unit

pub fn Set.union<T>(
    left: read Set<T>,
    right: read Set<T>,
) -> fresh Set<T>

pub fn Set.intersection<T>(
    left: read Set<T>,
    right: read Set<T>,
) -> fresh Set<T>

pub fn Set.difference<T>(
    left: read Set<T>,
    right: read Set<T>,
) -> fresh Set<T>

pub fn Set.is_subset<T>(
    left: read Set<T>,
    right: read Set<T>,
) -> Bool
