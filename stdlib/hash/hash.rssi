features: native

pub native fn Hash.sha256_string(value: String) -> fresh String
    effects(native)

pub native fn Hash.sha256_bytes(value: Bytes) -> fresh String
    effects(native)

pub native fn Hash.sha3_224_bytes(value: Bytes) -> fresh Bytes
    effects(native)

pub native fn Hash.sha3_256_bytes(value: Bytes) -> fresh Bytes
    effects(native)

pub native fn Hash.shake128_bytes(value: Bytes, out_len: Int) -> fresh Bytes
    effects(native)

pub native fn Hash.sha256_file(path: Path) -> Result<fresh String, FileError>
    effects(native)

pub native fn Hmac.sha256_string(
    key: String,
    value: String,
) -> fresh String
    effects(native)

pub native fn Hmac.sha256_bytes(
    key: Bytes,
    value: Bytes,
) -> fresh String
    effects(native)
