
struct DecodeError

pub fn Base64.encode(value: String) -> fresh String


pub fn Base64.encode_bytes(value: Bytes) -> fresh String


pub fn Base64.decode(text: String) -> Result<fresh Bytes, DecodeError>


pub fn Base64.decode_string(text: String) -> Result<fresh String, DecodeError>


pub fn Hex.encode(value: Bytes) -> fresh String


pub fn Hex.encode_string(value: String) -> fresh String


pub fn Hex.decode(text: String) -> Result<fresh Bytes, DecodeError>


pub fn Gzip.decompress_bytes(value: Bytes) -> Result<fresh Bytes, DecodeError>


pub fn Url.encode_component(value: String) -> fresh String


pub fn Url.decode_component(value: String) -> Result<fresh String, DecodeError>


pub fn DecodeError.message(error: DecodeError) -> String
