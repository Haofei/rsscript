features: native

struct ProcessOutput {
    status: Int
    stdout: String
    stderr: String
    merged: String
    truncated: Bool
}

struct ProcessEnv {
    name: String
    value: String
}

struct ProcessEvent {
    kind: String
    data: String
    status: Int
}

struct ProcessRequest {
    command: String
    args: List<String>
    cwd: Option<Path>
    stdin: Option<String>
    env: List<ProcessEnv>
    timeout_ms: Int
    merge_stderr: Bool
    output_cap_bytes: Int
}

pub native fn Process.run_stdout(
    command: read String,
    args: read List<String>,
) -> Result<String, String>
    effects(native)

pub native fn Process.run_stdout_timeout(
    command: read String,
    args: read List<String>,
    timeout_ms: Int,
) -> Result<String, String>
    effects(native)

pub native fn Process.run(
    command: read String,
    args: read List<String>,
) -> Result<fresh ProcessOutput, String>
    effects(native)

pub native fn Process.run_timeout(
    command: read String,
    args: read List<String>,
    timeout_ms: Int,
) -> Result<fresh ProcessOutput, String>
    effects(native)

pub native fn Process.run_request(
    request: read ProcessRequest,
) -> Result<fresh ProcessOutput, String>
    effects(native)

pub native fn Process.run_many_stdout(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
) -> Result<List<String>, String>
    effects(native)

pub native fn Process.run_many_stdout_timeout(
    command: read String,
    args: read List<String>,
    appended_args: read List<String>,
    jobs: Int,
    timeout_ms: Int,
) -> Result<List<String>, String>
    effects(native)
