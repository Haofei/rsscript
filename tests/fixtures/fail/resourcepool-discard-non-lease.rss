// expect: RS0710
features: local

resource Session {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

// `discard` evicts a checked-out lease, so it may only be applied to a
// `with ResourcePool.borrow/try_borrow(...) as name` binding. Calling it on an
// ordinary resource is rejected (the runtime needs the lease handle, not a bare
// resource).
fn misuse(session: mut Session) -> Unit {
    ResourcePool.discard(lease: mut session)
}
