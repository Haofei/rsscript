// expect: RS0711
features: local

resource Session {
    fd: Int

    drop {
        OS.close(fd: fd)
    }
}

fn Session.open(host: read String) -> Session

// A lazy factory is stored in the pool, so it must own its captures. Capturing
// the borrowed `host` parameter would not outlive the pool. Bind an owned `local`
// first and capture that instead.
fn run(host: read String) -> Result<Unit, PoolError> {
    local pool = ResourcePool<Session>.lazy(
        create: || Session.open(host: read host),
        max_size: 2,
    )
    return Ok(Unit)
}
