features: local

struct PackageSourceSetFacts {
    total_files: Int
    manifest_files: Int
    interface_files: Int
    source_files: Int
    public_interface_files: Int
    public_source_files: Int
}

struct PackageSourcePathSets {
    interface_paths: handle JsonValue
    source_paths: handle JsonValue
}

fn dogfood_source_root() -> fresh Path {
    let input = Args.get_or_default(
        index: 0,
        default: read "tests/fixtures/pass/dogfood-package-source-set",
    )

    return Path.from_string(value: read input)
}

fn json_error(prefix: read String, error: read JsonError) -> fresh String {
    let message = JsonError.message(error: read error)
    let first = String.concat(left: read prefix, right: read ": ")

    return String.concat(left: read first, right: read message)
}

fn file_error(prefix: read String, error: read FileError) -> fresh String {
    let message = FileError.message(error: read error)
    let first = String.concat(left: read prefix, right: read ": ")

    return String.concat(left: read first, right: read message)
}

fn parse_toml_result(path: read Path) -> Result<JsonValue, String> {
    match Toml.parse_file(path: read path) {
        Ok(value) => {
            return Ok(value)
        }
        Err(error) => {
            return Err(json_error(prefix: read "manifest parse", error: read error))
        }
    }
}

fn json_field_result(
    value: read JsonValue,
    name: read String,
) -> Result<JsonValue, String> {
    match Json.field(value: read value, name: read name) {
        Ok(field) => {
            return Ok(field)
        }
        Err(error) => {
            return Err(json_error(prefix: read "manifest field", error: read error))
        }
    }
}

fn json_string_result(value: read JsonValue) -> Result<String, String> {
    match Json.as_string(value: read value) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(json_error(prefix: read "manifest string", error: read error))
        }
    }
}

fn json_array_item_result(
    value: read JsonValue,
    index: Int,
) -> Result<JsonValue, String> {
    match Json.array_get(value: read value, index: index) {
        Ok(item) => {
            return Ok(item)
        }
        Err(error) => {
            return Err(json_error(prefix: read "manifest array item", error: read error))
        }
    }
}

fn json_array_string_result(value: read JsonValue, index: Int) -> Result<String, String> {
    let item = json_array_item_result(value: read value, index: index)?

    return json_string_result(value: read item)
}

fn json_array_len_result(value: read JsonValue) -> Result<Int, String> {
    match Json.array_len(value: read value) {
        Ok(length) => {
            return Ok(length)
        }
        Err(error) => {
            return Err(json_error(prefix: read "manifest array length", error: read error))
        }
    }
}

fn list_files_result(path: read Path) -> Result<List<String>, String> {
    match Directory.list_files(path: read path) {
        Ok(paths) => {
            return Ok(paths)
        }
        Err(error) => {
            return Err(file_error(prefix: read "source listing", error: read error))
        }
    }
}

fn read_file_text_result(path: read Path) -> Result<String, FileError> {
    with File.open_read(path: read path)? as file {
        let text = File.read_all_string(file: mut file)?

        return Ok(text)
    }
}

fn package_source_path_sets(root: read Path) -> Result<fresh PackageSourcePathSets, String> {
    let manifest_path = Path.join(
        base: read root,
        child: read "rsspkg.toml",
    )
    let manifest = parse_toml_result(path: read manifest_path)?
    let interfaces = json_field_result(value: read manifest, name: read "interfaces")?
    let interface_paths = json_field_result(value: read interfaces, name: read "paths")?
    let sources = json_field_result(value: read manifest, name: read "sources")?
    let source_paths = json_field_result(value: read sources, name: read "paths")?

    return PackageSourcePathSets(
        interface_paths: read interface_paths,
        source_paths: read source_paths,
    )
}

fn add_source_path(
    facts: read PackageSourceSetFacts,
    path: read String,
    contents: read String,
) -> fresh PackageSourceSetFacts {
    let is_manifest = path == "rsspkg.toml"
    let is_interface = String.ends_with(value: read path, suffix: read ".rssi")
    let is_source = String.ends_with(value: read path, suffix: read ".rss")
    let has_public_function = String.contains(value: read contents, needle: read "pub fn ")

    return PackageSourceSetFacts(
        total_files: facts.total_files + 1,
        manifest_files: add_bool(value: facts.manifest_files, condition: is_manifest),
        interface_files: add_bool(value: facts.interface_files, condition: is_interface),
        source_files: add_bool(value: facts.source_files, condition: is_source),
        public_interface_files: add_bool(
            value: facts.public_interface_files,
            condition: is_interface && has_public_function,
        ),
        public_source_files: add_bool(
            value: facts.public_source_files,
            condition: is_source && has_public_function,
        ),
    )
}

fn add_bool(value: Int, condition: Bool) -> Int {
    if condition {
        return value + 1
    }

    return value
}

fn count_source_set_from(
    root: read Path,
    paths: read List<String>,
    index: Int,
    facts: read PackageSourceSetFacts,
) -> Result<fresh PackageSourceSetFacts, String> {
    if index >= List.len(list: read paths) {
        return Ok(PackageSourceSetFacts(
            total_files: facts.total_files,
            manifest_files: facts.manifest_files,
            interface_files: facts.interface_files,
            source_files: facts.source_files,
            public_interface_files: facts.public_interface_files,
            public_source_files: facts.public_source_files,
        ))
    }

    let relative_path = List.get(list: read paths, index: index)
    let file_path = Path.join(
        base: read root,
        child: read relative_path,
    )

    match read_file_text_result(path: read file_path) {
        Ok(contents) => {
            let next = add_source_path(
                facts: read facts,
                path: read relative_path,
                contents: read contents,
            )

            return count_source_set_from(
                root: read root,
                paths: read paths,
                index: index + 1,
                facts: read next,
            )
        }
        Err(error) => {
            return Err(file_error(prefix: read "source read", error: read error))
        }
    }
}

fn count_root_paths_from(
    root: read Path,
    roots: read JsonValue,
    index: Int,
    facts: read PackageSourceSetFacts,
) -> Result<fresh PackageSourceSetFacts, String> {
    let limit = json_array_len_result(value: read roots)?

    if index >= limit {
        return Ok(PackageSourceSetFacts(
            total_files: facts.total_files,
            manifest_files: facts.manifest_files,
            interface_files: facts.interface_files,
            source_files: facts.source_files,
            public_interface_files: facts.public_interface_files,
            public_source_files: facts.public_source_files,
        ))
    }

    let child = json_array_string_result(value: read roots, index: index)?
    let source_root = Path.join(
        base: read root,
        child: read child,
    )
    let paths = list_files_result(path: read source_root)?
    let next = count_source_set_from(
        root: read source_root,
        paths: read paths,
        index: 0,
        facts: read facts,
    )?

    return count_root_paths_from(
        root: read root,
        roots: read roots,
        index: index + 1,
        facts: read next,
    )
}

fn dogfood_source_set_facts() -> Result<fresh PackageSourceSetFacts, String> {
    let root = dogfood_source_root()
    let paths = package_source_path_sets(root: read root)?
    let manifest = PackageSourceSetFacts(
        total_files: 1,
        manifest_files: 1,
        interface_files: 0,
        source_files: 0,
        public_interface_files: 0,
        public_source_files: 0,
    )
    let all_interfaces = count_root_paths_from(
        root: read root,
        roots: read paths.interface_paths,
        index: 0,
        facts: read manifest,
    )?

    return count_root_paths_from(
        root: read root,
        roots: read paths.source_paths,
        index: 0,
        facts: read all_interfaces,
    )
}

fn source_set_summary_line(facts: read PackageSourceSetFacts) -> fresh String {
    let total = String.from_int(value: facts.total_files)
    let manifests = String.from_int(value: facts.manifest_files)
    let interfaces = String.from_int(value: facts.interface_files)
    let sources = String.from_int(value: facts.source_files)
    let public_interfaces = String.from_int(value: facts.public_interface_files)
    let public_sources = String.from_int(value: facts.public_source_files)
    let first = String.concat(left: read "dogfood package sources total=", right: read total)
    let second = String.concat(left: read first, right: read " manifests=")
    let third = String.concat(left: read second, right: read manifests)
    let fourth = String.concat(left: read third, right: read " interfaces=")
    let fifth = String.concat(left: read fourth, right: read interfaces)
    let sixth = String.concat(left: read fifth, right: read " sources=")
    let seventh = String.concat(left: read sixth, right: read sources)
    let eighth = String.concat(left: read seventh, right: read " public_interfaces=")
    let ninth = String.concat(left: read eighth, right: read public_interfaces)
    let tenth = String.concat(left: read ninth, right: read " public_sources=")

    return String.concat(left: read tenth, right: read public_sources)
}

pub fn main() -> Result<Unit, String> {
    let facts = dogfood_source_set_facts()?
    let summary = source_set_summary_line(facts: read facts)

    Log.write(message: read summary)

    Assert.equal_int(left: facts.total_files, right: 5)
    Assert.equal_int(left: facts.manifest_files, right: 1)
    Assert.equal_int(left: facts.interface_files, right: 2)
    Assert.equal_int(left: facts.source_files, right: 2)
    Assert.equal_int(left: facts.public_interface_files, right: 2)
    Assert.equal_int(left: facts.public_source_files, right: 2)

    return Ok(Unit)
}
