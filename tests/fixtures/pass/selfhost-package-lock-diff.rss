features: local

struct PackageLockDiffFacts {
    declared_risk: Int
    package_changes: Int
    high_package_changes: Int
    high_feature_changes: Int
    unmodeled_reasons: Int
}

struct PackageLockDiffDecision {
    risk: Int
    mismatches: Int
}

fn LockRisk.low() -> Int {
    return 1
}

fn LockRisk.elevated() -> Int {
    return 2
}

fn LockRisk.high() -> Int {
    return 3
}

fn LockRisk.unknown() -> Int {
    return 4
}

fn lock_risk_from_string(value: read String) -> Int {
    if value == "unknown" {
        return LockRisk.unknown()
    }

    if value == "high" {
        return LockRisk.high()
    }

    if value == "elevated" {
        return LockRisk.elevated()
    }

    return LockRisk.low()
}

fn max_lock_risk(left: Int, right: Int) -> Int {
    if left > right {
        return left
    }

    return right
}

fn lock_diff_reason_is_modeled(reason: read String) -> Bool {
    if reason == "RSScript package added to lockfile" {
        return true
    }

    if reason == "RSScript package removed from lockfile" {
        return true
    }

    if reason == "RSScript package version changed" {
        return true
    }

    if reason == ".rssi interface hash changed" {
        return true
    }

    if reason == "review metadata hash changed" {
        return true
    }

    if reason == "native wrapper source hash changed" {
        return true
    }

    if reason == "package checksum changed" {
        return true
    }

    if reason == "package feature selection changed" {
        return true
    }

    if reason == "package source changed" {
        return true
    }

    return false
}

fn count_unmodeled_lock_reasons_from(
    reasons: read JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let item = Json.array_get(value: read reasons, index: index)?
    let reason = Json.as_string(value: read item)?
    let rest = count_unmodeled_lock_reasons_from(
        reasons: read reasons,
        index: index + 1,
        limit: limit,
    )?

    if lock_diff_reason_is_modeled(reason: read reason) {
        return Ok(rest)
    }

    return Ok(rest + 1)
}

fn count_unmodeled_lock_reasons(reasons: read JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: read reasons)?

    return count_unmodeled_lock_reasons_from(
        reasons: read reasons,
        index: 0,
        limit: limit,
    )
}

fn count_high_package_changes_from(
    changes: read JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: read changes, index: index)?
    let risk_text = Json.field_string(value: read change, name: read "risk")?
    let rest = count_high_package_changes_from(
        changes: read changes,
        index: index + 1,
        limit: limit,
    )?

    if risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn count_high_feature_fields_from(
    fields: read JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let field = Json.array_get(value: read fields, index: index)?
    let name = Json.field_string(value: read field, name: read "field")?
    let risk_text = Json.field_string(value: read field, name: read "risk")?
    let rest = count_high_feature_fields_from(
        fields: read fields,
        index: index + 1,
        limit: limit,
    )?

    if name == "features" && risk_text == "high" {
        return Ok(rest + 1)
    }

    return Ok(rest)
}

fn count_high_feature_changes_from(
    changes: read JsonValue,
    index: Int,
    limit: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(0)
    }

    let change = Json.array_get(value: read changes, index: index)?
    let fields = Json.field(value: read change, name: read "changes")?
    let field_count = Json.array_len(value: read fields)?
    let high_here = count_high_feature_fields_from(
        fields: read fields,
        index: 0,
        limit: field_count,
    )?
    let rest = count_high_feature_changes_from(
        changes: read changes,
        index: index + 1,
        limit: limit,
    )?

    return Ok(high_here + rest)
}

fn max_package_change_risk_from(
    changes: read JsonValue,
    index: Int,
    limit: Int,
    risk: Int,
) -> Result<Int, JsonError> {
    if index >= limit {
        return Ok(risk)
    }

    let change = Json.array_get(value: read changes, index: index)?
    let risk_text = Json.field_string(value: read change, name: read "risk")?
    let change_risk = lock_risk_from_string(value: read risk_text)
    let next = max_lock_risk(left: risk, right: change_risk)

    return max_package_change_risk_from(
        changes: read changes,
        index: index + 1,
        limit: limit,
        risk: next,
    )
}

fn max_package_change_risk(changes: read JsonValue) -> Result<Int, JsonError> {
    let limit = Json.array_len(value: read changes)?

    return max_package_change_risk_from(
        changes: read changes,
        index: 0,
        limit: limit,
        risk: LockRisk.low(),
    )
}

fn parse_package_lock_diff_facts(
    value: read JsonValue,
) -> Result<fresh PackageLockDiffFacts, JsonError> {
    let risk = Json.field_string(value: read value, name: read "risk")?
    let changes = Json.field(value: read value, name: read "package_changes")?
    let reasons = Json.field(value: read value, name: read "reasons")?
    let change_count = Json.array_len(value: read changes)?

    return PackageLockDiffFacts(
        declared_risk: lock_risk_from_string(value: read risk),
        package_changes: change_count,
        high_package_changes: count_high_package_changes_from(
            changes: read changes,
            index: 0,
            limit: change_count,
        )?,
        high_feature_changes: count_high_feature_changes_from(
            changes: read changes,
            index: 0,
            limit: change_count,
        )?,
        unmodeled_reasons: count_unmodeled_lock_reasons(reasons: read reasons)?,
    )
}

fn classify_package_lock_diff(
    facts: read PackageLockDiffFacts,
    changes: read JsonValue,
) -> Result<fresh PackageLockDiffDecision, JsonError> {
    let risk = max_package_change_risk(changes: read changes)?
    let mismatch = lock_diff_mismatch_count(risk: risk, expected: facts.declared_risk)

    return PackageLockDiffDecision(
        risk: risk,
        mismatches: mismatch,
    )
}

fn lock_diff_mismatch_count(risk: Int, expected: Int) -> Int {
    if risk != expected {
        return 1
    }

    return 0
}

fn selfhost_package_lock_diff_json() -> Result<fresh JsonValue, JsonError> {
    let path = Path.from_string(value: read "tests/fixtures/pass/selfhost-package-lock-diff.json")

    return Json.parse_file(path: read path)
}

fn lock_diff_summary_line(
    facts: read PackageLockDiffFacts,
    decision: read PackageLockDiffDecision,
) -> fresh String {
    let packages = String.from_int(value: facts.package_changes)
    let high_packages = String.from_int(value: facts.high_package_changes)
    let high_features = String.from_int(value: facts.high_feature_changes)
    let mismatches = String.from_int(value: decision.mismatches)
    let unmodeled = String.from_int(value: facts.unmodeled_reasons)
    let first = String.concat(left: read "selfhost package lock diff packages=", right: read packages)
    let second = String.concat(left: read first, right: read " high_packages=")
    let third = String.concat(left: read second, right: read high_packages)
    let fourth = String.concat(left: read third, right: read " high_features=")
    let fifth = String.concat(left: read fourth, right: read high_features)
    let sixth = String.concat(left: read fifth, right: read " mismatches=")
    let seventh = String.concat(left: read sixth, right: read mismatches)
    let eighth = String.concat(left: read seventh, right: read " unmodeled_reasons=")

    return String.concat(left: read eighth, right: read unmodeled)
}

pub fn main() -> Result<Unit, JsonError> {
    let value = selfhost_package_lock_diff_json()?
    let changes = Json.field(value: read value, name: read "package_changes")?
    let facts = parse_package_lock_diff_facts(value: read value)?
    let decision = classify_package_lock_diff(
        facts: read facts,
        changes: read changes,
    )?
    let summary = lock_diff_summary_line(facts: read facts, decision: read decision)

    Log.write(message: read summary)

    Assert.equal_int(left: decision.risk, right: facts.declared_risk)
    Assert.equal_int(left: decision.mismatches, right: 0)
    Assert.equal_int(left: facts.unmodeled_reasons, right: 0)
    Assert.equal_int(left: facts.package_changes, right: 1)
    Assert.equal_int(left: facts.high_package_changes, right: 1)
    Assert.equal_int(left: facts.high_feature_changes, right: 1)

    return Ok(Unit)
}
