features: local

struct Image {
    pixels: Buffer
}

fn Image.load(path: read Path) -> fresh Image
fn Image.ready(image: read Image) -> Bool

fn ok_short_circuit(path: read Path) -> Unit {
    local image = Image.load(path: read path)
    let ok = Image.ready(image: read image) && Image.ready(image: read (manage image))
}
