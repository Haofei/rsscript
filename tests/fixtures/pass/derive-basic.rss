struct Point derives(Clone, Eq, Ord, Hash, JsonEncode, JsonDecode, Schema) {
    x: Int
    y: Int
}

sum Direction derives(Clone, Eq, Ord, ReviewSchema) {
    North
    South
    East
    West
}

fn describe(d: read Direction) -> String {
    match d {
        North => { return "north" }
        South => { return "south" }
        East => { return "east" }
        West => { return "west" }
    }
}

fn main() -> Unit {
    let d = North
    let desc = describe(d: read d)
}
