features: local

class RetainedImageStore {
    entries: Map<String, Image>
}

struct Image {
    pixels: Buffer
}

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: read Image) -> Unit
    effects(retains(image))

fn good_store(cache: mut RetainedImageStore, input: read Path, output: read Path) -> Result<Unit, ImageError> {
    local image = Image.load(path: read input)?
    Image.resize(image: mut image, width: 800, height: 600)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: read shared)
    Image.save(image: read shared, path: read output)?

    return Ok(Unit)
}
