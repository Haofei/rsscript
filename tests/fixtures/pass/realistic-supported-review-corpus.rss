features: local, native

class User {
    id: String
}

struct Session {
    owner: weak User
    trace_id: String
}

struct UploadPlan {
    input: Path
    output: Path
    trace_id: String
}

struct WorkItem {
    plan: UploadPlan
    session: Session
}

class RetainedImageStore {
}

fn RetainedImageStore.store(cache: mut RetainedImageStore, image: read Image) -> Unit
    effects(retains(image))

fn User.lookup(id: read String) -> User
fn User.touch(user: read User) -> Unit

fn audit_step(callback: noescape Fn()) -> Unit {
    callback()
    return Unit
}

fn HttpError.from_config(error: read ConfigError) -> HttpError
fn HttpError.from_json(error: read JsonError) -> HttpError
fn HttpError.from_image(error: read ImageError) -> HttpError
fn HttpError.from_db(error: read DbError) -> HttpError

fn parse_plan(request: read Request) -> Result<fresh UploadPlan, JsonError> {
    let body = Request.path(request: read request)
    let json = Json.parse(text: read body)?
    local input_text = Json.field_string(value: read json, name: read "input")?
    local output_text = Json.field_string(value: read json, name: read "output")?
    local trace_id = Json.field_string(value: read json, name: read "trace")?
    local input = Path.from_string(value: read input_text)
    local output = Path.from_string(value: read output_text)

    return UploadPlan(
        input: take input,
        output: take output,
        trace_id: take trace_id,
    )
}

fn build_session(owner: read User, trace_id: read String) -> fresh Session {
    return Session(
        owner: Weak.from(value: read owner),
        trace_id: read trace_id,
    )
}

fn inspect_session(session: read Session) -> Unit {
    let maybe_owner = Weak.upgrade(value: read session.owner)
    audit_step(callback: || {
        Log.write(message: read session.trace_id)
    })

    return Unit
}

fn build_work_item(request: read Request, owner_id: read String) -> Result<fresh WorkItem, JsonError> {
    local plan = parse_plan(request: read request)?
    let owner = User.lookup(id: read owner_id)
    local session = build_session(owner: read owner, trace_id: read plan.trace_id)

    return WorkItem(plan: take plan, session: take session)
}

fn load_first_row(path: read Path) -> Result<fresh Row, CsvError> {
    local buffer = RowBuffer.new(size: 8192)

    with Csv.open_read(path: read path)? as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
    }

    return Csv.parse_row(buffer: read buffer)
}

fn process_image(plan: read UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, ImageError> {
    local image = Image.load(path: read plan.input)?

    audit_step(callback: || {
        Image.inspect(image: read image)
    })

    Image.resize(image: mut image, width: 1024, height: 768)
    Image.normalize(image: mut image)
    Image.sharpen(image: mut image)

    let shared = manage image
    RetainedImageStore.store(cache: mut cache, image: read shared)
    Image.save(image: read shared, path: read plan.output)?

    return Ok(Unit)
}

fn refresh_config(path: read Path, store: mut ConfigStore) -> Result<Unit, ConfigError> {
    let config = Config.load(path: read path)?
    ConfigStore.replace(store: mut store, value: read config)

    return Ok(Unit)
}

fn run_audit_query(url: read Url, trace_id: read String) -> Result<Unit, DbError> {
    local pool = ResourcePool<DbConnection>.new(
        create: || DbConnection.open(url: read url),
        max_size: 2,
    )

    with ResourcePool.borrow(pool: mut pool) as conn {
        DbConnection.query(conn: mut conn, sql: read trace_id)?
    }

    return Ok(Unit)
}

fn refresh_config_http(path: read Path, store: mut ConfigStore) -> Result<Unit, HttpError> {
    match refresh_config(path: read path, store: mut store) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_config(error: read error))
        }
    }
}

fn build_work_item_http(
    request: read Request,
    owner_id: read String,
) -> Result<WorkItem, HttpError> {
    match build_work_item(request: read request, owner_id: read owner_id) {
        Ok(item) => {
            return Ok(item)
        }
        Err(error) => {
            return Err(HttpError.from_json(error: read error))
        }
    }
}

fn process_image_http(plan: read UploadPlan, cache: mut RetainedImageStore) -> Result<Unit, HttpError> {
    match process_image(plan: read plan, cache: mut cache) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_image(error: read error))
        }
    }
}

fn run_audit_query_http(url: read Url, trace_id: read String) -> Result<Unit, HttpError> {
    match run_audit_query(url: read url, trace_id: read trace_id) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(HttpError.from_db(error: read error))
        }
    }
}

fn persist_trace(cache: mut Cache, trace_id: read String, status: read String) -> Unit {
    Cache.insert(cache: mut cache, key: read trace_id, value: read status)
    return Unit
}

fn handle_request(
    request: read Request,
    owner_id: read String,
    image_store: mut RetainedImageStore,
    config_store: mut ConfigStore,
    status_cache: mut Cache,
    counter: mut Counter,
    db_url: read Url,
) -> Result<fresh Response, HttpError> {
    let config_path = Path.from_string(value: read "config.json")
    refresh_config_http(path: read config_path, store: mut config_store)?

    let item = build_work_item_http(request: read request, owner_id: read owner_id)?
    inspect_session(session: read item.session)
    process_image_http(plan: read item.plan, cache: mut image_store)?
    run_audit_query_http(url: read db_url, trace_id: read item.plan.trace_id)?

    let status = ConfigStore.name(store: read config_store)
    persist_trace(cache: mut status_cache, trace_id: read item.plan.trace_id, status: read status)
    Counter.add(counter: mut counter, amount: 1)
    Log.write(message: read item.plan.trace_id)

    return Response.ok(body: read status)?
}
