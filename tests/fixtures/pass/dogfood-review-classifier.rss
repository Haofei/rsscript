fn parse_review_region(value: read JsonValue) -> Result<fresh ReviewFacts, JsonError> {
    let function_name = Json.field_string(value: read value, name: read "function")?
    let classification = Json.field_string(value: read value, name: read "classification")?
    let reasons = Json.field(value: read value, name: read "reasons")?

    return ReviewFacts(
        function_name: read function_name,
        expected_classification: review_class_from_string(value: read classification),
        public_api: Json.array_contains_string(value: read reasons, item: read "public entry point")?
            || Json.array_contains_string(value: read reasons, item: read "entry point")?,
        has_unknown_call: classification == "unknown",
        has_native_boundary: Json.array_contains_prefix(value: read reasons, prefix: read "native")?,
        has_unsafe_boundary: Json.array_contains_prefix(value: read reasons, prefix: read "unsafe")?,
        has_resource_boundary: Json.array_contains_prefix(value: read reasons, prefix: read "resource ")?
            || Json.array_contains_prefix(value: read reasons, prefix: read "ResourcePool")?,
        has_retains: Json.array_contains_prefix(value: read reasons, prefix: read "retains ")?
            || Json.array_contains_prefix(value: read reasons, prefix: read "retention ")?,
        has_mut: Json.array_contains_prefix(value: read reasons, prefix: read "mut ")?
            || Json.array_contains_string(value: read reasons, item: read "writes to managed state")?,
        has_local: Json.array_contains_string(value: read reasons, item: read "local binding")?,
        has_fresh_return: Json.array_contains_string(value: read reasons, item: read "fresh guarantee boundary")?,
        has_noescape: Json.array_contains_prefix(value: read reasons, prefix: read "noescape")?,
        has_error_boundary: Json.array_contains_string(value: read reasons, item: read "error handling boundary")?,
        callee_risk: review_callee_risk(reasons: read reasons)?,
        line_count: Json.field_int(value: read value, name: read "line_count")?,
    )
}

fn review_callee_risk(reasons: read JsonValue) -> Result<Int, JsonError> {
    if Json.array_contains_prefix(value: read reasons, prefix: read "calls unknown")? {
        return Ok(ReviewClass.unknown())
    }

    if Json.array_contains_prefix(value: read reasons, prefix: read "calls must-review")? {
        return Ok(ReviewClass.must_review())
    }

    return Ok(ReviewClass.low_semantic_risk())
}

fn parse_region_list_from(
    json: read JsonValue,
    index: Int,
    limit: Int,
    items: mut List<ReviewFacts>,
) -> Result<Unit, JsonError> {
    if index >= limit {
        return Ok(Unit)
    }

    let item = Json.array_get(value: read json, index: index)?
    let facts = parse_review_region(value: read item)?
    List.push(list: mut items, value: read facts)

    parse_region_list_from(
        json: read json,
        index: index + 1,
        limit: limit,
        items: mut items,
    )?

    return Ok(Unit)
}

fn parse_file_regions_from(
    files: read JsonValue,
    index: Int,
    limit: Int,
    items: mut List<ReviewFacts>,
) -> Result<Unit, JsonError> {
    if index >= limit {
        return Ok(Unit)
    }

    let file = Json.array_get(value: read files, index: index)?
    let regions = Json.field(value: read file, name: read "regions")?
    let region_count = Json.array_len(value: read regions)?

    parse_region_list_from(
        json: read regions,
        index: 0,
        limit: region_count,
        items: mut items,
    )?

    parse_file_regions_from(
        files: read files,
        index: index + 1,
        limit: limit,
        items: mut items,
    )?

    return Ok(Unit)
}

fn expected_summary_from_json(json: read JsonValue) -> Result<fresh ReviewSummary, JsonError> {
    let summary = Json.field(value: read json, name: read "summary")?
    let must_review = Json.field(value: read summary, name: read "must_review")?
    let low_risk = Json.field(value: read summary, name: read "low_semantic_risk")?
    let unknown = Json.field(value: read summary, name: read "unknown")?

    return ReviewSummary(
        total_functions: Json.field_int(value: read summary, name: read "total_functions")?,
        must_review_functions: Json.field_int(value: read must_review, name: read "functions")?,
        low_risk_functions: Json.field_int(value: read low_risk, name: read "functions")?,
        unknown_functions: Json.field_int(value: read unknown, name: read "functions")?,
        suggested_lines: Json.field_int(value: read summary, name: read "suggested_review_lines")?,
    )
}

fn empty_summary() -> fresh ReviewSummary {
    return ReviewSummary(
        total_functions: 0,
        must_review_functions: 0,
        low_risk_functions: 0,
        unknown_functions: 0,
        suggested_lines: 0,
    )
}

fn add_decision(
    summary: read ReviewSummary,
    decision_value: read ReviewDecision,
) -> fresh ReviewSummary {
    if decision_value.classification == ReviewClass.unknown() {
        return ReviewSummary(
            total_functions: summary.total_functions + 1,
            must_review_functions: summary.must_review_functions,
            low_risk_functions: summary.low_risk_functions,
            unknown_functions: summary.unknown_functions + 1,
            suggested_lines: summary.suggested_lines + decision_value.suggested_lines,
        )
    }

    if decision_value.classification == ReviewClass.must_review() {
        return ReviewSummary(
            total_functions: summary.total_functions + 1,
            must_review_functions: summary.must_review_functions + 1,
            low_risk_functions: summary.low_risk_functions,
            unknown_functions: summary.unknown_functions,
            suggested_lines: summary.suggested_lines + decision_value.suggested_lines,
        )
    }

    return ReviewSummary(
        total_functions: summary.total_functions + 1,
        must_review_functions: summary.must_review_functions,
        low_risk_functions: summary.low_risk_functions + 1,
        unknown_functions: summary.unknown_functions,
        suggested_lines: summary.suggested_lines,
    )
}

fn summarize_list_from(
    items: read List<ReviewFacts>,
    index: Int,
    summary: read ReviewSummary,
) -> fresh ReviewSummary {
    if index >= List.len(list: read items) {
        return ReviewSummary(
            total_functions: summary.total_functions,
            must_review_functions: summary.must_review_functions,
            low_risk_functions: summary.low_risk_functions,
            unknown_functions: summary.unknown_functions,
            suggested_lines: summary.suggested_lines,
        )
    }

    let facts = List.get(list: read items, index: index)
    let decision_value = classify_function(facts: read facts)
    let next = add_decision(summary: read summary, decision_value: read decision_value)

    return summarize_list_from(
        items: read items,
        index: index + 1,
        summary: read next,
    )
}

fn summarize_list(items: read List<ReviewFacts>) -> fresh ReviewSummary {
    return summarize_list_from(
        items: read items,
        index: 0,
        summary: read empty_summary(),
    )
}

fn classification_matches_region(facts: read ReviewFacts) -> Bool {
    let decision_value = classify_function(facts: read facts)

    if decision_value.classification != facts.expected_classification {
        return false
    }

    if decision_value.classification == ReviewClass.low_semantic_risk() {
        return decision_value.suggested_lines == 0
    }

    return decision_value.suggested_lines == facts.line_count
}

fn every_region_classification_matches(
    items: read List<ReviewFacts>,
    index: Int,
) -> Bool {
    if index >= List.len(list: read items) {
        return true
    }

    let facts = List.get(list: read items, index: index)

    if classification_matches_region(facts: read facts) == false {
        return false
    }

    return every_region_classification_matches(
        items: read items,
        index: index + 1,
    )
}

fn classification_mismatch_count_from(
    items: read List<ReviewFacts>,
    index: Int,
) -> Int {
    if index >= List.len(list: read items) {
        return 0
    }

    let facts = List.get(list: read items, index: index)
    let rest = classification_mismatch_count_from(
        items: read items,
        index: index + 1,
    )

    if classification_matches_region(facts: read facts) {
        return rest
    }

    return rest + 1
}

fn classification_mismatch_count(items: read List<ReviewFacts>) -> Int {
    return classification_mismatch_count_from(items: read items, index: 0)
}

fn mismatch_detail(facts: read ReviewFacts) -> fresh String {
    let decision_value = classify_function(facts: read facts)
    let expected = review_class_to_string(value: facts.expected_classification)
    let actual = review_class_to_string(value: decision_value.classification)
    let first = String.concat(left: read facts.function_name, right: read " expected=")
    let second = String.concat(left: read first, right: read expected)
    let third = String.concat(left: read second, right: read " actual=")

    return String.concat(left: read third, right: read actual)
}

fn first_classification_mismatch_from(
    items: read List<ReviewFacts>,
    index: Int,
) -> String {
    if index >= List.len(list: read items) {
        return "none"
    }

    let facts = List.get(list: read items, index: index)

    if classification_matches_region(facts: read facts) == false {
        return mismatch_detail(facts: read facts)
    }

    return first_classification_mismatch_from(
        items: read items,
        index: index + 1,
    )
}

fn first_classification_mismatch(items: read List<ReviewFacts>) -> String {
    return first_classification_mismatch_from(items: read items, index: 0)
}

fn dogfood_fact_list() -> Result<fresh List<ReviewFacts>, JsonError> {
    let path = Path.from_string(value: read "tests/fixtures/pass/dogfood-review-facts.json")
    let json = Json.parse_file(path: read path)?
    let files = Json.field(value: read json, name: read "files")?
    let limit = Json.array_len(value: read files)?
    local items = List<ReviewFacts>.new()

    parse_file_regions_from(
        files: read files,
        index: 0,
        limit: limit,
        items: mut items,
    )?

    return items
}

fn dogfood_expected_summary() -> Result<fresh ReviewSummary, JsonError> {
    let path = Path.from_string(value: read "tests/fixtures/pass/dogfood-review-facts.json")
    let json = Json.parse_file(path: read path)?

    return expected_summary_from_json(json: read json)
}

fn unknown_ratio_percent(summary: read ReviewSummary) -> Int {
    if summary.total_functions == 0 {
        return 0
    }

    return summary.unknown_functions * 100 / summary.total_functions
}

fn dogfood_sample_summary() -> Result<fresh ReviewSummary, JsonError> {
    let items = dogfood_fact_list()?

    return summarize_list(items: read items)
}

fn dogfood_shape_is_expected() -> Result<Bool, JsonError> {
    let items = dogfood_fact_list()?
    let summary = dogfood_sample_summary()?
    let expected = dogfood_expected_summary()?
    let unknown_percent = unknown_ratio_percent(summary: read summary)
    let mismatches = classification_mismatch_count(items: read items)

    if summary.total_functions != expected.total_functions {
        return Ok(false)
    }

    if summary.must_review_functions != expected.must_review_functions {
        return Ok(false)
    }

    if summary.low_risk_functions != expected.low_risk_functions {
        return Ok(false)
    }

    if summary.unknown_functions != expected.unknown_functions {
        return Ok(false)
    }

    if summary.suggested_lines != expected.suggested_lines {
        return Ok(false)
    }

    if mismatches != 0 {
        return Ok(false)
    }

    return Ok(unknown_percent == 0)
}

fn dogfood_summary_line(
    summary: read ReviewSummary,
    mismatches: Int,
    first_mismatch: read String,
) -> fresh String {
    let total = String.from_int(value: summary.total_functions)
    let must = String.from_int(value: summary.must_review_functions)
    let low = String.from_int(value: summary.low_risk_functions)
    let unknown = String.from_int(value: summary.unknown_functions)
    let lines = String.from_int(value: summary.suggested_lines)
    let mismatch_count = String.from_int(value: mismatches)
    let first = String.concat(left: read "dogfood review summary total=", right: read total)
    let second = String.concat(left: read first, right: read " must=")
    let third = String.concat(left: read second, right: read must)
    let fourth = String.concat(left: read third, right: read " low=")
    let fifth = String.concat(left: read fourth, right: read low)
    let sixth = String.concat(left: read fifth, right: read " unknown=")
    let seventh = String.concat(left: read sixth, right: read unknown)
    let eighth = String.concat(left: read seventh, right: read " lines=")
    let ninth = String.concat(left: read eighth, right: read lines)
    let tenth = String.concat(left: read ninth, right: read " mismatches=")
    let eleventh = String.concat(left: read tenth, right: read mismatch_count)
    let twelfth = String.concat(left: read eleventh, right: read " first_mismatch=")

    return String.concat(left: read twelfth, right: read first_mismatch)
}

pub fn main() -> Result<Unit, JsonError> {
    let summary = dogfood_sample_summary()?
    let items = dogfood_fact_list()?
    let expected = dogfood_expected_summary()?
    let unknown_region = make_unknown_region(lines: 7)
    let unknown_decision = classify_function(facts: read unknown_region)
    let mismatches = classification_mismatch_count(items: read items)
    let first_mismatch = first_classification_mismatch(items: read items)
    let summary_line = dogfood_summary_line(
        summary: read summary,
        mismatches: mismatches,
        first_mismatch: read first_mismatch,
    )
    let shape_ok = dogfood_shape_is_expected()?

    Assert.equal_int(left: summary.total_functions, right: expected.total_functions)
    Assert.equal_int(left: summary.must_review_functions, right: expected.must_review_functions)
    Assert.equal_int(left: summary.low_risk_functions, right: expected.low_risk_functions)
    Assert.equal_int(left: summary.unknown_functions, right: expected.unknown_functions)
    Assert.equal_int(left: summary.suggested_lines, right: expected.suggested_lines)
    Assert.equal_int(left: mismatches, right: 0)
    Assert.equal(left: read first_mismatch, right: read "none")
    Assert.equal_int(left: unknown_decision.classification, right: ReviewClass.unknown())
    Assert.equal_bool(left: shape_ok, right: true)
    Assert.equal_bool(left: every_region_classification_matches(items: read items, index: 0), right: true)
    Log.write(message: read summary_line)

    return Ok(Unit)
}
