
async fn write_then_read(path: Path) -> Result<String, FileError> {
    await File.write_string_async(path, text: "hello async io")?
    let text = await File.read_all_string_async(path)?
    return Ok(text)
}

async fn fetch_status(url: Url) -> Result<Int, HttpError> {
    let response = await Http.get_async(url)?
    return Ok(HttpResponse.status(response))
}

fn stream_local_inputs(path: Path) -> Result<Unit, ChannelError> {
    let chunks: Stream<Bytes> = File.bytes_stream(path, chunk_size: 4096)?
    let rows: Stream<Row> = Csv.rows(path, buffer_size: 8192)?
    return Ok(Unit)
}

async fn run_tool() -> Result<String, String> {
    let args = List<String>.new()
    let stdout = await Process.run_stdout_async(command: "printf", args)?
    return Ok(stdout)
}

async fn connect_tcp() -> Result<TcpStream, TcpError> {
    let stream = await Tcp.connect(host: "127.0.0.1", port: 8080)?
    return Ok(stream)
}

async fn connect_websocket(url: Url) -> Result<WebSocket, WebSocketError> {
    let socket = await WebSocket.connect(url)?
    return Ok(socket)
}

async fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: "rsscript-async-common-io.txt")
    let text = await write_then_read(path)?
    Log.write(message: text)
    return Ok(Unit)
}
