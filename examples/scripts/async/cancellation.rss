fn worker_should_stop(token: CancellationToken) -> Bool {
    return CancellationToken.is_cancelled(token)
}

fn main() -> Unit {
    let source = CancellationSource.new()
    let token = CancellationSource.token(source)

    Assert.equal_bool(left: worker_should_stop(token), right: false)

    CancellationSource.cancel(source: mut source)

    Assert.equal_bool(left: worker_should_stop(token), right: true)
    Log.write(message: "cancellation ok")
    return Unit
}
