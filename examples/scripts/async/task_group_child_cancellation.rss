features: async

// A child task observes the group's cancellation by taking the token as a
// `read` parameter. The token is minted in the `task_group` block (where it
// resolves to the real group token); the async child cannot call
// `Task.cancellation_token()` itself (RS0412), because at its definition site
// there is no enclosing group to inherit from.
async fn worker(token: CancellationToken) -> Result<Unit, TimerError> {
    await Timer.sleep_cancellable(ms: 1, token)?
    return Ok(Unit)
}

fn run_workers() -> Result<Unit, TimerError> {
    task_group {
        let token = Task.cancellation_token()

        async let first = worker(token)
        async let second = worker(token)

        await first?
        await second?
    }
    return Ok(Unit)
}

fn main() -> Result<Unit, TimerError> {
    run_workers()?
    Log.write(message: "task group children done")
    return Ok(Unit)
}
