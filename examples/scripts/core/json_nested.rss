fn main() -> Result<Unit, JsonError> {
    let value = Json.parse(text: "{\"profile\":{\"name\":\"RSScript\"}}")?
    let profile = Json.field(value, name: "profile")?
    let name = Json.field_string(value: profile, name: "name")?

    Assert.equal(left: name, right: "RSScript")
    Output.write(message: name)
    return Ok(Unit)
}
