fn put(
    cache: mut Cache,
    key: String,
    value: String,
) -> Unit
    effects(retains(key), retains(value))
{
    Cache.insert(cache: mut cache, key, value)
    return Unit
}

fn main() -> Unit {
    let cache = Cache.new()
    put(cache: mut cache, key: "/users", value: "handled /users")

    let body = Cache.lookup(cache, key: "/users")
    Assert.equal(left: body, right: "handled /users")
    Log.write(message: body)
    return Unit
}
