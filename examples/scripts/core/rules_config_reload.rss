features: local

fn load_rules_config(path: Path) -> Result<fresh Config, ConfigError> {
    let rules = RuleLoader.load_rules(path)?
    return Ok(Config.new(name: "rules", rules))
}

fn reload_rules_config(path: Path, global: mut GlobalConfig) -> Result<Unit, ConfigError> {
    let next = load_rules_config(path)?
    GlobalConfig.replace(global: mut global, value: next)
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let first = Path.from_string(value: "rsscript-rules-first.txt")
    let second = Path.from_string(value: "rsscript-rules-second.txt")
    let first_data = Bytes.from_string(value: "alpha\nbeta\n")
    let second_data = Bytes.from_string(value: "gamma\n")

    with File.open_write(path: first)? as file {
        File.write(file: mut file, data: first_data)?
    }
    with File.open_write(path: second)? as file {
        File.write(file: mut file, data: second_data)?
    }

    match load_rules_config(path: first) {
        Ok(initial) => {
            let global = GlobalConfig.new(value: (manage initial))
            match reload_rules_config(path: second, global: mut global) {
                Ok(unit) => {
                    let count = GlobalConfig.rule_count(global)
                    if count == 1 {
                        Log.write(message: "rules config reloaded")
                    }
                }
                Err(error) => {
                    Log.write(message: "rules config reload failed")
                }
            }
        }
        Err(error) => {
            Log.write(message: "rules config load failed")
        }
    }

    return Ok(Unit)
}
