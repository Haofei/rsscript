
fn read_csv(path: Path) -> Result<Unit, CsvError> {
    local buffer = RowBuffer.new(size: 4096)
    with Csv.open_read(path)? as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
        let row = Csv.parse_row(buffer)?
        let name = Row.field_string(row, index: 0)?
        Assert.equal(left: name, right: "RSScript")
        Log.write(message: name)
    }

    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: "rsscript-csv-example.csv")
    let data = Bytes.from_string(value: "name,amount\nRSScript,42\n")

    with File.open_write(path)? as file {
        File.write(file: mut file, data)?
    }

    match read_csv(path) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            Log.write(message: "csv read failed")
            return Ok(Unit)
        }
    }
}
