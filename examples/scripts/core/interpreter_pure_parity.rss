struct Expr {
    left: Int
    right: Int
}

fn render(value: Int) -> fresh String {
    return String.concat(left: "value=", right: value.to_string())
}

fn main() -> Unit {
    let expr = Expr(left: 20, right: 22)
    match read expr {
        Expr { left, right } => {
            let total = left + right
            Log.write(message: render(value: total))
            Log.trace(event: "eval.parity", message: "done")
        }
    }
}
