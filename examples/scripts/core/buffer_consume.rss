
fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: "rsscript-buffer-consume.txt")
    let data = Bytes.from_string(value: "consume buffer")

    with File.open_write(path)? as file {
        File.write(file: mut file, data)?
    }

    with File.open_read(path)? as file {
        local buffer = Buffer.new(size: 64)
        File.read_into(file: mut file, buffer: mut buffer)?
        Buffer.consume(buffer: take buffer)
    }

    Output.write(message: "buffer consumed")
    return Ok(Unit)
}
