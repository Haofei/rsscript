
fn copy_file(input: Path, output: Path) -> Result<Unit, FileError> {
    local buffer = Buffer.new(size: 8192)

    with File.open_read(path: input)? as reader {
        with File.open_write(path: output)? as writer {
            while File.read_into(file: mut reader, buffer: mut buffer)? {
                File.write_buffer(file: mut writer, buffer)?
                Buffer.clear(buffer: mut buffer)
            }
        }
    }

    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let input = Path.from_string(value: "rsscript-file-copy-buffer-input.txt")
    let output = Path.from_string(value: "rsscript-file-copy-buffer-output.txt")
    let data = Bytes.from_string(value: "file copy buffer ran")

    with File.open_write(path: input)? as file {
        File.write(file: mut file, data)?
    }

    copy_file(input, output)?
    Log.write(message: "file copy buffer ran")
    return Ok(Unit)
}
