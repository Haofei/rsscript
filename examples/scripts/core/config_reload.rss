features: local

fn load_config(path: Path) -> Result<fresh ConfigValue, ConfigError> {
    return Config.load(path)
}

fn reload_config(path: Path, store: mut ConfigStore) -> Result<Unit, ConfigError> {
    let next = load_config(path)?
    ConfigStore.replace(store: mut store, value: next)
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let first = Path.from_string(value: "rsscript-config-first.txt")
    let second = Path.from_string(value: "rsscript-config-second.txt")
    let initial = Bytes.from_string(value: "initial\n")
    let reloaded = Bytes.from_string(value: "reloaded\n")

    with File.open_write(path: first)? as file {
        File.write(file: mut file, data: initial)?
    }
    with File.open_write(path: second)? as file {
        File.write(file: mut file, data: reloaded)?
    }

    match load_config(path: first) {
        Ok(initial) => {
            local store = ConfigStore.new(value: initial)
            match reload_config(path: second, store: mut store) {
                Ok(unit) => {
                    let name = ConfigStore.name(store)
                    Assert.equal(left: name, right: "reloaded")
                    Log.write(message: name)
                }
                Err(error) => {
                    Log.write(message: "config reload failed")
                }
            }
        }
        Err(error) => {
            Log.write(message: "config load failed")
        }
    }
    return Ok(Unit)
}
