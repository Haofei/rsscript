pub fn copy_file(input: Path, output: Path) -> Result<Unit, FileError> {
    with File.open_read(path: input)? as reader {
        with File.open_write(path: output)? as writer {
            let bytes = File.read_all(file: mut reader)?
            File.write(file: mut writer, data: bytes)?
        }
    }
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let input = Path.from_string(value: "rsscript-file-copy-input.txt")
    let output_dir = Path.from_string(value: "rsscript-file-copy-output")
    Directory.create_all(path: output_dir)?
    let output = Path.join(base: output_dir, child: "copy.txt")
    with File.open_write(path: input)? as file {
        File.write_string(file: mut file, text: "file copy ran")?
    }

    copy_file(input, output)?

    Output.write(message: "file copy ran")
    return Ok(Unit)
}
