fn handle_request(request: Request) -> Result<fresh Response, HttpError> {
    let path = Request.path(request)
    let body = String.concat(left: "handled ", right: path)
    return Response.ok(body)
}

fn main() -> Result<Unit, HttpError> {
    let request = Request.new(path: "/users")
    let response = handle_request(request)?
    let body = Response.body(response)

    Assert.equal(left: body, right: "handled /users")
    Log.write(message: body)
    return Ok(Unit)
}
