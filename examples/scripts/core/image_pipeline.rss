features: local

fn process_image(input: read Path, output: read Path) -> Result<Unit, ImageError> {
    local image = Image.load(path: read input)?
    Image.resize(image: mut image, width: 320, height: 240)
    Image.normalize(image: mut image)
    Image.sharpen(image: mut image)
    Image.inspect(image: read image)
    Image.save(image: read image, path: read output)?

    Log.write(message: read "image pipeline ran")
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let input = Path.from_string(value: read "rsscript-image-input.bin")
    let output = Path.from_string(value: read "rsscript-image-output.bin")
    let data = Bytes.from_string(value: read "raw image bytes")

    with File.open_write(path: read input)? as file {
        File.write(file: mut file, data: read data)?
    }

    match process_image(input: read input, output: read output) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            Log.write(message: read "image pipeline failed")
            return Ok(Unit)
        }
    }
}
