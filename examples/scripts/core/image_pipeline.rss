features: local

fn process_image(input: Path, output: Path) -> Result<Unit, ImageError> {
    local image = Image.load(path: input)?
    Image.resize(image: mut image, width: 320, height: 240)
    Image.normalize(image: mut image)
    Image.sharpen(image: mut image)
    Image.inspect(image)
    Image.save(image, path: output)?

    Log.write(message: "image pipeline ran")
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let input = Path.from_string(value: "rsscript-image-input.bin")
    let output = Path.from_string(value: "rsscript-image-output.bin")
    let data = Bytes.from_string(value: "raw image bytes")

    with File.open_write(path: input)? as file {
        File.write(file: mut file, data)?
    }

    match process_image(input, output) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            Log.write(message: "image pipeline failed")
            return Ok(Unit)
        }
    }
}
