fn main() -> Result<Unit, JsonError> {
    let document = Yaml.parse(
        text: "service:\n  name: rss\n  port: 8080\ntags:\n  - cli\n  - server\n",
    )?

    let service = Json.field(value: document, name: "service")?
    let name = Json.field_string(value: service, name: "name")?
    let port = Json.field_int(value: service, name: "port")?

    let tags = Json.field(value: document, name: "tags")?
    let tag_count = Json.array_len(value: tags)?

    Assert.equal(left: name, right: "rss")
    Assert.equal_int(left: port, right: 8080)
    Assert.equal_int(left: tag_count, right: 2)
    Output.write(message: name)
    return Ok(Unit)
}
