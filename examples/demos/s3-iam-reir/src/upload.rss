
async fn upload_report(
    bucket: String,
    key: String,
    body: String,
) -> Result<Unit, String> {
    await S3.put_object(bucket: bucket, key: key, body: body)?
    return Ok(Unit)
}

pub fn Reports.upload_batch(
    bucket: String,
    day: String,
) -> Result<Unit, String> {
    task_group {
        async let summary = upload_report(
            bucket,
            key: "reports/summary.json",
            body: day,
        )
        async let audit = S3.put_object(
            bucket: bucket,
            key: "reports/audit.json",
            body: day,
        )
        async let metrics = S3.put_object(
            bucket: bucket,
            key: "reports/metrics.json",
            body: day,
        )
        async let inventory = S3.put_object(
            bucket: bucket,
            key: "reports/inventory.json",
            body: day,
        )
        async let finance = S3.put_object(
            bucket: bucket,
            key: "reports/finance.json",
            body: day,
        )
        async let security = S3.put_object(
            bucket: bucket,
            key: "reports/security.json",
            body: day,
        )

        await summary?
        await audit?
        await metrics?
        await inventory?
        await finance?
        await security?
    }
    return Ok(Unit)
}
