
async fn upload_report(
    bucket: String,
    key: String,
    body: String,
) -> Result<Unit, String> {
    await S3.put_object(bucket: bucket, key: key, body: body)?
    return Ok(Unit)
}

pub async fn Reports.upload_batch(
    bucket: String,
    day: String,
) -> Result<Unit, String> {
    await upload_report(
        bucket,
        key: "reports/summary.json",
        body: day,
    )?
    return Ok(Unit)
}

pub async fn Reports.cleanup_old_reports(
    bucket: String,
    day: String,
) -> Result<Unit, String> {
    await S3.delete_object(
        bucket: bucket,
        key: "reports/old.json",
    )?
    return Ok(Unit)
}
