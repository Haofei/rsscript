features: async

async fn upload_report(
    bucket: read String,
    key: read String,
    body: read String,
) -> Result<Unit, String> {
    await S3.put_object(bucket: read bucket, key: read key, body: read body)?
    return Ok(Unit)
}

pub async fn Reports.upload_batch(
    bucket: read String,
    day: read String,
) -> Result<Unit, String> {
    await upload_report(
        bucket: read bucket,
        key: read "reports/summary.json",
        body: read day,
    )?
    return Ok(Unit)
}

pub async fn Reports.cleanup_old_reports(
    bucket: read String,
    day: read String,
) -> Result<Unit, String> {
    await S3.delete_object(
        bucket: read bucket,
        key: read "reports/old.json",
    )?
    return Ok(Unit)
}
