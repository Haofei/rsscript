
async fn persist_event(
    table: String,
    payload: String,
) -> Result<Unit, String> {
    await DB.insert_event(table: table, payload: payload)?
    return Ok(Unit)
}

pub async fn Audit.record_login(
    user: String,
) -> Result<Unit, String> {
    await persist_event(
        table: "audit_events",
        payload: user,
    )?
    return Ok(Unit)
}
