struct AgentMessage {
    value: JsonValue
}

struct AgentState {
    messages: List<AgentMessage>
    step: Int
    finished: Bool
}

struct ToolLoopResult {
    called_tool: Bool
    messages: List<AgentMessage>
}

fn AgentMessage.from_value(value: read JsonValue) -> fresh AgentMessage {
    return AgentMessage(value: value.clone())
}

fn AgentMessage.system(content: read String) -> fresh AgentMessage {
    return AgentMessage.from_value({"role": "system", "content": content})
}

fn AgentMessage.user(content: read String) -> fresh AgentMessage {
    return AgentMessage.from_value({"role": "user", "content": content})
}

fn AgentMessage.tool(call_id: read String, content: read String) -> fresh AgentMessage {
    return AgentMessage.from_value({"role": "tool", "tool_call_id": call_id, "content": content})
}

fn AgentState.new(task: read String) -> fresh AgentState {
    return AgentState(
        messages: [AgentMessage.system(code_agent_instructions()), AgentMessage.user(task)],
        step: 0,
        finished: false,
    )
}

fn AgentState.can_continue(state: read AgentState, max_steps: Int) -> Bool {
    return state.finished == false && state.step < max_steps
}
