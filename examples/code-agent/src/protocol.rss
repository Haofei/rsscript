fn response_content(response: read String) -> String {
    return Json.string_at_or(
        text: read response,
        path: read "choices[0].message.content",
        fallback: read response,
    )
}

fn argument_field(arguments: read String, name: read String, fallback: read String) -> String {
    return Json.string_at_or(text: read arguments, path: read name, fallback: read fallback)
}
