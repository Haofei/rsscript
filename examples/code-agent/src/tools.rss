sum ToolRuntime {
    CoreToolRuntime
}


struct ToolRequest {
    id: String
    name: String
    arguments: String
}

struct ToolResult {
    id: String
    name: String
    content: JsonValue
}

fn ToolRequest.new(id: read String, name: read String, arguments: read String) -> fresh ToolRequest {
    return ToolRequest(id, name, arguments)
}

fn ToolResult.new(id: read String, name: read String, content: read JsonValue) -> fresh ToolResult {
    return ToolResult(id, name, content: content.clone())
}

