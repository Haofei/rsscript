features: local

fn load_config(path: read Path) -> Result<fresh ConfigValue, ConfigError> {
    return Config.load(path: read path)
}

fn reload_config(path: read Path, store: mut ConfigStore) -> Result<Unit, ConfigError> {
    let next = load_config(path: read path)?
    ConfigStore.replace(store: mut store, value: read next)
    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let first = Path.from_string(value: read "rsscript-config-first.txt")
    let second = Path.from_string(value: read "rsscript-config-second.txt")
    let initial = Bytes.from_string(value: read "initial\n")
    let reloaded = Bytes.from_string(value: read "reloaded\n")

    with File.open_write(path: read first)? as file {
        File.write(file: mut file, data: read initial)?
    }
    with File.open_write(path: read second)? as file {
        File.write(file: mut file, data: read reloaded)?
    }

    match load_config(path: read first) {
        Ok(initial) => {
            local store = ConfigStore.new(value: read initial)
            match reload_config(path: read second, store: mut store) {
                Ok(unit) => {
                    let name = ConfigStore.name(store: read store)
                    Assert.equal(left: read name, right: read "reloaded")
                    Log.write(message: read name)
                }
                Err(error) => {
                    Log.write(message: read "config reload failed")
                }
            }
        }
        Err(error) => {
            Log.write(message: read "config load failed")
        }
    }
    return Ok(Unit)
}
