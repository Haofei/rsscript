fn output_from_process(label: read String, args: read List<String>, output: read ProcessOutput, max_chars: Int) -> fresh ToolAction {
    let status_text = String.from_int(value: output.status)
    let truncated_text = String.from_bool(value: output.truncated)
    let body = [
        "command=", label, " ", args.join(" "),
        "\nexit=", status_text,
        "\nprocess_output_truncated=", truncated_text,
        "\nmerged:\n", String.copy(value: read output.merged),
        "\nstdout:\n", String.copy(value: read output.stdout),
        "\nstderr:\n", String.copy(value: read output.stderr),
    ].join("")
    let tool_output = output_with_cap(body, max_chars)
    if output.status != 0 {
        return ToolAction(response: Some(ToolOutput.error(content: read tool_output.content)), finish: false, abort: false, final_answer: "")
    }
    return ToolAction(response: Some(tool_output), finish: false, abort: false, final_answer: "")
}

fn process_request(command: read String, args: read List<String>, config: read AgentConfig, timeout_ms: Int, max_output_chars: Int) -> fresh ProcessRequest {
    let cwd = Path.normalize(path: read config.repo_root)
    let mut copied_args = List<String>.new()
    mut copied_args.append(args)
    return ProcessRequest(
        command: String.copy(value: read command),
        args: copied_args,
        cwd: Some(cwd),
        stdin: None,
        env: List<ProcessEnv>.new(),
        timeout_ms: timeout_ms,
        merge_stderr: true,
        output_cap_bytes: max_output_chars,
    )
}

fn execute_shell(arguments: read String, config: read AgentConfig) -> fresh ToolAction {
    match shell_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = shell_args(arguments)
    let cmd = string_or(decoded.cmd, "")
    if cmd == "" {
        return ToolAction.error(content: read "error: shell requires arguments.cmd")
    }
    if shell_command_policy_error(cmd).is_some() {
        return ToolAction.error(content: read "error: use rss_check/rss_cmd instead of shell for RSScript commands")
    }
    let timeout_ms = bounded_limit(int_or(decoded.timeout_ms, config.model.timeout_ms), config.model.timeout_ms, 300000)
    let max_chars = bounded_limit(int_or(decoded.max_output_chars, 12000), 12000, 50000)
    let args: List<String> = ["-c", cmd]
    let request = process_request("sh", args, config, timeout_ms, max_chars)
    match Process.run_request(request: read request) {
        Ok(output) => {
            return output_from_process("sh", args, output, max_chars)
        }
        Err(error) => {
            return ToolAction.error(content: read ["error running shell: ", error].join(""))
        }
    }
}

fn shell_command_policy_error(cmd: read String) -> Option<String> {
    if cmd.starts_with("rss ") || cmd.contains("&& rss ") || cmd.contains("; rss ") || cmd.contains("\nrss ") {
        return Some("rss command")
    }
    if cmd.starts_with("cargo run --") || cmd.contains(" cargo run --") {
        return Some("rss cargo wrapper command")
    }
    return None
}

fn execute_rss_check(arguments: read String, config: read AgentConfig) -> fresh ToolAction {
    match rss_check_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = rss_check_args(arguments)
    let path_text = string_or(decoded.path, "")
    if path_text == "" {
        return ToolAction.error(content: read "error: rss_check requires arguments.path")
    }
    let timeout_ms = bounded_limit(int_or(decoded.timeout_ms, 120000), 120000, 300000)
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            let args: List<String> = ["run", "--quiet", "--bin", "rss", "--", "check", path.to_string()]
            let request = process_request("cargo", args, config, timeout_ms, 50000)
            match Process.run_request(request: read request) {
                Ok(output) => {
                    return output_from_process("cargo", args, output, 50000)
                }
                Err(error) => {
                    return ToolAction.error(content: read ["error running rss_check: ", error].join(""))
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}

fn execute_rss_cmd(arguments: read String, config: read AgentConfig) -> fresh ToolAction {
    match rss_cmd_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = rss_cmd_args(arguments)
    let command = string_or(decoded.command, "")
    if command == "" {
        return ToolAction.error(content: read "error: rss_cmd requires arguments.command")
    }
    if rss_command_allowed(command) == false {
        return ToolAction.error(content: read "error: rss_cmd command must be check, lint, fmt, test, or pkg")
    }
    let timeout_ms = bounded_limit(int_or(decoded.timeout_ms, 120000), 120000, 300000)
    let max_chars = bounded_limit(int_or(decoded.max_output_chars, 20000), 20000, 50000)
    let mut args: List<String> = ["run", "--quiet", "--bin", "rss", "--", command]
    match decoded.args {
        Some(extra_args) => {
            mut args.append(extra_args)
        }
        None => {
        }
    }
    let path_text = string_or(decoded.path, "")
    if path_text != "" {
        match resolve_repo_path(config.repo_root, path_text) {
            Ok(path) => {
                mut args.push(path.to_string())
            }
            Err(error) => {
                return tool_path_error(path_text, error)
            }
        }
    }
    let request = process_request("cargo", args, config, timeout_ms, max_chars)
    match Process.run_request(request: read request) {
        Ok(output) => {
            return output_from_process("cargo", args, output, max_chars)
        }
        Err(error) => {
            return ToolAction.error(content: read ["error running rss_cmd: ", error].join(""))
        }
    }
}

fn rss_command_allowed(command: read String) -> Bool {
    return command == "check" || command == "lint" || command == "fmt" || command == "test" || command == "pkg"
}

fn execute_rss_ide(arguments: read String, config: read AgentConfig) -> fresh ToolAction {
    match rss_ide_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = rss_ide_args(arguments)
    let action = string_or(decoded.action, "")
    let path_text = string_or(decoded.path, "")
    let query = string_or(decoded.query, "")
    let max_results = bounded_limit(int_or(decoded.max_results, 20), 20, 100)
    if action == "" {
        return ToolAction.error(content: read "error: rss_ide requires arguments.action")
    }
    if rss_ide_action_allowed(action) == false {
        return ToolAction.error(content: read "error: rss_ide action must be diagnostics, symbols, outline, hover, definition, or references")
    }
    if path_text == "" {
        return ToolAction.error(content: read "error: rss_ide requires arguments.path")
    }
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            let mut args: List<String> = ["run", "--quiet", "--bin", "rss", "--", "ide", "--json", action, path.to_string()]
            if query != "" {
                mut args.push("--query")
                mut args.push(query)
            }
            if max_results != 20 {
                mut args.push("--max")
                mut args.push(max_results.to_string())
            }
            let line = int_or(decoded.line, 0)
            let column = int_or(decoded.column, 0)
            if line > 0 {
                mut args.push("--line")
                mut args.push(line.to_string())
            }
            if column > 0 {
                mut args.push("--column")
                mut args.push(column.to_string())
            }
            if bool_or(decoded.include_declaration, false) {
                mut args.push("--include-declaration")
            }
            let request = process_request("cargo", args, config, config.model.timeout_ms, 50000)
            match Process.run_request(request: read request) {
                Ok(output) => {
                    return output_from_process("cargo", args, output, 50000)
                }
                Err(error) => {
                    return ToolAction.error(content: read ["error running rss_ide: ", error].join(""))
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}

fn rss_ide_action_allowed(action: read String) -> Bool {
    return action == "diagnostics" || action == "symbols" || action == "outline" || action == "hover" || action == "definition" || action == "references"
}

fn execute_finish(arguments: read String) -> fresh ToolAction {
    match finish_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = finish_args(arguments)
    let answer = string_or(decoded.answer, "")
    if answer == "" {
        return ToolAction.error(content: read "error: finish requires arguments.answer")
    }
    return ToolAction.finish(answer: read answer)
}
