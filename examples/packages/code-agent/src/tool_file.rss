fn read_selection(content: String, start_line: Int, max_lines: Int) -> fresh String {
    let lines = content.lines()
    let total = lines.len()
    let start_index = start_line - 1
    let mut selected = List<String>.new()
    let mut index = start_index
    while index < total && selected.len() < max_lines {
        mut selected.push(lines.get(index))
        index = index + 1
    }
    return selected.join("\n")
}

fn read_header(
    path_text: String,
    content: String,
    start_line: Int,
    max_lines: Int,
    selection: String,
) -> fresh String {
    let total_lines = content.lines().len()
    let shown_lines = selection.lines().len()
    let end_line = start_line + shown_lines - 1
    let parts: List<String> = [
        "path=", path_text,
        "\nstart_line=", start_line.to_string(),
        "\nend_line=", end_line.to_string(),
        "\ntotal_lines=", total_lines.to_string(),
        "\nshown_lines=", shown_lines.to_string(),
        "\nmax_lines=", max_lines.to_string(),
        "\n---\n",
    ]
    return parts.join("")
}

fn execute_read(arguments: String, config: AgentConfig) -> fresh ToolAction {
    match read_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = read_args(arguments)
    let path_text = string_or(decoded.path, "")
    if path_text == "" {
        return ToolAction.error(content: "error: read requires arguments.path")
    }
    let start_line = bounded_limit(int_or(decoded.start_line, 1), 1, 1000000)
    let max_lines = bounded_limit(int_or(decoded.max_lines, 200), 200, 5000)
    let max_chars = bounded_limit(int_or(decoded.max_output_chars, 12000), 12000, 50000)
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            match Directory.metadata(path) {
                Ok(metadata) => {
                    if metadata.len > config.max_read_bytes {
                        let body = {
                            "ok": false,
                            "path": path_text,
                            "error": "file exceeds max_read_bytes",
                            "max_read_bytes": config.max_read_bytes,
                        }
                        return ToolAction.error(content: Json.encode(value: body))
                    }
                }
                Err(error) => {
                    return ToolAction.error(content: ["error reading metadata for ", path_text, ": ", error.message()].join(""))
                }
            }
            match path.read_string() {
                Ok(content) => {
                    let selected = read_selection(content, start_line, max_lines)
                    let header = read_header(path_text, content, start_line, max_lines, selected)
                    let output = [header, selected].join("")
                    let capped = output_with_cap(output, max_chars)
                    return ToolAction(response: Some(capped), finish: false, abort: false, final_answer: "")
                }
                Err(error) => {
                    let body = ["error reading ", path_text, ": ", error.message()].join("")
                    return ToolAction.error(content: body)
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}

fn write_guard_error(path_text: String, config: AgentConfig) -> Option<String> {
    if path_in_workspace(config.workspace_root, path_text) == false {
        let reason = [
            "writes are confined to `",
            String.copy(value: config.workspace_root),
            "` and must be safe relative paths",
        ].join("")
        return Some(reason)
    }
    return None
}

fn execute_write(arguments: String, config: AgentConfig) -> fresh ToolAction {
    match write_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = write_args(arguments)
    let path_text = string_or(decoded.path, "")
    let content = string_or(decoded.content, "")
    if path_text == "" {
        return ToolAction.error(content: "error: write requires arguments.path")
    }
    if content.len() > config.max_write_bytes {
        let body = {
            "ok": false,
            "path": path_text,
            "error": "content exceeds max_write_bytes",
            "bytes": content.len(),
            "max_write_bytes": config.max_write_bytes,
        }
        return ToolAction.error(content: Json.encode(value: body))
    }
    match write_guard_error(path_text, config) {
        Some(reason) => {
            return tool_path_error(path_text, reason)
        }
        None => {
        }
    }
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            let mut old_content = ""
            let mut existed = false
            match path.read_string() {
                Ok(existing) => {
                    old_content = existing
                    existed = true
                }
                Err => {
                }
            }
            match create_parent_dirs(path) {
                Ok => {
                }
                Err(error) => {
                    return ToolAction.error(content: ["error creating parent directory for ", path_text, ": ", error.message()].join(""))
                }
            }
            match File.write_atomic(path, text: content) {
                Ok => {
                    let diff = Diff.unified(old: old_content, new: content)
                    let body = {
                        "ok": true,
                        "path": path_text,
                        "existed": existed,
                        "changed": old_content != content,
                        "old_bytes": old_content.len(),
                        "new_bytes": content.len(),
                        "diff": diff,
                    }
                    return ToolAction.respond(content: Json.encode(value: body))
                }
                Err(error) => {
                    let body = {"ok": false, "path": path_text, "error": error.message()}
                    return ToolAction.error(content: Json.encode(value: body))
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}

fn create_parent_dirs(path: Path) -> Result<Unit, FileError> {
    match path.parent() {
        Some(parent) => {
            return Directory.create_dir_all(path: parent)
        }
        None => {
            return Ok(Unit)
        }
    }
}

fn first_match_line(content: String, needle: String) -> Int {
    let before_parts = content.split(needle)
    if before_parts.len() <= 1 {
        return 0
    }
    let prefix_text = before_parts.get(0)
    return String.lines(value: prefix_text).len()
}

fn edit_preview_json(
    old_content: String,
    new_content: String,
    old_string: String,
    new_string: String,
    replace_all: Bool,
    occurrences: Int,
) -> fresh JsonValue {
    let diff = Diff.unified(old: old_content, new: new_content)
    let mut old_start = first_match_line(old_content, old_string)
    let mut old_end = old_start + old_string.lines().len() - 1
    let mut new_start = old_start
    let mut new_end = new_start + new_string.lines().len() - 1
    if replace_all {
        old_start = 1
        old_end = old_content.lines().len()
        new_start = 1
        new_end = new_content.lines().len()
    }
    return {
        "old_start_line": old_start,
        "old_end_line": old_end,
        "new_start_line": new_start,
        "new_end_line": new_end,
        "occurrences": occurrences,
        "diff": diff,
    }
}

fn execute_edit(arguments: String, config: AgentConfig) -> fresh ToolAction {
    match edit_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = edit_args(arguments)
    let path_text = string_or(decoded.path, "")
    let old_string = string_or(decoded.old_string, "")
    let new_string = string_or(decoded.new_string, "")
    let replace_all = bool_or(decoded.replace_all, false)
    if path_text == "" {
        return ToolAction.error(content: "error: edit requires arguments.path")
    }
    if old_string == "" {
        return ToolAction.error(content: "error: edit requires non-empty arguments.old_string")
    }
    if old_string == new_string {
        return ToolAction.error(content: "error: edit old_string and new_string are identical")
    }
    match write_guard_error(path_text, config) {
        Some(reason) => {
            return tool_path_error(path_text, reason)
        }
        None => {
        }
    }
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            match path.read_string() {
                Ok(content) => {
                    let parts = content.split(old_string)
                    let occurrences = parts.len() - 1
                    if occurrences == 0 {
                        let body = {
                            "ok": false,
                            "path": path_text,
                            "error": "edit old_string not found",
                            "old_string_len": old_string.len(),
                        }
                        return ToolAction.error(content: Json.encode(value: body))
                    }
                    if occurrences > 1 && !replace_all  {
                        let body = {
                            "ok": false,
                            "path": path_text,
                            "error": "edit old_string matched more than once; set replace_all=true",
                            "occurrences": occurrences,
                        }
                        return ToolAction.error(content: Json.encode(value: body))
                    }
                    let mut replacement_count = 1
                    let mut new_content = content.replace(old_string, new_string)
                    if replace_all {
                        replacement_count = occurrences
                        new_content = parts.join(new_string)
                    }
                    if new_content.len() > config.max_write_bytes {
                        let body = {
                            "ok": false,
                            "path": path_text,
                            "error": "edited content exceeds max_write_bytes",
                            "bytes": new_content.len(),
                            "max_write_bytes": config.max_write_bytes,
                        }
                        return ToolAction.error(content: Json.encode(value: body))
                    }
                    match File.write_atomic(path, text: new_content) {
                        Ok => {
                            let preview = edit_preview_json(content, new_content, old_string, new_string, replace_all, replacement_count)
                            let body = {
                                "ok": true,
                                "path": path_text,
                                "replacements": replacement_count,
                                "new_bytes": new_content.len(),
                                "preview": preview,
                            }
                            return ToolAction.respond(content: Json.encode(value: body))
                        }
                        Err(error) => {
                            return ToolAction.error(content: ["error editing ", path_text, ": ", error.message()].join(""))
                        }
                    }
                }
                Err(error) => {
                    return ToolAction.error(content: ["error reading ", path_text, ": ", error.message()].join(""))
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}

fn execute_apply_patch(arguments: String, config: AgentConfig) -> fresh ToolAction {
    match apply_patch_args_error(arguments) {
        Some(error) => {
            return tool_arg_error(error)
        }
        None => {
        }
    }
    let decoded = apply_patch_args(arguments)
    let path_text = string_or(decoded.path, "")
    let patch = string_or(decoded.patch, "")
    if path_text == "" {
        return ToolAction.error(content: "error: apply_patch requires arguments.path")
    }
    if patch == "" {
        return ToolAction.error(content: "error: apply_patch requires non-empty arguments.patch")
    }
    match write_guard_error(path_text, config) {
        Some(reason) => {
            return tool_path_error(path_text, reason)
        }
        None => {
        }
    }
    match resolve_repo_path(config.repo_root, path_text) {
        Ok(path) => {
            match path.read_string() {
                Ok(content) => {
                    match Patch.apply_text(original: content, patch) {
                        Ok(next) => {
                            if next.len() > config.max_write_bytes {
                                let body = {
                                    "ok": false,
                                    "path": path_text,
                                    "error": "patched content exceeds max_write_bytes",
                                    "bytes": next.len(),
                                    "max_write_bytes": config.max_write_bytes,
                                }
                                return ToolAction.error(content: Json.encode(value: body))
                            }
                            match File.write_atomic(path, text: next) {
                                Ok => {
                                    let diff = Diff.unified(old: content, new: next)
                                    let body = {
                                        "ok": true,
                                        "path": path_text,
                                        "old_bytes": content.len(),
                                        "new_bytes": next.len(),
                                        "diff": diff,
                                    }
                                    return ToolAction.respond(content: Json.encode(value: body))
                                }
                                Err(error) => {
                                    return ToolAction.error(content: ["error writing patched file ", path_text, ": ", error.message()].join(""))
                                }
                            }
                        }
                        Err(error) => {
                            let body = {"ok": false, "path": path_text, "error": error}
                            return ToolAction.error(content: Json.encode(value: body))
                        }
                    }
                }
                Err(error) => {
                    return ToolAction.error(content: ["error reading ", path_text, ": ", error.message()].join(""))
                }
            }
        }
        Err(error) => {
            return tool_path_error(path_text, error)
        }
    }
}
