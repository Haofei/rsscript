fn rss_read_file_check_result(path_text: read String, actual_path: read Path) -> fresh JsonValue {
    match actual_path.read_string() {
        Ok(text) => {
            let has_path = text.contains("Path.from_string") || text.contains(".to_path()")
            let has_read = text.contains("File.read_string")
            let has_result = text.contains("Result<String, FileError>")
            let ok: Bool = has_path && has_read && has_result
            return {
                "ok": ok,
                "path": path_text,
                "has_path_from_string": has_path,
                "has_file_read_string": has_read,
                "has_result_type": has_result,
                "bytes": text.len(),
            }
        }
        Err(error) => {
            return {"ok": false, "path": path_text, "error": error.message()}
        }
    }
}
