fn rss_cmd_tool_spec() -> fresh JsonValue {
    return function_tool(
        "rss_cmd",
        "Run selected RSScript tool commands from the repository root with structured command arguments.",
        {
            "type": "object",
            "properties": {
                "command": {"type": "string", "enum": ["check", "lint", "fmt", "test", "pkg"]},
                "path": {"type": "string"},
                "args": {"type": "array", "items": {"type": "string"}},
                "timeout_ms": {"type": "integer"},
                "max_output_chars": {"type": "integer"},
            },
            "required": ["command"],
            "additionalProperties": false,
        },
    )
