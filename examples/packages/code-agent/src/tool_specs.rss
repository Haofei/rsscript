fn tool_specs() -> fresh JsonValue {
    let specs: List<JsonValue> = [
        read_tool_spec(),
        write_tool_spec(),
        edit_tool_spec(),
        apply_patch_tool_spec(),
        shell_tool_spec(),
        rss_check_tool_spec(),
        rss_cmd_tool_spec(),
        rss_ide_tool_spec(),
        finish_tool_spec(),
    ]
    return specs.to_json_values()
}

fn function_tool(name: read String, description: read String, parameters: read JsonValue) -> fresh JsonValue {
    return {
        "type": "function",
        "function": {
            "name": name,
            "description": description,
            "parameters": parameters,
        },
    }
}

fn read_tool_spec() -> fresh JsonValue {
    return function_tool(
        "read",
        "Read a UTF-8 text file. Supports optional start_line, max_lines, and max_output_chars.",
        {
            "type": "object",
            "properties": {
                "path": {"type": "string"},
                "start_line": {"type": "integer"},
                "max_lines": {"type": "integer"},
                "max_output_chars": {"type": "integer"},
            },
            "required": ["path"],
            "additionalProperties": false,
        },
    )
}

fn write_tool_spec() -> fresh JsonValue {
    return function_tool(
        "write",
