fn rss_ide_tool_spec() -> fresh JsonValue {
    return function_tool(
        "rss_ide",
        "Read-only RSScript semantic IDE helper. Supports diagnostics, symbols, outline, hover, definition, and references.",
        {
            "type": "object",
            "properties": {
                "action": {
                    "type": "string",
                    "enum": ["diagnostics", "symbols", "outline", "hover", "definition", "references"],
                },
                "path": {"type": "string"},
                "query": {"type": "string"},
                "line": {"type": "integer"},
                "column": {"type": "integer"},
                "max_results": {"type": "integer"},
                "include_declaration": {"type": "boolean"},
            },
            "required": ["action", "path"],
            "additionalProperties": false,
        },
    )
}

fn finish_tool_spec() -> fresh JsonValue {
    return function_tool(
        "finish",
        "Finish the agent loop with a final answer.",
        {
            "type": "object",
            "properties": {"answer": {"type": "string"}},
            "required": ["answer"],
            "additionalProperties": false,
        },
    )
}
