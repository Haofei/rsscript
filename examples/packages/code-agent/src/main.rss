features: async

async fn main() -> Result<Unit, String> {
    let config = agent_config_from_env()
    let task = agent_task_from_env()
    let logger = StructuredLogger.named(name: "rss-code-agent")
    let prompt = Prompt.code_agent(model: config.model)
    let mut usage_total = TokenUsage.zero()
    let mut state = AgentState.new(task, prompt)
    StructuredLogger.event(logger: logger, event: "agent.started", message: config.model.model)
    while state.can_continue(config.max_steps) {
        let request_body = build_model_request(config, state).to_string()
        let http_result = await Http.post_json_bearer_retry_async(
            url: config.model.endpoint,
            body: request_body,
            token: config.model.api_key,
            timeout_ms: config.model.timeout_ms,
            attempts: config.model.max_attempts,
            backoff_ms: config.model.backoff_ms,
        )
        match http_result {
            Ok(http) => {
                let response = http.text()
                if http.is_success() == false {
                    let turn_span = TraceSpan.start(name: "agent.turn")
                    let status = http.status().to_string()
                    let status_message = ["agent HTTP status ", status].join("")
                    StructuredLogger.error(logger: logger, event: "turn.failed", message: status_message)
                    StructuredLogger.event(logger: logger, event: "agent.response", message: response)
                    TraceSpan.finish(span: turn_span, logger: logger, status: "http_error")
                    state.finished = true
                    state.failed = true
                    state.failure_reason = status_message.copy()
                } else {
                    let turn_span = TraceSpan.start(name: "agent.turn")
                    StructuredLogger.event(logger: logger, event: "agent.response", message: response)
                    let usage = ChatResponse.usage(response: response)
                    usage_total = TokenUsage.add(left: usage_total, right: usage)
                    StructuredLogger.json(logger: logger, event: "usage.turn", value: TokenUsage.to_json(usage: usage))
                    StructuredLogger.json(logger: logger, event: "usage.total", value: TokenUsage.to_json(usage: usage_total))
                    let tool_result = execute_tool_calls(response, state.messages, config, logger)
                    if tool_result.failed {
                        StructuredLogger.error(logger: logger, event: "turn.failed", message: tool_result.failure_reason)
                        TraceSpan.finish(span: turn_span, logger: logger, status: "tool_abort")
                        state.finished = true
                        state.failed = true
                        state.failure_reason = tool_result.failure_reason.copy()
                    } else if tool_result.finished {
                        StructuredLogger.event(logger: logger, event: "turn.completed", message: tool_result.final_answer)
                        Log.write(message: tool_result.final_answer)
                        TraceSpan.finish(span: turn_span, logger: logger, status: "finished")
                        state.finished = true
                    } else if tool_result.called_tool == false {
                        let content = ChatResponse.content(response: response)
                        StructuredLogger.event(logger: logger, event: "turn.completed", message: content)
                        Log.write(message: content)
                        TraceSpan.finish(span: turn_span, logger: logger, status: "no_tool")
                        state.finished = true
                    } else {
                        state.messages = tool_result.messages
                        state.step = state.step + 1
                        TraceSpan.finish(span: turn_span, logger: logger, status: "tool_loop")
                        if state.step >= config.max_steps {
                            state.finished = true
                            state.failed = true
                            state.failure_reason = "stopped before completion: step budget exhausted"
                            StructuredLogger.event(
                                logger: logger,
                                event: "turn.budget_exhausted",
                                message: state.failure_reason,
                            )
                        } else if usage_total.total_tokens >= config.max_total_tokens {
                            state.finished = true
                            state.failed = true
                            state.failure_reason = "stopped before completion: token budget exhausted"
                            StructuredLogger.event(
                                logger: logger,
                                event: "turn.token_budget_exhausted",
                                message: state.failure_reason,
                            )
                        }
                    }
                }
            }
            Err(error) => {
                let reason = ["agent HTTP transport error: ", error.message()].join("")
                StructuredLogger.error(logger: logger, event: "turn.failed", message: reason)
                state.finished = true
                state.failed = true
                state.failure_reason = reason.copy()
            }
        }
    }
    if state.failed {
        return Err(state.failure_reason.copy())
    }
    return Ok(Unit)
}
