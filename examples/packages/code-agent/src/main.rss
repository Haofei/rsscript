features: async

async fn main() -> Result<Unit, HttpError> {
    let config = agent_config_from_env()
    let task = agent_task_from_env()
    let mut state = AgentState.new(task)
    Log.trace(event: read "turn.started", message: read "code agent turn")
    while state.can_continue(config.max_steps) {
        let request_body = build_model_request(config, state).to_string()
        let http = await Http.post_json_bearer_retry_async(
            url: read config.endpoint,
            body: read request_body,
            token: read config.api_key,
            timeout_ms: config.request_timeout_ms,
            attempts: config.max_attempts,
            backoff_ms: config.backoff_ms,
        )?
        let response = http.text()
        if http.is_success() == false {
            let status = http.status().to_string()
            let status_message = ["agent HTTP status ", status].join("")
            Log.error(message: read status_message)
            Log.trace(event: read "turn.failed", message: read response)
            state.finished = true
        } else {
            Log.trace(event: read "agent.response", message: read response)
            Log.write_json(value: read response_usage(response))
            let tool_result = execute_tool_calls(response, state.messages, config)
            if tool_result.finished {
                Log.trace(event: read "turn.completed", message: read tool_result.final_answer)
                Log.write(message: read tool_result.final_answer)
                state.finished = true
            } else if tool_result.called_tool == false {
                let content = response_content(response)
                Log.trace(event: read "turn.completed", message: read content)
                Log.write(message: read content)
                state.finished = true
            } else {
                state.messages = tool_result.messages
                state.step = state.step + 1
                if state.step >= config.max_steps {
                    Log.trace(
                        event: read "turn.budget_exhausted",
                        message: read "stopped before completion: step budget exhausted",
                    )
                }
            }
        }
    }
    return Ok(Unit)
}
