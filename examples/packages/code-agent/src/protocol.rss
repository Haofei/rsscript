fn code_agent_system_prompt() -> String {
    return """You are a RSScript code agent.

Work in a bounded tool loop:
1. Discover files before reading unfamiliar code.
2. Use rss_ide for diagnostics, symbols, outline, hover, definition, and references before guessing APIs.
3. Make small edits.
4. Run a structured RSScript check after edits.
5. Call finish with a concise answer when the task is done.

Do not guess RSScript function names or parameter names.
Do not use native/local/take in ordinary RSScript examples unless the task explicitly requires them.
Prefer the structured rss_check/rss_cmd tools over shell for RSScript commands.
Keep tool arguments explicit JSON objects."""
}

fn build_model_request(config: read AgentConfig, state: read AgentState) -> fresh JsonValue {
    let messages = model_messages(state.messages)
    let tools = tool_specs()
    return {"model": config.model, "messages": messages, "tools": tools, "stream": false}
}

fn model_messages(messages: read List<AgentMessage>) -> fresh JsonValue {
    let mut values = List<JsonValue>.new()
    for message in messages {
        mut values.push(message.value)
    }
    return values.to_json_values()
}

fn response_content(response: read String) -> String {
    match response.json_parse() {
        Ok(root) => {
            match root.at_optional_string("choices[0].message.content") {
                Ok(content) => {
                    return content.unwrap_or(response)
                }
                Err => {
                    return response.copy()
                }
            }
        }
        Err => {
            return response.copy()
        }
    }
}

fn response_usage(response: read String) -> fresh JsonValue {
    match response.json_parse() {
        Ok(root) => {
            return root.at_or("usage", {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0})
        }
        Err => {
            return {"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0}
        }
    }
}

fn assistant_message_value(root: read JsonValue, fallback: read String) -> fresh JsonValue {
    return root.at_or("choices[0].message", assistant_fallback_message(fallback))
}

fn assistant_fallback_message(content: read String) -> fresh JsonValue {
    return {"role": "assistant", "content": content}
}

fn tool_call_at(message: read JsonValue, index: Int) -> Result<fresh JsonValue, JsonError> {
    let calls = message.field("tool_calls")?
    return calls.array_get(index)
}

fn tool_call_count(message: read JsonValue) -> Int {
    match message.field("tool_calls") {
        Ok(calls) => {
            return calls.array_len().unwrap_or(0)
        }
        Err => {
            return 0
        }
    }
}

fn tool_request_from_call(call: read JsonValue) -> Result<fresh ToolRequest, JsonError> {
    let id = call.field_string("id")?
    let name = call.at_string("function.name")?
    let arguments = call.at_string("function.arguments")?
    return Ok(ToolRequest.new(id, name, arguments))
}

fn tool_request_at(message: read JsonValue, index: Int) -> Option<ToolRequest> {
    match tool_call_at(message, index) {
        Ok(call) => {
            return tool_request_from_call(call).ok()
        }
        Err => {
            return None
        }
    }
}

fn tool_requests_from_message(message: read JsonValue) -> List<ToolRequest> {
    let mut requests = List<ToolRequest>.new()
    let limit = tool_call_count(message)
    let mut index = 0
    while index < limit {
        if let Some(request) = tool_request_at(message, index) {
            mut requests.push(request)
        }
        index = index + 1
    }
    return requests
}
