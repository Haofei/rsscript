fn decode_args_error(tool: String, error: JsonError) -> fresh ToolAction {
    let body = ["error: ", tool, " arguments must be a JSON object: ", error.message()].join("")
    return ToolAction.error(content: body)
}

fn string_or(value: Option<String>, fallback: String) -> String {
    return Option.unwrap_or(value, default: fallback)
}

fn int_or(value: Option<Int>, fallback: Int) -> Int {
    return Option.unwrap_or(value, default: fallback)
}

fn bool_or(value: Option<Bool>, fallback: Bool) -> Bool {
    return Option.unwrap_or(value, default: fallback)
}

fn read_args_error(arguments: String) -> Option<String> {
    match Json.decode_text<ReadArgs>(text: arguments) {
        Ok => {
            return None
        }
        Err(error) => {
            return Some(["read arguments must be a JSON object: ", error.message()].join(""))
        }
    }
}

fn read_args(arguments: String) -> ReadArgs {
    let fallback = ReadArgs(path: None, start_line: None, max_lines: None, max_output_chars: None)
    return Result.unwrap_or(value: Json.decode_text<ReadArgs>(text: arguments), default: fallback)
}

