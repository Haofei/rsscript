fn path_in_workspace(workspace_root: String, path_text: String) -> Bool {
    let safe = path_text.safe_relative().is_ok()
    let under_root = path_text.starts_with(workspace_root)
    return safe && under_root
}

fn resolve_repo_path(repo_root: Path, path_text: String) -> Result<fresh Path, String> {
    return Workspace.resolve(root: repo_root, relative: path_text)
}

fn tool_path_error(path_text: String, reason: String) -> fresh ToolAction {
    let body = {"ok": false, "path": path_text, "error": reason}
    return ToolAction.error(content: Json.encode(value: body))
}

fn tool_arg_error(reason: String) -> fresh ToolAction {
    let body = {"ok": false, "error": reason}
    return ToolAction.error(content: Json.encode(value: body))
}

fn bounded_limit(value: Int, fallback: Int, max: Int) -> Int {
    if value < 1 {
        return fallback
    }
    if value > max {
        return max
    }
    return value
}

fn cap_text(content: String, max_chars: Int) -> fresh String {
    if content.len() <= max_chars {
        return content.copy()
    }
    return content.slice(0, max_chars)
}

fn truncation_header(content: String, max_chars: Int) -> String {
    if content.len() <= max_chars {
        return ""
    }
    let parts: List<String> = [
        "truncated=true\noutput_chars=",
        content.len().to_string(),
        "\nshown_chars=",
        max_chars.to_string(),
        "\n---\n",
    ]
    return parts.join("")
}

fn output_with_cap(content: String, max_chars: Int) -> fresh ToolOutput {
    let capped = cap_text(content, max_chars)
    let prefix = truncation_header(content, max_chars)
    let text = [prefix, capped].join("")
    if content.len() > max_chars {
        return ToolOutput.error(content: text)
    }
    return ToolOutput.respond(content: text)
}
