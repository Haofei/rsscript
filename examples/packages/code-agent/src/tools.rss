fn ToolRuntime.execute(
    runtime: read ToolRuntime,
    request: read ToolRequest,
    config: read AgentConfig,
) -> fresh ToolAction {
    match runtime {
        CoreToolRuntime => {
            return execute_core_tool(request, config)
        }
    }
}

fn execute_core_tool(request: read ToolRequest, config: read AgentConfig) -> fresh ToolAction {
    match request.name {
        "read" => {
            return execute_read(request.arguments, config)
        }
        "write" => {
            return execute_write(request.arguments, config)
        }
        "edit" => {
            return execute_edit(request.arguments, config)
        }
        "apply_patch" => {
            return execute_apply_patch(request.arguments, config)
        }
        "shell" => {
            return execute_shell(request.arguments, config)
        }
        "rss_check" => {
            return execute_rss_check(request.arguments, config)
        }
        "rss_cmd" => {
            return execute_rss_cmd(request.arguments, config)
        }
        "rss_ide" => {
            return execute_rss_ide(request.arguments, config)
        }
        "finish" => {
            return execute_finish(request.arguments)
        }
        _ => {
            return ToolAction.error(content: read ["error: unknown tool ", String.copy(value: read request.name)].join(""))
        }
    }
}

fn push_tool_response(messages: mut List<ChatMessage>, request: read ToolRequest, output: read ToolOutput) -> Unit {
    let envelope = {
        "tool": request.name,
        "is_error": output.is_error,
        "content": output.content,
    }
    let tool_output = ToolOutput.respond(content: read Json.encode(value: read envelope))
    mut messages.push(ChatMessage.tool(request: read request, output: read tool_output))
}

fn execute_tool_calls(
    response: read String,
    messages: read List<ChatMessage>,
    config: read AgentConfig,
    logger: read StructuredLogger,
) -> fresh ToolLoopResult {
    let runtime = CoreToolRuntime
    let mut called_tool = false
    let mut finished = false
    let mut final_answer = ""
    let mut next_messages = List<ChatMessage>.new()
    mut next_messages.append(messages)
    let assistant_message = ChatResponse.assistant_message(response: read response)
    mut next_messages.push(assistant_message)
    let requests = ChatResponse.tool_requests(message: read assistant_message).take(config.max_tool_calls)
    for request in requests {
        if finished == false {
            StructuredLogger.event(logger: read logger, event: read "tool.requested", message: read request.name)
            let action = runtime.execute(request, config)
            called_tool = true
            match action.response {
                Some(output) => {
                    Log.write(message: read output.content)
                    push_tool_response(mut next_messages, request, output)
                }
                None => {
                    final_answer = action.final_answer
                    finished = true
                }
            }
        }
    }
    return ToolLoopResult(
        called_tool: called_tool,
        messages: next_messages,
        finished: finished,
        final_answer: final_answer,
    )
}
