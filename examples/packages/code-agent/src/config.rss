struct AgentConfig {
    model: String
    endpoint: Url
    api_key: String
    max_steps: Int
    max_tool_calls: Int
    request_timeout_ms: Int
    max_attempts: Int
    backoff_ms: Int
    repo_root: Path
    workspace_root: String
}

fn env_int(name: read String, default: Int) -> Int {
    let raw = name.env_or("")
    return raw.parse_int().unwrap_or(default)
}

fn env_min_int(name: read String, default: Int, min: Int) -> Int {
    let value = env_int(name, default)
    if value < min {
        return default
    }
    return value
}

fn ensure_trailing_slash(value: read String) -> String {
    if value.ends_with("/") {
        return value
    }
    return [value, "/"].join("")
}

fn workspace_root_from_env() -> String {
    let raw = "AGENT_WORKSPACE_ROOT".env_or("target/")
    if raw == "" {
        return "target/"
    }
    if raw.safe_relative().is_err() {
        return "target/"
    }
    return ensure_trailing_slash(raw)
}

fn repo_root_from_env() -> fresh Path {
    let explicit = "AGENT_REPO_ROOT".env_or("")
    if explicit != "" {
        return explicit.to_path()
    }
    return Env.run_workspace_root()
}

fn agent_config_from_env() -> fresh AgentConfig {
    return AgentConfig(
        model: "AGENT_MODEL".env_or("gpt-5.5:medium"),
        endpoint: "AGENT_ENDPOINT".env_or("http://localhost:8080/v1/chat/completions").to_url(),
        api_key: "AGENT_API_KEY".env_or("test_key"),
        max_steps: env_min_int("AGENT_MAX_STEPS", 8, 1),
        max_tool_calls: env_min_int("AGENT_MAX_TOOL_CALLS", 8, 1),
        request_timeout_ms: env_min_int("AGENT_TIMEOUT_MS", 60000, 1),
        max_attempts: env_min_int("AGENT_MAX_ATTEMPTS", 3, 1),
        backoff_ms: env_min_int("AGENT_BACKOFF_MS", 500, 0),
        repo_root: repo_root_from_env(),
        workspace_root: workspace_root_from_env(),
    )
}

fn default_agent_task() -> String {
    return """Read examples/packages/code-agent/AGENTS.md and schemas/core-package-index.json.
Use rss_ide to find the file IO API, then read the relevant core interface.
Write target/rsscript-agent-read-file.rss containing a concise RSScript function that reads a UTF-8 file with File.read_string.
After writing, call rss_check for examples/packages/code-agent.
If the check passes, call finish with a short summary."""
}

fn agent_task_from_env() -> fresh String {
    return "AGENT_PROMPT".env_or(default_agent_task())
}
