struct AgentState {
    messages: List<ChatMessage>
    step: Int
    finished: Bool
    failed: Bool
    failure_reason: String
}

struct ToolLoopResult {
    called_tool: Bool
    messages: List<ChatMessage>
    finished: Bool
    failed: Bool
    final_answer: String
    failure_reason: String
}

fn AgentState.new(task: String, prompt: Prompt) -> fresh AgentState {
    return AgentState(
        messages: [ChatMessage.system(prompt.render()), ChatMessage.user(task)],
        step: 0,
        finished: false,
        failed: false,
        failure_reason: "",
    )
}

fn AgentState.can_continue(state: AgentState, max_steps: Int) -> Bool {
    return state.finished == false && state.failed == false && state.step < max_steps
}
