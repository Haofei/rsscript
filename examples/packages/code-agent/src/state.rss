struct AgentState {
    messages: List<ChatMessage>
    step: Int
    finished: Bool
}

struct ToolLoopResult {
    called_tool: Bool
    messages: List<ChatMessage>
    finished: Bool
    final_answer: String
}

fn AgentState.new(task: read String, prompt: read Prompt) -> fresh AgentState {
    return AgentState(
        messages: [ChatMessage.system(prompt.render()), ChatMessage.user(task)],
        step: 0,
        finished: false,
    )
}

fn AgentState.can_continue(state: read AgentState, max_steps: Int) -> Bool {
    return state.finished == false && state.step < max_steps
}
