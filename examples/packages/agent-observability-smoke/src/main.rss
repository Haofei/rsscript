fn agent_observability_smoke(response: String) -> Result<fresh JsonValue, JsonError> {
    let env = ModelEnv(
        model: "TEST_AGENT_MODEL",
        endpoint: "TEST_AGENT_ENDPOINT",
        api_key: "TEST_AGENT_API_KEY",
        timeout_ms: "TEST_AGENT_TIMEOUT_MS",
        max_attempts: "TEST_AGENT_MAX_ATTEMPTS",
        backoff_ms: "TEST_AGENT_BACKOFF_MS",
    )
    let defaults = ModelDefaults(
        model: "test-model",
        endpoint: "http://localhost:8080/v1/chat/completions",
        api_key: "test_key",
        timeout_ms: 1000,
        max_attempts: 1,
        backoff_ms: 0,
    )
    let model = ModelConfig.from_env(env: env, defaults: defaults)
    let prompt = Prompt.code_agent(model: model)
    let rendered = Prompt.render(prompt: prompt)
    let usage = TokenUsage.from_response_text(text: response)
    let doubled = TokenUsage.add(left: usage, right: usage)
    let logger = StructuredLogger.named(name: "test-agent")
    StructuredLogger.event(logger: logger, event: "prompt.rendered", message: rendered)
    StructuredLogger.json(logger: logger, event: "usage", value: TokenUsage.to_json(usage: doubled))
    let span = TraceSpan.start(name: "test.span")
    TraceSpan.finish(span: span, logger: logger, status: "ok")
    return Ok(TokenUsage.to_json(usage: doubled))
}

fn main() -> Result<Unit, JsonError> {
    let response = """{"usage":{"prompt_tokens":2,"completion_tokens":3,"total_tokens":5}}"""
    let usage = agent_observability_smoke(response)?
    let total = usage.field_int("total_tokens")?
    Assert.equal_int(left: total, right: 10)
    return Ok(Unit)
}
