features: local

fn read_csv(path: read Path) -> Result<Unit, CsvError> {
    local buffer = RowBuffer.new(size: 4096)
    with File.open_read(path: read path) as file {
        Csv.read_into(file: mut file, buffer: mut buffer)?
        let row = Csv.parse_row(buffer: read buffer)?
        let name = Row.field_string(row: read row, index: 0)?
        Assert.equal(left: read name, right: read "RSScript")
        Log.write(message: read name)
    }

    return Ok(Unit)
}

fn main() -> Result<Unit, FileError> {
    let path = Path.from_string(value: read "rsscript-csv-example.csv")
    let data = Bytes.from_string(value: read "name,amount\nRSScript,42\n")

    with File.open_write(path: read path) as file {
        File.write(file: mut file, data: read data)?
    }

    match read_csv(path: read path) {
        Ok(unit) => {
            return Ok(Unit)
        }
        Err(error) => {
            Log.write(message: read "csv read failed")
            return Ok(Unit)
        }
    }
}
