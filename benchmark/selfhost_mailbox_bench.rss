features: native, local

// A fixed-capacity mailbox (message queue) implemented in RSS itself, on top of
// parallel lists. Each message carries a source id and a monotonic sequence
// number; `take` returns the OLDEST pending message (lowest seq), optionally
// filtered by source.
//
// NOTE (language finding): RSS does not allow reassigning a *scalar* struct field
// through a `mut` parameter (`m.count = ...` is rejected). `List` fields are
// reference types, so `List.set(list: mut m.field, ...)` mutates in place and
// propagates. So mutable scalar state (`next_seq`) is held in a 1-element list,
// and `count` is computed by scanning. See docs/rss-selfhost-ledger.md SH-007.
struct Mailbox<T> {
    capacity: Int
    next_seq: List<Int>
    msg: List<T>
    valid: List<Bool>
    src: List<Int>
    seq: List<Int>
}

fn mailbox_new<T>(capacity: Int) -> fresh Mailbox<T> {
    let mut next_seq = List<Int>.new()
    List.push<Int>(list: mut next_seq, value: read 0)
    return Mailbox(
        capacity: capacity,
        next_seq: next_seq,
        msg: List<T>.new(),
        valid: List<Bool>.new(),
        src: List<Int>.new(),
        seq: List<Int>.new(),
    )
}

fn mailbox_count<T>(m: read Mailbox<T>) -> Int {
    let mut count = 0
    let mut i = 0
    let len = List.len<Bool>(list: read m.valid)
    while i < len {
        if List.get<Bool>(list: read m.valid, index: i) {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

// Store a message; returns false if the mailbox is full.
fn mailbox_send<T>(m: mut Mailbox<T>, value: read T, source: Int) -> Bool {
    if mailbox_count<T>(m: read m) >= m.capacity {
        return false
    }
    let seq = List.get<Int>(list: read m.next_seq, index: 0)
    let next = seq + 1
    List.set<Int>(list: mut m.next_seq, index: 0, value: read next)

    let mut i = 0
    let len = List.len<Bool>(list: read m.valid)
    while i < len {
        if List.get<Bool>(list: read m.valid, index: i) == false {
            List.set<T>(list: mut m.msg, index: i, value: read value)
            List.set<Bool>(list: mut m.valid, index: i, value: read true)
            List.set<Int>(list: mut m.src, index: i, value: read source)
            List.set<Int>(list: mut m.seq, index: i, value: read seq)
            return true
        }
        i = i + 1
    }

    List.push<T>(list: mut m.msg, value: read value)
    List.push<Bool>(list: mut m.valid, value: read true)
    List.push<Int>(list: mut m.src, value: read source)
    List.push<Int>(list: mut m.seq, value: read seq)
    return true
}

// Slot index of the oldest valid message (optionally only from `source`), or -1.
fn oldest_slot<T>(m: read Mailbox<T>, filtered: Bool, source: Int) -> Int {
    let mut best = -1
    let mut best_seq = 0
    let mut i = 0
    let len = List.len<Bool>(list: read m.valid)
    while i < len {
        if List.get<Bool>(list: read m.valid, index: i) {
            let mut matches = true
            if filtered {
                if List.get<Int>(list: read m.src, index: i) != source {
                    matches = false
                }
            }
            if matches {
                let s = List.get<Int>(list: read m.seq, index: i)
                if best < 0 {
                    best = i
                    best_seq = s
                } else {
                    if s < best_seq {
                        best = i
                        best_seq = s
                    }
                }
            }
        }
        i = i + 1
    }
    return best
}

fn take_at<T>(m: mut Mailbox<T>, slot: Int) -> T {
    let value = List.get<T>(list: read m.msg, index: slot)
    List.set<Bool>(list: mut m.valid, index: slot, value: read false)
    return value
}

fn mailbox_take<T>(m: mut Mailbox<T>) -> Option<T> {
    let slot = oldest_slot<T>(m: read m, filtered: false, source: 0)
    if slot < 0 {
        return None
    }
    return Some(take_at<T>(m: mut m, slot: slot))
}

fn mailbox_take_from<T>(m: mut Mailbox<T>, source: Int) -> Option<T> {
    let slot = oldest_slot<T>(m: read m, filtered: true, source: source)
    if slot < 0 {
        return None
    }
    return Some(take_at<T>(m: mut m, slot: slot))
}

// Cycle count comes from runtime args so neither AOT/LLVM nor the JIT can fold
// the workload to a constant.
fn input_size(default: Int) -> Int {
    let fallback = String.from_int(value: default)
    let raw = Args.get_or_default(index: 0, default: read fallback)
    match String.parse_int(value: read raw) {
        Some(n) => {
            return n
        }
        None => {
            return default
        }
    }
}

// Heavy driver on the self-hosted Mailbox<T>. The pattern is deliberately *not*
// send(i);take(): sources vary (i % 4), takes alternate between oldest, source-
// filtered, and leaving items pending, and the mailbox runs near capacity — so
// the work is data-dependent and can't be optimized away. Measures the collection
// across VM / JIT / native / AOT.
fn main() -> Unit {
    let cycles = input_size(default: 60000)
    let mut box = mailbox_new<Int>(capacity: 16)

    // Prefill so sends and takes interleave against a non-empty buffer.
    let mut p = 0
    while p < 8 {
        let psrc = p % 4
        let _pre = mailbox_send<Int>(m: mut box, value: read p, source: psrc)
        p = p + 1
    }

    let mut i = 0
    let mut sink = 0
    while i < cycles {
        let source = i % 4
        let _sent = mailbox_send<Int>(m: mut box, value: read i, source: source)
        let which = i % 3
        if which == 0 {
            // Source-filtered take (scans).
            match mailbox_take_from<Int>(m: mut box, source: 1) {
                Some(v) => { sink = sink + v }
                None => { sink = sink + 1 }
            }
        } else {
            if which == 1 {
                // Oldest take.
                match mailbox_take<Int>(m: mut box) {
                    Some(v) => { sink = sink + v }
                    None => { sink = sink + 2 }
                }
            } else {
                // Leave the item pending (no take) — exercises the full buffer.
                sink = sink + 3
            }
        }
        i = i + 1
    }

    // Drain whatever remains so the result depends on the pending items too.
    let mut drained = mailbox_take<Int>(m: mut box)
    while is_some_int(value: read drained) {
        match drained {
            Some(v) => { sink = sink + v }
            None => { sink = sink + 0 }
        }
        drained = mailbox_take<Int>(m: mut box)
    }

    Log.write(message: read String.from_int(value: sink))
    return Unit
}

fn is_some_int(value: read Option<Int>) -> Bool {
    match value {
        Some(_v) => {
            return true
        }
        None => {
            return false
        }
    }
}
