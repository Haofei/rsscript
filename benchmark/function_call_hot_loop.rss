features: local

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn mix(value: Int, salt: Int) -> Int {
    let doubled = value * 2
    return doubled + salt
}

fn main() -> Unit {
    let limit = bench_size(default: 1200000)
    let mut index = 0
    let mut salt_index = 0
    let mut total = 0
    local salts = List<Int>.new()
    List.push<Int>(list: mut salts, value: read 1)
    List.push<Int>(list: mut salts, value: read 3)
    List.push<Int>(list: mut salts, value: read 5)
    List.push<Int>(list: mut salts, value: read 7)
    List.push<Int>(list: mut salts, value: read 11)
    List.push<Int>(list: mut salts, value: read 13)
    List.push<Int>(list: mut salts, value: read 17)
    List.push<Int>(list: mut salts, value: read 19)

    while index < limit {
        let salt = List.get<Int>(list: read salts, index: salt_index)
        total = total + mix(value: index + total / 1000000000, salt: salt)
        index = index + 1
        salt_index = salt_index + 1
        if salt_index == List.len<Int>(list: read salts) {
            salt_index = 0
        }
    }

    Log.write(message: read String.from_int(value: total))
    return Unit
}
