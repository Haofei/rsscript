features: native, local

// Self-hosted RSS tool: inspect an `rsspkg.toml` package manifest and emit a JSON
// report. Used both as a real tool and as a cross-backend (VM/JIT/AOT) benchmark
// and hardening pressure-test (see docs/rss-selfhost-ledger.md).

fn edition_of(package: read JsonValue) -> Result<fresh String, JsonError> {
    // SH-002: the optional-field-or-default shape collapses to one line via the
    // existing `Option.unwrap_or` rather than a `match`.
    let edition = Json.field_optional_string(value: read package, name: read "edition")?
    return Ok(Option.unwrap_or<String>(value: read edition, default: read ""))
}

fn dependency_count(manifest: read JsonValue) -> Result<Int, JsonError> {
    match Json.field_optional(value: read manifest, name: read "dependencies")? {
        Some(deps) => {
            let keys = Json.object_keys(value: read deps)?
            return Ok(List.len<String>(list: read keys))
        }
        None => {
            return Ok(0)
        }
    }
}

// `[<table>] paths = [...]` as a list of strings, or empty when absent.
fn path_array(manifest: read JsonValue, table: read String) -> Result<fresh List<String>, JsonError> {
    match Json.field_optional(value: read manifest, name: read table)? {
        Some(section) => {
            match Json.field_optional(value: read section, name: read "paths")? {
                Some(array) => {
                    return Json.array_strings(value: read array)
                }
                None => {
                    return Ok(List<String>.new())
                }
            }
        }
        None => {
            return Ok(List<String>.new())
        }
    }
}

fn inspect(path: read Path) -> Result<fresh String, JsonError> {
    let manifest = Toml.parse_file(path: read path)?
    let package = Json.field(value: read manifest, name: read "package")?
    let name = Json.field_string(value: read package, name: read "name")?
    let version = Json.field_string(value: read package, name: read "version")?
    let edition = edition_of(package: read package)?
    let dep_count = dependency_count(manifest: read manifest)?
    let interfaces = path_array(manifest: read manifest, table: read "interfaces")?
    let sources = path_array(manifest: read manifest, table: read "sources")?

    let mut fields = List<String>.new()
    List.push<String>(list: mut fields, value: read Json.string_field(name: read "package", value: read name))
    List.push<String>(list: mut fields, value: read Json.string_field(name: read "version", value: read version))
    List.push<String>(list: mut fields, value: read Json.string_field(name: read "edition", value: read edition))
    List.push<String>(list: mut fields, value: read Json.int_field(name: read "dependency_count", value: dep_count))
    List.push<String>(list: mut fields, value: read Json.raw_field(name: read "interfaces", value: read Json.string_array(items: read interfaces)))
    List.push<String>(list: mut fields, value: read Json.raw_field(name: read "sources", value: read Json.string_array(items: read sources)))
    return Ok(Json.object(fields: read fields))
}

fn main() -> Result<Unit, String> {
    let path = Args.get_or_default(index: 0, default: read "rss/agent/rsspkg.toml")
    match inspect(path: read Path.from_string(value: read path)) {
        Ok(report) => {
            Log.write(message: read report)
            return Ok(Unit)
        }
        Err(error) => {
            return Err(JsonError.message(error: read error))
        }
    }
}
