features: async

async fn upload_report(
    bucket: read String,
    key: read String,
    body: read String,
) -> Result<Unit, String> {
    await S3.put_object(bucket: read bucket, key: read key, body: read body)?
    return Ok(Unit)
}

pub fn Reports.upload_batch(
    bucket: read String,
    day: read String,
) -> Result<Unit, String> {
    task_group {
        async let summary = upload_report(
            bucket: read bucket,
            key: read "reports/summary.json",
            body: read day,
        )
        async let audit = S3.put_object(
            bucket: read bucket,
            key: read "reports/audit.json",
            body: read day,
        )
        async let metrics = S3.put_object(
            bucket: read bucket,
            key: read "reports/metrics.json",
            body: read day,
        )
        async let inventory = S3.put_object(
            bucket: read bucket,
            key: read "reports/inventory.json",
            body: read day,
        )
        async let finance = S3.put_object(
            bucket: read bucket,
            key: read "reports/finance.json",
            body: read day,
        )
        async let security = S3.put_object(
            bucket: read bucket,
            key: read "reports/security.json",
            body: read day,
        )

        await summary?
        await audit?
        await metrics?
        await inventory?
        await finance?
        await security?
    }
    return Ok(Unit)
}
