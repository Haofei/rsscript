
fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

async fn step(value: Int) -> Result<Int, String> {
    return Ok(value + 1)
}

// Async call/await overhead gate: each iteration drives the async-call + resume
// machinery (frame/task state). Exercises the per-await cost the review flags as
// proportional to stack/register footprint on park/resume.
async fn main(args: read List<String>) -> Result<Unit, String> {
    let limit = bench_size(args: read args, default: 200000)
    let mut i = 0
    let mut total = 0
    while i < limit {
        total = await step(value: total)?
        i = i + 1
    }
    Output.write(message: String.from_int(value: total))
    return Ok(Unit)
}
