
// A fixed-capacity ring-buffer mailbox (message queue) implemented in RSS itself.
// `head`/`count` index a circular live window over `values`/`sources` (grown lazily
// up to `capacity`). Common send/take are O(1); only the source-filtered take scans
// (and compacts). Mutable scalar state lives in plain `Int` fields, mutated
// through `mut` parameters (see ledger SH-013) — no `List<Int>`-as-cell.
struct Mailbox<T> {
    capacity: Int
    head: Int
    count: Int
    values: List<T>
    sources: List<Int>
}

fn mailbox_new<T>(capacity: Int) -> fresh Mailbox<T> {
    return Mailbox(
        capacity: capacity,
        head: 0,
        count: 0,
        values: List<T>.new(),
        sources: List<Int>.new(),
    )
}

fn mailbox_count<T>(m: Mailbox<T>) -> Int {
    return m.count
}

// Store a message at the tail. O(1). Returns false if full.
fn mailbox_send<T>(m: mut Mailbox<T>, value: T, source: Int) -> Bool {
    if m.count >= m.capacity {
        return false
    }
    let raw = m.head + m.count
    let tail = raw % m.capacity
    // Slots fill 0..capacity-1 contiguously, so `tail` is either an existing slot
    // (reuse) or exactly the next one to allocate (grow). Avoids needing a generic
    // placeholder value to pre-size the lists.
    if tail < List.len<T>(list: m.values) {
        List.set<T>(list: mut m.values, index: tail, value)
        List.set<Int>(list: mut m.sources, index: tail, value: source)
    } else {
        List.push<T>(list: mut m.values, value)
        List.push<Int>(list: mut m.sources, value: source)
    }
    m.count = m.count + 1
    return true
}

// Take the oldest message (ring head). O(1).
fn mailbox_take<T>(m: mut Mailbox<T>) -> Option<T> {
    if m.count <= 0 {
        return None
    }
    let value = List.get<T>(list: m.values, index: m.head)
    let next = m.head + 1
    m.head = next % m.capacity
    m.count = m.count - 1
    return Some(value)
}

// Take the oldest message from `source`. Scans the live window; on a middle
// removal, shifts the older elements forward by one to close the gap (preserving
// FIFO order of the rest).
fn mailbox_take_from<T>(m: mut Mailbox<T>, source: Int) -> Option<T> {
    let mut offset = -1
    let mut k = 0
    while k < m.count {
        let raw = m.head + k
        let idx = raw % m.capacity
        if List.get<Int>(list: m.sources, index: idx) == source {
            offset = k
            k = m.count
        } else {
            k = k + 1
        }
    }
    if offset < 0 {
        return None
    }
    let take_raw = m.head + offset
    let take_idx = take_raw % m.capacity
    let value = List.get<T>(list: m.values, index: take_idx)
    let mut j = offset
    while j > 0 {
        let dst_raw = m.head + j
        let dst = dst_raw % m.capacity
        let src_raw = m.head + j - 1
        let src = src_raw % m.capacity
        let moved_value = List.get<T>(list: m.values, index: src)
        let moved_source = List.get<Int>(list: m.sources, index: src)
        List.set<T>(list: mut m.values, index: dst, value: moved_value)
        List.set<Int>(list: mut m.sources, index: dst, value: moved_source)
        j = j - 1
    }
    let next = m.head + 1
    m.head = next % m.capacity
    m.count = m.count - 1
    return Some(value)
}

fn input_size(default: Int) -> Int {
    let fallback = String.from_int(value: default)
    let raw = Arguments.get_or_default(args: read args, index: 0, default: fallback)
    match String.parse_int(value: raw) {
        Some(n) => { return n }
        None => { return default }
    }
}

fn is_some_int(value: Option<Int>) -> Bool {
    match value {
        Some(_v) => { return true }
        None => { return false }
    }
}

fn main(args: read List<String>) -> Unit {
    let cycles = input_size(default: 60000)
    let mut box = mailbox_new<Int>(capacity: 16)
    let mut p = 0
    while p < 8 {
        let psrc = p % 4
        let _pre = mailbox_send<Int>(m: mut box, value: p, source: psrc)
        p = p + 1
    }
    let mut i = 0
    let mut sink = 0
    while i < cycles {
        let source = i % 4
        let _sent = mailbox_send<Int>(m: mut box, value: i, source)
        let which = i % 3
        if which == 0 {
            match mailbox_take_from<Int>(m: mut box, source: 1) {
                Some(v) => { sink = sink + v }
                None => { sink = sink + 1 }
            }
        } else {
            if which == 1 {
                match mailbox_take<Int>(m: mut box) {
                    Some(v) => { sink = sink + v }
                    None => { sink = sink + 2 }
                }
            } else {
                sink = sink + 3
            }
        }
        i = i + 1
    }
    let mut drained = mailbox_take<Int>(m: mut box)
    while is_some_int(value: drained) {
        match drained {
            Some(v) => { sink = sink + v }
            None => { sink = sink + 0 }
        }
        drained = mailbox_take<Int>(m: mut box)
    }
    Output.write(message: String.from_int(value: sink))
    return Unit
}
