
fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 12000)
    let mut index = 0
    local table = Map<Int, Int>.new()

    while index < limit {
        let value = index * 3
        Map.insert<Int, Int>(map: mut table, key: index, value)
        index = index + 1
    }

    index = 0
    let mut total = 0
    while index < limit {
        match Map.get<Int, Int>(map: table, key: index) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
