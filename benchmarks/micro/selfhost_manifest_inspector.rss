
// Frozen self-hosting research artifact. This program predates the provider-only
// host boundary and intentionally is not part of Core VM/JIT/AOT conformance.
// A host may migrate it by exposing file reads through an explicit `.rssi`
// interface and provider.

fn edition_of(package: JsonValue) -> Result<fresh String, JsonError> {
    // SH-002: the optional-field-or-default shape collapses to one line via the
    // existing `Option.unwrap_or` rather than a `match`.
    let edition = Json.field_optional_string(value: package, name: "edition")?
    return Ok(Option.unwrap_or<String>(value: edition, default: ""))
}

fn dependency_count(manifest: JsonValue) -> Result<Int, JsonError> {
    match Json.field_optional(value: manifest, name: "dependencies")? {
        Some(deps) => {
            let keys = Json.object_keys(value: deps)?
            return Ok(List.len<String>(list: keys))
        }
        None => {
            return Ok(0)
        }
    }
}

// `[<table>] paths = [...]` as a list of strings, or empty when absent.
fn path_array(manifest: JsonValue, table: String) -> Result<fresh List<String>, JsonError> {
    match Json.field_optional(value: manifest, name: table)? {
        Some(section) => {
            match Json.field_optional(value: section, name: "paths")? {
                Some(array) => {
                    return Json.array_strings(value: array)
                }
                None => {
                    return Ok(List<String>.new())
                }
            }
        }
        None => {
            return Ok(List<String>.new())
        }
    }
}

fn inspect(path: Path) -> Result<fresh String, JsonError> {
    let manifest = Toml.parse_file(path)?
    let package = Json.field(value: manifest, name: "package")?
    let name = Json.field_string(value: package, name: "name")?
    let version = Json.field_string(value: package, name: "version")?
    let edition = edition_of(package)?
    let dep_count = dependency_count(manifest)?
    let interfaces = path_array(manifest, table: "interfaces")?
    let sources = path_array(manifest, table: "sources")?

    let mut fields = List<String>.new()
    List.push<String>(list: mut fields, value: Json.string_field(name: "package", value: name))
    List.push<String>(list: mut fields, value: Json.string_field(name: "version", value: version))
    List.push<String>(list: mut fields, value: Json.string_field(name: "edition", value: edition))
    List.push<String>(list: mut fields, value: Json.int_field(name: "dependency_count", value: dep_count))
    List.push<String>(list: mut fields, value: Json.raw_field(name: "interfaces", value: Json.string_array(items: interfaces)))
    List.push<String>(list: mut fields, value: Json.raw_field(name: "sources", value: Json.string_array(items: sources)))
    return Ok(Json.object(fields))
}

fn main(args: read List<String>) -> Result<Unit, String> {
    let path = Arguments.get_or_default(args: read args, index: 0, default: "benchmarks/micro/fixtures/package-medium/rsspkg.toml")
    match inspect(path: Path.from_string(value: path)) {
        Ok(report) => {
            Output.write(message: report)
            return Ok(Unit)
        }
        Err(error) => {
            return Err(JsonError.message(error))
        }
    }
}
