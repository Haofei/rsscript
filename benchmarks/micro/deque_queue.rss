
fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 50000)
    local q = Deque<Int>.new()
    let mut i = 0

    // Enqueue at the back...
    while i < limit {
        Deque.push_back<Int>(deque: mut q, value: i)
        i = i + 1
    }

    // ...then drain from the front (FIFO). `pop_front` was `Vec::remove(0)` (O(n)
    // → O(n^2) total); with `VecDeque` it is O(1) → O(n) total.
    let mut total = 0
    while Deque.len<Int>(deque: q) > 0 {
        match Deque.pop_front<Int>(deque: mut q) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total
            }
        }
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
