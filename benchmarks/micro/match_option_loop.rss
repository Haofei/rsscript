fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn maybe_value(value: Int) -> Option<Int> {
    let half = value / 2
    if half * 2 == value {
        return Some(value)
    }
    return None
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 200000)
    let mut index = 0
    let mut total = 0

    while index < limit {
        match maybe_value(value: index) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
