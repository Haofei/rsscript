
fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 12000)
    let mut index = 0
    local table = SortedMap<Int, Int>.new()

    while index < limit {
        let value = index * 2
        SortedMap.insert<Int, Int>(map: mut table, key: index, value)
        index = index + 1
    }

    let keys = SortedMap.keys<Int, Int>(map: table)
    index = 0
    let mut total = 0
    while index < List.len<Int>(list: keys) {
        let key = List.get<Int>(list: keys, index)
        match SortedMap.get<Int, Int>(map: table, key) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Log.write(message: String.from_int(value: total))
    return Unit
}
