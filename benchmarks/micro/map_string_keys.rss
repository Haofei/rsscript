
fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn key_for(value: Int) -> String {
    return String.concat(left: "key-", right: String.from_int(value))
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 12000)
    let mut index = 0
    local table = Map<String, Int>.new()

    while index < limit {
        let key = key_for(value: index)
        Map.insert<String, Int>(map: mut table, key, value: index)
        index = index + 1
    }

    index = 0
    let mut total = 0
    while index < limit {
        let key = key_for(value: index)
        match Map.get<String, Int>(map: table, key) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
