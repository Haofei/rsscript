
fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 2000000)
    let mut index = 0
    let mut step_index = 0
    let mut total = 0
    local steps = List<Int>.new()
    List.push<Int>(list: mut steps, value: 1)
    List.push<Int>(list: mut steps, value: 2)
    List.push<Int>(list: mut steps, value: 3)
    List.push<Int>(list: mut steps, value: 5)
    List.push<Int>(list: mut steps, value: 8)
    List.push<Int>(list: mut steps, value: 13)
    List.push<Int>(list: mut steps, value: 21)
    List.push<Int>(list: mut steps, value: 34)

    while index < limit {
        let step = List.get<Int>(list: steps, index: step_index)
        total = total + index * step + total / 1000000000
        index = index + 1
        step_index = step_index + 1
        if step_index == List.len<Int>(list: steps) {
            step_index = 0
        }
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
