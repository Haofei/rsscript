
// TV1 isolation kernel: build a `List<Float>` once, then sum it in a tight loop.
// Exercises flat `Floats` storage on the build (push) and read (get) paths.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let n = bench_size(args: read args, default: 200000)
    let mut index = 0
    local values = List<Float>.new()
    while index < n {
        List.push<Float>(list: mut values, value: Int.to_float(value: index))
        index = index + 1
    }

    let len = List.len<Float>(list: values)
    let mut total = 0.0
    let mut pass = 0
    while pass < 8 {
        index = 0
        while index < len {
            total = total + List.get<Float>(list: values, index)
            index = index + 1
        }
        pass = pass + 1
    }

    Output.write(message: String.from_float(value: total))
    return Unit
}
