
fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn mix(value: Int, salt: Int) -> Int {
    let doubled = value * 2
    return doubled + salt
}

fn main() -> Unit {
    let limit = bench_size(default: 1200000)
    let mut index = 0
    let mut salt_index = 0
    let mut total = 0
    local salts = List<Int>.new()
    List.push<Int>(list: mut salts, value: 1)
    List.push<Int>(list: mut salts, value: 3)
    List.push<Int>(list: mut salts, value: 5)
    List.push<Int>(list: mut salts, value: 7)
    List.push<Int>(list: mut salts, value: 11)
    List.push<Int>(list: mut salts, value: 13)
    List.push<Int>(list: mut salts, value: 17)
    List.push<Int>(list: mut salts, value: 19)

    while index < limit {
        let salt = List.get<Int>(list: salts, index: salt_index)
        total = total + mix(value: index + total / 1000000000, salt)
        index = index + 1
        salt_index = salt_index + 1
        if salt_index == List.len<Int>(list: salts) {
            salt_index = 0
        }
    }

    Log.write(message: String.from_int(value: total))
    return Unit
}
