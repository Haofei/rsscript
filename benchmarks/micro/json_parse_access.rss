fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Result<Unit, JsonError> {
    let limit = bench_size(args: read args, default: 50000)
    let text = "{\"profile\":{\"id\":41,\"active\":true,\"name\":\"rss\"},\"items\":[1,2,3,4]}"
    let mut index = 0
    let mut total = 0

    while index < limit {
        let doc = Json.parse(text)?
        let profile = Json.field(value: doc, name: "profile")?
        let id = Json.field_int(value: profile, name: "id")?
        total = total + id
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Ok(Unit)
}
