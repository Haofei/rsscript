fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Result<Unit, JsonError> {
    let limit = bench_size(default: 50000)
    let text = "{\"profile\":{\"id\":41,\"active\":true,\"name\":\"rss\"},\"items\":[1,2,3,4]}"
    let mut index = 0
    let mut total = 0

    while index < limit {
        let doc = Json.parse(text: read text)?
        let profile = Json.field(value: read doc, name: read "profile")?
        let id = Json.field_int(value: read profile, name: read "id")?
        total = total + id
        index = index + 1
    }

    Log.write(message: read String.from_int(value: total))
    return Ok(Unit)
}
