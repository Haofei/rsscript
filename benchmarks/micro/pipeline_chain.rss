
struct Acc {
    total: Int
}

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 12000)
    let mut index = 0
    local values = List<Int>.new()

    while index < limit {
        List.push<Int>(list: mut values, value: index)
        index = index + 1
    }

    let pipeline = Pipeline.map<Int, Int>(
        pipeline: Pipeline.filter<Int>(
            pipeline: List.pipeline<Int>(list: values),
            predicate: |value| {
                let half = value / 2
                return half * 2 == value
            },
        ),
        mapper: |value| {
            return value * 3 + 1
        },
    )
    let collected = Pipeline.collect<Int>(pipeline)
    let acc = List.fold<Int, Acc>(
        list: collected,
        initial: Acc(total: 0),
        folder: |state, value| {
            return Acc(total: state.total + value)
        },
    )

    Output.write(message: String.from_int(value: acc.total))
    return Unit
}
