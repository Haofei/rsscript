{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsscript.dev/schemas/native-jit-baseline-v1.json",
  "title": "RSScript native JIT canonical baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commit",
    "cpu",
    "os",
    "arch",
    "rust_version",
    "cranelift_version",
    "profile",
    "warmup",
    "samples",
    "fixture_digest",
    "controlled",
    "cpu_affinity",
    "cpu_governor",
    "sample_order",
    "cases"
  ],
  "properties": {
    "schema": { "const": "rsscript.native_jit_baseline.v1" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "cpu": { "type": "string", "minLength": 1 },
    "os": { "type": "string", "minLength": 1 },
    "arch": { "type": "string", "minLength": 1 },
    "rust_version": { "type": "string", "minLength": 1 },
    "cranelift_version": { "type": "string", "minLength": 1 },
    "profile": { "const": "release" },
    "warmup": { "type": "integer", "minimum": 1 },
    "samples": { "type": "integer", "minimum": 20 },
    "fixture_digest": { "type": "string", "minLength": 1 },
    "controlled": { "const": true },
    "cpu_affinity": { "type": "string", "minLength": 1 },
    "cpu_governor": { "type": "string", "minLength": 1 },
    "sample_order": { "const": "alternating" },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "case",
          "pass",
          "status",
          "interpreter_ns",
          "cold_e2e_native_ns",
          "interpreter_samples_ns",
          "cold_e2e_native_samples_ns",
          "interpreter_mad_ns",
          "cold_e2e_native_mad_ns",
          "warm_native_instrumented_ns",
          "speedup",
          "translation_nanos",
          "validation_nanos",
          "codegen_nanos",
          "finalize_nanos",
          "compile_nanos",
          "resident_code_bytes",
          "native_calls",
          "native_bails",
          "osr_entries",
          "continuation_entries",
          "runtime_helper_call_sites",
          "readonly_licm_sites",
          "bounds_check_sites",
          "bounds_checks_elided",
          "semantic_match",
          "controlled",
          "retention_threshold_met"
        ],
        "properties": {
          "case": { "type": "string", "minLength": 1 },
          "interpreter_ns": { "type": "integer", "minimum": 0 },
          "cold_e2e_native_ns": { "type": "integer", "minimum": 0 },
          "interpreter_samples_ns": {
            "type": "array",
            "minItems": 20,
            "items": { "type": "integer", "minimum": 0 }
          },
          "cold_e2e_native_samples_ns": {
            "type": "array",
            "minItems": 20,
            "items": { "type": "integer", "minimum": 0 }
          },
          "interpreter_mad_ns": { "type": "integer", "minimum": 0 },
          "cold_e2e_native_mad_ns": { "type": "integer", "minimum": 0 },
          "warm_native_instrumented_ns": { "type": "integer", "minimum": 0 },
          "instrumented_native_nanos_per_entry": { "type": "integer", "minimum": 0 },
          "pass": { "type": "string", "minLength": 1 },
          "status": { "enum": ["entered", "declined"] },
          "speedup": { "type": "number", "minimum": 0 },
          "translation_nanos": { "type": "integer", "minimum": 0 },
          "validation_nanos": { "type": "integer", "minimum": 0 },
          "codegen_nanos": { "type": "integer", "minimum": 0 },
          "finalize_nanos": { "type": "integer", "minimum": 0 },
          "compile_nanos": { "type": "integer", "minimum": 0 },
          "resident_code_bytes": { "type": "integer", "minimum": 0 },
          "native_calls": { "type": "integer", "minimum": 0 },
          "native_bails": { "type": "integer", "minimum": 0 },
          "osr_entries": { "type": "integer", "minimum": 0 },
          "continuation_entries": { "type": "integer", "minimum": 0 },
          "continuation_candidate_checks": { "type": "integer", "minimum": 0 },
          "continuation_full_probes": { "type": "integer", "minimum": 0 },
          "continuation_instance_key_builds": { "type": "integer", "minimum": 0 },
          "runtime_helper_call_sites": { "type": "integer", "minimum": 0 },
          "readonly_licm_sites": { "type": "integer", "minimum": 0 },
          "bounds_check_sites": { "type": "integer", "minimum": 0 },
          "bounds_checks_elided": { "type": "integer", "minimum": 0 },
          "semantic_match": { "const": true },
          "controlled": { "const": true },
          "retention_threshold_met": { "type": "boolean" }
        }
      }
    }
  }
}
