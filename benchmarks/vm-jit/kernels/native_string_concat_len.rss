// JIT hot path with native heap allocation plus concat: the scalar loop runs
// natively, `String.from_int(total)` allocates into the native transaction table,
// `String.concat(prefix, suffix)` allocates another output handle, and
// `String.len` consumes that native-created concat result before returning Int.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(prefix: read String, limit: Int, seed: Int) -> Int {
    let mut i = 0
    let mut total = seed
    while i < limit {
        total = total + i * 3 - i / 2 + 7
        i = i + 1
    }
    let suffix = String.from_int(value: total)
    let text = String.concat(left: read prefix, right: read suffix)
    return String.len(value: read text)
}

fn main() -> Unit {
    let limit = bench_size(default: 2000000)
    let result = hot(prefix: read "item-", limit: limit, seed: 0)
    Log.write(message: read String.from_int(value: result))
    return Unit
}
