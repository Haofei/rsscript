// JIT hot path: native parent repeatedly calls a native child that mutates a
// struct through a Handle parameter. This exercises the staged native-call ABI's
// mutable Handle parameter path without relying on flat-array argument support.

struct Cell {
    value: Int
}

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn set_cell(cell: mut Cell, value: Int) -> Int {
    cell.value = value
    return cell.value
}

fn hot(cell: mut Cell, limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        total = total + set_cell(cell: mut cell, value: i)
        i = i + 1
    }
    return total + cell.value
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 250000)
    let mut cell = Cell(value: 0)
    let result = hot(cell: mut cell, limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
