features: local

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn is_empty_loop(
    values: List<Int>,
    table: Map<Int, Int>,
    set: Set<Int>,
    sorted: SortedSet<Int>,
    sorted_table: SortedMap<Int, Int>,
    queue: Deque<Int>,
    reps: Int
) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        if List.is_empty<Int>(list: values) {
            total = total + 1
        } else {
            total = total + 10
        }
        if Map.is_empty<Int, Int>(map: table) {
            total = total + 2
        } else {
            total = total + 20
        }
        if Set.is_empty<Int>(set) {
            total = total + 4
        } else {
            total = total + 40
        }
        if SortedSet.is_empty<Int>(set: sorted) {
            total = total + 8
        } else {
            total = total + 80
        }
        if SortedMap.is_empty<Int, Int>(map: sorted_table) {
            total = total + 16
        } else {
            total = total + 160
        }
        if Deque.is_empty<Int>(deque: queue) {
            total = total + 32
        } else {
            total = total + 320
        }
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let reps = bench_size(default: 2000000)
    local values = List<Int>.new()
    local table = Map<Int, Int>.new()
    local set = Set.new<Int>()
    local sorted = SortedSet.new<Int>()
    local sorted_table = SortedMap<Int, Int>.new()
    local queue = Deque<Int>.new()

    List.push<Int>(list: mut values, value: 1)
    Map.insert<Int, Int>(map: mut table, key: 1, value: 2)
    Set.insert(set: mut set, value: 3)
    let _sorted_inserted = SortedSet.insert<Int>(set: mut sorted, value: 4)
    SortedMap.insert<Int, Int>(map: mut sorted_table, key: 5, value: 6)
    Deque.push_back<Int>(deque: mut queue, value: 7)

    Log.write(message: String.from_int(value: is_empty_loop(
        values,
        table,
        set,
        sorted,
        sorted_table,
        queue,
        reps
    )))
    return Unit
}
