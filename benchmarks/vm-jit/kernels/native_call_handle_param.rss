// JIT hot path: native parent allocates a String handle and passes it to a
// read-only native child. This exercises the staged native-call ABI's Handle
// parameter path without flat-array or mutating helper arguments.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn len_text(text: String) -> Int {
    return String.len(value: text)
}

fn hot(limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        let text = String.from_int(value: i)
        total = total + len_text(text)
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 250000)
    let result = hot(limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
