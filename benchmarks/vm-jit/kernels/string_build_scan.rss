features: local

// Slow path: String construction/inspection in a hot loop.
// Exercises String.concat (allocation + copy), String.from_int (formatting),
// String.slice, and String.len every iteration. None of these reach the native
// tier; they run on the interpreter dispatch path the perf plan targets.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 200000)
    let mut index = 0
    let mut total = 0

    while index < limit {
        let suffix = String.from_int(value: index)
        let key = String.concat(left: read "item-", right: read suffix)
        let head = String.slice(value: read key, start: 0, len: 4)
        total = total + String.len(value: read key) + String.len(value: read head)
        index = index + 1
    }

    Log.write(message: read String.from_int(value: total))
    return Unit
}
