
// String construction/inspection in a hot loop.
// Exercises String.concat (allocation + copy), String.from_int (formatting),
// String.slice, and String.len every iteration. This is a regression anchor for
// helper coverage: native/OSR should keep the slice/len chain out of dispatch.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 200000)
    let mut index = 0
    let mut total = 0

    while index < limit {
        let suffix = String.from_int(value: index)
        let key = String.concat(left: "item-", right: suffix)
        let head = String.slice(value: key, start: 0, len: 4)
        total = total + String.len(value: key) + String.len(value: head)
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
