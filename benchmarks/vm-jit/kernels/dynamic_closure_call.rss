
// Slow path: stored first-class `owned Fn` values invoked dynamically.
// Closures are stored in a struct inside a List, fetched, and called each
// iteration (the CallClosure / dynamic-dispatch path, not a static CallKnown).
// Tracks the recent "first-class owned Fn" work; pure-Int native cannot inline
// across an indirect closure call.

struct Op derives(Clone) {
    apply: owned Fn(Int) -> Int
}

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 200000)
    let base = 7
    local ops = List.new<Op>()

    let double_plus = Op(apply: fn(value) captures(read base) {
        return value * 2 + base
    })
    List.push(list: mut ops, value: double_plus)

    let shift = Op(apply: fn(value) captures(read base) {
        return value + base * 3
    })
    List.push(list: mut ops, value: shift)

    let mut index = 0
    let mut sel = 0
    let mut total = 0
    while index < limit {
        let op = List.get(list: ops, index: sel)
        let f = op.apply
        total = total + f(index)
        index = index + 1
        sel = sel + 1
        if sel == 2 {
            sel = 0
        }
    }

    Log.write(message: String.from_int(value: total))
    return Unit
}
