
fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(limit: Int, seed: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        let result: Result<Int, String> = Ok(i + seed)
        match result {
            Ok(value) => {
                total = total + value
            }
            Err(error) => {
                total = total + String.len(value: error)
            }
        }
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 300000)
    let result = hot(limit, seed: 7)
    Output.write(message: String.from_int(value: result))
    return Unit
}
