// JIT hot path: nested native-to-native scalar calls. The direct call benchmark
// proves one compiled edge; this one proves staged native-call ABI depth:
// hot(limit) -> mid(value, salt) -> leaf(value, salt).

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn leaf(value: Int, salt: Int) -> Int {
    return value * 3 + salt - value / 11
}

fn mid(value: Int, salt: Int) -> Int {
    let left = leaf(value, salt)
    let right = leaf(value: value + 1, salt: salt + 1)
    return left + right
}

fn hot(limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        total = total + mid(value: i, salt: total % 17)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 250000)
    let result = hot(limit)
    Log.write(message: String.from_int(value: result))
    return Unit
}
