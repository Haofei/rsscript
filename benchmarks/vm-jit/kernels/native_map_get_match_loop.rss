
fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 200000)
    local table = Map<Int, Int>.new()

    let mut seed = 0
    while seed < 256 {
        let value = seed * 3
        Map.insert<Int, Int>(map: mut table, key: seed, value)
        seed = seed + 1
    }

    let mut index = 0
    let mut total = 0
    while index < limit {
        let key = index % 256
        match Map.get<Int, Int>(map: table, key) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
