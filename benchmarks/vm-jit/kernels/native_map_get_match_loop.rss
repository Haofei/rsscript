features: local

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 200000)
    local table = Map<Int, Int>.new()

    let mut seed = 0
    while seed < 256 {
        let value = seed * 3
        Map.insert<Int, Int>(map: mut table, key: read seed, value: read value)
        seed = seed + 1
    }

    let mut index = 0
    let mut total = 0
    while index < limit {
        let key = index % 256
        match Map.get<Int, Int>(map: read table, key: read key) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total - 1
            }
        }
        index = index + 1
    }

    Log.write(message: read String.from_int(value: total))
    return Unit
}
