
// JIT hot path: a native parent passes a read-only flat `List<Float>` parameter
// to a compiled native child. This pins the native-to-native FlatFloat ABI:
// the caller must forward both the raw f64 pointer and the parallel length word.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn read_at(values: List<Float>, index: Int) -> Float {
    return List.get<Float>(list: values, index) + Int.to_float(value: List.len<Float>(list: values))
}

fn hot(values: List<Float>, limit: Int) -> Float {
    let mut i = 0
    let mut total = 0.0
    let n = List.len<Float>(list: values)
    while i < limit {
        total = total + read_at(values, index: i % n)
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 750000)
    local values = List.new<Float>()
    List.push<Float>(list: mut values, value: 1.25)
    List.push<Float>(list: mut values, value: 2.5)
    List.push<Float>(list: mut values, value: 3.75)
    List.push<Float>(list: mut values, value: 5.0)
    let result = hot(values, limit)
    Output.write(message: Float.to_string(value: result))
    return Unit
}
