// JIT hot path: integer division + modulo heavy, pure scalar. Exercises
// DivInt/ModInt and the native tier's div-by-zero guard path (the guard that can
// bail). `i` starts at 1 so no divisor is ever zero. Native-eligible.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(limit: Int) -> Int {
    let mut i = 1
    let mut total = 0
    while i < limit {
        total = total + 1000003 / i + i % 7 - i % 5
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 2000000)
    let result = hot(limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
