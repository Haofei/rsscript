
// Slow path: deep value copy (Rc/clone traffic). Each iteration makes an
// independent copy of a 256-element list via List.slice(full range), exercising
// the value-clone path that the perf plan's Phase 4 asks about ("is Rc/clone
// traffic a real cost?"). The copy cannot be elided — its head is read out.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 100000)
    local base = List<Int>.new()
    let mut k = 0
    while k < 256 {
        let v = k * k - k
        List.push<Int>(list: mut base, value: v)
        k = k + 1
    }
    let n = List.len<Int>(list: base)

    let mut index = 0
    let mut total = 0
    while index < limit {
        local copy = List.slice(list: base, start: 0, len: n)
        total = total + List.get<Int>(list: copy, index: 0)
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
