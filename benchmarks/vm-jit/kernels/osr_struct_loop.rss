// OSR × J3-struct kernel: a once-called, I/O-tangled function (Log.write before and
// after) whose hot loop builds a FLAT scalar-field struct `Point { x: Int, y: Int }`
// inline each iteration and reads its fields to accumulate. The Log.write calls make
// the function native-INELIGIBLE as a whole, so only OSR can run the loop natively.
// The Point is non-escaping and dead at the loop boundary, so OSR's J3 struct pass
// scalar-replaces it (one register per field slot, no allocation), turning the loop
// into an allocation-free native loop. NO helper functions, NO nested structs.

struct Point {
    x: Int,
    y: Int
}

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn run(limit: Int) -> Int {
    Log.write(message: "begin")
    let mut i = 0
    let mut total = 0
    while i < limit {
        let p = Point(x: i, y: i * 2)
        total = total + p.x + p.y
        i = i + 1
    }
    Log.write(message: String.from_int(value: total))
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 2000000)
    Log.write(message: String.from_int(value: run(limit)))
    return Unit
}
