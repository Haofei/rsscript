
fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn bytes_loop(data: Bytes, reps: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        let head = Bytes.slice(value: data, start: 0, len: 5)
        total = total + Bytes.len(value: head) + Bytes.len(value: data)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let reps = bench_size(default: 2000000)
    let data = Bytes.from_string(value: "the quick brown fox jumps over the lazy dog")
    Output.write(message: String.from_int(value: bytes_loop(data, reps)))
    return Unit
}
