features: local

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn bytes_loop(data: read Bytes, reps: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        let head = Bytes.slice(value: read data, start: 0, len: 5)
        total = total + Bytes.len(value: read head) + Bytes.len(value: read data)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let reps = bench_size(default: 2000000)
    let data = Bytes.from_string(value: read "the quick brown fox jumps over the lazy dog")
    Log.write(message: read String.from_int(value: bytes_loop(data: read data, reps: reps)))
    return Unit
}
