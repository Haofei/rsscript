
fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 500000)
    local values = List<Int>.new()

    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)

    let total = hot(limit, values: mut values)
    Output.write(message: String.from_int(value: total))
    return Unit
}

fn hot(limit: Int, values: mut List<Int>) -> Int {
    let mut i = 0
    let mut total = 0

    while i < limit {
        let slot = i % 16
        List.set<Int>(list: mut values, index: slot, value: i)
        total = total + List.get<Int>(list: values, index: slot)
        i = i + 1
    }

    return total
}
