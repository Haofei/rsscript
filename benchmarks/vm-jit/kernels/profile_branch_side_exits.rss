// Profile-guided whole-function branch side-exit kernel.
//
// The perf gate defers this 11-work-unit body for 66 calls. That collects 16
// strong post-warmup branch samples before later calls compile `branchy` as a
// whole function and lower the cold edge as a profile-guided side exit, exposed
// as `profile_branch_side_exits` / `br_x` telemetry.

fn branchy(value: Int) -> Int {
    if value < 1000000000 {
        return value + 1
    }
    return 0
}

