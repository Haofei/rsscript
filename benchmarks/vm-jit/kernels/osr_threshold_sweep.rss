// OSR backedge-threshold downside-guard kernel.
//
// `short_hot` is an I/O-tangled (native-INELIGIBLE) function with a SINGLE hot
// scalar loop whose bound = `inner` (the second size arg). `main` calls it
// `outer` times (first size arg). When the threshold is set BELOW `inner`, every
// call OSR-compiles the loop — but each call is a *fresh frame*, so a too-low
// threshold can pay the OSR compile repeatedly for a loop that exits right after
// firing. This exposes whether a low threshold wastes compiles on loops that do
// not run long enough to recoup the compile cost.
//
// Drive: `... osr_threshold_sweep.rss -- <outer> <inner>`.

fn size_arg(index: Int, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn short_hot(limit: Int, seed: Int) -> Int {
    Output.write(message: "osr-begin")
    let mut i = 0
    let mut total = seed
    while i < limit {
        total = total + i * 3 - i / 2 + 7
        i = i + 1
    }
    Output.write(message: String.from_int(value: total))
    return total
}

fn main(args: read List<String>) -> Unit {
    let outer = size_arg(index: 0, default: 1000)
    let inner = size_arg(index: 1, default: 1500)
    let mut k = 0
    let mut acc = 0
    while k < outer {
        acc = acc + short_hot(limit: inner, seed: k)
        k = k + 1
    }
    Output.write(message: String.from_int(value: acc))
    return Unit
}
