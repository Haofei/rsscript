fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Result<Unit, JsonError> {
    let limit = bench_size(default: 500000)
    let total = hot(limit)?
    Output.write(message: String.from_int(value: total))
    return Ok(Unit)
}

fn hot(limit: Int) -> Result<Int, JsonError> {
    let text = "{\"profile\":{\"id\":41,\"active\":true,\"name\":\"rss\"},\"items\":[1,2,3,4]}"
    let doc = Json.parse(text)?
    let profile = Json.field(value: doc, name: "profile")?
    let mut index = 0
    let mut total = 0

    while index < limit {
        total = total + Json.field_int(value: profile, name: "id")?
        index = index + 1
    }

    return Ok(total)
}
