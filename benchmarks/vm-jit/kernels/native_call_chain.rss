// JIT hot path: a scalar hot loop that calls a small leaf function every
// iteration — exercises the native tier's cross-function call path (acyclic,
// non-suspending, scalar args/return). Tests whether native handles CallKnown
// inside compiled code rather than bailing to the interpreter.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn mix(value: Int, salt: Int) -> Int {
    return value * 2 + salt - value / 7
}

fn hot(limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        total = total + mix(value: i, salt: total % 13)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 1500000)
    let result = hot(limit)
    Log.write(message: String.from_int(value: result))
    return Unit
}
