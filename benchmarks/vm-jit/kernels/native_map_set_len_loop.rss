
fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn len_loop(table: Map<Int, Int>, set: Set<Int>, reps: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        total = total + Map.len<Int, Int>(map: table)
        total = total + Set.len<Int>(set)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let reps = bench_size(default: 2000000)
    local table = Map<Int, Int>.new()
    local set = Set.new<Int>()
    let mut i = 0
    while i < 32 {
        let value = i * 2
        Map.insert<Int, Int>(map: mut table, key: i, value)
        Set.insert(set: mut set, value: i)
        i = i + 1
    }

    Log.write(message: String.from_int(value: len_loop(
        table,
        set,
        reps
    )))
    return Unit
}
