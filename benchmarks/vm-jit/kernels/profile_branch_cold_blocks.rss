// Profile-guided branch-layout kernel.
//
// The perf gate runs this case with RSS_JIT_TIER_THRESHOLD=200 so `branchy`
// executes under the native-enabled interpreter long enough to collect a strong
// one-sided branch profile before it first compiles. The native translator should
// then mark the cold successor block in `JitFunction::cold_blocks`, exposed as
// `profile_branch_cold_blocks` / `br_c` telemetry.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn branchy(value: Int) -> Int {
    if value < 1000000000 {
        return value + 1
    }
    return 0
}

fn main() -> Unit {
    let limit = bench_size(default: 250000)
    let mut i = 0
    let mut total = 0
    while i < limit {
        total = total + branchy(value: i)
        i = i + 1
    }
    Output.write(message: String.from_int(value: total))
    return Unit
}
