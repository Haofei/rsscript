features: local

// JIT hot path: a native parent passes a read-only flat `List<Int>` parameter
// to a compiled native child. This exercises the native-to-native flat param ABI:
// the caller must forward both the raw pointer and the parallel length word.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn read_at(values: read List<Int>, index: Int) -> Int {
    return List.get<Int>(list: read values, index: index) + List.len<Int>(list: read values)
}

fn hot(values: read List<Int>, limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    let n = List.len<Int>(list: read values)
    while i < limit {
        total = total + read_at(values: read values, index: read i % n)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 750000)
    local values = List.new<Int>()
    List.push<Int>(list: mut values, value: read 5)
    List.push<Int>(list: mut values, value: read 7)
    List.push<Int>(list: mut values, value: read 11)
    List.push<Int>(list: mut values, value: read 13)
    let result = hot(values: read values, limit: limit)
    Log.write(message: read String.from_int(value: result))
    return Unit
}
