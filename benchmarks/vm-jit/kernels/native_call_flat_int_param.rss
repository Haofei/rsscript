features: local

// JIT hot path: a native parent passes a read-only flat `List<Int>` parameter
// to a compiled native child. This exercises the native-to-native flat param ABI:
// the caller must forward both the raw pointer and the parallel length word.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn read_at(values: List<Int>, index: Int) -> Int {
    return List.get<Int>(list: values, index) + List.len<Int>(list: values)
}

fn hot(values: List<Int>, limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    let n = List.len<Int>(list: values)
    while i < limit {
        total = total + read_at(values, index: i % n)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 750000)
    local values = List.new<Int>()
    List.push<Int>(list: mut values, value: 5)
    List.push<Int>(list: mut values, value: 7)
    List.push<Int>(list: mut values, value: 11)
    List.push<Int>(list: mut values, value: 13)
    let result = hot(values, limit)
    Log.write(message: String.from_int(value: result))
    return Unit
}
