// OSR × J3 kernel (Pending #1): a hot loop that constructs and matches a
// *non-escaping* scalar `Option<Int>` each iteration, wrapped by non-native I/O
// in the SAME, once-called function — so the function is native-INELIGIBLE as a
// whole (the `Output.write` calls keep it off the whole-function native tier), and
// the only way to run the loop natively is OSR.
//
// Today (OSR off, or plain native-subset OSR) the interpreter runs the whole
// loop, ALLOCATING an `Option` per iteration. With OSR × J3 (Pending #1), the
// OSR pre-pass scalar-replaces the loop-internal Option into tag + payload scalar
// registers, so the loop runs as an allocation-free native loop. The Option is
// dead at the loop boundary, so the OSR live-in/live-out stay the loop-carried
// registers (`i`, `total`) — unchanged by J3.
//
// Run it with OSR off (`--mode jit-native`, today's interpreter for this shape)
// vs OSR on (`--mode jit-native-osr`); the OSR median should beat the off median.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn f(limit: Int) -> Int {
    Output.write(message: "osr-option-begin")
    let mut i = 0
    let mut total = 0
    while i < limit {
        let mut o: Option<Int> = None
        if i % 3 == 0 {
            o = Some(i * 2)
        }
        match o {
            Some(x) => {
                total = total + x
            }
            None => {
                total = total + 0
            }
        }
        i = i + 1
    }
    Output.write(message: String.from_int(value: total))
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 2000000)
    let result = f(limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
