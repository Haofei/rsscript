
// JIT hot path: read-only heap access over a `List<Float>` inside a pure scalar
// loop in its own function — exercises the native tier's *Float* host-helper read
// ABI (list_len / list_get_float, Phase 3.2). `main` builds a small float list
// once (cheap) and `hot` does the heavy read loop, so eligibility is not tainted
// by the build. Mirrors native_read_heap.rss but accumulates an f64.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(xs: List<Float>, limit: Int) -> Float {
    let mut i = 0
    let mut total = 0.0
    let n = List.len<Float>(list: xs)
    while i < limit {
        let idx = i % n
        total = total + List.get<Float>(list: xs, index: idx)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 2000000)
    local xs = List<Float>.new()
    let mut k = 0
    while k < 16 {
        let v = k * k - k
        List.push<Float>(list: mut xs, value: Int.to_float(value: v))
        k = k + 1
    }
    let result = hot(xs, limit)
    Output.write(message: String.from_float(value: result))
    return Unit
}
