fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 100000)
    let total = hot(line: "alpha,beta,gamma,delta,epsilon", fill: " ", limit)
    Log.write(message: String.from_int(value: total))
    return Unit
}

fn hot(line: String, fill: String, limit: Int) -> Int {
    let mut index = 0
    let mut total = 0

    while index < limit {
        let padded = String.pad_left(value: line, width: 40, fill)
        total = total + String.len(value: padded)
        index = index + 1
    }

    return total
}
