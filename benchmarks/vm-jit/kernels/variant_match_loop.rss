
// Slow path: user-defined sum type construction + match dispatch.
// Exercises MakeVariant, MatchVariant, and UnwrapVariantValue every iteration
// (distinct from the built-in Option/Result match already covered). The native
// tier does not construct or destructure heap variants.

sum Shape {
    Circle(radius: Int)
    Square(side: Int)
    Empty
}

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn make_shape(sel: Int, size: Int) -> Shape {
    if sel == 0 {
        return Circle(radius: size)
    }
    if sel == 1 {
        return Square(side: size)
    }
    return Empty
}

fn area(shape: Shape) -> Int {
    match shape {
        Circle(radius) => {
            return radius * radius * 3
        }
        Square(side) => {
            return side * side
        }
        Empty => {
            return 0
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 300000)
    let mut index = 0
    let mut sel = 0
    let mut total = 0

    while index < limit {
        let shape = make_shape(sel, size: index)
        total = total + area(shape)
        index = index + 1
        sel = sel + 1
        if sel == 3 {
            sel = 0
        }
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
