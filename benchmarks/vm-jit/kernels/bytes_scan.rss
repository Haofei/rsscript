features: local

// Slow path: Bytes value family (construct + slice + length) in a hot loop.
// Exercises the Bytes intrinsic group, distinct from String. Not reachable by
// the native tier (heap value, host-helper boundary).

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 200000)
    let data = Bytes.from_string(value: read "the quick brown fox jumps over the lazy dog")
    let mut index = 0
    let mut total = 0

    while index < limit {
        let head = Bytes.slice(value: read data, start: 0, len: 5)
        total = total + Bytes.len(value: read head) + Bytes.len(value: read data)
        index = index + 1
    }

    Log.write(message: read String.from_int(value: total))
    return Unit
}
