// JIT hot path: a pure-Int scalar loop in its own function — the canonical
// native-eligible shape (no allocation/construction in the body, non-recursive).
// This is the kernel where the native (Cranelift) tier SHOULD win; if `nat/reg`
// is not well below 1.0 here, native is not engaging. Keep `hot` separate from
// `main` so `main`'s arg parsing doesn't taint eligibility.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(limit: Int, seed: Int) -> Int {
    let mut i = 0
    let mut total = seed
    while i < limit {
        total = total + i * 3 - i / 2 + 7
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 2000000)
    let result = hot(limit, seed: 0)
    Output.write(message: String.from_int(value: result))
    return Unit
}
