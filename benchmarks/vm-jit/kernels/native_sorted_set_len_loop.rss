
fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn len_loop(seen: SortedSet<Int>, reps: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        total = total + SortedSet.len<Int>(set: seen)
        i = i + 1
    }
    return total
}

fn main(args: read List<String>) -> Unit {
    let reps = bench_size(args: read args, default: 2000000)
    local seen = SortedSet.new<Int>()
    let mut i = 0
    while i < 32 {
        let _inserted = SortedSet.insert<Int>(set: mut seen, value: i)
        i = i + 1
    }

    Output.write(message: String.from_int(value: len_loop(seen, reps)))
    return Unit
}
