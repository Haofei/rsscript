features: local

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn len_loop(seen: read SortedSet<Int>, reps: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < reps {
        total = total + SortedSet.len<Int>(set: read seen)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let reps = bench_size(default: 2000000)
    local seen = SortedSet.new<Int>()
    let mut i = 0
    while i < 32 {
        let _inserted = SortedSet.insert<Int>(set: mut seen, value: read i)
        i = i + 1
    }

    Log.write(message: read String.from_int(value: len_loop(seen: read seen, reps: reps)))
    return Unit
}
