
// Slow path: Set membership (hash-set insert + contains) in a hot loop.
// Complements the Map kernels: Set has its own intrinsic group (SetInsert,
// SetContains/len) and hashing cost. Not reachable by the native tier.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 30000)
    local seen = Set.new<Int>()
    let mut index = 0

    while index < limit {
        Set.insert(set: mut seen, value: index)
        index = index + 1
    }

    index = 0
    let mut total = 0
    while index < limit {
        if Set.contains(set: seen, value: index) {
            total = total + 1
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
