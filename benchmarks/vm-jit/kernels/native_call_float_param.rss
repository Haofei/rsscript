// JIT hot path: native parent calls a compiled child with Float parameters and
// Float return, then consumes that result in native Float arithmetic. This pins
// the staged native-call ABI for f64 payloads rather than relying on Int-shaped
// call tests.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn scale(value: Float, factor: Float) -> Float {
    return value * factor
}

fn hot(limit: Int) -> Float {
    let mut i = 0
    let mut total = 0.0
    while i < limit {
        let residue = i % 97
        let f = Int.to_float(value: residue)
        total = total + scale(value: f, factor: 1.25)
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 750000)
    let result = hot(limit)
    Log.write(message: Float.to_string(value: result))
    return Unit
}
