
// JIT hot path: a native parent repeatedly calls a native child that mutates a
// flat `List<Int>` parameter. This exercises the native-to-native ABI for
// `FlatIntMut`: the caller forwards the raw pointer and length, and the child
// performs a direct bounds-checked store.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn write_at(values: mut List<Int>, index: Int, value: Int) -> Int {
    List.set<Int>(list: mut values, index, value)
    return List.get<Int>(list: values, index)
}

fn hot(values: mut List<Int>, limit: Int) -> Int {
    let mut i = 0
    let mut total = 0
    let n = List.len<Int>(list: values)
    while i < limit {
        let slot = i % n
        total = total + write_at(values: mut values, index: slot, value: i)
        i = i + 1
    }
    return total + List.get<Int>(list: values, index: 3)
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 500000)
    local values = List.new<Int>()
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    List.push<Int>(list: mut values, value: 0)
    let result = hot(values: mut values, limit)
    Output.write(message: String.from_int(value: result))
    return Unit
}
