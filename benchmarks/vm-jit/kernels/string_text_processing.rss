// Slow path: String text-processing intrinsics (split / pad_left / starts_with)
// in a hot loop — a distinct intrinsic group from the concat/slice covered by
// string_build_scan. `split` allocates a List<String> each iteration.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 100000)
    let total = hot(
        line: "alpha,beta,gamma,delta,epsilon",
        delimiter: ",",
        fill: " ",
        prefix: "alpha",
        limit,
    )
    Output.write(message: String.from_int(value: total))
    return Unit
}

fn hot(line: String, delimiter: String, fill: String, prefix: String, limit: Int) -> Int {
    let mut index = 0
    let mut total = 0

    while index < limit {
        let parts = String.split(value: line, delimiter)
        let padded = String.pad_left(value: line, width: 40, fill)
        total = total + List.len<String>(list: parts) + String.len(value: padded)
        if String.starts_with(value: line, prefix) {
            total = total + 1
        }
        index = index + 1
    }

    return total
}
