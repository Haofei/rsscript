// Slow path: String text-processing intrinsics (split / pad_left / starts_with)
// in a hot loop — a distinct intrinsic group from the concat/slice covered by
// string_build_scan. `split` allocates a List<String> each iteration.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 100000)
    let total = hot(
        line: read "alpha,beta,gamma,delta,epsilon",
        delimiter: read ",",
        fill: read " ",
        prefix: read "alpha",
        limit: limit,
    )
    Log.write(message: read String.from_int(value: total))
    return Unit
}

fn hot(line: read String, delimiter: read String, fill: read String, prefix: read String, limit: Int) -> Int {
    let mut index = 0
    let mut total = 0

    while index < limit {
        let parts = String.split(value: read line, delimiter: read delimiter)
        let padded = String.pad_left(value: read line, width: 40, fill: read fill)
        total = total + List.len<String>(list: read parts) + String.len(value: read padded)
        if String.starts_with(value: read line, prefix: read prefix) {
            total = total + 1
        }
        index = index + 1
    }

    return total
}
