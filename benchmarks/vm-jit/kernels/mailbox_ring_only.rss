
struct MailboxInt {
    capacity: Int
    head: Int
    count: Int
    values: List<Int>
}

fn mailbox_new(capacity: Int) -> fresh MailboxInt {
    return MailboxInt(
        capacity: capacity,
        head: 0,
        count: 0,
        values: List<Int>.new(),
    )
}

fn mailbox_send(m: mut MailboxInt, value: Int) -> Bool {
    if m.count >= m.capacity {
        return false
    }
    let tail = (m.head + m.count) % m.capacity
    if tail < List.len<Int>(list: m.values) {
        List.set<Int>(list: mut m.values, index: tail, value)
    } else {
        List.push<Int>(list: mut m.values, value)
    }
    m.count = m.count + 1
    return true
}

fn mailbox_take(m: mut MailboxInt) -> Option<Int> {
    if m.count <= 0 {
        return None
    }
    let value = List.get<Int>(list: m.values, index: m.head)
    m.head = (m.head + 1) % m.capacity
    m.count = m.count - 1
    return Some(value)
}

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 60000)
    let total = hot(limit)
    Output.write(message: String.from_int(value: total))
    return Unit
}

fn hot(limit: Int) -> Int {
    let mut box = mailbox_new(capacity: 16)
    let mut i = 0
    let mut total = 0

    while i < limit {
        let _sent = mailbox_send(m: mut box, value: i)
        match mailbox_take(m: mut box) {
            Some(value) => {
                total = total + value
            }
            None => {
                total = total + 1
            }
        }
        i = i + 1
    }

    return total
}
