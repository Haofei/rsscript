
// Slow path: Float value family + float arithmetic in a hot loop.
// The native (Cranelift) tier handles Int scalars; this kernel keeps the VM on
// the Float arithmetic path (AddFloat/SubFloat/MulFloat) plus Int->Float and
// Float->String conversions, none of which the int fast path covers.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 1000000)
    let mut index = 0
    let mut acc = 0.0

    while index < limit {
        let f = Int.to_float(value: index)
        acc = acc + f * 0.5 - 1.0
        index = index + 1
    }

    Output.write(message: Float.to_string(value: acc))
    return Unit
}
