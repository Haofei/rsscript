
// Slow path: SortedSet membership (ordered insert + contains) — the one
// collection structure the suite was missing (have Map/SortedMap/Set/Deque).
// Exercises SortedSetInsert / SortedSetContains and the ordered backing.

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 8000)
    local s = SortedSet<Int>.new()
    let mut index = 0

    while index < limit {
        let _ins = SortedSet.insert<Int>(set: mut s, value: index)
        index = index + 1
    }

    index = 0
    let mut total = 0
    while index < limit {
        if SortedSet.contains<Int>(set: s, value: index) {
            total = total + 1
        }
        index = index + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
