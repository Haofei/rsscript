features: local

// Slow path: SortedSet membership (ordered insert + contains) — the one
// collection structure the suite was missing (have Map/SortedMap/Set/Deque).
// Exercises SortedSetInsert / SortedSetContains and the ordered backing.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: read String.from_int(value: default))
    match String.parse_int(value: read raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 8000)
    local s = SortedSet<Int>.new()
    let mut index = 0

    while index < limit {
        let _ins = SortedSet.insert<Int>(set: mut s, value: read index)
        index = index + 1
    }

    index = 0
    let mut total = 0
    while index < limit {
        if SortedSet.contains<Int>(set: read s, value: read index) {
            total = total + 1
        }
        index = index + 1
    }

    Log.write(message: read String.from_int(value: total))
    return Unit
}
