
// Slow path: structured concurrency — each round spawns 3 concurrent tasks in a
// `task_group` and joins them (the SpawnTask / async-let / await-join machinery),
// distinct from async_call_loop's single sequential await. (RSScript has no
// `select`; a task_group implicitly joins all its tasks at block end.)
//
// HISTORY: this kernel once scaled ~quadratically in round count (completed
// task slots were never reclaimed from the scheduler's task table, so its
// per-step scans grew O(n)). Fixed by reaping a task slot on join — it now
// scales linearly. See README finding #4.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

async fn work(seed: Int) -> Result<Int, String> {
    return Ok(seed * 2 + 1)
}

fn run_round(seed: Int) -> Result<Int, String> {
    let mut sum = 0
    task_group {
        async let a = work(seed)
        async let b = work(seed: seed + 1)
        async let c = work(seed: seed + 2)
        let ra = await a?
        let rb = await b?
        let rc = await c?
        sum = ra + rb + rc
    }
    return Ok(sum)
}

fn main() -> Result<Unit, String> {
    let limit = bench_size(default: 20000)
    let mut index = 0
    let mut total = 0

    while index < limit {
        let r = run_round(seed: index)?
        total = total + r
        index = index + 1
    }

    Log.write(message: String.from_int(value: total))
    return Ok(Unit)
}
