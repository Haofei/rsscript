// Profile-guided polymorphic closure inline-cache kernel.
//
// `dispatch` is a tiny higher-order function whose `CallClosure` site sees three
// hot closure targets. The native tier should lower that call site as a
// profile-guided polymorphic inline cache (PIC), which the perf gate verifies
// through `profile_closure_pic_sites` and `profile_closure_pic_arms` telemetry.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn dispatch(f: Fn(Int) -> Int, x: Int) -> Int {
    return f(x)
}

fn main() -> Unit {
    let limit = bench_size(default: 600000)
    let mut i = 0
    let mut total = 0
    while i < limit {
        if i % 6 == 0 {
            let c: Fn(Int) -> Int = |x| { return 0 - x }
            total = total + dispatch(f: c, x: i)
        } else if i % 6 < 3 {
            let b: Fn(Int) -> Int = |x| { return x + 7 }
            total = total + dispatch(f: b, x: i)
        } else {
            let a: Fn(Int) -> Int = |x| { return x * 2 - 1 }
            total = total + dispatch(f: a, x: i)
        }
        i = i + 1
    }
    Log.write(message: String.from_int(value: total))
    return Unit
}
