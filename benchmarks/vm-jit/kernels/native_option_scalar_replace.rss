
fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(limit: Int, seed: Int) -> Int {
    let mut i = 0
    let mut total = 0
    while i < limit {
        let value: Option<Int> = Some(i + seed)
        match value {
            Some(item) => {
                total = total + item
            }
            None => {
                total = total + 1
            }
        }
        i = i + 1
    }
    return total
}

fn main() -> Unit {
    let limit = bench_size(default: 300000)
    let result = hot(limit, seed: 7)
    Log.write(message: String.from_int(value: result))
    return Unit
}
