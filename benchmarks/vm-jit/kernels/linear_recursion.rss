// Slow path: deep *linear* recursion (frame depth), complementing recursion_fib
// (which is exponential breadth). `sum_to` recurses n frames deep with an
// accumulator; main drives it many times. Stresses sustained frame push/pop
// depth rather than call fan-out. Recursive call graph => ineligible for native.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn sum_to(n: Int, acc: Int) -> Int {
    if n == 0 {
        return acc
    }
    return sum_to(n: n - 1, acc: acc + n)
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 50000)
    let mut i = 0
    let mut total = 0

    while i < limit {
        total = total + sum_to(n: 1000, acc: 0)
        i = i + 1
    }

    Output.write(message: String.from_int(value: total))
    return Unit
}
