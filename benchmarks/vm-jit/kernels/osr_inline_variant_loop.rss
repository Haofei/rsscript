
// OSR × inline-leaf-calls (Pending #1) cross-function kernel.
//
// Same cross-function shape as `variant_match_loop.rss` — a variant built in one
// leaf (`make_shape`) and matched in another (`area`), both called from the hot
// loop — but with a DETECTOR-FRIENDLY single natural loop (no extra in-loop
// `if sel == 3 { sel = 0 }` back-branch; the arm selector is `index % 3`). The
// loop lives in an I/O-tangled (native-ineligible) `run`, so only OSR can run it
// natively: OSR inlines the two `CallKnown` leaves into the loop body, the variant
// becomes loop-local, and J3 variant scalar-replacement dissolves it to a tag +
// payload scalar pair — an allocation-free native loop. With `RSS_JIT_OSR=1` this
// kernel OSRs; without it the reg-VM interprets the loop, allocating a `Shape` and
// destructuring it every iteration.

sum Shape {
    Circle(radius: Int)
    Square(side: Int)
    Empty
}

fn bench_size(default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn make_shape(sel: Int, size: Int) -> Shape {
    if sel == 0 {
        return Circle(radius: size)
    }
    if sel == 1 {
        return Square(side: size)
    }
    return Empty
}

fn area(shape: Shape) -> Int {
    match shape {
        Circle(radius) => {
            return radius * radius * 3
        }
        Square(side) => {
            return side * side
        }
        Empty => {
            return 0
        }
    }
}

fn run(limit: Int) -> Int {
    Output.write(message: "begin")
    let mut index = 0
    let mut total = 0
    while index < limit {
        let shape = make_shape(sel: index % 3, size: index)
        total = total + area(shape)
        index = index + 1
    }
    Output.write(message: String.from_int(value: total))
    return total
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(default: 300000)
    Output.write(message: String.from_int(value: run(limit)))
    return Unit
}
