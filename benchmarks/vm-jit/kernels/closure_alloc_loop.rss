
// Slow path: closure allocation churn — a fresh closure is created and called
// every iteration (MakeClosure + CallClosure per loop), distinct from the
// list_closure kernel which builds its closures once. Stresses the per-iteration
// closure allocation the VM does on the heap.

fn bench_size(default: Int) -> Int {
    let raw = Args.get_or_default(index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn main() -> Unit {
    let limit = bench_size(default: 300000)
    let mut i = 0
    let mut total = 0

    while i < limit {
        local f = |x| {
            return x * 2 + 1
        }
        total = total + f(i)
        i = i + 1
    }

    Log.write(message: String.from_int(value: total))
    return Unit
}
