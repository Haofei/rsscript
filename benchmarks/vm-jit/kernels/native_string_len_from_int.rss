// JIT hot path with a native-created heap value consumed before return: the scalar
// loop runs natively, then `String.from_int(total)` allocates in the native
// transaction table and `String.len` reads that output handle before returning Int.

fn bench_size(args: read List<String>, default: Int) -> Int {
    let raw = Arguments.get_or_default(args: read args, index: 0, default: String.from_int(value: default))
    match String.parse_int(value: raw) {
        Some(value) => {
            return value
        }
        None => {
            return default
        }
    }
}

fn hot(limit: Int, seed: Int) -> Int {
    let mut i = 0
    let mut total = seed
    while i < limit {
        total = total + i * 3 - i / 2 + 7
        i = i + 1
    }
    let text = String.from_int(value: total)
    return String.len(value: text)
}

fn main(args: read List<String>) -> Unit {
    let limit = bench_size(args: read args, default: 2000000)
    let result = hot(limit, seed: 0)
    Output.write(message: String.from_int(value: result))
    return Unit
}
