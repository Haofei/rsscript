features: native, local

// Native tensor: a packed, row-major `f32` buffer plus a shape, backed by a
// runtime kernel (slice 1 of the ML-perf work). The VM orchestrates; native code
// computes. Both backends call the same `rsscript_runtime::tensor_*` functions,
// so results are bit-identical. Floats are `f64` in RSScript but stored as `f32`
// in a tensor; values are narrowed on the way in and widened on the way out.

struct TensorError
struct Tensor

// Build a tensor from a flat row-major `Float` buffer and a shape. Errors if the
// shape has a negative dimension or its element count != `data.len()`.
pub native fn Tensor.from_f32_slice(
    data: List<Float>,
    shape: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Read the packed buffer back out (row-major), widened to `Float`.
pub native fn Tensor.to_f32_slice(tensor: Tensor) -> Result<fresh List<Float>, TensorError>
    effects(native)

// The tensor's shape.
pub native fn Tensor.shape(tensor: Tensor) -> Result<fresh List<Int>, TensorError>
    effects(native)

// The number of dimensions.
pub native fn Tensor.rank(tensor: Tensor) -> Int
    effects(native)

// Serialize f32 values to little-endian device-buffer bytes (4 per value, each in
// 0..=255). Used by the fused-backend realize path to fill exec-context buffers.
pub native fn Tensor.f32_to_le_bytes(data: List<Float>) -> fresh List<Int>
    effects(native)

// Inverse: decode little-endian f32 bytes (length a multiple of 4) to floats.
pub native fn Tensor.f32_from_le_bytes(bytes: List<Int>) -> Result<fresh List<Float>, TensorError>
    effects(native)

// 2-D × 2-D matrix multiply, contracting the inner dims: (m, k) × (k, n) -> (m,
// n). Errors on non-rank-2 operands or an inner-dimension mismatch.
pub native fn Tensor.matmul(
    a: Tensor,
    b: Tensor,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Whether a Metal GPU is available for the native compute path (false off macOS or
// when no device is present).
pub native fn Tensor.metal_available() -> Bool
    effects(native)

// The Metal device name (e.g. "Apple M2 Max"), or an empty string when no GPU is
// available.
pub native fn Tensor.metal_device_name() -> fresh String
    effects(native)

// GPU matrix multiply: same contract as `matmul`, dispatched to Metal. NOT bit-
// identical to the CPU kernel (GPU reductions reorder), so it matches to f32
// tolerance. Errors on non-rank-2 operands, an inner-dim mismatch, or no GPU.
pub native fn Tensor.matmul_metal(
    a: Tensor,
    b: Tensor,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Compile and dispatch an arbitrary MSL kernel on the GPU. `source` is full MSL,
// `fn_name` the kernel entry point. Each inner list of `inputs` is uploaded to
// buffer(i); the output is buffer(inputs.len()), sized `out_len` f32s, dispatched
// over `threads` linear grid threads. Returns the output floats. NOT bit-exact vs
// CPU (GPU accumulation reorders); validate to f32 tolerance. The generic GPU
// escape hatch the Metal renderer lowers kernel ASTs into. Errors on no GPU or an
// MSL compile/dispatch failure.
pub native fn Tensor.gpu_run_msl(
    source: String,
    fn_name: String,
    inputs: List<List<Float>>,
    out_len: Int,
    threads: Int,
) -> Result<fresh List<Float>, TensorError>
    effects(native)

// (The `Metal.*` GPU-dispatch surface lives in metal.rssi — a standalone interface
// with no `struct Tensor`, so a host program that defines its own `Tensor` can
// depend on Metal without a type collision.)

// Elementwise binary ops over two same-shape tensors. No broadcasting — the
// shapes must match exactly (broadcasting is deferred to a later slice). Errors
// on a shape mismatch.
pub native fn Tensor.add(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.sub(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.mul(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.div(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Elementwise unary ops, same shape out. Infallible (no Result).
pub native fn Tensor.neg(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.exp(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.log(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.sqrt(t: Tensor) -> fresh Tensor
    effects(native)

// ReLU: max(0, x).
pub native fn Tensor.relu(t: Tensor) -> fresh Tensor
    effects(native)

// Reductions (slice 3). `sum_all` is a global reduction to a scalar `Float`
// (infallible). The per-axis reductions remove the given axis, producing a tensor
// of rank `rank-1` (e.g. shape [2,3,4] reduce axis 1 -> [2,4]); they error if the
// axis is out of range.

// Sum of every element.
pub native fn Tensor.sum_all(t: Tensor) -> Float
    effects(native)

// Sum over one axis, removing it.
pub native fn Tensor.sum_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

// Max over one axis, removing it.
pub native fn Tensor.max_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

// Mean (sum / axis length) over one axis, removing it.
pub native fn Tensor.mean_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

// Index of the max over one axis, removing it. The result tensor holds the
// integer indices stored as `f32` (read them back via `to_f32_slice` and round).
// Ties resolve to the lowest index.
pub native fn Tensor.argmax_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

// Movement ops (slice 4). The tensor stays row-major contiguous: reshape is
// zero-copy (shares the same buffer, new shape); transpose/permute/broadcast_to
// materialize a fresh contiguous buffer (true strided views are future work).

// Reshape to a new shape WITHOUT copying — shares the buffer. Errors if the new
// shape's element count differs from the current one.
pub native fn Tensor.reshape(
    t: Tensor,
    shape: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// 2-D transpose: (r, c) -> (c, r), materializing the transposed buffer. Errors
// if the tensor is not rank-2.
pub native fn Tensor.transpose(t: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// General axis permutation: `axes` must be a permutation of 0..rank. Errors
// otherwise. Materializes the permuted buffer.
pub native fn Tensor.permute(
    t: Tensor,
    axes: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// NumPy-style broadcast to `shape`, materializing the expanded buffer. Each
// source dim (right-aligned) must be 1 or equal to the target dim. Errors if not
// broadcastable.
pub native fn Tensor.broadcast_to(
    t: Tensor,
    shape: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Comparisons (slice: dtype + broadcasting foundation). All broadcast their two
// operands (NumPy right-aligned) and return a Bool tensor (1.0 / 0.0). Error if the
// shapes are not broadcast-compatible.
pub native fn Tensor.cmplt(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.cmpne(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.cmpeq(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Select (tinygrad's `where`): pick `a` where `cond` is nonzero, else `b`. All
// three broadcast together. Output dtype = F32 if either a/b is F32 else I32. Error
// if the three shapes are not mutually broadcast-compatible.
pub native fn Tensor.select(
    cond: Tensor,
    a: Tensor,
    b: Tensor,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Elementwise maximum / minimum with broadcasting. Output dtype = F32 if either
// operand is F32 else I32. Error if not broadcast-compatible.
pub native fn Tensor.maximum(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.minimum(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Casts: reinterpret the dtype tag (with numeric coercion). Infallible.
// cast_f32: values unchanged. cast_i32: each value truncated toward zero.
// cast_bool: 1.0 where x != 0.0, else 0.0.
pub native fn Tensor.cast_f32(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.cast_i32(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.cast_bool(t: Tensor) -> fresh Tensor
    effects(native)

// The tensor's dtype as a numeric code: F32=0, I32=1, Bool=2. Infallible.
pub native fn Tensor.dtype_code(t: Tensor) -> Int
    effects(native)

// movement+gather (ops B). pad/shrink/flip materialize a fresh contiguous buffer
// and preserve the input dtype; gather selects along one axis with a rank-1 index
// tensor and yields the data tensor's dtype.

// Pad each axis with 0.0. `pads` is flat per-axis [before0, after0, before1,
// after1, ...] (length == 2*rank). Output dim = before + old + after. Errors if
// `pads` length != 2*rank or any pad is negative.
pub native fn Tensor.pad(
    t: Tensor,
    pads: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Slice each axis to the half-open range [start, end). `bounds` is flat per-axis
// [start0, end0, start1, end1, ...] (length == 2*rank). Output dim = end - start.
// Errors if `bounds` length != 2*rank or any axis violates 0 <= start <= end <= dim.
pub native fn Tensor.shrink(
    t: Tensor,
    bounds: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Reverse the tensor along each listed axis (shape unchanged). Errors if any axis
// is out of range or duplicated.
pub native fn Tensor.flip(
    t: Tensor,
    axes: List<Int>,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Gather rows along `axis` using a rank-1 integer-valued `indices` tensor: output
// shape = data.shape with dim `axis` replaced by indices.len(); out[..., j, ...] =
// data[..., indices[j], ...]. Output dtype = data's dtype. Only a rank-1 index
// tensor along one axis is supported in this slice. Errors if `axis` is out of
// range, `indices` is not rank-1, or any index is out of bounds.
pub native fn Tensor.gather(
    data: Tensor,
    axis: Int,
    indices: Tensor,
) -> Result<fresh Tensor, TensorError>
// reductions+math (ops C)
// Product / min over one axis, removing it. prod -> F32; min -> input dtype.
// Error on an out-of-range axis.
pub native fn Tensor.prod_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.min_axis(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

// Multi-axis reductions: remove ALL listed axes (must be distinct & in range).
// sum/prod/mean -> F32; max/min -> input dtype. An empty axes list is identity
// (returns a copy). Error on a duplicate or out-of-range axis.
pub native fn Tensor.sum_axes(t: Tensor, axes: List<Int>) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.prod_axes(t: Tensor, axes: List<Int>) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.max_axes(t: Tensor, axes: List<Int>) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.min_axes(t: Tensor, axes: List<Int>) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.mean_axes(t: Tensor, axes: List<Int>) -> Result<fresh Tensor, TensorError>
    effects(native)

// Math unary ops, same shape out, all -> F32. Infallible (no Result).
// reciprocal: 1/x. exp2: 2^x. log2: log2(x). rsqrt: 1/sqrt(x).
pub native fn Tensor.reciprocal(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.exp2(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.log2(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.rsqrt(t: Tensor) -> fresh Tensor
    effects(native)

// Elementwise sine (radians). Output dtype F32.
pub native fn Tensor.sin(t: Tensor) -> fresh Tensor
    effects(native)

// Elementwise truncation toward zero (drops the fractional part, keeps the sign);
// a float-result op that preserves dtype, unlike cast_i32 which retags to I32.
pub native fn Tensor.trunc(t: Tensor) -> fresh Tensor
    effects(native)

// Elementwise power a^b with broadcasting. Output dtype F32. Error if not
// broadcast-compatible.
pub native fn Tensor.pow(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
// bmm+int/bit (ops D)
// Batched matmul: both operands rank >= 2. The last two dims are the matrix
// (m,k) x (k,n) -> (m,n); the leading (batch) dims BROADCAST against each other
// (NumPy semantics). Output dtype F32. Errors on rank < 2, an inner-dim
// mismatch, or non-broadcastable batch dims.
pub native fn Tensor.bmm(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Integer / bitwise ops over the INTEGER VALUES of (I32-dtype) tensors. The f32
// storage holds integers exactly only while |value| <= 2^24; bit ops on larger
// magnitudes are not guaranteed. Each op converts operands to i64, applies the
// operation, and stores the result back as f32 with dtype I32. All binary ops
// broadcast (NumPy right-aligned) and are TOTAL: idiv/modulo by zero return 0 and
// shift counts are masked to 0..63.

// Truncated integer division toward zero (div-by-zero -> 0).
pub native fn Tensor.idiv(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Integer remainder (sign follows the dividend; mod-by-zero -> 0).
pub native fn Tensor.modulo(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Floor division (Python //): rounds toward negative infinity, so the quotient
// sign follows the divisor (distinct from idiv's truncate-toward-zero). Div-by-zero
// -> 0. Broadcasts; output dtype I32.
pub native fn Tensor.floordiv(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Floor modulo (Python %): the remainder sign follows the DIVISOR (distinct from
// modulo, whose sign follows the dividend). Mod-by-zero -> 0. Broadcasts; dtype I32.
pub native fn Tensor.floormod(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Left / right shift on i64 values, shift count masked to 0..63.
pub native fn Tensor.shl(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.shr(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Bitwise AND / OR / XOR on i64 values.
pub native fn Tensor.bit_and(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.bit_or(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.bit_xor(a: Tensor, b: Tensor) -> Result<fresh Tensor, TensorError>
    effects(native)

// Bit-reinterpretation casts (for completeness/index arithmetic). Same 2^24
// exactness caveat. Infallible.
pub native fn Tensor.bitcast_f32_to_i32(t: Tensor) -> fresh Tensor
    effects(native)

pub native fn Tensor.bitcast_i32_to_f32(t: Tensor) -> fresh Tensor
    effects(native)

// rng (slice E)
// Native seeded RNG (threefry2x32-20). Pure and explicit-counter: same
// (shape, seed, counter) always yields identical output in every backend.
// Element `i` (row-major flat index) draws from counter base + i; advance
// `counter` by the element count between draws. `randn` advances at 2x (two
// uniforms per element).
pub native fn Tensor.rand(
    shape: List<Int>,
    seed: Int,
    counter: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.randint(
    shape: List<Int>,
    low: Int,
    high: Int,
    seed: Int,
    counter: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.randn(
    shape: List<Int>,
    seed: Int,
    counter: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// nn (slice F). Forward-only NN primitives. iota/one_hot build index/label
// tensors; softmax/log_softmax are numerically stable (max-subtract /
// log-sum-exp); cross_entropy is the MEAN over the batch of -log_softmax at each
// target CLASS INDEX (targets are class indices, not one-hot) and returns a
// SCALAR tensor (shape []). All produce F32 (iota is I32).
pub native fn Tensor.iota(n: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.one_hot(
    indices: Tensor,
    num_classes: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.softmax(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.log_softmax(t: Tensor, axis: Int) -> Result<fresh Tensor, TensorError>
    effects(native)

pub native fn Tensor.cross_entropy(
    logits: Tensor,
    targets: Tensor,
    axis: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// conv (slice G). Forward-only NCHW 2-D convolution + pooling, output dtype F32.
// `conv2d` is the ML convolution = cross-correlation (NO kernel flip): input
// NCHW [N, Cin, H, W], weight OIHW [Cout, Cin, KH, KW], zero-padded by `padding`
// on both H/W sides, then cross-correlated with `stride`. Output
// [N, Cout, Hout, Wout] where Hout = (H + 2*padding - KH)/stride + 1 (floor),
// similarly Wout. No bias (callers add a broadcast bias); no dilation/groups and
// rectangular strides/kernels are future work. Errors on rank mismatch, Cin
// mismatch, or non-positive output dims.
pub native fn Tensor.conv2d(
    input: Tensor,
    weight: Tensor,
    stride: Int,
    padding: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Square max pooling: NCHW in, kernel x kernel window, given stride, NO padding.
// Output [N, C, (H-kernel)/stride+1, (W-kernel)/stride+1], dtype F32. Errors on
// non-positive output dims. Rectangular kernels/strides are future work.
pub native fn Tensor.max_pool2d(
    input: Tensor,
    kernel: Int,
    stride: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// Square average pooling: same as max_pool2d but averages over each window
// (divides by kernel*kernel). Output dtype F32.
pub native fn Tensor.avg_pool2d(
    input: Tensor,
    kernel: Int,
    stride: Int,
) -> Result<fresh Tensor, TensorError>
    effects(native)

// scatter
// Accumulating inverse of gather (its vjp): scatters the rows of `updates` along
// `axis` into a zero-initialised output whose `axis` dim is `dim_size`,
// accumulating on duplicate indices. `indices` is rank-1 with length
// `updates.shape[axis]`. Output dtype = updates dtype. Errors if indices is not
// rank-1, its length != updates.shape[axis], axis out of range, dim_size <= 0, or
// any index is outside [0, dim_size).
pub native fn Tensor.scatter_add(
    updates: Tensor,
    axis: Int,
    indices: Tensor,
    dim_size: Int,
) -> Result<fresh Tensor, TensorError>

pub fn TensorError.message(error: TensorError) -> fresh String
    effects(pure)
