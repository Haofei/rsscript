features: native, local

// Exercises rayon's read-only native fns through the VM's dynamic loader,
// including structured overflow errors and successful calls after each error.

fn assert_ok_int(result: Result<Int, String>, expected: Int) -> Unit {
    match result {
        Ok(value) => {
            Assert.equal_int(left: value, right: expected)
        }
        Err(_) => {
            Assert.equal_bool(left: false, right: true)
        }
    }
    return Unit
}

fn assert_overflow(result: Result<Int, String>) -> Unit {
    match result {
        Ok(_) => {
            Assert.equal_bool(left: false, right: true)
        }
        Err(error) => {
            Assert.equal_bool(left: error == "RSScript integer overflow", right: true)
        }
    }
    return Unit
}

fn main() -> Unit {
    local values = List<Int>.new()
    List.push<Int>(list: mut values, value: 1)
    List.push<Int>(list: mut values, value: 2)
    List.push<Int>(list: mut values, value: 3)
    List.push<Int>(list: mut values, value: 4)

    assert_ok_int(result: Rayon.sum_int(values: values), expected: 10)
    assert_ok_int(result: Rayon.sum_squares(values: values), expected: 30)

    local sum_overflow = List<Int>.new()
    List.push<Int>(list: mut sum_overflow, value: 9223372036854775807)
    List.push<Int>(list: mut sum_overflow, value: 1)
    assert_overflow(result: Rayon.sum_int(values: sum_overflow))
    assert_ok_int(result: Rayon.sum_int(values: values), expected: 10)

    local square_overflow = List<Int>.new()
    List.push<Int>(list: mut square_overflow, value: 3037000500)
    assert_overflow(result: Rayon.sum_squares(values: square_overflow))
    assert_ok_int(result: Rayon.sum_squares(values: values), expected: 30)

    return Unit
}
