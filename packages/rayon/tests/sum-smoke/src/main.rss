features: native, local

// Exercises rayon's read-only native fns through the VM's dynamic loader:
// `List<Int>` arguments and an `Int` return crossing the generated shim.

fn main() -> Unit {
    local values = List<Int>.new()
    List.push<Int>(list: mut values, value: 1)
    List.push<Int>(list: mut values, value: 2)
    List.push<Int>(list: mut values, value: 3)
    List.push<Int>(list: mut values, value: 4)

    let sum = Rayon.sum_int(values: values)
    Assert.equal_int(left: sum, right: 10)

    let squares = Rayon.sum_squares(values: values)
    Assert.equal_int(left: squares, right: 30)

    return Unit
}
