struct ToolRequest {
    id: String
    name: String
    arguments: String
}

struct ToolOutput {
    content: String
    is_error: Bool
}

struct ToolAction {
    response: Option<ToolOutput>
    finish: Bool
    abort: Bool
    final_answer: String
}

pub fn ToolRequest.new(id: String, name: String, arguments: String) -> fresh ToolRequest

pub fn ToolOutput.respond(content: String) -> fresh ToolOutput

pub fn ToolOutput.error(content: String) -> fresh ToolOutput

pub fn ToolAction.respond(content: String) -> fresh ToolAction

pub fn ToolAction.error(content: String) -> fresh ToolAction

pub fn ToolAction.finish(answer: String) -> fresh ToolAction
