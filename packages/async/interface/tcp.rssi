features: async, native, local

// TCP client sockets are provider-backed async IO. The public surface is
// deliberately narrow: connect, byte read/write, and explicit shutdown.

struct TcpError
struct TcpStream

pub async native fn Tcp.connect(
    host: String,
    port: Int,
) -> Result<fresh TcpStream, TcpError>
    effects(native)

pub async native fn TcpStream.read(
    stream: TcpStream,
    max_bytes: Int,
) -> Result<fresh Bytes, TcpError>
    effects(native)

pub async native fn TcpStream.write(
    stream: TcpStream,
    data: Bytes,
) -> Result<Int, TcpError>
    effects(native)

pub async native fn TcpStream.write_all(
    stream: TcpStream,
    data: Bytes,
) -> Result<Unit, TcpError>
    effects(native)

pub async native fn TcpStream.shutdown(stream: TcpStream) -> Result<Unit, TcpError>
    effects(native)

pub fn TcpError.message(error: TcpError) -> fresh String
    effects(pure)
