
// TCP client sockets are provider-backed async IO. The public surface is
// deliberately narrow: connect, byte read/write, and explicit shutdown.

struct TcpError
struct TcpStream

pub async fn Tcp.connect(
    host: String,
    port: Int,
) -> Result<fresh TcpStream, TcpError>


pub async fn TcpStream.read(
    stream: TcpStream,
    max_bytes: Int,
) -> Result<fresh Bytes, TcpError>


pub async fn TcpStream.write(
    stream: TcpStream,
    data: Bytes,
) -> Result<Int, TcpError>


pub async fn TcpStream.write_all(
    stream: TcpStream,
    data: Bytes,
) -> Result<Unit, TcpError>


pub async fn TcpStream.shutdown(stream: TcpStream) -> Result<Unit, TcpError>


pub fn TcpError.message(error: TcpError) -> fresh String
