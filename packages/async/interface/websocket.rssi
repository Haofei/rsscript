
// WebSocket client IO is provider-backed. Text and bytes are explicit separate
// operations so review can see which frame type a call expects.

struct WebSocket
struct WebSocketError

pub async fn WebSocket.connect(url: Url) -> Result<fresh WebSocket, WebSocketError>


pub async fn WebSocket.send_text(
    socket: WebSocket,
    text: String,
) -> Result<Unit, WebSocketError>


pub async fn WebSocket.send_bytes(
    socket: WebSocket,
    bytes: Bytes,
) -> Result<Unit, WebSocketError>


pub async fn WebSocket.recv_text(socket: WebSocket) -> Result<Option<String>, WebSocketError>


pub async fn WebSocket.recv_bytes(socket: WebSocket) -> Result<Option<Bytes>, WebSocketError>


pub async fn WebSocket.close(socket: WebSocket) -> Result<Unit, WebSocketError>


pub fn WebSocketError.message(error: WebSocketError) -> fresh String
