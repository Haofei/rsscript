
// Async process IO runs blocking OS process work through the async runtime
// provider. The RSScript surface stays explicit: command, args, timeout, and
// result type are visible in the signature.

pub async fn Process.run_async(
    command: String,
    args: List<String>,
) -> Result<fresh ProcessOutput, String>


pub async fn Process.run_timeout_async(
    command: String,
    args: List<String>,
    timeout_ms: Int,
) -> Result<fresh ProcessOutput, String>


pub async fn Process.run_request_async(
    request: ProcessRequest,
) -> Result<fresh ProcessOutput, String>


pub async fn Process.run_request_cancellable_async(
    request: ProcessRequest,
    token: CancellationToken,
) -> Result<fresh ProcessOutput, String>


pub fn Process.stream(
    request: ProcessRequest,
) -> Result<fresh Stream<ProcessEvent>, String>


pub async fn Process.run_stdout_async(
    command: String,
    args: List<String>,
) -> Result<String, String>


pub async fn Process.run_stdout_timeout_async(
    command: String,
    args: List<String>,
    timeout_ms: Int,
) -> Result<String, String>


pub async fn Process.run_many_stdout_async(
    command: String,
    args: List<String>,
    appended_args: List<String>,
    jobs: Int,
) -> Result<List<String>, String>


pub async fn Process.run_many_stdout_timeout_async(
    command: String,
    args: List<String>,
    appended_args: List<String>,
    jobs: Int,
    timeout_ms: Int,
) -> Result<List<String>, String>
