features: async, native, local

// Async file IO belongs to the async provider surface. It reuses core File,
// Path, Bytes, and FileError types but does not make core imply async.

pub async native fn File.read_all_async(path: Path) -> Result<fresh Bytes, FileError>
    effects(native)

pub async native fn File.read_all_string_async(path: Path) -> Result<String, FileError>
    effects(native)

pub async native fn File.write_async(path: Path, data: Bytes) -> Result<Unit, FileError>
    effects(native)

pub async native fn File.write_string_async(path: Path, text: String) -> Result<Unit, FileError>
    effects(native)

pub fn File.bytes_stream(
    path: Path,
    chunk_size: Int,
) -> Result<fresh Stream<Bytes>, ChannelError>
    effects(native)
