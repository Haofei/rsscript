features: async, native, local

// Async HTTP IO belongs to the async provider surface. Core keeps request and
// response data types plus synchronous helpers; executable async calls require
// an async provider.

pub async native fn Http.send_async(request: take HttpRequest) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.get_async(url: read Url) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.get_timeout_async(
    url: read Url,
    timeout_ms: Int,
) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.get_retry_async(
    url: read Url,
    timeout_ms: Int,
    attempts: Int,
    backoff_ms: Int,
) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.post_json_async(url: read Url, body: read String) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.post_json_timeout_async(
    url: read Url,
    body: read String,
    timeout_ms: Int,
) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.post_json_retry_async(
    url: read Url,
    body: read String,
    timeout_ms: Int,
    attempts: Int,
    backoff_ms: Int,
) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.post_json_bearer_retry_async(
    url: read Url,
    body: read String,
    token: read String,
    timeout_ms: Int,
    attempts: Int,
    backoff_ms: Int,
) -> Result<fresh HttpResponse, HttpError>
    effects(native)

pub async native fn Http.post_form_async(url: read Url, body: read String) -> Result<fresh HttpResponse, HttpError>
    effects(native)
