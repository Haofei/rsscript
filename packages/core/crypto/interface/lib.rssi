features: native

native fn Sha256.hex_string(value: String) -> fresh String
    effects(native)

native fn Sha256.hex_bytes(value: Bytes) -> fresh String
    effects(native)

native fn HmacSha256.hex(key: String, message: String) -> fresh String
    effects(native)

native fn ConstantTime.equal(left: String, right: String) -> Bool
    effects(native)
