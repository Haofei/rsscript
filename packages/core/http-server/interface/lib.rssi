features: native

// Demo-only blocking static-route HTTP server. It is not a production server.
// Each `paths[i]` is answered with
// `bodies[i]` (HTTP 200, `text/plain`); any other path returns 404, and a
// non-GET request to a known path returns 405. `paths` and `bodies` must have
// equal length, and paths must be unique. The call binds `address` and serves
// requests until a fatal error, so a successful bind never returns `Ok`.
native fn HttpServer.serve_static(
    address: String,
    paths: List<String>,
    bodies: List<String>,
) -> Result<Unit, String>
    effects(native)
