struct ChatMessage {
    value: JsonValue
}

pub fn ChatMessage.system(content: String) -> fresh ChatMessage

pub fn ChatMessage.user(content: String) -> fresh ChatMessage

pub fn ChatMessage.assistant(content: String) -> fresh ChatMessage

pub fn ChatMessage.tool(request: ToolRequest, output: ToolOutput) -> fresh ChatMessage

pub fn ChatMessage.value(message: ChatMessage) -> fresh JsonValue

pub fn ChatRequest.openai_compatible(
    model: String,
    messages: List<ChatMessage>,
    tools: JsonValue,
) -> fresh JsonValue

pub fn ChatResponse.content(response: String) -> fresh String

pub fn ChatResponse.usage(response: String) -> fresh TokenUsage

pub fn ChatResponse.assistant_message(response: String) -> fresh ChatMessage

pub fn ChatResponse.tool_requests(message: ChatMessage) -> List<ToolRequest>
