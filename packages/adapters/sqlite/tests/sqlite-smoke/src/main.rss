features: native, local

// Exercises the sqlite adapter through the VM's dynamic native loader: the
// `Path` parameter type and Result/List<String> returns all cross the generated
// shim. (sqlite is a direct native package, so this consumer uses `features:
// native` and calls `Sqlite.*` directly.)

fn db_path() -> fresh Path {
    let temp = Env.temp_dir()

    return Path.join(base: temp, child: "rss-sqlite-smoke.db")
}

fn main() -> Result<Unit, String> {
    let path = db_path()
    Sqlite.execute(path: path, sql: "drop table if exists item")?
    Sqlite.execute(path: path, sql: "create table item(name text)")?
    Sqlite.execute(path: path, sql: "insert into item values ('a'), ('b')")?

    let names = Sqlite.query_strings(
        path: path,
        sql: "select name from item order by name",
    )?
    Assert.equal_int(left: List.len(list: names), right: 2)

    return Ok(Unit)
}
