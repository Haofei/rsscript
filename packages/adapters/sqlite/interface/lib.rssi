features: native

// Query results are capped at 10,000 rows and 16 MiB of returned UTF-8 data by
// default. RSS_SQLITE_MAX_RESULT_ROWS and RSS_SQLITE_MAX_RESULT_BYTES can set
// positive per-process overrides. Connections are reused in a bounded LRU cache
// (32 paths by default) and wait up to 5 seconds for SQLite locks. Override these
// with RSS_SQLITE_MAX_CACHED_CONNECTIONS and RSS_SQLITE_BUSY_TIMEOUT_MS.
// Parameters are positional strings; use SQLite placeholders (?1, ?2, ...).
// `execute` accepts transaction batches such as `BEGIN; ...; COMMIT;`.
native fn Sqlite.execute(path: Path, sql: String) -> Result<Unit, String>
    effects(native)

native fn Sqlite.execute_params(
    path: Path,
    sql: String,
    params: List<String>,
) -> Result<Unit, String>
    effects(native)

native fn Sqlite.query_strings(path: Path, sql: String) -> Result<fresh List<String>, String>
    effects(native)

native fn Sqlite.query_strings_params(
    path: Path,
    sql: String,
    params: List<String>,
) -> Result<fresh List<String>, String>
    effects(native)

native fn Sqlite.query_one_string(path: Path, sql: String) -> Result<Option<String>, String>
    effects(native)

native fn Sqlite.query_one_string_params(
    path: Path,
    sql: String,
    params: List<String>,
) -> Result<Option<String>, String>
    effects(native)
