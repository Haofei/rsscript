features: native, local

fn sqlite_url() -> fresh String {
    let temp = Env.temp_dir()
    let path = Path.join(base: temp, child: "rss-sqlx-ffi-smoke.db")
    let path_string = Path.to_string(path: path)
    let prefixed = String.concat(left: "sqlite://", right: path_string)

    return String.concat(left: prefixed, right: "?mode=rwc")
}

fn main() -> Result<Unit, String> {
    let url = sqlite_url()
    SqlxFfi.execute(url: url, sql: "drop table if exists item")?
    SqlxFfi.execute(url: url, sql: "create table item(name text)")?

    let params = List.new<String>()
    List.push<String>(list: mut params, value: "a quote: ' and ?")
    SqlxFfi.execute_params(
        url: url,
        sql: "insert into item(name) values (?)",
        params: params,
    )?

    let value = SqlxFfi.query_one_string_params(
        url: url,
        sql: "select name from item where name = ?",
        params: params,
    )?
    match value {
        Some(name) => {
            Assert.equal(left: name, right: "a quote: ' and ?")
        }
        None => {
            return Err("expected parameterized SQLx query to return one row")
        }
    }

    SqlxFfi.close(url: url)?
    SqlxFfi.close_all()?
    return Ok(Unit)
}
