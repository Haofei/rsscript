// Public, plain-RSS API for the sqlx adapter. Import this package and call
// `Sqlx.*` directly from an ordinary RSS app -- no `features: native` and no
// native code at the call site. The single `native` boundary lives behind these
// wrappers in `interface/lib.rssi` (the `SqlxFfi.*` bindings).
//
// `url` is a sqlx connection string whose scheme selects the backend, e.g.
// `sqlite:///tmp/app.db?mode=rwc` or `postgres://user:pw@host/db`. Each call
// opens (or reuses, via the pooled native layer) a connection, runs the SQL, and
// returns. Queries read the first column of each row as text.

// Run one or more SQL statements that produce no rows (DDL, INSERT, ...).
pub fn Sqlx.execute(url: String, sql: String) -> Result<Unit, String> {
    return SqlxFfi.execute(url: url, sql: sql)
}

// Run a query and collect the first column of every row as a list of strings.
pub fn Sqlx.query_strings(url: String, sql: String) -> Result<fresh List<String>, String> {
    return SqlxFfi.query_strings(url: url, sql: sql)
}

// Run a query and return the first column of the first row, if any.
pub fn Sqlx.query_one_string(url: String, sql: String) -> Result<Option<String>, String> {
    return SqlxFfi.query_one_string(url: url, sql: sql)
}
