// Drive the plain-RSS facade end to end. The same checks run against SQLite
// (always) and Postgres (when RSS_SQLX_TEST_POSTGRES_URL is set).
fn check_backend(url: String, placeholder: String) -> Result<Unit, String> {
    Sqlx.execute(url: url, sql: "drop table if exists rss_sqlx_item")?
    Sqlx.execute(url: url, sql: "create table rss_sqlx_item(name text)")?
    Sqlx.execute(url: url, sql: "insert into rss_sqlx_item values ('a'), ('b')")?

    let names = Sqlx.query_strings(
        url: url,
        sql: "select name from rss_sqlx_item order by name",
    )?
    Assert.equal_int(left: List.len(list: names), right: 2)
    let first = List.get(list: names, index: 0)
    let second = List.get(list: names, index: 1)
    Assert.equal(left: first, right: "a")
    Assert.equal(left: second, right: "b")

    match Sqlx.query_one_string(
        url: url,
        sql: "select name from rss_sqlx_item order by name",
    )? {
        Some(one) => {
            Assert.equal(left: one, right: "a")
        }
        None => {
            return Err("expected at least one row from sqlx query_one_string")
        }
    }

    let inserted = "a quote: ' and ?"
    let insert_params = List.new<String>()
    List.push<String>(list: mut insert_params, value: inserted)
    let insert_sql = String.concat(
        left: "insert into rss_sqlx_item(name) values (",
        right: String.concat(left: placeholder, right: ")"),
    )
    Sqlx.execute_params(url: url, sql: insert_sql, params: insert_params)?

    let query_params = List.new<String>()
    List.push<String>(list: mut query_params, value: inserted)
    let query_sql = String.concat(
        left: "select name from rss_sqlx_item where name = ",
        right: placeholder,
    )
    let bound_names = Sqlx.query_strings_params(
        url: url,
        sql: query_sql,
        params: query_params,
    )?
    Assert.equal_int(left: List.len(list: bound_names), right: 1)
    Assert.equal(left: List.get(list: bound_names, index: 0), right: inserted)

    let one_params = List.new<String>()
    List.push<String>(list: mut one_params, value: inserted)
    match Sqlx.query_one_string_params(
        url: url,
        sql: query_sql,
        params: one_params,
    )? {
        Some(value) => {
            Assert.equal(left: value, right: inserted)
        }
        None => {
            return Err("expected parameterized sqlx query to return one row")
        }
    }

    Sqlx.close(url: url)?
    let reopened = Sqlx.query_one_string(
        url: url,
        sql: "select name from rss_sqlx_item order by name",
    )?
    match reopened {
        Some(value) => {
            Assert.equal(left: value, right: "a")
        }
        None => {
            return Err("expected sqlx query to reopen a closed pool")
        }
    }

    return Ok(Unit)
}

fn sqlite_url() -> fresh String {
    let temp = Env.temp_dir()
    let db_path = Path.join(base: temp, child: "rss-sqlx-smoke.db")
    let db_string = Path.to_string(path: db_path)
    let prefixed = String.concat(left: "sqlite://", right: db_string)

    return String.concat(left: prefixed, right: "?mode=rwc")
}

fn main() -> Result<Unit, String> {
    let url = sqlite_url()
    check_backend(url: url, placeholder: "?")?
    Log.write(message: "sqlx sqlite backend ok")

    match Env.get(name: "RSS_SQLX_TEST_POSTGRES_URL") {
        Some(pg_url) => {
            check_backend(url: pg_url, placeholder: "$1")?
            Log.write(message: "sqlx postgres backend ok")
        }
        None => {
            Log.write(message: "skipping sqlx postgres backend: RSS_SQLX_TEST_POSTGRES_URL not set")
        }
    }

    Sqlx.close_all()?
    return Ok(Unit)
}
