// Drive the sqlx adapter end to end: create a table, insert rows, and read
// them back through `query_strings` / `query_one_string`. The same checks run
// against SQLite (always) and Postgres (only when RSS_SQLX_TEST_POSTGRES_URL is
// set), so the pooled native bindings are exercised over both backends.
fn check_backend(url: String) -> Result<Unit, String> {
    Sqlx.execute(url: url, sql: "drop table if exists rss_sqlx_item")?
    Sqlx.execute(url: url, sql: "create table rss_sqlx_item(name text)")?
    Sqlx.execute(url: url, sql: "insert into rss_sqlx_item values ('a'), ('b')")?

    let names = Sqlx.query_strings(
        url: url,
        sql: "select name from rss_sqlx_item order by name",
    )?
    Assert.equal_int(left: List.len(list: names), right: 2)
    let first = List.get(list: names, index: 0)
    let second = List.get(list: names, index: 1)
    Assert.equal(left: first, right: "a")
    Assert.equal(left: second, right: "b")

    match Sqlx.query_one_string(
        url: url,
        sql: "select name from rss_sqlx_item order by name",
    )? {
        Some(one) => {
            Assert.equal(left: one, right: "a")
        }
        None => {
            return Err("expected at least one row from sqlx query_one_string")
        }
    }

    return Ok(Unit)
}

fn sqlite_url() -> fresh String {
    let temp = Env.temp_dir()
    let db_path = Path.join(base: temp, child: "rss-sqlx-smoke.db")
    let db_string = Path.to_string(path: db_path)
    let prefixed = String.concat(left: "sqlite://", right: db_string)

    return String.concat(left: prefixed, right: "?mode=rwc")
}

fn main() -> Result<Unit, String> {
    let url = sqlite_url()
    check_backend(url)?
    Log.write(message: "sqlx sqlite backend ok")

    match Env.get(name: "RSS_SQLX_TEST_POSTGRES_URL") {
        Some(pg_url) => {
            check_backend(url: pg_url)?
            Log.write(message: "sqlx postgres backend ok")
        }
        None => {
            Log.write(message: "skipping sqlx postgres backend: RSS_SQLX_TEST_POSTGRES_URL not set")
        }
    }

    return Ok(Unit)
}
