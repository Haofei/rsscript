// Public, plain-RSS API for the sqlx adapter. Import this package and call
// `Sqlx.*` from an ordinary RSS app -- no `features: native` and no native code
// at the call site. Implemented in `src/lib.rss` as thin wrappers over the
// `rss-sqlx-ffi` native bindings.
//
// `url` is a sqlx connection string whose scheme selects the backend, e.g.
// `sqlite:///tmp/app.db?mode=rwc` or `postgres://user:pw@host/db`. Queries read
// the first column of each row as text. Parameter placeholders follow the
// backend (`?` for SQLite and `$1`, `$2`, ... for Postgres); all values are
// bound as strings.
pub fn Sqlx.execute(url: String, sql: String) -> Result<Unit, String>

pub fn Sqlx.execute_params(
    url: String,
    sql: String,
    params: List<String>,
) -> Result<Unit, String>

pub fn Sqlx.query_strings(url: String, sql: String) -> Result<fresh List<String>, String>

pub fn Sqlx.query_strings_params(
    url: String,
    sql: String,
    params: List<String>,
) -> Result<fresh List<String>, String>

pub fn Sqlx.query_one_string(url: String, sql: String) -> Result<Option<String>, String>

pub fn Sqlx.query_one_string_params(
    url: String,
    sql: String,
    params: List<String>,
) -> Result<Option<String>, String>

// Close and evict the cached pool for `url`. A later operation recreates it.
pub fn Sqlx.close(url: String) -> Result<Unit, String>

// Close and evict every cached SQLx pool in this process.
pub fn Sqlx.close_all() -> Result<Unit, String>
