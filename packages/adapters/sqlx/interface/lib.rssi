// Public, plain-RSS API for the sqlx adapter. Import this package and call
// `Sqlx.*` from an ordinary RSS app -- no `features: native` and no native code
// at the call site. Implemented in `src/lib.rss` as thin wrappers over the
// `rss-sqlx-ffi` native bindings.
//
// `url` is a sqlx connection string whose scheme selects the backend, e.g.
// `sqlite:///tmp/app.db?mode=rwc` or `postgres://user:pw@host/db`. Queries read
// the first column of each row as text.
pub fn Sqlx.execute(url: String, sql: String) -> Result<Unit, String>

pub fn Sqlx.query_strings(url: String, sql: String) -> Result<fresh List<String>, String>

pub fn Sqlx.query_one_string(url: String, sql: String) -> Result<Option<String>, String>
