fn package_publish_check_facts(root: Path) -> Result<fresh PublishCheckFacts, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package_name = manifest_package_string_or_empty(manifest, field: "name")
    let version = manifest_package_string_or_empty(manifest, field: "version")
    let edition = manifest_package_string_or_empty(manifest, field: "edition")
    let source_roots = manifest_array_strings_or_empty(
        manifest,
        section: "sources",
        field: "paths",
    )
    let interface_summary = package_interface_summary(root)?
    let source_files = count_existing_root_files_with_suffix(
        root,
        children: source_roots,
        suffix: ".rss",
    )?
    let missing_name = bool_count(value: String.len(value: package_name) == 0)
    let missing_version = bool_count(value: String.len(value: version) == 0)
    let missing_edition = bool_count(value: String.len(value: edition) == 0)
    let missing_interfaces = bool_count(value: interface_summary.interface_files == 0)
    let missing_sources = bool_count(value: source_files == 0)
    let errors = missing_name + missing_version + missing_edition + missing_interfaces + missing_sources + interface_summary.empty_files + interface_summary.non_public_files

    return PublishCheckFacts(
        package_name,
        version,
        interface_files: interface_summary.interface_files,
        source_files: source_files,
        public_apis: interface_summary.public_apis,
        ok: errors == 0,
        errors: errors,
    )
}

fn run_metadata(root: Path, output: Path) -> Result<Unit, String> {
    let facts = package_manifest_facts(root)?
    let text = package_metadata_json(facts)
    write_text_result(path: output, text)?
    let message = String.concat(
        left: "rss package manager metadata ",
        right: facts.package_name,
    )
    Log.write(message)

    return Ok(Unit)
}

fn run_vendor(root: Path, vendor: Path) -> Result<Unit, String> {
    create_dir_result(path: vendor)?
    let manifest = package_manifest_facts(root)?
    let files = list_files_result(path: root)?
    let facts = copy_package_tree(source: root, vendor, files)?
    let metadata_path = Path.join(base: vendor, child: "rss-vendor.json")
    let metadata = vendor_metadata_json(manifest, facts)
    write_text_result(path: metadata_path, text: metadata)?

    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "rss package manager vendor copied=")
    let copied = String.from_int(value: facts.copied_files)
    StringBuilder.push(builder: mut builder, value: copied)
    StringBuilder.push(builder: mut builder, value: " interfaces=")
    let interfaces = String.from_int(value: facts.interface_files)
    StringBuilder.push(builder: mut builder, value: interfaces)
    StringBuilder.push(builder: mut builder, value: " sources=")
    let sources = String.from_int(value: facts.source_files)
    StringBuilder.push(builder: mut builder, value: sources)
