fn add_review_line(facts: PackageReviewFacts, line: String) -> fresh PackageReviewFacts {
    let trimmed = String.trim(value: line)
    let is_type = String.starts_with(value: trimmed, prefix: "struct ")
    let is_public_type = String.starts_with(value: trimmed, prefix: "pub struct ")
    let is_fn = String.starts_with(value: trimmed, prefix: "pub fn ")
    let is_native_fn = String.starts_with(value: trimmed, prefix: "pub native fn ")
    let is_api = is_fn || is_native_fn
    let has_mut = String.contains(value: trimmed, needle: " mut ")
    let has_retains = String.contains(value: trimmed, needle: "effects(retains")
    let has_resource_pool = String.contains(value: trimmed, needle: "ResourcePool")
    let has_resource_name = String.contains(value: trimmed, needle: "resource")
    let has_resource = has_resource_pool || has_resource_name
    let has_fresh = String.contains(value: trimmed, needle: "fresh ")
    let has_native = is_native_fn || String.contains(value: trimmed, needle: "effects(native")
    let has_parallel = String.contains(value: trimmed, needle: "parallel")
    let has_unsafe = String.contains(value: trimmed, needle: "unsafe")
    let has_unknown = String.contains(value: trimmed, needle: "unknown")

    return PackageReviewFacts(
        package_name: facts.package_name,
        public_types: facts.public_types + bool_count(value: is_type || is_public_type),
        public_apis: facts.public_apis + bool_count(value: is_api),
        mutating_apis: facts.mutating_apis + bool_count(value: is_api && has_mut),
        retaining_apis: facts.retaining_apis + bool_count(value: is_api && has_retains),
        resource_apis: facts.resource_apis + bool_count(value: is_api && has_resource),
        fresh_apis: facts.fresh_apis + bool_count(value: is_api && has_fresh),
        native_apis: facts.native_apis + bool_count(value: is_api && has_native),
        parallel_apis: facts.parallel_apis + bool_count(value: is_api && has_parallel),
        unsafe_apis: facts.unsafe_apis + bool_count(value: is_api && has_unsafe),
        unknown_apis: facts.unknown_apis + bool_count(value: is_api && has_unknown),
    )
}

fn review_interface_file(
    root: Path,
    child: String,
    file: String,
    facts: PackageReviewFacts,
) -> Result<fresh PackageReviewFacts, String> {
    if String.ends_with(value: file, suffix: ".rssi") == false {
        return Ok(copy_package_review_facts(facts))
    }

    let directory = Path.join(base: root, child)
    let path = Path.join(base: directory, child: file)
    let text = read_text_result(path)?
    let lines = String.lines(value: text)

    return List.fold<String, PackageReviewFacts>(
        list: lines,
        initial: facts,
        folder: |state, line| {
            return add_review_line(facts: state, line)
        },
    )
}

fn review_interface_root(
    root: Path,
    child: String,
    facts: PackageReviewFacts,
) -> Result<fresh PackageReviewFacts, String> {
    let directory = Path.join(base: root, child)
    require_directory(path: directory, label: child)?
    let files = list_files_result(path: directory)?

    return List.try_fold<String, PackageReviewFacts, String>(
        list: files,
        initial: facts,
        folder: |state, file| {
            return review_interface_file(
                root,
                child,
                file,
                facts: state,
            )
        },
    )
}

fn package_review_facts(root: Path) -> Result<fresh PackageReviewFacts, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package = json_field_result(value: manifest, name: "package")?
    let package_name = json_field_string_result(value: package, name: "name")?
    let interface_roots = manifest_interface_roots(manifest)?

    return List.try_fold<String, PackageReviewFacts, String>(
        list: interface_roots,
        initial: empty_package_review_facts(package_name),
        folder: |facts, child| {
            return review_interface_root(root, child, facts)
        },
    )
}

fn manifest_dependencies(manifest: JsonValue) -> Result<Option<JsonValue>, String> {
    match Json.field(value: manifest, name: "dependencies") {
        Ok(dependencies) => {
            return Ok(Some(dependencies))
        }
        Err(_) => {
            return Ok(None)
        }
    }
}

fn add_dependency_tree(
    root: Path,
    dependencies: JsonValue,
    facts: PackageTreeFacts,
    name: String,
) -> Result<fresh PackageTreeFacts, String> {
    let spec = json_field_result(value: dependencies, name)?

    if Json.is_object(value: spec) {
        match Json.field_string(value: spec, name: "path") {
            Ok(path) => {
                let dependency_root = Path.join(base: root, child: path)
                let dependency_facts = package_tree_facts(root: dependency_root)?

                return add_path_dependency(
                    facts,
                    dependency: dependency_facts,
                )
            }
            Err(_) => {
                return add_unresolved_dependency(facts)
            }
        }
    }

    return add_unresolved_dependency(facts)
}

fn add_dependencies_tree(
    root: Path,
    dependencies: JsonValue,
    facts: PackageTreeFacts,
) -> Result<fresh PackageTreeFacts, String> {
    let names = json_object_keys_result(value: dependencies)?

    return List.try_fold<String, PackageTreeFacts, String>(
        list: names,
        initial: facts,
        folder: |state, name| {
            return add_dependency_tree(
                root,
                dependencies,
                facts: state,
                name,
            )
        },
    )
}

fn package_tree_facts(root: Path) -> Result<fresh PackageTreeFacts, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package = json_field_result(value: manifest, name: "package")?
    let package_name = json_field_string_result(value: package, name: "name")?
    local facts = empty_package_tree_facts(package_name)

    match manifest_dependencies(manifest)? {
        Some(dependencies) => {
            return add_dependencies_tree(
                root,
                dependencies,
                facts,
            )
        }
        None => {
            return Ok(facts)
        }
    }
}

fn empty_vendor_facts() -> fresh VendorCopyFacts {
    return VendorCopyFacts(
        copied_files: 0,
        interface_files: 0,
        source_files: 0,
        manifest_files: 0,
    )
}

fn bool_count(value: Bool) -> Int {
    if value {
        return 1
    }

    return 0
}

fn add_file_facts(facts: VendorCopyFacts, relative_path: String) -> fresh VendorCopyFacts {
    let is_interface = String.ends_with(value: relative_path, suffix: ".rssi")
    let is_source = String.ends_with(value: relative_path, suffix: ".rss")
    let is_manifest = relative_path == "rsspkg.toml"

    return VendorCopyFacts(
        copied_files: facts.copied_files + 1,
        interface_files: facts.interface_files + bool_count(value: is_interface),
        source_files: facts.source_files + bool_count(value: is_source),
        manifest_files: facts.manifest_files + bool_count(value: is_manifest),
    )
}

fn copy_relative_file(
    source: Path,
    vendor: Path,
    facts: VendorCopyFacts,
    relative_path: String,
) -> Result<fresh VendorCopyFacts, String> {
    let input = Path.join(base: source, child: relative_path)
    let output = Path.join(base: vendor, child: relative_path)
    let contents = read_text_result(path: input)?
    write_text_result(path: output, text: contents)?

    return add_file_facts(facts, relative_path)
}

fn copy_package_tree(
    source: Path,
    vendor: Path,
    files: List<String>,
) -> Result<fresh VendorCopyFacts, String> {
    return List.try_fold<String, VendorCopyFacts, String>(
        list: files,
        initial: empty_vendor_facts(),
        folder: |facts, relative_path| {
            return copy_relative_file(
                source,
                vendor,
                facts,
                relative_path,
            )
        },
    )
}

