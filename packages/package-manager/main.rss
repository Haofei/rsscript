fn package_review_risk(facts: PackageReviewFacts) -> String {
    if facts.unknown_apis > 0 {
        return "unknown"
    }

    if facts.unsafe_apis > 0 {
        return "unsafe"
    }

    if facts.native_apis > 0 {
        return "native"
    }

    if facts.resource_apis > 0 {
        return "resource"
    }

    if facts.retaining_apis > 0 {
        return "elevated"
    }

    if facts.mutating_apis > 0 {
        return "elevated"
    }

    return "low"
}

