pub fn main() -> Result<Unit, String> {
    let command = Args.get_or_default(index: 0, default: "metadata")
    let root = root_path()
    let output = output_path()

    if command == "metadata" {
        return run_metadata(root, output)
    }

    if command == "vendor" {
        return run_vendor(root, vendor: output)
    }

    if command == "check" {
        return run_check(root, output)
    }

    if command == "tree" {
        return run_tree(root, output)
    }

    if command == "review" {
        return run_review(root, output)
    }

    if command == "lock" {
        return run_lock(root, output)
    }

    if command == "diff" {
        let other = Args.get_or_default(index: 3, default: ".")
        let other_path = Path.from_string(value: other)
        return run_diff(root, other: other_path, output)
    }

    if command == "publish" {
        return run_publish(root, output)
    }

    let message = String.concat(left: "unknown package command: ", right: command)
    return Err(message)
}
