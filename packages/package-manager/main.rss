fn run_lock(root: Path, output: Path) -> Result<Unit, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package = json_field_result(value: manifest, name: "package")?
    let package_name = json_field_string_result(value: package, name: "name")?
    let version = json_field_string_result(value: package, name: "version")?
    let edition = json_field_string_result(value: package, name: "edition")?
    let entries = package_lock_entries(root)?
    let facts = LockFacts(
        package_name,
        version,
        edition,
        entries: List.len(list: entries),
    )
    let text = package_lock_json(facts, entries)
    write_text_result(path: output, text)?

    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "rss package manager lock ")
