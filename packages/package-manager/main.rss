fn json_bool_text(value: Bool) -> String {
    if value {
        return "true"
    }

    return "false"
}

fn copy_string(value: String) -> fresh String {
    return String.concat(left: "", right: value)
}

fn json_field_string_or_empty(value: JsonValue, name: String) -> fresh String {
    match Json.field_string(value, name) {
        Ok(text) => {
            return copy_string(value: text)
        }
        Err(_) => {
            return copy_string(value: "")
        }
    }
}

fn manifest_package_string_or_empty(
    manifest: JsonValue,
    field: String,
) -> fresh String {
    match Json.field(value: manifest, name: "package") {
        Ok(package) => {
            let text = json_field_string_or_empty(value: package, name: field)
            return copy_string(value: text)
        }
        Err(_) => {
            return copy_string(value: "")
        }
    }
}

fn manifest_array_strings_or_empty(
    manifest: JsonValue,
    section: String,
    field: String,
) -> fresh List<String> {
    match Json.field(value: manifest, name: section) {
        Ok(section_value) => {
            match Json.field(value: section_value, name: field) {
                Ok(items_value) => {
                    match Json.array_strings(value: items_value) {
                        Ok(items) => {
                            return items
                        }
                        Err(_) => {
                            return List<String>.new()
                        }
                    }
                }
                Err(_) => {
                    return List<String>.new()
                }
            }
        }
        Err(_) => {
            return List<String>.new()
        }
    }
}

fn public_interface_line_count(line: String) -> Int {
    let trimmed = String.trim(value: line)
    let is_public_fn = String.starts_with(value: trimmed, prefix: "pub fn ")
    let is_public_native_fn = String.starts_with(
        value: trimmed,
        prefix: "pub native fn ",
    )
    let is_public_struct = String.starts_with(value: trimmed, prefix: "pub struct ")

    return bool_count(value: is_public_fn || is_public_native_fn || is_public_struct)
}

fn empty_interface_summary() -> fresh InterfaceSummary {
    return InterfaceSummary(
        interface_files: 0,
        interface_lines: 0,
        public_apis: 0,
        empty_files: 0,
        non_public_files: 0,
    )
}

fn copy_interface_summary(summary: InterfaceSummary) -> fresh InterfaceSummary {
    return InterfaceSummary(
        interface_files: summary.interface_files,
        interface_lines: summary.interface_lines,
        public_apis: summary.public_apis,
        empty_files: summary.empty_files,
        non_public_files: summary.non_public_files,
    )
}

fn add_interface_summary_from_text(
    summary: InterfaceSummary,
    text: String,
) -> fresh InterfaceSummary {
    let lines = String.lines(value: text)
    let public_apis = List.fold<String, Int>(
        list: lines,
        initial: 0,
        folder: |count, line| {
            return count + public_interface_line_count(line)
        },
    )
    let trimmed = String.trim(value: text)

    return InterfaceSummary(
        interface_files: summary.interface_files + 1,
        interface_lines: summary.interface_lines + List.len(list: lines),
        public_apis: summary.public_apis + public_apis,
        empty_files: summary.empty_files + bool_count(value: String.len(value: trimmed) == 0),
        non_public_files: summary.non_public_files + bool_count(value: public_apis == 0),
    )
}

fn summarize_interface_file(
    root: Path,
    child: String,
    file: String,
    summary: InterfaceSummary,
) -> Result<fresh InterfaceSummary, String> {
    if String.ends_with(value: file, suffix: ".rssi") == false {
        return copy_interface_summary(summary)
    }

    let directory = Path.join(base: root, child)
    let path = Path.join(base: directory, child: file)
    let text = read_text_result(path)?

    return add_interface_summary_from_text(summary, text)
}

fn summarize_interface_root(
    root: Path,
    child: String,
    summary: InterfaceSummary,
) -> Result<fresh InterfaceSummary, String> {
    let directory = Path.join(base: root, child)
    if Directory.exists(path: directory) == false {
        return copy_interface_summary(summary)
    }

    if Directory.is_dir(path: directory) == false {
        return copy_interface_summary(summary)
    }

    let files = list_files_result(path: directory)?

    return List.try_fold<String, InterfaceSummary, String>(
        list: files,
        initial: summary,
        folder: |state, file| {
            return summarize_interface_file(
                root,
                child,
                file,
                summary: state,
            )
        },
    )
}

fn package_interface_summary(root: Path) -> Result<fresh InterfaceSummary, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let interface_roots = manifest_array_strings_or_empty(
        manifest,
        section: "interfaces",
        field: "paths",
    )

    return List.try_fold<String, InterfaceSummary, String>(
        list: interface_roots,
        initial: empty_interface_summary(),
        folder: |summary, child| {
            return summarize_interface_root(
                root,
                child,
                summary,
            )
        },
    )
}

fn count_existing_files_with_suffix(
    root: Path,
    child: String,
    suffix: String,
) -> Result<Int, String> {
    let directory = Path.join(base: root, child)
    if Directory.exists(path: directory) == false {
        return 0
    }

    if Directory.is_dir(path: directory) == false {
        return 0
    }

    let files = list_files_result(path: directory)?
    let counter = Counter.new(value: 0)

    for file in files {
        if String.ends_with(value: file, suffix) {
            Counter.add(counter: mut counter, amount: 1)
        }
    }

    return Counter.value(counter)
}

fn count_existing_root_files_with_suffix(
    root: Path,
    children: List<String>,
    suffix: String,
) -> Result<Int, String> {
    let counter = Counter.new(value: 0)

    for child in children {
        let count = count_existing_files_with_suffix(
            root,
            child,
            suffix,
        )?
        Counter.add(counter: mut counter, amount: count)
    }

    return Counter.value(counter)
}

fn collect_interface_snapshots_from_files(
    root: Path,
    child: String,
    files: List<String>,
    index: Int,
    snapshots: mut List<InterfaceSnapshot>,
) -> Result<Unit, String> {
    if index >= List.len(list: files) {
        return Ok(Unit)
    }

    let file = List.get(list: files, index)
    if String.ends_with(value: file, suffix: ".rssi") {
        let directory = Path.join(base: root, child)
        let path = Path.join(base: directory, child: file)
        let text = read_text_result(path)?
        let prefix = String.concat(left: child, right: "/")
        let relative_path = String.concat(left: prefix, right: file)
        let snapshot = InterfaceSnapshot(relative_path, text)
        List.push(list: mut snapshots, value: snapshot)
    }

    return collect_interface_snapshots_from_files(
        root,
        child,
        files,
        index: index + 1,
        snapshots: mut snapshots,
    )
}

fn collect_interface_snapshots_from_roots(
    root: Path,
    children: List<String>,
    index: Int,
    snapshots: mut List<InterfaceSnapshot>,
) -> Result<Unit, String> {
    if index >= List.len(list: children) {
        return Ok(Unit)
    }

    let child = List.get(list: children, index)
    let directory = Path.join(base: root, child)
    require_directory(path: directory, label: child)?
    let files = list_files_result(path: directory)?
    collect_interface_snapshots_from_files(
        root,
        child,
        files,
        index: 0,
        snapshots: mut snapshots,
    )?

    return collect_interface_snapshots_from_roots(
        root,
        children,
        index: index + 1,
        snapshots: mut snapshots,
    )
}

fn package_interface_snapshots(root: Path) -> Result<fresh List<InterfaceSnapshot>, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let interface_roots = manifest_interface_roots(manifest)?
    local snapshots = List<InterfaceSnapshot>.new()
    collect_interface_snapshots_from_roots(
        root,
        children: interface_roots,
        index: 0,
        snapshots: mut snapshots,
    )?

    return snapshots
}

fn find_snapshot_text(
    snapshots: List<InterfaceSnapshot>,
    index: Int,
    path: String,
) -> Option<String> {
    if index >= List.len(list: snapshots) {
        return None
    }

    let snapshot = List.get(list: snapshots, index)
    if snapshot.relative_path == path {
        return Some(snapshot.text)
    }

    return find_snapshot_text(
        snapshots,
        index: index + 1,
        path,
    )
}

fn count_removed_snapshots(
    left: List<InterfaceSnapshot>,
    right: List<InterfaceSnapshot>,
    index: Int,
) -> Int {
    if index >= List.len(list: left) {
        return 0
    }

    let snapshot = List.get(list: left, index)
    match find_snapshot_text(
        snapshots: right,
        index: 0,
        path: snapshot.relative_path,
    ) {
        Some(_) => {
            return count_removed_snapshots(left, right, index: index + 1)
        }
        None => {
            return 1 + count_removed_snapshots(
                left,
                right,
                index: index + 1,
            )
        }
    }
}

fn count_added_snapshots(
    left: List<InterfaceSnapshot>,
    right: List<InterfaceSnapshot>,
    index: Int,
) -> Int {
    if index >= List.len(list: right) {
        return 0
    }

    let snapshot = List.get(list: right, index)
    match find_snapshot_text(
        snapshots: left,
        index: 0,
        path: snapshot.relative_path,
    ) {
        Some(_) => {
            return count_added_snapshots(left, right, index: index + 1)
        }
        None => {
            return 1 + count_added_snapshots(
                left,
                right,
                index: index + 1,
            )
        }
    }
}

fn count_modified_snapshots(
    left: List<InterfaceSnapshot>,
    right: List<InterfaceSnapshot>,
    index: Int,
) -> Int {
    if index >= List.len(list: left) {
        return 0
    }

    let snapshot = List.get(list: left, index)
    match find_snapshot_text(
        snapshots: right,
        index: 0,
        path: snapshot.relative_path,
    ) {
        Some(text) => {
            return bool_count(value: text != snapshot.text) + count_modified_snapshots(
                left,
                right,
                index: index + 1,
            )
        }
        None => {
            return count_modified_snapshots(left, right, index: index + 1)
        }
    }
}

fn collect_lock_entries_from_manifest(
    root: Path,
    manifest: JsonValue,
    entries: mut List<LockEntry>,
) -> Result<Unit, String> {
    match manifest_dependencies(manifest)? {
        Some(dependencies) => {
            let names = json_object_keys_result(value: dependencies)?
            return collect_lock_entries_from_dependencies(
                root,
                dependencies,
                names,
                index: 0,
                entries: mut entries,
            )
        }
        None => {
            return Ok(Unit)
        }
    }
}

fn collect_lock_entries_from_dependencies(
    root: Path,
    dependencies: JsonValue,
    names: List<String>,
    index: Int,
    entries: mut List<LockEntry>,
) -> Result<Unit, String> {
    if index >= List.len(list: names) {
        return Ok(Unit)
    }

    let name = List.get(list: names, index)
    let spec = json_field_result(value: dependencies, name)?
    if Json.is_object(value: spec) {
        match Json.field_string(value: spec, name: "path") {
            Ok(path) => {
                let dependency_root = Path.join(base: root, child: path)
                let dependency_manifest = parse_toml_result(
                    path: manifest_path(root: dependency_root),
                )?
                let package = json_field_result(value: dependency_manifest, name: "package")?
                let package_name = json_field_string_result(value: package, name: "name")?
                let summary = package_interface_summary(root: dependency_root)?
                let entry = LockEntry(
                    name: package_name,
                    path,
                    interface_lines: summary.interface_lines,
                    public_apis: summary.public_apis,
                )
                List.push(list: mut entries, value: entry)
                collect_lock_entries_from_manifest(
                    root: dependency_root,
                    manifest: dependency_manifest,
                    entries: mut entries,
                )?
            }
            Err(_) => {
            }
        }
    }

    return collect_lock_entries_from_dependencies(
        root,
        dependencies,
        names,
        index: index + 1,
        entries: mut entries,
    )
}

fn package_lock_entries(root: Path) -> Result<fresh List<LockEntry>, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    local entries = List<LockEntry>.new()
    collect_lock_entries_from_manifest(
        root,
        manifest,
        entries: mut entries,
    )?

    return entries
}

fn added_api_count(before: Int, after: Int) -> Int {
    if after > before {
        return after - before
    }

    return 0
}

fn removed_api_count(before: Int, after: Int) -> Int {
    if before > after {
        return before - after
    }

    return 0
}

fn append_lock_entries_json(
    entries: List<LockEntry>,
    index: Int,
    builder: mut StringBuilder,
) -> Unit {
    if index >= List.len(list: entries) {
        return Unit
    }

    if index > 0 {
        StringBuilder.push(builder: mut builder, value: ",\n")
    }

    let entry = List.get(list: entries, index)
    StringBuilder.push(builder: mut builder, value: "    {\n      \"name\": ")
    let name = Json.quote_string(value: entry.name)
    StringBuilder.push(builder: mut builder, value: name)
    StringBuilder.push(builder: mut builder, value: ",\n      \"path\": ")
    let path = Json.quote_string(value: entry.path)
    StringBuilder.push(builder: mut builder, value: path)
    StringBuilder.push(builder: mut builder, value: ",\n      \"interface_lines\": ")
    let interface_lines = String.from_int(value: entry.interface_lines)
    StringBuilder.push(builder: mut builder, value: interface_lines)
    StringBuilder.push(builder: mut builder, value: ",\n      \"public_apis\": ")
    let public_apis = String.from_int(value: entry.public_apis)
    StringBuilder.push(builder: mut builder, value: public_apis)
    StringBuilder.push(builder: mut builder, value: "\n    }")

    return append_lock_entries_json(
        entries,
        index: index + 1,
        builder: mut builder,
    )
}

fn package_lock_json(facts: LockFacts, entries: List<LockEntry>) -> fresh String {
    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "{\n")
    StringBuilder.push(builder: mut builder, value: "  \"package\": ")
    let package_name = Json.quote_string(value: facts.package_name)
