fn json_error(prefix: String, error: JsonError) -> fresh String {
    let message = JsonError.message(error)
    let first = String.concat(left: prefix, right: ": ")

    return String.concat(left: first, right: message)
}

fn file_error(prefix: String, error: FileError) -> fresh String {
    let message = FileError.message(error)
    let first = String.concat(left: prefix, right: ": ")

    return String.concat(left: first, right: message)
}

fn root_path() -> fresh Path {
    let input = Args.get_or_default(
        index: 1,
        default: "tests/fixtures/pass/selfhost-package-source-set",
    )

    return Path.from_string(value: input)
}

fn output_path() -> fresh Path {
    let input = Args.get_or_default(
        index: 2,
        default: "target/rsscript-selfhost-package-manager-output",
    )

    return Path.from_string(value: input)
}

fn manifest_path(root: Path) -> fresh Path {
    return Path.join(base: root, child: "rsspkg.toml")
}

fn parse_toml_result(path: Path) -> Result<JsonValue, String> {
    match Toml.parse_file(path) {
        Ok(value) => {
            return Ok(value)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest parse", error))
        }
    }
}

fn json_field_result(
    value: JsonValue,
    name: String,
) -> Result<JsonValue, String> {
    match Json.field(value, name) {
        Ok(field) => {
            return Ok(field)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest field", error))
        }
    }
}

fn json_field_string_result(
    value: JsonValue,
    name: String,
) -> Result<String, String> {
    match Json.field_string(value, name) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest string", error))
        }
    }
}

fn json_array_len_result(value: JsonValue) -> Result<Int, String> {
    match Json.array_len(value) {
        Ok(length) => {
            return Ok(length)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest array length", error))
        }
    }
}

fn json_array_strings_result(value: JsonValue) -> Result<List<String>, String> {
    match Json.array_strings(value) {
        Ok(items) => {
            return Ok(items)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest array strings", error))
        }
    }
}

fn json_object_keys_result(value: JsonValue) -> Result<List<String>, String> {
    match Json.object_keys(value) {
        Ok(items) => {
            return Ok(items)
        }
        Err(error) => {
            return Err(json_error(prefix: "manifest object keys", error))
        }
    }
}

fn package_manifest_facts(root: Path) -> Result<fresh PackageManifestFacts, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package = json_field_result(value: manifest, name: "package")?
    let interfaces = json_field_result(value: manifest, name: "interfaces")?
    let interface_paths = json_field_result(value: interfaces, name: "paths")?
    let sources = json_field_result(value: manifest, name: "sources")?
    let source_paths = json_field_result(value: sources, name: "paths")?

    return PackageManifestFacts(
        package_name: json_field_string_result(value: package, name: "name")?,
        version: json_field_string_result(value: package, name: "version")?,
        edition: json_field_string_result(value: package, name: "edition")?,
        interface_paths: json_array_len_result(value: interface_paths)?,
        source_paths: json_array_len_result(value: source_paths)?,
    )
}

fn manifest_array_field(
    manifest: JsonValue,
    section: String,
    field: String,
) -> Result<JsonValue, String> {
    let section_value = json_field_result(value: manifest, name: section)?
    return json_field_result(value: section_value, name: field)
}

fn manifest_interface_roots(manifest: JsonValue) -> Result<List<String>, String> {
    let paths = manifest_array_field(
        manifest,
        section: "interfaces",
        field: "paths",
    )?

    return json_array_strings_result(value: paths)
}

fn manifest_source_roots(manifest: JsonValue) -> Result<List<String>, String> {
    let paths = manifest_array_field(
        manifest,
        section: "sources",
        field: "paths",
    )?

    return json_array_strings_result(value: paths)
}

fn ensure_parent_directory(path: Path) -> Result<Unit, String> {
    match Path.parent(path) {
        Some(parent) => {
            match Directory.create_all(path: parent) {
                Ok(_) => {
                }
                Err(error) => {
                    return Err(file_error(prefix: "create parent", error))
                }
            }
        }
        None => {
        }
    }

    return Ok(Unit)
}

fn require_directory(path: Path, label: String) -> Result<Unit, String> {
    if Directory.exists(path) == false {
        return Err(String.concat(left: "missing directory ", right: label))
    }

    if Directory.is_dir(path) == false {
        return Err(String.concat(left: "not a directory ", right: label))
    }

    return Ok(Unit)
}

fn write_text_file(path: Path, text: String) -> Result<Unit, FileError> {
    with File.open_write(path)? as file {
        File.write_string(file: mut file, text)?
    }

    return Ok(Unit)
}

fn write_text_result(path: Path, text: String) -> Result<Unit, String> {
    ensure_parent_directory(path)?

    match write_text_file(path, text) {
        Ok(_) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(file_error(prefix: "write file", error))
        }
    }
}

fn read_text_file(path: Path) -> Result<String, FileError> {
    with File.open_read(path)? as file {
        let text = File.read_all_string(file: mut file)?

        return Ok(text)
    }
}

fn read_text_result(path: Path) -> Result<String, String> {
    match read_text_file(path) {
        Ok(text) => {
            return Ok(text)
        }
        Err(error) => {
            return Err(file_error(prefix: "read file", error))
        }
    }
}

fn list_files_result(path: Path) -> Result<List<String>, String> {
    match Directory.list_files(path) {
        Ok(files) => {
            return Ok(files)
        }
        Err(error) => {
            return Err(file_error(prefix: "list files", error))
        }
    }
}

fn count_files_with_suffix(
    root: Path,
    child: String,
    suffix: String,
) -> Result<Int, String> {
    let directory = Path.join(base: root, child)
    require_directory(path: directory, label: child)?
    let files = list_files_result(path: directory)?
    let counter = Counter.new(value: 0)

    for file in files {
        if String.ends_with(value: file, suffix) {
            Counter.add(counter: mut counter, amount: 1)
        }
    }

    return Ok(Counter.value(counter))
}

fn count_root_files_with_suffix(
    root: Path,
    children: List<String>,
    suffix: String,
) -> Result<Int, String> {
    let counter = Counter.new(value: 0)

    for child in children {
        let count = count_files_with_suffix(
            root,
            child,
            suffix,
        )?
        Counter.add(counter: mut counter, amount: count)
    }

    return Ok(Counter.value(counter))
}

fn create_dir_result(path: Path) -> Result<Unit, String> {
    match Directory.create_all(path) {
        Ok(_) => {
            return Ok(Unit)
        }
        Err(error) => {
            return Err(file_error(prefix: "create directory", error))
        }
    }
}

fn package_check_facts(root: Path) -> Result<fresh PackageCheckFacts, String> {
    let manifest = parse_toml_result(path: manifest_path(root))?
    let package = json_field_result(value: manifest, name: "package")?
    let interface_roots = manifest_interface_roots(manifest)?
    let source_roots = manifest_source_roots(manifest)?
    let interface_files = count_root_files_with_suffix(
        root,
        children: interface_roots,
        suffix: ".rssi",
    )?
    let source_files = count_root_files_with_suffix(
        root,
        children: source_roots,
        suffix: ".rss",
    )?

    return PackageCheckFacts(
        package_name: json_field_string_result(value: package, name: "name")?,
        interface_roots: List.len(list: interface_roots),
        source_roots: List.len(list: source_roots),
        interface_files: interface_files,
        source_files: source_files,
    )
}

