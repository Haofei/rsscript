    StringBuilder.push(builder: mut builder, value: entry_count)
    let message = StringBuilder.finish(builder: take builder)
    Log.write(message)

    return Ok(Unit)
}

fn run_diff(root: Path, other: Path, output: Path) -> Result<Unit, String> {
    let before = package_review_facts(root)?
    let after = package_review_facts(root: other)?
    let before_snapshots = package_interface_snapshots(root)?
    let after_snapshots = package_interface_snapshots(root: other)?
    let facts = DiffFacts(
        package_name: before.package_name,
        added_apis: added_api_count(before: before.public_apis, after: after.public_apis),
        removed_apis: removed_api_count(before: before.public_apis, after: after.public_apis),
        changed_interfaces: count_removed_snapshots(
                left: before_snapshots,
                right: after_snapshots,
                index: 0,
            ) + count_added_snapshots(
                left: before_snapshots,
                right: after_snapshots,
                index: 0,
            ) + count_modified_snapshots(
                left: before_snapshots,
                right: after_snapshots,
                index: 0,
            ),
        risk_changed: package_review_risk(facts: before) != package_review_risk(facts: after),
    )
    let text = package_diff_json(facts)
    write_text_result(path: output, text)?

    local builder = StringBuilder.new()
    StringBuilder.push(builder: mut builder, value: "rss package manager diff ")
    StringBuilder.push(builder: mut builder, value: before.package_name)
    StringBuilder.push(builder: mut builder, value: " changed_interfaces=")
    let changed_interfaces = String.from_int(value: facts.changed_interfaces)
    StringBuilder.push(builder: mut builder, value: changed_interfaces)
    let message = StringBuilder.finish(builder: take builder)
    Log.write(message)

    return Ok(Unit)
}

