features: local

fn prop_json_int_object_roundtrip(value: Int) -> fresh PropertyResult {
    local fields = List<String>.new()
    List.push(list: mut fields, value: Json.int_field(name: "value", value))
    let text = Json.object(fields)
    match Json.parse(text) {
        Ok(root) => {
            match Json.field_int(value: root, name: "value") {
                Ok(parsed) => {
                    return Property.expect_bool(value: parsed == value)
                }
                Err(error) => {
                    return Property.fail(message: JsonError.message(error), counterexample: text)
                }
            }
        }
        Err(error) => {
            return Property.fail(message: JsonError.message(error), counterexample: text)
        }
    }
}

