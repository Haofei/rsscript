pub fn QuickCheckJson.run() -> Unit {
    let json_int_summary = Property.check_int(
        name: "json int object roundtrip",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_json_int_object_roundtrip(value)
        },
    )
    Property.assert_passed(summary: json_int_summary)

    let json_string_summary = Property.check_string(
        name: "json string object roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_json_string_object_roundtrip(value)
        },
    )
    Property.assert_passed(summary: json_string_summary)

    let json_pair_summary = Property.check_int_pair(
        name: "json int pair object roundtrip",
        cases: 200,
        seed: 20260602,
        input: IntPairGen.new(
            left: IntRange.new(min: -10000, max: 10000),
            right: IntRange.new(min: -10000, max: 10000),
        ),
        property: |value| {
            return prop_json_int_pair_object_roundtrip(value)
        },
    )
    Property.assert_passed(summary: json_pair_summary)

    let json_string_pair_summary = Property.check_string_pair(
        name: "json string pair object roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringPairGen.new(max_len: 40),
        property: |value| {
            return prop_json_string_pair_object_roundtrip(value)
        },
    )
    Property.assert_passed(summary: json_string_pair_summary)

    let json_int_array_summary = Property.check_int_list(
        name: "json int array roundtrip",
        cases: 200,
        seed: 20260602,
        input: IntListGen.new(
            max_len: 50,
            range: IntRange.new(min: -10000, max: 10000),
        ),
        property: |values| {
            return prop_json_int_array_roundtrip(values)
        },
    )
    Property.assert_passed(summary: json_int_array_summary)

    let json_bool_array_summary = Property.check_bool_list(
        name: "json bool array roundtrip",
        cases: 200,
        seed: 20260602,
        input: BoolListGen.new(max_len: 50),
        property: |values| {
            return prop_json_bool_array_roundtrip(values)
        },
    )
    Property.assert_passed(summary: json_bool_array_summary)

    let json_string_array_summary = Property.check_string_list(
        name: "json string array roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringListGen.new(max_len: 50, max_item_len: 40),
        property: |values| {
            return prop_json_string_array_roundtrip(values)
        },
    )
    Property.assert_passed(summary: json_string_array_summary)

    return Unit
}
