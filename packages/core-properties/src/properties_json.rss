fn int_lists_equal(left: List<Int>, right: List<Int>) -> Bool {
    if List.len(list: left) != List.len(list: right) {
        return false
    }
    let mut index = 0
    while index < List.len(list: left) {
        if List.get(list: left, index) != List.get(list: right, index) {
            return false
        }
        index = index + 1
    }
    return true
}

