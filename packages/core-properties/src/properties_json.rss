        List.push(list: mut items, value: String.from_bool(value))
        index = index + 1
    }
    return Json.array(items)
}

fn prop_json_int_array_roundtrip(values: List<Int>) -> fresh PropertyResult {
    let text = json_int_array_text(values)
    match Json.parse(text) {
        Ok(root) => {
            match Json.array_ints(value: root) {
                Ok(parsed) => {
                    return Property.expect_bool(value: int_lists_equal(left: values, right: parsed))
                }
                Err(error) => {
                    return Property.fail(message: JsonError.message(error), counterexample: text)
                }
            }
        }
        Err(error) => {
            return Property.fail(message: JsonError.message(error), counterexample: text)
        }
    }
}

