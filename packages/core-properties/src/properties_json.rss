fn json_int_array_text(values: List<Int>) -> fresh String {
    local items = List<String>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        List.push(list: mut items, value: String.from_int(value))
        index = index + 1
    }
    return Json.array(items)
}

fn json_bool_array_text(values: List<Bool>) -> fresh String {
    local items = List<String>.new()
