features: local

fn non_negative(value: Int) -> Int {
    if value < 0 {
        return 0 - value
    }
    return value
}

fn prop_string_view_len_bounds(value: String) -> fresh PropertyResult {
    let len = String.len(value)
    let start = len / 2
    let view = String.view(value, start, len)
    return Property.expect_bool(value: StringView.len(value: view) <= len - start)
}

fn prop_string_view_slice_len_bounds(value: String) -> fresh PropertyResult {
    let len = String.len(value)
    let view = String.view(value, start: 0, len)
    let slice = StringView.slice(value: view, start: len / 2, len)
    return Property.expect_bool(value: StringView.len(value: slice) <= len)
}

fn prop_string_view_to_string_matches_slice(value: String) -> fresh PropertyResult {
    let len = String.len(value)
    let count = len / 2
    let view = String.view(value, start: 0, len: count)
    let text = StringView.to_string(value: view)
    let expected = String.slice(value, start: 0, len: count)
    return Property.expect_bool(value: text == expected)
}

fn prop_bytes_from_string_len(value: String) -> fresh PropertyResult {
    let bytes = Bytes.from_string(value)
    return Property.expect_bool(value: Bytes.len(value: bytes) == String.len(value))
}

fn prop_bytes_concat_len(value: String) -> fresh PropertyResult {
    let left = Bytes.from_string(value)
    let right = Bytes.from_string(value)
    let joined = Bytes.concat(left, right)
    return Property.expect_bool(value: Bytes.len(value: joined) == String.len(value) * 2)
}

fn prop_bytes_slice_len_bounds(value: String) -> fresh PropertyResult {
    let bytes = Bytes.from_string(value)
    let len = Bytes.len(value: bytes)
    let start = len / 2
    let slice = Bytes.slice(value: bytes, start, len)
    return Property.expect_bool(value: Bytes.len(value: slice) <= len - start)
}

fn prop_bytes_view_to_bytes_len(value: String) -> fresh PropertyResult {
    let bytes = Bytes.from_string(value)
    let len = Bytes.len(value: bytes)
    let count = len / 2
    let view = Bytes.view(value: bytes, start: 0, len: count)
    let copied = BytesView.to_bytes(value: view)
    return Property.expect_bool(value: Bytes.len(value: copied) == count)
}

fn prop_buffer_view_len_bounds(value: Int) -> fresh PropertyResult {
    let size = non_negative(value) / 100
    let buffer = Buffer.new(size)
    let view = Buffer.view(buffer, start: size / 2, len: size)
    return Property.expect_bool(value: BufferView.len(value: view) <= size)
}

pub fn QuickCheckViews.run() -> Unit {
    let string_view_len = Property.check_string(
        name: "string view length stays in bounds",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_string_view_len_bounds(value)
        },
    )
    Property.assert_passed(summary: string_view_len)

    let string_view_slice = Property.check_string(
        name: "string view slice length stays in bounds",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_string_view_slice_len_bounds(value)
        },
    )
    Property.assert_passed(summary: string_view_slice)

    let string_view_text = Property.check_string(
        name: "string view to_string matches slice",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_string_view_to_string_matches_slice(value)
        },
    )
    Property.assert_passed(summary: string_view_text)

    let bytes_len = Property.check_string(
        name: "bytes from string has matching ascii length",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_bytes_from_string_len(value)
        },
    )
    Property.assert_passed(summary: bytes_len)

    let bytes_concat = Property.check_string(
        name: "bytes concat adds lengths",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_bytes_concat_len(value)
        },
    )
    Property.assert_passed(summary: bytes_concat)

    let bytes_slice = Property.check_string(
        name: "bytes slice length stays in bounds",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_bytes_slice_len_bounds(value)
        },
    )
    Property.assert_passed(summary: bytes_slice)

    let bytes_view = Property.check_string(
        name: "bytes view to_bytes preserves length",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_bytes_view_to_bytes_len(value)
        },
    )
    Property.assert_passed(summary: bytes_view)

    let buffer_view = Property.check_int(
        name: "buffer view length stays in bounds",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_buffer_view_len_bounds(value)
        },
    )
    Property.assert_passed(summary: buffer_view)

    return Unit
}
