features: local

fn double_int(value: Int) -> Int {
    return value * 2
}

fn even_some(value: Int) -> Option<Int> {
    let quotient = value / 2
    if quotient * 2 == value {
        return Some(value)
    }
    return None
}

fn option_int(value: Int) -> Option<Int> {
    if value >= 0 {
        return Some(value)
    }
    return None
}

fn result_int(value: Int) -> Result<Int, String> {
    if value >= 0 {
        return Ok(value)
    }
    return Err("negative")
}

fn prop_option_unwrap_or_some(value: Int) -> fresh PropertyResult {
    let input = Some(value)
    return Property.expect_bool(value: Option.unwrap_or<Int>(value: input, default: 0) == value)
}

fn prop_option_unwrap_or_none(value: Int) -> fresh PropertyResult {
    let input = option_int(value: -1)
    return Property.expect_bool(value: Option.unwrap_or<Int>(value: input, default: value) == value)
}

fn prop_option_map_some(value: Int) -> fresh PropertyResult {
    let input = Some(value)
    match Option.map(
        value: input,
        mapper: |item| {
            return double_int(value: item)
        },
    ) {
        Some(mapped) => {
            return Property.expect_bool(value: mapped == value * 2)
        }
        None => {
            return Property.fail(message: "Option.map dropped Some", counterexample: String.from_int(value))
        }
    }
}

fn prop_option_and_then_matches_filter(value: Int) -> fresh PropertyResult {
    let input = Some(value)
    let chained = Option.and_then(
        value: input,
        mapper: |item| {
            return even_some(value: item)
        },
    )
    let quotient = value / 2
    let is_even = quotient * 2 == value
    if is_even {
        return Property.expect_bool(value: Option.is_some(value: chained))
    }
    return Property.expect_bool(value: Option.is_none(value: chained))
}

fn prop_option_or_keeps_first_some(value: Int) -> fresh PropertyResult {
    let first = Some(value)
    let fallback = Some(value + 1)
    match Option.or<Int>(value: first, fallback) {
        Some(result) => {
            return Property.expect_bool(value: result == value)
        }
        None => {
            return Property.fail(message: "Option.or dropped first Some", counterexample: String.from_int(value))
        }
    }
}

fn prop_result_unwrap_or_ok(value: Int) -> fresh PropertyResult {
    let input = result_int(value)
    return Property.expect_bool(value: Result.unwrap_or<Int, String>(value: input, default: 0) == value)
}

fn prop_result_unwrap_or_err(value: Int) -> fresh PropertyResult {
    let input = result_int(value: -1)
    return Property.expect_bool(value: Result.unwrap_or<Int, String>(value: input, default: value) == value)
}

fn prop_result_ok_projection(value: Int) -> fresh PropertyResult {
    let input = result_int(value)
    match Result.ok<Int, String>(value: input) {
        Some(result) => {
            return Property.expect_bool(value: result == value)
        }
        None => {
            return Property.fail(message: "Result.ok returned None for Ok", counterexample: String.from_int(value))
        }
    }
}

fn prop_result_map_ok(value: Int) -> fresh PropertyResult {
    let input = Ok(value)
    match Result.map(
        result: input,
        mapper: |item| {
            return double_int(value: item)
        },
    ) {
        Ok(mapped) => {
            return Property.expect_bool(value: mapped == value * 2)
        }
        Err(error) => {
            return Property.fail(message: error, counterexample: String.from_int(value))
        }
    }
}

fn prop_result_and_then_err_stays_err(value: Int) -> fresh PropertyResult {
    let input = Err("negative")
    match Result.and_then(
        result: input,
        mapper: |item| {
            return result_int(value: item)
        },
    ) {
        Ok(_) => {
            return Property.fail(message: "Result.and_then converted Err to Ok", counterexample: String.from_int(value))
        }
        Err(error) => {
            return Property.expect_bool(value: error == "negative")
        }
    }
}

pub fn QuickCheckResultOption.run() -> Unit {
    let option_unwrap_some = Property.check_int(
        name: "option unwrap_or returns Some value",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_option_unwrap_or_some(value)
        },
    )
    Property.assert_passed(summary: option_unwrap_some)

    let option_unwrap_none = Property.check_int(
        name: "option unwrap_or returns default for None",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_option_unwrap_or_none(value)
        },
    )
    Property.assert_passed(summary: option_unwrap_none)

    let option_map = Property.check_int(
        name: "option map transforms Some",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_option_map_some(value)
        },
    )
    Property.assert_passed(summary: option_map)

    let option_and_then = Property.check_int(
        name: "option and_then matches even predicate",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_option_and_then_matches_filter(value)
        },
    )
    Property.assert_passed(summary: option_and_then)

    let option_or = Property.check_int(
        name: "option or keeps first Some",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_option_or_keeps_first_some(value)
        },
    )
    Property.assert_passed(summary: option_or)

    let result_unwrap_ok = Property.check_int(
        name: "result unwrap_or returns Ok value",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: 0, max: 10000),
        property: |value| {
            return prop_result_unwrap_or_ok(value)
        },
    )
    Property.assert_passed(summary: result_unwrap_ok)

    let result_unwrap_err = Property.check_int(
        name: "result unwrap_or returns default for Err",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_result_unwrap_or_err(value)
        },
    )
    Property.assert_passed(summary: result_unwrap_err)

    let result_ok = Property.check_int(
        name: "result ok projects Ok payload",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: 0, max: 10000),
        property: |value| {
            return prop_result_ok_projection(value)
        },
    )
    Property.assert_passed(summary: result_ok)

    let result_map = Property.check_int(
        name: "result map transforms Ok",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: 0, max: 10000),
        property: |value| {
            return prop_result_map_ok(value)
        },
    )
    Property.assert_passed(summary: result_map)

    let result_and_then = Property.check_int(
        name: "result and_then preserves Err",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_result_and_then_err_stays_err(value)
        },
    )
    Property.assert_passed(summary: result_and_then)

    return Unit
}
