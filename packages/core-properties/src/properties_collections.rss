features: local

fn lists_equal(left: List<Int>, right: List<Int>) -> Bool {
    if List.len(list: left) != List.len(list: right) {
        return false
    }
    let mut index = 0
    while index < List.len(list: left) {
        if List.get(list: left, index) != List.get(list: right, index) {
            return false
        }
        index = index + 1
    }
    return true
}

fn is_even(value: Int) -> Bool {
    let quotient = value / 2
    return quotient * 2 == value
}

fn list_contains_value(values: List<Int>, needle: Int) -> Bool {
    let mut index = 0
    while index < List.len(list: values) {
        if List.get(list: values, index) == needle {
            return true
        }
        index = index + 1
    }
    return false
}

fn prop_reverse_reverse(values: List<Int>) -> fresh PropertyResult {
    let once = List.reverse(list: values)
    let twice = List.reverse(list: once)
    return Property.expect_bool(value: lists_equal(left: values, right: twice))
}

fn prop_take_skip_rebuild(values: List<Int>) -> fresh PropertyResult {
    let count = List.len(list: values) / 2
    local rebuilt = List.take(list: values, count)
    let suffix = List.skip(list: values, count)
    List.append(list: mut rebuilt, values: suffix)
    return Property.expect_bool(value: lists_equal(left: values, right: rebuilt))
}

fn prop_filter_count_matches(values: List<Int>) -> fresh PropertyResult {
    let filtered = List.filter(
        list: values,
        predicate: |value| {
            return is_even(value)
        },
    )
    let counted = List.count_where(
        list: values,
        predicate: |value| {
            return is_even(value)
        },
    )
    return Property.expect_bool(value: List.len(list: filtered) == counted)
}

fn prop_list_first_last_match_indices(values: List<Int>) -> fresh PropertyResult {
    if List.len(list: values) == 0 {
        return Property.discard()
    }

    match List.first(list: values) {
        Some(first) => {
            match List.last(list: values) {
                Some(last) => {
                    let expected_first = List.get(list: values, index: 0)
                    let expected_last = List.get(list: values, index: List.len(list: values) - 1)
                    return Property.expect_bool(value: first == expected_first && last == expected_last)
                }
                None => {
                    return Property.fail(message: "last returned none for non-empty list", counterexample: "")
                }
            }
        }
        None => {
            return Property.fail(message: "first returned none for non-empty list", counterexample: "")
        }
    }
}

fn prop_list_pop_removes_last(values: List<Int>) -> fresh PropertyResult {
    if List.len(list: values) == 0 {
        return Property.discard()
    }

    local copy = List.slice(list: values, start: 0, len: List.len(list: values))
    let expected_last = List.get(list: values, index: List.len(list: values) - 1)
    match List.pop(list: mut copy) {
        Some(popped) => {
            let len_ok = List.len(list: copy) == List.len(list: values) - 1
            return Property.expect_bool(value: popped == expected_last && len_ok)
        }
        None => {
            return Property.fail(message: "pop returned none for non-empty list", counterexample: "")
        }
    }
}

fn prop_list_set_updates_index(value: IntPair) -> fresh PropertyResult {
    local values = List<Int>.new()
    List.push(list: mut values, value: value.left)
    List.set(list: mut values, index: 0, value: value.right)
    return Property.expect_bool(value: List.get(list: values, index: 0) == value.right && List.len(list: values) == 1)
}

fn prop_list_remove_at_decreases_len(values: List<Int>) -> fresh PropertyResult {
    if List.len(list: values) == 0 {
        return Property.discard()
    }

    let index = List.len(list: values) / 2
    let expected = List.get(list: values, index)
    local copy = List.slice(list: values, start: 0, len: List.len(list: values))
    match List.remove_at(list: mut copy, index) {
        Some(removed) => {
            let len_ok = List.len(list: copy) == List.len(list: values) - 1
            return Property.expect_bool(value: removed == expected && len_ok)
        }
        None => {
            return Property.fail(message: "remove_at returned none for valid index", counterexample: "")
        }
    }
}

fn prop_list_clear_empties(values: List<Int>) -> fresh PropertyResult {
    local copy = List.slice(list: values, start: 0, len: List.len(list: values))
    List.clear(list: mut copy)
    return Property.expect_bool(value: List.len(list: copy) == 0 && List.is_empty(list: copy))
}

fn prop_map_insert_get(values: List<Int>) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Map.insert(map: mut map, key: value, value)
        match Map.get(map, key: value) {
            Some(found) => {
                if found != value {
                    return Property.fail(message: "map returned wrong value", counterexample: String.from_int(value))
                }
            }
            None => {
                return Property.fail(message: "map lost inserted key", counterexample: String.from_int(value))
            }
        }
        index = index + 1
    }
    return Property.pass()
}

fn prop_map_get_or_default_after_insert(value: Int) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    Map.insert(map: mut map, key: value, value)
    let next = value + 1
    let found = Map.get_or_default(map, key: value, default: next)
    let missing = Map.get_or_default(map, key: next, default: value)
    return Property.expect_bool(value: found == value && missing == value)
}

fn prop_map_remove_deletes_key(value: Int) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    Map.insert(map: mut map, key: value, value)
    match Map.remove(map: mut map, key: value) {
        Some(removed) => {
            let missing = Map.contains_key(map, key: value) == false
            return Property.expect_bool(value: removed == value && missing)
        }
        None => {
            return Property.fail(message: "remove returned none for inserted key", counterexample: String.from_int(value))
        }
    }
}

fn prop_map_keys_values_match_len(values: List<Int>) -> fresh PropertyResult {
    local map = Map<Int, Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Map.insert(map: mut map, key: value, value)
        index = index + 1
    }

    let keys = Map.keys(map)
    let map_values = Map.values(map)
    return Property.expect_bool(value: List.len(list: keys) == Map.len(map) && List.len(list: map_values) == Map.len(map))
}

