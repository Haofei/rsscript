    return Property.expect_bool(value: Set.is_subset(left: set, right: set))
}

fn prop_set_insert_contains(values: List<Int>) -> fresh PropertyResult {
    local set = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Set.insert(set: mut set, value)
        if Set.contains(set, value) == false {
            return Property.fail(message: "set lost inserted value", counterexample: String.from_int(value))
        }
        index = index + 1
    }
    return Property.expect_bool(value: Set.len(set) <= List.len(list: values))
}

fn prop_set_to_list_membership(values: List<Int>) -> fresh PropertyResult {
    local set = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Set.insert(set: mut set, value)
        index = index + 1
    }

    let items = Set.to_list(set)
    let mut item_index = 0
    while item_index < List.len(list: items) {
        let item = List.get(list: items, index: item_index)
        if list_contains_value(values, needle: item) == false {
            return Property.fail(message: "set to_list returned unknown value", counterexample: String.from_int(value: item))
        }
        item_index = item_index + 1
    }
    return Property.expect_bool(value: List.len(list: items) == Set.len(set))
}

fn prop_set_union_contains_left(values: List<Int>) -> fresh PropertyResult {
    local left = Set<Int>.new()
    local right = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        if is_even(value) {
            Set.insert(set: mut left, value)
        } else {
            Set.insert(set: mut right, value)
        }
        index = index + 1
    }

    let union = Set.union(left, right)
    let left_items = Set.to_list(set: left)
    let mut left_index = 0
    while left_index < List.len(list: left_items) {
        let item = List.get(list: left_items, index: left_index)
        if Set.contains(set: union, value: item) == false {
            return Property.fail(message: "union does not contain left item", counterexample: String.from_int(value: item))
        }
        left_index = left_index + 1
    }
    return Property.pass()
}

fn prop_set_intersection_subset(values: List<Int>) -> fresh PropertyResult {
    local left = Set<Int>.new()
    local right = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Set.insert(set: mut left, value)
        if is_even(value) {
            Set.insert(set: mut right, value)
        }
        index = index + 1
    }

    let intersection = Set.intersection(left, right)
    return Property.expect_bool(value: Set.is_subset(left: intersection, right: left))
}

fn set_from_list(values: List<Int>) -> fresh Set<Int> {
    local set = Set<Int>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        Set.insert(set: mut set, value)
        index = index + 1
    }
    return set
}

fn prop_set_union_contains_both_sides(value: IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: value.left)
    let right = set_from_list(values: value.right)
    let union = Set.union(left, right)

    let mut left_index = 0
    while left_index < List.len(list: value.left) {
        let item = List.get(list: value.left, index: left_index)
        if Set.contains(set: union, value: item) == false {
            return Property.fail(message: "union missing left input", counterexample: String.from_int(value: item))
        }
        left_index = left_index + 1
    }

    let mut right_index = 0
    while right_index < List.len(list: value.right) {
        let item = List.get(list: value.right, index: right_index)
        if Set.contains(set: union, value: item) == false {
            return Property.fail(message: "union missing right input", counterexample: String.from_int(value: item))
        }
        right_index = right_index + 1
    }

    return Property.pass()
}

fn prop_set_difference_excludes_right(value: IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: value.left)
    let right = set_from_list(values: value.right)
    let difference = Set.difference(left, right)

    let right_items = Set.to_list(set: right)
    let mut index = 0
    while index < List.len(list: right_items) {
        let item = List.get(list: right_items, index)
        if Set.contains(set: difference, value: item) {
            return Property.fail(message: "difference contains right item", counterexample: String.from_int(value: item))
        }
        index = index + 1
    }

    return Property.pass()
}

fn prop_set_intersection_contains_only_both(value: IntListPair) -> fresh PropertyResult {
    let left = set_from_list(values: value.left)
    let right = set_from_list(values: value.right)
    let intersection = Set.intersection(left, right)
    let items = Set.to_list(set: intersection)

    let mut index = 0
    while index < List.len(list: items) {
        let item = List.get(list: items, index)
        if Set.contains(set: left, value: item) == false || Set.contains(set: right, value: item) == false {
            return Property.fail(message: "intersection item is not in both sets", counterexample: String.from_int(value: item))
        }
        index = index + 1
    }

    return Property.pass()
}

fn prop_sort_adjacent_order(values: List<Int>) -> fresh PropertyResult {
    if List.len(list: values) < 2 {
        return Property.discard()
    }

    local sorted = List.slice(list: values, start: 0, len: List.len(list: values))
    List.sort(list: mut sorted)
    let mut index = 1
    while index < List.len(list: sorted) {
        let previous = List.get(list: sorted, index: index - 1)
        let current = List.get(list: sorted, index)
        if previous > current {
            return Property.fail(message: "sort produced descending adjacent pair", counterexample: "")
        }
        index = index + 1
    }
    return Property.pass()
}

fn prop_sort_first_last(values: List<Int>) -> fresh PropertyResult {
    if List.len(list: values) == 0 {
        return Property.discard()
    }

    local sorted = List.slice(list: values, start: 0, len: List.len(list: values))
    List.sort(list: mut sorted)
    let first = List.get(list: sorted, index: 0)
    let last = List.get(list: sorted, index: List.len(list: sorted) - 1)
    return Property.expect_bool(value: first <= last)
}

