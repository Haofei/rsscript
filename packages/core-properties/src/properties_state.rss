features: local

fn list_sum(values: List<Int>) -> Int {
    let mut total = 0
    let mut index = 0
    while index < List.len(list: values) {
        total = total + List.get(list: values, index)
        index = index + 1
    }
    return total
}

fn key_from_int(value: Int) -> fresh String {
    return String.concat(left: "key-", right: String.from_int(value))
}

fn value_from_int(value: Int) -> fresh String {
    return String.concat(left: "value-", right: String.from_int(value))
}

fn prop_counter_add_matches_sum(values: List<Int>) -> fresh PropertyResult {
    let start = List.len(list: values)
    let expected = start + list_sum(values)
    let mut actual = start
    let mut index = 0
    while index < List.len(list: values) {
        actual = actual + List.get(list: values, index)
        index = index + 1
    }
    return Property.expect_bool(value: actual == expected)
}

fn prop_counter_add_zero_identity(value: Int) -> fresh PropertyResult {
    let actual = value + 0
    return Property.expect_bool(value: actual == value)
}

fn prop_cache_insert_lookup(value: Int) -> fresh PropertyResult {
    local entries = Map.new<String, String>()
    let key = key_from_int(value)
    let stored = value_from_int(value)
    Map.insert(map: mut entries, key, value: stored)
    let found = Map.get_or_default(map: entries, key, default: "")
    return Property.expect_bool(value: found == stored)
}

fn prop_cache_last_write_wins(value: Int) -> fresh PropertyResult {
    local entries = Map.new<String, String>()
    let key = key_from_int(value)
    let first = value_from_int(value)
    let second = value_from_int(value: value + 1)
    Map.insert(map: mut entries, key, value: first)
    Map.insert(map: mut entries, key, value: second)
    let found = Map.get_or_default(map: entries, key, default: "")
    return Property.expect_bool(value: found == second)
}

fn prop_cache_independent_keys(value: Int) -> fresh PropertyResult {
    local entries = Map.new<String, String>()
    let left_key = key_from_int(value)
    let right_key = key_from_int(value: value + 1)
    if left_key == right_key {
        return Property.discard()
    }

    let left_value = value_from_int(value)
    let right_value = value_from_int(value: value + 1)
    Map.insert(map: mut entries, key: left_key, value: left_value)
    Map.insert(map: mut entries, key: right_key, value: right_value)

    let left_found = Map.get_or_default(map: entries, key: left_key, default: "")
    let right_found = Map.get_or_default(map: entries, key: right_key, default: "")
    return Property.expect_bool(value: left_found == left_value && right_found == right_value)
}

pub fn QuickCheckState.run() -> Unit {
    let counter_sum = Property.check_int_list(
        name: "counter add matches sum model",
        cases: 200,
        seed: 20260602,
        input: IntListGen.new(
            max_len: 50,
            range: IntRange.new(min: -100, max: 100),
        ),
        property: |values| {
            return prop_counter_add_matches_sum(values)
        },
    )
    Property.assert_passed(summary: counter_sum)

    let counter_zero = Property.check_int(
        name: "counter add zero is identity",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_counter_add_zero_identity(value)
        },
    )
    Property.assert_passed(summary: counter_zero)

    let cache_lookup = Property.check_int(
        name: "cache insert lookup roundtrip",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_cache_insert_lookup(value)
        },
    )
    Property.assert_passed(summary: cache_lookup)

    let cache_last_write = Property.check_int(
        name: "cache last write wins",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_cache_last_write_wins(value)
        },
    )
    Property.assert_passed(summary: cache_last_write)

    let cache_keys = Property.check_int(
        name: "cache keeps independent keys",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_cache_independent_keys(value)
        },
    )
    Property.assert_passed(summary: cache_keys)

    return Unit
}
