features: local

fn prop_int_in_range(value: Int) -> fresh PropertyResult {
    return Property.expect_bool(value: value >= -10 && value <= 10)
}

fn prop_bool_roundtrip(value: Bool) -> fresh PropertyResult {
    let text = String.from_bool(value)
    let true_case = value && text == "true"
    let false_case = !value  && text == "false"
    let ok = true_case || false_case
    return Property.expect_bool(value: ok)
}

fn prop_int_parse_roundtrip(value: Int) -> fresh PropertyResult {
    let text = String.from_int(value)
    match String.parse_int(value: text) {
        Some(parsed) => {
            return Property.expect_bool(value: parsed == value)
        }
        None => {
            return Property.fail(
                message: "parse_int failed",
                counterexample: String.from_int(value),
            )
        }
    }
}

fn prop_string_concat_len(value: String) -> fresh PropertyResult {
    let doubled = String.concat(left: value, right: value)
    let expected_len = String.len(value) * 2
    return Property.expect_bool(value: String.len(value: doubled) == expected_len)
}

fn prop_string_trim_no_growth(value: String) -> fresh PropertyResult {
    let trimmed = String.trim(value)
    return Property.expect_bool(value: String.len(value: trimmed) <= String.len(value))
}

fn prop_string_uppercase_preserves_len(value: String) -> fresh PropertyResult {
    let upper = String.to_uppercase(value)
    return Property.expect_bool(value: String.len(value: upper) == String.len(value))
}

fn prop_string_split_join_roundtrip(value: String) -> fresh PropertyResult {
    let parts = String.split(value, delimiter: "a")
    let joined = List.join(list: parts, separator: "a")
    return Property.expect_bool(value: joined == value)
}

fn prop_string_strip_prefix_roundtrip(value: String) -> fresh PropertyResult {
    let half_len = String.len(value) / 2
    let prefix = String.slice(value, start: 0, len: half_len)
    match String.strip_prefix(value, prefix) {
        Some(rest) => {
            let rebuilt = String.concat(left: prefix, right: rest)
            return Property.expect_bool(value: rebuilt == value)
        }
        None => {
            return Property.fail(message: "strip_prefix failed for actual prefix", counterexample: value)
        }
    }
}

fn prop_string_before_after_roundtrip(value: String) -> fresh PropertyResult {
    if String.contains(value, needle: "m") == false {
        return Property.discard()
    }

    match String.before(value, delimiter: "m") {
        Some(before) => {
            match String.after(value, delimiter: "m") {
                Some(after) => {
                    let left = String.concat(left: before, right: "m")
                    let rebuilt = String.concat(left, right: after)
                    return Property.expect_bool(value: rebuilt == value)
                }
                None => {
                    return Property.fail(message: "after failed for contained delimiter", counterexample: value)
                }
            }
        }
        None => {
            return Property.fail(message: "before failed for contained delimiter", counterexample: value)
        }
    }
}

fn prop_string_concat_pair_contains_both(value: StringPair) -> fresh PropertyResult {
    let combined = String.concat(left: value.left, right: value.right)
    let has_left_prefix = String.starts_with(value: combined, prefix: value.left)
    let has_right_suffix = String.ends_with(value: combined, suffix: value.right)
    return Property.expect_bool(value: has_left_prefix && has_right_suffix)
}

fn prop_string_list_join_split_roundtrip(values: List<String>) -> fresh PropertyResult {
    if List.len(list: values) == 0 {
        return Property.discard()
    }

    let joined = List.join(list: values, separator: "|")
    let split = String.split(value: joined, delimiter: "|")
    if List.len(list: values) != List.len(list: split) {
        return Property.fail(message: "split length changed", counterexample: joined)
    }

    let mut index = 0
    while index < List.len(list: values) {
        if List.get(list: values, index) != List.get(list: split, index) {
            return Property.fail(message: "split item changed", counterexample: joined)
        }
        index = index + 1
    }
    return Property.pass()
}

pub fn QuickCheckCore.run() -> Unit {
    let range_summary = Property.check_int(
        name: "generated ints stay in requested range",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10, max: 10),
        property: |value| {
            return prop_int_in_range(value)
        },
    )
    Property.assert_passed(summary: range_summary)

    let bool_summary = Property.check_bool(
        name: "bool string roundtrip",
        cases: 200,
        seed: 20260602,
        property: |value| {
            return prop_bool_roundtrip(value)
        },
    )
    Property.assert_passed(summary: bool_summary)

    let parse_summary = Property.check_int(
        name: "int parse roundtrip",
        cases: 200,
        seed: 20260602,
        range: IntRange.new(min: -10000, max: 10000),
        property: |value| {
            return prop_int_parse_roundtrip(value)
        },
    )
    Property.assert_passed(summary: parse_summary)

    let concat_summary = Property.check_string(
        name: "string concat doubles length",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_string_concat_len(value)
        },
    )
    Property.assert_passed(summary: concat_summary)

    let trim_summary = Property.check_string(
        name: "string trim never grows input",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_string_trim_no_growth(value)
        },
    )
    Property.assert_passed(summary: trim_summary)

    let uppercase_summary = Property.check_string(
        name: "string uppercase preserves length",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_string_uppercase_preserves_len(value)
        },
    )
    Property.assert_passed(summary: uppercase_summary)

    let split_join_summary = Property.check_string(
        name: "string split join roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_string_split_join_roundtrip(value)
        },
    )
    Property.assert_passed(summary: split_join_summary)

    let strip_prefix_summary = Property.check_string(
        name: "string strip prefix roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringGen.new(max_len: 40),
        property: |value| {
            return prop_string_strip_prefix_roundtrip(value)
        },
    )
    Property.assert_passed(summary: strip_prefix_summary)

    let before_after_summary = Property.check_string(
        name: "string before after roundtrip",
        cases: 400,
        seed: 20260602,
        input: StringGen.new(max_len: 80),
        property: |value| {
            return prop_string_before_after_roundtrip(value)
        },
    )
    Property.assert_passed(summary: before_after_summary)

    let concat_pair_summary = Property.check_string_pair(
        name: "string concat pair preserves prefix and suffix",
        cases: 200,
        seed: 20260602,
        input: StringPairGen.new(max_len: 40),
        property: |value| {
            return prop_string_concat_pair_contains_both(value)
        },
    )
    Property.assert_passed(summary: concat_pair_summary)

    let join_split_list_summary = Property.check_string_list(
        name: "string list join split roundtrip",
        cases: 200,
        seed: 20260602,
        input: StringListGen.new(max_len: 40, max_item_len: 20),
        property: |values| {
            return prop_string_list_join_split_roundtrip(values)
        },
    )
    Property.assert_passed(summary: join_split_list_summary)

    return Unit
}
