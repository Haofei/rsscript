fn gen_string(rng: Rng, input: StringGen) -> fresh String {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng, range: IntRange(min: 0, max: bounded_len))
    let mut item_rng = Rng.next(rng)
    local builder = StringBuilder.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: item_rng)
        let letter_index = Rng.int(rng: item_rng, range: IntRange(min: 0, max: 25))
        StringBuilder.push(builder: mut builder, value: letter_from_index(value: letter_index))
        index = index + 1
    }
    return StringBuilder.finish(builder: take builder)
}

fn gen_string_pair(rng: Rng, input: StringPairGen) -> fresh StringPair {
    let left_rng = Rng.next(rng)
    let right_rng = Rng.next(rng: left_rng)
    let string_gen = StringGen(max_len: input.max_len)
    local left_value = gen_string(rng: left_rng, input: string_gen)
    local right_value = gen_string(rng: right_rng, input: string_gen)
    return StringPair(left: take left_value, right: take right_value)
}

fn gen_string_list(rng: Rng, input: StringListGen) -> fresh List<String> {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng, range: IntRange(min: 0, max: bounded_len))
    let string_gen = StringGen(max_len: input.max_item_len)
    let mut item_rng = Rng.next(rng)
    local values = List<String>.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: item_rng)
        let value = gen_string(rng: item_rng, input: string_gen)
        List.push(list: mut values, value)
        index = index + 1
    }
    return values
}

fn shrink_string_failure(value: String, property: noescape Fn(String) -> fresh PropertyResult) -> fresh PropertyResult {
    let empty = property("")
    if empty.ok == false && empty.discarded == false {
        return result_with_counterexample(
            result: empty,
            counterexample: "\"\"",
        )
    }

    let half_len = String.len(value) / 2
    if half_len > 0 {
        let half = String.slice(value, start: 0, len: half_len)
        let half_counterexample = string_counterexample(value: half)
        let half_result = property(half)
        if half_result.ok == false && half_result.discarded == false {
            return result_with_counterexample(
                result: half_result,
                counterexample: half_counterexample,
            )
        }
    }

    let original = property(String.copy(value))
    return result_with_counterexample(
        result: original,
        counterexample: string_counterexample(value),
    )
}

fn shrink_string_pair_failure(
    value: StringPair,
    property: noescape Fn(StringPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    let empty = StringPair(left: "", right: "")
    let empty_result = property(empty)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: empty_result,
