fn result_with_counterexample(result: PropertyResult, counterexample: String) -> fresh PropertyResult {
    if String.is_empty(value: result.counterexample) {
        return PropertyResult(
            ok: result.ok,
            discarded: result.discarded,
            label: String.copy(value: result.label),
            message: String.copy(value: result.message),
            counterexample: String.copy(value: counterexample),
        )
    }
    return PropertyResult(
        ok: result.ok,
        discarded: result.discarded,
        label: String.copy(value: result.label),
        message: String.copy(value: result.message),
        counterexample: String.copy(value: result.counterexample),
    )
}

