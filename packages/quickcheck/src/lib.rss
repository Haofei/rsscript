fn positive_mod(value: Int, modulus: Int) -> Int {
    let quotient = value / modulus
    let reduced = value - quotient * modulus
    if reduced < 0 {
        return reduced + modulus
    }
    return reduced
}

fn bounded_cases(cases: Int) -> Int {
    if cases <= 0 {
        return 100
    }
    return cases
}

fn bounded_range_min(min: Int, max: Int) -> Int {
    if min <= max {
        return min
    }
    return max
}

fn bounded_range_max(min: Int, max: Int) -> Int {
    if min <= max {
        return max
    }
    return min
}

pub fn Rng.seed(seed: Int) -> fresh Rng {
    let normalized = positive_mod(value: seed, modulus: 2147483647)
    if normalized == 0 {
        return Rng(state: 1)
    }
    return Rng(state: normalized)
}

pub fn Rng.next(rng: Rng) -> fresh Rng {
    let next = positive_mod(value: rng.state * 48271, modulus: 2147483647)
    return Rng(state: next)
}

pub fn Rng.int(rng: Rng, range: IntRange) -> Int {
    let low = bounded_range_min(min: range.min, max: range.max)
    let high = bounded_range_max(min: range.min, max: range.max)
    let span = high - low + 1
    return low + positive_mod(value: rng.state, modulus: span)
}

pub fn Rng.bool(rng: Rng) -> Bool {
    return Rng.int(rng, range: IntRange(min: 0, max: 1)) == 1
}

