pub fn Property.pass() -> fresh PropertyResult {
    return PropertyResult(
        ok: true,
        discarded: false,
        label: "",
        message: "",
        counterexample: "",
    )
}

pub fn Property.fail(message: String, counterexample: String) -> fresh PropertyResult {
    return PropertyResult(
        ok: false,
        discarded: false,
        label: "",
        message: String.copy(value: message),
        counterexample: String.copy(value: counterexample),
    )
}

pub fn Property.discard() -> fresh PropertyResult {
    return PropertyResult(
        ok: false,
        discarded: true,
        label: "",
        message: "",
        counterexample: "",
    )
}

pub fn Property.expect_bool(value: Bool) -> fresh PropertyResult {
    if value {
        return Property.pass()
    }
    return Property.fail(message: "property returned false", counterexample: "")
}

