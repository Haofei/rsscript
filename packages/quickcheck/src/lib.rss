fn shrink_int_failure(value: Int, property: noescape Fn(Int) -> fresh PropertyResult) -> fresh PropertyResult {
    let zero = property(0)
    if zero.ok == false && zero.discarded == false {
        return result_with_counterexample(
            result: zero,
            counterexample: int_counterexample(value: 0),
        )
    }

    let half = value / 2
    if half != value {
        let candidate = property(half)
        if candidate.ok == false && candidate.discarded == false {
            return result_with_counterexample(
                result: candidate,
                counterexample: int_counterexample(value: half),
            )
        }
    }

    let original = property(value)
    return result_with_counterexample(
        result: original,
        counterexample: int_counterexample(value),
    )
}

pub fn Property.check_int(
    name: String,
    cases: Int,
    seed: Int,
    range: IntRange,
    property: noescape Fn(Int) -> fresh PropertyResult,
) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed)
    let total = bounded_cases(cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng)
        let value = Rng.int(rng, range)
        let result = property(value)
        if result.discarded {
            discarded = discarded + 1
        } else {
            if result.ok {
                passed = passed + 1
            } else {
                let shrunk = shrink_int_failure(value, property: property)
                return failed_summary(
                    name,
                    passed,
                    discarded,
                    total,
                    seed,
                    result: shrunk,
                )
            }
        }
        index = index + 1
    }

    return passed_summary(name, passed, discarded, total, seed)
}

