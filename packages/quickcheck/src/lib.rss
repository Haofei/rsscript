fn gen_int_list(rng: Rng, input: IntListGen) -> fresh List<Int> {
    let bounded_len = bounded_range_max(min: 0, max: input.max_len)
    let len = Rng.int(rng, range: IntRange(min: 0, max: bounded_len))
    let mut item_rng = Rng.next(rng)
    local values = List<Int>.new()
    let mut index = 0
    while index < len {
        item_rng = Rng.next(rng: item_rng)
        let value = Rng.int(rng: item_rng, range: input.range)
        List.push(list: mut values, value)
        index = index + 1
    }
    return values
}

fn gen_int_pair(rng: Rng, input: IntPairGen) -> fresh IntPair {
    let left_rng = Rng.next(rng)
    let right_rng = Rng.next(rng: left_rng)
    return IntPair(
        left: Rng.int(rng: left_rng, range: input.left),
        right: Rng.int(rng: right_rng, range: input.right),
    )
}

fn gen_int_list_pair(rng: Rng, input: IntListPairGen) -> fresh IntListPair {
    let left_rng = Rng.next(rng)
    let right_rng = Rng.next(rng: left_rng)
    let list_gen = IntListGen(max_len: input.max_len, range: IntRange(min: input.range.min, max: input.range.max))
    local left_values = gen_int_list(rng: left_rng, input: list_gen)
    local right_values = gen_int_list(rng: right_rng, input: list_gen)
    return IntListPair(
        left: take left_values,
        right: take right_values,
    )
}

fn shrink_list_failure(
    values: List<Int>,
    property: noescape Fn(List<Int>) -> fresh PropertyResult,
) -> fresh PropertyResult {
    local empty = List<Int>.new()
    let empty_result = property(empty)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: empty_result,
            counterexample: "[]",
        )
    }

    let half_len = List.len(list: values) / 2
    if half_len > 0 {
        let half = List.take(list: values, count: half_len)
        let half_counterexample = int_list_counterexample(values: half)
        let half_result = property(half)
        if half_result.ok == false && half_result.discarded == false {
            return result_with_counterexample(
                result: half_result,
                counterexample: half_counterexample,
            )
        }
    }

    let original_value = List.slice(list: values, start: 0, len: List.len(list: values))
    let original = property(original_value)
    return result_with_counterexample(
        result: original,
        counterexample: int_list_counterexample(values),
    )
}

fn shrink_int_pair_failure(
    value: IntPair,
    property: noescape Fn(IntPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    let zero = IntPair(left: 0, right: 0)
    let zero_result = property(zero)
    if zero_result.ok == false && zero_result.discarded == false {
        return result_with_counterexample(
            result: zero_result,
            counterexample: "left=0 right=0",
        )
    }

    let original_value = IntPair(left: value.left, right: value.right)
    let original = property(original_value)
    return result_with_counterexample(
        result: original,
        counterexample: int_pair_counterexample(value),
    )
}

fn shrink_int_list_pair_failure(
    value: IntListPair,
    property: noescape Fn(IntListPair) -> fresh PropertyResult,
) -> fresh PropertyResult {
    local left_empty = List<Int>.new()
    local right_empty = List<Int>.new()
    let empty_pair = IntListPair(left: take left_empty, right: take right_empty)
    let empty_result = property(empty_pair)
    if empty_result.ok == false && empty_result.discarded == false {
        return result_with_counterexample(
            result: empty_result,
            counterexample: "left=[] right=[]",
        )
    }

    local left_copy = List.slice(list: value.left, start: 0, len: List.len(list: value.left))
    local right_copy = List.slice(list: value.right, start: 0, len: List.len(list: value.right))
    let original_value = IntListPair(left: take left_copy, right: take right_copy)
    let original = property(original_value)
    return result_with_counterexample(
        result: original,
        counterexample: int_list_pair_counterexample(value),
    )
}

pub fn Property.check_int_list(
    name: String,
    cases: Int,
    seed: Int,
    input: IntListGen,
    property: noescape Fn(List<Int>) -> fresh PropertyResult,
) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed)
    let total = bounded_cases(cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng)
        let values = gen_int_list(rng, input)
        let input = List.slice(list: values, start: 0, len: List.len(list: values))
        let result = property(input)
        if result.discarded {
            discarded = discarded + 1
        } else {
            if result.ok {
                passed = passed + 1
            } else {
                let shrunk = shrink_list_failure(values, property: property)
                return failed_summary(
                    name,
                    passed,
                    discarded,
                    total,
                    seed,
                    result: shrunk,
                )
            }
        }
        index = index + 1
    }

    return passed_summary(name, passed, discarded, total, seed)
}

