pub fn Property.check_string(
    name: String,
    cases: Int,
    seed: Int,
    input: StringGen,
    property: noescape Fn(String) -> fresh PropertyResult,
) -> fresh PropertySummary {
    let mut rng = Rng.seed(seed)
    let total = bounded_cases(cases)
    let mut passed = 0
    let mut discarded = 0
    let mut index = 0

    while index < total {
        rng = Rng.next(rng)
