pub fn Property.assert_passed(summary: PropertySummary) -> Unit {
    if summary.failed {
        let named = String.concat(left: "quickcheck failed: ", right: summary.name)
        let reason = String.concat(left: named, right: " reason=")
        let with_reason = String.concat(left: reason, right: summary.failure)
        let counterexample = String.concat(left: with_reason, right: " counterexample=")
        Log.write(message: String.concat(left: counterexample, right: summary.counterexample))
    }
    Assert.equal_bool(left: summary.failed, right: false)
    return Unit
}
