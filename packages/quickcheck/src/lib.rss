}

fn int_counterexample(value: Int) -> fresh String {
    return String.from_int(value)
}

fn bool_counterexample(value: Bool) -> fresh String {
    return String.from_bool(value)
}

fn string_counterexample(value: String) -> fresh String {
    return String.concat(
        left: "\"",
        right: String.concat(left: value, right: "\""),
    )
}

fn string_pair_counterexample(value: StringPair) -> fresh String {
    let left = String.concat(left: "left=", right: string_counterexample(value: value.left))
    let mid = String.concat(left, right: " right=")
    return String.concat(left: mid, right: string_counterexample(value: value.right))
}

fn int_list_counterexample(values: List<Int>) -> fresh String {
    local parts = List<String>.new()
    let mut index = 0
    while index < List.len(list: values) {
        let value = List.get(list: values, index)
        List.push(list: mut parts, value: String.from_int(value))
        index = index + 1
    }
    return String.concat(
        left: "[",
        right: String.concat(
            left: List.join(list: parts, separator: ", "),
            right: "]",
        ),
    )
}

