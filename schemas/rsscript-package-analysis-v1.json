{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsscript.dev/schemas/rsscript-package-analysis-v1.json",
  "title": "RSScript package analysis v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "producer", "language_version", "interface_catalog_digest", "snapshot_digest", "package", "files", "summary", "exports", "external_imports", "call_edges", "recursive_functions", "resource_lifetimes", "task_groups", "await_sites", "diagnostics"],
  "properties": {
    "$schema": { "const": "rsscript.package_analysis.v1" },
    "producer": { "$ref": "#/$defs/producer" },
    "language_version": { "type": "string", "minLength": 1 },
    "interface_catalog_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "snapshot_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "module_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "package": { "$ref": "#/$defs/package" },
    "files": { "type": "array", "items": { "type": "object" } },
    "summary": { "type": "object" },
    "exports": { "type": "array", "items": { "type": "object" } },
    "external_imports": { "type": "array", "items": { "$ref": "#/$defs/import" } },
    "call_edges": { "type": "array", "items": { "$ref": "#/$defs/call_edge" } },
    "recursive_functions": { "type": "array", "items": { "type": "string" } },
    "resource_lifetimes": { "type": "array", "items": { "$ref": "#/$defs/resource_lifetime" } },
    "task_groups": { "type": "array", "items": { "$ref": "#/$defs/task_group" } },
    "await_sites": { "type": "array", "items": { "type": "object" } },
    "diagnostics": { "type": "array", "items": { "type": "object" } }
  },
  "$defs": {
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "source_revision", "ruleset_digest"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "source_revision": { "type": "string" },
        "ruleset_digest": { "type": "string" }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "edition"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "edition": { "type": "string" }
      }
    },
    "import": {
      "type": "object",
      "required": ["function", "symbol", "call_chain"],
      "properties": {
        "function": { "type": "string" },
        "symbol": { "type": "string" },
        "call_chain": { "type": "array", "items": { "type": "string" } },
        "span": { "type": "object" }
      }
    },
    "call_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["caller", "callee"],
      "properties": {
        "caller": { "type": "string" },
        "callee": { "type": "string" }
      }
    },
    "resource_lifetime": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "binding", "acquisition", "cleanup", "cleanup_on_cancellation"],
      "properties": {
        "function": { "type": "string" }, "binding": { "type": "string" },
        "acquisition": { "type": "string" }, "cleanup": { "type": "string" },
        "cleanup_on_cancellation": { "type": "boolean" }
      }
    },
    "task_group": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "spawned_tasks", "select_arms", "drains_on_exit", "cleanup_on_cancellation"],
      "properties": {
        "function": { "type": "string" }, "spawned_tasks": { "type": "integer", "minimum": 0 },
        "select_arms": { "type": "integer", "minimum": 0 }, "drains_on_exit": { "type": "boolean" },
        "cleanup_on_cancellation": { "type": "boolean" }
      }
    }
  }
}
