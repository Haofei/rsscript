{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsscript.dev/schemas/rsscript.runner_request.v1.schema.json",
  "title": "RSScript runner request v1 header",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "args", "limits", "metadata_only_trace"],
  "properties": {
    "schema": { "const": "rsscript.runner_request.v1" },
    "profile": { "enum": ["no_providers", "no_providers_namespaced", "no_providers_network_isolated", "no_providers_filesystem_isolated", "no_providers_seccomp_filtered", "log_only"] },
    "args": { "type": "array", "maxItems": 256, "items": { "type": "string", "maxLength": 65536 } },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_time_ms", "max_depth", "step_budget", "allocation_budget", "live_memory_limit", "output_budget", "intrinsic_call_budget", "provider_call_budget", "resource_limit"],
      "properties": {
        "wall_time_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 1024 },
        "step_budget": { "type": "integer", "minimum": 1, "maximum": 100000000 },
        "allocation_budget": { "type": "integer", "minimum": 1, "maximum": 536870912 },
        "live_memory_limit": { "type": "integer", "minimum": 1, "maximum": 268435456 },
        "output_budget": { "type": "integer", "minimum": 1, "maximum": 4194304 },
        "intrinsic_call_budget": { "type": "integer", "minimum": 1, "maximum": 10000000 },
        "provider_call_budget": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "resource_limit": { "type": "integer", "minimum": 1, "maximum": 16384 }
      }
    },
    "metadata_only_trace": { "type": "boolean" }
  }
}
