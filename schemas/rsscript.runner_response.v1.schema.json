{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rsscript.dev/schemas/rsscript.runner_response.v1.schema.json",
  "title": "RSScript runner response v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profile", "runner_termination", "report", "error"],
  "properties": {
    "schema": { "const": "rsscript.runner_response.v1" },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "descriptor_digest"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "descriptor_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "runner_termination": {
      "enum": ["completed", "isolation_rejected", "verification_rejected", "link_rejected", "protocol_rejected", "host_failure"]
    },
    "report": { "type": ["object", "null"] },
    "error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "runner_termination": { "const": "completed" } } },
      "then": { "properties": { "report": { "type": "object" }, "error": { "type": "null" } } },
      "else": { "properties": { "report": { "type": "null" }, "error": { "type": "string" } } }
    }
  ]
}
